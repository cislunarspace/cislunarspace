@article{lopezInterplanetaryPitStops2025,
  title = {Interplanetary Pit Stops: Harnessing Asteroids as Solar Filling Stations for {{Earth-to-mars}} Missions},
  shorttitle = {Interplanetary Pit Stops},
  author = {Lopez, Francesco and Conte, Davide},
  year = 2025,
  journal = {Acta Astronautica},
  volume = {Vol.228},
  pages = {515--526},
  doi = {10.1016/j.actaastro.2024.12.009},
  abstract = {This paper studies Earth--Mars missions that utilize asteroid candidates as intermediate stops to perform in-situ resource utilization refueling and minimize overall spacecraft launch mass from Earth. The first leg of the trajectory intercepts one such asteroid candidate, where the spacecraft performs an insertion into a Sun--asteroid distant retrograde orbit. After refueling, the spacecraft transfers from the asteroid to Mars. While heliocentric orbital transfers are computed using Lambert's problem, particle swarm optimization and dynamical systems theory are used to compute the proposed Sun--asteroid distant retrograde orbit and to determine the {$\Delta$} V -optimal trajectories to approach and land onto the asteroid. The selection process for candidate asteroids narrows down from over a million possibilities to 94 asteroids based on specific orbital parameters. Significant {$\Delta$} V savings and mission cost reductions are demonstrated through strategic asteroid selection. A double-arc trajectory model between Earth, an asteroid, and Mars is outlined, addressing computational challenges by dividing the problem into subdomains. The development of Sun--asteroid distant retrograde orbit families and the optimization of landing trajectories on selected asteroids using particle swarm optimization highlight the feasibility and advantages of asteroid-based refueling stations for sustainable space exploration.},
  langid = {english},
  keywords = {Asteroidal ISRU,Circular restricted three-body problem,Distant retrograde orbits,Earth-Mars missions,Particle swarm optimization,Refueling on asteroids,Trajectory design},
  annotation = {titleTranslation: 星际中途补给站：利用小行星作为地球至火星任务的太阳能``加油站''\\
abstractTranslation: 本文研究了利用小行星候选体作为中转站以实现原位资源利用加注并最大限度降低航天器从地球发射总质量的地球--火星任务。任务第一段轨迹拦截其中一颗候选小行星，航天器在日--小行星远距离逆行轨道上实施入轨。完成加注后，航天器从小行星转移至火星。日心轨道转移计算基于兰伯特问题，而所提出的日--小行星远距离逆行轨道及其接近与着陆的速度增量最优轨迹则通过粒子群优化与动力系统理论共同求解。候选小行星的筛选过程从超过一百万种可能性中根据特定轨道参数缩减至94颗。通过战略性小行星选择，展示了显著的速度增量节省与任务成本降低。本文勾勒出地球、小行星与火星之间的双弧段轨迹模型，通过将问题划分为子域来应对计算挑战。日--小行星远距离逆行轨道族的建立以及利用粒子群优化对选定小行星着陆轨迹的优化，凸显了基于小行星的加注站用于可持续空间探索的可行性与优势}
}

@inproceedings{loucksLunarRectilinearOrbits2016,
  title = {Lunar near Rectilinear Orbits and Cis-Lunar Transfer Trajectories in Support of the Deep Space Proving Ground},
  booktitle = {26th {{AAS}}/{{AIAA Spaceflight Mechanics Meeting}}},
  author = {Loucks, Michel and Post, Kevin and Carrico, John},
  year = 2016,
  series = {26th {{AAS}}/{{AIAA Spaceflight Mechanics Meeting}}},
  address = {Napa, CA},
  abstract = {The NASA Evolvable Mars Campaign (EMC) contains the Deep Space Proving Ground (DSPG) in the near-Lunar vicinity as one of the major increments along the path to a sustainable human spaceflight architecture. The DSPG development path includes several key hardware architectural elements including the Space Launch System (SLS), the Orion crew vehicle, and an extended stay capability provided by an Exploration Augmentation Module (EAM). Recent NASA studies have indicated that a class of cislunar Halo orbits known as Near Rectilinear Orbits or NROs, could be a useful staging location for human-tended cislunar operations in the DSPG away from the Lunar Distant Retrograde Orbit (LDRO). In this paper, we describe a method for the simple creation and analysis of these orbits and provide and describe their fundamental characteristics.},
  langid = {english},
  annotation = {titleTranslation: 支持深空试验场的月球近直线晕轨道及地月转移轨道}
}


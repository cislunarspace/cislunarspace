@article{sanagaLeveragingHillRestricted2025,
  title = {Leveraging the Hill Restricted Four-Body Problem to Investigate the Ephemeris Transition Characteristics in the {{Earth-moon L2}} Halo Orbit Region},
  author = {Sanaga, Rohith Reddy and Howell, Kathleen C.},
  year = 2025,
  month = oct,
  journal = {Astrodynamics},
  volume = {9},
  number = {5},
  pages = {785--805},
  issn = {2522-008X, 2522-0098},
  doi = {10.1007/s42064-024-0250-4},
  urldate = {2025-12-01},
  abstract = {Abstract                            The Earth-Moon               L               1               ,               L               2               halo orbit families support a variety of options for lunar surface activities as well as other developments in the cislunar region. The planned operational orbit for NASA's Gateway is the 9:2               L               2               synodic resonant halo orbit. Furthermore, orbits from this family could serve as staging locations for future missions to near-Earth asteroids and Mars, hubs for servicing logistics, and nodes for sensor networks. Therefore, it is essential to understand the dynamics that govern the halo orbit regions. Previously, a sub-region in the               L               2               halo family of the Earth-Moon system, termed the ``Interface Region'' was identified to be particularly challenging when transitioning the solutions from this               L               2               halo family sub-region to the Higher-Fidelity Ephemeris model (HFEM). Recent research suggests that the intermediate models incorporating pulsation in the Earth-Moon motion offer more insight into the dynamics governing this general underlying flow. This investigation aims to characterize the interface region by understanding the dynamical structures via the Hill Restricted Four-Body Problem (HR4BP).},
  langid = {english},
  annotation = {titleTranslation: 利用希尔限制性四体问题研究地月L2晕轨道区域的星历转换特性\\
abstractTranslation: 摘要：地月L1、L2晕轨道族为月球表面活动以及地月空间的其他发展提供了多种选择。NASA Gateway计划采用的运行轨道是9:2 L2会合共振晕轨道。此外，该轨道族的轨道可作为未来近地小行星和火星任务的中转站、后勤保障中心以及传感器网络节点。因此，理解支配晕轨道区域的动力学至关重要。此前，在地月系统L2晕轨道族中识别出一个称为``界面区域''的子区域，该区域在将解从该L2晕轨道族子区域过渡到高保真星历模型时尤为困难。近期研究表明，引入地月运动脉动的中间模型能为支配这一基本背景流的动力学提供更多见解。本研究旨在通过Hill限制性四体问题来表征界面区域，理解其动力学结构。},
  file = {/home/ouyangjiahong/Zotero/storage/M579M9US/Sanaga和Howell - 2025 - Leveraging the hill restricted four-body problem to investigate the ephemeris transition characteris.pdf}
}

@article{sanchez-martinManifoldsLagrangianCoherent2018,
  title = {From Manifolds to Lagrangian Coherent Structures in Galactic Bar Models},
  author = {{S{\'a}nchez-Mart{\'i}n}, P. and Masdemont, J. J. and {Romero-G{\'o}mez}, M.},
  year = 2018,
  month = oct,
  journal = {Astronomy and Astrophysics},
  volume = {618},
  pages = {A72},
  issn = {0004-6361, 1432-0746},
  doi = {10.1051/0004-6361/201833451},
  urldate = {2025-11-27},
  abstract = {We study the dynamics near the unstable Lagrangian points in galactic bar models using dynamical system tools in order to determine the global morphology of a barred galaxy. We aim at the case of non-autonomous models, in particular with secular evolution, by allowing the bar pattern speed to decrease with time. We have extended the concept of manifolds widely used in the autonomous problem to the Lagrangian coherent structures (LCS), widely used in fluid dynamics, which behave similar to the invariant manifolds driving the motion. After adapting the LCS computation code to the galactic dynamics problem, we apply it to both the autonomous and non-autonomous problems, relating the results with the manifolds and identifying the objects that best describe the motion in the non-autonomous case. We see that the strainlines coincide with the first intersection of the stable manifold when applied to the autonomous case, while, when the secular model is used, the strainlines still show the regions of maximal repulsion associated to both the corresponding stable manifolds and regions with a steep change of energy. The global morphology of the galaxy predicted by the autonomous problem remains unchanged.},
  copyright = {https://www.edpsciences.org/en/authors/copyright-and-licensing},
  langid = {english},
  annotation = {titleTranslation: 从流形到星系棒模型中拉格朗日相干结构\\
abstractTranslation: 我们利用动力系统工具研究星系棒模型中不稳定拉格朗日点附近的动力学，以确定棒旋星系的整体形态。我们重点关注非自治模型，特别是包含长期演化的情况，允许棒模式速度随时间减小。我们将自治问题中广泛使用的流形概念扩展至流体动力学中常用的拉格朗日相干结构（LCS），这些结构的行为类似于驱动运动的不变流形。在将LCS计算代码适配到星系动力学问题后，我们将其应用于自治和非自治两种情况，将结果与流形相关联，并识别出最能描述非自治情况下运动的对象。我们发现，在自治情况下，应变线与稳定流形的第一次交会重合；而在使用长期演化模型时，应变线仍显示出与相应稳定流形及能量剧烈变化区域相关的最大排斥区。自治问题所预测的星系整体形态保持不变},
  file = {/home/ouyangjiahong/Zotero/storage/SW7XXMDX/Sánchez-Martín 等 - 2018 - From manifolds to lagrangian coherent structures in galactic bar models.pdf}
}

@article{sanchezAsteroidRetrievalMissions2016,
  title = {Asteroid Retrieval Missions Enabled by Invariant Manifold Dynamics},
  author = {S{\'a}nchez, Joan Pau and Garc{\'i}a Y{\'a}rnoz, Daniel},
  year = 2016,
  month = oct,
  journal = {Acta Astronautica},
  volume = {127},
  pages = {667--677},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2016.05.034},
  urldate = {2025-11-27},
  abstract = {Near Earth Asteroids are attractive targets for new space missions; firstly, because of their scientific importance, but also because of their impact threat and prospective resources. The asteroid retrieval mission concept has thus arisen as a synergistic approach to tackle these three facets of interest in one single mission. This paper reviews the methodology used by the authors (2013) in a previous search for objects that could be transported from accessible heliocentric orbits into the Earth's neighbourhood at affordable costs (or Easily Retrievable Objects, a.k.a. EROs). This methodology consisted of a heuristic pruning and an impulsive manoeuvre trajectory optimisation. Low thrust propulsion on the other hand clearly enables the transportation of much larger objects due to its much higher specific impulse. Hence, in this paper, low thrust retrieval transfers are sought using impulsive trajectories as first guesses to solve the optimal control problem. GPOPS-II is used to transcribe the continuous-time optimal control problem to a nonlinear programming problem (NLP). The latter is solved by IPOPT, an open source software package for largescale NLPs. Finally, a natural continuation procedure that increases the asteroid mass allows to find out the largest objects that could be retrieved from a given asteroid orbit. If this retrievable mass is larger than the actual mass of the asteroid, the asteroid retrieval mission for this particular object is said to be feasible. The paper concludes with an updated list of 17 EROs, as of April 2016, with their maximum retrievable masses by means of low thrust propulsion. This ranges from 2,000 tonnes for the easiest object to be retrieved to 300 tonnes for the least accessible of them.},
  langid = {english},
  annotation = {titleTranslation: 基于不变流形动力学的近地小行星捕获任务\\
abstractTranslation: 近地小行星因其科学重要性、撞击威胁以及潜在资源，成为新型航天任务中的理想目标。小行星回收任务概念由此应运而生，它以一种协同方式在同一任务中同时应对这三个方面的关注点。本文回顾了作者（2013年）此前用于搜索那些能以可承受成本从可抵达的日心轨道运送至地球附近的星体（即易回收天体，简称ERO）所采用的方法论。该方法论包括启发式剪枝和脉冲机动轨迹优化。而另一方面，低推力推进凭借其远高于脉冲推进的比冲，显然能够运输更大质量的星体。因此，本文以脉冲轨迹作为初值，通过求解最优控制问题来寻找低推力回收转移轨道。采用GPOPS-II将连续时间最优控制问题转录为非线性规划问题（NLP），再由IPOPT（一款开源的大规模NLP求解软件包）进行求解。最后，通过自然延续过程逐步增加星体质量，从而找出能从给定小行星轨道回收的最大质量星体。若该可回收质量大于小行星的实际质量，则针对该星体的小行星回收任务视为可行。本文最后给出了截至2016年4月更新的17颗ERO清单，并列出其借助低推力推进所能回收的最大质量，范围从最容易回收的星体的2000吨至最难回收的300吨。},
  file = {/home/ouyangjiahong/Zotero/storage/RRPBQPNN/Sánchez和García Yárnoz - 2016 - Asteroid retrieval missions enabled by invariant manifold dynamics.pdf}
}


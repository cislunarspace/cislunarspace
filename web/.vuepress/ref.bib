@article{liuCHANGE5T1ExtendedMission2016,
  title = {{{CHANG}}'{{E-5T1}} Extended Mission: The First Lunar Libration Point Flight via a Lunar Swing-By},
  shorttitle = {{{CHANG}}'{{E-5T1}} Extended Mission},
  author = {Liu, Lei and Li, Ji-sheng},
  year = 2016,
  month = aug,
  journal = {Advances in Space Research},
  volume = {58},
  number = {4},
  pages = {609--618},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2016.05.015},
  urldate = {2026-03-26},
  abstract = {This paper introduces the extended mission of the Chinese circumlunar return and reentry test (i.e., the CHANG'E-5T1 mission), the first Chinese flight in the Earth--Moon libration orbit and the first spacecraft to reach the Earth--Moon libration orbit via a lunar swing-by. The extended mission utilized the remaining propellant from the CHANG'E-5T1 mission. Based on the normal trajectory and satellite state at the end of the CHANG'E-5T1 mission, a lunar return and a flight in the lunar libration orbit were determined to be the flight goals of the extended mission. Two schemes were then proposed for the CHANG'E-5T1 extended mission, including a possible Earth--Moon libration orbit. The methodology for the trajectory design and maneuvering included the direct libration-point orbit transfer and injection method, which is characterized by a reduced calculation burden compared with the prevalent invariant manifold method. The scenarios were compared in terms of flight time, control energy and number of maneuvers, flight distance, and achieved flight goals. The comparison indicated that the scheme, including the Earth--Moon L2 point and return to the Moon, was preferred for the CHANG'E-5T1 extended mission. Furthermore, the actual flight parameters of the CHANG'E-5T1 extended mission are also presented to validate the selected scheme.},
  langid = {english},
  keywords = {CHANG'E-5T1 mission,Extended mission,Flight scheme,Libration point,Lunar swing-by,Trajectory design},
  annotation = {titleTranslation: 嫦娥五号T1拓展任务：首次借力月球飞抵地月平动点的航天任务\\
abstractTranslation: 本文介绍了中国绕月返回与再入试验（即CHANG'E-5T1任务）的扩展任务，这是中国首次飞入地月平动点轨道的飞行任务，也是首个通过月球借力到达地月平动点轨道的航天器。该扩展任务利用了CHANG'E-5T1任务剩余的推进剂。基于CHANG'E-5T1任务结束时的标准轨迹与卫星状态，确定了月球返回及月球平动点轨道飞行为扩展任务的飞行目标。随后针对CHANG'E-5T1扩展任务提出了两种方案，其中包含一种可能的地月平动点轨道。轨迹设计与变轨方法包括直接平动点轨道转移与注入方法，与主流的流形不变法相比，其计算负担更小。从飞行时间、控制能量、变轨次数、飞行距离及任务目标达成情况等方面对方案进行了对比。对比结果表明，包含地月L2点并返回月球的方案更适用于CHANG'E-5T1扩展任务。此外，还给出了CHANG'E-5T1扩展任务的实际飞行参数，以验证所选方案的有效性。},
  file = {/home/ouyangjiahong/Zotero/storage/CFFCVT62/Liu和Li - 2016 - CHANG’E-5T1 extended mission the first lunar libration point flight via a lunar swing-by.pdf;/home/ouyangjiahong/Zotero/storage/9PC7VZTK/S0273117716302010.html}
}


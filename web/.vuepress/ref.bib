@article{vinhReachableDomainInterception1995,
  title = {Reachable Domain for Interception at Hyperbolic Speeds},
  author = {Vinh, Nguyen X. and Gilbert, Elmer G. and Howe, Robert M. and Sheu, Donglong and Lu, Ping},
  year = 1995,
  month = jan,
  journal = {Acta Astronautica},
  volume = {35},
  number = {1},
  pages = {1--8},
  issn = {0094-5765},
  doi = {10.1016/0094-5765(94)00132-6},
  urldate = {2026-02-13},
  abstract = {The interception of an ICBM at low altitude and in a short time requires hyperbolic speeds. At the acquisition time t0, if updated information about the trajectory of the target dictates a velocity correction for the interception, then it is of interest to assess the potential for interception. The reachable surface is defined as the boundary of the set of all attainable points at a given time t, for a fuel potential, conveniently expressed in terms of the {$\Delta$}v available. Properties of this surface are derived and its mathematical characterization is obtained. As an application of the concept, a necessary condition for a successful interception of a target given in terms of a capture function is explicitly derived.},
  langid = {english},
  annotation = {titleTranslation: 双曲线速度拦截的可达域\\
abstractTranslation: 在低空和短时间拦截洲际弹道导弹需要达到双曲速度。在捕获时刻t{$_0$}，若目标弹道的最新更新信息要求对拦截进行速度修正，则评估拦截潜力就具有重要意义。可达面定义为给定时刻t，在燃料能力（可用{$\Delta$}v表示）下所有可到达点集的边界。本文推导了该曲面的性质，并给出了其数学表征。作为该概念的应用，明确推导了基于捕获函数的成功拦截必要条件。},
  file = {/home/ouyangjiahong/Zotero/storage/4TQ72PZA/Vinh 等 - 1995 - Reachable domain for interception at hyperbolic speeds.pdf;/home/ouyangjiahong/Zotero/storage/6J6KMG2K/0094576594001326.html}
}

@article{vinodProjectionfreeComputationRobust2025,
  title = {Projection-Free Computation of Robust Controllable Sets with Constrained Zonotopes},
  author = {Vinod, Abraham P. and Weiss, Avishai and Di Cairano, Stefano},
  year = 2025,
  journal = {Automatica},
  volume = {Vol.175},
  pages = {112211},
  issn = {0005-1098},
  doi = {10.1016/j.automatica.2025.112211},
  abstract = {We study the problem of computing robust controllable sets for discrete-time linear systems with additive uncertainty. We propose a tractable and scalable approach to inner- and outer-approximate robust controllable sets using constrained zonotopes, when the additive uncertainty set is a symmetric, convex, and compact set. Our least-squares-based approach uses novel closed-form approximations of the Pontryagin difference between a constrained zonotopic minuend and a symmetric, convex, and compact subtrahend. We obtain these approximations using two novel canonical representations for full-dimensional constrained zonotopes. Unlike existing approaches, our approach does not rely on convex optimization solvers, and is projection-free for ellipsoidal and zonotopic uncertainty sets. We also propose a least-squares-based approach to compute a convex, polyhedral outer-approximation to constrained zonotopes, and characterize sufficient conditions under which all these approximations are exact. We demonstrate the computational efficiency and scalability of our approach in several case studies, including the design of abort-safe rendezvous trajectories for a spacecraft in near-rectilinear halo orbit under uncertainty. Our approach can inner-approximate a 20-step robust controllable set for a 100-dimensional linear system in under 15 s on a standard computer.},
  langid = {english},
  keywords = {Computational geometry,Constrained Zonotopes,Pontryagin difference,Robust controllable set,Set-based control},
  annotation = {titleTranslation: 基于约束Zonotope的无投影鲁棒可控集计算\\
abstractTranslation: 我们研究计算具有加性不确定性的离散时间线性系统的鲁棒可控集问题。当加性不确定性集为对称、凸且紧致时，我们提出一种使用约束Zonotope来内逼近和外逼近鲁棒可控集的易处理且可扩展的方法。我们的基于最小二乘法的方法利用约束Zonotope被减数与对称、凸且紧致减数之间庞特里亚金差的新型闭式近似。我们通过两种新的全维约束Zonotope的规范表示来获得这些近似。与现有方法不同，我们的方法不依赖凸优化求解器，并且对于椭球和Zonotope不确定性集无需投影操作。我们还提出一种基于最小二乘法的方法来计算约束Zonotope的凸多面体外逼近，并刻画所有这些近似为精确的充分条件。我们在多个案例研究中展示了该方法在计算效率和可扩展性方面的优势，包括在不确定性环境下为近直线晕轨道航天器设计中止安全交会轨迹。我们的方法能在标准计算机上于15秒内内逼近一个100维线性系统的20步鲁棒可控集}
}


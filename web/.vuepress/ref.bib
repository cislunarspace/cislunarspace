@article{shimaneOptimizationbasedPhaseconstrainedXaxis2025,
  title = {Optimization-Based Phase-Constrained x-Axis Crossing Control for Station-Keeping on Libration Point Orbits},
  author = {Shimane, Yuri and Weiss, Koki Ho Avishai},
  year = 2025,
  journal = {Journal of Astronautical Sciences},
  volume = {Vol.72},
  number = {No.6},
  doi = {10.1007/s40295-025-00543-1},
  abstract = {Libration Point Orbits (LPO) play a central role in lunar exploration of the twenty first century. Long-term operations of both crewed and robotic assets on LPOs necessitate propellant-efficient and reliable station-keeping schemes. Recent developments highlight the importance of station-keeping schemes that not only maintain the geometric orbital regime but also avoid leading or lagging along the orbit as a result of a drifting phase. In this work, an optimization-based station-keeping algorithm for colinear LPO based on the x-axis crossing control, an event-based targeting scheme for impulsive maneuver design, is conceived. The optimization problem is cast as a sequential second-order cone program and incorporates an explicit constraint on the perilune pass epoch to ensure the steered trajectory follows the reference baseline without deviating in phase. The resulting formulation has easily interpretable tuning parameters that may be obtained directly from mission requirements. The algorithm is demonstrated through Monte-Carlo simulations on Gateway's Near Rectilinear Halo Orbit (NRHO) in the high-fidelity ephemeris model with realistic error models.},
  langid = {english},
  keywords = {Ephemeris model,Libration point orbit,Optimization,Station keeping},
  annotation = {titleTranslation: 基于优化的相位约束X轴穿越控制------用于拉格朗日点轨道驻留保持\\
abstractTranslation: 平动点轨道（LPO）在二十一世纪的月球探测中扮演核心角色。在LPO上长期运行载人与机器人资产，需要推进剂高效且可靠的站位保持策略。最新进展凸显了站位保持方案的重要性------不仅要维持几何轨道形态，还需避免因相位漂移导致轨道超前或滞后。本研究提出一种基于x轴穿越控制的共线LPO优化站位保持算法，该算法采用基于事件的脉冲机动设计目标定位方案。优化问题被构建为序列二阶锥规划，并包含对近月点通过历元的显式约束，以确保受控轨迹在不产生相位偏移的情况下跟随参考基线。最终公式具有易于解释的调谐参数，可直接根据任务需求确定。通过蒙特卡洛仿真，在高保真星历模型及实际误差模型下，对Gateway的近直线晕轨道（NRHO）进行了算法验证。}
}

@article{shimaneRevolutionspacedOutputfeedbackModel2025,
  title = {Revolution-Spaced Output-Feedback Model Predictive Control for Station Keeping on near-Rectilinear Halo Orbits},
  author = {Shimane, Yuri and Di Cairano, Stefano and Ho, Koki and Weiss, Avishai},
  year = 2025,
  journal = {IEEE Transactions on Control Systems Technology},
  pages = {1--7},
  issn = {1063-6536},
  doi = {10.1109/TCST.2025.3614324},
  abstract = {We develop a model predictive control (MPC) policy for station-keeping (SK) on a Near-Rectilinear Halo Orbit (NRHO). The proposed policy achieves full-state tracking of a reference NRHO via a multiple-maneuver control horizon, each spaced 1 r apart to abide by typical mission operation requirements. We prove that the proposed policy is recursively feasible, and perform numerical evaluation in an output-feedback setting by incorporating a navigation filter and realistic operational uncertainties, where the proposed MPC is compared against the state-of-the-art SK algorithm adopted for the Gateway. Our approach successfully maintains the spacecraft in the vicinity of the reference NRHO at a similar cumulative cost as existing SK methods without encountering phase deviation issues, a common drawback of existing methods with one maneuver per revolution.},
  langid = {english},
  keywords = {Finite element analysis,Logic gates,Moon,Navigation,Perturbation methods,Planetary orbits,Predictive control,Signal to noise ratio,Space vehicles,Uncertainty},
  annotation = {titleTranslation: 近直线晕轨道位置保持的等间隔输出反馈模型预测控制\\
abstractTranslation: 我们针对近直线晕轨道（NRHO）上的站位保持（SK）问题，提出了一种模型预测控制（MPC）策略。该策略通过一个多机动控制时域实现参考NRHO的全状态跟踪，各机动间隔为1个轨道周期，以满足典型任务操作要求。我们证明了该策略具有递归可行性，并在输出反馈框架下结合导航滤波器及实际运行不确定性进行了数值评估，将所提出的MPC与Gateway采用的先进SK算法进行了对比。我们的方法成功将航天器维持在参考NRHO附近，其累积成本与现有SK方法相当，且避免了相位偏差问题------这是现有每轨道周期单次机动方法的常见缺陷}
}


@article{chiHomotopyMethodOptimization2017,
  title = {Homotopy Method for Optimization of Variable-Specific-Impulse Low-Thrust Trajectories},
  author = {Chi, Zhemin and Yang, Hongwei and Chen, Shiyu and Li, Junfeng},
  year = 2017,
  month = nov,
  journal = {Astrophysics and Space Science},
  volume = {362},
  number = {11},
  pages = {216--229},
  issn = {0004-640X, 1572-946X},
  doi = {10.1007/s10509-017-3196-7},
  urldate = {2025-09-25},
  abstract = {The homotopy method has been used as a useful tool in solving fuel-optimal trajectories with constantspecific-impulse low thrust. However, the specific impulse is often variable for many practical solar electric powerlimited thrusters. This paper investigates the application of the homotopy method for optimization of variable-specificimpulse low-thrust trajectories. Difficulties arise when the two commonly-used homotopy functions are employed for trajectory optimization. The optimal power throttle level and the optimal specific impulse are coupled with the commonly-used quadratic and logarithmic homotopy functions. To overcome these difficulties, a modified logarithmic homotopy function is proposed to serve as a gateway for trajectory optimization, leading to decoupled expressions of both the optimal power throttle level and the optimal specific impulse. The homotopy method based on this homotopy function is proposed. Numerical simulations validate the feasibility and high efficiency of the proposed method.},
  langid = {english},
  annotation = {titleTranslation: 变量比冲低推力轨迹优化的同伦法\\
abstractTranslation: 同伦法已被用作求解恒定比冲低推力燃料最优轨迹的有效工具。然而，对于许多实际太阳电功率受限推进器，比冲往往是可变的。本文研究了同伦法在变比冲低推力轨迹优化中的应用。当采用两种常用的同伦函数进行轨迹优化时，会出现困难。最优功率节流水平与最优比冲同常用的二次同伦函数和对数同伦函数耦合在一起。为克服这些困难，提出了一种改进的对数同伦函数作为轨迹优化的入口，从而得到了最优功率节流水平和最优比冲的解耦表达式。基于该同伦函数的同伦法被提出。数值仿真验证了所提方法的可行性与高效性},
  file = {/home/ouyangjiahong/Zotero/storage/N272G2IF/Chi 等 - 2017 - Homotopy method for optimization of variable-specific-impulse low-thrust trajectories.pdf}
}


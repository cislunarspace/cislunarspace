@article{davisDynamicsJettisonEarthtoNRHO2025,
  title = {Dynamics of Jettison during Earth-to-{{NRHO}} Transfers},
  author = {Davis, Diane C. and {Zimovan-Spreen}, Emily M. and Scheuerle, Stephen T. and Howell, Kathleen C.},
  year = 2025,
  journal = {Acta Astronautica},
  volume = {Vol.236},
  pages = {78--96},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2025.06.040},
  abstract = {During a spacecraft transit from Earth to the lunar Gateway and back, it may be desirable to jettison objects; examples could include cubesats, docking covers, or docking adapters. It is critical to design safe paths for jettisoned objects that will not litter cislunar space with persistent debris that could threaten sensitive regions on the lunar surface, current and future missions, or the Earth. The dynamical environment in cislunar space is significantly impacted by the simultaneous and complex gravitational influence of the Sun, Earth, and Moon, and designing safe disposal trajectories is nontrivial. This investigation explores safe jettison opportunities and identifies challenges associated with the jettison of objects along a fast transit to the Gateway and back: prior to an outbound powered flyby (OPF) of the Moon, between OPF and orbit insertion, and between NRHO departure and a return powered lunar flyby on the transit back to Earth.},
  langid = {english},
  keywords = {Artemis,Cislunar,Disposal,Gateway,Jettison,NRHO},
  annotation = {titleTranslation: 地月转移至近直线晕轨道过程中的抛射动力学\\
abstractTranslation: 在航天器从地球往返月球门户的过程中，可能需要抛离物体，例如立方星、对接盖或对接适配器。设计安全的抛离轨迹至关重要，以避免在地月空间留下持久碎片，这些碎片可能威胁到月球表面的敏感区域、当前及未来任务，甚至地球。地月空间的动力学环境受到太阳、地球和月球复杂的联合引力作用的显著影响，因此设计安全的弃置轨迹并非易事。本研究探索了安全抛离的可行时机，并识别出在快速往返月球门户过程中抛离物体所面临的相关挑战：包括在月球出站动力飞越之前、出站动力飞越与轨道插入之间，以及NRHO离轨与返回地球途中动力飞越月球之间这几个阶段中的抛离问题}

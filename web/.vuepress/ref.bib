@article{diruzzaChaoticCoexistenceLibrational2023,
  title = {Chaotic Coexistence of Librational and Rotational Dynamics in the Averaged Planar Three-Body Problem},
  author = {Di Ruzza, Sara},
  year = 2023,
  month = aug,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {4},
  pages = {39},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10155-2},
  urldate = {2025-10-01},
  abstract = {Through an appropriate change of reference frame and rescalings of the variables and the parameters introduced, the Hamiltonian of the three-body problem is written as a perturbed Kepler problem. In this system, new Delaunay variables are defined and a suitable configuration of the phase space and the mass parameters is chosen. In such a system, wide regions of librational and rotational motions where orbits are regular and stable are found. Close to the separatrix of these regions, the existence of chaotic motions presenting a double rotational and librational dynamics is proved, numerically, through Poincar\'e sections and the use of FLI.},
  langid = {english},
  annotation = {titleTranslation: 平均平面三体问题中天平动与转动动力学的混沌共存\\
abstractTranslation: 通过适当的参考系变换以及变量与参数的重新标度，三体问题的哈密顿量被写成一个受扰动的开普勒问题。在该系统中，定义了新的Delaunay变量，并选定了相空间与质量参数的合适构型。在此系统中，发现了大范围的平动与转动运动区域，其中的轨道是规则且稳定的。靠近这些区域的分离线附近，通过庞加莱截面和FLI方法数值上证明了存在呈现双重转动-平动动力学的混沌运动。},
  file = {/home/ouyangjiahong/Zotero/storage/HUK2AEQN/Di Ruzza - 2023 - Chaotic coexistence of librational and rotational dynamics in the averaged planar three-body problem.pdf}
}


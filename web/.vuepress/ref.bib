@article{kakoiAccessMarsEarth2014,
  title = {Access to {{Mars}} from {{Earth}}--Moon Libration Point Orbits: Manifold and Direct Options},
  shorttitle = {Access to {{Mars}} from {{Earth}}--Moon Libration Point Orbits},
  author = {Kakoi, Masaki and Howell, Kathleen C. and Folta, David},
  year = 2014,
  month = sep,
  journal = {Acta Astronautica},
  volume = {102},
  pages = {269--286},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2014.06.010},
  urldate = {2026-03-01},
  abstract = {This investigation is focused specifically on transfers from Earth--Moon L1/L2 libration point orbits to Mars. Initially, the analysis is based on the circular restricted three-body problem to utilize the framework of the invariant manifolds. Various departure scenarios are compared, including arcs that leverage manifolds associated with the Sun--Earth L2 orbits as well as non-manifold trajectories. For the manifold options, ballistic transfers from Earth--Moon L2 libration point orbits to Sun--Earth L1/L2 halo orbits are first computed. This autonomous procedure applies to both departure and arrival between the Earth--Moon and Sun--Earth systems. Departure times in the lunar cycle, amplitudes and types of libration point orbits, manifold selection, and the orientation/location of the surface of section all contribute to produce a variety of options. As the destination planet, the ephemeris position for Mars is employed throughout the analysis. The complete transfer is transitioned to the ephemeris model after the initial design phase. Results for multiple departure/arrival scenarios are compared.},
  langid = {english},
  keywords = {Circular restricted three-body problem,Invariant manifolds,Libration point orbits,Mars,Multi-body dynamics,System-to-system transfer},
  annotation = {titleTranslation: 从地月系拉格朗日点轨道前往火星的途径：流形与直接转移方案\\
abstractTranslation: 本次研究聚焦于从地月L1/L2平动点轨道到火星的转移。首先基于圆型限制性三体问题进行分析，以利用不变流形框架。比较了多种出发方案，包括利用日地L2轨道相关流形的弧段以及非流形轨迹。对于流形选项，首先计算从地月L2平动点轨道到日地L1/L2晕轨道的弹道转移。这一自主过程同时适用于地月系统与日地系统之间的出发和到达。月球周期内的出发时刻、平动点轨道的振幅与类型、流形选择以及截面的方位/位置共同构成了多种可供选择的方案。作为目标行星，分析过程中全程采用火星的星历位置。在初始设计阶段结束后，完整的转移过程将转换至星历模型。针对多种出发/到达情景的结果进行了比较。},
  file = {/home/ouyangjiahong/Zotero/storage/NDUJX8DK/Kakoi 等 - 2014 - Access to Mars from Earth–moon libration point orbits manifold and direct options.pdf;/home/ouyangjiahong/Zotero/storage/38VYKUPA/S0094576514002094.html}
}


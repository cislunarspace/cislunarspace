@article{mignardEvolutionLunarOrbit1979,
  title = {Evolution of the Lunar Orbit Revisited .1},
  author = {Mignard, F.},
  year = 1979,
  journal = {Moon and the Planets},
  volume = {Vol.20},
  number = {No.3},
  pages = {301--315},
  doi = {10.1007/BF00907581},
  abstract = {Abstract\&nbsp;\&nbsp;After recalling the contribution of Halley, J. Kepler, and G. Darwin to our understanding of the secular acceleration of the Moon, we establish a set of differential equations for the variation of the semi-major axis, and the inclination of the Moon on the maximum area plane. These equations are obtained without expanding the disturbing function, due to the tidal bulge, in term of the elliptic elements. The equations thus obtained are simple enough to allow us a qualitative discussion of the solution, followed by a numerical integration.The results obtained show the Moon was in the distant past in a retrograde orbit, approaching the Earth, its inclination increasing towards 90\&deg;; once after a closer approach to the Earth, the Moon receeded and it will finally reach an equilibrium point, the orbital and the equatorial planes being blended.The solution of the equations appears as a fascicle of curves, becoming extremely dense as we come nearer to the present. Owing to the high sensitivity of the solution to the initial conditions, a weak disturbance added to our modeled forces may lead to a past situation very different from the conclusion drawn by Goldreich (1966) and MacDonald (1964); the minimal approach distance could be greater than 10 Earth''s radii..},
  langid = {english},
  keywords = {differential-equations,earth-planet,orbits-,solar-system-evolution,torque-},
  annotation = {titleTranslation: 月球轨道演化再探\\
abstractTranslation: 摘要{$\quad$}在回顾了哈雷、开普勒和达尔文对于理解月球长期加速的贡献之后，我们建立了一组微分方程，用于描述月球半长轴及其相对于最大面积平面的倾角变化。这些方程无需将潮汐隆起引起的摄动函数展开为椭圆根数即可获得。所得方程足够简洁，使我们能够对解进行定性讨论，随后进行数值积分。结果表明，在遥远的过去，月球曾处于逆行轨道，向地球靠近，其倾角逐渐增至90{$^\circ$}；在更接近地球之后，月球开始后退，最终将达到一个平衡点，此时轨道平面与赤道平面重合。方程的解呈现为一束曲线，越接近现代，曲线越密集。由于解对初始条件高度敏感，在我们模型作用力上添加微弱的扰动，可能导致与Goldreich（1966）和MacDonald（1964）得出的结论截然不同的过去状态；最小接近距离可能大于10个地球半径。}
}


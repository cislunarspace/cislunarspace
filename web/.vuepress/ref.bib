  shorttitle = {Towards a Robust Calibration and Model Discrepancy Reduction for Digital Twin Spacecraft},
  author = {Sgorlon Gaiatto, Carlo and Antonello, Federico and Segneri, Daniele and Eggleston, James and Sousa, Bruno and Abascal Palacios, Beatriz and Schiavo, Anna and Bartesaghi, Mauro and Maass, Jan and Inojosa, Aniris},
  year = 2024,
  publisher = {SSRN},
  doi = {10.2139/ssrn.4995451},
  urldate = {2025-10-07},
  abstract = {The development of a Digital Twin (DT) for spacecraft represents a key step in the digital transformation of space systems, which has the potential to enable high fidelity simulation capabilities, enhanced mission situational awareness, procedure validation, autonomous operations and predictive maintenance, to mention a few. A DT relies on simulation models with configurable parameters that must be calibrated to accurately represent the behaviour of the real system. Commonly used approaches for the calibration of spacecraft simulation models are optimization-based methods, such as numerical techniques and evolutionary algorithms. However, they do not incorporate uncertainty quantification (UQ), which is a fundamental requirement for the development of accurate and reliable twinning technologies.},
  archiveprefix = {SSRN},
  langid = {english},
  annotation = {titleTranslation: 面向数字孪生航天器的稳健标定与模型差异缩减：在欧洲空间局（ESA）集群任务中的应用\\
abstractTranslation: 航天器数字孪生（DT）的开发是空间系统数字化转型的关键一步，其有望实现高保真仿真能力、增强任务态势感知、流程验证、自主运行与预测性维护等重要功能。数字孪生依赖于可配置参数的仿真模型，这些参数必须经过校准以精确反映真实系统的行为。目前航天器仿真模型校准常用基于优化的方法，如数值技术与进化算法。然而，这些方法未纳入不确定性量化（UQ），而该量化是开发精确可靠孪生技术的基本要求。},
  file = {/home/ouyangjiahong/Zotero/storage/QJ3PCW5M/Sgorlon Gaiatto 等 - 2024 - Towards a robust calibration and model discrepancy reduction for digital twin spacecraft applicatio.pdf}
}


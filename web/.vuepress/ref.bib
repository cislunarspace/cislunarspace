@phdthesis{LiLiJiYuXSheXianMaiChongXingDeHangTianQiZiZhuDaoHangFangFaYanJiu2007,
  type = {{硕士学位论文}},
  title = {{基于X射线脉冲星的航天器自主导航方法研究}},
  author = {{李黎}},
  year = 2007,
  address = {长沙},
  urldate = {2026-03-02},
  abstract = {自主导航是航天器自主运行的关键,是减少测控运行费用、提高任务实现可靠性、确保我国空间能力的核心技术。比较而言,X射线脉冲星作为自然的天体,其运行特性不会受到人为的破坏与干扰;航天器上安装的X射线探测器,不会被激光、太阳致盲,被污染物破坏的风险也低;X射线脉冲星在X波段特征显著,可以把探测器做得很小,且有足够的流量敏感度和时空分辨率。因此,基于X射线脉冲星网络的位置、姿态确定方法稳定、可靠、精度高,是航天器自主导航领域重要的发展方向,同时也可促进天体物理相关学科的发展。基于X射线脉冲星自主导航方法为航天器的自主导航提供了全新的思路。 	本论文探讨航天器利用X射线脉冲星作为信息源,自主定位、授时与姿态确定的原理。重点研究自主定位的位置增量估计方法。论文建立了导航模型,对存在初始误差及不同测量精度条件下的定位精度进行仿真分析,并得到当脉冲到达航天器时间的精度达到0.1{$\mu$}sec,脉冲星方位测量精度达到0.1 arcsech ei时,导航精度(3arcsec{$\sigma$})在1000米之内,当脉冲到达航天器时间的精度达到0.01{$\mu$}sec,脉冲星方位测量精度达到0.0001时,导航精度达到10米量级。通过对脉冲星可见性和导航星GDOP的分析,讨论了轨道根数轨道高度,轨道偏心率和轨道倾角对定位精度的影响,评估该导航方法在不同轨道航天器上应用的效果。 	本文的研究对于我国开展基于X射线脉冲星自主导航的研究有重要意义。},

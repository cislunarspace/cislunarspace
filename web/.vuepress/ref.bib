@article{mingtaoImpulsiveLunarHalo2010a,
  title = {Impulsive Lunar Halo Transfers Using the Stable Manifolds and Lunar Flybys},
  author = {Mingtao, Li and Jianhua, Zheng},
  year = 2010,
  month = may,
  journal = {Acta Astronautica},
  volume = {66},
  number = {9},
  pages = {1481--1492},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2009.11.014},
  urldate = {2026-03-01},
  abstract = {Since the stable manifolds of lunar Halo orbits could not approach the Earth, direct transfers from the Earth parking orbit to the stable manifolds is impossible. Three-impulse lunar Halo transfer using the stable manifolds and lunar flybys is studied in this paper. With an escape maneuver velocity about 3.1km/s, the spacecraft departs from the Earth parking orbit. About 3--10 days later the spacecraft arrives at the vicinity of periselenium from where the spacecraft is injected into the stable manifolds of lunar Halo orbits with a second maneuver velocity about 180--220m/s. After about 3--20 days, the spacecraft is captured into lunar Halo orbits with a third maneuver velocity about 0--160m/s according to the size of the objective Halo orbit. The proposed transfer to lunar Halo orbit requires much lower maneuver velocity than that of direct fast transfer, and requires much shorter flight time than that of WSB transfer to lunar Halo orbit.},
  langid = {english},
  keywords = {Halo orbit,Lunar exploration,Lunar flyby,Stable manifolds,Transfer trajectory},
  annotation = {titleTranslation: 基于稳定流形与月球借力的脉冲式晕轨道转移\\
abstractTranslation: 由于月球Halo轨道的稳定流形无法接近地球，因此从地球停泊轨道直接进入稳定流形是不可行的。本文研究了基于稳定流形与月球飞越的三脉冲月球Halo轨道转移方案。航天器以约3.1 km/s的逃逸机动速度离开地球停泊轨道，约3至10天后抵达近月点附近，在此处以约180--220 m/s的第二次机动速度进入月球Halo轨道的稳定流形。经过约3至20天后，根据目标Halo轨道的大小，以约0--160 m/s的第三次机动速度实现月球Halo轨道捕获。所提出的月球Halo轨道转移方案所需的机动速度远低于直接快速转移，而飞行时间则远短于WSB转移至月球Halo轨道的方式},
  file = {/home/ouyangjiahong/Zotero/storage/WAUNK6R2/Mingtao和Jianhua - 2010 - Impulsive lunar halo transfers using the stable manifolds and lunar flybys.pdf;/home/ouyangjiahong/Zotero/storage/ZST97JJK/Mingtao和Jianhua - 2010 - Impulsive lunar halo transfers using the stable manifolds and lunar flybys.pdf;/home/ouyangjiahong/Zotero/storage/HMU5TS6R/S0094576509005645.html}
}


@article{LiuQiKaoLuWeiZhiYueShuKongJianDeKongDiDaoDanZuiYouDanDaoYuCeFangFa2024,
  title = {{考虑未知约束空间的空地导弹最优弹道预测方法}},
  author = {{刘淇} and {粟华} and {刘松语} and {龚春林}},

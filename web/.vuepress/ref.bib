  author = {Douskos, C. and Kalantonis, V. and Markellos, P.},
  year = 2007,
  month = jan,
  journal = {Astrophysics and Space Science},
  volume = {310},
  pages = {245--249},
  doi = {10.1007/s10509-007-9508-6},
  abstract = {The stability evolution of family f of the planar circular restricted three-body problem in the Earth--Moon case is explored numerically using the Poincar\'e surface of section. It is shown that third order resonances are the main cause of the reduction of the stability region of retrograde satellites. Several branches of family f are also computed and these are seen by the configuration of their family characteristics to roughly determine the stability region. Previous results on smaller mass ratios of primaries are thus extended to the Earth--Moon system.},
  langid = {english},
  annotation = {titleTranslation: 共振效应对逆行卫星稳定性的影响\\
abstractTranslation: 利用庞加莱截面数值研究了地月系平面圆型限制性三体问题中f族的稳定性演化。结果表明，三阶共振是逆行卫星稳定区缩小的主要原因。还计算了f族的若干分支，其族特征构型大致确定了稳定区域。因此，先前关于较小主星质量比的结果被推广到了地月系统。},
  file = {/home/ouyangjiahong/Zotero/storage/XNYF79TZ/Douskos 等 - 2007 - Effects of resonances on the stability of retrograde satellites.pdf}
}


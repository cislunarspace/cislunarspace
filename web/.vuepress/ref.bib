  volume = {43},
  number = {1},
  pages = {198--210},
  doi = {10.19328/j.cnki.2096-8655.2026.01.019},
  urldate = {2026-05-19},
  abstract = {强化学习下的卫星任务规划通过``试错-反馈''机制，学习在资源、时间和轨道约束条件下获得最大化任务收益，并适应动态环境。为更贴近真实多卫星观测多目标的场景，需综合考虑目标成像、星上存储、能源状态、动量轮角动量等多种关键因素。为此，本文提出一种面向复杂环境的多星协同任务规划（CE-MSCMP）框架，系统研究从卫星任务场景的马尔可夫决策过程（MDP）建模到协同规划策略求解的全流程问题。CE-MSCMP框架具有三方面优势：1）构建综合动态环境模型，提升仿真场景的真实性；2）将异构智能体近端策略优化（HAPPO）算法引入多星协同任务规划问题求解，为算法设计提供新范式；3）显著增强规划策略的泛化能力、实时适应性与多目标灵活性，克服传统方法在场景适应性和扩展性方面的局限。仿真结果表明：MDP建模的合理性以及HAPPO算法在卫星任务规划中的有效性得到验证，充分体现了CE-MSCMP框架性能的优越性。},
  langid = {chinese},
  keywords = {,(MDP)},
  annotation = {Fund: 国家重点研发计划资助项目（2022YFB3902701）；},
  file = {/home/ouyangjiahong/Zotero/storage/FGSLIUN6/吴昊恩 等 - 2026 - 基于多智能体深度强化学习的多星协同任务规划架构与算法研究.pdf}
}

@article{WuJianFaJiYuShenDuQiangHuaXueXiDeHangTianQiDuoYueShuGuiBiDongZuoKuaiSuGuiHua2023,
  title = {{基于深度强化学习的航天器多约束规避动作快速规划}},
  author = {{吴健发} and {魏春岭} and {张海博} and {李克行} and {郝仁剑}},
  year = 2023,
  month = apr,
  journal = {空间控制技术与应用（中英文）},
  volume = {49},
  number = {2},
  pages = {1--9},
  issn = {1674-1579},
  doi = {10.3969/j.issn.1674-1579.2023.02.001},
  urldate = {2026-04-05},
  abstract = {航天器规避机动过程中面临多种复杂约束条件, 传统基于数值优化的动作规划方法在处理相应模型和约束条件时存在初值敏感、计算时间较长等问题, 难以对近距离轨道威胁做出及时反应. 针对该问题, 本文提出一种基于深度强化学习的航天器多约束规避动作规划方法. 建立航天器六自由度非线性动力学模型以及相应姿轨机动约束条件; 建立基于双延迟深度确定性策略梯度(TD3)的动作规划方法, 通过TD3训练得到的神经网络在线生成满足多种约束条件的规避机动动作; 构造与规划方法相适配的深度强化学习规范化训练环境, 确保学习训练过程中智能体和环境的有效交互. 仿真结果表明, 所提方法能在预期交会时间仅数十秒的情况下快速实时生成规避动作, 规划周期小于9 ms, 远低于作为对比项的高斯伪谱法.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/LT5W642Y/吴健发 等 - 2023 - 基于深度强化学习的航天器多约束规避动作快速规划.pdf;/home/ouyangjiahong/Zotero/storage/HQRZAUHR/j.issn.1674-1579.2023.02.html}
}


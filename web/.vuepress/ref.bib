@article{liOrbitalMultiplayerPursuitevasion2024,
  title = {Orbital Multi-Player Pursuit-Evasion Game with Deep Reinforcement Learning},
  author = {Li, Zhen-yu and Chen, Si and Zhou, Chenghong and Sun, Wei},
  year = 2024,
  month = dec,
  journal = {Journal of Astronautical Sciences},
  volume = {72},
  number = {1},
  pages = {1--29},
  issn = {2195-0571},
  doi = {10.1007/s40295-024-00474-3},
  urldate = {2026-03-27},
  abstract = {This study investigates an orbital multi-player ``encirclement-capture'' game where multiple pursuers with an encirclement configuration aim to capture an evader, whereas the evader tries to escape all of the pursuers. First, an elliptic encirclement configuration is designed for the pursuers to exploit the initial position advantage. Then, the pursuit-evasion process for capturing the evader is formulated as a discrete Markov game. To acquire superior pursuit-evasion strategies, a distributed distributional deep deterministic policy gradient algorithm is employed and modified for the multi-player game. The main structure of the algorithm is modified as a parallel adversarial-learning framework to achieve efficient two-sided training. Meanwhile, the policy networks and policy-gradient calculation are modified to achieve a decentralized-decision coordination among multiple pursuers. Simulations showed that the pursuers and evader trained via the proposed algorithm can learn `active-cooperation' pursuit strategy and `multi-target' evasion strategy, respectively. Meanwhile, the obtained strategies outperform traditional pursuit-evasion strategies.},
  langid = {english},
  annotation = {titleTranslation: 基于深度强化学习的轨道多人追逃博弈\\
abstractTranslation: 本研究探讨了一种轨道多智能体``包围-捕获''博弈，其中多个追击者以包围构型协同捕获一个逃避者，而逃避者则试图摆脱所有追击者。首先，为追击者设计了一种椭圆包围构型以利用初始位置优势。随后，将捕获逃避者的追逃过程建模为离散马尔可夫博弈。为获取更优的追逃策略，采用并改进了适用于多智能体博弈的分布式深度确定性策略梯度算法。该算法的主体结构被改造为并行对抗学习框架，以实现高效的双边训练。同时，对策略网络及策略梯度计算方法进行改进，使多个追击者能够达成分布式决策协调。仿真结果表明，经所提算法训练的追击者与逃避者分别习得了``主动协作''追击策略与``多目标''逃逸策略，且所得策略优于传统追逃策略。},
  file = {/home/ouyangjiahong/Zotero/storage/KZIRGW3G/Li 等 - 2024 - Orbital multi-player pursuit-evasion game with deep reinforcement learning.pdf}
}

@article{liOrbitalStabilityInvariant2022,
  title = {Orbital Stability and Invariant Manifolds on Distant Retrograde Orbits around Ganymede and Nearby Higher-Period Orbits},
  author = {Li, Qingqing and Tao, Yuming and Jiang, Fanghua},
  year = 2022,
  month = aug,
  journal = {Aerospace},
  volume = {9},
  number = {8},
  pages = {454--475},
  issn = {2226-4310},
  doi = {10.3390/aerospace9080454},
  urldate = {2025-11-20},
  abstract = {In the past few years, distant retrograde orbits (DROs) have become increasingly popular due to their conspicuous stability. Nevertheless, it is this characteristic that results in the challenge to the design of transfer orbits into/out of DROs. This paper investigates the DROs around Ganymede in order to utilize their dynamical characteristics for Jupiter system exploration. In particular, the DRO family is calculated by numerical integration and numerical continuation, higher-period orbits near the DROs are detected using bifurcation theory, and characteristics including orbital stability and invariant manifolds of these orbits are investigated through stability indices and manifold theory. The stability of DROs and the higher-period orbits are first investigated in the circular restricted three-body problem and are then verified in a third-body gravitation perturbation model. The results show that the strong stability of DROs makes it possible to observe the Galilean moons for long periods and that the higher-period orbits that bifurcate from the DROs offer additional insight into the motion of probes approaching/departing from the vicinities of the DROs. Further investigation of the invariant manifolds around higher-period orbits reveals the feasibility of utilizing the DRO family and the nearby unstable structures for multi-target exploration and low-energy transfer between the Galilean moons.},
  langid = {english},
  keywords = {bifurcation,distant retrograde orbit (DRO),invariant manifold,orbital stability},
  annotation = {titleTranslation: 轨道稳定性与不变流形：围绕木卫三的远距离逆行轨道及邻近高周期轨道研究\\
abstractTranslation: 在过去几年中，远距离逆行轨道（DROs）因其显著的稳定性而日益受到关注。然而，正是这一特性给进出DRO的转移轨道设计带来了挑战。本文研究了Ganymede周围的DROs，以期利用其动力学特征进行木星系统探索。具体而言，通过数值积分与数值延拓计算了DRO族，利用分岔理论探测了DRO附近的高周期轨道，并借助稳定性指标与流形理论分析了这些轨道的轨道稳定性及不变流形等特征。首先在圆形限制性三体问题中研究了DROs与高周期轨道的稳定性，随后在第三体引力摄动模型中进行了验证。结果表明，DROs的强稳定性使长期观测伽利略卫星成为可能，而从DRO分岔出的高周期轨道为研究探测器接近/离开DRO附近区域的运动提供了更多视角。进一步对高周期轨道附近不变流形的分析揭示了利用DRO族及其邻近不稳定结构在伽利略卫星之间进行多目标探测与低能量转移的可行性。},
  file = {/home/ouyangjiahong/Zotero/storage/SWN6L6WE/Li 等 - 2022 - Orbital stability and invariant manifolds on distant retrograde orbits around ganymede and nearby hi.pdf}
}


@article{jeongDesignOrbitSimulation2023,
  title = {Design of Orbit Simulation Tool for Lunar Navigation Satellite System},
  author = {Jeong, Hojoon and Park, Jaeuk and Song, Junwon and Kang, Minjae and Kee, Changdon},
  year = 2023,
  journal = {Journal of Positioning, Navigation, and Timing},
  volume = {Vol.12},
  number = {No.4},
  pages = {335--342},
  issn = {2288-8187},
  abstract = {Lunar Navigation Satellite System refers to a constellation of satellite providing PNT services on the moon. LNSS consists of main satellite and navigation satellites. Navigation satellites orbiting around the moon and a main satellite moves the area between the moon and the L2 point. The navigation satellite performs the same role as the Earth's GNSS satellite, and the main satellite communicates with the Earth for time synchronization. Due to the effect of the non-uniform shape of the moon, it is necessary to focus on the influence of the lunar gravitational field when designing the orbit simulation for navigation satellite. Since the main satellite is farther away from the moon than the navigation satellite, both the earth's gravity and the moon's gravity must be considered simultaneously when designing the orbit simulation for main satellite. Therefore, the main satellite orbit simulation must be designed through the three-body problem between the Earth, the moon, and the main satellite. In this paper, the orbit simulation tool for main satellite and navigation satellite required for LNSS was designed. The orbit simulation considers the environment characteristics of the moon. As a result of comparing long-term data (180 days) with the commercial program GMAT, it was confirmed that there was an error of about 1 m.},
  langid = {english},
  keywords = {ELFO,LNSS,NRHO,orbit simulation tool},
  annotation = {titleTranslation: 月球导航卫星系统轨道仿真工具设计\\
abstractTranslation: 月球导航卫星系统是指为月球提供定位、导航与授时服务的一组卫星星座。LNSS由主卫星与导航卫星组成。导航卫星绕月运行，主卫星则在月球与L2点之间的区域运动。导航卫星的功能与地球GNSS卫星类似，而主卫星负责与地球通信以实现时间同步。由于月球形状非均匀的影响，在设计导航卫星轨道仿真时必须重点关注月球引力场的作用。由于主卫星距离月球比导航卫星更远，因此在设计主卫星轨道仿真时需要同时考虑地球引力和月球引力。因此，主卫星轨道仿真必须基于地球、月球与主卫星之间的三体问题进行设计。本文设计了LNSS所需的主卫星与导航卫星轨道仿真工具。该轨道仿真考虑了月球的环境特性。通过与商业程序GMAT的长期数据（180天）对比，确认误差约为1米}
}


@article{zhaoPerturbationEffectSolar2024,
  title = {Perturbation Effect of Solar Radiation Pressure on the Sun-Earth Co-Orbital Motion},
  author = {Zhao, Mingxu and Qiao, Yi Qi Dong},
  year = 2024,
  journal = {Astrophysics and Space Science},
  volume = {Vol.369},
  number = {No.12},
  pages = {1--15},
  doi = {10.1007/s10509-024-04387-3},
  abstract = {Sun-Earth co-orbital motions have an important value in deep space explorations due to their unique orbital characteristics and spatial configurations. In this paper, we investigate the influence of the solar radiation pressure (SRP) on the Sun-Earth co-orbital motion. Firstly, we derive several analytical formulas of the effect of the SRP on orbital elements. Then, based on the analytical results, the orbital variables of perturbed distant retrograde orbits (DROs) and perturbed tadpole (TP) orbits around triangular libration points are studied, and the validity of those conclusions is demonstrated by numerical integration. Finally, we derive an approximate expression to analyze the drift trend of triangular libration points under the SRP and explain the drift phenomena of libration centers of perturbed co-orbital motions. The conclusions obtained in this paper could be used to design control laws of the perturbed Sun-Earth co-orbital motion in the future.},
  langid = {english},
  keywords = {Circular restricted three-body problem,Co-orbital motion,Distant retrograde orbit,Solar radiation pressure,Tadpole orbit},
  annotation = {titleTranslation: 太阳辐射压对日地共轨运动的摄动效应\\
abstractTranslation: 日-地共轨运动因其独特的轨道特性和空间构型，在深空探测中具有重要价值。本文研究太阳辐射压对日-地共轨运动的影响。首先，我们推导了太阳辐射压对轨道要素影响的若干解析公式。然后，基于解析结果，研究了受扰动的远距离逆行轨道（DROs）和三角平动点附近受扰动的蝌蚪（TP）轨道的轨道变化，并通过数值积分验证了这些结论的有效性。最后，我们推导了一个近似表达式，用以分析太阳辐射压下三角平动点的漂移趋势，并解释了受扰共轨运动平动中心的漂移现象。本文所得结论可用于未来设计受扰日-地共轨运动的控制律。}
}

@article{zhaoPRDMADDPGEfficientLearningbased2023,
  title = {{{PRD-MADDPG}}: An Efficient Learning-Based Algorithm for Orbital Pursuit-Evasion Game with Impulsive Maneuvers},
  shorttitle = {Prd-Maddpg},
  author = {Zhao, Liran and Zhang, Yulin and Dang, Zhaohui},
  year = 2023,
  month = jul,
  journal = {Advances in Space Research},
  volume = {72},
  number = {2},
  pages = {211--230},
  issn = {02731177},
  doi = {10.1016/j.asr.2023.03.014},
  urldate = {2026-03-27},
  abstract = {This paper comprehensively investigates the problem of impulsive orbital pursuit-evasion games (OPEGs) by using an artificial intelligence-based approach. First, the mathematical model for the impulsive OPEGs in which the pursuer and evader both perform their orbital maneuvers by imposing the impulsive velocity increments is constructed. Second, the problem of impulsive OPEGs is transformed into a bilateral optimization problem with a minimum--maximum optimization index in terms of terminal time and multiple constraints such as maneuverability, total fuel consumption, and mission time, etc. To determine the optimal impulsive maneuvers for both sides, a PRD-MADDPG (Predict-Reward-Detect Multi-Agent Deep Deterministic Policy Gradient) algorithm in the frame of multi-agent reinforcement learning is designed. This novel algorithm uses the basic MADDPG to achieve the strategies training and learning, and applies the supplemental PRD to predict the change of game state during the interval between two adjacent impulsive maneuvers and incorporate these information into the algorithm training in the form of predicted reward. Finally, some pursuit-evasion missions near the Geosynchronous Earth Orbit are numerically analyzed to verify the validness and effectiveness of the algorithm. The results prove that the PRD-MADDPG algorithm is very efficient to find applicable strategies even considering rather complex constraints. It is also shown that the learning-based strategies can be effectively applied in the extended scenarios which are not seen in the training process.},
  langid = {english},
  annotation = {titleTranslation: PRD-MADDPG：一种用于含脉冲机动的轨道追逃博弈的高效学习算法\\
abstractTranslation: 本文采用基于人工智能的方法，全面研究了脉冲式轨道追逃博弈（OPEGs）问题。首先，构建了追击器和逃逸器均通过施加脉冲速度增量进行轨道机动的脉冲式OPEGs数学模型。其次，将脉冲式OPEGs问题转化为一个以终端时间为最小-最大优化指标，并受机动能力、总燃料消耗、任务时间等多重约束的双边优化问题。为确定双方的最优脉冲机动策略，在多智能体强化学习框架下设计了PRD-MADDPG（预测-奖励-检测多智能体深度确定性策略梯度）算法。该新颖算法利用基础MADDPG实现策略训练与学习，并应用补充的PRD模块预测相邻两次脉冲机动间隔内博弈状态的变化，以预测奖励的形式将这些信息融入算法训练。最后，针对地球同步轨道附近的若干追逃任务进行了数值分析，验证了算法的有效性与实用性。结果表明，即使在考虑较为复杂约束的情况下，PRD-MADDPG算法也能高效地寻得可行策略；此外，基于学习得到的策略可有效应用于未在训练过程中出现的扩展场景。},
  file = {/home/ouyangjiahong/Zotero/storage/T49LLP5D/Zhao 等 - 2023 - PRD-MADDPG an efficient learning-based algorithm for orbital pursuit-evasion game with impulsive ma.pdf;/home/ouyangjiahong/Zotero/storage/YNM8VYUD/Zhao 等 - 2023 - PRD-MADDPG An efficient learning-based algorithm for orbital pursuit-evasion game with impulsive ma.pdf}
}


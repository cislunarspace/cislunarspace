@article{jiaConjunctionTimeCollision2023,
  title = {Conjunction Time and Collision Probability Calculation Based on Bayesian Optimization},
  author = {Jia, Bin and Xin, Ming},
  year = 2023,
  month = jan,
  journal = {Journal of Spacecraft and Rockets},
  volume = {60},
  number = {1},
  pages = {315--325},
  issn = {0022-4650, 1533-6794},
  doi = {10.2514/1.A35453},
  urldate = {2026-05-11},
  abstract = {Collision probability calculation is critical to space situational awareness or space traffic management. To determine the collision probability, the conjunction time needs to be determined first, but both collision probability and conjunction time usually exist large uncertainties. In this paper, a continuous representation of the polynomial chaos expansion (PCE)-based surrogate model is used to describe the uncertainty of space objects along with time. This PCE model facilitates the propagation of sampling points representing orbital uncertainty at any time. A machine learning-based Bayesian optimization method is employed to determine the conjunction time and then the collision probability. A data-driven Gaussian process regression model is built to approximate the Hausdorff distance, which is a distance metric between two space objects with uncertainty and is used as an objective function for Bayesian optimization. The proposed PCE model and Bayesian optimization do not require the Gaussian assumption and provide a general framework to calculate the conjunction time and collision probability. Two numerical experiments are used to show the effectiveness of the proposed algorithm and its close performance to the traditional Monte Carlo sampling-based method.},
  langid = {english},
  annotation = {titleTranslation: 基于贝叶斯优化的交会时刻与碰撞概率计算\\
abstractTranslation: 碰撞概率计算对于空间态势感知或空间交通管理至关重要。为确定碰撞概率，首先需要确定交会时间，但两者通常存在较大的不确定性。本文采用基于多项式混沌展开（PCE）代理模型的连续表示来描述空间物体随时间变化的不确定性。该PCE模型有助于传播代表任意时刻轨道不确定性的采样点。通过基于机器学习的贝叶斯优化方法确定交会时间，进而计算碰撞概率。构建数据驱动的高斯过程回归模型来近似豪斯多夫距离------一种衡量两个具有不确定性的空间物体之间距离的指标，并将其作为贝叶斯优化的目标函数。所提出的PCE模型和贝叶斯优化方法不依赖高斯假设，为计算交会时间和碰撞概率提供了通用框架。通过两个数值实验验证了所提算法的有效性，并表明其性能接近传统的基于蒙特卡洛采样的方法。}
}

@article{JiaFeiLeiCaiYongBianSuKongZhiLiJuTuoLuoDeHangTianQiZiTaiGenZongYanJiu2012,
  title = {采用变速控制力矩陀螺的航天器姿态跟踪研究},

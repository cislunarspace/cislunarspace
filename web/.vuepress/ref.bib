@article{dealmeidajuniorFast2impulseNonKeplerian2021,
  title = {Fast 2-Impulse Non-{{Keplerian}} Orbit Transfer Using the {{Theory}} of {{Functional Connections}}},
  author = {{de Almeida Junior}, Allan K. and Johnston, Hunter and Leake, Carl and Mortari, Daniele},
  year = 2021,
  month = feb,
  journal = {European Physical Journal Plus},
  volume = {136},
  number = {2},
  pages = {223},
  issn = {2190-5444},
  doi = {10.1140/epjp/s13360-021-01151-2},
  urldate = {2026-02-04},
  abstract = {This study applies a new approach, the Theory of Functional Connections (TFC), to solve the two-point boundary-value problem (TPBVP) in non-Keplerian orbit transfer. The perturbations considered are drag, solar radiation pressure, higher-order gravitational potential harmonic terms, and multiple bodies. The proposed approach is applied to Earth-to-Moon transfers and obtains exact boundary condition satisfaction and with very fast convergence. Thanks to this highly efficient approach, perturbed pork-chop plots of Earth-to-Moon transfers are generated, and individual analyses on the transfers' parameters are easily done at low computational costs. The minimum fuel analysis is provided in terms of the time of flight, thrust application points, and relative geometry of the Moon and Sun. The transfer costs obtained are in agreement with the literature's best solutions and in some cases are even slightly better.},
  langid = {english},
  annotation = {titleTranslation: 基于函数连接理论的快速双脉冲非开普勒轨道转移\\
abstractTranslation: 本研究采用一种新方法------函数连接理论（TFC），来解决非开普勒轨道转移中的两点边值问题（TPBVP）。所考虑的摄动因素包括阻力、太阳辐射压、高阶引力势谐波项以及多体引力。该方法应用于地球至月球转移任务，能够精确满足边界条件，且收敛速度极快。借助这一高效方法，生成了地球至月球转移的摄动猪排图，并能够在较低计算成本下轻松对转移参数进行单独分析。基于飞行时间、推力施加点以及月球与太阳的相对几何关系，给出了最小燃料消耗分析。所得转移成本与文献中的最优解一致，且在部分情况下甚至略优。},
  file = {/home/ouyangjiahong/Zotero/storage/I6W7B9P8/de Almeida Junior 等 - 2021 - Fast 2-impulse non-Keplerian orbit transfer using the Theory of Functional Connections.pdf}
}

@article{dealmeidaOrbitTransferUsing2023,
  title = {Orbit Transfer Using Theory of Functional Connections via Change of Variables},
  author = {{de Almeida}, Allan K. and Prado, Antonio F. B. A. and Mortari, Daniele},
  year = 2023,
  month = dec,
  journal = {European Physical Journal Special Topics},
  volume = {232},
  number = {18},
  pages = {3161--3173},
  issn = {1951-6401},
  doi = {10.1140/epjs/s11734-023-01013-1},
  urldate = {2026-02-04},
  abstract = {This work shows that a class of astrodynamics problems subject to mission constraints can be efficiently solved using the Theory of Functional Connections (TFC) mathematical framework by a specific change of coordinates. In these problems, the constraints are initially written in nonlinear and coupled mathematical forms using classical rectangular coordinates. The symmetries of the constrained problem are used to select a new system of coordinates that transforms the nonlinear constraints into linear. This change of coordinates is also used to isolate the components of the constraints. This way the TFC technique can be used to solve the ordinary differential equations governing orbit transfer problems subject to mission constraints. Specifically, this paper shows how to apply the change of coordinates method to the perturbed Hohmann-type and the one-tangent burn transfer problems.},
  langid = {english},
  annotation = {titleTranslation: 基于变量变换的功能连接理论轨道转移\\
abstractTranslation: 本工作表明，通过特定的坐标变换，利用函数连接理论（TFC）数学框架可高效求解一类受任务约束的天体动力学问题。在此类问题中，约束条件最初以经典直角坐标形式呈现为非线性和耦合的数学表达。利用受约束问题的对称性，选择新的坐标系可将非线性约束转化为线性约束，同时该坐标变换还可用于分离约束的各个分量。由此，TFC技术可被用于求解受任务约束的轨道转移问题中的常微分方程。具体而言，本文展示了如何将坐标变换方法应用于受扰动的霍曼型转移和单切机动转移问题},
  file = {/home/ouyangjiahong/Zotero/storage/ZHU36ATT/de Almeida 等 - 2023 - Orbit transfer using theory of functional connections via change of variables.pdf}
}


@inproceedings{uedaMultidisciplinarySystemDesign2019,
  title = {Multidisciplinary System Design Optimization Approach for Lunar Surface Access from Cislunar Orbit},
  booktitle = {{{AIAA SciTech}} Forum and Exposition},
  author = {Ueda, Satoshi and Ikenaga, Toshinori and Ujiie, Ryo},
  year = 2019,
  address = {San Diego},
  abstract = {The families of near rectilinear halo orbit (NRHO) around the Earth-Moon Lagrange 2 (EML2) point offer favorable features for cislunar missions such as a lunar-orbit space station. Lunar surface access via the station is a promising mission that utilizes the station as a platform for further space exploration. This study addresses a mission design methodology employing multidisciplinary system design optimization (MSDO). The methodology is applied to an EML2 NRHO-based lunar surface access mission that includes transfer to low lunar orbit (LLO) and landing from LLO. The methodology consists of two steps: (1) design optimization for both transfer orbit and landing trajectory, and (2) MSDO by considering the orbits, eclipse, and subsystem mass using the surrogate models trained in the preceding step. A Pareto optimal front related to payload mass and total time of flight resulting from the MSDO study has indicated the most optimal design points in terms of balanced mission design.},
  langid = {english},
  annotation = {titleTranslation: 从地月轨道实现月面登陆的多学科系统设计优化方法}
}


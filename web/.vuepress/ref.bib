@phdthesis{PengChenYuanDuoYueShuDuoXingFeiYueXunChaRenWuGuiHuaYuFenXi2021,
  type = {{硕士学位论文}},
  title = {{多约束多星飞越巡察任务规划与分析}},
  author = {{彭晨远}},
  year = 2021,
  address = {长沙},
  doi = {10.27052/d.cnki.gzjgu.2021.001006},
  abstract = {多星飞越巡察可以在短时间内以较少的推进剂消耗获取大量空间目标的信息,是天基态势感知等任务的重要发展方向。近距离巡察时,相机等敏感器的工作要求给飞越末端状态带来了巡察约束,轨道转移过程中还存在最低高度、最大单次机动量等约束条件。当这些约束与指派、次序、机动变量耦合在一起时,该类规划问题的求解变得异常困难。本文开展多约束多星飞越巡察的任务规划与分析研究,主要研究内容和成果如下。1.提出了基于约束传播表征的可行域和飞越巡察可行性快速判断算法首先分析了单次飞越巡察任务流程与约束条件,将阳光视线角、相对速度、单次机动上限和近地点高度等多种约束进行解析传播表征,精简为关于末端飞行方向角和速度大小的可行域,进而提出了一种飞越巡察可行性快速判断方法。对两个典型场景的仿真应用表明:所提出的算法准确性在93\%以上,与遗传算法相比,单次判断计算效率大幅增加。所表征的可行域形式简洁,为约束难满足问题的算法设计打下了基础。2.提出了基于混合编码遗传算法的多约束多星飞越巡察序列优化方法对于约束难满足问题的序列优化,结合表征的可行域和设计变量的转换,提出基于混合编码遗传算法的任务时间最短两层优化方法,外层搜索巡察次序、转移时间等变量,内层搜索单次任务的机动时刻。对于推进剂消耗最省问题,提出基于约束修复的单层混合编码遗传算法,将不满足的约束修复到可行域内再进行优化。仿真结果表明:当约束难满足时,所提出的两层优化方法和基于约束修复的方法在优化效果上都优于单层无修复方法,且计算效率是单层无修复方法的两倍以上;约束参数中,阳光视线角约束对结果的影响较大。3.提出了基于贪婪搜索的多约束多星飞越巡察目标筛选和任务分配方法对于大规模目标筛选问题,以飞越巡察目标数量最多为目标函数,结合可行性估算方法,研究了多星飞越巡察的启发式贪婪筛选方法。对于多星飞越巡察的任务分配问题,基于共面调相机动的摄动轨道积分模型,研究了结合任务指标决策表的任务平台-目标贪婪分配方法。仿真结果表明:在获得飞越目标数量相同的情况下,启发式贪婪筛选方法求解效率是无初步估算方法的约1.33倍;任务平台-目标贪婪分配方法可以在0.5\%的计算时间内获得比混合编码遗传算法略优的结果。本论文对考虑巡察点与过程复杂约束的多星飞越巡察任务的约束传播分析、序列规划、目标筛选与任务指派等问题开展了研究,所提出的方法可为天基态势感知等相关任务的设计提供参考。},
  collaborator = {{罗亚中} and {张进}},
  langid = {chinese},
  school = {国防科技大学},
  annotation = {CNKICite: 1},
  file = {/home/ouyangjiahong/Zotero/storage/HLGPMJV9/彭晨远 - 2021 - 多约束多星飞越巡察任务规划与分析.pdf}
}


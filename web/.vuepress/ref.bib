@inproceedings{bassettConceptAnalysisInspace2017,
  title = {Concept Analysis for an In-Space Assembly Concept Using {{SEP}} to Transfer Payloads between {{LEO}} to {{LDRO}}},
  booktitle = {{{AIAA Space}} and {{Astronautics Forum}} and {{Exposition}}},
  author = {Bassett, G. Z. and Finch, P. and Kwan, H.},
  year = 2017,
  series = {{{AIAA Space}} and {{Astronautics Forum}} and {{Exposition}}},
  address = {Orlando, FL, USA},
  doi = {10.2514/6.2017-5266},
  abstract = {As humans extend their presence beyond low Earth orbit (LEO), reaching distant planets and moons, the need for a more efficient method for sending large spacecraft into space is essential. The assembly of the International Space Station (ISS) took 42 launches over a span of 18 years, indicating an exigent need for autonomous robotic in-space assembly (ISA) of spacecraft. Autonomous robotics is a key technology that allows for missions to be designed so that spacecraft components can be aggregated in one location and then assembled in space. The focus of this paper is to present the analysis for an ISA concept of spacecraft, particularly tugs, that are propelled by solar electric propulsion (SEP) and transfer between LEO and a lunar Distant Retrograde Orbit (LDRO). The proposed concept uses SpaceX's Falcon 9 as the launch vehicle, NASA NEXT as the thrusters, Orbital ATK's MegaFlex for the solar arrays, a scaled down version of the Canadarm, and an in-house designed mechanisms to assist in the docking procedure during in-space assembly. NASA's Evolvable Mars Campaign (EMC) plans to use LDRO to stage space systems for various missions including lunar excursions, asteroid rendezvous, and human Mars exploration. While space operations in LEO are sufficiently vetted, large-scale SEP, in-space assembly of spacecraft, and LEO to LDRO transfers are some of the most important technology foci that require greater maturity in order to send humans to Mars and elsewhere.},
  langid = {english},
  annotation = {titleTranslation: 采用太阳能电推进（SEP）在近地轨道（LEO）与月球远距离逆行轨道（LDRO）间转移载荷的在轨组装方案概念分析}
}


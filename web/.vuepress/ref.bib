  title = {{星历模型下基于多重打靶拼接的长期近直线晕轨道设计方法}},
  author = {{朱彦伟} and {蒋昕玙} and {陈昱桔} and {郑清标} and {王鹏}},
  year = 2026,
  month = apr,

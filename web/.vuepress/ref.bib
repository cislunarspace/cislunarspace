  doi = {10.1016/j.asr.2025.05.094},
  urldate = {2026-04-23},
  abstract = {This research investigates the initial orbit determination (IOD) for objects moving in the cislunar space, using optical observations from both ground- and space-based stations. The proposed method, referred to as the perturbed-Laplace (PL) method, is derived in an approach the same as the conventional Laplace's method, i.e., the IOD problem is transformed into solving a polynomial equation of the pseudo range. The difference is that the polynomial equation is more complex. This study investigates the number of solutions of the polynomial equation. Moreover, key issues associated with the PL method are studied, including the choice of the fitting polynomial to get the first and second derivatives of the optical data, and the influence of the observation errors on the IOD results. For the orbit types studied in this work, we recommend to use a fitting polynomial of order 8 for arc lengths greater than 4~h, and a lower order for shorter arc lengths.},
  langid = {english},
  keywords = {Cislunar space,Initial Orbit Determination,Laplace' Method,Polynomials},
  annotation = {titleTranslation: 地月空间初始轨道确定的多解问题\\
abstractTranslation: 本研究探讨了利用地面和天基光学观测数据对地月空间运动目标进行初始轨道确定（IOD）的问题。所提出的方法称为扰动拉普拉斯（PL）方法，其推导思路与传统拉普拉斯方法相同，即将IOD问题转化为求解一个关于伪距的多项式方程。区别在于该多项式方程更为复杂。本研究分析了该多项式方程的解的数量。此外，还研究了与PL方法相关的关键问题，包括用于获取光学数据一阶和二阶导数的拟合多项式选择，以及观测误差对IOD结果的影响。对于本研究涉及的轨道类型，建议弧段长度大于4小时时使用8阶拟合多项式，较短弧段则使用更低阶的拟合多项式}
}

@article{liuNoteComputationMultirevolution2025,
  title = {A Note on the Computation of Multi-Revolution {{NRHO}} under the Ephemeris Model},
  author = {Liu, Lei and Liu, Yong},
  year = 2025,
  month = feb,
  journal = {Advances in Space Research},
  volume = {75},
  number = {3},
  pages = {2889--2907},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2024.11.001},
  urldate = {2026-01-11},
  abstract = {Near Rectilinear Halo Orbits (NRHOs) are vital to manned lunar and deep space exploration, which nowadays are of great interest for different space agencies and in particular with regard to the future space station. However, the required computation of multi-revolution NRHO under the ephemeris model is difficult, especially for the NRHOs with low periapsis relative to the secondary body. This paper explores this issue from the perspective of multiple shooting, first analyzing the influence of the state transition matrices by means of their condition number and then, focusing on a good selection of trajectory segments with suitable patch points. The methodology considerably improves the convergence and the computation under the ephemeris model. Numerical simulations show that at least 30 revolutions can be achieved for NRHOs with perilune radius of less than 12,000~km around L1 or period less than 8.8~days around L2; meanwhile, the number of segments used can be as low as 2 for each single revolution. As for the position of patch points, the first and last points of each revolution should be apart from the Moon, and the distance can be reduced only when the number of segments increases. The proposed method requires no dedicated optimization algorithm or commercial software to produce the multi-revolution NRHOs.},
  langid = {english},
  keywords = {Ephemeris model,Libration point,Multiple shooting,Near rectilinear halo orbit,Orbit computation},
  annotation = {titleTranslation: 关于星历模型下多圈NRHO轨道计算的说明\\
abstractTranslation: 近直线晕轨道（NRHOs）对于载人月球及深空探索至关重要，目前各航天机构对此兴趣浓厚，尤其是在未来空间站相关的应用中。然而，在星历模型下计算多圈NRHO难度较大，特别是对于近心点相对次天体较低的NRHO。本文从多重打靶法的角度探讨该问题，首先通过条件数分析状态转移矩阵的影响，然后聚焦于合理选取轨迹段及合适的拼接点。该方法显著提升了星历模型下的收敛性与计算效率。数值仿真表明，对于近月点半径小于12,000 km的L1点NRHO或周期小于8.8天的L2点NRHO，可实现至少30圈的计算；同时，每单圈使用的轨迹段数可低至2段。至于拼接点位置，每圈的首尾点应远离月球，仅在增加轨迹段数时方可缩短该距离。本方法无需使用专用优化算法或商业软件即可生成多圈NRHO。},
  file = {/home/ouyangjiahong/Zotero/storage/7ALJ6XPI/Liu和Liu - 2025 - A note on the computation of multi-revolution NRHO under the ephemeris model.pdf;/home/ouyangjiahong/Zotero/storage/AJIS26NU/S0273117724011189.html}
}

@article{liuNovelAutonomousNavigation2024,
  title = {A Novel Autonomous Navigation Constellation in the {{Earth}}--Moon System},
  author = {Liu, Bin and Li, Hengnian and Hou, Xiyun and Yang, Jie and Huyan, Zongbo},
  year = 2024,
  month = sep,
  journal = {Open Astronomy},
  volume = {33},
  number = {1},
  pages = {20220203},
  issn = {2543-6376},
  doi = {10.1515/astro-2022-0203},
  urldate = {2025-09-25},
  abstract = {With more and more activities in cislunar space and deep space, a navigation system that can provide autonomous navigation service for cislunar or even deep space missions has become an urgent need. This article proposes a new type of navigation constellation which is placed on two kinds of special orbits, namely the dynamical substitutes around the triangular libration points and the distant retrograde orbits (DROs). Both types of orbits have the same characteristics of long-term stability under the full force model, so no orbit control is needed and it can operate autonomously without ground support. First, using inter-satellite range data, the autonomous orbit determination between navigation satellites on the dynamical substitutes and the DROs is investigated under the full force model. Then, taking a translunar orbit as an example, the constellation's navigation performance based on inter-satellite range observation is evaluated. With range errors of 1, 10, and 100 m, respectively, the navigation capability of the constellation is successfully verified in the sense that the accuracy of the determined orbit reaches the level of the observation data. From the viewpoint of stable autonomous navigation, the current results are meaningful and deserve further consideration when deploying the navigation constellation in the Earth--Moon system.},
  copyright = {http://creativecommons.org/licenses/by/4.0},
  langid = {english},
  annotation = {titleTranslation: 地月系统中一种新颖的自主导航星座。\\
abstractTranslation: 随着地月空间及深空活动日益增多，能够为地月甚至深空任务提供自主导航服务的导航系统已成为迫切需求。本文提出一种新型导航星座，该星座部署于两类特殊轨道：一类是三角平动点附近的动力学替代轨道，另一类是远距离逆行轨道（DROs）。这两种轨道在全摄动力模型下均具有长期稳定的特性，因此无需轨道控制，且可在无地面支持的情况下自主运行。首先，利用星间测距数据，研究动力学替代轨道与DROs上导航卫星之间的自主定轨问题（基于全摄动力模型）。随后，以地月转移轨道为例，评估基于星间测距观测的星座导航性能。在测距误差分别为1米、10米和100米时，成功验证了该星座的导航能力，即定轨精度达到观测数据水平。从稳定自主导航的角度看，当前结果具有意义，值得在地球---月球系统部署导航星座时进一步考虑},
  file = {/home/ouyangjiahong/Zotero/storage/ACB3IFWN/Liu 等 - 2024 - A novel autonomous navigation constellation in the Earth–moon system.pdf}
}

@article{liuOptimalImpulsiveRendezvous2024,
  title = {Optimal Impulsive Rendezvous for Approaching Geostationary Earth Orbit Targets with Terminal Configuration Constraints},
  author = {Liu, Zhaoyang and Hao, Yutao and Xu, Sihan and Dang, Zhaohui},
  year = 2024,
  month = jan,
  journal = {Space: Science \& Technology},
  volume = {4},
  pages = {157--171},
  issn = {2692-7659},
  doi = {10.34133/space.0157},
  urldate = {2025-09-25},
  abstract = {This paper explores multi-impulse trajectory design for approaching Geostationary Earth Orbit (GEO) targets, emphasizing the attainment of a 2:1 elliptical relative orbit for close inspection. The intricate optimization challenge includes dynamic and terminal constraints, as well as total mission duration limitations. Critical variables like transfer duration, impulse count, timing, and entry point are optimized using genetic algorithms to minimize velocity increment requirements. These optimal values are influenced by uncertain terminal states constrained by the 2:1 circling orbit. To address these complexities, the paper leverages a linear state transition matrix from relative orbital dynamics to formulate a multi-impulse optimization model. Additionally, a differential correction-based iterative approach mitigates nonlinear dynamics' impact on terminal rendezvous errors. Through theoretical analysis and simulations, the study elucidates variations in optimization criteria, particularly in GEO missions with multiple impulses, and identifies optimal entry points for different impulse counts. The proposed models and methodologies offer theoretical insights for future GEO orbit approaching missions and potential applications in various space maneuver tasks.},
  langid = {english},
  annotation = {titleTranslation: 终端构型约束下逼近地球静止轨道目标的最优脉冲交会。\\
abstractTranslation: 本文探讨了针对地球静止轨道（GEO）目标的多脉冲轨迹设计，重点实现2:1椭圆相对轨道以进行近距离检查。这一复杂的优化问题涉及动态约束、终端约束以及总任务时长限制。通过遗传算法对转移时长、脉冲次数、时机及进入点等关键变量进行优化，以最小化速度增量需求。这些最优值受限于由2:1环绕轨道所制约的不确定终端状态。为应对这些复杂性，本文利用相对轨道动力学的线性状态转移矩阵，构建了一个多脉冲优化模型。此外，基于微分修正的迭代方法减轻了非线性动力学对终端交会误差的影响。通过理论分析与仿真，本研究揭示了优化准则的变化规律，特别是在多脉冲GEO任务中，并识别了不同脉冲次数下的最优进入点。所提出的模型与方法可为未来GEO接近任务及其他各类空间机动任务提供理论参考},
  file = {/home/ouyangjiahong/Zotero/storage/7MWBMAK9/Liu 等 - 2024 - Optimal impulsive rendezvous for approaching geostationary earth orbit targets with terminal configu.pdf}
}

@inproceedings{liuOrbitalThreeplayerDifferential2016,
  title = {Orbital Three-Player Differential Game Using Semi-Direct Collocation with Nonlinear Programming},
  booktitle = {2016 2nd {{International Conference}} on {{Control Science}} and {{Systems Engineering}} ({{ICCSSE}})},
  author = {Liu, Yifang and Li, Renfu and Wang, Shuquan},
  year = 2016,
  month = jul,
  pages = {217--222},
  publisher = {IEEE},
  address = {Singapore, Singapore},
  doi = {10.1109/CCSSE.2016.7784385},
  urldate = {2025-10-15},
  abstract = {An orbital three-player differential game among Target spacecraft, Pursuer spacecraft and Evader spacecraft is studied in this work. It is assumed that Target spacecraft runs in its orbit without the ability of maneuver, while Pursuer spacecraft and Evader spacecraft have continuous maneuverability. There are opposing objectives between Pursuer spacecraft and Evader spacecraft. The objective of Pursuer spacecraft is to keep Evader spacecraft far away from Target spacecraft while Evader spacecraft tries its best to shorten the distance from it to Target spacecraft prior to being intercepted. The orbital three-player differential game terminates when Evader spacecraft performs successful interception of Target spacecraft or it is intercepted by Pursuer spacecraft. The semi-direct collocation with nonlinear programming incorporated with NSGA-II algorithm which provides the initial guess is employed to solve the current three-player differential game. Numerical simulation was provided to verify the availability of the algorithm in finding the optimal solution of the orbital three-player differential game presented in this paper, and the results show that this work will be useful to some practical applications.},
  isbn = {978-1-4673-9872-5},
  langid = {english},
  annotation = {titleTranslation: 基于非线性规划的半直接配点法轨道三体微分博弈研究},
  file = {/home/ouyangjiahong/Zotero/storage/2K5DAAPT/Liu 等 - 2016 - Orbital three-player differential game using semi-direct collocation with nonlinear programming.pdf}
}

@phdthesis{LiuPengJiYuTianJiTanCeQiDeYueQiuWeiXingDingGuiWenTi2014,
  type = {{硕士学位论文}},
  title = {{基于天基探测器的月球卫星定轨问题}},
  author = {{刘鹏}},
  year = 2014,
  address = {南京},
  urldate = {2025-12-12},
  abstract = {20世纪60年代开始,美国和前苏联展开了以月球探测为中心的空间竞赛。自1958年至1976年期间,美国和前苏联共发射83颗月球探测器,进行了载人和不载人的登月任务,月球探测取得了划时代的成就。20世纪80年代以来,世界上空间探测技术和月球科学研究达到了新的阶段,美国分别成功发射了`"Clementine"和"Lunar Prospector"月球探测器对月进行高精度测量。进入21世纪,世界主要航天大国或组织纷纷开展了月球探测任务。欧洲空间局(ESA)、日本空间局(JAXA)印度空间研究组织(ISRO)都发射了其首颗月球探测器(SMART-1, Selene-1, Chandrayaan-1)。美国航空航天局(NASA)也发射了三颗月球探测器(LRO, LCROSS, GRAIL).与此同时,我国相继发射了``嫦娥一号''、``嫦娥二号''和``嫦娥三号''月球探测器,顺利完成了我国探月工程``绕''、``落''两个阶段的任务。在上述这些月球探测中,探测器的精确轨道是探测任务能否顺利成功的关键。通常月球卫星的测轨定轨是由地面测控站(如深空探测网DSN)负责,我国的``嫦娥一号''就是利用USB测距测速和VLBI测角两种技术手段,共同完成了我国第一颗探月卫星的测控工作。然而,月球距地球约38万公里,这一较远的距离给测控系统的数据传输带来了巨大的挑战,与日俱增的卫星数目也增加了地面测站的负荷。另外,月球的公转周期与自转周期相同,因此月球几乎总以一面朝向地球,当月球卫星运行到月球背面时,会被月球遮挡,导致地面测站对月球卫星的观测不连续,使得月球卫星的导航定位受到影响。针对上述月球卫星定轨问题,美国戈达德空间飞行中心的Beckman和科罗拉多大学的部分研究人员提出了使用星间测距技术实现月球卫星自主定轨的方案(Linked, Autonomous, Interplanetary Satellite Orbit Navigation,简称LiAISON),国内也有部分学者进行了相关研究(例如解放军信息工程大学的杜兰教授课题组)。这些工作的主要思想是利用地---月系圆型限制性三体问题的共线平动点(collinear libration point,文中简记为CLP),通过月球卫星与定点在共线平动点附近的探测器之间的星间链路数据,来达到同时定出月球卫星与共线平动点探测器的轨道的目的。由于定轨过程理论上并不依赖地面站的支持,因此是真正意义上的自主定轨。本硕士论...},
  collaborator = {{侯锡云}},
  langid = {chinese},
  school = {南京大学},
  keywords = {,GEO/IGSO},
  annotation = {album: 工程科技II辑\\
CLC: V412.41;V448.2\\
dbcode: CMFD\\
dbname: CMFD201601\\
download: 561\\
filename: 1015310292.nh\\
major: 天体测量与天体力学},
  file = {/home/ouyangjiahong/Zotero/storage/PTDKY5LP/刘鹏 - 2014 - 基于天基探测器的月球卫星定轨问题.pdf}
}


@article{silvaExtendingGeostationaryOrbit2019,
  title = {Extending Geostationary Orbit Missions for Lunar Observations},
  author = {Silva, William R. and Terra, Maisa De O. and Celestino, Claudia C. and De Melo, Cristiano F.},
  year = 2019,
  month = oct,
  journal = {Journal of Physics: Conference Series},
  volume = {1365},
  number = {1},
  pages = {012003},
  issn = {1742-6588, 1742-6596},
  doi = {10.1088/1742-6596/1365/1/012003},
  urldate = {2025-11-27},
  abstract = {This work investigates an alternative strategy to exploit future communications satellite generations including a final stage of lunar observations. For that, we explore impulsive transfers between geostationary orbits and lunar gravitational capture orbits in a full 4-body dynamical model with the Sun, Earth, Moon and spacecraft. Criteria to seek natural transfer orbits between the geostationary orbit and the vicinity of the Moon are defined considering escape properties of trajectories of the Circular Restricted Three Body Problem (CR3BP) as a guide. Namely, we select initial conditions of the 4-body model with energies that favors Earth-Moon transfers that remain around the Moon for a long time. As a case of study, we selected the current Brazilian geostationary satellite Star One C4. After a broad analysis of initial conditions and their transport behavior, we select potential transfers that reaches a near vicinity of the GEO orbit with an sufficiently small inclination with respect to the terrestrial equator. Time evolution of candidate solutions are analyzed and ∆v budget and propellant mass are computed. As well as some current proposals for space debris mitigation, our strategy requires that additional mass of propellant besides onboard propulsion systems to perform final maneuvers have to be foreseen in the design of future generations of these communication satellites.},
  langid = {english},
  annotation = {titleTranslation: 拓展地球静止轨道任务以进行月球观测\\
abstractTranslation: 本研究探讨了一种利用未来通信卫星世代进行月球观测末阶段的替代策略。为此，我们在包含太阳、地球、月球和航天器的完整四体动力学模型中，探索了地球静止轨道与月球引力捕获轨道之间的脉冲转移。以圆型限制性三体问题（CR3BP）轨迹的逃逸特性为指引，定义了在地球静止轨道与月球附近区域之间寻找自然转移轨道的准则。具体而言，我们选取了四体模型中能量有利于实现地球-月球转移且能长期绕月运行的初始条件。作为案例研究，我们选择了当前巴西地球静止卫星Star One C4。在对初始条件及其输运行为进行广泛分析后，筛选出能够到达地球静止轨道附近且与赤道面夹角足够小的潜在转移方案。对候选解的时间演化进行了分析，并计算了{$\Delta$}v预算和推进剂质量。与当前一些空间碎片减缓方案类似，我们的策略要求在未来的通信卫星代际设计中，除了星载推进系统外，还需预留额外的推进剂质量以执行末段机动},
  file = {/home/ouyangjiahong/Zotero/storage/7B5C3DFK/Silva 等 - 2019 - Extending geostationary orbit missions for lunar observations.pdf}
}


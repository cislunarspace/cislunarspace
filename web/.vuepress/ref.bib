@article{LiangBinZiYouPiaoFuKongJianJiQiRenBuHuoFanGunMuBiaoDeLiWeiXingRongHeKongZhiFangFa2024,
  title = {{自由漂浮空间机器人捕获翻滚目标的力-位-型融合控制方法}},

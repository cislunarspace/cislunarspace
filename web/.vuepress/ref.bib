@article{shannonOrbitalAveragingAdvancement2024,
  title = {Orbital Averaging Advancement for Low-Thrust Trajectory Design},
  author = {Shannon, Jackson},
  year = 2024,
  journal = {Journal of Astronautical Sciences},
  volume = {Vol.71},
  number = {No.6},
  pages = {1--22},
  doi = {10.1007/s40295-024-00468-1},
  abstract = {This work introduces several improvements to the classical orbital averaging approach for the many-revolution low-thrust trajectory problem. The mean anomaly fast variable is included in the averaged state vector to effectively track spacecraft location throughout an orbit transfer. Additionally, a new approach to optimal coasting is formulated based on the relative effectivity concept and is compared to literature results. Both of these improvements are then leveraged to demonstrate a hybrid model that combines averaged and non-averaged dynamics to produce optimal trajectories from Geostationary Transfer Orbit (GTO) to an Earth-Moon Distant Retrograde Orbit (DRO).},
  langid = {english},
  keywords = {Low-thrust,Trajectory optimization},
  annotation = {titleTranslation: 低推力轨道设计中的轨道平均化技术进展\\
abstractTranslation: 本研究针对多圈低推力轨迹问题中的经典轨道平均方法提出了若干改进。将平近点角这一快变量纳入平均状态向量，以有效追踪航天器在轨道转移过程中的位置。此外，基于相对效能概念提出了一种新的最优滑行方法，并与文献结果进行了对比。随后，利用这两项改进展示了一种混合模型，该模型结合了平均与非平均动力学，能够生成从地球静止转移轨道（GTO）到地月远距逆行轨道（DRO）的最优轨迹。}
}


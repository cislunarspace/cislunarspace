@article{calvoIntegralSolutionElliptic2023,
  title = {On the Integral Solution of Elliptic Kepler's Equation},
  author = {Calvo, M. and Elipe, A. and R{\'a}ndez, L.},
  year = 2023,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {3},
  pages = {26},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10142-7},
  urldate = {2025-10-01},
  abstract = {In a recent paper, Philcox, Goodman and Slepian obtain an explicit solution of the elliptic Kepler's equation (KE) as a quotient of two contour integrals along a Jordan curve C = C(M, e) that contains the unique real solution of KE but not includes other complex zeros of KE in its interior. The aim of this paper is to study the main issues that arise in the practical implementation of this integral solution. Thus, after a study of the complex zeros of KE, several families of Jordan contours C = C(M, e) that are suitable for this integral solution are proposed. Since contours with minimal length turn out to be the more accurate for numerical purposes, several families that minimize their length are constructed. Secondly, the approximation of the contour integrals by the composite trapezoidal rule is considered. Recall that this rule is employed in the fast Fourier transform and, in spite of its lower order, displays a spectral convergence as a function of the number of nodes, which implies a very fast convergence. Finally, the results of some numerical experiments are presented to show that such a combination of appropriate contours with the composite trapezoidal rule leads to a powerful numerical method to solve KE with any desired accuracy for all values of eccentricity.},
  langid = {english},
  annotation = {titleTranslation: 关于椭圆开普勒方程积分解法的探讨\\
abstractTranslation: 在近期的一篇论文中，Philcox、Goodman 与 Slepian 将椭圆开普勒方程（KE）的显式解表示为两个沿 Jordan 曲线 C = C(M, e) 的围道积分之商，该曲线包含 KE 的唯一实根，但其内部不包含 KE 的其他复零点。本文旨在研究该积分解在实际实现中遇到的主要问题。为此，在分析 KE 复零点的基础上，提出了若干适用于该积分解的 Jordan 曲线族 C = C(M, e)。由于数值计算中长度最小的曲线精度更高，我们构造了若干使曲线长度最小化的曲线族。其次，研究了采用复合梯形公式近似计算围道积分的方法。该公式虽阶数较低，但因其用于快速傅里叶变换，且节点数增加时具有谱收敛特性，故收敛速度极快。最后，通过数值实验表明，选择合适的曲线与复合梯形公式相结合，能够为所有偏心率下的 KE 求解提供一种高效数值方法，并可达到任意所需精度。},
  file = {/home/ouyangjiahong/Zotero/storage/NTKPEF4D/Calvo 等 - 2023 - On the integral solution of elliptic kepler’s equation.pdf}
}

@article{calvoIntegralSolutionHyperbolic2024,
  title = {On the Integral Solution of Hyperbolic Kepler's Equation},
  author = {Calvo, M. and Elipe, A. and R{\'a}ndez, L.},
  year = 2024,
  month = apr,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {2},
  pages = {13--27},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10184-5},
  urldate = {2025-10-01},
  abstract = {In a recent paper of Philcox, Goodman and Slepian, the solution of the elliptic Kepler's equation is given as a quotient of two contour integrals along a Jordan curve that contains in its interior the unique real solution of the elliptic Kepler's equation and does not include other complex zeroes. In this paper, we show that a similar explicit integral solution can be given for the hyperbolic Kepler's equation. With this purpose, we carry out a study of the complex zeros of the hyperbolic Kepler's equation in order to define suitable Jordan contours in the integrals. Even more, we show that appropriate elliptic Jordan contours can be defined for such integrals, which reduces the computing time. Moreover, using the ideas behind the fast Fourier transform (FFT) algorithm, these integrals can be approximated by the composite trapezoidal rule which gives an algorithm with spectral convergence as a function of the number of nodes. The results of some numerical experiments are presented to show that this implementation is a reliable and very accurate algorithm for solving the hyperbolic Kepler's equation.},
  langid = {english},
  annotation = {titleTranslation: 关于双曲型开普勒方程的积分解。\\
abstractTranslation: 在Philcox、Goodman与Slepian近期的一篇论文中，椭圆Kepler方程的解被表示为沿一条Jordan曲线的两个围道积分之商，该曲线内部包含椭圆Kepler方程的唯一实解，且不包含其他复零点。本文证明，类似的显式积分解也可用于双曲Kepler方程。为此，我们对双曲Kepler方程的复零点展开研究，以定义合适的Jordan围道用于积分。更进一步，我们证明可以为这些积分定义适当的椭圆Jordan围道，从而缩短计算时间。此外，借助快速傅里叶变换（FFT）算法的思想，这些积分可通过复合梯形公式进行逼近，从而得到一种随节点数增加而具有谱收敛性的算法。数值实验结果表明，该实现方法是求解双曲Kepler方程的一种可靠且高精度的算法},
  file = {/home/ouyangjiahong/Zotero/storage/6YEPEMPR/Calvo 等 - 2024 - On the integral solution of hyperbolic kepler’s equation.pdf}
}


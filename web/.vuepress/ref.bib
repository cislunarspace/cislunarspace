@article{xingmingliVisibilityAnalysisCislunar2024,
  title = {Visibility Analysis of the Cislunar Periodic Orbit for the Halo Orbits near the {{Earth-moon L1}} and {{L2}} Points},
  author = {Xingming LI, Linli GUO Ruimin FU and Dong, Lianqing},
  year = 2024,
  journal = {Spacecraft Recovery \& Remote Sensing},
  volume = {Vol.45},
  number = {No.2},
  pages = {53},
  abstract = {With the increasing of spacecrafts going to the moon, the detection capability of the existing near-Earth space optical satellites and ground-based optical telescopes can no longer meet the observation requirements, and it is urgent to enhance the cislunar space observation capability. It is considered as an effective means to make up the deficiency of cislunar space observation capability for observations using the cislunar periodic orbit. According to the characteristics of the cislunar periodic orbit, the orbit is modeled based on the principle of differential correction and the algorithm is designed. An orbit selection principle is proposed and three optimized orbits are given. In the analysis of the visibility of the cislunar periodic orbit to the Halo Orbit near the cislunar Lagrange points L1 and L2, in order to facilitate the evaluation, the spheroid-like object magnitude evaluation model is used to define the evaluation criteria of visibility. Based on the spatiotemporal relationship between natural objects, object and remote sensing satellites involved in the calculation of the model provided by the satellite toolkit, the visibility analysis process and results are presented. The results show that the cislunar periodic orbit has a good observation effect on the Halo Orbit near the cislunar lagrange points L1 and L2, and the visibility of the cislunar periodic orbit with serial number 1 is the highest, which is greater than 95\%.},
  langid = {english},
  keywords = {cislunar periodic orbit,differential correction,Halo Orbit,magnitude model,space exploration,visibility analysis},
  annotation = {titleTranslation: 地月L1与L2点附近晕轨道的地月周期轨道可见性分析}
}


@article{oshimaRegularizingFueloptimalMultiimpulse2023,
  title = {Regularizing Fuel-Optimal, Multi-Impulse Trajectories},
  author = {Oshima, Kenta},
  year = 2023,
  journal = {Research Square},
  abstract = {The regularization theory has successfully enabled the removal of gravitational singularities associated with celestial bodies. This paper merges regularizing techniques into a multi--impulse trajectory design framework that requires delicate computations specifically in a fuel minimization problem. Regularized variables based on the Levi--Civita or Kustaanheimo--Stiefel transformation express instantaneous velocity changes in a gradient--based direct optimization method. The formulation removes the notorious singularities associated with null thrust impulses from derivatives of an objective function in the fuel minimization problem. The favorite singularity--free property enables accurate reductions of unnecessary impulses and generations of necessary impulses for local optimal solutions in an automatic manner. Examples of fuel--optimal, multi--impulse trajectories are presented including novel transfer solutions between a near rectilinear halo orbit and a distant retrograde orbit.},
  langid = {english},
  keywords = {fuel minimization,multi-impulse trajectory,regularization,trajectory optimization},
  annotation = {titleTranslation: 正则化燃料最优多脉冲轨迹\\
abstractTranslation: 正则化理论已成功消除了与天体相关的引力奇点。本文将正则化技术融入多脉冲轨迹设计框架，该框架在燃料最小化问题中需要进行精细计算。基于Levi-Civita或Kustaanheimo--Stiefel变换的正则化变量，在基于梯度的直接优化方法中表达了瞬时速度变化。该公式消除了燃料最小化问题中目标函数导数与零推力冲量相关的著名奇点。其出色的无奇点特性能够自动实现不必要冲量的精确缩减以及必要冲量的生成，以获取局部最优解。最后给出了燃料最优多脉冲轨迹的示例，包括近直线晕轨道与远距离逆行轨道之间的新颖转移解}
}

@article{oshimaRetrogradeCoorbitalOrbits2021,
  title = {Retrograde Co-Orbital Orbits in the {{Earth}}--Moon System: Planar Stability Region under Solar Gravitational Perturbation},
  shorttitle = {Retrograde Co-Orbital Orbits in the {{Earth}}--Moon System},
  author = {Oshima, Kenta},
  year = 2021,
  month = sep,
  journal = {Astrophysics and Space Science},
  volume = {366},
  number = {9},
  pages = {88--99},
  issn = {0004-640X, 1572-946X},
  doi = {10.1007/s10509-021-03994-8},
  urldate = {2025-11-20},
  abstract = {This paper explores a stability region near the 1 : 1 retrograde resonance with the Moon in the planar bicircular restricted four-body problem. We find, in addition to lunar distant retrograde orbits and Trojan orbits around the triangular equilibria, another co-orbital stability region in the Earth--Moon system under solar gravitational perturbations. We identify three families of periodic orbits that could be the possible origin of the stability region. As an application, ballistic capture trajectories into the stability region from the vicinity of the Earth or interplanetary space are computed with the aid of the symmetry of the model. We reveal trade-offs among time-of-flights, characteristic energies, and lunar flyby altitudes for the ballistic capture trajectories.},
  langid = {english},
  keywords = {Ballistic capture,Earth-Moon-Sun system,Periodic orbit,Retrograde co-orbital orbit,Stability region},
  annotation = {titleTranslation: 地月系统中的逆行共轨轨道：太阳引力摄动下的平面稳定区域\\
abstractTranslation: 本文探讨了平面双圆限制性四体问题中月球1:1逆共振附近的稳定区域。我们发现，除了月球远距离逆行轨道和三角平动点周围的特洛伊轨道外，在太阳引力摄动下的地月系统中还存在另一个共轨稳定区域。我们识别出三个周期轨道族，它们可能是该稳定区域的起源。作为应用，利用模型的对称性，计算了从地球附近或星际空间弹道捕获至稳定区域的轨道。我们揭示了弹道捕获轨道在飞行时间、特征能量和月球飞越高度之间的权衡关系。},
  file = {/home/ouyangjiahong/Zotero/storage/CH9XGRGR/Oshima - 2021 - Retrograde co-orbital orbits in the Earth–moon system planar stability region under solar gravitati.pdf}
}


@article{ZhangChuZhiYueShuYuLiangDianBianZhiYueShuGuiDaoDongLiXueFangChengDeKuaiSuShuZhiJiSuanFangFa12022,
  title = {{初值约束与两点边值约束轨道动力学方程的快速数值计算方法1)}},
  author = {{张哲} and {代洪华} and {冯浩阳} and {汪雪川} and {岳晓奎}},
  year = 2022,
  journal = {力学学报},
  volume = {54},
  number = {2},
  pages = {503--516},
  issn = {0459-1879},
  abstract = {轨道动力学快速计算是航天工程中的基础问题,广泛存在于轨道设计、空间抓捕以及深空探测等任务中.基于有限差分原理的经典数值积分算法,由于精度严重依赖小积分步长,难以满足航天器在轨快速计算需求.针对该问题,提出一种局部配点反馈迭代算法,该算法能高效解算受到初值约束和两点边值约束的轨道动力学方程.基于Picard 迭代公式建立数值算法以避免计算雅可比矩阵,引入误差反馈以加快迭代收敛速度.通过时域配点法消除迭代公式推导中的复杂符号运算,使迭代公式更为简洁.结合拟线性化法及叠加法,算法能对两点边值约束下的Lambert 问题实现高效解算.基于ph 网格细化法建立计算参数自适应调节算法,能进一步增强局部配点反馈迭代法的大步长计算优势.通过求解二体动力学模型下的递推轨道,摄动Lambert 问题以及限制性三体动力学模型下的转移轨道验证了算法有效性.仿真结果表明,在相同计算精度下,局部配点反馈迭代算法计算速度比拟线性化-局部变分迭代法提高1.5 倍以上,引入变参数方案能够进一步将算法计算速度提高6 倍以上.},
  langid = {chinese},
  keywords = {;;;;;}
}

@article{zhangCislunarSpaceConstellation2025,
  title = {Cislunar Space Constellation Design for Future Lunar Resource Development and Utilization},
  author = {Zhang, Xiao and Sun, Zhaowei and Ye, Dong},
  year = 2025,
  month = jan,
  journal = {IFAC-PapersOnLine},
  series = {23th {{IFAC Symposium}} on {{Automatic Control}} in {{Aerospace ACA}} 20255},
  volume = {59},
  number = {20},
  pages = {1043--1047},
  issn = {2405-8963},
  doi = {10.1016/j.ifacol.2025.11.292},
  urldate = {2025-12-20},
  abstract = {A design method of cislunar space constellation is proposed for future lunar resource development and utilization. This paper combs out the performance evaluation indexes of constellation, such as lunar surface covering rate, continuous covering number, geometric dilution of precision, and analyzes the typical cislunar orbit characteristics. Combined with the development trend of China future lunar exploration, a three-stage optimal construction scheme of cislunar space constellation is proposed based on the analytic hierarchy process, which can provide technical reference for the follow-up engineering implementation of cislunar space constellation.},
  langid = {english},
  keywords = {Cislunar space,communication,constellation configuration,lunar south pole,navigation},
  annotation = {abstractTranslation: 针对未来月球资源开发利用需求，本文提出一种地月空间星座设计方法。梳理了月面覆盖率、连续覆盖数、几何精度衰减因子等星座性能评估指标，分析了典型地月轨道特性。结合我国未来月球探测发展趋势，基于层次分析法提出了地月空间星座三阶段优化构建方案，可为后续地月空间星座工程实施提供技术参考。\\
titleTranslation: 面向未来月球资源开发与利用的地月空间星座设计},

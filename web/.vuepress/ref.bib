@phdthesis{AnBinLanJieLinJinKongJianFeiXingQiZhiDaoYuFangZhenYanJiu2017,
  type = {硕士},
  title = {拦截临近空间飞行器制导与仿真研究},
  author = {{安彬}},
  year = 2017,
  abstract = {临近空间飞行器随着导航、制导与控制技术快速发展,具备有快速机动和实时打击的特点,是飞行器中的研究热点。在未来战场上,必须应对以临近空间飞行器为目标的高超声速武器。本文针对拦截临近空间飞行器展开了制导与仿真研究,包含以下内容:首先,针对临近空间飞行器,设计了一套高抛程序初制导+最优预测中制导+微分对策末制导的复合制导律,采用动能拦截技术对目标进行精确拦截。在此基础上,给出了各制导段间的交班条件及交班过程的设计方案。该制导律考虑了临近空间飞行器典型的机动方式,对比和分析了拦截弹采用复合制导律和比例制导律的仿真结果,以及交班过程对拦截精度的影响。其次,给出了拦截弹可拦截区的计算方法,以及针对迎面拦截目标的射后可拦截区的快速计算方法。考虑可拦截区的影响因素,对拦截弹进行了总体优化设计。对多拦截器拦截多个目标进行了制导设计,并设计了以母拦截器为领弹、子拦截器为从弹的十字型编队飞行方案,对典型目标形成多弹拦截。仿真分析了多拦截器的可拦截区、射后可拦截区、多拦截器拦截多个目标和多拦截器编队飞行拦截同一目标的情况,验证了多拦截器技术对拦截临近空间飞行器的可行性。最后,建立了多目标任务分配的数学模型,采用粒子群算法进行了动态任务分配。设计了一套多层拦截方案,实现了对多临近空间飞行器的饱和拦截。对目标分配及多层拦截进行了数值仿真,结果表明,该方案可以对多临近空间飞行器实现精确拦截。},
  school = {南京航空航天大学},
  keywords = {;;;;;;},
  file = {/home/ouyangjiahong/Zotero/storage/VL447RBB/安彬 - 2017 - 拦截临近空间飞行器制导与仿真研究.pdf}
}

@article{andersonComparisonLowenergyLunar2013,
  title = {Comparison of Low-Energy Lunar Transfer Trajectories to Invariant Manifolds},
  author = {Anderson, Rodney L. and Parker, Jeffrey S.},
  year = 2013,
  month = mar,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {115},
  number = {3},
  pages = {311--331},
  issn = {1572-9478},
  doi = {10.1007/s10569-012-9466-3},
  abstract = {In this study, transfer trajectories from the Earth to the Moon that encounter the Moon at various flight path angles are examined, and lunar approach trajectories are compared to the invariant manifolds of selected unstable orbits in the circular restricted three-body problem. Previous work focused on lunar impact and landing trajectories encountering the Moon normal to the surface, and this research extends the problem with different flight path angles in three dimensions. The lunar landing geometry for a range of Jacobi constants is computed, and approaches to the Moon via invariant manifolds from unstable orbits are analyzed for different energy levels.},
  langid = {english},
  annotation = {titleTranslation: 低能量地月转移轨道与不变流形对比\\
abstractTranslation: 在本研究中，探讨了以不同飞行路径角与月球相遇的地月转移轨道，并将月球接近轨迹与圆型限制性三体问题中选定的不稳定轨道的不变流形进行了比较。以往的研究主要关注垂直撞击月球表面的月球撞击与着陆轨迹，而本研究将问题扩展至三维空间中不同飞行路径角的情形。计算了不同雅可比常数值下的月球着陆几何构型，并针对不同能量水平，分析了经由不稳定轨道的不变流形接近月球的方式。},
  file = {/home/ouyangjiahong/Zotero/storage/JDP743FB/Anderson和Parker - 2013 - Comparison of low-energy lunar transfer trajectories to invariant manifolds.pdf}
}

@article{andersonDirectExploration$$hbox2024,
  title = {Direct Exploration of the \$\$\textbackslash hbox \textbraceleft{{L}}\textbraceright\_2\$\$ Isolated Invariant Set Using Isolating Neighborhoods},
  author = {Anderson, Rodney L. and Easton, Robert W. and Lo, Martin W.},
  year = 2024,
  month = dec,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {6},
  pages = {56--77},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10224-0},
  urldate = {2025-10-01},
  abstract = {Previous studies have used isolating blocks to explore the isolated invariant set around the L2 Lagrange point in the circular restricted three-body problem by computing trajectories on the asymptotic set and using them to track particular orbits. Once an initial map of the location of the orbits within the isolated invariant set projected into configuration space has been found, it is possible to further explore these orbits more directly by starting from appropriately chosen points within the mapped space. Here, we develop a method that uses these points to explore the periodic and quasiperiodic orbits within the isolated invariant set.},
  langid = {english},
  annotation = {titleTranslation: 利用孤立邻域对\$\textbackslash hbox \textbraceleft L\textbraceright\_2\$孤立不变集的直接探索\\
abstractTranslation: 先前的研究通过使用隔离块，计算渐近集上的轨迹并利用这些轨迹追踪特定轨道，探讨了圆形限制性三体问题中L2拉格朗日点附近的孤立不变集。一旦获得了映射到构型空间中的孤立不变集内轨道位置的初始图谱，就可以从图谱空间内适当选择的点出发，更直接地进一步探索这些轨道。本文开发了一种方法，利用这些点探索孤立不变集内的周期轨道和准周期轨道},
  file = {/home/ouyangjiahong/Zotero/storage/P5QIPXR3/Anderson 等 - 2024 - Direct exploration of the $$hbox L _2$$ isolated invariant set using isolating neighborhoods.pdf}
}

@misc{andersonIsolatingNeighborhoodTrajectory2023,
  title = {Isolating Neighborhood Trajectory Computations in Non-Autonomous Systems Including the Elliptic Restricted Three-Body Problem},
  author = {Anderson, Rodney L. and Easton, Robert W. and Lo, Martin W.},
  year = 2023,
  month = aug,
  number = {arXiv:2308.06667},
  eprint = {2308.06667},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2308.06667},
  urldate = {2026-01-01},
  abstract = {Isolating block and isolating neighborhood methods have previously been implemented to find transit trajectories and orbits around libration points in the autonomous circular restricted three-body problem. For some applications, the direct computation of these types of trajectories in non-autonomous models more closely approximating real-world ephemerides is beneficial. Here, we apply isolating neighborhood methods to non-autonomous systems, including the elliptic restricted three-body problem (ERTBP). Specifically, simplified isolating neighborhood boundaries are computed around libration points in the ERTBP. These boundaries are used in combination with a bisection method to compute the forward asymptotic trajectories of the isolated invariant set and track orbits around a libration point.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Dynamical Systems},
  annotation = {titleTranslation: 非自治系统中孤立邻域轨迹计算------以椭圆型限制性三体问题为例\\
abstractTranslation: 隔离块与隔离邻域方法先前已被用于在自治圆型限制性三体问题中寻找平动点附近的转移轨迹与周期轨道。对于某些应用而言，在更接近真实星历的非自治模型中直接计算此类轨迹更具实际价值。本文中，我们将隔离邻域方法应用于非自治系统，包括椭圆型限制性三体问题。具体而言，我们在椭圆型限制性三体问题的平动点周围计算了简化的隔离邻域边界，并结合二分法计算了孤立不变集的前向渐近轨迹，从而追踪平动点附近的轨道。},
  file = {/home/ouyangjiahong/Zotero/storage/9PWP7PZT/Anderson 等 - 2023 - Isolating neighborhood trajectory computations in non-autonomous systems including the elliptic rest.pdf;/home/ouyangjiahong/Zotero/storage/JB3CUNJD/2308.html}
}


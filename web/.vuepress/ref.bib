@article{hallHigherorderSensitivityMatrix2020,
  title = {Higher-Order Sensitivity Matrix Method for Probabilistic Solution to Uncertain Lambert Problem and Reachability Set Problem},
  author = {Hall, Zach and Singla, Puneet},
  year = 2020,
  month = nov,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {132},
  number = {10},
  pages = {50},
  issn = {1572-9478},
  doi = {10.1007/s10569-020-09988-y},
  urldate = {2026-02-13},
  abstract = {This paper presents a derivative-free method for computing approximate solutions to the uncertain Lambert problem (ULP) and the reachability set problem (RSP) while utilizing higher-order sensitivity matrices. These sensitivities are analogous to the coefficients of a Taylor series expansion of the deterministic solution to the ULP and RSP, and are computed in a derivative-free and computationally tractable manner. The coefficients are computed by minimizing least squared error over the domain of the input probability density function (PDF), and represent the nonlinear mapping of the input PDF to the output PDF. A non-product quadrature method known as the conjugate unscented transform is used to compute the multidimensional expectation values necessary to determine these coefficients with the minimal number of full model propagations. Numerical simulations for both the ULP and the RSP are provided to validate the developed methodology and illustrate potential applications. The benefits and limitations of the presented method are discussed.},
  langid = {english},
  keywords = {Conjugate unscented transform,Higher-order sensitivity,Lambert problem,Reachability sets,Stochastic systems,Uncertainty propagation},
  annotation = {titleTranslation: 高阶灵敏度矩阵法求解不确定兰伯特问题与可达集问题的概率解\\
abstractTranslation: 本文提出了一种无需导数的计算方法，利用高阶灵敏度矩阵来求解不确定兰伯特问题（ULP）和可达集问题（RSP）的近似解。这些灵敏度类似于ULP和RSP确定性解泰勒级数展开的系数，且以无导数且计算可行的方式求得。系数通过最小化输入概率密度函数（PDF）域内的最小二乘误差来计算，并反映了输入PDF到输出PDF的非线性映射。采用一种非乘积型求积方法------共轭无迹变换，以最少的全模型传播次数计算确定这些系数所需的多维期望值。提供了针对ULP和RSP的数值仿真，以验证所开发的方法并展示潜在应用。最后讨论了所提方法的优势与局限。},
  file = {/home/ouyangjiahong/Zotero/storage/ZLRSLUYX/Hall和Singla - 2020 - Higher-order sensitivity matrix method for probabilistic solution to uncertain lambert problem and r.pdf}
}


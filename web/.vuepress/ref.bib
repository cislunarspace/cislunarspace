@inproceedings{nurreEndtoendOperationallyconstrainedLowthrust2024,
  title = {End-to-End Operationally-Constrained Low-Thrust Transfers to Gateways near-Rectilinear Halo Orbit},
  booktitle = {{{AIAA SciTech Forum}} and {{Exposition}}, 2024},
  author = {Nurre, Nicholas P. and Taheri, Ehsan},
  year = 2024,
  address = {Orlando, FL, United states},
  abstract = {With NASAs consideration of a southern L2 Near-Rectilinear Halo Orbit (NRHO) to host Deep Space Gateway (DSG), optimal low-thrust trajectory design to the NRHO for building the Gateway and to sustain its operation has become an important task. This work presents a methodology for end-to-end low-thrust trajectory design to an insertion point on the NRHO using an indirect-based approach. Necessary conditions of optimality are derived to determine first minimum-time trajectories in reverse-time and then minimum-fuel trajectories in forward-time between a selected NRHO insertion point and epoch and a free point along a super geosynchronous transfer orbit. Numerical continuation is utilized to introduce the high-fidelity ephemeris-based perturbations, and to embed Earth-eclipse-coast arcs. Results demonstrate that efficient selection of the targeting point on the NRHO makes it possible to obtain high-resolution and high-fidelity minimum-time and minimum-fuel trajectories for acceleration levels on the order of 1.0 \texttimes{} 10?3 m/s2.},
  langid = {english},
  annotation = {titleTranslation: 端到端运行约束下的低推力转移至近直线晕轨道门户点}
}

@article{ober-blobaumDiscreteMechanicsOptimal2011,
  title = {Discrete Mechanics and Optimal Control: An Analysis},
  shorttitle = {Discrete Mechanics and Optimal Control},
  author = {{Ober-Bl{\"o}baum}, Sina and Junge, Oliver and Marsden, Jerrold E.},
  year = 2011,
  month = apr,
  journal = {ESAIM: Control, Optimisation and Calculus of Variations},
  volume = {17},
  number = {2},
  pages = {322--352},
  publisher = {EDP Sciences},
  issn = {1292-8119, 1262-3377},
  doi = {10.1051/cocv/2010012},
  urldate = {2026-01-27},
  abstract = {The optimal control of a mechanical system is of crucial importance in many application areas. Typical examples are the determination of a time-minimal path in vehicle dynamics, a minimal energy trajectory in space mission design, or optimal motion sequences in robotics and biomechanics. In most cases, some sort of discretization of the original, infinite-dimensional optimization problem has to be performed in order to make the problem amenable to computations. The approach proposed in this paper is to directly discretize the variational description of the system's motion. The resulting optimization algorithm lets the discrete solution directly inherit characteristic structural properties from the continuous one like symmetries and integrals of the motion. We show that the DMOC (Discrete Mechanics and Optimal Control) approach is equivalent to a finite difference discretization of Hamilton's equations by a symplectic partitioned Runge-Kutta scheme and employ this fact in order to give a proof of convergence. The numerical performance of DMOC and its relationship to other existing optimal control methods are investigated.},
  copyright = {\copyright{} EDP Sciences, SMAI, 2010},
  langid = {english},
  annotation = {titleTranslation: 离散力学与最优控制：一种分析\\
abstractTranslation: 机械系统的最优控制在众多应用领域中至关重要。典型例子包括：车辆动力学中时间最优路径的确定、空间任务设计中能量最优轨迹的规划，以及机器人学和生物力学中的最优运动序列。在大多数情况下，需要对原始的无穷维优化问题进行某种离散化处理，以便于计算求解。本文提出的方法是对系统运动的变分描述直接进行离散化。由此产生的优化算法使离散解能够直接继承连续解的特征结构性质，如对称性和运动积分。我们证明，DMOC（离散力学与最优控制）方法等价于通过辛分区龙格-库塔格式对哈密顿方程进行有限差分离散化，并利用这一事实给出收敛性证明。此外，还研究了DMOC的数值性能及其与其他现有最优控制方法的关系},
  file = {/home/ouyangjiahong/Zotero/storage/44423LXQ/Ober-Blöbaum 等 - 2011 - Discrete mechanics and optimal control an analysis.pdf}
}


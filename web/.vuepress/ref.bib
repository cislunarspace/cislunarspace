@inproceedings{rubinsztejnChainingMoontomoonTrajectories2022,
  title = {Chaining Moon-to-Moon Trajectories Using Network Analysis},
  booktitle = {{{AIAA SciTech Forum}} and {{Exposition}}},
  author = {Rubinsztejn, Ari and Sood, Rohan},
  year = 2022,
  address = {San Diego, CA, United states},
  doi = {10.2514/6.2022-0858},
  abstract = {Cislunar space, the primary focus of NASAs human spaceflight program, is strongly perturbed by the Suns gravitational pull. This perturbation, if correctly harnessed and used in conjunction with Lunar flybys, can be used to dramatically change a spacecrafts energy at a minimal fuel cost. Moon-to-Moon trajectories present a natural approach to exploiting the perturbation, as they both reduce the dimension of the design space from seven variables to four, as well as ensure an encounter with the Lunar sphere of influence. Unfortunately, a single Lunar flyby is often limited in the outcomes it can achieve. This investigation demonstrates how Moon-to-Moon trajectories can be chained together to provide further flexibility in harnessing the solar perturbation. Additionally, concepts from network analysis are applied to provides a computationally efficient method for describing and searching through the Moon-to-Moon chains. Through one of these chains, a spacecraft can gain 1900 m/s of 'free' {$\Delta$}V at the cost of only 20 m/s of thrust {$\Delta$}V. More interesting, though, is when these chains are joined with NASAs plan to place the Gateway space station in an Earth-Moon L2 near rectilinear halo orbit. Connecting this orbits unstable manifold to the chain of Moon-to-Moon trajectories allows it to become a true gateway to the solar system and beyond.},
  langid = {english},
  annotation = {titleTranslation: 基于网络分析的月球间轨道链式设计}
}


  year = 2020,
  series = {71st {{International Astronautical Congress}}, {{IAC}} 2020},
  address = {Virtual, Online},
  abstract = {This paper describes the feasibility and motivation to use raw materials from an asteroid captured into a lunar Distant Retrograde Orbit (DRO). Due to the high long-term stability, this parking orbit offers the opportunity to develop in-situ resource examination and processing, such as production of propellant, life-support or space construction using water and other extracted materials. These resources can be used for robotic and crewed missions to support future lunar and deep-space missions. For this purpose, recent studies examined and proposed a lunar orbiting outpost, located on the Near Rectilinear Halo Orbit (NRHO) about Lagrange L2 point of the Earth-Moon system. Our study is focused on the transfer design scenario for capturing a small asteroid into a DRO, and its accessibility from the NRHO. As a case study, an asteroid, classified as temporarily captured natural Earth satellite, is considered. Then, transfer options from NRHO to DRO are analysed, and an assessment of the required delta-v and time of flight is performed. Trajectories are computed using both - simplified circular restricted three body problem and high-fidelity dynamical models.},
  langid = {english},
  annotation = {titleTranslation: 月球远距离逆行轨道上的小行星资源开发}
}


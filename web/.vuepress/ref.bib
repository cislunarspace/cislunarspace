@inproceedings{boudadRoundtripTrajectoriesEarthmoon2021,
  title = {Round-Trip Trajectories between Earth-Moon {{NRHOs}} and Heliocentric Space in the {{Earth-moon-sun}} System},
  author = {Boudad, Kenza K.},
  year = 2021,
  urldate = {2026-01-11},
  abstract = {In the next decades, multiple missions are proposed or planned that originate in the vicinity of the Moon with the expected delivery of a spacecraft to heliocentric space, e.g., servicing missions to the Nancy Roman or the James Webb Space Telescopes, as well as departures from Gateway to other interplanetary destinations. The Earth-Moon-Sun transit dynamics are complex, primarily influenced by the Earth and the Moon in cislunar space; the gravitational influence of the Sun becomes significant after departure from the EarthMoon vicinity. The current investigation leverages dynamical structures in the BCR4BP such as periodic orbits and manifolds, to design low-energy, round-trip transfers between the cislunar and heliocentric spaces.},
  langid = {english},
  annotation = {abstractTranslation: 未来数十年内，有多项从月球附近出发、旨在将航天器送入日心轨道的任务已被提出或规划，例如前往南希{$\cdot$}罗曼号或詹姆斯{$\cdot$}韦伯空间望远镜的维护任务，以及从月球门户空间站前往其他行星际目的地的航行。地-月-日转移动力学过程极为复杂，在近月空间主要受地球与月球引力支配；而在脱离地月邻近区域后，太阳引力影响将显著增强。本研究利用BCR4BP模型中的周期轨道、流形等动力学结构，设计了近月空间与日心空间之间的低能耗往返转移轨道。\\
titleTranslation: 地月-太阳系中地月NRHO与日心空间往返轨道}

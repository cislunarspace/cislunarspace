@article{nishimuraAnalysisDistantRetrograde2020,
  title = {Analysis of a Distant Retrograde Orbit in the Hill Three-Body Problem},
  author = {Nishimura, K. and Satoh, S. and Yamada, K.},
  year = 2020,
  month = may,
  journal = {Acta Astronautica},
  volume = {170},
  pages = {365--374},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2019.12.028},
  urldate = {2025-11-20},
  abstract = {In this study, spacecraft orbital motion in the Hill three-body problem is considered. When the secondary body moves in a circular orbit whose center is the primary body, a distant retrograde orbit (DRO) exists on the plane of revolution of the secondary body. In this study, a three-dimensional DRO including an out-of-plane motion is investigated. First, the motion in each direction is assumed as a simple trigonometric motion, and relations between the ratios of the amplitudes and the ratios of the angular velocities are derived. Then, a stability criterion of the three-dimensional DRO is obtained from the maximum eigenvalues of the monodromy matrix. A comparative study is executed between the present analytical results and the numerical simulations, and it validates the analytical results.},
  langid = {english},
  keywords = {monodromy matrix,orbital stability,three-dimensional distant retrograde orbit},
  annotation = {titleTranslation: 希尔三体问题中的远距离逆行轨道分析\\
abstractTranslation: 在本研究中，考虑希尔三体问题中的航天器轨道运动。当次级天体绕主天体作圆周运动时，在其公转平面内存在一种远距离逆行轨道（DRO）。本文对包含面外运动的三维DRO进行了研究。首先，假设各方向运动均为简单三角函数形式，推导出振幅比与角速度比之间的关系。随后，通过单值矩阵的最大特征值得到了三维DRO的稳定性判据。将本文解析结果与数值仿真进行对比分析，验证了解析结果的正确性},
  file = {/home/ouyangjiahong/Zotero/storage/N9UY5DLD/Nishimura 等 - 2020 - Analysis of a distant retrograde orbit in the hill three-body problem.pdf}
}

@inproceedings{nittiMinimumpropellantOptimalTrajectories2024,
  title = {Minimum-Propellant Optimal Trajectories for the de-Orbiting of Decommissioned Satellites in Lunar Polar Graveyard Regions},
  booktitle = {2024 {{IAF Space Exploration Symposium}} at the 75th {{International Astronautical Congress}}, {{IAC}} 2024},
  author = {Nitti, Alessandro and Mascolo, Luigi and Battipede, Manuela},
  year = 2024,
  address = {Milan},
  doi = {10.52202/078357-0194},
  abstract = {NASA's ambitious plans for sustained human presence in cislunar space, e.g. the Lunar Orbital Platform-Gateway program, has raised interest in cislunar orbits, looking for some desirable properties such as relatively low transfer costs from Earth, low orbit maintenance costs, and favourable communications opportunities with both Earth and the lunar south pole. As the cislunar region is anticipated to become increasingly populated with spacecraft, including potential debris, it is important to highlight the necessity of strategic deorbiting planning and compliance with international laws governing space debris. This study focuses on optimizing lunar deorbiting trajectories that use electric propulsion and depart from a NRHO, with a particular emphasis on minimizing propellant usage. The chosen reference orbit is the Gateway's southern L2 NRHO, with perilune and apolune radii of 3,300 km and 70,000 km and 9:2 synodic resonance with respect to the Moon's orbit around Earth. The optimization is carried out by an indirect method based on the Optimal Control Theory that transforms the propellant minimization problem into a Two-Point Boundary Value Problem. The single-shooting method shows bang-bang control derived from the Pontryagin's Maximum Principle to optimize the trajectories, ensuring that a specific region in the lunar north pole is targeted. The dynamic model considers 3-body gravitation (spacecraft subject to Earth and Moon gravity) within the Circular Restricted Three-Body Problem. Results identify a specific orbital arc in the NRHO, post-apolune, which is deemed ideal for de-orbiting the satellite via a two-burn trajectory that enables direct disposal towards the lunar north pole, significantly reducing propellant consumption allowing the mission to allocate more fuel for earlier operational phases, effectively extending the mission's operational lifespan.},
  langid = {english},
  annotation = {titleTranslation: 月球极区坟墓轨道退役卫星离轨的最小推进剂最优轨迹}
}

@inproceedings{niuResearchMissionTime2020,
  title = {Research on Mission Time Planning and Autonomous Interception Guidance Method for Low-Thrust Spacecraft in Long-Distance Interception},
  booktitle = {2020 5th {{International Conference}} on {{Automation}}, {{Control}} and {{Robotics Engineering}} ({{CACRE}})},
  author = {Niu, Shangwei and Li, Dongxu and Ji, Haoran},
  year = 2020,
  month = sep,
  pages = {117--123},
  publisher = {IEEE},
  address = {Dalian, China},
  doi = {10.1109/CACRE50138.2020.9230051},
  urldate = {2025-09-25},
  abstract = {Taking continuous low-thrust spacecraft as the research object, a long-distance online autonomous interception guidance scheme is designed, and an optimal mission time planning method is proposed. The velocity gain guidance method is used to design a closed-loop guidance scheme, where the Lambert two-point boundary value problem is quickly solved in each control cycle to obtain the current required speed of the tracking spacecraft. After that, the desired gain speed can be calculated according to the current required speed, so that the desired magnitude and direction of the control force can be attained. In addition, the thruster shutdown scheme is set according to the norm of the desired gain speed to obtain a rational shutdown moment. Also, a novel objective function related to both the interception time period and the terminal position error is proposed in the genetic algorithm, to ensure the optimal time cost and the success of the interception mission. Finally, based on the numerical simulation, the effectiveness of the optimal mission time planning method and the reliability of the autonomous intercept guidance method are verified.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  isbn = {978-1-7281-9888-0},
  langid = {english},
  annotation = {titleTranslation: 小推力航天器远距离拦截任务时间规划与自主拦截制导方法研究},
  file = {/home/ouyangjiahong/Zotero/storage/4HQ43YKV/Niu 等 - 2020 - Research on mission time planning and autonomous interception guidance method for low-thrust spacecr.pdf}
}

@phdthesis{NiuShangWeiXiaoTuiLiHangTianQiGuiDaoJiaoHuiDeZhiDaoYuGuiJiGuiHuaFangFaYanJiu2020,
  title = {小推力航天器轨道交会的制导与轨迹规划方法研究},
  author = {{牛上维}},
  year = 2020,
  abstract = {作为小推力航天器的关键技术之一，轨道交会技术对于在轨维修、燃料加注、卫星编队等应用领域具有重要的研究价值。但是小推力航天器推力加速度的量级较小（一般在10-3m/s2及以下），导致其在轨运行时间较长，摄动力的累积作用会引入较大的误差，大大增加了小推力轨道交会的难度。　　针对以上问题，本文首先对小推力交会的制导方法和轨迹规划方法开展研究。并在此研究的基础上，结合制导方法和轨迹规划方法的优点，提出了一种标称轨迹跟踪和误差修正策略，以提高轨道交会的效能。论文的主要工作如下：　　1、对小推力交会的制导方法开展研究。针对长期摄动累积导致误差增大的问题，按照导航方式的不同将轨道交会过程分为远程交会段和近程交会段，并提出在各阶段采用针对性方法的分段制导策略：在远程交会段，提出了基于遗传算法的速度增益制导方法。以任务时间和相对位置误差为待优化参数，设计了三组目标函数，并分别对三组目标函数的制导效果展开研究；在近程交会段，基于相对运动过程中常采用的C-W方程和滑模控制理论，推导了基于指数趋近律的滑模制导方法，提高了近程交会段的交会精度。　　2、对小推力交会的轨迹规划方法开展研究。根据高斯伪谱法收敛性好，对初值估计精度要求不高的优势，采用该方法对小推力轨道交会问题开展研究。根据任务阶段和推力器输出特性的不同。设计了定推力远程交会、连续可变推力远程交会、定推力交会、连续可变推力交会这四种轨迹规划问题。并比较了四种问题的任务精度、任务时间和目标函数的优化效果。仿真结果为跟踪与误差修正策略提供了数据支撑。　　3、提出了标称轨迹跟踪和误差修正策略。在分析总结制导方法和轨迹规划方法优缺点的基础上，以定推力交会问题的优化轨迹作为标称轨迹。提出以轨迹规划方法得到的控制指令跟踪标称轨迹，并采用滑模制导修正误差的策略。论文所提策略的有效性通过仿真结果得到了充分验证，该策略结合了轨迹规划方法和制导方法的特点和优势。},
  school = {国防科学技术大学; 国防科技大学},
  file = {/home/ouyangjiahong/Zotero/storage/V42UTX9B/牛上维 - 2020 - 小推力航天器轨道交会的制导与轨迹规划方法研究.pdf}
}


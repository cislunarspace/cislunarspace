  pages = {548--562},
  issn = {0731-5090, 1533-3884},
  doi = {10.2514/1.G002102},
  urldate = {2025-11-27},
  abstract = {The system entry problem entails the capture of a spacecraft about a planet by way of propulsive maneuver(s) or flyby(s) of a planetary satellite(s), or both. In the case of the Jovian system, a balance is sought between the interplanetary time-of-flight, orbit insertion maneuver magnitude, mass delivered to the system, capture orbit period, radiation dose, and mission complexity. Based on a nominal asymptote, this paper introduces the analytical equations necessary to solve the phase-free, singly-aided and doubly-aided capture problems, with a focus on the doubly-aided capture problem in the Jovian system. An analytical approximation for the required phasing is derived and the implications of the Laplace resonance are discussed. Analytical approximations are used to seamlessly seed a multiple-shooting algorithm in order to arrive at the converged high-fidelity solution space for the Europa Mission.},
  langid = {english},
  annotation = {titleTranslation: 双星辅助行星捕获与星际轨道约束\\
abstractTranslation: 系统进入问题涉及通过推进机动、行星卫星的飞越或两者结合来实现航天器绕行星的捕获。在木星系统的情况下，需要在星际飞行时间、轨道插入机动幅度、送入系统的质量、捕获轨道周期、辐射剂量和任务复杂性之间寻求平衡。基于名义渐近线，本文介绍了解决无相位、单辅助和双辅助捕获问题所需的分析方程，并重点研究了木星系统中的双辅助捕获问题。推导了所需相位的解析近似，并讨论了拉普拉斯共振的影响。利用解析近似无缝地为多重打靶算法提供初值，以得到欧罗巴任务收敛的高保真解空间},
  file = {/home/ouyangjiahong/Zotero/storage/6PWU8QKA/Scott 等 - 2017 - Dual satellite-aided planetary capture with interplanetary trajectory constraints.pdf}
}


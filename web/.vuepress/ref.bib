@phdthesis{schwabCislunarTransportCharacterization2024,
  title = {Cislunar Transport Characterization for Space Situational Awareness},
  author = {Schwab, David},
  year = 2024,
  journal = {ProQuest Dissertations and Theses},
  abstract = {Space situational awareness (SSA) is the cornerstone for safe space operations. The conventional SSA architecture so far has been built to survey, track, and catalog space objects in geosynchronous equatorial orbit (GEO)-and-below GEO altitude, referred to hereafter as the GEO-domain. However, cislunar space is becoming an ever more present regime of interest for civil, commercial, and military entities. The SSA architecture must adapt to the challenges imposed by expanding SSA capabilities to cislunar space. In this respect, the main aim of this work is to develop computationally efficient algorithms to characterize trajectories in the proximity of the liberation point and leverage these characterization variables for SSA applications (e.g., gaining the custody of a lost object).Many of the SSA algorithms developed for the GEO-domain leverage the classical orbital elements, which define the set of integrable coordinates for Keplerian motion. Even under perturbations, the classical orbital elements provide excellent qualitative description of the underlying trajectory for the perturbed two-body problem. However, these elements do not describe motion in certain regions of cislunar space primarily modeled through the circular restricted three body problem (CR3BP). In fact, there is no set of coordinates that are globally integrable in the CR3BP framework. A Lie series perturbation method is used to define local coordinates in the proximity of the libration point--known as normal form (or action-angle) coordinates. The utility of these coordinates is examined to characterize different transport behaviors in the proximity to the L1 and L2 libration points. The normal form coordinates are separated in the saddle, planar center, out-of-plane center coordinates. The center coordinates define quasi-/periodic trajectories, while the saddle subspace defines the transport properties of a trajectory. The invariant manifolds are captured in the saddle coordinates, as well as transit and reflective trajectories with respect to the L1/L2-gateways. Though accurate analytic propagation requires a very high-order Lie series approximation ({$>$}30), the low-order approximations ({$<$} 15) provide a description of the dynamic properties of the underlying trajectory.Two different algorithms are presented to generate an admissible set of maneuvers, with known dynamic properties, e.g., the set of all maneuvers that induce a lunar flyby trajectory. The first method, known hereafter as the Cartesian approach, relies on approximating maneuver parameters (∆V ) as a function of position on the orbit and points on the Poincar\'e surface corresponding to desired dynamical behavior. The unknown coefficients of this parameterization are solved through a continuous least squares process utilizing the solution to a set of two-point boundary value problems (TPBVPs) between initial conditions on a nominal orbit and the judiciously selected points on an oft utilized Poincair\'e surface of section. This method is restricted with regard to finding maneuvers for a certain class of dynamical behaviors characterized by the user-defined Poincar\'e surface. The second method utilizes the normal form coordinates to find admissible sets for more generic dynamical behaviors. This method parameterizes the maneuver parameters as a function of location on the orbit and normal form variables corresponding to desired dynamical behavior. Given sampled positions on a nominal trajectory and judiciously selected samples in the saddle subspace, a TPBVP is posed to find the maneuver that satisfies the boundary conditions in mixed coordinates. A detailed study is conducted to assess the accuracy of the developed method to find admissible sets for different dynamical behaviors. Results from these studies show that the normal form method for maneuver generation provides an algorithm to systematically define a set of maneuvers with known transport properties, while avoiding the limitations of the Cartesian approach.The admissible maneuver sets are further leveraged to search, task and track a lost space object with the help of a space-based observer. The search space is approximated by a polynomial function with the knowledge of bounds on maneuver parameters (∆V and location of maneuver). However, the errors of the polynomial approximation grow significantly as cislunar trajectories experience vastly differing dynamics dependent on their location in cislunar space. The normal form method for maneuver generation allows for the local approximation of the reachability set corresponding to different dynamical behaviors and hence, greatly increasing accuracy of the overall approximation of the reachability set. Space-based observers are tasked to search the reachability set to maximize the detection probability. Various observer orbits and sensor parameters (e.g., field-of-view, measurement frequency, probability of detection, the starting time for tasking since maneuver) are considered to track a lost object in a Lyapunov orbit around L1 and L2 libration points. Numerical studies show the efficacy of the normal form methods not only in approximating the reachability space but also in tasking sensors to search different local regions.Finally, normal form coordinates are used for optimal transfer and station-keeping for a quasi-periodic orbit family. The action part of normal form coordinates characterizes the Lissajous torus, and the angle part of the normal form coordinate is used to define the location on that torus. Conditions are derived to characterize the stable manifold of the Lissajous family and exploited for optimal transfer as well as station keeping.The studies in this dissertation demonstrate, through analysis and simulations, the utility and significance of using normal form coordinates for SSA applications in the cislunar regime. The results from these studies are of direct utility in extending SSA capabilities beyond GEO.},
  isbn = {979-8-3463-8005-4},
  langid = {english},
  keywords = {0538:Aerospace engineering,0548:Mechanical engineering,Aerospace engineering,Cartesian approach,Coordinate transformations,Geosynchronous equatorial orbit,Mechanical engineering,Orbits},
  annotation = {titleTranslation: 空间态势感知的地月传输特征},
  file = {/home/ouyangjiahong/Zotero/storage/VU8BSJLL/Schwab - 2024 - Cislunar transport characterization for space situational awareness.pdf}
}


@article{zhangOrbitDeterminationThrust2023,
  title = {Orbit Determination and Thrust Estimation for Noncooperative Target Using Angle-Only Measurement},
  author = {Zhang, Zhixun and Shu, Leizheng and Zhang, Keke and Zhu, Zhencai and Zhou, Meijiang and Wang, Xinwei and Yin, Weidong},
  year = 2023,
  month = jan,
  journal = {Space: Science \& Technology},
  volume = {3},
  pages = {0073},
  issn = {2692-7659},
  doi = {10.34133/space.0073},
  urldate = {2026-05-11},
  abstract = {The classical interactive multimodel (IMM) algorithm has some disadvantages in tracking a noncooperative continuous thrust maneuvering spacecraft, such as poor steady-state accuracy, difficult selection of subfilter parameters, and mismatched model jump. To address the abovementioned problems, a variable-dimensional adaptive IMM strong tracking filtering algorithm (VAIMM-STEKF) is proposed to estimate the spacecraft's position, velocity, and maneuvering acceleration state. VAIMM-STEKF contains 2 models, model 1 and model 2, which correspond to the tracking of the spacecraft in maneuvering and nonmaneuvering situations. Model 1 estimates the position and velocity of the spacecraft to ensure tracking accuracy when no maneuver occurs. Model 2 is a strong tracking filter with an augmented state. The adaptive IMM algorithm adjusts the fixed Markov transfer matrix in real time according to the model output probability. According to the different states of the spacecraft, the corresponding model interactive fusion method, together with the strong tracking filter, is adopted to ensure fast tracking when the spacecraft state changes. This method can also adapt to continuous thrust maneuvering spacecraft with different orders of magnitude. Simulation results show that the position accuracy of VAIMM-STEKF can be improved by approximately 27\% and the speed accuracy can be enhanced by approximately 17\% under different levels of maneuvering acceleration compared with those of the IMM algorithm. The convergence speed of VAIMM-STEKF is also better than the IMM algorithm.},
  langid = {english},
  annotation = {titleTranslation: 基于仅角度测量的非合作目标轨道确定与推力估计\\
abstractTranslation: 经典交互式多模型（IMM）算法在跟踪非合作连续推力机动航天器时存在稳态精度差、子滤波器参数选取困难以及模型跳跃不匹配等不足。针对上述问题，提出一种变维自适应IMM强跟踪滤波算法（VAIMM-STEKF），用于估计航天器的位置、速度及机动加速度状态。VAIMM-STEKF包含两个模型------模型1和模型2，分别对应航天器在机动与非机动情况下的跟踪。模型1估计航天器的位置和速度，以保证无机动发生时的跟踪精度；模型2为增广状态的强跟踪滤波器。自适应IMM算法根据模型输出概率实时调整固定马尔可夫转移矩阵。依据航天器的不同状态，采用相应的模型交互融合方法，结合强跟踪滤波器，确保航天器状态变化时能快速跟踪。该方法还可适应不同量级的连续推力机动航天器。仿真结果表明，与IMM算法相比，VAIMM-STEKF在不同机动加速度水平下，位置精度可提升约27\%，速度精度可提升约17\%，且收敛速度也优于IMM算法}
}

@article{zhangOverviewEarthmoonTransfer2023,
  title = {Overview of {{Earth-moon}} Transfer Trajectory Modeling and Design},
  author = {Zhang, Jiye and Yu, Huichang and Dai, Honghua},
  year = 2023,
  journal = {Computer Modeling in Engineering and Sciences},
  volume = {135},
  number = {1},
  pages = {5--43},
  issn = {1526-1506},
  doi = {10.32604/cmes.2022.022585},
  urldate = {2025-11-30},
  abstract = {The Moon is the only celestial body that human beings have visited. The design of the Earth-Moon transfer orbits is a critical issue in lunar exploration missions. In the 21st century, new lunar missions including the construction of the lunar space station, the permanent lunar base, and the Earth-Moon transportation network have been proposed, requiring low-cost, expansive launch windows and a fixed arrival epoch for any launch date within the launch window. The low-energy and low-thrust transfers are promising strategies to satisfy the demands. This review provides a detailed landscape of Earth-Moon transfer trajectory design processes, from the traditional patched conic to the state-of-the-art low-energy and low-thrust methods. Essential mechanisms of the various utilized dynamic models and the characteristics of the different design methods are discussed in hopes of helping readers grasp the basic overview of the current Earth-Moon transfer orbit design methods and a deep academic background is unnecessary for the context understanding.},
  langid = {english},
  annotation = {titleTranslation: 地月转移轨道建模与设计概述\\
abstractTranslation: 月球是人类唯一到访过的天体。地月转移轨道的设计是月球探测任务中的关键问题。21世纪以来，月球空间站建设、永久月球基地以及地月运输网络等新型月球探测任务相继提出，要求发射窗口宽、成本低，且窗口内任意发射日期对应的到达时刻固定。低能量转移和低推力转移是实现这些需求的有前途的策略。本综述详细介绍了地月转移轨道设计流程的全貌，从传统的拼接圆锥曲线方法到当前最先进的低能量与低推力方法。文中讨论了所采用的各种动力学模型的基本机制以及不同设计方法的特点，旨在帮助读者把握当前地月转移轨道设计方法的基本概况，且无需深厚的学术背景即可理解内容},
  file = {/home/ouyangjiahong/Zotero/storage/VI6CHYZ3/Zhang 等 - 2023 - Overview of Earth-moon transfer trajectory modeling and design.pdf}
}

@article{ZhangQiangJinKongJianFeiXingQiLuBangZiGuaYingBacksteppingKongZhi2012,
  title = {{近空间飞行器鲁棒自适应Backstepping控制}},
  author = {{张强} and {吴庆宪} and {姜长生} and {王玉惠}},
  year = 2012,
  journal = {系统工程与电子技术},
  volume = {34},

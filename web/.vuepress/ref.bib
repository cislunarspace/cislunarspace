@phdthesis{thangaveluTransfersRectilinearHalo2019,
  title = {Transfers between near Rectilinear Halo Orbits and Low Lunar Orbits},
  author = {Thangavelu, Chelsea},
  year = 2019,
  abstract = {NASA's goal to have long-term crewed missions in cislunar space, e.g. the lunar gateway, has sparked interest in cislunar orbits, specifically the Near Rectilinear Halo Orbit (NRHO). The NRHO is a strong candidate for the orbit of the lunar gateway. NRHOs are stable periodic orbits in the Circular Restricted Three-Body Problem (CR3BP) that are eccentric with a relatively low perilune and a relatively high apolune. In this thesis, an overview of computing periodic orbits in the CR3BP is presented, and a method to find the NRHOs is followed. Single shooting and multiple shooting methods are described and employed to compute periodic orbits in the CR3BP. NRHOs are calculated by first finding the L2 Lyapunov family of orbits which contain an orbit that bifurcates with the L2 family. Then stability properties are used to identify both the L2 halos and the L2 NRHOs. Single shooting is used to construct transfer trajectories from NRHOs to low lunar orbits (LLOs). A variety of transfers are identified from various initial conditions along a 9:2 synodic resonant L2 NRHO to a fixed location on an LLO by varying the transfer time of flight and delta v requirements. The delta v, transfer time of flight, and directional changes in velocity are studied for the computed NRHO to LLO transfers. A method is described and implemented to find transfers from NRHOs to LLOs to reduce the delta v of a transfer. The recovered transfers with the lowest delta v's are then compared to transfers from NRHOs to LLOs from the literature.},
  langid = {english},
  school = {University of Colorado at Boulder, N1  - Bosanac, Natasha},
  keywords = {Aerospace engineering,Circular Restricted Three-Body Problem,Low lunar orbit,Near Rectilinear Halo Orbit,Transfer},
  annotation = {M.S.\\
titleTranslation: 近直线晕轨道与低月球轨道间的转移}
}


@phdthesis{williamsDynamicsLongtermOrbit2024,
  title = {Dynamics of Long-Term Orbit Maintenance Strategies in the Circular Restricted Three Body Problem},
  author = {Williams, Dale A. P.},
  year = 2024,
  journal = {ProQuest Dissertations and Theses},
  abstract = {An increased interest in long term development and utilization of cislunar space necessitates improved intuition for operating spacecraft in multi-body orbits. Many cislunar orbits are linearly unstable, and an orbit maintenance approach is needed to secure a spacecraft near some desired reference motion. The development of effective stationkeeping techniques is facilitated by improved understanding of the variational dynamics near a periodic orbit. In this investigation, several existing orbit maintenance strategies are assessed in four different cislunar orbits. The underlying dynamics leveraged and controlled by a given strategy are highlighted via a state representation in terms of modal coordinates. For effective long-term stationkeeping, controlling only the exponentially unstable component of a spacecraft variational state is insufficient. Some control must also be enacted over spacecraft energy, phase, and any quasi-periodic motion near the reference orbit. A discussion of several strategies that may be applicable in a variety of cislunar orbits is also offered, and some stationkeeping performance metrics are assessed.},
  isbn = {979-8-3421-0134-9},
  langid = {english},
  keywords = {0405:Mathematics,0790:Systems science,Dynamical systems,Eigenvectors,Mathematics,Orbits,Symmetry,System theory,Systems science},
  annotation = {titleTranslation: 圆型限制性三体问题中的长期轨道维持策略动力学},
  file = {/home/ouyangjiahong/Zotero/storage/DYEBVSJC/Williams - 2024 - Dynamics of long-term orbit maintenance strategies in the circular restricted three body problem.pdf}
}

@article{williamsQuadratureDiscretizationMethod2011,
  title = {Quadrature Discretization Method in Tethered Satellite Control},
  author = {Williams, Paul},
  year = 2011,
  month = jul,
  journal = {Applied Mathematics and Computation},
  volume = {217},
  number = {21},
  pages = {8223--8235},
  issn = {0096-3003},
  doi = {10.1016/j.amc.2011.02.091},
  urldate = {2026-01-27},
  abstract = {A pseudospectral method for solving the tethered satellite retrieval problem based on nonclassical orthogonal and weighted interpolating polynomials is presented. Traditional pseudospectral methods expand the state and control trajectories using global Lagrange interpolating polynomials based on a specific class of orthogonal polynomials from the Jacobi family, such as Legendre or Chebyshev polynomials, which are orthogonal with respect to a specific weight function over a fixed interval. Although these methods have many advantages, the location of the collocation points are more or less fixed. The method presented in this paper generalizes the existing methods and allows a much more flexible selection of grid points by the arbitrary selection of the orthogonal weight function and interval. The trajectory optimization problem is converted to set of algebraic equations by discretization of the necessary conditions using a nonclassical pseudospectral method.},
  langid = {english},
  keywords = {Pseudospectral,Quadrature discretization method,Tethered satellites},
  annotation = {titleTranslation: 系绳卫星控制中的正交离散化方法\\
abstractTranslation: 提出了一种基于非经典正交加权插值多项式求解绳系卫星回收问题的伪谱法。传统伪谱法利用基于雅可比族中特定类正交多项式（如勒让德或切比雪夫多项式）的全局拉格朗日插值多项式来展开状态和轨迹控制，这些多项式在固定区间上相对于特定权函数正交。尽管这些方法具有许多优势，但配置点的位置或多或少是固定的。本文提出的方法推广了现有方法，通过任意选择正交权函数和区间，允许更灵活地选择网格点。利用非经典伪谱法对必要条件进行离散化，将轨迹优化问题转化为一组代数方程},
  file = {/home/ouyangjiahong/Zotero/storage/TN5BRQL5/Williams - 2011 - Quadrature discretization method in tethered satellite control.pdf}
}


@article{zhaoImpulsivePhasingProblem2024,
  title = {Impulsive Phasing Problem of Cislunar Distant Retrograde Orbits},
  author = {Zhao, Mingxu and Qi, Yi and Jin, Qihang},
  year = 2024,
  journal = {Yuhang Xuebao/Journal of Astronautics},
  volume = {Vol.45},
  number = {No.10},
  pages = {1599--1612},
  abstract = {Cislunar distant retrograde orbit（DRO）is of great value for lunar exploration，cislunar development and other missions. Aiming at the impulsive phasing problem of cislunar DROs，two methods of direct phasing and indirect phasing are proposed. Firstly，feasible sets of direct phasing strategy of cislunar DROs are constructed by numerical method，and the influence of starting and terminal points of phasing orbits is analyzed. Then，the optimal and sub-optimal two-impulse phase strategy are obtained. A combined phasing strategy，composed of several two-impulse phasing arcs，is proposed for phasing missions requiring a large phase difference. Secondly，the indirect phasing method of cislunar DRO is constructed by using the lunar libration point orbit and its homoclinic and heteroclinic transfers. Fuel consumption and time of flight of indirect phasing orbits with different Jacobi constants are analyzed. Finally，performances of direct and indirect phasing orbits are analyzed and compared. Several recommendations for their applicable conditions are given. The results provide a theoretical basis for the application of cislunar DROs.},
  langid = {english},
  keywords = {Circular restricted three-body problem,Distant retrograde orbit,Libration point orbit,Orbital optimization,Phasing problem},
  annotation = {titleTranslation: 地月远距离逆行轨道的脉冲调相问题\\
abstractTranslation: 地月空间远距离逆行轨道（DRO）对月球探测、地月空间开发等任务具有重要意义。针对地月空间DRO的脉冲调相问题，提出了直接调相和间接调相两种方法。首先，通过数值方法构建了地月空间DRO直接调相策略的可行域，分析了调相轨道起始点与终止点的影响；进而获得最优与次优的双脉冲调相策略。针对需要较大相位差的调相任务，提出了一种由多个双脉冲调相弧段组成的组合调相策略。其次，利用月球平动点轨道及其同宿/异宿转移构建了地月空间DRO的间接调相方法，分析了不同Jacobi常数下间接调相轨道的燃料消耗与飞行时间。最后，对直接与间接调相轨道的性能进行分析与比较，给出了适用条件的若干建议。研究结果为地月空间DRO的应用提供了理论依据。}
}

@article{zhaoIntelligentStrategyResolution2025,
  title = {Intelligent Strategy Resolution Methods and Mechanism Analysis in Two-on-One Impulsive Orbital Pursuit--Evasion Games},
  author = {Zhao, Liran and Sun, Qinbo and Dang, Zhaohui},
  year = 2025,
  month = oct,
  journal = {Astrodynamics},
  volume = {9},
  number = {5},
  pages = {727--751},
  issn = {2522-008X, 2522-0098},
  doi = {10.1007/s42064-025-0262-8},
  urldate = {2026-03-27},
  abstract = {This paper conducts a comprehensive study on the multi-constrained two-on-one impulsive orbital pursuit--evasion game (OPEG). Firstly, considering constraints such as maneuverability, fuel reserves, and mission duration, a mathematical game model for the two-on-one impulsive OPEG is established, which transforms the two-on-one impulsive OPEG, where cooperation and competition coexist, into a multi-constrained three-party optimization problem suitable for solving with multi-agent deep reinforcement learning. Then, an intelligent solution method for cooperative game strategies based on the Multi-Agent Deep Deterministic Policy Gradient (MADDPG) algorithm is proposed. In the reward function design section, a reward function based on fixedtime triggering is introduced to address the information loss problem caused by long impulse intervals. To ensure good convergence of the algorithm and guide the spacecraft to learn effective cooperative strategies during training, an immediate reward function is designed, incorporating outcome rewards, guidance rewards, and cooperative rewards. Numerical simulations validate the feasibility and effectiveness of the proposed method. To further analyze the cooperative mechanisms learned by the spacecraft during algorithm training, a comparative experiment with the one-on-one impulsive OPEG is designed. The experimental results demonstrate that the two pursuers in the two-on-one impulsive OPEG not only develop various strategies such as ``pre-emptive interception'', ``pincer interception'', and ``trailing pursuit'' during training, but also improve mission success rates and reduce mission durations through coordinated efforts. Additionally, this paper reveals the impact of the relative initial state distribution between the two pursuing spacecraft and the evading spacecraft on the effectiveness of cooperation.},
  langid = {english},
  annotation = {titleTranslation: 二对一脉冲轨道追逃博弈中的智能策略求解方法与机制分析\\
abstractTranslation: 本文对多约束二对一脉冲轨道追逐-规避博弈（OPEG）进行了全面研究。首先，考虑机动能力、燃料储备和任务持续时间等约束，建立了二对一脉冲OPEG的数学模型，将合作与竞争并存的二对一脉冲OPEG转化为适用于多智能体深度强化学习求解的多约束三方优化问题。随后，提出了一种基于多智能体深度确定性策略梯度（MADDPG）算法的合作博弈策略智能求解方法。在奖励函数设计部分，引入了一种基于固定时间触发的奖励函数，以解决长脉冲间隔导致的信息丢失问题。为确保算法具有良好的收敛性，并在训练过程中引导航天器学习有效的合作策略，设计了包含结果奖励、引导奖励和合作奖励的即时奖励函数。数值仿真验证了所提方法的可行性和有效性。为进一步分析算法训练过程中航天器学到的合作机制，设计了一对一脉冲OPEG对比实验。实验结果表明，二对一脉冲OPEG中的两个追逐器在训练过程中不仅形成了``先发制人拦截''、``钳形拦截''和``尾随追击''等多种策略，还通过协调配合提高了任务成功率并缩短了任务持续时间。此外，本文揭示了两个追逐航天器与逃逸航天器之间的相对初始状态分布对合作效果的影响},
  file = {/home/ouyangjiahong/Zotero/storage/NF3T3Y4Q/Zhao 等 - 2025 - Intelligent strategy resolution methods and mechanism analysis in two-on-one impulsive orbital pursu.pdf}
}


@article{howellAlmostRectilinearHalo1984,
  title = {Almost Rectilinear Halo Orbits},
  author = {Howell, K. C. and Breakwell, J. V.},
  year = 1984,
  month = jan,
  journal = {Celestial Mechanics},
  volume = {32},
  number = {1},
  pages = {29--52},
  doi = {10.1007/BF01358402},
  urldate = {2025-11-27},
  abstract = {Numerical studies over the entire range of mass ratios in the circular restricted three-body problem have revealed the existence of families of three-dimensional `halo' periodic orbits emanating from the general vicinity of any of the three collinear Lagrangian libration points. Following a family towards the nearer primary leads, in two different cases, to thin, almost rectilinear orbits aligned essentially perpendicular to the plane of motion of the primaries. (i) If the nearer primary is much more massive than the farther, these thin L{$_3$}-family halo orbits are analyzed by looking at the in-plane components of the small osculating angular momentum relative to the larger primary and at the small in-plane components of the osculating Laplace eccentricity vector. The analysis is carried out either to first or second order in these four small quantities, and the resulting orbits and their stability are compared with those obtained by a regularized numerical integration. (ii) If the nearer primary is much less massive than the farther, the thin L{$_1$}-family and L{$_2$}-family halo orbits are analyzed to first order in these same four small quantities with an independent variable related to the one-dimensional approximate motion. The resulting orbits and their stability are again compared with those obtained by numerical integration.},
  langid = {english},
  annotation = {titleTranslation: 近直线晕轨道\\
abstractTranslation: 在圆形限制性三体问题中对质量比全范围的数值研究表明，存在从三个共线拉格朗日平动点附近区域衍生的三维``晕''周期轨道族。当沿某轨道族向较近主天体方向追踪时，在两种不同情形下会得到细长、几乎呈直线状的轨道，其延伸方向基本垂直于主天体运动平面。\\
\\
（i）若较近主天体质量远大于较远主天体，可通过分析这些细长L3族晕轨道相对于较大主天体的瞬时角动量面内分量，以及瞬时拉普拉斯偏心率矢量的面内小分量来进行研究。分析针对这四个小量展开至一阶或二阶，并将所得轨道及其稳定性与正则化数值积分结果进行对比。\\
\\
（ii）若较近主天体质量远小于较远主天体，则针对细长L1族和L2族晕轨道，采用与一维近似运动相关的自变量，对上述四个小量进行一阶分析。所得轨道及其稳定性同样与数值积分结果进行比较。},
  file = {/home/ouyangjiahong/Zotero/storage/RBLR247U/Howell和Breakwell - 1984 - Almost rectilinear halo orbits.pdf}
}

@article{howellApplicationDynamicalSystems1997,
  title = {Application of Dynamical Systems Theory to Trajectory Design for a Libration Point Mission},
  author = {Howell, K. C. and Barden, B. T. and Lo, M. W.},
  year = 1997,
  month = jun,
  journal = {Journal of Astronautical Sciences},
  volume = {45},
  number = {2},
  pages = {161--178},
  issn = {2195-0571},
  doi = {10.1007/BF03546374},
  abstract = {Recently, there has been accelerated interest in missions utilizing trajectories near libration points. The trajectory design issues involved in missions of such complexity go beyond the lack of preliminary baseline trajectories (since conic analysis fails in this region of the solution space). Successful and efficient design of mission options will require new persepectives; a more complete understanding of the solution space is imperative. In this investigation, dynamical systems theory is applied to better understand the geometry of the phase space in the three-body problem via stable and unstable manifolds. Then, the manifolds are used to generate various solution arcs and establish trajectory options that are then utilized in preliminary design for the proposed Suess-Urey mission.},
  langid = {english},
  annotation = {titleTranslation: 动力系统理论在平动点任务轨道设计中的应用\\
abstractTranslation: 近年来，利用平动点附近轨道的任务引起了越来越多的关注。此类复杂任务中涉及的轨迹设计问题，远不止缺乏初步基准轨迹（因为圆锥曲线分析在该解空间区域内失效）。成功且高效地设计任务方案需要新的视角；更全面地理解解空间至关重要。本研究应用动力系统理论，通过稳定流形与不稳定流形来深入理解三体问题中相空间的几何结构。随后，利用这些流形生成各种解弧并建立轨迹方案，进而将其应用于拟议的Suess-Urey任务的初步设计中},
  file = {/home/ouyangjiahong/Zotero/storage/ELHJCVNL/Howell 等 - 1997 - Application of dynamical systems theory to trajectory design for a libration point mission.pdf}
}


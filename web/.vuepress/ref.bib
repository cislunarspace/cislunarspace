@article{ceccarelliSpacecraftLocalizationAngle2007,
  title = {Spacecraft Localization via Angle Measurements for Autonomous Navigation in Deep Space Missions},
  author = {Ceccarelli, Nicola and Garulli, Andrea and Giannitrapani, Antonio and Leomanni, Mirko and Scortecci, Fabrizio},
  year = 2007,
  journal = {IFAC Proceedings Volumes},
  volume = {40},
  number = {7},
  pages = {551--556},
  issn = {14746670},
  doi = {10.3182/20070625-5-FR-2916.00094},
  urldate = {2025-11-27},
  abstract = {This paper deals with spacecraft autonomous navigation in deep space missions. The considered problem is that of spacecraft localization based on angular measurements. The dynamic model of the spacecraft accounts for several perturbing effects, such as Earth and Moon gravitational field asymmetry and errors associated with the Moon ephemerides. The measurement process is based on elevation and azimuth of Moon and Earth with respect to the spacecraft reference system. Distance measurements are not employed. Position and velocity of the spacecraft are estimated by using both the Extended Kalman Filter (EKF) and the Unscented Kalman Filter (UKF). The performance of the filters are evaluated on an example of Earth-to-Moon transfer mission.},
  langid = {english},
  annotation = {titleTranslation: 通过角度测量进行航天器定位，用于深空任务中的自主导航\\
abstractTranslation: 本文探讨了深空任务中的航天器自主导航问题。所考虑的问题是基于角度测量的航天器定位。航天器的动力学模型考虑了多种摄动效应，例如地球和月球引力场的不对称性以及月球星历相关的误差。测量过程基于月球和地球相对于航天器参考系的高度角和方位角，未采用距离测量。航天器的位置和速度通过扩展卡尔曼滤波器（EKF）和无迹卡尔曼滤波器（UKF）进行估计。两种滤波器的性能以地月转移任务为例进行了评估},
  file = {/home/ouyangjiahong/Zotero/storage/CN5K3YHN/Ceccarelli 等 - 2007 - Spacecraft localization via angle measurements for autonomous navigation in deep space missions.pdf}
}

@article{cellettiDynamicsCollinearPoints2024,
  title = {The Dynamics around the Collinear Points of the Elliptic Three-Body Problem: A Normal Form Approach},
  shorttitle = {The Dynamics around the Collinear Points of the Elliptic Three-Body Problem},
  author = {Celletti, Alessandra and Lhotka, Christoph and Pucacco, Giuseppe},
  year = 2024,
  month = nov,
  journal = {Physica D: Nonlinear Phenomena},
  volume = {468},
  eprint = {2510.21937},
  primaryclass = {math},
  pages = {134302},
  issn = {01672789},
  doi = {10.1016/j.physd.2024.134302},
  urldate = {2026-01-01},
  abstract = {We study the dynamics of the collinear points in the planar, restricted three-body problem, assuming that the primaries move on an elliptic orbit around a common barycenter. The equations of motion can be conveniently written in a rotating pulsating barycentric frame, taking the true anomaly as independent variable. We consider the Hamiltonian modeling this problem in the extended phase space and we imple ment a normal form to make a center manifold reduction. The normal form provides an approximate solution for the Cartesian coordinates, which allows us to construct several kinds of orbits, most notably planar and vertical Lyapunov orbits, and halo orbits. We compare the analytical results with a numerical simulation, which requires special care in the selection of the initial conditions.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematical Physics,Mathematics - Dynamical Systems,Nonlinear Sciences - Chaotic Dynamics},
  annotation = {titleTranslation: 椭圆型三体问题共线点附近的动力学：正规形式方法\\
abstractTranslation: 我们研究平面限制性三体问题中共线平动点的动力学特性，假设主天体绕共同质心沿椭圆轨道运行。以真近点角为自变量，在旋转脉动质心坐标系中可便捷地建立运动方程。我们在扩展相空间中考虑该问题的哈密顿模型，并运用正规形式进行中心流形降维。该正规形式为笛卡尔坐标提供了近似解，使我们能构建多种类型的轨道，特别是平面与垂向李雅普诺夫轨道，以及晕轨道。我们将解析结果与数值模拟进行对比，该过程需特别注意初始条件的选取。},
  file = {/home/ouyangjiahong/Zotero/storage/8DBT3CID/Celletti 等 - 2024 - The dynamics around the collinear points of the elliptic three-body problem a normal form approach.pdf;/home/ouyangjiahong/Zotero/storage/ZYF9YG2J/2510.html}
}

@article{cellettiLissajousHaloOrbits2015,
  title = {Lissajous and Halo Orbits in the Restricted Three-Body Problem},
  author = {Celletti, Alessandra and Pucacco, Giuseppe and Stella, Danilo},
  year = 2015,
  month = apr,
  journal = {Journal of Nonlinear Science},
  volume = {25},
  number = {2},
  pages = {343--370},
  issn = {0938-8974, 1432-1467},
  doi = {10.1007/s00332-015-9232-2},
  urldate = {2025-11-20},
  abstract = {We study the dynamics near the collinear Lagrangian points of the spatial, circular, restricted three\textbraceleft body problem. Following a standard procedure, we reduce the system to the center manifold and we analyze the Lissajous orbits as well the halo orbits, the latter ones arising from bifurcations of the planar Lyapunov family of periodic orbits. To obtain the Lissajous orbits, we perform a classical perturbation theory and we provide a formal approximate solution under suitable non\textbraceleft degeneracy and non\textbraceleft{} resonance conditions. As for the halo orbits, we construct a normal form adapted to the synchronous resonance: introducing a detuning, measuring the displacement from the resonance, and expanding the energy in series of the detuning, we are able to evaluate the energy level at which the bifurcation takes place. Except for a particular case, the analytical values obtained after a second order resonant perturbation theory are in very good agreement (in some cases up to the fourth decimal digit) with the numerical values found in the literature.},
  langid = {english},
  annotation = {titleTranslation: 限制性三体问题中的李萨如轨道与晕轨道\\
abstractTranslation: 我们研究了空间圆型限制性三体问题中共线拉格朗日点附近的动力学。遵循标准步骤，将系统约化至中心流形，分析了Lissajous轨道以及由平面Lyapunov周期轨道族分岔产生的halo轨道。为获得Lissajous轨道，采用经典摄动理论，在适当的非退化与非共振条件下给出了形式近似解。针对halo轨道，构造了适应同步共振的规范型：引入失谐量以度量偏离共振的程度，并将能量展开为失谐量的级数，从而能够评估分岔发生时的能量水平。除个别特例之外，基于二阶共振摄动理论得到的分析值（某些情况下精确到小数点后第四位）与文献中的数值结果高度吻合。},
  file = {/home/ouyangjiahong/Zotero/storage/5VVE63PA/Celletti 等 - 2015 - Lissajous and halo orbits in the restricted three-body problem.pdf}
}


@article{xuLearningWinDDPG2025,
  title = {Learning to Win: {{DDPG}} vs. {{Differential}} Games in Orbital Pursuit-Evasion},
  shorttitle = {Learning to Win},
  author = {Xu, Sihan and Liu, Zhaoyang and Dang, Zhaohui},
  year = 2025,
  month = jan,
  journal = {IFAC-PapersOnLine},
  series = {23th {{IFAC Symposium}} on {{Automatic Control}} in {{Aerospace ACA}} 20255},
  volume = {59},
  number = {20},
  pages = {2224--2229},
  issn = {2405-8963},
  doi = {10.1016/j.ifacol.2025.11.490},
  urldate = {2026-03-08},
  abstract = {The study of spacecraft orbital pursuit-evasion games (OPEGs) has progressively evolved from classical differential game theory to artificial intelligence (AI)-based approaches. However, there remains a lack of comprehensive comparative analysis between AI methods and traditional differential game strategies in this context. This paper explores the effectiveness and counter-strategies of intelligent control---based on the Deep Deterministic Policy Gradient (DDPG) algorithm---versus classical differential game strategies, from both the pursuer and evader perspectives. Focusing on the infinite-horizon differential game model, we derive and solve the control gain matrices to obtain the optimal strategies for both spacecraft. To bridge the difference between continuous control in differential strategies and the impulsive control characteristic of space maneuvers, the motion equations for relative state variables are formulated, incorporating a variable integration step into the state-update process. An IDSA-DDPG (Intelligent and Differential Strategy Adversarial-DDPG) training framework is proposed, enabling direct competition between AI and classical strategies. Simulation results show that under the IDSA-DDPG framework, the intelligent strategy achieves a win rate of approximately 70\% against its differential counterpart and exhibits increasing superiority as constraints are relaxed.},
  langid = {english},
  keywords = {differential game strategy,intelligent game strategy,Orbital pursuit-evasion game,strategy counteract},
  annotation = {titleTranslation: 学会制胜：DDPG与微分博弈在轨道追逃中的较量\\
abstractTranslation: 航天器轨道追逃博弈（OPEG）的研究已从经典的微分博弈理论逐步演进到基于人工智能（AI）的方法。然而，在此背景下，AI方法与传统微分博弈策略之间仍缺乏全面的比较分析。本文从追捕者和逃避者双方视角，探讨了基于深度确定性策略梯度（DDPG）算法的智能控制与经典微分博弈策略的有效性及对抗策略。针对无限时域微分博弈模型，我们推导并求解了控制增益矩阵，从而获得两航天器的最优策略。为弥合微分策略中连续控制与空间机动中脉冲控制特性之间的差异，我们建立了相对状态变量的运动方程，并在状态更新过程中引入可变积分步长。提出了一种IDSA-DDPG（智能与微分策略对抗-DDPG）训练框架，实现了AI与经典策略之间的直接竞争。仿真结果表明，在IDSA-DDPG框架下，智能策略对抗微分策略的胜率约为70\%，且随着约束条件的放宽，其优势愈发显著。},
  file = {/home/ouyangjiahong/Zotero/storage/64RW6ZFU/Xu 等 - 2025 - Learning to win DDPG vs. Differential games in orbital pursuit-evasion.pdf;/home/ouyangjiahong/Zotero/storage/ANVASIHV/S2405896325021688.html}
}

@phdthesis{XuLiangShuangSanXingDianCiBianDuiXiangDuiPingHengTaiJiQiTeXingYanJiu2015,
  type = {硕士},
  title = {双/三星电磁编队相对平衡态及其特性研究},
  author = {{徐良}},
  year = 2015,
  abstract = {随着航天器在轨服务技术的不断发展,利用多个航天器组成编队协同工作,对某一特定空间目标实施在轨操控成为新的空间任务模式。近年来,以电磁力、库仑力为代表的星间非接触内力的研究,为航天器在轨操控提供了一种新的研究思路与技术途径。航天器电磁编队作为典型的非接触内力作用编队,利用安装于各航天器上的电磁装置产生可控电磁力/力矩以实现对编队系统相对位置/姿态的在轨控制,有效地解决了传统喷气推进带来的羽流污染、工质消耗等技术问题,一定程度上提供了连续、可逆且同步的在轨控制。随着协同航天器编队技术的飞速发展,电磁编队技术逐渐变为当今的研究热点和前沿性课题。但由于电磁编队的内力特性以及编队系统的高非线性/耦合性,给编队系统动力学与控制问题带来一定挑战,一些关于航天器电磁编队动力学与控制的难题仍有待解决。针对航天器电磁编队的动力学与控制问题,论文开展了电磁编队动力学建模、相对平衡态分析、编队系统稳定性分析等相关研究。(1)静态电磁编队相对平衡态条件。相对平衡态对应实现静态编队,此时编队系统各航天器相对位形保持不变,相关研究对编队系统空间构型保持与重构有重要意义。论文基于牛顿-欧拉方程建立航天器电磁编队矢量动力学模型;由静态编队平衡态特性,基于矢量力学方法推导航天器编队系统平衡态条件与磁偶极子配置情况。(2)电磁编队Hamilton动力学模型。航天器电磁编队在轨飞行涉及到复杂的运动形式:一是整个编队系统随质心做定点运动;二是编队系统中各航天器之间的相对运动。为清晰的描述编队系统的动力学特性和各航天器间的相对运动关系,论文基于Hamilton力学方法建立编队系统姿/轨耦合动力学模型,推导了航天器电磁编队无扰动条件下的耦合非线性六自由度动力学方程,并与电磁编队矢量力学模型对比,验证Hamilton力学模型适用性。(3)电磁编队平衡态求解及稳定性分析。航天器电磁编队相对平衡态及其稳定性问题研究是静态编队在轨运行的基础性课题,关系着航天器编队系统能否在轨安全且稳定运行。论文针对双/三星静态编队平衡态构型与磁偶极子配置等问题开展深入研究,基于所建立的航天器电磁编队相对平衡态条件结合编队系统Hamilton非线性动力学方程对求解平衡态构型的稳定特性进行分析,得出结论。},
  school = {国防科学技术大学},
  keywords = {;;;},
  file = {/home/ouyangjiahong/Zotero/storage/AML5UQLA/徐良 - 2015 - 双三星电磁编队相对平衡态及其特性研究.pdf}
}


@inproceedings{kechichianSolarSurveillanceZone2003,
  title = {Solar Surveillance Zone Population Strategies with PicosaTELlites Using Halo and Distant Retrograde Orbits},
  booktitle = {Libration {{Point Orbits}} and {{Applications}}},
  author = {Kechichian, J. A. and Campbell, E. T. and Werner, M. F. and Robinson, E. Y.},
  year = 2003,
  series = {Libration {{Point Orbits}} and {{Applications}}},
  address = {Aiguablava},
  doi = {10.1142/9789812704849_0008},
  abstract = {Solar surveillance missions that provide ample warning time of impending solar storms to satellite users in earth orbit are naturally designed to allow the weather forecasting spacecraft to wander as far away from the earth as possible, in the direction of the sun. Vehicles positioned on the L\_1 halo orbits do not provide more than an hour of warning time due to the fact that the L\_1 equilibrium point of the sun-earth system is located at some 1.5 million km from the earth. In order to increase this warning time by a factor of two or more, use is made in this paper of distant retrograde orbits which allow compact sensorcraft to remain in the vicinity of the earth but at substantially larger distances from it than the L\_1 point. However, the sensorcraft transit periodically and only for a limited time inside the surveillance zone centered on the sun-earth axis, such that a certain number of such sensorcraft is needed for continuous surveillance capability. An alternative scheme produces a finite number of passes through the surveillance zone with some transits reaching much further out toward the sun, over several years. Another scheme utilizes a series of miniature probes released from a multi-probe carrier vehicle from a parking halo orbit, to travel on that halo orbit invariant unstable manifold in successive single passes through the surveillance zone, requiring continuing replenishment. This paper shows several sensorcraft and sensor probes release strategies and their associated trajectories for both the distant retrograde orbit and the halo orbit cases. It also provides an estimate of the minimum number of probes needed for continuous coverage for a given time span.},
  langid = {english},
  annotation = {titleTranslation: 利用晕轨道与远逆行轨道的皮科卫星太阳监测区域人口策略}
}

@article{kechichianSolarSurveillanceZone2005,
  title = {Solar Surveillance Zone Population Strategies with Picosatellites Using Halo and Distant Retrograde Orbits},
  author = {K{\'e}chichian, Jean A. Jean. A. and Campbell, Eric T. and Werner, Michael F. and Robinson, Ernest Y.},
  year = 2005,
  journal = {Acta Astronautica},
  volume = {Vol.56},
  number = {NO.5},
  pages = {495--506},
  doi = {10.1016/j.actaastro.2004.10.003},
  abstract = {Solar surveillance missions that provide ample warning time of impending solar storms to satellite users in earth orbit are naturally designed to allow the weather forecasting spacecraft to wander as far away from the earth as possible, in the direct\%ion of the sun. Vehicles positioned on the L\_1 halo orbits do not provide more than an hour of warning time due to the fact that the L\_1 equilibrium point of the sun-earth system is located at some 1.5 million km from the earth. In order to increasethis warning time by a factor of two or more, use is made in this paper of distant retrograde orbits which allow compact sensorcraft to remain in the vicinity of the earth but at substantially larger distances from it than the L\_1 point. However, the sensorcraft transit periodically and only for a limited time inside the surveillance zone centered on the sun-earth axis, such that a certain number of such sensorcraft is needed for continuous surveillance capability. An alternative scheme produces a finite number of passes through the surveillance zone with some transits reaching much further out toward the sun, over several years. Another scheme utilizes a series of miniature probes released from a multi-probe carrier vehicle from a parkinghalo orbit, to travel on that halo orbit invariant unstable manifold in successive single passes through the surveillance zone, requiring continuing replenishment. This paper shows several sensorcraft and sensor probes release strategies and their associated trajectories for both the distant retrograde orbit and the halo orbit cases. It also provides an estimate of the minimum number of probes needed for continuous coverage for a given time span.},
  langid = {english},
  keywords = {Coronal mass ejections (CME),Earth (planet),Engineering controlled terms,Engineering main heading,Engineering uncontrolled terms,Geomagnetism,Orbits,Picosatellites,Plasma sources,Plasma structures,Satellites,Sensorcraft,Space probes,Space surveillance,Spacecraft,Weather forecasting},
  annotation = {titleTranslation: 利用晕轨道与远逆行轨道的皮卫星太阳监测区域布设策略\\
abstractTranslation: 旨在为地球轨道卫星用户提供充足太阳风暴预警时间的太阳监测任务，其设计自然要求气象预报航天器尽可能远离地球、朝向太阳方向运行。由于日地系统的L1平衡点距离地球约150万公里，部署在L1晕轨道上的航天器仅能提供不足一小时的预警时间。为将预警时间延长两倍或更多，本文采用远距离逆行轨道方案，使紧凑型监测航天器能在地球附近驻留，同时保持比L1点更远的距离。然而，此类监测航天器仅能周期性、有限时段地进入以日地轴线为中心的监测区域，因此需要部署一定数量才能实现连续监测能力。另一种方案可在数年内实现有限次数的监测区域穿越，其中若干次穿越可抵达更靠近太阳的深空区域。另有方案采用多探测器运载器从驻留晕轨道释放微型探测器群，使其沿该晕轨道的不稳定流形依次单次穿越监测区域，此方案需持续补充探测器。本文展示了针对远距离逆行轨道与晕轨道的多种监测航天器及探测器释放策略及其对应轨迹，并估算了给定时间段内实现连续监测所需的最小探测器数量。}

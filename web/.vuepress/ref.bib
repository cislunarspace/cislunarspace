@article{diezDynamicalEquivalentEquilateral1990,
  title = {A Dynamical Equivalent to the Equilateral Libration Points of the Earth-Moon System},
  author = {D{\'i}ez, Carles and Jorba, {\`A}ngel and Sim{\'o}, Carles},

@article{tsirogiannisGreedyGlobalSearch2013,
  title = {A Greedy Global Search Algorithm for Connecting Unstable Periodic Orbits with Low Energy Cost},
  author = {Tsirogiannis, G. A. and Markellos, V. V.},

@phdthesis{LiuLiBoYuanXingXianZhiXingSanTiWenTiXiaGongZhenGuiDaoDeSheJiJiWenDingXingFenXi2019,
  type = {{硕士学位论文}},
  title = {{圆型限制性三体问题下共振轨道的设计及稳定性分析}},
  author = {{刘俐波}},
  year = 2019,
  address = {北京},
  doi = {10.26935/d.cnki.gbjgu.2019.000379},
  abstract = {当围绕某一中心天体运动的两个或多个天体的轨道周期存在或接近一个有理数的比值时,这类轨道称为共振轨道。对天体系统而言,共振是系统引力之间长时间演化的结果,探测器的共振轨道则是可设计的,具有潜在的应用价值。本文分别给出了地月系统中二体问题和圆型限制性三体问题下的共振轨道的设计方法,并分析了共振轨道的两个重要初始参数对轨道动力学特性和运动规律的影响;以开普勒能量和月球影响球半径作为判断准则,得到了引起圆型限制性三体问题下共振轨道失去稳定共振比的初始参数区间,并进行了验证;探究圆型限制性三体问题下不同共振比的共振轨道族的稳定性和分岔。论文的研究内容分为如下几个部分:(1)动力学模型和坐标系选择:针对后续共振轨道设计与稳定性分析等一系列较为复杂的动力学建模问题,给出了本文涉及到的动力学模型和坐标系,并且介绍了不同坐标系之间的转换方法。(2)共振轨道的设计方法与动力学特性分析:分别介绍了地月系统二体问题和圆型限制性三体问题下共振轨道的设计方法,对影响共振轨道动力学特性和运动规律的两个重要的初始参数偏心率和初始相位差进行了分析,并确定初始参数会影响共振轨道与月球的相对位置关系。通过对比二体问题和圆型限制性三体问题下共振轨道的差异性,初步分析了月球对共振轨道的影响。(3)引起共振轨道失去稳定共振比的初始参数空间研究:基于共振飞越和月球弱捕获两个概念,以开普勒能量和月球影响范围为判断准则,建立初始参数与失去稳定共振比的共振轨道之间的联系,分析了不同偏心率和初始相位差对共振轨道与月球最近距离和对月开普勒能量的影响,得到了引起圆型限制性三体问题下共振轨道失去稳定共振比的初始参数区间。并以1:2外共振和2:1内共振轨道为例,对两个准则的进行了验证。(4)共振轨道的稳定性与分岔分析:引入单值矩阵的概念,以1:2和2:3共振轨道为例,利用分岔理论寻找新类型的周期轨道。并且引入稳定阶数和稳定系数两个概念对共振轨道族的稳定性进行了分析,确定了不稳定共振轨道的范围和周围存在的不变流形的维数。求解不稳定共振轨道附近的稳定和不稳定流形,引入了Poincare?截面得到流形在位置-速度坐标系下更清晰的视图,更直观得观察到相空间下流形与其他结构之间的相互关系。此外,还给出了1:3和1:4这种全局不稳定的共振轨道族的分析实例。},
  collaborator = {{钱霙婧}},
  langid = {chinese},
  school = {北京工业大学},
  file = {/home/ouyangjiahong/Zotero/storage/7DSHSDN8/刘俐波 - 2019 - 圆型限制性三体问题下共振轨道的设计及稳定性分析.pdf}
}

@article{liuLimitsApplicationMean2025,
  title = {On the Limits of Application of Mean Motion Resonant Normal Forms of the Three-Body Problem for Crossing Orbits and Close Encounters},
  author = {Liu, Xiang and Guzzo, Massimiliano},
  year = 2025,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},
  number = {1},
  pages = {1--33},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10232-0},
  urldate = {2025-10-01},
  abstract = {In this paper, we study the limits of application of canonical perturbation theory, specifically the validity of the normal form approximations, for the study of the mean motion resonances of the planar circular restricted three-body problem in the domain of orbits which cross, or are close to cross, the orbit of the secondary body. First, we discuss analytic issues related to the definition of a MMR normal form within a domain of the phase-space to which these orbits belong; then, we compute with a numerical method the canonical transformations defining the MMR normal forms. The limits of validity of the averaging method are studied by supplementing the information provided by the phase-portrait representations of the normal form Hamiltonian with analyses concerning the preservation of the quasi-integrals of motion obtained through one step of perturbation theory, and the computation of fast Lyapunov indicators regularized with respect to the close encounters with the secondary body. We provide numerical explorations using as model examples the external 1:2 and 5:6 MMRs for values of the mass ratios which are representative of the Sun--Jupiter and Sun--Neptune cases. For the 1:2 MMR, the efficacy of the averaging method is established also for chaotic orbits of eccentricity up to e {$\sim$} 0.55.},
  langid = {english},
  annotation = {titleTranslation: 关于三体问题中穿越轨道与近距交会情况下平运动共振正规形式应用的局限性\\
abstractTranslation: 本文研究规范摄动理论的应用极限，特别是正则形式近似的有效性，以分析平面圆形限制性三体问题中穿越或接近穿越次级天体轨道的轨道域内的平均运动共振。首先，我们讨论与这些轨道所属相空间域内平均运动共振正则形式定义相关的解析问题；随后，通过数值方法计算定义平均运动共振正则形式的规范变换。通过结合正则形式哈密顿量的相图表示所提供的信息，与对摄动理论单步获得的运动准积分保持性的分析，以及针对与次级天体近距离交会进行正则化处理的快速李雅普诺夫指标计算，我们研究了平均化方法的有效性极限。以代表太阳-木星和太阳-海王星情形的质量比值为例，利用外部1:2和5:6平均运动共振作为模型实例进行数值探索。对于1:2平均运动共振，平均化方法的有效性在偏心率高达e\textasciitilde 0.55的混沌轨道中也得到验证。},
  file = {/home/ouyangjiahong/Zotero/storage/FDWF6B4I/Liu和Guzzo - 2025 - On the limits of application of mean motion resonant normal forms of the three-body problem for cros.pdf}
}


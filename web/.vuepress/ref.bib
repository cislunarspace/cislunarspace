  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {Vol.46},
  number = {No.10},
  pages = {1929--1944},
  doi = {10.2514/1.G007495},
  abstract = {Impulsive maneuver design between quasi-periodic orbits (QPOs) remains a prevalent problem in astrodynamics. Challenges associated with the higher-dimensional nature of QPOs present difficulties when using existing approaches to design transfers between them. This paper establishes a methodology to abate these issues. Fundamental to the approach is the treatment of orbits as tori and their manifolds as the associated whiskers. Utilizing this formulation, intersection curves, surfaces, or volumes between the manifolds are computed leveraging a robust multiparameter continuation scheme. Intersections are then used to seed a multiple shooting scheme to compute transfer trajectories between a pair of orbits. The approach is applied in the Earth--moon circular restricted three-body problem. Numerical examples demonstrate the benefits of considering QPOs in the preliminary stage of trajectory design, showing that leveraging these higher-dimensional solutions offers reductions in propellant cost and transfer time when compared to their periodic counterparts.},
  langid = {english},
  keywords = {Distant Retrograde Orbit,Dynamical Systems Theory,Invariant Tori,Multi Body Dynamics,Multi-Parameter Continuation},
  annotation = {titleTranslation: 基于异宿不变流形交集的准周期轨道转移设计\\
abstractTranslation: 准周期轨道之间的脉冲机动设计仍然是天体动力学中的一个普遍问题。准周期轨道的高维特性，使得现有方法在设计它们之间的转移时面临困难。本文建立了一种缓解这些问题的方法论。该方法的核心是将轨道视为环面，并将其流形视为对应的须。利用这一表述，通过稳健的多参数延拓方法计算流形之间的交线、交面或交体。然后，将这些交集作为初始解，用于多重打靶法，从而计算一对轨道之间的转移轨迹。该方法应用于地月圆型限制性三体问题。数值示例表明，在轨迹设计的初步阶段考虑准周期轨道具有优势，利用这些高维解相比对应的周期轨道能够降低推进剂消耗和转移时间。}
}

@article{scheeresRestrictedHillFourbody1998,
  title = {The Restricted Hill Four-Body Problem with Applications to the {{Earth}}--Moon--Sun System},
  author = {Scheeres, D. J.},
  year = 1998,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {70},
  number = {2},
  pages = {75--98},
  issn = {0923-2958, 1572-9478},
  urldate = {2025-12-02},
  abstract = {Starting from the four-body problem a generalization of both the restricted three-body problem and the Hill three-body problem is derived. The model is time periodic and contains two parameters: the mass ratio {$\nu$} of the restricted three-body problem and the period parameter m of the Hill Variation orbit. In the proper coordinate frames the restricted three-body problem is recovered as m {$\rightarrow$} 0 and the classical Hill three-body problem is recovered as {$\nu$} {$\rightarrow$} 0. This model also predicts motions described by earlier researchers using specific models of the Earth--Moon--Sun system. An application of the current model to the motion of a spacecraft in the Sun perturbed Earth--Moon system is made using Hill's Variation orbit for the motion of the Earth--Moon system. The model is general enough to apply to the motion of an infinitesimal mass under the influence of any two primaries which orbit a larger mass. Using the model, numerical investigations of the structure of motions around the geometric position of the triangular Lagrange points are performed. Values of the parameter {$\nu$} range in the neighborhood of the Earth--Moon value as the parameter m increases from 0 to 0.195, at which point the Hill Variation orbit becomes unstable. Two families of planar periodic orbits are studied in detail as the parameters m and {$\nu$} vary. These families contain stable and unstable members in the plane and all have the out-of-plane stability. The stable and unstable manifolds of the unstable periodic orbits are computed and found to be trapped in a geometric area of phase space over long periods of time for ranges of the parameter values including the Earth--Moon--Sun system. This model is derived from the general four-body problem by rigorous application of the Hill and restricted approximations. The validity of the Hill approximation is discussed in light of the actual geometry of the Earth--Moon--Sun system.},
  copyright = {https://www.springernature.com/gp/researchers/text-and-data-mining},
  langid = {english},
  annotation = {titleTranslation: 《受限希尔四体问题及其在地-月-日系统中的应用》\\
abstractTranslation: 从四体问题出发，推导出了限制性三体问题和希尔三体问题的一种推广形式。该模型具有时间周期性，并包含两个参数：限制性三体问题中的质量比{$\nu$}，以及希尔变化轨道中的周期参数m。在适当的坐标框架下，当m{$\rightarrow$}0时恢复为限制性三体问题，当{$\nu\rightarrow$}0时恢复为经典希尔三体问题。该模型还预测了早期研究者利用地球-月球-太阳系统特定模型所描述的运动。以希尔变化轨道描述地球-月球系统的运动，将当前模型应用于太阳摄动下地球-月球系统中航天器的运动。该模型具有足够的普适性，可应用于任意两个绕更大质量天体运行的初级天体影响下无穷小质量的运动。利用该模型，对三角拉格朗日点几何位置周围运动的结构进行了数值研究。当参数m从0增加到0.195（此时希尔变化轨道变得不稳定）时，参数{$\nu$}的取值在地球-月球值附近变化。随着参数m和{$\nu$}的变化，详细研究了两个平面周期轨道族。这些族在平面内包含稳定和不稳定的成员，且均具有面外稳定性。计算了不稳定周期轨道的稳定流形和不稳定流形，发现在包括地球-月球-太阳系统在内的参数值范围内，这些流形在长时间内被限制在相空间的某个几何区域内。该模型通过严格应用希尔近似和限制性近似从一般四体问题推导而来。结合地球-月球-太阳系统的实际几何构型，讨论了希尔近似的有效性},
  file = {/home/ouyangjiahong/Zotero/storage/GNNEEY7F/Scheeres - 1998 - The restricted hill four-body problem with applications to the Earth–moon–sun system.pdf}
}

@article{scheeresSemianalyticalMeasuresNonlinearity2023,
  title = {Semianalytical Measures of Nonlinearity Based on Tensor Eigenpairs},
  author = {Scheeres, Erica L. Jenson And},
  year = 2023,
  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {Vol.46},
  number = {No.4},
  pages = {638--653},
  issn = {0731-5090},
  doi = {10.2514/1.G006760},
  abstract = {This paper proposes a semianalytical measure of nonlinearity (MoN) based on tensor eigenpairs. Approximating nonlinear dynamics via local linearization is a common practice that is used to enable analytical methods in dynamics, control, navigation, and uncertainty propagation. However, these linear approximations are only applicable near the linearization point, and the size and characteristics of the linear region are dependent on the system's underlying degree of nonlinearity. This paper presents a novel MoN that is based on the eigenpairs of tensors that are derived from the higher-order terms in a Taylor series expansion, e.g.,~the local dynamics tensors and state transition tensors. Unlike existing MoN, the tensor eigenpair measure of nonlinearity (TEMoN) is semianalytical and its computation does not require empirical sampling or numerical optimization. TEMoN can be used to quantify nonlinearity, identify directions of strong nonlinearity, predict the size of a linear region, and justify the truncation order of a Taylor series expansion by distinguishing higher-order contributions to nonlinearity. The TEMoN method is demonstrated for equilibrium points in the circular restricted three-body problem, near-rectilinear halo orbits, and nonlinear parameter transformations.},
  langid = {english},
  keywords = {Applied Mathematics,Astrodynamics,Mathematical Optimization,Nonlinear Dynamics,Nonlinear Systems,Numerical Integration,Orbital Mechanics,Taylor Series},
  annotation = {titleTranslation: 基于张量特征对的非线性半解析度量\\
abstractTranslation: 本文提出了一种基于张量特征对的非线性度量半解析方法。通过局部线性化近似非线性动力学，是动力学、控制、导航及不确定性传播中实现解析方法的常用手段。然而，这些线性近似仅在线性化点附近有效，且线性区域的大小和特征取决于系统固有的非线性程度。本文提出了一种新型非线性度量，其基于泰勒级数展开中高阶项所导出的张量特征对，例如局部动力学张量和状态转移张量。与现有非线性度量不同，张量特征对非线性度量（TEMoN）具有半解析特性，其计算无需经验采样或数值优化。TEMoN可用于量化非线性程度、识别强非线性方向、预测线性区域大小，并通过区分高阶项对非线性的贡献，论证泰勒级数展开的截断阶数。本文在圆形限制性三体问题的平衡点、近直线晕轨道及非线性参数变换中展示了TEMoN方法的应用。}
}


@article{brownSuperhumanAIMultiplayer2019,
  title = {Superhuman {{AI}} for Multiplayer Poker},
  author = {Brown, Noam and Sandholm, Tuomas},
  year = 2019,
  month = aug,
  journal = {Science},
  volume = {365},
  number = {6456},
  pages = {885--890},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.aay2400},
  urldate = {2026-04-23},
  abstract = {AI now masters six-player poker             Computer programs have shown superiority over humans in two-player games such as chess, Go, and heads-up, no-limit Texas hold'em poker. However, poker games usually include six players---a much trickier challenge for artificial intelligence than the two-player variant. Brown and Sandholm developed a program, dubbed Pluribus, that learned how to play six-player no-limit Texas hold'em by playing against five copies of itself (see the Perspective by Blair and Saffidine). When pitted against five elite professional poker players, or with five copies of Pluribus playing against one professional, the computer performed significantly better than humans over the course of 10,000 hands of poker.                            Science               , this issue p.               885               ; see also p.               864                        ,              An AI dubbed Pluribus performs significantly better than human professionals in six-player no-limit Texas hold'em poker.           ,              In recent years there have been great strides in artificial intelligence (AI), with games often serving as challenge problems, benchmarks, and milestones for progress. Poker has served for decades as such a challenge problem. Past successes in such benchmarks, including poker, have been limited to two-player games. However, poker in particular is traditionally played with more than two players. Multiplayer games present fundamental additional issues beyond those in two-player games, and multiplayer poker is a recognized AI milestone. In this paper we present Pluribus, an AI that we show is stronger than top human professionals in six-player no-limit Texas hold'em poker, the most popular form of poker played by humans.},
  langid = {english},
  annotation = {**论文摘要：** 人工智能现已掌握六人扑克\\
            在诸如国际象棋、围棋以及单挑无限注德州扑克等双人游戏中，计算机程序已展现出超越人类的能力。然而，扑克游戏通常包含六名玩家------这对人工智能而言，是比双人变体游戏棘手得多的挑战。Brown和Sandholm开发了一个名为Pluribus的程序，该程序通过与自身的五个副本对战，学会了如何进行六人无限注德州扑克（参见Blair和Saffidine的评论文章）。当与五名精英职业扑克玩家对弈，或者由五个Pluribus副本与一名职业玩家对战时，在总计10,000手牌的较量中，计算机的表现显著优于人类。\\
            \\
              《科学》\\
              ，本期第\\
              885\\
              页\\
              ；另见第\\
              864\\
              页\\
            \\
          , \\
            一款名为Pluribus的人工智能在六人无限注德州扑克中的表现显著优于人类职业选手。\\
          , \\
            近年来，人工智能（AI）取得了巨大进步，而游戏常常作为进展的挑战性问题、基准和里程碑。数十年来，扑克一直扮演着此类挑战性问题的角色。过去在此类基准（包括扑克）上的成功，仅限于双人游戏。然而，扑克尤其传统上是多人参与的游戏。多人游戏带来了超越双人游戏的根本性额外难题，而多人扑克是一个公认的人工智能里程碑。在本文中，我们介绍了Pluribus，我们证明这款人工智能在六人无限注德州扑克（人类最常玩的扑克形式）中强于顶尖的人类职业选手。\\
titleTranslation: **论文标题：** 多人扑克中的超人类人工智能\\
abstractTranslation: AI现已掌握六人扑克\\
\\
计算机程序在象棋、围棋以及单挑无限注德州扑克等双人游戏中已展现出超越人类的能力。然而，扑克通常有六名玩家参与------这对人工智能而言远比双人变体更具挑战性。Brown和Sandholm开发了一个名为Pluribus的程序，它通过与五个自身副本对弈学会了六人无限注德州扑克（参见Blair和Saffidine的评论）。当Pluribus与五位精英职业扑克选手对战，或者五个Pluribus副本与一位职业选手对战时，计算机在10000手扑克牌局中表现显著优于人类。\\
\\
《科学》杂志，本期第885页；另见第864页\\
\\
一款名为Pluribus的人工智能在六人无限注德州扑克中表现显著优于人类职业选手。\\
\\
近年来，人工智能取得了巨大进步，游戏常被用作挑战问题、基准测试和进展里程碑。扑克数十年来一直是此类挑战问题。过去在包括扑克在内的这些基准测试中的成功仅限于双人游戏。然而，特别是扑克传统上是由多于两名玩家参与的。多人游戏在双人游戏基础上带来了根本性的额外问题，而多人扑克是公认的人工智能里程碑。在本文中，我们介绍了Pluribus，这是一种在六人无限注德州扑克（人类最常玩的扑克形式）中表现强于顶级人类职业选手的人工智能。},

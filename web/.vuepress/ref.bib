@article{rosalesInvariantManifoldsL12023,
  title = {Invariant Manifolds near {{L1}} and {{L2}} in the Quasi-Bicircular Problem},
  author = {Rosales, Jos{\'e} J. and Jorba, {\`A}ngel and {Jorba-Cusc{\'o}}, Marc},
  year = 2023,
  month = apr,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {2},
  pages = {15--62},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10129-4},
  urldate = {2025-10-01},
  abstract = {The quasi-bicircular problem (QBCP) is a periodic time-dependent perturbation of the Earth--Moon restricted three-body problem (RTBP) that accounts for the effect of the Sun. It is based on using a periodic solution of the Earth--Moon--Sun three-body problem to write the equations of motion of the infinitesimal particle. The paper focuses on the dynamics near the L1 and L2 points of the Earth--Moon system in the QBCP. By means of a periodic time-dependent reduction to the center manifold, we show the existence of two families of quasi-periodic Lyapunov orbits around L1 (resp. L2) with two basic frequencies. The first of these two families is contained in the Earth--Moon plane and undergoes an out-of-plane (quasi-periodic) pitchfork bifurcation giving rise to a family of quasi-periodic Halo orbits. This analysis is complemented with the continuation of families of 2D tori. In particular, the planar and vertical Lyapunov families are continued, and their stability analyzed. Finally, examples of invariant manifolds associated with invariant 2D tori around the L2 that pass close to the Earth are shown. This phenomenon is not observed in the RTBP and opens the room to direct transfers from the Earth to the Earth--Moon L2 region.},
  langid = {english},
  annotation = {titleTranslation: 准双圆问题中L1与L2点附近的流形不变性\\
abstractTranslation: 准双圆问题（QBCP）是对地月限制性三体问题（RTBP）的一种周期时变扰动，它考虑了太阳的影响。该模型基于利用地月日三体问题的一个周期解来推导无穷小质点的运动方程。本文重点关注QBCP中地月系统L1和L2点附近的动力学。通过周期时变约化至中心流形，我们证明了围绕L1（及L2）存在两族具有两个基本频率的准周期Lyapunov轨道。其中第一族轨道位于地月平面内，并发生面外（准周期）叉型分岔，从而产生一族准周期Halo轨道。这一分析辅以二维环面族的延续。具体而言，我们对平面和垂直Lyapunov族进行了延续，并分析了其稳定性。最后，展示了与L2附近不变二维环面相关联的不变流形示例，这些流形能够接近地球。这一现象在RTBP中并未观察到，从而为从地球到地月L2区域的直接转移开辟了可能。},
  file = {/home/ouyangjiahong/Zotero/storage/GGLY575W/Rosales 等 - 2023 - Invariant manifolds near L1 and L2 in the quasi-bicircular problem.pdf}
}

@phdthesis{roseStatisticalMethodsLaunch2012,
  title = {Statistical Methods for Launch Vehicle Guidance, Navigation, and Control ({{GN}}\&{{C}}) System Design and Analysis},
  author = {Rose, Michael B.},
  year = 2012,
  journal = {ProQuest Dissertations and Theses},
  abstract = {A novel trajectory and attitude control and navigation analysis tool for powered ascent is developed. The tool is capable of rapid trade-space analysis and is designed to ultimately reduce turnaround time for launch vehicle design, mission planning, and redesign work. It is streamlined to quickly determine trajectory and attitude control dispersions, propellant dispersions, orbit insertion dispersions, and navigation errors and their sensitivities to sensor errors, actuator execution uncertainties, and random disturbances. The tool is developed by applying both Monte Carlo and linear covariance analysis techniques to a closed-loop, launch vehicle guidance, navigation, and control (GN\&C) system. The nonlinear dynamics and flight GN\&C software models of a closed-loop, six-degree-of-freedom (6-DOF), Monte Carlo simulation are formulated and developed. The nominal reference trajectory (NRT) for the proposed lunar ascent trajectory is defined and generated. The Monte Carlo truth models and GN\&C algorithms are linearized about the NRT, the linear covariance equations are formulated, and the linear covariance simulation is developed. The performance of the launch vehicle GN\&C system is evaluated using both Monte Carlo and linear covariance techniques and their trajectory and attitude control dispersion, propellant dispersion, orbit insertion dispersion, and navigation error results are validated and compared. Statistical results from linear covariance analysis are generally within 10\% of Monte Carlo results, and in most cases the differences are less than 5\%. This is an excellent result given the many complex nonlinearities that are embedded in the ascent GN\&C problem. Moreover, the real value of this tool lies in its speed, where the linear covariance simulation is 1036.62 times faster than the Monte Carlo simulation. Although the application and results presented are for a lunar, single-stage-to-orbit (SSTO), ascent vehicle, the tools, techniques, and mathematical formulations that are discussed are applicable to ascent on Earth or other planets as well as other rocket-powered systems such as sounding rockets and ballistic missiles.},
  isbn = {978-1-267-54237-3},
  langid = {english},
  keywords = {0538:Aerospace engineering,Aerospace engineering,Applied sciences,Guidance,Launch vehicles,Linear covariance analysis,Monte Carlo analysis,Navigation},
  annotation = {titleTranslation: 运载火箭制导、导航和控制（GN\&C）系统设计和分析的统计方法},
  file = {/home/ouyangjiahong/Zotero/storage/74E4KDPC/Rose - 2012 - Statistical methods for launch vehicle guidance, navigation, and control (GN&C) system design and an.pdf}
}


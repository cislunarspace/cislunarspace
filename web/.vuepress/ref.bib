@article{jinghuiSpacebasedOrbitDetermination2023,
  title = {Space-Based Orbit Determination and Time Synchronization Method for Three Typical Cislunar Orbits},
  author = {Jinghui, P. U. and Shuanglin, L. I. and Jiangkai, Liu and Pengbin, Guo and Wenbin, Wang},
  year = 2023,
  journal = {Journal of Deep Space Exploration},
  volume = {Vol.10},
  number = {No.6},
  pages = {641--651},
  abstract = {In this paper, a space-based orbit determination and time synchronization method for Earth-Moon spacecraft was presented. As a ``space-based tracking station'', LEO satellite on the one hand receives GNSS navigation signals to achieve high-precision real-time orbit determination and timing；on the other hand, it establishes measurement links with Earth-moon space spacecraft to support the fast and high-precision orbit determination of Earth-moon spacecraft. Compared with ground stations, LEO satellites operate at a faster speed and orbit the Earth in a shorter period. The Earth-Moon spacecraft and its measurement link have the advantages of short invisible time interval, better measurement geometry, and no atmospheric delay in the measurement process. Therefore, using LEO satellite can improve the convergence speed and accuracy of orbit determination. This paper analyzed the space-based orbit determination and time synchronization performance of three typical orbits in Earth-Moon space, including the distant retrograde orbit (DRO), the highly elliptical orbit (HEO) and the Earth-moon transfer orbit. Space-based orbit determination simulation results show that when the LEO satellite position accuracy is high, the convergence time of the three orbits is less than 3 hours, the orbit position accuracy is about 50 m, and the time synchronization accuracy is tens of nanoseconds. Therefore, this method can hopefully solve the problems of limited deployment and heavy burden of ground stations.},
  langid = {english},
  keywords = {dual one-way ranging,extended Kalman filter,GNSS navigation,satellite-to-satellite tracking link,space-based orbit determination},
  annotation = {titleTranslation: 三种典型地月轨道的天基定轨与时间同步方法\\
abstractTranslation: 本文提出了一种面向地月空间航天器的天基定轨与时间同步方法。作为``天基跟踪站''，低轨卫星一方面接收GNSS导航信号，实现高精度实时定轨与授时；另一方面，与地月空间航天器建立测量链路，支持地月空间航天器快速高精度定轨。相较于地面站，低轨卫星运行速度更快、绕地周期更短。地月空间航天器及其测量链路具有不可见时间间隔短、测量几何更好、测量过程中无大气延迟等优势。因此，利用低轨卫星可提升定轨的收敛速度与精度。本文分析了地月空间三种典型轨道------远距离逆行轨道（DRO）、大椭圆轨道（HEO）及地月转移轨道------的天基定轨与时间同步性能。天基定轨仿真结果表明，当低轨卫星位置精度较高时，三种轨道的收敛时间均小于3小时，轨道位置精度约为50米，时间同步精度为数十纳秒。因此，该方法有望解决地面站部署受限、负担沉重等问题}
}

@article{jingIntentionRecognitionSpace2025,
  title = {Intention Recognition of Space Noncooperative Targets Using Large Language Models},
  author = {Jing, Heng and Sun, Qinbo and Dang, Zhaohui and Wang, Hua},
  year = 2025,
  month = jan,
  journal = {Space: Science \& Technology},
  volume = {5},
  pages = {0271},
  issn = {2692-7659},
  doi = {10.34133/space.0271},
  urldate = {2026-03-27},
  abstract = {This study proposes a novel method for intention recognition of space noncooperative targets using large language models (LLMs). Traditional methods rely on motion data to assess orbital motion intentions but cannot infer operation and task intentions from multi-source information like images. LLMs, with their logical reasoning capabilities, can address this limitation. The intentions are categorized into 3 types and 23 subtypes based on multi-source information and their characteristics: motion intentions (e.g., ``hovering'', ``flyby'', and ``rendezvous''), operation intentions (e.g., ``docking'', ``refueling'', and ``repair''), and task intentions (e.g., ``detection'', ``surveillance'', and ``attack''). The proposed method constructs LLMs for spacecraft intention recognition, involving prompt classification, template design, and test sample generation. The use of prompt tuning V2 (P-tuning V2) and low-rank adaptation (LoRA) fine-tuning enhances the models' performance. A dataset of 50,688 nominal samples and 8,448 perturbed samples was created through computer simulation based on expert knowledge, focusing on intention recognition of approaching targets in space station on-orbit operation and surveillance scenarios. The models were tested under 3 prompt conditions: basic, instruction, and chain-of-thought (CoT). The performance of 6 models (ChatGLM2-6B and ChatGLM3-6B base and fine-tuned models) was analyzed. Notably, the LoRA fine-tuned ChatGLM3-6B model on instruction prompts achieved 99.9\% accuracy, with improved robustness compared to the base model. This work presents a pioneering application of LLMs for spacecraft intention recognition, offering valuable insights for future research and applications.},
  langid = {english},
  annotation = {titleTranslation: 基于大语言模型的空间非合作目标意图识别\\
abstractTranslation: 本研究提出了一种利用大型语言模型（LLMs）识别空间非合作目标意图的新方法。传统方法依赖运动数据评估轨道运动意图，但无法从图像等多源信息中推断操作与任务意图。LLMs凭借其逻辑推理能力能够弥补这一不足。基于多源信息及其特性，将意图分为3大类及23个子类：运动意图（如``悬停''、``飞越''、``交会''）、操作意图（如``对接''、``加油''、``维修''）和任务意图（如``探测''、``监视''、``攻击''）。所提方法构建了用于航天器意图识别的LLMs，涉及提示分类、模板设计与测试样本生成。采用提示微调V2（P-tuning V2）和低秩适应（LoRA）微调提升了模型性能。基于专家知识，通过计算机仿真生成了包含50,688个标称样本和8,448个扰动样本的数据集，重点针对空间站在轨操作与监视场景中接近目标的意图识别。模型在三种提示条件下进行了测试：基础提示、指令提示和思维链（CoT）提示。分析了6个模型（ChatGLM2-6B与ChatGLM3-6B的基础模型及微调模型）的性能。值得注意的是，采用LoRA微调的ChatGLM3-6B模型在指令提示下达到了99.9\%的准确率，且相比基础模型鲁棒性更强。本工作开创性地将LLMs应用于航天器意图识别，为未来研究与应用提供了宝贵见解。},
  file = {/home/ouyangjiahong/Zotero/storage/9CXLXZRS/Jing 等 - 2025 - Intention recognition of space noncooperative targets using large language models.pdf;/home/ouyangjiahong/Zotero/storage/JJ5X7PIY/Jing 等 - 2025 - Intention recognition of space noncooperative targets using large language models.pdf}
}


@phdthesis{vananderlechtTadpoleOrbitsL42016,
  title = {Tadpole Orbits in the {{L4}}/{{L5}} Region: Construction and Links to Other Families of Periodic Orbits},
  shorttitle = {Tadpole Orbits in the {{L4}}/{{L5}} Region},
  author = {Van Anderlecht, Alexandre G.},
  year = 2016,
  pages = {236},
  abstract = {The equations of motion in the Circular Restricted Three-Body Problem (CR3BP) allow five equilibrium solutions, that is, the Lagrange or libration points. Two of the five equilibrium solutions are the triangular or equilateral libration points, L4 and L 5. As the secondary gravitational body moves in its orbit about the larger mass, L4 and L5 lead and trail the secondary by 60 degrees, respectively. This investigation focuses on periodic solutions in the vicinity of the triangular libration points, specifically horseshoe and tadpole orbits. Horseshoe orbits are symmetric periodic solutions in the plane of primary motion encompassing both triangular points, as well as one of the collinear libration points, L 3. As a result of these known properties, it is possible to identify regions bounding the motion of horseshoe orbits. Also planar, tadpole orbits represent stable oscillations about the triangular points, combining a long-period librational motion and a short-period epicyclic motion reflecting the period of the two large gravitational bodies about their barycenter. Different strategies are developed to effectively construct tadpole orbits numerically, since the motion is not symmetrical and cannot be bounded to a limiting region as accomplished with horseshoe orbits. The relationship between tadpole orbits and other periodic orbits in the vicinity of L4 and L 5 is examined to explore the natural dynamical evolution of motion and produce useful insight for applications.},
  isbn = {978-1-369-03643-5},
  langid = {english},
  keywords = {0538:Aerospace engineering,0596:Astrophysics,Aerospace engineering,Applied sciences,Astrophysics,Horseshoe,Orbits,Pure sciences,Tadpole,Three-body},
  annotation = {titleTranslation: L4/L5区域蝌蚪型轨道：构建方法及其与其它周期轨道族的关联},
  file = {/home/ouyangjiahong/Zotero/storage/MMGMJN8C/Van Anderlecht - 2016 - Tadpole orbits in the L4L5 region construction and links to other families of periodic orbits.pdf}
}

@article{vanantiMetricsSpaceClosed2023,
  title = {Metrics on Space of Closed Orbits for Near-Earth Objects Identification},
  author = {Vananti, A. and Meyer Zu Westram, Moritz and Schildknecht, T.},
  year = 2023,
  month = oct,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {5},
  pages = {51},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10165-0},
  urldate = {2025-10-01},
  abstract = {In the characterization of the space debris environment, the computation of the orbit of the debris objects is usually conducted by considering the association of short sequences of observations called tracklets. In case the orbits can be already determined with sufficient accuracy from single tracklets, it is necessary to define a criterion to decide if two calculated orbits correspond to the same object. One possibility is to introduce a definition of distance between orbits and to consider a threshold below which the two orbits are considered to be originating from the same object. The concept of distance is quite general and leaves room to different definitions. There are different ways to describe and to parameterize the space of the possible orbits. In this article, new metrics are proposed which extend distance definitions suggested in previous works. In these metrics in addition to orbital plane and orbital shape, also the position of the object along the orbit is taken into account. The obtained distances are scaled according to the orbit covariance. This has the advantage that the distance between orbits with different accuracy can be evaluated. The proposed metrics are then compared with existing common metrics to assess their applicability.},
  langid = {english},
  annotation = {titleTranslation: 近地天体识别的闭合轨道空间度量。\\
abstractTranslation: 在空间碎片环境表征过程中，碎片目标的轨道计算通常基于称为tracklet的短弧观测序列关联进行。当单个tracklet已能足够精确地确定轨道时，需定义判据以判断两个计算轨道是否对应同一目标。一种可行方案是引入轨道间距离的定义，并设定阈值：若距离低于该阈值，则认为两轨道源自同一目标。距离概念具有高度通用性，可衍生多种定义方式。描述和参数化可能轨道空间的方法也各不相同。本文提出新的度量方法，扩展了先前研究中提出的距离定义。这些新度量不仅考虑轨道平面与轨道形状，还考虑了目标沿轨道的具体位置。所得距离根据轨道协方差进行缩放，其优势在于可评估不同精度轨道间的距离。随后将所提度量与现有常用度量进行对比，以评估其适用性。},
  file = {/home/ouyangjiahong/Zotero/storage/QIDVV9UH/Vananti 等 - 2023 - Metrics on space of closed orbits for near-earth objects identification.pdf}
}


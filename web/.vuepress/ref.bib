@article{boudadDepartureEscapeDynamics2022,
  title = {Departure and Escape Dynamics from the near Rectilinear Halo Orbits in the {{Earth-moon-sun}} System},
  author = {Boudad, Kenza K. and Davis, Kathleen C. Howell Diane},
  year = 2022,
  journal = {Journal of Astronautical Sciences},
  volume = {Vol.69},
  number = {No.4},
  pages = {1076--1114},
  issn = {0021-9142},
  doi = {10.1007/s40295-022-00328-w},
  abstract = {A proposed Gateway facility in a lunar near rectilinear halo orbit (NRHO) will serve as an outpost in cislunar space, with various spacecraft periodically arriving and departing. The dynamics in the proximity of an NRHO are complex; the motion is primarily influenced by the Earth and Moon within the vicinity of the NRHO, but spacecraft are significantly impacted by solar gravity upon departure from the lunar vicinity. The current investigation explores two aspects of the trajectory dynamics after a separation maneuver from Gateway: departure dynamics and escape dynamics. The departure dynamics analysis focuses on the immediate fate of the trajectory after a maneuver, while the object remains close to the NRHO. The escape dynamics analysis details the outcome of the trajectory, that is, whether it remains in the Earth-Moon vicinity or escapes to heliocentric space. This investigation identifies a range of parameters and metrics at the different stages along the departed trajectory that inform the trajectory design process.},
  langid = {english},
  keywords = {Bicircular restricted four-body model,Circular restricted three-body model,Dynamical systems theory,Escape dynamics,Multi-body dynamics,Near rectilinear halo orbit},
  annotation = {titleTranslation: 地-月-日系统中近直线晕轨道的出发与逃逸动力学\\
abstractTranslation: 拟议中的月球近直线晕轨道（NRHO）门户设施将作为地月空间的前哨站，各类航天器会定期抵达和离开。NRHO附近的动力学特性较为复杂：在NRHO邻近区域，航天器的运动主要受地球和月球影响，但一旦离开月球附近，太阳引力将对其产生显著作用。本研究探讨了从门户设施分离机动后的轨迹动力学中的两个方面：离开动力学与逃逸动力学。离开动力学分析关注机动后轨迹的即时状态，此时飞行器仍停留在NRHO附近；逃逸动力学分析则详细描述轨迹的最终归宿------是继续停留在地月附近，还是逃逸至日心空间。本研究识别了沿离开轨迹不同阶段的一系列参数与指标，为轨迹设计过程提供参考}
}


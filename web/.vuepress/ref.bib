@article{yeObservationScopeSpatial2018,
  title = {Observation Scope and Spatial Coverage Analysis for Earth Observation from a {{Moon-based}} Platform},
  author = {Ye, Hanlin and Guo, Huadong and Liu, Guang and Ren, Yuanzhen},
  year = 2018,
  month = sep,
  journal = {International Journal of Remote Sensing},
  volume = {39},
  number = {18},
  pages = {5809--5833},
  issn = {0143-1161, 1366-5901},
  doi = {10.1080/01431161.2017.1395976},
  urldate = {2025-09-25},
  abstract = {As a new concept platform for Earth observation, a Moon-based platform has the advantages of large-scale, constant and long-term dynamic Earth observations that can meet the needs of conducting systematic research on the Earth. However, a Moon-based platform has particular differences from space-borne and air-borne platforms because of its long distance from the Earth and the vast expanses of the Moon. In this article, we present three contributions. First, we propose a formula to describe the relative position of the Moonbased platform and Earth observation target. Second, we establish an observation geometry model and discuss three key observation parameters that are vital to the observation scope and coverage calculation. Third, a new observation scope and coverage analysis method is established in order to demonstrate that a suitable Moonbased Earth observation platform site can be located in the full observation region. We establish a geometric model for a Moon-based platform based on the Earth orientation parameters and Jet Propulsion Laboratory (JPL) ephemerides. Then, three key parameters including the visibility of the Earth from the Moon, nadir point, and Earth viewing angle are calculated using the proposed model. These parameters determine the observation scope and coverage of the Earth. The Earth-facing hemisphere of the Moon is divided into four regions, including the full observation region and the incomplete observation regions. Compared with the selenocentric case, during orbital periods, the maximum nadir point's latitudinal and longitudinal difference in terms of placing sensors on the Moon surface is about 0.3{$^\circ$}, the maximum viewing angle difference of the Earth is about 0.005{$^\circ$}, and the maximum angular difference of the Moon-based platform and the Sun is about 0.24{$^\circ$}. Thus, the maximum coverage difference is about 0.1\%, so that placing sensors on the full observation region would result in better Earth observation performance.},
  langid = {english},
  annotation = {titleTranslation: 月球基地对地观测的观测范围与空间覆盖分析\\
abstractTranslation: 作为地球观测的新概念平台，月基平台具备大尺度、持续且长期动态观测地球的优势，能够满足对地球进行系统性研究的需求。然而，由于月基平台距离地球遥远且月球表面广阔，它与天基和空基平台存在显著差异。本文提出三项贡献：首先，推导出描述月基平台与地球观测目标相对位置的公式；其次，建立观测几何模型并讨论三个关键观测参数，这些参数对观测范围与覆盖计算至关重要；第三，建立新的观测范围与覆盖分析方法，以证明合适的月基地球观测平台站点可位于全观测区域内。基于地球定向参数和JPL星历，我们构建了月基平台几何模型，并通过该模型计算了三个关键参数（包括月球对地球的可视性、星下点和地球视角）。这些参数决定了地球的观测范围与覆盖面积。月球朝向地球的半球被划分为四个区域，包括全观测区域和不完全观测区域。与月心坐标系情况相比，在轨道周期内，在月球表面布设传感器时，星下点最大经纬度差异约为0.3{$^\circ$}，地球视角最大差异约为0.005{$^\circ$}，月基平台与太阳的最大角度差异约为0.24{$^\circ$}。因此，最大覆盖差异约为0.1\%，将传感器布设在全观测区域可获得更优的地球观测性能。},
  file = {/home/ouyangjiahong/Zotero/storage/QC665C9B/Ye 等 - 2018 - Observation scope and spatial coverage analysis for earth observation from a Moon-based platform.pdf}
}


  pages = {77--106},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-012-9434-y},
  urldate = {2025-11-27},
  abstract = {We demonstrate the remarkable effectiveness of boundary value formulations coupled to numerical continuation for the computation of stable and unstable manifolds in systems of ordinary differential equations. Specifically, we consider the Circular Restricted Three-Body Problem (CR3BP), which models the motion of a satellite in an EarthMoon-like system. The CR3BP has many well-known families of periodic orbits, such as the planar Lyapunov orbits and the non-planar Vertical and Halo orbits. We compute the unstable manifolds of selected Vertical and Halo orbits, which in several cases leads to the detection of heteroclinic connections from such a periodic orbit to invariant tori. Subsequent continuation of these connecting orbits with a suitable end point condition and allowing the energy level to vary leads to the further detection of apparent homoclinic connections from the base periodic orbit to itself, or the detection of heteroclinic connections from the base periodic orbit to other periodic orbits. Some of these connecting orbits are of potential interest in space mission design.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Dynamical Systems,Mathematics - Numerical Analysis},
  annotation = {titleTranslation: 计算圆形限制性三体问题中的不变流形与连接轨道\\
abstractTranslation: 我们展示了边值问题公式化与数值延拓相结合在常微分方程组系统中计算稳定与不稳定流形的显著有效性。具体而言，我们考虑了圆型限制性三体问题（CR3BP），该模型描述了卫星在地月系统中的运动。CR3BP中存在许多已知的周期轨道族，例如平面Lyapunov轨道以及非平面的垂直轨道和Halo轨道。我们计算了选定垂直轨道和Halo轨道的不稳定流形，这在若干情况下导致检测到从该周期轨道到不变环面的异宿连接。随后，利用适当的端点条件并允许能量水平变化对这些连接轨道进行延拓，进一步检测到从基础周期轨道到自身的明显同宿连接，或从基础周期轨道到其他周期轨道的异宿连接。其中一些连接轨道在空间任务设计中具有潜在价值。},
  file = {/home/ouyangjiahong/Zotero/storage/45JDJ6EY/Calleja 等 - 2012 - Computing invariant manifolds and connecting orbits in the circular restricted three body problem.pdf;/home/ouyangjiahong/Zotero/storage/XTCC2USN/Calleja 等 - 2012 - Computing invariant manifolds and connecting orbits in the circular restricted three body problem.pdf}
}


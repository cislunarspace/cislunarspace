@article{kimInvestigationLunarLanding2022,
  title = {Investigation on {{Lunar Landing Candidate Sites}} for a {{Future Lunar Exploration Mission}}},
  author = {Kim, Suyeon and Kim, Kyeong Ja and Yi, Yu},
  year = 2022,
  month = feb,
  journal = {International Journal of Aeronautical and Space Sciences},
  volume = {23},
  number = {1},
  pages = {221--232},
  issn = {2093-2480},
  doi = {10.1007/s42405-021-00433-4},
  urldate = {2026-03-01},
  abstract = {Korea plans to send a lunar lander following the launching of the Korea Pathfinder Lunar Orbiter (KPLO) in August 2022. The Korea Aerospace Research Institute (KARI) conducted a demand survey to select potential candidates for landing sites to be photographed with the LUnar Terrain Imager (LUTI) onboard the KPLO. The main purpose of the LUTI is to conduct a preliminary exploration to select candidate landing sites for a future Korean lunar exploration. We proposed three landing candidate sites which suggest to provide either scientific or technical assistance for this future exploration. The first candidate site is the Meton. Moon Mineralogy Mapper (\$\$\textbraceleft\textbackslash mathrm\textbraceleft M\textbraceright\textbraceright\textasciicircum\textbraceleft 3\textbraceright\$\$) data show that it has more hydroxyls than other regions investigated in this study. Furthermore, there is a domed terrain in the center of the crater, which could have been formed due to volcanic activity. It is worth investigating this aspect of morphology. The second candidate suggested is the Copernicus crater as hydroxyl and olivine components with multiple origins were confirmed by the \$\$\textbraceleft\textbackslash mathrm\textbraceleft M\textbraceright\textbraceright\textasciicircum\textbraceleft 3\textbraceright\$\$data. Therefore, by studying this area, we can get information about the internal structure of the Moon and the hydroxyl feature. The third candidate suggested is the Aristarchus Plateau. In this area, the existence of resources including hydroxyl was confirmed by \$\$\textbraceleft\textbackslash mathrm\textbraceleft M\textbraceright\textbraceright\textasciicircum\textbraceleft 3\textbraceright\$\$data, and the collection of various volcanic features makes it geologically valuable. Additionally, an investigation of the LROC mosaic image is provided to examine the detailed topography of Crater Copernicus. For all three candidate sites, the Selenological and Engineering Explore's (SELENE) altitude data analysis confirmed several flat ground areas to land a spacecraft.},
  langid = {english},
  keywords = {Aristarchus,Copernicus,Hydroxyl,Landing sites,Meton,Moon,Slopes},
  annotation = {titleTranslation: 未来月球探测任务着陆候选区研究\\
abstractTranslation: 韩国计划于2022年8月发射韩国探路者月球轨道器（KPLO）后，再发射一个月球着陆器。韩国航空航天研究院（KARI）开展了一项需求调查，以筛选KPLO搭载的月球地形成像仪（LUTI）可能拍摄的候选着陆点。LUTI的主要目的是为未来韩国月球探测进行初步勘测，以选取候选着陆点。我们提出了三个候选着陆点，旨在为这一未来探测提供科学或技术支持。第一个候选点是Meton陨石坑。月球矿物绘图仪（M{$^3$}）数据显示，该区域的羟基含量高于本研究调查的其他区域。此外，陨石坑中心存在穹状地形，可能是由火山活动形成，其形态特征值得研究。第二个候选点为哥白尼陨石坑，M{$^3$}数据证实该区域存在多种来源的羟基和橄榄石成分。因此，通过研究该区域，可获取月球内部结构及羟基特征的相关信息。第三个候选点是阿里斯塔克斯高原。M{$^3$}数据确认该区域存在羟基等资源，且汇集了多种火山特征，具有重要地质价值。此外，文中还提供了对LROC镶嵌影像的分析，用以考察哥白尼陨石坑的精细地形。针对所有三个候选点，基于辉夜号（SELENE）高程数据分析，确认存在若干可供航天器着陆的平坦区域},
  file = {/home/ouyangjiahong/Zotero/storage/Y5JGVBPG/Kim 等 - 2022 - Investigation on Lunar Landing Candidate Sites for a Future Lunar Exploration Mission.pdf}
}

@article{kimProbabilisticRegressionAutonomous2024,
  title = {Probabilistic Regression for Autonomous Terrain Relative Navigation via Multi-Modal Feature Learning},
  author = {Kim, Ickbum and Singh, Sandeep},
  year = 2024,
  month = dec,
  journal = {Scientific Reports},
  volume = {14},
  number = {1},
  pages = {29966},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-024-81377-z},
  urldate = {2026-02-02},
  abstract = {The extension of human spaceflight across an ever-expanding domain, in conjunction with intricate mission architectures demands a paradigm shift in autonomous navigation algorithms, especially for the powered descent phase of planetary landing. Deep learning architectures have previously been explored to perform low-dimensional localization with limited success. Due to the expectations regarding novel algorithms in the context of real missions, the proposed approaches must be rigorously evaluated in extraneous scenarios and demonstrate sufficient robustness. In the current work, a novel formulation is proposed to train CNN-based Deep Learning (DL) models in a multi-layer cascading architecture and utilize the resulting classification probabilities as regression weights to estimate the position of the lander spacecraft.~The approach leverages image intensity and depth data provided by multiple sensors on board to accurately determine the spacecraft's location relative to the observed terrain at a specific altitude. Navigation performance is validated through Monte Carlo analysis, demonstrating the efficacy of the proposed DL architecture and the subsequent state-estimation framework across several simulated scenarios. It shows tremendous promise in extending the multi-modal feature learning approach to realistic missions.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {Astronomy and planetary science,Computer science,Engineering,Software},
  annotation = {titleTranslation: 基于多模态特征学习的自主地形相对导航概率回归\\
TLDR: A novel formulation is proposed to train CNN-based Deep Learning models in a multi-layer cascading architecture and utilize the resulting classification probabilities as regression weights to estimate the position of the lander spacecraft.\\
abstractTranslation: 随着人类航天活动向不断扩展的疆域延伸，加上复杂的任务架构，对自主导航算法提出了范式转变的要求，尤其是在行星着陆的主动下降阶段。先前已有研究探索利用深度学习架构进行低维定位，但成效有限。鉴于实际任务对新型算法的期待，所提出的方法必须在极端场景下经过严格评估，并展现出足够的鲁棒性。本文提出了一种新颖的公式，用于训练基于CNN的深度学习模型，采用多层级联架构，并将由此产生的分类概率作为回归权重，以估计着陆器航天器的位置。该方法利用机载多传感器提供的图像强度与深度数据，在特定高度下精确确定航天器相对于观测地形的方位。通过蒙特卡洛分析验证导航性能，展示了所提出的深度学习架构及其后续状态估计框架在多个模拟场景中的有效性。该方法在将多模态特征学习方法拓展至实际任务方面展现出巨大潜力},
  file = {/home/ouyangjiahong/Zotero/storage/4LJKXTW4/Kim和Singh - 2024 - Probabilistic regression for autonomous terrain relative navigation via multi-modal feature learning.pdf}
}

@inproceedings{kimTimeShiftGovernor2023,
  title = {Time Shift Governor for Constraint Satisfaction during Low-Thrust Spacecraft Rendezvous in near Rectilinear Halo Orbits},
  booktitle = {2023 {{IEEE Conference}} on {{Control Technology}} and {{Applications}} ({{CCTA}})},
  author = {Kim, Taehyeun and Liu, Kaiwen and Kolmanovsky, Ilya and Girard, Anouck},
  year = 2023,
  address = {Bridgetown, Barbados},
  doi = {10.1109/CCTA54093.2023.10252878},
  abstract = {A parameter governor-based control scheme is developed to enforce various constraints, such as the Line of Sight (LoS) cone angle, the thrust limit, and the relative approach velocity during rendezvous missions in a near rectilinear halo orbit (NRHO) in the Earth-Moon system. The parameter governor is an add-on scheme to the nominal closed-loop system, which dynamically adjusts controller parameters in order to enforce the constraints. For the application to the rendezvous mission, we utilize the Time Shift Governor (TSG) which time shifts the target trajectory commanded to the Deputy spacecraft controller. The time shift is gradually reduced to zero so that the virtual target trajectory gradually converges to the Chief spacecraft trajectory as time evolves, and the rendezvous mission can be accomplished. Simulation results are reported that demonstrate the effectiveness of the proposed control scheme.},
  langid = {english},
  keywords = {Closed loop systems,Planetary orbits,Simulation,Space vehicles,Trajectory},
  annotation = {titleTranslation: 低推力航天器近直线晕轨道交会中的约束满足时间偏移调节器}
}

@article{kimuraAnalyticalExpressionDistant2019,
  title = {Analytical Expression for Distant Retrograde Orbits around a Small Natural Satellite},
  author = {Kimura, Masaya and Kawamura, Masanori and Yamada, Katsuhiko},
  year = 2019,

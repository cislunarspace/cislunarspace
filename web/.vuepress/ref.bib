@article{saint-hilairePreciseFormationflyingTelescope2020,
  title = {Precise Formation-Flying Telescope in Target-Centric Orbit: The Solar Case},
  shorttitle = {Precise Formation-Flying Telescope in Target-Centric Orbit},
  author = {{Saint-Hilaire}, Pascal and Marchese, Jeffrey E.},
  year = 2020,
  journal = {Journal of Astronautical Sciences},
  volume = {Vol.67},
  number = {No.4},
  pages = {1391--1411},
  doi = {10.1007/s40295-020-00231-2},
  abstract = {We present the general concept of a telescope with optics and detectors mounted on two separate spacecrafts, in orbit around the telescope's target (scopocentric or target-centric orbit), and using propulsion to maintain the Target-Optics-Detector alignment and Optics-Detector distance. Specifically, we study the case of such a telescope with the Sun as the target, orbiting at \textbackslash (\textbackslash sim \textbackslash )1 AU. We present a simple differential acceleration budget for maintaining Target-Optics-Detector alignment and Optics-Detector distance, backed by simulations of the orbital dynamics, including solar radiation pressure and influence of the planets. Of prime interest are heliocentric orbits (such as Earth-trailing/leading orbits or Distant Retrograde Orbits), where thrust requirement to maintain formation is primarily in a single direction (either sunward or anti-sunward), can be quite minuscule (a few m/s/year), and preferably met by constant-thrust engines such as solar electric propulsion or even by solar sailing via simple extendable and/or orientable flaps or rudders.},
  langid = {english},
  keywords = {Formation flying,Heliocentric,Precise Formation Flying,Telescope},
  annotation = {titleTranslation: 目标中心轨道上的精确编队飞行望远镜：以太阳为例\\
abstractTranslation: 我们提出了一种望远镜的通用概念，其光学元件和探测器分别安装在两个独立的航天器上，这两个航天器环绕望远镜的目标运行（即围绕目标的轨道或目标中心轨道），并通过推进系统来维持目标-光学元件-探测器的对准以及光学元件与探测器之间的距离。具体而言，我们研究了以太阳为目标、在约1 AU轨道上运行的此类望远镜的情况。我们提出了一个简单的微分加速度预算，用于维持目标-光学元件-探测器的对准和光学元件-探测器之间的距离，并通过轨道动力学模拟（包括太阳辐射压和行星影响）加以验证。我们重点关注日心轨道（例如地球后随/前导轨道或远距离逆行轨道），在这些轨道上，维持编队所需的推力主要沿单一方向（朝向太阳或背离太阳），推力需求非常小（每年几米/秒），并且最好由恒定推力发动机（如太阳能电推进）或甚至通过简单的可伸展和/或可定向的帆板或舵来实现太阳帆推进}
}


@article{WangYuanBinJiYuQianYiXueXiHeTeZhengZhuYiZengQiangXingPP_LiteSegDeKuangJingShuSongDaiQuYuFenGeSuanFa2026,
  title = {{基于迁移学习和特征注意增强型PP＿LiteSeg的矿井输送带区域分割算法}},

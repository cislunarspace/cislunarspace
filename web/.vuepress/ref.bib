@article{chenLunarFarSide2019,
  title = {Lunar Far Side Positioning Enabled by a {{CubeSat}} System Deployed in an {{Earth-moon}} Halo Orbit},
  author = {Chen, Hongru and Liu, Jiangkai and Long, Long and Xu, Zhenyu and Meng, Yazhe and Zhang, Hao},
  year = 2019,
  month = jul,
  journal = {Advances in Space Research},
  volume = {64},
  number = {1},
  pages = {28--41},
  issn = {02731177},
  doi = {10.1016/j.asr.2019.03.031},
  urldate = {2025-09-29},
  abstract = {For explorations of the far side of the Moon, it is necessary to tackle the challenge of navigation and communication as the far side is invisible to the Earth. This paper proposes a low-cost mission concept that consists of four CubeSats in an Earth-Moon L2 (EML2) halo orbit. The mission objective is to provide real-time positioning service for lunar far-side assets, taking advantage of the visibility of EML2 halo orbits to both the Earth and lunar far side. Being miniature, CubeSats can be carried by a mother spacecraft and deployed during the mid-course. As CubeSat missions are generally constrained by limited communication, power, and propulsion capacities, this paper presents a feasibility study that takes into account the high-fidelity dynamical environment and system constraints. This paper analyzes the positioning performance in terms of accuracy, and spatial and temporal coverage. In addition, the requirement of deployment in terms of Dv budget and thrust magnitude is also investigated. Results show that (1) a positioning accuracy of 2.7 km is achievable; and (2) several state-of-the-art propulsion systems can meet the requirement of deployment and the stationkeeping for an acceptable duration.},
  langid = {english},
  annotation = {titleTranslation: 部署于地月晕轨道上的立方星系统实现月球背面定位。\\
abstractTranslation: 对于月球背面的探测，必须解决导航与通信的挑战，因为月球背面在地球上不可见。本文提出了一种低成本任务概念，由四颗运行于地月L2（EML2）晕轨道上的立方星组成。该任务旨在利用EML2晕轨道对地球和月球背面均可见的优势，为月球背面资产提供实时定位服务。立方星体积小巧，可由母航天器携带并在中途部署。由于立方星任务通常受限于有限的通信、能源和推进能力，本文在考虑高保真动力学环境和系统约束的前提下，进行了可行性研究。本文从精度、空间覆盖和时间覆盖等方面分析了定位性能。此外，还研究了部署所需的{$\Delta$}v预算和推力幅度要求。结果表明：（1）可实现2.7公里的定位精度；（2）多种现有推进系统能够满足部署要求，并在可接受的时间范围内完成轨道维持。},
  file = {/home/ouyangjiahong/Zotero/storage/RC8R73WD/Chen 等 - 2019 - Lunar far side positioning enabled by a CubeSat system deployed in an Earth-moon halo orbit.pdf;/home/ouyangjiahong/Zotero/storage/UK8BHKSV/Chen 等 - 2019 - Lunar far side positioning enabled by a CubeSat system deployed in an Earth-moon halo orbit.pdf}
}


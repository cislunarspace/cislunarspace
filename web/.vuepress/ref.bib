@article{YuDengYunHangTianQiZaiGuiWeiXiuWeiHuJiShuFaZhanXianZhuangYuZhanWang2025,
  title = {{航天器在轨维修维护技术发展现状与展望}},
  author = {{于登云} and {刘育强} and {王典军} and {韩璐} and {侯锐}},
  year = 2025,
  journal = {宇航学报},
  volume = {46},
  number = {8},
  pages = {1483--1500},
  issn = {1000-1328},
  abstract = {针对航天器在轨服务技术向工程实用转化的技术瓶颈，开展了系统性研究与综述。首先明确了在轨服务的概念内涵，划分了任务类型和服务对象。随后，从技术实现视角，将狭义上的在轨服务领域细分为可维修航天器、在轨维修、在轨维护3大方面，并进一步提出了11个具体技术方向，包括可维修体系架构、可更换功能模块、故障诊断、在轨维修操作、在轨接管延寿、在轨加注等。通过对国内外典型项目的剖析，总结分析了11个技术方向的发展现状与发展趋势，提出了急需解决的6项关键技术。研究表明，在轨服务技术已进入解决工程实用问题的关键阶段，其发展将显著提升航天器可靠性和寿命，并推动航天器研制与应用模式变革。},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/N2N2X5AN/于登云 等 - 2025 - 航天器在轨维修维护技术发展现状与展望.pdf}
}

@article{YuDengYunRenGongZhiNengFuNengDiYueKongJianGanZhiJiShuXianZhuangJiZhanWang2025a,
  title = {{人工智能赋能地月空间感知技术现状及展望}},
  author = {{于登云} and {尹继豪} and {刘斯琦} and {王鹏} and {王汇娟} and {张余} and {姜鸿翔} and {陈培}},
  year = 2025,
  journal = {中国图象图形学报},
  volume = {30},
  number = {9},
  pages = {2899--2910},
  urldate = {2026-05-27},
  abstract = {随着深空探测的不断推进，地月空间已成为探月和深空任务的关键战略区域。面对日益增多的航天器及太空碎片数量，亟需先进的空间态势感知技术以实现对地月空间目标的精准监测与持续跟踪。传统方法因复杂动力学环境和远距离探测精度限制，难以满足高精度轨迹预测和目标识别的需求，制约了地月空间感知技术进一步发展，人工智能技术的快速发展为解决这一瓶颈问题提供了新契机。本文系统梳理了人工智能技术在地月空间感知领域的应用进展，涵盖空间目标监视需求、传统机器学习在目标检测及轨道定轨中的应用，以及深度学习、强化学习等人工智能算法的初步应用。通过对国内外典型研究成果的对比分析，归纳了现有技术的优势和不足，提出在算法优化、模型开发等方面的发展展望。分析表明，人工智能方法在提升暗弱目标检测精度、智能轨道确定及复杂态势感知方面表现出显著潜力，尽管面临数据匮乏和专用场景未知等挑战，人工智能技术已初步展现出构建全天候、高自适应性地月空间智能感知体系的能力。未来需加强人工智能与地月空间目标检测、轨道定轨与预报等传统技术结合，持续拓展人工智能在地月空间感知领域的应用，推动地月空间开发迈向智能化发展新阶段。},
  langid = {chinese},
  keywords = {,(AI)},
  annotation = {Fund: ``新一代人工智能''国家科技重大专项(2022ZD0117402)\textasciitilde\textasciitilde ；},
  file = {/home/ouyangjiahong/Zotero/storage/M32HMHK9/于登云 等 - 2025 - 人工智能赋能地月空间感知技术现状及展望.pdf}
}


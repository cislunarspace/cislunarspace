@article{perolatMasteringGameStratego2022,
  title = {Mastering the Game of Stratego with Model-Free Multiagent Reinforcement Learning},
  author = {Perolat, Julien and De Vylder, Bart and Hennes, Daniel and Tarassov, Eugene and Strub, Florian and De Boer, Vincent and Muller, Paul and Connor, Jerome T. and Burch, Neil and Anthony, Thomas and McAleer, Stephen and Elie, Romuald and Cen, Sarah H. and Wang, Zhe and Gruslys, Audrunas and Malysheva, Aleksandra and Khan, Mina and Ozair, Sherjil and Timbers, Finbarr and Pohlen, Toby and Eccles, Tom and Rowland, Mark and Lanctot, Marc and Lespiau, Jean-Baptiste and Piot, Bilal and Omidshafiei, Shayegan and Lockhart, Edward and Sifre, Laurent and Beauguerlange, Nathalie and Munos, Remi and Silver, David and Singh, Satinder and Hassabis, Demis and Tuyls, Karl},
  year = 2022,
  month = dec,
  journal = {Science},
  volume = {378},
  number = {6623},
  pages = {990--996},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.add4679},
  urldate = {2026-04-23},
  abstract = {We introduce DeepNash, an autonomous agent that plays the imperfect information game Stratego at a human expert level. Stratego is one of the few iconic board games that artificial intelligence (AI) has not yet mastered. It is a game characterized by a twin challenge: It requires long-term strategic thinking as in chess, but it also requires dealing with imperfect information as in poker. The technique underpinning DeepNash uses a game-theoretic, model-free deep reinforcement learning method, without search, that learns to master Stratego through self-play from scratch. DeepNash beat existing state-of-the-art AI methods in Stratego and achieved a year-to-date (2022) and all-time top-three ranking on the Gravon games platform, competing with human expert players.           ,              Machine learning to play Stratego                            Stratego is a popular two-player imperfect information board game. Because of its complexity stemming from its enormous game tree, decision-making under imperfect information, and a piece deployment phase at the start, Stratego poses a challenge for artificial intelligence (AI). Previous computer programs only performed at an amateur level at best. Perolat               et al               . introduce a model-free multiagent reinforcement learning methodology and show that it can achieve human expert--level performance in Stratego. The present work not only adds to the growing list of games that AI systems can play as well or even better than humans but may also facilitate further applications of reinforcement learning methods in real-world, large-scale multiagent problems that are characterized by imperfect information and thus are currently unsolvable. ---YS                        ,              Reinforcement learning achieves human expert--level performance in the large-scale imperfect information board game Stratego.},
  langid = {english},
  annotation = {titleTranslation: 利用免模型多智能体强化学习掌握策略游戏\\
abstractTranslation: 我们介绍了DeepNash，一个在不完美信息游戏Stratego中达到人类专家水平的自主智能体。Stratego是人工智能尚未征服的少数标志性棋盘游戏之一。这款游戏具有双重挑战：它需要像国际象棋那样的长期战略思维，同时也需要像扑克那样处理不完美信息。支撑DeepNash的技术使用了一种基于博弈论、无模型的深度强化学习方法，无需搜索，通过从头开始的自我对弈来学会掌握Stratego。DeepNash击败了Stratego中现有的最先进AI方法，并在Gravon游戏平台上取得了2022年度及历史总排名前三的成绩，与人类专家玩家竞争。\\
\\
机器学习玩转Stratego\\
\\
Stratego是一款流行的双人不完美信息棋盘游戏。由于其巨大的博弈树、不完美信息下的决策以及开局阶段的棋子部署所带来的复杂性，Stratego对人工智能构成了挑战。之前的计算机程序最多只能达到业余水平。Perolat等人引入了一种无模型的多智能体强化学习方法，并展示了该方法能够在Stratego中达到人类专家级别的表现。这项研究不仅增加了AI系统能够玩得与人类一样好甚至更好的游戏名单，还可能促进强化学习方法在现实世界大规模多智能体问题中的进一步应用，这些问题的特点是不完美信息，因此目前尚无法解决。------YS\\
\\
强化学习在大型不完美信息棋盘游戏Stratego中达到人类专家级别的表现},
  file = {/home/ouyangjiahong/Zotero/storage/KG8VQWP3/Perolat 等 - 2022 - Mastering the game of stratego with model-free multiagent reinforcement learning.pdf}
}

@article{perozziDistantRetrogradeOrbits2017,
  title = {Distant Retrograde Orbits and the Asteroid Hazard},
  author = {Perozzi, Ettore and Ceccaroni, Marta and Valsecchi, Giovanni B. and Rossi, Alessandro},
  year = 2017,
  journal = {European Physical Journal Plus},
  volume = {Vol.132},
  number = {No.8},
  doi = {10.1140/epjp/i2017-11644-0},
  abstract = {Distant Retrograde Orbits (DROs) gained a novel wave of fame in space mission design because of their numerous advantages within the framework of the US plans for bringing a large asteroid sample in the vicinity of the Earth as the next target for human exploration. DROs are stable solutions of the three-body problem that can be used whenever an object, whether of natural or artificial nature, is required to remain in the neighborhood of a celestial body without being gravitationally captured by it. As such, they represent an alternative option to Halo orbits around the collinear Lagrangian points L\textsubscript{1} and L\textsubscript{2}. Also known under other names (e.g., quasi-satellite orbits, cis-lunar orbits, family-f orbits) these orbital configurations found interesting applications in several mission profiles, like that of a spacecraft orbiting around the small irregularly shaped satellite of Mars Phobos or the large Jovian moon Europa. In this paper a basic explanation of the DRO dynamics is presented in order to clarify some geometrical properties that characterize them. Their accessibility is then discussed from the point of view of mission analysis under different assumptions. Finally, their relevance within the framework of the present asteroid hazard protection programs is shown, stressing the significant increase in warning time they would provide in the prediction of impactors coming from the direction of the Sun.},
  langid = {english},
  annotation = {titleTranslation: 远距离逆行轨道与小行星撞击风险\\
abstractTranslation: 远距离逆行轨道（DROs）因其在美国将大型小行星样本带回地球附近作为人类下一个探索目标的计划框架内具有众多优势，而在航天任务设计中再度受到广泛关注。DROs是三体问题的稳定解，适用于需要将天然或人造物体停留在某天体附近而不被其引力俘获的情形。因此，它们代表了围绕共线拉格朗日点L{$_1$}和L{$_2$}的晕轨道的一种替代方案。这些轨道构型还有其他名称（如准卫星轨道、地月轨道、f族轨道），并在多种任务设计中找到了有趣的应用，例如绕火星不规则小卫星火卫一或木星大卫星欧罗巴运行的航天器。本文对DRO动力学进行了基本解释，以阐明其某些几何特性。随后从不同假设下的任务分析角度讨论了其可达性。最后，展示了它们在当前小行星危险防护计划中的相关性，并强调了它们在预测来自太阳方向的撞击体时将显著增加预警时间。}
}


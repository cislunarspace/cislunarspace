@phdthesis{sharanHigherorderMethodsTrajectory2025,
  type = {博士论文},
  title = {Higher-Order Methods for Trajectory Design in Multi-Body Environments},
  author = {Sharan, Sharad},
  year = 2025,
  abstract = {Designing spacecraft trajectories presents numerous challenges in multi-body environments. In the well-known two-body problem, orbits take the shape of conic sections, and strategies for designing trajectories between them have been well established. On the other hand, multi-body dynamical models host a wide range of possible orbits of varying geometries. Designing orbits of interest and navigating between them in such an environment requires solving sensitive two-point boundary value problems (TPBVPs). Gravitational acceleration in a multi-body environment is typically an order of magnitude smaller than the gravitational acceleration near a primary body in the two-body problem. This is advantageous in the sense that less propulsive power is needed to achieve large state changes. However, this simple fact also results in increased sensitivity to state errors. Therefore, the TPBVPs to design orbits are very sensitive to the initial guess for the unknown states. Current methods focus on discretizing a trajectory into several segments in time, in order to distribute sensitivity between those segments in a divide and conquer strategy. In each segment, a differential correction process is used to find the unknown values. Differential correction, also known as the single shooting method, is widely used for its simplicity and effectiveness. As the sensitivity of the TPBVP increases, so does the necessity for a finer discretization process. This increases the dimensionality of the unknowns, thereby contributing to high computational costs.An ideal scenario of applying the computationally efficient single shooting method to just one segment defined by the aforementioned TPBVP has remained a challenging task. Realization of such a scenario is the primary contribution of this dissertation. This dissertation presents the development of a single shooting methodology termed Multi-Order Shooting Scheme (MOSS) that employs higher-order sensitivity information to solve highly sensitive TPBVPs in a robust manner. The well-known Halley's method is generalized to include up to fourth-order sensitivities in multi-dimensional space. Furthermore, a non-product quadrature scheme such as the Conjugate Unscented Transformation (CUT) is employed to compute higher-order sensitivities in a derivative-free manner. The computational efficiency and robustness of the MOSS to the initial guess is demonstrated by considering multiple benchmark problems in optimal control.MOSS allows one to investigate challenging problems that have not been previously explored. One such problem is the identification of heteroclinic connections between periodic orbits in the circular restricted three-body problem (CR3BP) as solutions to a minimum-fuel optimization problem. This approach is contrary to traditional semi-analytic means of determining heteroclinic pathways, which involves finding the intersection of the stable and unstable manifolds of two orbits of the same energy. MOSS enabled the identification of several such planar pathways as zero-fuel solutions to the optimization problem, thereby doing away with the tediousness of the semi-analytical approach. This contribution demonstrates the capability of the proposed methodology in handling challenging optimization problems in the multi-body environment when they are cast as TPBVPs using optimal control theory.Furthermore, the robustness of MOSS is leveraged in transitioning periodic solutions from the CR3BP to the non-autonomous, higher-fidelity bi-circular restricted four-body problem (BCR4BP). The BCR4BP is an active area of research, and conventional means of transitioning solutions from the CR3BP involves a multiple shooting procedure in conjunction with a continuation process. The continuation process is carried out by increasing the fraction of the Sun's mass gradually from zero to one, and solving a problem of non-physical nature at each continuation step. Such a process is tedious and incurs high computational costs. A novel framework involving MOSS is proposed for transitioning purposes, which involves solving a TPBVP directly in the BCR4BP space with the initial guess corresponding to the CR3BP solution. The developed process utilizes the CR3BP solution by judiciously choosing an epoch corresponding to least sensitivity to the Sun's gravitational perturbation in the BCR4BP. The efficacy of the developed framework is demonstrated by successfully transitioning several halo and butterfly orbits from the CR3BP to the BCR4BP. Finally, a detailed study is conducted to assess the limitation of the developed approach. This contribution provides an efficient tool to investigate how CR3BP orbits manifest in the higher-fidelity BCR4BP, in order to design appropriate orbits for varying missions in a contested, highly relevant multi-body environment of the present day - cislunar space.},
  langid = {english},
  school = {The Pennsylvania State University},
  keywords = {0538:Aerospace engineering,0548:Mechanical engineering,Aerospace engineering,Boundary conditions,Mechanical engineering,Moon,Multi-body environments,Orbits,Space exploration,Trajectory design},
  annotation = {titleTranslation: 多体环境下高阶轨迹设计方法},
  file = {/home/ouyangjiahong/Zotero/storage/FFPCV838/Sharan - 2025 - Higher-order methods for trajectory design in multi-body environments.pdf}
}


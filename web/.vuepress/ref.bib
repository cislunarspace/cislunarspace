@article{RaoJiaXuanJiYuDuoZhiNengTiQiangHuaXueXiDeZhuiZongFangYuGuiDaoBoYiJueCeFangFaYanJiu2026,
  title = {{基于多智能体强化学习的追踪-防御轨道博弈决策方法研究}},
  author = {{饶佳轩} and {李文龙} and {成飞} and {金磊}},
  year = 2026,
  month = feb,
  journal = {北京航空航天大学学报},
  pages = {1--16},
  issn = {1001-5965},
  doi = {10.13700/j.bh.1001-5965.2025.0727},
  abstract = {针对脉冲推力航天器集群的轨道博弈问题，提出一种基于自注意力机制的多智能体强化博弈决策方法，使得追踪星能够躲避防御星拦截并抵近目标星至特定距离。首先，综合考虑终端条件、全过程约束条件、单次速度增量和燃料上限等约束，建立追踪---防御轨道博弈模型；其次，在多智能体近端优化（MAPPO）框架中引入自注意力机制（SA），提出一种SA-MAPPO算法，以增强位置信息感知并提升航天器在不确定博弈场景下的自主决策能力；同时，通过引入掩码序列处理个别航天器``退出''问题，保障训练完整性；最后，分别使用SA-MAPPO与MAPPO方法以互博方式同时训练追踪星与防御星，并在打靶验证中对比双方策略性能。仿真结果表明，SA-MAPPO算法收敛更快、训练更平稳、奖励回报更高，习得策略在验证任务中表现更优，追踪星捕获成功率提升7\%，防御星拦截成功率提升3\%，验证了该方法能为博弈双方生成更优的策略，实现整体效能的协同优化。},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/R5NISYBM/饶佳轩 等 - 2026 - 基于多智能体强化学习的追踪-防御轨道博弈决策方法研究.pdf}

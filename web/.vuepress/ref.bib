  abstract = {A new control scheme of nonlinear output tracking and disturbance rejection for autonomous close-range rendezvous and docking of spacecraft is proposed in a closed-loop structure. The robustness of the proposed control scheme is achieved through the sum of output-feedback control and state-feedback control as a closed-loop control structure. The designs of both control laws are based on full, 6-degrees-of-freedom, nonlinear dynamic models, which are transformed into a linear-like form using a state dependent Ricatti equation technique. The proposed control scheme ensures closerange rendezvous and meets the state tracking conditions for docking such that the convergence of state tracking errors should be ensured in the presence of unknown disturbances and uncertainties of the system parameters. Compared with the conventional state-dependent Ricatti equation method, the proposed control scheme yields superior state tracking performance and robustness in the presence of external disturbances and uncertain system parameters. The 6-degreesof-freedom numerical simulation results are presented to verify the effectiveness and capability of the proposed control scheme for autonomous close-range rendezvous and docking.},
  langid = {english},
  annotation = {titleTranslation: 航天器自主近距离交会对接的非线性输出跟踪与扰动抑制\\
abstractTranslation: 提出了一种基于闭环结构的航天器自主近距离交会对接非线性输出跟踪与干扰抑制控制方案。该控制方案的鲁棒性通过输出反馈控制与状态反馈控制的叠加作为闭环控制结构实现。两种控制律的设计均基于完整的六自由度非线性动力学模型，并采用状态依赖Riccati方程技术将其转化为类线性形式。所提出的控制方案确保了近距离交会，并满足对接的状态跟踪条件，使得在未知干扰和系统参数不确定性存在时，状态跟踪误差能够收敛。与传统的状态依赖Riccati方程方法相比，所提控制方案在外部干扰和不确定系统参数存在下，具有更优越的状态跟踪性能和鲁棒性。给出了六自由度数值仿真结果，以验证所提控制方案在自主近距离交会对接中的有效性和能力},
  file = {/home/ouyangjiahong/Zotero/storage/NDSFSIV4/Lee 等 - 2014 - Nonlinear output tracking and disturbance rejection for autonomous close-range rendezvous and dockin.pdf}
}

@article{leeOptimalControlProximity2010,
  title = {Optimal Control for Proximity Operations and Docking},
  author = {Lee, Dae-Ro and Pernicka, Henry},
  year = 2010,
  month = sep,
  journal = {International Journal of Aeronautical and Space Sciences},

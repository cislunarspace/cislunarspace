@article{humiSatellitesOrbitsSun2023,
  title = {Satellites' Orbits in the Sun--Earth--Moon System},
  author = {Humi, Mayer},
  year = 2023,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {3},
  pages = {30},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10146-3},
  urldate = {2025-10-01},
  abstract = {There is a large set of papers and monographs which consider the restricted three-body problem and apply the results to the orbits of satellites or spacecrafts in the Earth--Moon system. These studies ignore the impact of the Sun on these orbits. This approximation is justified for satellites in close Earth orbit. However, for satellites whose orbit is around the Sun, the Earth and the Moon or one of the Lagrange points the impact of the Sun's presence cannot be ignored and one has to consider a four-body problem. In this paper, we derive the general equations of motion for satellites in a system that consists of a central body (Sun), first and second primaries and a satellite. These equations can be used for mission planning in general. Obvious practical example of such a system consists of the Earth and the Moon as the first and second primaries. These equations are then used in this paper to illustrate the impact of the central body on the motion of satellites around the two primaries.},
  langid = {english},
  annotation = {titleTranslation: 卫星轨道在日-地-月系统。\\
abstractTranslation: 大量论文和专著研究了限制性三体问题，并将其结果应用于地月系统中卫星或航天器的轨道。这些研究忽略了太阳对这些轨道的影响。对于近地轨道卫星而言，这一近似是合理的。然而，对于绕太阳、地月系统或某拉格朗日点运行的卫星，太阳的影响不可忽略，必须考虑四体问题。本文推导了由中心天体（太阳）、第一和第二主天体以及一颗卫星所构成系统中卫星的一般运动方程。这些方程可普遍用于任务规划。一个显而易见的实际例子是以地球和月球作为第一和第二主天体。本文利用这些方程进一步阐述了中心天体对绕两个主天体运行卫星运动的影响。},
  file = {/home/ouyangjiahong/Zotero/storage/KZKN5YSW/Humi - 2023 - Satellites’ orbits in the sun–earth–moon system.pdf}
}


@article{LiRongHuaGaoGuiShiWenMuBiaoDanZaiHeXiangDuiWeiZiCeLiangFangFa2017,
  title = {高轨失稳目标单载荷相对位姿测量方法},
  author = {{李荣华} and {李金明} and {陈凤} and {肖余之}},
  year = 2017,
  journal = {宇航学报},
  number = {第10期},
  pages = {1105--1113},
  abstract = {针对线阵扫描型激光雷达在探测高轨失稳目标过程中,发生时空非定常点云数据畸变,而需多载荷协同方式测量相对位姿问题,提出一种激光雷达同向差分扫描测量方法。该方法基于运动目标畸变点云信息瞬时拓扑结构不变性,首先对相邻两次扫描的畸变点云进行配准来获取目标运动增量、解算目标瞬时运动参数。其次,逐条恢复畸变扫描线点云所处目标真实几何位置、完成目标三维重建。然后以目标三维模型为初始位姿基准,通过设定增量次数阈值不断更新位姿基准实现误差自标定。最后通过叠加位姿增量获取目标相对位姿。该方法在缺失非合作目标先验信息的情况下,仅使用单一载荷,不仅实现了目标三维点云模型的重建,而且精确测量了空间非合作目标相对位姿。},
  keywords = {;;;}
}


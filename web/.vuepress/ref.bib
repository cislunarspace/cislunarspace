@article{agranovskiyMeshAEfficientPath,
  title = {{{MeshA}}*: Efficient Path Planning with Motion Primitives},
  shorttitle = {{{MeshA}}*},
  author = {Agranovskiy, Marat and Yakovlev, Konstantin},
  pages = {1--8},
  doi = {10.1609/aaai.v40i43.41004},
  abstract = {We study a path planning problem where the possible move actions are represented as a finite set of motion primitives aligned with the grid representation of the environment. That is, each primitive corresponds to a short kinodynamicallyfeasible motion of an agent and is represented as a sequence of the swept cells of a grid. Typically, heuristic search, i.e. A*, is conducted over the lattice induced by these primitives (lattice-based planning) to find a path. However, due to the large branching factor, such search may be inefficient in practice. To this end, we suggest a novel technique rooted in the idea of searching over the grid cells (as in vanilla A*) simultaneously fitting the possible sequences of the motion primitives into these cells. The resultant algorithm, MeshA*, provably preserves the guarantees on completeness and optimality, on the one hand, and is shown to notably outperform conventional lattice-based planning (x1.5-x2 decrease in the runtime), on the other hand.},
  langid = {english},
  annotation = {titleTranslation: MeshA*：基于运动基元的高效路径规划\\
abstractTranslation: 我们研究了一种路径规划问题，其中可能的移动动作被表示为与环境网格表示对齐的有限运动基元集合。每个基元对应智能体的一段短时运动学可行运动，并表示为网格中扫过单元的序列。通常，启发式搜索（如A*）会在这些基元诱导的格点上进行（即基于格点的规划）以寻找路径。然而，由于较大的分支因子，这种搜索在实践中可能效率低下。为此，我们提出了一种新颖技术，其核心思想是在网格单元上进行搜索（如同原始A*），同时将可能的运动基元序列拟合到这些单元中。所得到的算法MeshA*一方面可证明保留完备性和最优性保证，另一方面在运行时间上显著优于传统基于格点的规划（运行时间降低1.5至2倍）},
  file = {/home/ouyangjiahong/Zotero/storage/H23FC3S5/Agranovskiy和Yakovlev - MeshA efficient path planning with motion primitives.pdf}
}

@article{AiChangFaJiYuJuShenZhiNengTiDeZiZhuZhiHuiGaoSuJiaGouTiXiYanJiu2026,
  title = {{基于具身智能体的自主智慧高速架构体系研究}},
  author = {{艾长发} and {陈光伟} and {董子硕} and {张稳进} and {张傲南} and {吕松涛} and {任东亚}},
  year = 2026,
  month = jan,
  journal = {中国公路学报},
  pages = {1--28},
  issn = {1001-7372},
  urldate = {2026-02-05},
  abstract = {近年来，国内外依托外部感知技术与车路协同体系建立的智慧高速建设取得显著进展，但其在内涵、发展目标以及架构一致性方面仍有改进空间，亟需革新传统道路建设与运维理念。为此，本文综述了美国、欧洲、日本等国家的智慧高速发展历程，分析国外经验对我国智慧高速建设的启示，并总结当前典型的智慧高速技术架构体系。在此基础上，以道路交通基础设施为智慧本体，实现智慧高速全生命周期的全时全域全事件智慧赋能与满足功能目标需求，提出了基于具身智能体的自主智慧高速架构体系。首先，将智慧高速抽象为具身智能体系统，采用面向过程的结构分析方法与机器系统行为控制理论建立了自主智慧高速功能架构。然后从数据类型、数据采集方式、组网方式、决策处理与服务应用等方面，设计了可实现五大功能场景的自主智慧高速物理架构。进一步，提出多源感知、R2X交互以及智慧大脑的架构体系以及基于生物遗传算法的分部架构协同运行方法。接着，基于具身智能体理念，提出了满足功能目标需求的自主智慧高速体系中数据属性要求，构建了集核心功能于一体的15项技术集及其基本要求。最后，设计了五大应用场景的流程与技术实现方法，为我国智慧高速高质量建设和高品质运营提供应用支撑。本文提出的基于具身智能体的自主智慧高速架构体系以道路交通基础设施为智慧本体，层次清晰、统一协调、兼容开放，革新了传统道路建设与运维理念，可实现智慧高速全生命周期全时全域全事件智慧赋能。},

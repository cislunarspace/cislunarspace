@article{moonOptimalRendezvousGuidance2016,
  title = {Optimal {{Rendezvous Guidance Using Linear Quadratic Control}}},
  author = {Moon, Gun-Hee and Lee, Byung-Yoon and Tahk, Min-Jea and Shim, David Hyunchul},
  editor = {{Abou-El-Hossein}, K.},
  year = 2016,
  journal = {MATEC Web of Conferences},
  volume = {54},
  pages = {09002},
  issn = {2261-236X},
  doi = {10.1051/matecconf/20165409002},
  urldate = {2025-09-25},
  abstract = {This paper handles with an energy optimal guidance law for rendezvous mission, based on linear quadratic control (LQC) problem. Rendezvous of two satellites are expressed by a nonlinear relative orbit dynamic model. The LQC problem minimizes integral of control input quadratic term with given final time and terminal states. A linear relative orbit dynamic, also called as the Clohessy-Wiltshire equation, is utilized as governing equation for optimal rendezvous guidance law. It is proven that renewing costates like an initial time is identical to propagating it from initial time to current time. Thus optimal guidance law can be formulated in state feedback form. To enhance computation efficiency, this work uses Taylor series expansion for the exponential of system matrix. The proposed algorithm is verified through nonlinear relative orbit simulations.},
  langid = {english},
  annotation = {titleTranslation: 基于线性二次控制的最优交会制导\\
abstractTranslation: 本文研究基于线性二次型控制（LQC）问题的交会任务能量最优制导律。两颗卫星的交会通过非线性相对轨道动力学模型描述。LQC问题在给定终端时间和终端状态条件下，最小化控制输入二次项的积分。采用线性相对轨道动力学，即Clohessy-Wiltshire方程，作为最优交会制导律的控制方程。证明了像初始时刻那样更新协态变量等价于将其从初始时刻传播到当前时刻。因此，最优制导律可以表示为状态反馈形式。为提高计算效率，本文采用泰勒级数展开对系统矩阵的指数进行近似。通过非线性相对轨道仿真验证了所提算法},
  file = {/home/ouyangjiahong/Zotero/storage/UJCJ8WYC/Moon 等 - 2016 - Optimal Rendezvous Guidance Using Linear Quadratic Control.pdf}
}


@article{heReviewCislunarConstellation2026,
  title = {A Review of Cislunar Constellation Design and Optimization},
  author = {He, Yuchen and Cui, Shuhao and Wang, Yue},
  year = 2026,
  month = mar,
  journal = {Advances in Astronautics},
  volume = {9},
  number = {1},
  pages = {1--31},
  publisher = {Springer Nature Singapore},
  issn = {3059-2976},
  doi = {10.1007/s42423-025-00199-x},
  urldate = {2026-04-23},
  abstract = {With the increasing interest in cislunar space exploration, a variety of cislunar missions are being proposed. To support the implementation of diverse missions, it is necessary to establish different types of cislunar constellations. Although there is abundant research on cislunar constellation design, a comprehensive review is still lacking. This review addresses this gap by establishing a theoretical framework for the design and optimization of cislunar constellations through an examination of relevant literature. Firstly, common orbital types and their applications in cislunar constellations are summarized. Subsequently, various types of existing cislunar constellations are introduced, including those in the development phase and those still in the conceptual design phase. A unified constellation performance evaluation system is then established, consisting of two types of performance metrics: metrics associated to specific missions and general metrics applicable to all types of constellations. Following this, design strategies and results for cislunar constellations are collated and summarized. An analysis based on the research overview reveals the trends in cislunar constellation design and optimization. Finally, future prospects on cislunar constellation design and optimization are discussed.},
  copyright = {2025 Chinese Society of Astronautics},
  langid = {english},
  annotation = {titleTranslation: 地月空间星座设计与优化综述\\
abstractTranslation: 随着地月空间探索兴趣的日益增长，各类地月空间任务正被陆续提出。为支撑多样化任务的实施，有必要建立不同类型的地月空间星座。尽管关于地月空间星座设计的研究已相当丰富，但仍缺乏全面的综述。本文通过梳理相关文献，建立地月空间星座设计与优化的理论框架，以填补这一空白。首先，总结了常见轨道类型及其在地月空间星座中的应用。随后，介绍了各类现有地月空间星座，包括处于开发阶段以及仍处于概念设计阶段的星座。接着，建立了一个统一的星座性能评估体系，该体系由两类性能指标构成：与特定任务相关的指标，以及适用于所有类型星座的通用指标。在此基础上，对地月空间星座的设计策略与结果进行了整理与总结。基于研究综述的分析揭示了地月空间星座设计与优化的趋势。最后，探讨了地月空间星座设计与优化的未来展望。},
  file = {/home/ouyangjiahong/Zotero/storage/78DF9JC9/He 等 - 2026 - A review of cislunar constellation design and optimization.pdf}
}

@article{heritierDynamicalEvolutionNatural2014,

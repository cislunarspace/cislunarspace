@article{shangActiveSolarEclipse2025,
  title = {Active Solar Eclipse Avoidance on the Distant Retrograde Orbit of the {{Earth-moon}} System},
  author = {Shang, Yunong and Wen, Changxuan and Sun, Yang and Zhang, Hao and Gao, Yang},
  year = 2025,
  month = feb,
  journal = {Advances in Space Research},
  volume = {75},
  number = {3},
  pages = {2970--2981},
  issn = {02731177},
  doi = {10.1016/j.asr.2024.11.027},
  urldate = {2025-09-25},
  abstract = {Lighting condition is a significant concern for spacecraft because it is directly related to their power and thermal subsystems. For spacecraft moving on a Distant Retrograde Orbit (DRO) of the Earth-Moon System, the lighting condition is severe because the DRO faces frequent long-duration solar eclipses. This study proposes a solar eclipse avoidance strategy for DRO missions. First, the lighting condition on a stable nominal DRO is analyzed, which reveals that long-duration solar eclipses are inevitable and active avoidance maneuvers are essential. Then, a close-loop three-impulse maneuver strategy is developed to deviate the trajectory from the nominal DRO and avoid a single shadow region of the Earth (or the Moon). The analytical solution of the first velocity impulse required for orbit correction at an arbitrary position is derived. The optimal position of imposing the velocity impulse is obtained using a nonlinear programming-based optimization algorithm. Finally, a coordinated shadow avoidance algorithm is proposed to simultaneously avoid the shadow of the Earth and the Moon. Simulations show that the proposed strategy successfully keeps the flying trajectory outside the shadow regions in a 4-year mission time at an average annual velocity impulse cost of 46.936 m/s.},
  langid = {english},
  keywords = {Cislunar space,Distant retrograde orbit,Lighting condition,Solar eclipse avoidance},
  annotation = {titleTranslation: 地月系统远距离逆行轨道上的主动式日食规避\\
abstractTranslation: 照明条件对于航天器至关重要，因为它直接关系到其电源和热控子系统。对于在地月系统远距离逆行轨道（DRO）上运行的航天器而言，照明条件尤为严酷，因为DRO会频繁经历长时间日食。本研究提出了一种针对DRO任务的日食规避策略。首先，分析了稳定标称DRO上的照明条件，结果表明长时间日食不可避免，主动规避机动至关重要。随后，开发了一种闭环三脉冲机动策略，使飞行轨迹偏离标称DRO，并规避地球（或月球）的单一阴影区域。推导了在任意位置进行轨道修正所需第一速度冲量的解析解，并采用基于非线性规划的优化算法确定了施加速度冲量的最优位置。最后，提出了一种协调阴影规避算法，以同时规避地球和月球的阴影。仿真结果表明，所提出的策略在4年的任务时间内成功使飞行轨迹保持在阴影区域之外，年均速度冲量代价为46.936 m/s},
  file = {/home/ouyangjiahong/Zotero/storage/6BQX7355/Shang 等 - 2025 - Active solar eclipse avoidance on the distant retrograde orbit of the Earth-moon system.pdf}
}

@article{shangGalacticCosmicRay2026,
  title = {A Galactic Cosmic Ray Cavity in {{Earth-moon}} Space},
  author = {Shang, Wensai and Liu, Ji and Xu, Zigong and Yue, Chao and Guo, Ruilong and Xiao, Chao and Shi, Quanqi and {Wimmer-Schweingruber}, Robert F. and Guo, Jingnan and Degeling, Alexander W. and Rankin, Robert and Tian, Anmin and Zong, Qiu-Gang and Han, Chenyao and Park, Jong-Sun and Wang, Huizi and Liu, Wenlong and Fu, Suiyan and Zhai, L. M. and Chen, D. and Ni, Sulan and Chen, T. L.},
  year = 2026,
  month = mar,
  journal = {Science Advances},
  volume = {12},
  number = {13},
  pages = {eadv1908},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/sciadv.adv1908},
  urldate = {2026-04-23},
  abstract = {In regions of the Solar System distant from planetary magnetic fields, galactic cosmic rays (GCRs) have generally been assumed to be uniformly distributed over the Earth-Moon distance. However, our analysis of data from the LND (Lunar Lander Neutron and Dosimetry) experiment onboard the Chang'E-4 lander revealed a region of reduced GCR flux in the prenoon sector of the lunar orbit. Further investigation suggests the presence of an energetic particle cavity, formed by Earth's magnetic field acting as an obstacle to GCR propagation. This cavity indicates that the influence of Earth's magnetic field within the space environment extends unexpectedly up to and far beyond the lunar orbit. This finding offers the potential to avoid high radiation levels during future lunar exploration and deep-space missions.},
  langid = {english},
  annotation = {titleTranslation: 地月空间中的银河宇宙射线空腔\\
abstractTranslation: 在太阳系中远离行星磁场的区域，银河宇宙射线（GCR）通常被认为在地球与月球距离范围内均匀分布。然而，我们对嫦娥四号着陆器上搭载的LND（月球着陆器中子与剂量测量）实验数据的分析，在月球轨道晨间区域发现了一个GCR通量降低的区域。进一步研究表明，存在一个高能粒子空洞，由地球磁场作为GCR传播的障碍物形成。该空洞表明，地球磁场在空间环境中的影响出乎意料地延伸至月球轨道甚至更远。这一发现为未来月球探测及深空任务中规避高辐射水平提供了可能。},
  file = {/home/ouyangjiahong/Zotero/storage/RALXBVHC/Shang 等 - 2026 - A galactic cosmic ray cavity in Earth-moon space.pdf}
}


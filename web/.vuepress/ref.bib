@article{chenIAImperativeLearningbased2025,
  title = {{{iA}}*: Imperative Learning-Based a* Search for Path Planning},
  shorttitle = {{{iA}}*},
  author = {Chen, Xiangyu and Yang, Fan and Wang, Chen},
  year = 2025,
  month = dec,
  journal = {IEEE Robotics and Automation Letters},
  volume = {10},
  number = {12},
  pages = {12987--12994},
  issn = {2377-3766, 2377-3774},
  doi = {10.1109/LRA.2025.3625500},
  urldate = {2026-04-23},
  abstract = {Path planning, which aims to find a collision-free path between two locations, is critical for numerous applications ranging from mobile robots to self-driving vehicles. Traditional search-based methods like A{$\ast$} search guarantee path optimality but are often computationally expensive when handling large-scale maps. While learning-based methods alleviate this issue by incorporating learned constraints into their search procedures, they often face challenges like overfitting and reliance on extensive labeled datasets. To address these limitations, we propose Imperative A{$\ast$} (iA{$\ast$}), a novel self-supervised path planning framework leveraging bilevel optimization (BLO) and imperative learning (IL). The iA{$\ast$} framework integrates a neural network that predicts node costs with a differentiable A{$\ast$} search mechanism, enabling efficient selfsupervised training via bilevel optimization. This integration significantly enhances the balance between search efficiency and path optimality while improving generalization to previously unseen maps. Extensive experiments demonstrate that iA{$\ast$} outperforms both classical and supervised learning-based methods, achieving an average reduction of 65.7\% in search area and 54.4\% in runtime, underscoring its effectiveness in robot path planning tasks.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  annotation = {titleTranslation: iA*：基于指令式学习的A*路径规划搜索\\
abstractTranslation: 路径规划旨在寻找两点之间无碰撞的路径，对于从移动机器人到自动驾驶汽车等众多应用至关重要。传统的基于搜索的方法（如A*搜索）能够保证路径最优性，但在处理大规模地图时往往计算成本高昂。尽管基于学习的方法通过将学习到的约束整合到搜索过程中缓解了这一问题，但它们常常面临过拟合以及对大量标注数据集的依赖等挑战。为解决这些局限，我们提出了Imperative A* (iA*)，一种利用双层优化（BLO）和命令式学习（IL）的新型自监督路径规划框架。iA*框架将预测节点成本的神经网络与可微分的A*搜索机制相结合，通过双层优化实现高效的自监督训练。这种整合显著提升了搜索效率与路径最优性之间的平衡，同时增强了对未见地图的泛化能力。大量实验表明，iA*在性能上超越了传统方法和基于监督学习的方法，平均搜索面积减少65.7\%，运行时间减少54.4\%，充分证明了其在机器人路径规划任务中的有效性。},
  file = {/home/ouyangjiahong/Zotero/storage/PPVGPY4A/Chen 等 - 2025 - iA imperative learning-based a search for path planning.pdf}
}

@inproceedings{chenImprovedMethodCislunar2025,
  title = {An Improved Method for Cislunar Space {{DRO}} Calculation Based on Differential Correction},
  booktitle = {2024 {{International Conference}} on {{Guidance}}, {{Navigation}} and {{Control}}},
  author = {Chen, Yujie and Zhu, Yanwei and Chan, Meichen and Qiao, Chenyuan and Qiu, Haipeng},
  year = 2025,
  series = {2024 {{International Conference}} on {{Guidance}}, {{Navigation}} and {{Control}}},
  address = {Changsha, China},
  abstract = {The multi-body dynamics of cislunar space is an important research direction of spacecraft motion in nowadays. DRO (Distant Retrograde Orbit) is a high value orbit in cislunar space. The initial value of the plane DRO at CR3BP (Circular Restricted Three-Body Problem) includes the x-component position, y-component velocity, and period. Under the traditional differential correction method, if the x-component position is fixed, the y-component velocity and period need to be input as the variables to be corrected. In this case, the approximate value of the y-component velocity and the period need to be calculated in advance. An improved method for cislunar space DRO calculation based on differential correction is proposed. This method calculates the period by setting the orbital integral event, and updates the period in each correction, so as to obtain the exact value of the period in the process of correcting the y-component velocity. This method reduces the input of the period to be corrected so that reduces reliance on the period. Under the condition of fixed x-component position, the initial value and period of the orbit can be calculated by inputting only one parameter (y-component velocity) while traditional differential correction needs two (y-component velocity and period). In this study, the stability, Jacobi energy, precision and other indexes are analyzed between traditional differential correction and improved differential correction.},
  langid = {english},
  annotation = {titleTranslation: 一种基于微分校正的地月空间DRO计算改进方法},
  file = {/home/ouyangjiahong/Zotero/storage/JS2Z8HHA/Chen 等 - 2025 - An improved method for cislunar space DRO calculation based on differential correction.pdf}
}

@book{ChenJieShengTaiKongJunShiYunYongZhanLueGouXiang2021,
  title = {太空军事运用战略构想},
  author = {{陈杰生} and {王鹏} and {张清作}},
  year = 2021,
  publisher = {北京：国防工业出版社},
  abstract = {随着信息时代与空天时代的同步到来，太空已经成为影响国家安全和发展利益、赢得信息化战争的关键因素，加强太空军事运用的战略谋划是太空领域军民融合健康发展和国家安全的迫切需要。本书在界定太空军事运用战略、剖析太空军事战略形势的基础上，着眼于未来空天威胁，借鉴军事强国太空作战理论研究成果和发展方向，把握太空作战``易攻难守''``耗资巨大''等基本规律，结合面临的太空战略形势和世界主要国家太空军事运用战略，研究了未来太空军事运用的战略目标、战略任务、战略指导思想、战略指导原则和战略体系等问题，并对太空力量在威慑、信息支援、进攻和防御中的战略运用问题，以及太空军事运用的训练和保障问题进行了系统论述。本书可供军队中高级指挥机构、规划业务机关，以及地方政府有关规划部门人员，院校及科研机构作战理论和航天技术研究人员，相关专业研究生，以及其他关注国家安全、关注太空安全的人士参考。},
  keywords = {-}
}


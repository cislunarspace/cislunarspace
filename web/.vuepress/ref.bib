@article{mortariAttitudeOrbitError2006,
  title = {Attitude and Orbit Error in N-Dimensional Spaces},
  author = {Mortari, Daniele and Scuro, Sante R. and Bruccoleri, Christian},
  year = 2006,
  month = dec,
  journal = {Journal of Astronautical Sciences},
  volume = {54},
  number = {3-4},
  pages = {467--484},
  issn = {0021-9142},
  doi = {10.1007/BF03256501},
  urldate = {2025-11-27},
  abstract = {This paper focuses the attention on theoretical aspects associated with the definition of the error for Special Orthogonal and for General Linear transformations, in any dimensional space, Real or Complex, and in both Euclidean and Riemannian spaces. In particular, the paper shows that the orbit error can be described by a complex number whose phase represents the orbit orientation error while the modulus describes the orbit shape error. This paper also shows that the angle between two quaternion has a specific geometrical meaning. In particular, the QR decomposition allows us to see a General Linear transformation as made of two subsequent effects: a dilation and a rigid rotation. This decomposition has been applied to the Lorentz transformations by highlighting the relativity effects of length change and coordinate axes bending.},
  copyright = {http://www.springer.com/tdm},
  langid = {english},
  annotation = {titleTranslation: n维空间中的姿态与轨道误差\\
abstractTranslation: 本文重点关注与特殊正交变换和一般线性变换误差定义相关的理论方面，涉及任意维度的空间（实数或复数域），以及在欧几里得空间和黎曼空间中的情形。具体而言，本文表明轨道误差可由一个复数描述，其相位代表轨道方向误差，而模长代表轨道形状误差。本文还指出两个四元数之间的夹角具有特定的几何意义。特别地，QR分解使我们能够将一般线性变换视为两个相继效应的组合：一个膨胀变换和一个刚体旋转。该分解已被应用于洛伦兹变换，从而揭示了长度变化和坐标轴弯曲的相对论效应。},
  file = {/home/ouyangjiahong/Zotero/storage/4LUXC4TS/Mortari 等 - 2006 - Attitude and orbit error in n-dimensional spaces.pdf}
}

@article{mortariHighAccuracyLeastsquares2019,
  title = {High Accuracy Least-Squares Solutions of Nonlinear Differential Equations},
  author = {Mortari, Daniele and Johnston, Hunter and Smith, Lidia},
  year = 2019,
  month = may,
  journal = {Journal of Computational and Applied Mathematics},
  volume = {352},
  pages = {293--307},
  issn = {0377-0427},
  doi = {10.1016/j.cam.2018.12.007},
  urldate = {2026-02-04},
  abstract = {This study shows how to obtain least-squares solutions to initial and boundary value problems of ordinary nonlinear differential equations. The proposed method begins using an approximate solution obtained by any existing integrator. Then, a least-squares fitting of this approximate solution is obtained using a constrained expression, derived from Theory of Connections. In this expression, the differential equation constraints are embedded and are always satisfied. The resulting constrained expression is then used as an initial guess in a Newton iterative process that increases the solution accuracy to machine error level in no more than two iterations for most of the problems considered. An analysis of speed and accuracy has been conducted for this method using two nonlinear differential equations. For non-smooth solutions or for long integration times, a piecewise approach is proposed. The highly accurate value estimated at the final time is then used as the new initial guess for the next time range, and this process is repeated for subsequent time ranges. This approach has been applied and validated solving the Duffing oscillator obtaining a final solution error on the order of 10-12. To complete the study, a final numerical test is provided for a boundary value problem with a known solution.},
  langid = {english},
  keywords = {Embedded linear constraints,Interpolation,Linear least-squares},
  annotation = {TLDR: This study shows how to obtain least-squares solutions to initial and boundary value problems of ordinary nonlinear differential equations by using an approximate solution obtained by any existing integrator using a constrained expression derived from Theory of Connections.\\
titleTranslation: 非线性微分方程的高精度最小二乘解\\
abstractTranslation: 本研究展示了如何获得常非线性微分方程初边值问题的最小二乘解。所提方法首先利用任意现有积分器获取近似解，随后基于约束表达式（源自连接理论）对该近似解进行最小二乘拟合。该表达式中嵌入了微分方程约束条件，且这些条件始终得到满足。然后将所得约束表达式作为牛顿迭代过程的初始猜测，对于大多数所考察问题，该过程在不超过两次迭代内即可将求解精度提升至机器误差水平。针对速度和精度，本文使用两个非线性微分方程对该方法进行了分析。对于非光滑解或长积分时间情形，本文提出一种分段处理方案：将最终时刻的高精度估计值作为下一时间区间的新初始猜测，并依次重复该过程。该方法已应用于Duffing振荡器的求解与验证，最终解误差量级达10{$^{-12}$}。为完整研究，本文给出了一个具有已知解的边值问题的最终数值测试},
  file = {/home/ouyangjiahong/Zotero/storage/QUKV8ITA/Mortari 等 - 2019 - High accuracy least-squares solutions of nonlinear differential equations.pdf;/home/ouyangjiahong/Zotero/storage/MYIZK2YY/S0377042718307325.html}
}

@article{mortariMultivariateTheoryConnections2019,
  title = {The Multivariate Theory of Connections},
  author = {Mortari, Daniele and Leake, Carl},
  year = 2019,
  month = mar,
  journal = {Mathematics},
  volume = {7},
  number = {3},
  pages = {296},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2227-7390},
  doi = {10.3390/math7030296},
  urldate = {2026-02-04},
  abstract = {This paper extends the univariate Theory of Connections, introduced in (Mortari, 2017), to the multivariate case on rectangular domains with detailed attention to the bivariate case. In particular, it generalizes the bivariate Coons surface, introduced by (Coons, 1984), by providing analytical expressions, called constrained expressions, representing all possible surfaces with assigned boundary constraints in terms of functions and arbitrary-order derivatives. In two dimensions, these expressions, which contain a freely chosen function,     g ( x , y )    , satisfy all constraints no matter what the     g ( x , y )     is. The boundary constraints considered in this article are Dirichlet, Neumann, and any combinations of them. Although the focus of this article is on two-dimensional spaces, the final section introduces the Multivariate Theory of Connections, validated by mathematical proof. This represents the multivariate extension of the Theory of Connections subject to arbitrary-order derivative constraints in rectangular domains. The main task of this paper is to provide an analytical procedure to obtain constrained expressions in any space that can be used to transform constrained problems into unconstrained problems. This theory is proposed mainly to better solve PDE and stochastic differential equations.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {constraints,embedded constraints,interpolation},
  annotation = {TLDR: The main task of this paper is to provide an analytical procedure to obtain constrained expressions in any space that can be used to transform constrained problems into unconstrained problems.\\
titleTranslation: 多元联络理论\\
abstractTranslation: 本文将（Mortari, 2017）中提出的单变量连接理论（Theory of Connections）扩展到矩形域上的多变量情形，并特别关注双变量情况。具体而言，它推广了（Coons, 1984）提出的双变量Coons曲面，通过提供称为约束表达式的解析表达式，描述了所有可能的、具有给定边界约束（以函数和任意阶导数形式给出）的曲面。在二维空间中，这些表达式包含一个自由选择的函数 g(x,y)，无论 g(x,y) 为何，都能满足所有约束。本文考虑的边界约束包括Dirichlet、Neumann以及它们的任意组合。尽管本文重点讨论二维空间，但最后一节引入了多变量连接理论，并给出了数学证明。这代表了连接理论在矩形域上受任意阶导数约束的多变量扩展。本文的主要任务是提供一种解析方法，以获取任意空间中的约束表达式，从而将约束问题转化为无约束问题。该理论的主要目的是更好地求解偏微分方程和随机微分方程。},
  file = {/home/ouyangjiahong/Zotero/storage/XDI929JV/Mortari和Leake - 2019 - The multivariate theory of connections.pdf}
}


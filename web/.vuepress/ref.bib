@article{hanBlockingGeosynchronousOrbits2025,
  title = {Blocking Geosynchronous Orbits: Analysis of Deployment and Mission Capability},
  shorttitle = {Blocking Geosynchronous Orbits},
  author = {Han, Hongyu and Dang, Zhaohui},
  year = 2025,
  month = jan,
  journal = {Space: Science \& Technology},
  volume = {5},
  pages = {221--234},
  issn = {2692-7659},
  doi = {10.34133/space.0221},
  urldate = {2025-09-25},
  abstract = {This paper addresses the blocking problem against a satellite attempting a geostationary or geosynchronous transfer. Calculation and optimization methods based on reachable domain and Lambert interception are designed for the case of in-plane and nonplanar transfer orbits. Numerical validations against Hohmann transfer orbits were conducted to substantiate the proposed methods. Results indicate that, when blocking in-plane geostationary transfers, the blocker's optimal stand-by orbit is the circular geostationary orbit. The mission-capable rates of in-plane elliptical blocking orbits, if properly arranged, resemble those of circular blocking orbits. When blocking nonplanar geosynchronous transfers, if only one blocker is involved, the optimal blocking orbit is circular. However, when multiple satellites collaborate on the same nonplanar blockade, the optimal blocking orbit is similar to a quasi-zenith orbit while the required capabilities for each blocker can be considerably reduced. Results indicate that geostationary or geosynchronous blocking can be achieved without occupying the precious geostationary orbit. Subsequently, the paper analyzes the impacts of non-Hohmann transfer orbits, inclined geostationary transfers, nonimpulsive maneuvers, and reaction times. The analysis pertaining to specific scenarios illustrates the interpretation and the definition used for orbital blockades; the engineering value of the computed results is revealed, providing insights for future research on orbital games.},
  langid = {english},
  annotation = {titleTranslation: 阻塞地球同步轨道：部署与任务能力分析\\
abstractTranslation: 本文针对企图进行地球静止轨道或地球同步轨道转移的卫星所面临的拦截问题展开研究。基于可达域与Lambert拦截方法，设计了面向共面与异面转移轨道的计算与优化方案。通过针对霍曼转移轨道的数值验证，证实了所提方法的有效性。结果表明：在拦截共面地球静止轨道转移时，拦截器的最优待命轨道为圆形地球静止轨道；若合理配置，共面椭圆拦截轨道的任务可行率与圆形拦截轨道相似。在拦截异面地球同步轨道转移时，若仅使用单个拦截器，最优拦截轨道为圆形；但当多颗卫星协同执行同一异面拦截任务时，最优拦截轨道类似于准天顶轨道，且各拦截器所需能力可显著降低。研究表明，无需占用宝贵的地球静止轨道即可实现地球静止或地球同步轨道拦截。随后，本文分析了非霍曼转移轨道、倾斜地球静止轨道转移、非脉冲机动及反应时间的影响。针对特定场景的分析阐释了轨道拦截的内涵与定义，揭示了计算结果的工程价值，为未来轨道博弈研究提供了启示。},
  file = {/home/ouyangjiahong/Zotero/storage/RKEGIQEB/Han和Dang - 2025 - Blocking geosynchronous orbits analysis of deployment and mission capability.pdf}
}


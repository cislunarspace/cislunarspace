@article{farquharQuasiperiodicOrbitsTranslunar1973,
  title = {Quasi-Periodic Orbits about the Translunar Libration Point},
  author = {Farquhar, Robert W and Kamel, Ahmed A},
  year = 1973,
  journal = {Celestial Mechanics},
  volume = {7},
  number = {4},
  pages = {458--473},
  publisher = {Springer},
  doi = {10.1007/BF01227511},
  abstract = {Analytical solutions for quasi-periodic orbits about the translunar libration point are obtained by using the method of Lindstedt-Poincar6 and computerized algebraic manipulations. The solutions include the effects of nonlinearities, lunar orbital eccentricity, and the Sun's gravitational field. For a small-amplitude orbit, the orbital path as viewed from the Earth traces out a Lissajous figure. This is due to a small difference in the fundamental frequencies of the in-plane and out-of-plane oscillations. However, when the amplitude of the in-plane oscillation is greater than 32 379 km, there is a corresponding value of the out-of-plane amplitude that will produce a path where the fundamental frequencies are equal. This synchronized trajectory describes a 'halo orbit' of the Moon.},
  langid = {english},
  annotation = {titleTranslation: 关于地月平动点的准周期轨道\\
abstractTranslation: 利用林德斯泰特-庞加莱方法及计算机代数运算，获得了绕平动点拟周期轨道的解析解。该解包含了非线性效应、月球轨道偏心率及太阳引力场的影响。对于小振幅轨道，从地球视角观测其轨迹会呈现利萨如图形，这是由于面内与面外振荡基频存在微小差异所致。然而当面内振荡振幅大于32379公里时，存在一个对应的面外振幅值可使轨道基频相等。这种同步轨迹即描述了月球的"晕轨道"。},
  file = {/home/ouyangjiahong/Zotero/storage/JGRISWMW/Farquhar和Kamel - 1973 - Quasi-periodic orbits about the translunar libration point.pdf}
}

@article{farresDynamicsSolarSail2010,
  title = {Dynamics of a Solar Sail near a Halo Orbit},
  author = {Farr{\'e}s, A. Ari Maia. Ub. and Jorba, {\`A}. Angel Maia. Ub.},
  year = 2010,
  journal = {Acta Astronautica},
  volume = {Vol.67},
  number = {No.7-8},
  pages = {979--990},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2010.05.022},
  abstract = {In this work we are interested in the local dynamics around a Halo-type orbit for a solar sail and how it varies when the sail orientation changes. To model the dynamics of a solar sail we have considered the restricted three body problem adding the solar radiation pressure (RTBPS). We know that the RTBPS has a 2D family of equilibrium points parametrised by the two angles that define the sail orientation. First we will describe the families of periodic and quasi-periodic orbits that appear around the different equilibrium points. We will find planar, vertical and Halo-type orbits around the different equilibria. Finally, we will focus on a Halo-type orbit and describe the natural dynamics around it. We will discuss the possibility of using this knowledge to derive station keeping strategies for a solar sail.},
  langid = {english},
  keywords = {Centre manifold,Invariant manifolds,Low-thrust,Periodic orbits,Station keeping},
  annotation = {titleTranslation: 太阳帆在晕轨道附近的动力学特性\\
abstractTranslation: 在本工作中，我们关注太阳帆在Halo型轨道附近的局部动力学，以及该动力学如何随帆面朝向变化而变化。为建模太阳帆动力学，我们考虑了加入太阳辐射压的限制性三体问题（RTBPS）。已知RTBPS具有由定义帆面朝向的两个角度参数化的二维平衡点族。首先，我们将描述不同平衡点附近出现的周期和拟周期轨道族。我们将在不同平衡点附近找到平面、垂直和Halo型轨道。最后，我们将聚焦于一个Halo型轨道，描述其附近的自然动力学，并讨论利用这些知识推导太阳帆位置保持策略的可能性}
}


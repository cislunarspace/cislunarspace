@inproceedings{muralidharanControlStrategyLongterm2020,
  title = {Control Strategy for Long-Term Station-Keeping on near-Rectilinear Halo Orbits},
  booktitle = {{{AIAA SciTech Forum}} and {{Exposition}}},
  author = {Muralidharan, Vivek and Weiss, Avishai and Kalabi{\'c}, Uro{\v s}},
  year = 2020,
  address = {Orlando, FL, United states},
  doi = {10.2514/6.2020-1459},
  abstract = {This work considers the control of a spacecraft in indefinite near-rectilinear halo orbit about the Earth-Moon L2. For indefinite station-keeping, it is important to minimize fuel consumption, while allowing for occasional transfer to a new orbit. The control scheme therefore consists of two components: the first component is the tracking of the nominal NRHO and the second component is an orbit correction maneuver between NRHO trajectories. The nominal NRHO is computed using a multiple-shooting technique that takes into account all forces on the spacecraft whose magnitude is larger than the dominant disturbance forces caused by navigational error. The tracking component is a linear-quadratic regulation scheme that rejects disturbances caused by orbit determination error, using a Lyapunov sublevel set that models the state covariance generated using sequential Kalman filter. The orbit correction maneuver is computed to minimize fuel costs.},
  langid = {english},
  annotation = {titleTranslation: 近直线晕轨道长期位置保持控制策略}
}


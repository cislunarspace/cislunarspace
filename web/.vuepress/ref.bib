  urldate = {2025-11-25},
  abstract = {Gateway represents a key element of the Artemis program for the upcoming lunar exploration aimed at establishing a sustainable presence by the mid-2030s. This paper investigates minimum-fuel bi-impulsive orbit transfers from Gateway to low lunar orbits (LLOs) with a maximum time of flight of 48 h. Two distinct scenarios are analyzed: (i) target orbits with free right ascension of the ascending node (RAAN), and (ii) target orbits with specified RAAN. For case (i), a global optimization technique based on a heuristic algorithm is exploited to obtain the minimum-fuel transfer. Several inclinations of the target orbit are considered. For case (ii), two distinct techniques are proposed: (a) a purely heuristic approach, and (b) a semi-analytical method based on local refinement of a Lambert-based solution. Numerical propagations are conducted in all scenarios in a high-fidelity framework that includes all relevant perturbations. A comparison between the different strategies and the related numerical results is provided.},
  langid = {english},
  keywords = {fuel-optimal trajectories,gateway,Lambert's problem,low lunar orbits,nrho,two-impulse transfer orbit},
  annotation = {titleTranslation: 从地月空间站至低月球轨道的最优脉冲轨道转移\\
abstractTranslation: Gateway 是阿尔忒弥斯计划中即将开展的月球探测任务的关键要素，该计划旨在到 2030 年代中期建立可持续的月球存在。本文研究了从 Gateway 到低月球轨道（LLO）的最小燃料双脉冲轨道转移，最大飞行时间为 48 小时。分析了两种不同场景：(i) 升交点赤经（RAAN）自由的目标轨道，以及 (ii) 指定 RAAN 的目标轨道。对于场景 (i)，采用基于启发式算法的全局优化技术来获得最小燃料转移，并考虑了目标轨道的多种倾角。对于场景 (ii)，提出了两种不同的技术：(a) 纯启发式方法，以及 (b) 基于对 Lambert 解进行局部修正的半解析方法。所有场景均在包含所有相关摄动的高保真框架内进行数值传播，并提供了不同策略及相关数值结果之间的比较},
  file = {/home/ouyangjiahong/Zotero/storage/DQACKVID/Sanna 等 - 2024 - Optimal impulsive orbit transfers from gateway to low lunar orbit.pdf}
}

@article{sansebastianDispersionVelocityRevisited2023,
  title = {Dispersion Velocity Revisited},
  author = {San Sebasti{\'a}n, Irina L. and Parisi, M. Gabriela and Guilera, Octavio M. and Efthymiopoulos, Christos},
  year = 2023,
  month = apr,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {2},
  pages = {11},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10128-5},
  urldate = {2025-10-01},
  abstract = {The aim of this paper is to provide an analytical tool, which might improve models in which the particle-in-a-box approach has been applied and that may be also used when the thin disk approximation could not be longer appropriate. The dispersion velocity is the root-meansquare planetesimal, asteroid, or Kuiper belt object velocity with respect to the local mean circular orbit. This velocity is a function of the object orbital eccentricity and inclination. We calculate a general expression of the dispersion velocity for the planar case in which the object's orbit has no inclination with respect to the local mean circular orbit and for the spatial case in which it has an inclined orbit. Our general expression of the square of the dispersion velocity may be expanded around any value of e for the planar and spatial cases, being in space an exact solution of the orbital inclination i. We expanded our expression around e = 0 with i = e/2 to study solid accretion rates and collision probabilities. We find that in the whole range of eccentricities and inclinations, our results are lower than solid accretion rates and collision probabilities computed by using the expressions of the dispersion velocity usually adopted in the literature. We apply our expressions of the square of the dispersion velocity expanded around e=0 and up to sixth order in e in our numerical model of planetary formation with planetesimal fragmentation and in our model of the collisional frequency on large asteroids. Our formalism, although generally giving lower values than previous approximations, validates the formerly used estimates for the applications presented here. In addition, we calculate the statistical velocity dispersion obtaining a straightforward expression as a function of the eccentricity.},
  langid = {english},
  annotation = {titleTranslation: 重新考察了弥散速度。\\
abstractTranslation: 本文旨在提供一种分析工具，以改进已采用``粒子在一维盒子''模型的模拟方法，同时适用于薄盘近似不再适用的情况。弥散速度是指星子、小行星或柯伊伯带天体相对于局部平均圆形轨道的均方根速度，该速度是天体轨道偏心率和倾角的函数。我们计算了平面情形（天体轨道相对于局部平均圆形轨道无倾角）和空间情形（天体轨道存在倾角）下弥散速度的一般表达式。该弥散速度平方的一般表达式可在平面和空间情形下围绕任意e值展开，且在空间情形下是轨道倾角i的精确解。我们将表达式在e=0且i=e/2处展开，以研究固体吸积率和碰撞概率。结果发现，在全部偏心率和倾角范围内，我们的结果均低于文献中常用弥散速度表达式所计算的固体吸积率和碰撞概率。我们将e=0处展开至e的六阶的弥散速度平方表达式应用于考虑星子碎裂的行星形成数值模型以及大型小行星碰撞频率模型中。尽管我们的公式通常给出低于先前近似的结果，但验证了此前估计值在本文所述应用中的有效性。此外，我们还计算了统计速度弥散，得到了一个关于偏心率的简明表达式。},
  file = {/home/ouyangjiahong/Zotero/storage/HDZZH4CG/San Sebastián 等 - 2023 - Dispersion velocity revisited.pdf}
}


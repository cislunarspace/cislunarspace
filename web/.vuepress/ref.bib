@article{gaoLowthrustStationkeepingControl2023,
  title = {Low-Thrust Station-Keeping Control for Lunar near Rectilinear Halo Orbits},
  author = {Gao, Chen and Masdemont, Josep J. and G{\'o}mez, Gerard and Yuan, Jianping},
  year = 2023,
  month = apr,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {2},
  pages = {14},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10130-x},
  urldate = {2025-10-01},
  abstract = {This paper studies a low-thrust station-keeping of near rectilinear halo orbits in the Earth--Moon quasi-bicircular dynamical model, and it is illustrated using resonant near rectilinear halo orbits as nominal orbits. The control laws considered use a dynamical reshaping strategy that cancels the unstable Floquet modes and stabilize the motion. Furthermore, asymptotic stabilization can be achieved adding the central Floquet modes into the reshaping procedure. Using the Jet Transport technique, the control laws can be explicitly given as high-order Taylor polynomials in terms of the deviation between the state of the spacecraft and the corresponding isochronous state. The explicit closed-form of the controller, obtained using Jet Transport, allows fast control acceleration computation, which could be also of interest for an onboard implementation. Moreover, the robustness of the station-keeping method is shown introducing orbit determination errors in both position and velocity.},
  langid = {english},
  keywords = {Dynamical reshaping strategy,Low-thrust station keeping,Near rectilinear halo orbits,Quasi-bicircular problem},
  annotation = {titleTranslation: 月球近直线晕轨道低推力位置保持控制\\
abstractTranslation: 本文研究了地月准双圈动力学模型中近直线晕轨道的低推力站位保持，并以共振近直线晕轨道作为标称轨道进行说明。所考虑的控制律采用动态重塑策略，消除不稳定Floquet模态并稳定运动。此外，通过将中心Floquet模态纳入重塑过程，可实现渐近稳定。利用Jet Transport技术，控制律可显式表示为航天器状态与对应等时状态偏差的高阶泰勒多项式。借助Jet Transport获得的控制器显式闭式形式，可快速计算控制加速度，这也有利于星上实现。此外，通过引入位置和速度的轨道确定误差，展示了该站位保持方法的鲁棒性},
  file = {/home/ouyangjiahong/Zotero/storage/KAV8UDSX/Gao 等 - 2023 - Low-thrust station-keeping control for lunar near rectilinear halo orbits.pdf}
}


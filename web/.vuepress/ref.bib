@phdthesis{rossPulsarbasedOrbitDetermination2025,
  type = {硕士论文},
  title = {Pulsar-Based Orbit Determination for Navigation in a Cislunar Cold-Start Scenario},
  author = {Ross, Jillian},
  year = 2025,
  journal = {ProQuest Dissertations and Theses},
  abstract = {The anticipated growth of operations in cislunar space necessitates advancements in autonomous navigation capabilities. Methods developed during the Apollo program of the 1960's and early 1970's largely depended upon inertial updates from ground tracking. Limitations in onboard computer memory during that era prevented implementation of fully autonomous navigation 1]; however, astronauts could manually use a sextant to perform updates with angle measurements between celestial bodies 2]. While successful for the Apollo program, such technology is not considered to be sufficient for recent and anticipated missions such as Artemis, which involve risks inherent to more complex trajectories and increased traffic. One critical scenario is the cold-start, where loss of communication with ground or space-based stations results in the loss of prior state information. Ensuring mission safety in cases such as the cold-start requires spacecraft to autonomously reacquire their state information. Initial orbit determination (IOD), a cornerstone of navigation, has been extensively studied under Keplerian dynamics by Laplace 3], Gauss 4], and Gibbs 5] since the 18th century. However, a closed-form solution for IOD in the Circular Restricted Three-Body Problem (CR3BP), which more accurately models motion in the Earth-Moon system, remains elusive. Probabilistic methods, such as the Admissible Region approach 6], provide a framework to characterize the state probability density function of a spacecraft. A cislunar approach is constructed to develop an Admissible Region which leverages celestial measurements and the CR3BP integral of motion, the Jacobi Constant. Among celestial navigation options, pulsars serve as a uniquely attractive source for position determination due to their emission of highly stable periodic electromagnetic signals in the X-ray band 7]. In this thesis, a probabilistic orbit determination method is developed to constrain a satellite's admissible region space using pulsar-based measurements and mission-specific assumptions about the Jacobi Constant. A Gaussian Mixture Model (GMM) is used to approximate the admissible region, which is modeled as a bivariate uniform probability density function in range and range-rate space of the satellite relative to Earth. A Gaussian Mixture Filter (GMF) is then designed to predict the GMM-admissible region under CR3BP dynamics and update the mixture components using pulsar-based X-ray measurements. Performance of the proposed filter is evaluated by assessing whether it meets NASA's navigation error requirements for encountering a cold-start in various cislunar trajectories. Inspired by mission developments for NASA's Lunar Gateway and Orion vehicles, test cases consist of cold-start initialization in a Near-rectilinear Halo Orbit (NRHO), Distant Retrograde Orbit (DRO), and Moon-toEarth transfer, ensuring suitability of the developed filter for autonomous navigation in the Earth-Moon system.},
  isbn = {9798290635071},
  langid = {english},
  school = {Purdue University},
  keywords = {0538:Aerospace engineering,Aerospace engineering,Moon,Pulsars},
  annotation = {titleTranslation: 基于脉冲星的轨道确定在月球空间冷启动导航中的应用},
  file = {/home/ouyangjiahong/Zotero/storage/PQB4MTAB/Ross - 2025 - Pulsar-based orbit determination for navigation in a cislunar cold-start scenario.pdf}
}

@inproceedings{rozekMultiobjectiveOptimisationNRHOLLO2019,
  title = {Multi-Objective Optimisation of {{NRHO-LLO}} Orbit Transfer via Surrogate-Assisted Evolutionary Algorithms},
  booktitle = {{{AIAC18}}: 18th {{Australian International Aerospace Congress}} (2019): {{HUMS}} - 11th {{Defence Science}} and {{Technology}} ({{DST}}) {{International Conference}} on {{Health}} and {{Usage Monitoring}} ({{HUMS}} 2019): {{ISSFD}} - 27th {{International Symposium}} on {{Space Flight Dynamics}} ({{ISSFD}})},
  author = {Rozek, Matthew and Ogawa, Hideaki and Ueda, Satoshi and Ikenaga, Toshinori},
  year = 2019,
  address = {Melbourne},
  abstract = {The near rectilinear halo orbit (NRHO) families around the Earth-Moon Lagrange 2 point offer favourable features for cislunar missions such as advantages in transfer and polar visibility. Multidisciplinary system design optimisation (MSDO) has been conducted for the NRHO to the low lunar orbit (LLO) transfer by means of evolutionary algorithm in the present study. The methodology consists of two steps; (1) perform multi-objective design optimisation (MDO) for transfer orbits simultaneously minimising total delta V and time of flight by coupling an orbit propagator using a highly parallel GPU (graphics processing unit) into evolutionary algorithms; (2) perform MSDO considering the orbit, eclipse and visibility effects as well as subsystem mass using the surrogate models trained in the preceding MDO step. A Pareto optimal front indicative of a counteracting trend has resulted from the MSDO study. Presence of multiple families of feasible trajectories with different attributes has been suggested by post analysis.},
  langid = {english},
  annotation = {titleTranslation: 基于代理辅助进化算法的NRHO-LLO轨道转移多目标优化}
}


@article{patrickHybridOptimizationHighfidelity2023,
  title = {Hybrid Optimization of High-Fidelity Low-Thrust Transfers to the Lunar Gateway},
  author = {Patrick, Brian and Pascarella, Alex and Woollands, Robyn},
  year = 2023,
  journal = {Journal of Astronautical Sciences},
  volume = {Vol.70},
  number = {No.4},
  pages = {27},
  issn = {0021-9142},
  doi = {10.1007/s40295-023-00387-7},
  abstract = {NASA's Artemis program aims to establish a sustainable and long-term human presence on, and in orbit around, the Moon. Transportation of humans and supplies to and from the Lunar Gateway will be a critical element of a successful Artemis program. Solar electric propulsion will play a key role in the supply chain for sustainable cislunar space operations. Solar electric propulsion engines are more efficient than chemical engines, thus requiring less propellant mass which in turn leads to smaller/lighter spacecraft that are cheaper to launch. In this paper we present a hybrid optimization scheme for solving fuel-optimal, low-thrust, transfers from a Geosynchronous Equatorial Orbit to a Near Rectilinear Halo Orbit, including a terminal manifold coast, considering a spacecraft with a thrust acceleration less than 0.25 mm/s \textsuperscript{2} . Such problems are extremely challenging to solve with single- or multiple-shooting, even when continuation and smoothing are applied to thruster on/off switches and eclipse entry/exit conditions. Our hybrid optimization scheme is formulated using particle swarm optimization to compute the optimal sequence of intermediate target orbits between the departure orbit and the desired manifold injection point, such that the total propellant mass for the transfer is minimized. An indirect optimization approach is then used to compute fuel-optimal trajectory legs between each pair of intermediate orbits. To quantify the performance of our hybrid algorithm, we compare it to optimal trajectories obtained using single- or multiple-shooting for problems with a larger thrust-to-mass ratio that can be more easily converged using shooting methods.},
  langid = {english},
  keywords = {Gateway,Low-thrust,Particle swarm,Trajectory optimization},
  annotation = {titleTranslation: 高保真低推力地月门户转移轨道的混合优化\\
abstractTranslation: NASA的Artemis计划旨在在月球表面及绕月轨道上建立可持续且长期的人类存在。航天员和物资往返于Lunar Gateway的运输将是Artemis计划成功的关键要素。太阳电推进将在可持续地月空间运营的供应链中发挥核心作用。太阳电推进发动机比化学发动机效率更高，因此所需推进剂质量更少，进而使航天器更小、更轻，发射成本更低。本文提出了一种混合优化方案，用于求解从地球同步赤道轨道到近直线晕轨道的燃料最优小推力转移，包括终端流形滑行，并考虑了推力加速度小于0.25 mm/s{$^2$}的航天器。此类问题即使对推力器开关和进出阴影条件应用延拓与平滑处理，使用单重或多重打靶法也极难求解。我们的混合优化方案采用粒子群优化算法计算从出发轨道到目标流形注入点之间的最优中间目标轨道序列，以使转移过程总推进剂质量最小化；随后，利用间接优化方法计算每对中间轨道之间的燃料最优轨迹段。为量化混合算法的性能，我们将其与使用单重或多重打靶法获得的、具有较大推重比（从而更易通过打靶法收敛）问题的最优轨迹进行对比}
}


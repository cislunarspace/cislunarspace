  pages = {2576--2588},
  issn = {1001-5965},
  doi = {10.13700/j.bh.1001-5965.2020.0608},
  urldate = {2025-09-25},
  abstract = {地月系统中存在着一类绕月逆行、高度稳定的轨道族，称为远距离逆行轨道族(DRO)。以圆型限制性三体问题(CR3BP)为动力学模型研究了DRO轨道族周边的动力系统结构。利用Broucke稳定性图寻找分叉点，判断分叉类型，基于数值延拓计算分岔后产生的一系列新轨道分支。分叉类型主要有切分叉与多倍周期分叉(从3倍周期开始),轨道维度包含平面轨道族与三维轨道族。计算新轨道族的特征，包括形状、周期、能量、稳定性、双曲流形结构等。探讨周期轨道的轨道周期与能量的关系，以几何化的方式展现分叉结构、多周期轨道的双曲流形结构等。该动力结构将为基于DRO轨道族的地月空间任务提供重要的理论支持。},

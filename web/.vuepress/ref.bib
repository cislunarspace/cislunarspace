@article{muralidharanLeveragingStretchingDirections2022,
  title = {Leveraging Stretching Directions for Stationkeeping in {{Earth-moon}} Halo Orbits},
  author = {Muralidharan, Vivek and Howell, Kathleen C.},
  year = 2022,
  journal = {Advances in Space Research},
  volume = {Vol.69},
  number = {No.1},
  pages = {620--646},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2021.10.028},
  abstract = {Near Rectilinear Halo Orbits (NRHOs) are stable or nearly stable orbits that are defined as part of the L1 and L2 halo orbit families in the circular restricted three-body problem. Within the Earth-Moon regime, the L1 and L2 NRHOs are proposed as long horizon trajectories for cislunar exploration missions, including NASA's upcoming Gateway mission. The spacecraft, however, incurs continuous deviations due to unmodeled forces and orbit determination errors in this dynamically sensitive region. The current investigation focuses on an impulsive stationkeeping technique to maintain the spacecraft near a virtual reference orbit despite these uncertainties. The flow dynamics in the region are utilized to identify appropriate maneuver and target locations. The investigation reflects the impact of various factors on maneuver cost and efficacy. For orbits where position and velocity states are particularly sensitive to epoch time, an additional feedback control strategy is applied for phasing constraints.},
  langid = {english},
  keywords = {Cauchy-Green tensor,Circular restricted three-body problem,Near rectilinear halo orbits,Phase control,Stationkeeping,Stretching directions,x-axis crossing control},
  annotation = {titleTranslation: 利用拉伸方向实现地月系晕轨道位置保持\\
abstractTranslation: 近直线晕轨道（NRHOs）是圆形限制性三体问题中定义为L1和L2晕轨道族一部分的稳定或近稳定轨道。在地月系内，L1和L2 NRHOs被提议作为地月空间探索任务的长期轨迹，包括NASA即将实施的Gateway任务。然而，在这一动态敏感区域，航天器因未建模力和轨道确定误差而持续产生偏差。当前研究聚焦于一种脉冲式轨道保持技术，旨在尽管存在这些不确定性，仍使航天器维持在虚拟参考轨道附近。利用该区域的流动力学特性来确定合适的机动位置和目标位置。研究反映了各种因素对机动成本与效能的影响。对于位置和速度状态对历元时间特别敏感的轨道，额外采用反馈控制策略以满足定相约束。}
}


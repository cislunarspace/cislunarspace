@article{ZhangRunDeJiQunHangTianQiLuBangZiGuaYingKuaiSuRenWuFenPei2023,
  title = {集群航天器鲁棒自适应快速任务分配},
  author = {{张润德} and {蔡伟伟} and {杨乐平} and {范大伟}},
  year = 2023,
  journal = {宇航学报},
  number = {第8期},
  pages = {1183--1194},
  abstract = {针对集群航天器协同观测任务分配问题，提出一种基于深度神经网络和鲁棒自适应拍卖算法的快速任务分配策略。为提高燃料消耗指标的计算效率，利用深度神经网络直接预测连续推力转移轨迹的燃料消耗，避免在线规划相对运动轨迹。通过构造虚拟收益矩阵和分配向量使得拍卖算法适用于航天器数与任务数目不一致的分配问题。为提高拍卖算法的收敛速度，提出报价增量自适应调整策略。考虑到通信失联、航天器故障等不确定因素，通过在线调整故障航天器的收益和报价矩阵以提高算法鲁棒性。数值仿真表明深度神经网络对燃料消耗指标预测精度高，基于深度神经网络和鲁棒自适应拍卖算法的快速任务分配策略可在保持计算精度的同时，将计算效率提升约两个数量级。},
  keywords = {,;;;;},
  file = {/home/ouyangjiahong/Zotero/storage/8T4H26IT/张润德 等 - 2023 - 集群航天器鲁棒自适应快速任务分配.pdf}
}

@article{ZhangRuYueDiYueKongJianDROJinJuChiBianDuiXingJianCeLiangXiangDuiDingGui2025,
  title = {{地月空间DRO近距离编队星间测量相对定轨}},
  author = {{张如悦} and {王文彬} and {李霜琳} and {蒲京辉} and {张伟}},
  year = 2025,
  journal = {宇航学报},
  volume = {46},
  number = {10},
  pages = {2146--2159},
  issn = {1000-1328},
  abstract = {地月空间远距离逆行轨道（DRO）因轨道稳定性及三体引力场非对称特性，成为卫星长期驻留与月球导航星座部署的研究热点。针对DRO主/副星近距离编队相对定轨问题，提出一种基于多源观测数据融合的协同定轨方案。该方案利用近地轨道（LEO）卫星接收全球导航卫星系统（GNSS）信号实现自主定轨，并建立与DRO主/副星的星间测量链路。主星搭载光学相机获取副星方位信息，其绝对轨道作为相对定轨的先验基准。设计了3种相对定轨策略，并通过高保真数值仿真验证方案有效性。结果表明，当主星轨道精度较高时，3种方案均能达到10 m级相对位置精度和亚毫米每秒量级速度精度；当主星轨道精度较低时，结合星间测距与光学测角数据的方案可将相对位置精度提升至13 m，速度精度达8 mm/s，收敛时间缩短至分钟级。该研究揭示了低精度主星条件下光学测角数据对相对定轨性能的改善机制，为DRO编队测量链路设计提供了理论依据。},
  langid = {chinese},
  keywords = {,(DRO)},
  file = {/home/ouyangjiahong/Zotero/storage/J8XV4FCA/张如悦 等 - 2025 - 地月空间DRO近距离编队星间测量相对定轨.pdf}
}

@article{ZhangSenMianXiangShiYanHuanJingDeWuRenJiQiangHuaXueXiZhiNengKongZhiFangFa2026,
  title = {{面向时延环境的无人机强化学习智能控制方法}},
  author = {{张森} and {李杰} and {张建伟} and {李辉} and {吴寿英} and {吴冯国}},
  year = 2026,
  month = feb,
  journal = {计算机工程},
  pages = {1--18},
  issn = {1000-3428},
  doi = {10.19678/j.issn.1000-3428.0253200},
  urldate = {2026-02-05},
  abstract = {深度强化学习（DRL）在无人机（UAV）决策领域的最新研究中展现出强大潜力，已在多种控制任务中取得显著成效。然而，现有将DRL用于无人机控制的研究大多默认``零延迟''理想环境，忽略了真实链路中普遍存在的信号延迟；直接把在MuJoCo 等基准任务中验证的通用延迟处理方法迁移到高动态无人机平台，往往难以复现其原有效果，甚至加剧性能衰减。本研究通过仿真实验验证了经过深度强化学习训练的无人机智能体在信号延迟下出现的显著性能下降，并深入分析了性能衰退的原因。论文提出了一种状态预测与自适应决策增强框架SPADE，能够有效处理固定与非固定延迟，在1v1近距离格斗任务中实现了与无延迟系统相媲美的控制效果：在300--2400 毫秒延迟区间内，SPADE较基线方法平均胜率增幅为19.4\%（固定延迟）13.0\%（非固定延迟），显著补偿了软演员-评论家（SAC）算法因延迟造成的性能衰减，且优于现有缓解深度强化学习无人机控制延迟效应的方法。总体而言，本研究揭示了信号延迟对无人机控制系统的负面影响，并提出了创新的状态预测与决策增强框架（SPADE）以应对此挑战，显著提升了在延迟条件下的无人机控制性能。},
  langid = {chinese},
  annotation = {original-container-title: Computer Engineering\\
AIF: 1.819\\

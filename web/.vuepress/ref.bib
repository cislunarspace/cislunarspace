  number = {9},
  pages = {1364--1375},
  issn = {1000-1328},
  abstract = {为应对地球观测卫星（EOS）任务过程中面临的应急任务处置、卫星失效等突发情况，考虑通信约束，提出了一种针对卫星观测敏感器的预调度与重调度相结合的分布式调度方法。首先，提出一种多点交叉变异的分布式遗传算法（MDGA），产生高鲁棒性的初始对地观测方案，完成观测资源预调度。然后，面对应急任务处置需求和卫星失效事件，设计一种基于星间通信约束的合同网协议算法（ICCNP），使观测方案可动态调整，实现观测资源重调度。仿真结果表明，所提方法在预调度阶段相比集中式遗传算法、贪婪算法等算法显著提高了调度收益；在重调度阶段，所提方法能局部调整任务方案，以对任务方案扰动最小的方式，合理安排应急任务并重新分配失效卫星未完成的任务。},
  langid = {chinese},

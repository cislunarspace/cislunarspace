@inproceedings{guzmanGeneratingArtemis32020,
  title = {Generating Artemis 3 Trajectories to a 9:2 {{NRHO}} Using Machine Learning},
  booktitle = {{{AIAA SciTech}} Forum and Exposition},
  author = {Guzman, Esteban},
  year = 2020,
  address = {Orlando},
  abstract = {The purpose of this thesis is to design a machine-learning platform that expands knowledge of mission availability through a launch season by improving trajectory resolution and introducing launch mission forecasting. This paper considers trajectory data provided for deterministic translational maneuvers through a mission to a Near Rectilinear Halo Orbit (NRHO). Current launch availability knowledge under NASA's Orion Orbit Performance Team is established by altering optimization variables at given reference launch epochs. This current method can be abstract and relies on orbit analysts to structure trajectories based off an established mission design methodology associated to the performance of Orion and NASA's Space Launch System. Introducing a machine-learning algorithm trained to construct mission scenarios within the feasible range of known trajectories reduces the required interaction of orbit analysts by removing the needed step of optimizing the orbit to fit an expected translational response required of the spacecraft. In this study, k-Nearest Neighbor and Bayesian Linear Regression successfully predicted classical orbital elements for the launch windows observed. Training machine-learning algorithms off converged trajectories introduced a repetitive approach to reconstructing missions through the launch window and can prove to be a viable method of generating launch window scans.},
  langid = {english},
  annotation = {titleTranslation: 利用机器学习生成前往9:2 NRHO的阿尔忒弥斯3号任务轨道。}
}


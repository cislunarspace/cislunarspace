@article{duanAdaptivePolynomialChaos2025,
  title = {Adaptive Polynomial Chaos Expansion Method for Uncertain Multiple-Revolution Lambert Problem},
  author = {Duan, Yu and Yang, Zhen and Luo, Ya-Zhong},
  year = 2025,
  month = oct,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},

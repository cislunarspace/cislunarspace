  booktitle = {Proceedings of the 2000 {{American Control Conference}}. {{ACC}} ({{IEEE Cat}}. {{No}}.{{00CH36334}})},
  author = {{Joonhyung Park} and Rhinehart, R.G. and Kabamba, P.T.},

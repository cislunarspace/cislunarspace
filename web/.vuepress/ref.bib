  abstract = {This work studies a special type of cislunar periodic orbits in the circular restricted three-body problem called resonance transition periodic orbits, which switch between different resonances and revolve about the secondary with multiple loops during one period. In the practical computation, families of multiple periodic orbits are identified first, and then the invariant manifolds emanating from the unstable multiple periodic orbits are taken to generate resonant homoclinic connections, which are used to determine the initial guesses for computing the desired periodic orbits by means of multiple-shooting scheme. The obtained periodic orbits have potential applications for the missions requiring long-term continuous observation of the secondary and tour missions in a multi-body environment.},
  langid = {english},
  keywords = {Distant retrograde orbits,Invariant manifolds,Multiple periodic orbits,Resonance transitions},
  annotation = {titleTranslation: 圆型限制性三体问题中的共振跃迁周期轨道\\
abstractTranslation: 本研究聚焦于圆型限制性三体问题中的一类特殊地月空间周期轨道，即共振过渡周期轨道。该类轨道在单一周期内于不同共振态之间切换，并环绕次级天体形成多圈运动。实际计算中，首先识别多圈周期轨道族，随后提取不稳定多圈周期轨道的不变流形，构建共振同宿连接，并以此作为初始猜测，通过多重打靶法求解期望的周期轨道。所得轨道在需长期连续观测次级天体的任务以及多体环境中的巡回探测任务中具有潜在应用价值。},
  file = {/home/ouyangjiahong/Zotero/storage/9BC2PB5F/Lei和Xu - 2018 - Resonance transition periodic orbits in the circular restricted three-body problem.pdf}
}

@article{LeiShaoHuaJiYuDuoChiDuTeZhengQianYiXueXiDeTiShengJiGuanJianBuJianGuZhangZhenDuanJiShu2025,
  title = {{基于多尺度特征迁移学习的提升机关键部件故障诊断技术}},

@phdthesis{faheyDesignStrategiesLow2024,
  title = {Design Strategies for Low Thrust Transfers in the {{Earth-moon}} System},
  author = {Fahey, Liam V.},
  year = 2024,
  journal = {ProQuest Dissertations and Theses},
  abstract = {The increased interest in deep space missions is creating an increased interest in cislunar space. The need for fast and efficient methods of traversing the lunar vicinity increases as more spacecraft enter the region. This investigation discusses methods of low thrust transfer design in order to create low cost and low time of flight transfers. Indirect optimization is employed to compute minimum energy and minimum fuel transfers in the circular restricted three body problem. Sigmoid smoothing techniques are leveraged to approximate the optimal bang-coast-bang solution with continuous functions. The minimum fuel solution is employed as an initial guess to target an inertially fixed thrust direction transfer. This process is applied to a variety of cislunar orbital transfer problems. Transfers are constructed between orbits in the L1halo, L2halo, distant retrograde, and L4short period orbit families. The resulting trajectories are compared to impulsive and free transfers from the literature based on the required propellant mass and time of flight.},
  isbn = {979-8-3468-2918-8},
  langid = {english},
  keywords = {0590:Planetology,0790:Systems science,0791:Energy,Cost control,Energy,Engines,Gravity,Moon,Orbits,Planetology,Space telescopes,System theory,Systems science},
  annotation = {titleTranslation: 地月系统低推力转移轨道设计策略},

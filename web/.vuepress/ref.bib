@article{zhouFuelOptimalMultiImpulseOrbit2020,
  title = {Fuel-{{Optimal Multi-Impulse Orbit Transfer Using}} a {{Hybrid Optimization Method}}},
  author = {Zhou, Hongyu and Wang, Xiaogang and Cui, Naigang},
  year = 2020,
  month = apr,
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  volume = {21},
  number = {4},
  pages = {1359--1368},
  issn = {1524-9050, 1558-0016},
  doi = {10.1109/TITS.2019.2905586},
  urldate = {2025-09-25},
  abstract = {For the N-impulse transfer between two earth orbits, this paper introduces N - 1 intermediate orbits to describe the orbit transfer scheme. The eccentricity vector of the intermediate orbits and the true anomalies corresponding to the impulsive points are chosen as the optimization variables. Based on the patched conic theory, candidate solution can be analytically derived, constraints are removed from the optimization model, and the original problem is converted to a parameter optimization problem. The only difficulty lies in the initialization because the number of optimization variables increases linearly with N, which can be very large. This is settled by a hybrid optimization algorithm that comprises two searching methods. The problem is solved first by an improved particle swarm optimization method and, then, by an adaptive conjugate gradient method. The proposed method is adaptive to problems with any finite N and can calculate the optimal N in any transfer scenarios. The simulation validates the proposed method with some well-known cases and demonstrates its adaptation to N.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  annotation = {titleTranslation: 基于混合优化方法的燃料最优多脉冲轨道转移\\
abstractTranslation: 对于地球轨道之间的N次脉冲转移，本文引入了N-1个中间轨道来描述轨道转移方案。选择中间轨道的偏心率向量以及脉冲点对应的真近点角作为优化变量。基于拼接圆锥曲线理论，可解析推导出候选解，从而将约束条件从优化模型中移除，原问题转化为参数优化问题。唯一的难点在于初始化，因为优化变量的数量随N线性增长，可能非常大。通过一种包含两种搜索方法的混合优化算法解决了该问题。首先采用改进的粒子群优化方法求解，然后使用自适应共轭梯度法。所提方法适用于任意有限N的问题，并能在任何转移场景下计算最优N。仿真通过一些经典案例验证了所提方法，并展示了其对N的适应性。},
  file = {/home/ouyangjiahong/Zotero/storage/JBH6QF5M/Zhou 等 - 2020 - Fuel-Optimal Multi-Impulse Orbit Transfer Using a Hybrid Optimization Method.pdf}
}


  pages = {339--367},
  issn = {1572-9478},
  doi = {10.1007/s10569-016-9698-8},
  urldate = {2026-01-01},
  abstract = {This paper is devoted to the study on applying numerical techniques to accurately compute and robustly extend the libration point orbits (LPOs). A new methodology is proposed exploiting the hyperbolic dynamics of the collinear libration points. Numerical tools are developed to facilitate the efficient computation process, which are applicable to realistic force models and inherently parallelizable. Extensive numerical explorations in the Earth--Moon system are carried out, revealing the delicate structures of nested island chains and bounded chaotic motions on the center manifold. Numerical results confirm that the proposed approach can handle the computations of various types of LPOs in a unified manner and is operational over a wide range of energy levels. LPOs obtained with this approach offer a broad range of future mission possibilities in an extended vicinity of the collinear libration points.},
  langid = {english},
  keywords = {Center manifold,Libration point orbit (LPO),Quasi-periodic orbit,Restricted three body problem},
  annotation = {titleTranslation: 一种生成与延拓共线平动点轨道的通用方法\\
abstractTranslation: 本文致力于研究应用数值技术精确计算并稳健延拓平动点轨道。我们提出了一种新方法，该方法利用共线平动点的双曲动力学特性。研究开发了适用于实际力模型且具备内在并行化特性的数值工具，以提升计算效率。在地月系统中开展的大量数值探索揭示了中心流形上嵌套岛链的精细结构与有界混沌运动。数值结果证实，所提方法能以统一方式处理各类平动点轨道的计算，并在较宽能量范围内保持有效。通过该方法获得的平动点轨道为共线平动点扩展邻域内的未来任务规划提供了广泛可能性。},
  file = {/home/ouyangjiahong/Zotero/storage/X7WZANC6/Zhang和Li - 2016 - A general method for the generation and extension of collinear libration point orbits.pdf}
}


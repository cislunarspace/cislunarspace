  author = {{方驰}},
  year = 2023,
  abstract = {随着航空航天技术与跟踪制导技术的不断发展，隐蔽与非隐蔽、对抗与非对抗等问题应运而生。普通的卫星轨道机动参数会被时刻侦测，一般制导律作用下的轨道特点也都比较容易探测，因此隐蔽制导技术得到广泛使用。其本意为拦截飞行器通过类似于蛇形机动或轨道机动的隐蔽技术，改变其在原有制导律作用下的运行轨迹，达到命中目标同时隐蔽自身的目的。随着目标机动性和防御能力不断提高，追踪飞行器更易被敌方雷达探测，空间飞行器的拦截交会制导问题变得更加复杂和困难。因此研究拦截目标卫星的隐蔽制导问题对于提升制导性能以及生存性能都是很有必要的。　　本文首先介绍隐蔽与非隐蔽的概念及研究现状，并叙述两者的联系和区别，给出隐蔽飞行的重要性。然后结合空间飞行器拦截目标的轨道动力学特性，建立研究空间隐蔽制导需要用到的坐标系。并在此基础上推导出基于C-W（Clohessy-Wiltshire）方程的隐蔽中制导轨道交会模型，以及隐蔽末制导段飞行器和目标的相对运动模型。　　其次，基于空间隐蔽交会任务，给出空间隐蔽拦截的总体任务规划。然后分析隐蔽轨道的概念和特点，并对传统空间C-W速度脉冲制导、比例导引以及滑模变结构导引律进行分析，给出制导律选取准则。最后将整体研究规划为隐蔽轨道交会的中制导以及隐蔽末制导两阶段，分别进行隐蔽制导律设计。　　接着，提出了一种基于隐蔽轨道交会的隐蔽中制导策略。该制导律应用了霍曼转移轨道的燃料最优性特点，并结合了近程空间交会中使用的C-W脉冲制导方法，利用速度脉冲制导以及霍曼轨道的最优性，通过施加多个脉冲形成多段隐蔽轨道，实现飞行器隐蔽导引至目标卫星处。　　最后，基于末段隐蔽制导提出了一种空间拦截末段隐蔽滑模制导律。该隐蔽制导律的创新在于提高命中敌方概率的同时提高了生存性能。首先设计滑模制导律来拦截目标卫星，将视线倾角和偏角设计成两个切换面函数，并最终让两个视线角趋向于零值，实现成功拦截目标卫星的任务。同时在滑模面设计时将饱和函数应用于控制函数中，很好地削弱了输出抖振，提高了制导效果。之后对主动蛇形机动与滑模制导律进行一体化设计，仿真验证了隐蔽末制导律的突防效果，不仅能让自身隐蔽飞行，提高突防生存的能力，而且能实现与目标交会。},
  school = {南京理工大学},
  file = {/home/ouyangjiahong/Zotero/storage/SV9TNUDN/方驰 - 2023 - 空间飞行器交会隐蔽制导问题研究.pdf}
}

@article{FangHaiYanQueQiaoTongDaoYaoXingZuoXiTongYuMaiChongXingLianHeDaoHangYanJiu2025,
  title = {{``鹊桥''通导遥星座系统与脉冲星联合导航研究}},
  author = {{方海燕} and {刘益君} and {李小平} and {赵取同} and {张力} and {何熊文} and {陈朝基} and {钟兆丰}},
  year = 2025,
  journal = {深空探测学报（中英文）},
  volume = {12},
  number = {4},
  pages = {391--403},
  urldate = {2026-05-18},
  abstract = {针对地月空间航天器高精度导航对地面测控依赖强等问题，提出一种融合X射线脉冲星与``鹊桥''星座信息的高精度导航方法。通过耦合X射线脉冲星观测数据与``鹊桥''通导遥星座提供的航天器测距信息，结合地月空间轨道动力学模型，构建了``鹊桥''星座-脉冲星联合导航观测模型，分析了环月轨道与地月L1平动点Halo轨道的导航精度。仿真结果表明，与传统X射线脉冲星导航（X-ray Pulsar-based NAVigation,XPNAV）相比，两种轨道的位置精度分别由1.73 km、2.10 km提升至187 m、236 m，分别提升了90.11\%、88.73\%。所提的联合导航方法显著提升了导航定位性能，可为地月空间资源开发等任务的导航应用提供理论参考与技术支撑。},
  langid = {chinese},
  keywords = {,"",X},
  annotation = {Fund: 民用航天技术预先研究项目（D040102）；},
  file = {/home/ouyangjiahong/Zotero/storage/AT62CGZ3/方海燕 等 - 2025 - “鹊桥”通导遥星座系统与脉冲星联合导航研究.pdf}
}

@phdthesis{FangHaoKongJianNaoXingFeiXingQiZiTaiYinShenKongZhiFangFaDeYanJiu2020,
  type = {硕士},
  title = {空间挠性飞行器姿态隐身控制方法的研究},
  author = {{房浩}},
  year = 2020,
  abstract = {随着雷达探测技术的不断发展,雷达探测距离和精度的不断提高,以及雷达组网系统的不断完善,在现代战争攻防对抗中,相应的,飞行器想要躲避雷达的探测,就需要更高的隐身性能。本文探讨在已知发射点位置以及三部雷达位置的背景下,建立所需的基本坐标系,引入飞行器与雷达视线偏角的概念,通过这个视线偏角给出飞行器隐身的限定条件,然后根据三余弦定理,写出视线偏角的水平分量和竖直分量,通过坐标系的转换关系将视线偏角分量引入其中可以得到方程组。坐标系的转换关系主要包括空间飞行器、发射点以及雷达探测系统之间的转换关系。其中雷达视线在弹体坐标系的投影关系中,引入视线偏角分量,建立出非线性方程组,然后通过Newton迭代法求解此非线性方程组,求得飞行器相对于第一部雷达的姿态角,进一步求得相对于第二部、第三部雷达的姿态角以及相对于发射点惯性系的姿态角。同时,根据求得的姿态角,反求出飞行器相对于三部雷达的实现偏角值,验证实现偏角是否处在限定的隐身范围内。在现代战争中,飞行器的更新换代,为了达到打赢现代战争的目的,对飞行器的隐身性能、速度、精度射程以及机动性提出了更高的要求,而这些要求都指向了飞行器具有大长径比的特点。本文以长径比为40的空间飞行器为研究对象,考虑安装在飞行器机身上的惯性元件由于挠性振动,影响姿态角的测量精度,从而影响控制系统的稳定性和控制精度。本文首先给出刚体飞行器的动力学方程以及运动学方程建立刚体飞行器的模型,然后基于有限元分析理论,将飞行器简化为简单梁模型,取微元进行受力分析,对于空间中飞行器的挠性效应对姿态角的影响,本文只考虑空间中姿控发动机的推力,并基于此推力,采用假设模态法建立挠性模型,最后将挠性振动转换为附加姿态角,并对其进行仿真。本文基于四元数,选用PD控制律作为控制策略,引入误差四元数,建立了误差四元数运动学方程,进一步设计了姿态跟踪PD控制器,然后采用脉宽调制(PWM)方法设计了PD控制律下姿控发动机的开关逻辑,对飞行器进行弹道仿真并进行分析对比,最后验证了挠性效应对飞行器的影响、飞行器隐身效果的有效性和PD控制律的有效性。},
  school = {哈尔滨工业大学},
  keywords = {;;PD},
  file = {/home/ouyangjiahong/Zotero/storage/268HFRDP/房浩 - 2020 - 空间挠性飞行器姿态隐身控制方法的研究.pdf}
}

@article{FangLiuDiYueLiBiaoWuChaiDuiGongXianPingDongDianZhouQiGuiDaoDeWuChaiYingXiangFenXi2024,
  title = {{地月历表误差对共线平动点周期轨道的误差影响分析}},

@inproceedings{tatay-sanguesaRobustMultiobjectiveTrajectory2021,
  title = {Robust Multi-Objective Trajectory Optimization in the {{CR3BP}}},
  booktitle = {{{IAF Astrodynamics Symposium}} 2021 at the 72nd {{International Astronautical Congress}}, {{IAC}} 2021},
  author = {{Tatay-Sanguesa}, Jose and Wiegand, Andreas and Noomen, Ron},
  year = 2021,
  address = {Dubai},
  abstract = {Orbital mission analysis is an iterative procedure in which several solutions are tested until the one that better fulfils mission objectives is selected. With new missions in the Circular Restricted Three-Body Problem (CR3BP) becoming more frequent, the mission analysis process for trajectories within this model must be improved. So far, most of the research efforts have been devoted to finding the most accurate optimization algorithm for a particular problem, mainly related to the Gateway mission. However, this study presents a novel approach whose aim is to improve the initial phase of mission design by providing a multitude of optimal solutions that cover most of the trajectory possibilities. Moreover, this should be performed without an initial guess input from the user, nor any kind of previously known solution, so that it can be applied to all kinds of problems. To do so, the proposed research performs a multi-objective optimization on direct, manifold and flyby transfers and places the non-dominated solutions in a Pareto front. In this way, the user can easily choose which solution better meets their requirements in terms of {$\Delta$}V and time of flight. Once the solution is chosen, it can used as a first guess for a further optimization with the Analysis, Simulation and Trajectory Optimization Software (ASTOS), which increases the accuracy and reliability of the results, by being verified in a higher fidelity model. To achieve this purpose, the tool has been carefully designed, selecting the design variables that with the least amount of information, completely define the full trajectories. Then, a mixed integer distributed ant colony optimizer (MIDACO) is used to find the best solutions. The results obtained include two sample cases. First a LEO to L2 southern Halo orbit and then a GTO to 9:2 resonant L2 NRHO, all in the Earth-Moon system. For all cases, a populated Pareto front with dozens of optimal solutions, was obtained and a single trajectory solution was selected for representation purposes.},
  langid = {english},
  annotation = {titleTranslation: CR3BP中的鲁棒多目标轨迹优化}
}

@article{tengAutonomousOrbitDetermination2025,
  title = {Autonomous Orbit Determination, Timekeeping and Service Performance Analysis of the Cislunar Space Navigation System Based on Special Long-Period Orbits},
  author = {Teng, Yuehao and Xu, Bo and Gao, Youtao and Liu, Jingxi and Li, Xin},
  year = 2025,
  journal = {Measurement: Journal of the International Measurement Confederation},
  volume = {Vol.255},
  pages = {118005},
  abstract = {The Special Long-Period Orbit (SLPO), due to its flexible three-body orbital dynamics and coverage characteristics of cislunar space, provides a promising platform for placing navigation satellites to offer navigation services for spacecraft within the Earth-Moon system. In this study, we focus on the Cislunar Space Navigation System (CSNS) and, leveraging the gravitational asymmetry near the libration points of cislunar space, we investigate the autonomous navigation and time synchronization of 34 satellites within the system. Additionally, a comprehensive assessment of CSNS service performance is conducted. The autonomous navigation process of the CSNS system utilizes dual one-way ranging data between satellites as the observation input and applies the classical extended Kalman filter to jointly estimate the orbital states (position and velocity) of the constellation's satellites as well as the spaceborne clock states. In addition to assessing the overall performance of CSNS, we also evaluate the signal characteristics and visibility within Lunar Transfer Orbit (LTO). Finally, the navigation and timing performance of LTO spacecraft utilizing CSNS is analyzed. The experimental results demonstrate that the autonomous orbit determination position accuracy of CSNS exceeds 30 m, with time synchronization errors within 3 ns. For spacecraft navigation using CSNS, the minimum number of visible satellites is 10, with orbit determination accuracy better than 50 m and timing accuracy better than 10 ns. This study provides valuable reference for the construction of autonomous cislunar navigation constellations and the transfer of spatiotemporal references, as well as for performance assessment of navigation systems.},
  langid = {english},
  keywords = {Autonomous navigation,Cislunar space,Inertial navigation systems,Inter-satellite link,Orbital transfer,Satellite imagery,Space platforms,Special long-period orbit,Time synchronization},
  annotation = {titleTranslation: 基于特殊长周期轨道的地月空间导航系统自主定轨、守时与服务性能分析\\
abstractTranslation: 特殊长周期轨道（SLPO）凭借其灵活的三体轨道动力学特性以及对地月空间的覆盖能力，为部署导航卫星以服务地球-月球系统内航天器提供了理想平台。本研究聚焦于地月空间导航系统（CSNS），利用地月空间平动点附近的引力不对称性，研究了该系统内34颗卫星的自主导航与时间同步问题，并对CSNS的服务性能进行了全面评估。CSNS系统的自主导航过程以卫星间的双向单程测距数据作为观测输入，采用经典扩展卡尔曼滤波对星座卫星的轨道状态（位置与速度）以及星载时钟状态进行联合估计。除了评估CSNS整体性能外，我们还分析了月球转移轨道（LTO）内的信号特征与可见性，最后研究了利用CSNS的LTO航天器的导航与授时性能。实验结果表明，CSNS的自主定轨位置精度优于30米，时间同步误差在3纳秒以内。对于使用CSNS的航天器导航，最小可见卫星数为10颗，定轨精度优于50米，授时精度优于10纳秒。本研究为自主地月导航星座的构建、时空基准的传递以及导航系统性能评估提供了有价值的参考}
}

@article{tengAutonomousTimeSynchronization2025,
  title = {Autonomous Time Synchronization Scheme Design for Cislunar Space Navigation System},
  author = {Teng, Yuehao and Xu, Bo and Gao, Youtao and Hu, Chaoyong and Li, Xin and Liu, Yang},
  year = 2025,
  month = may,
  journal = {Advances in Space Research},
  volume = {75},
  number = {10},
  pages = {7345--7364},
  issn = {02731177},
  doi = {10.1016/j.asr.2025.02.044},
  urldate = {2025-09-25},
  abstract = {A cislunar space navigation system (CSNS), constructed based on halo orbits and special long-period orbits (SLPO) near the EarthMoon L1 libration point, promises significant augmentations in the positioning, navigation, and timing (PNT) services. The cornerstone of CSNS lies in the autonomous time synchronization and clock frequency stability of SLPO satellites. In this study, an autonomous time synchronization scheme is proposed utilizing libration point navigation satellites as ``space-based tracking stations'' to establish intersatellite links (ISLs) with SLPO satellites and integrate X-ray pulsar timing data, thus achieving satellite time synchronization and frequency stability. By simulating high-fidelity X-ray photon timestamps and precise inter-satellite ranging data as raw measurement data, we implemented orbit determination and time synchronization for SLPO satellites using an extended Kalman filter (EKF). Additionally, we propose the onboard Vondrak-Cepek joint timing algorithm, which fully exploits the long-term stability of pulsars and the short-term stability of atomic clocks. Experimental results demonstrate that SLPO satellites equipped with high-stability and low-stability atomic clocks achieve timing precisions of 20 ns and 100 ns, respectively. Although the integration of X-ray pulsar data increases system complexity, it enhances the stability of the timing reference. The onboard joint ensemble timescale generated by the timing algorithm exhibits an order of magnitude improvement over the pulsar timescale in the short term, and maintains enhancements of 1 and 3 orders of magnitude in the long term compared to the two atomic time scales, the high-stability and the low- stability, respectively. This autonomous time synchronization scheme fully leverages the stability of pulsars and atomic clocks and can be applied to space time transfer services in similar contexts.},
  langid = {english},
  keywords = {Atomic clocks,Bandpass filters,Cislunar space navigation system,Communication satellites,Frequency stability,Kalman filters,Pulsars,Satellite navigation aids,Time measurement,Time synchronization,Tropics,Vondrak-Cepek filter,X-ray pulsars Inter-satellite link},
  annotation = {titleTranslation: 地月空间导航系统自主时间同步方案设计\\
abstractTranslation: 一个基于地月L1平动点附近的晕轨道和特殊长周期轨道（SLPO）构建的地月空间导航系统（CSNS），有望显著增强定位、导航与授时（PNT）服务。CSNS的基石在于SLPO卫星的自主时间同步与时钟频率稳定性。本研究提出了一种自主时间同步方案，利用平动点导航卫星作为``天基跟踪站''，与SLPO卫星建立星间链路，并融合X射线脉冲星计时数据，从而实现卫星时间同步与频率稳定。通过模拟高保真X射线光子时间戳和精确星间测距数据作为原始观测数据，我们采用扩展卡尔曼滤波（EKF）实现了SLPO卫星的定轨与时间同步。此外，我们提出了星载Vondrak-Cepek联合计时算法，该算法充分利用了脉冲星的长期稳定性与原子钟的短期稳定性。实验结果表明，配备高稳定性和低稳定性原子钟的SLPO卫星分别实现了20纳秒和100纳秒的计时精度。尽管融合X射线脉冲星数据增加了系统复杂度，但提升了计时参考的稳定性。该计时算法生成的星载联合综合时间尺度在短期内相较于脉冲星时间尺度提升了一个数量级，在长期内相较于高稳定性和低稳定性两种原子时间尺度分别保持了1个和3个数量级的提升。该自主时间同步方案充分利用了脉冲星与原子钟的稳定性，可应用于类似场景中的空间时间传递服务},
  file = {/home/ouyangjiahong/Zotero/storage/EY6X7ZQ9/Teng 等 - 2025 - Autonomous time synchronization scheme design for cislunar space navigation system.pdf}
}


@article{wangDebrisCloudEvolution2025,
  title = {Debris Cloud Evolution in Cislunar Space Using Eulerian Perspective Method},
  author = {Wang, Haiyi and Yang, Zhen and Guo, Xiang},
  year = 2025,
  month = jan,
  journal = {IFAC-PapersOnLine},
  series = {23th {{IFAC Symposium}} on {{Automatic Control}} in {{Aerospace ACA}} 20255},
  volume = {59},
  number = {20},
  pages = {168--173},
  issn = {2405-8963},
  doi = {10.1016/j.ifacol.2025.11.144},
  urldate = {2025-12-20},
  abstract = {The competition among space-faring nations for resources in the Cislunar space will inevitably lead to an increase in the number of space objects in this region, and the risk of spacecraft disintegration events is also growing. The paper proposes a debris cloud evolution analysis method based on the Eulerian viewpoint for the Cislunar space. The method is based on the Earth-Moon space four-body dynamics model using the homotopy iterative approach to solve the Cislunar space margin problem to obtain the debris probability density at the location to be analyzed. This method accurately provides the probability density distribution of debris clouds near specific analysis points and avoids the need for selecting a large number of sample points, thereby efficiently computing the evolution of debris clouds in the Cislunar space. This paper applies the proposed method to analyze the probability density distribution of debris clouds generated from spacecraft disintegration at different Earth-Moon Lagrange points. Furthermore, a Monte Carlo analysis is conducted on these cases and compared with the simulation results of the proposed method. The relative error is found to be below 10\%, validating the correctness of using the method presented in this paper to calculate the probability density distribution of debris clouds in the Cislunar space.},
  langid = {english},
  keywords = {Cislunar space,Debris cloud evolution,Density distribution of disintegrated debris,Disintegrated debris cloud,Orbital boundary value problem},
  annotation = {abstractTranslation: 各国在近月空间资源上的竞争，必然导致该区域空间物体数量增加，航天器解体事件的风险也随之上升。本文提出一种基于欧拉视角的近月空间碎片云演化分析方法。该方法以地月空间四体动力学模型为基础，采用同伦迭代法求解近月空间边界问题，从而获得待分析位置处的碎片概率密度。该方法能精确给出特定分析点附近的碎片云概率密度分布，避免了选取大量样本点的需求，从而高效计算近月空间碎片云的演化过程。本文应用所提方法，分析了不同地月拉格朗日点航天器解体产生碎片云的概率密度分布，并针对这些案例开展蒙特卡洛分析，与所提方法的仿真结果进行对比。相对误差低于10\%，验证了使用本文方法计算近月空间碎片云概率密度分布的正确性。\\
titleTranslation: 基于欧拉视角方法的近地-月球空间碎片云演化研究},
  file = {/home/ouyangjiahong/Zotero/storage/YULCL2EM/Wang 等 - 2025 - Debris cloud evolution in cislunar space using eulerian perspective method.pdf}
}


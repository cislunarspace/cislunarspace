@article{olivierCombinationDirectMethods2019,
  title = {Combination of {{Direct Methods}} and {{Homotopy}} in {{Numerical Optimal Control}}: {{Application}} to the {{Optimization}} of {{Chemotherapy}} in {{Cancer}}},
  author = {Olivier, Antoine and Pouchol, Camille},

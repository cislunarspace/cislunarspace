@article{klonowskiOptimalCislunarArchitecture2023,
  title = {Optimal {{Cislunar Architecture Design Using Monte Carlo Tree Search Methods}}},
  author = {Klonowski, Michael and Holzinger, Marcus J. and Fahrner, Naomi Owens},
  year = 2023,
  month = jun,
  journal = {Journal of Astronautical Sciences},
  volume = {70},
  number = {3},
  pages = {17},
  issn = {2195-0571},
  doi = {10.1007/s40295-023-00383-x},
  urldate = {2026-01-31},
  abstract = {A novel multi-objective Monte Carlo Tree Search (MO-MCTS) algorithm is developed and implemented for use in architecture design problems. This algorithm is used with two well-known problems with known solutions in order to verify its performance. It is then used in a highly nonlinear Cislunar architecture design problem with no known analytical solutions. The results of this implementation display the ability of MO-MCTS to effectively navigate the state space of mixed integer nonlinear programming problems and emphasize the versatility of MO-MCTS for designing critical Cislunar architecture.},
  langid = {english},
  keywords = {Cislunar architecture,Monte Carlo Tree Search,Reinforcement learning,Space domain awareness},
  annotation = {titleTranslation: 基于蒙特卡洛树搜索方法的月地空间最优架构设计\\
abstractTranslation: 我们开发并实现了一种新颖的多目标蒙特卡洛树搜索（MO-MCTS）算法，用于解决架构设计问题。该算法首先应用于两个已知解决方案的经典问题以验证其性能，随后被用于一个高度非线性的地月空间架构设计问题------该问题目前尚无已知的解析解。实施结果表明，MO-MCTS能够有效遍历混合整数非线性规划问题的状态空间，并凸显了其在设计关键地月空间架构方面的多功能性。},
  file = {/home/ouyangjiahong/Zotero/storage/4CFKM8MX/Klonowski 等 - 2023 - Optimal Cislunar Architecture Design Using Monte Carlo Tree Search Methods.pdf;/home/ouyangjiahong/Zotero/storage/GMNH73JN/Klonowski 等 - 2023 - Optimal cislunar architecture design using monte carlo tree search methods.pdf}
}


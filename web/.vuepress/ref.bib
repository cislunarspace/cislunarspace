@article{scheeresBoundsEnergyAngular2023,
  title = {Bounds on Energy and Angular Momentum Loss in the Full N-Body Problem},
  author = {Scheeres, D. J. and Brown, G. M.},
  year = 2023,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {3},
  pages = {35},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10148-1},
  urldate = {2025-10-01},
  abstract = {A new bound on the amended potential in an n-body system is derived and applied to the partitioning of energy and angular momentum in a disrupting gravitational aggregate. This result provides analytic insight into how energy and angular momentum can be lost or partitioned between different collections of bodies as they escape from each other. To better understand the possible outcomes in such a situation, some specific numerical tests are also performed for systems of N = 3, 4, 5, 6. The results confirm that disrupting systems always lose energy, with a characteristic stochastic distribution of the lost energy. We also find that the system loses most of its angular momentum, although individual escaping components can retain significant nonzero angular momentum vectors that can be uniformly distributed in space as the number of bodies in the system increases.},
  langid = {english},
  annotation = {titleTranslation: 全n体问题中能量和角动量损失的界。\\
abstractTranslation: 一个新的关于n体系统中修正势能的界被推导出来，并应用于解释瓦解引力聚合体中能量与角动量的划分。该结果提供了分析性见解，揭示了当不同天体集合相互逃逸时，能量和角动量如何损失或在这些集合之间进行分配。为了更好地理解此类情况下可能出现的结局，我们还针对N=3、4、5、6的系统进行了具体的数值测试。结果证实，瓦解系统总是会损失能量，且损失的能量呈现特征性的随机分布。我们还发现，系统会损失大部分角动量，但单个逃逸组分可能保留显著的、非零的角动量矢量，并且随着系统内天体数量的增加，这些矢量的方向在空间中趋于均匀分布。},
  file = {/home/ouyangjiahong/Zotero/storage/HQWCBIAI/Scheeres和Brown - 2023 - Bounds on energy and angular momentum loss in the full n-body problem.pdf}
}


@article{zhaoAnalyticalInvestigationLonglifetime2024,
  title = {Analytical Investigation about Long-Lifetime Science Orbits around Galilean Moons},
  author = {Zhao, Shunjing and Lei, Hanlun and Ortore, Emiliano and Circi, Christian and Liu, Jingxi},
  year = 2024,
  month = apr,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {2},
  pages = {14--36},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10183-6},
  urldate = {2025-10-01},
  abstract = {It is desirable to design low-altitude and near-polar science orbits for missions to Galilean moons. However, the long-term perturbation from a distant perturber may lead such a kind of orbits to quick impacts, indicating that initial conditions of working orbits need to be welldesigned. To this end, long-lifetime working orbits around oblate satellites are investigated in this work. Initially, numerical maps of lifetime around oblate satellites are produced under the long-term dynamical model and they show that initial conditions of long-lifetime orbits are distributed in the form of strips in the space spanned by initial longitude of ascending node and argument of pericenter. This phenomenon is known to be caused by the effect of nodal phasing due to the existence of the mother planet's obliquity. To understand the mechanism of nodal phasing, we adopt Lie-series transformation to formulate an integrable Hamiltonian model, where the dynamical structures in phase space can be uncovered by phase portraits. Furthermore, we provide three constraints for solving the initial conditions of long-lifetime orbits: the first one states that the Hamiltonian of long-lifetime orbits should be equal to that of the stable manifold, the second and third ones are associated to given initial eccentricity and inclination. By solving these constraint equations and performing direct transformation, analytical strips are produced. It is shown that the analytical and numerical strips are in good agreement. At last, the analytical approach is applied to missions to Galilean moons.},
  langid = {english},
  annotation = {titleTranslation: 围绕伽利略月球的长寿命科学轨道的分析研究。\\
abstractTranslation: 为伽利略卫星任务设计低高度近极地科学轨道是理想的。然而，来自远距离摄动体的长期摄动可能导致此类轨道快速撞击，这意味着工作轨道的初始条件需要精心设计。为此，本文研究了围绕扁率卫星的长寿命工作轨道。首先，在长期动力学模型下生成了扁率卫星周围的寿命数值地图，结果显示长寿命轨道的初始条件在初始升交点经度和近心点幅角张成的空间中呈条带分布。已知这一现象是由母行星倾角引起的节点定相效应所致。为理解节点定相机制，我们采用李级数变换构建了一个可积哈密顿模型，通过相图可揭示相空间中的动力学结构。此外，我们提供了三个求解长寿命轨道初始条件的约束：第一个约束要求长寿命轨道的哈密顿量等于稳定流形的哈密顿量；第二、三个约束分别与给定的初始偏心率和倾角相关。通过求解这些约束方程并进行直接变换，得到了解析条带。结果表明解析条带与数值条带吻合良好。最后，将解析方法应用于伽利略卫星任务},
  file = {/home/ouyangjiahong/Zotero/storage/SUDMML48/Zhao 等 - 2024 - Analytical investigation about long-lifetime science orbits around galilean moons.pdf}
}

@article{zhaoAutonomousCelestialNavigation2013,
  title = {Autonomous Celestial Navigation and Analysis of Precision for Spacecraft on Halo Orbit near {{L2}} Point of Sun-Earth System},
  author = {Zhao, Shu-Ge and Zhang, Jing-Rui and Zhang, Yao},
  year = 2013,
  journal = {Beijing Ligong Daxue Xuebao/Transaction of Beijing Institute of Technology},
  volume = {Vol.33},
  number = {No.11},
  pages = {1119--1123,1139},
  issn = {1001-0645},
  abstract = {For the spacecraft in Halo orbits around L\textsubscript{2} point in Sun-Earth system, firstly, the kinematics equation of spacecraft in initial frame and rotating frame (and celestial navigation model whose measurement is starlight angle were presented. Secondly, the celestial navigation model whose measurement is starlight angle was established; thirdly, an extended Kalman filter (EKF) algorithm was used to estimate of the position of the spacecraft; finally, the performance of the system using different kinds of statement and measurement was analyzed based on the Cram\'er-Rao low bound method. Simulation results show that some factors that influence largely on the precision of position estimation are pointed, which includes navigation coordinate system, the major celestial body, the number of observing the stars and filter observation time. The results of the above factors impacting on the precision of celestial navigation are analyzed based on libration point orbit kinematic characteristics.},
  langid = {english},
  keywords = {Celestial navigation,Extanded Kalman filter,Halo orbit,Libration points,Precision analysis},
  annotation = {titleTranslation: 日地系统L2点附近晕轨道航天器自主天文导航及精度分析\\
abstractTranslation: 对于日地系统中L\textsubscript{2}点附近晕轨道上的航天器，首先给出了航天器在初始坐标系和旋转坐标系下的运动学方程（以及以星光角为测量量的天文导航模型）；其次，建立了以星光角为测量量的天文导航模型；再次，采用扩展卡尔曼滤波（EKF）算法对航天器位置进行估计；最后，基于Cram\'er-Rao下界方法分析了使用不同状态量和测量量的系统性能。仿真结果表明，影响位置估计精度的主要因素包括导航坐标系、主天体、观测恒星数量以及滤波观测时间。结合平动点轨道运动特性，分析了上述因素对天文导航精度的影响结果。}
}


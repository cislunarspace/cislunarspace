@inproceedings{burnettAnalyticApproximationsOrbit2020,
  title = {Analytic Approximations of Orbit Geometry in a Rotating Higher Order Gravity Field},
  booktitle = {{{AAS}}/{{AIAA Astrodynamics Specialist Conference}}, 2019},

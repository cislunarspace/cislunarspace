@article{wangRecentAdvancesBayesian2023,
  title = {Recent Advances in Bayesian Optimization},
  author = {Wang, Xilu and Jin, Yaochu and Schmitt, Sebastian and Olhofer, Markus},
  year = 2023,
  month = dec,
  journal = {ACM Computing Surveys},
  volume = {55},
  number = {13s},
  pages = {1--36},
  issn = {0360-0300, 1557-7341},
  doi = {10.1145/3582078},
  urldate = {2025-11-06},
  abstract = {Bayesian optimization has emerged at the forefront of expensive black-box optimization due to its data efficiency. Recent years have witnessed a proliferation of studies on the development of new Bayesian optimization algorithms and their applications. Hence, this article attempts to provide a comprehensive and updated survey of recent advances in Bayesian optimization that are mainly based on Gaussian processes and identify challenging open problems. We categorize the existing work on Bayesian optimization into nine main groups according to the motivations and focus of the proposed algorithms. For each category, we present the main advances with respect to the construction of surrogate models and adaptation of the acquisition functions. Finally, we discuss the open questions and suggest promising future research directions, in particular with regard to heterogeneity, privacy preservation, and fairness in distributed and federated optimization systems.},
  langid = {english},
  annotation = {titleTranslation: 贝叶斯优化的最新进展\\
abstractTranslation: 贝叶斯优化因其数据效率而成为昂贵黑箱优化领域的前沿方法。近年来，关于新型贝叶斯优化算法及其应用的研究大量涌现。因此，本文旨在对主要基于高斯过程的贝叶斯优化最新进展进行全面且更新的综述，并识别出具有挑战性的开放问题。我们根据所提出算法的动机和关注点，将现有贝叶斯优化研究分为九大类。针对每一类别，我们介绍在代理模型构建和采集函数自适应方面的主要进展。最后，我们讨论开放性问题并指出未来有前景的研究方向，特别是关于分布式与联邦优化系统中的异质性、隐私保护及公平性},
  file = {/home/ouyangjiahong/Zotero/storage/SFRW243S/Wang 等 - 2023 - Recent advances in bayesian optimization.pdf}
}

@article{wangResearchAdvancementsKey2022,
  title = {Research Advancements in Key Technologies for Space-Based Situational Awareness},
  author = {Wang, Beichao and Li, Shuang and Mu, Jinzhen and Hao, Xiaolong and Zhu, Wenshan and Hu, Jiaqian},
  year = 2022,
  month = jan,
  journal = {Space: Science \& Technology},
  volume = {2022},
  pages = {2022/9802793},
  issn = {2692-7659},
  doi = {10.34133/2022/9802793},
  urldate = {2026-05-11},
  abstract = {The space environment has become highly congested due to the increasing space debris, seriously threatening the safety of orbiting spacecraft. Space-based situational awareness, as a comprehensive capability of threat knowledge, analysis, and decision-making, is of significant importance to ensure space security and maintain normal order. Various space situational awareness systems have been designed and launched. Data acquisition, target recognition, and monitoring constituting key technologies make major contributions, and various advanced algorithms are explored as technical supports. However, comprehensive reviews of these technologies and specific algorithms rarely emerge. It disadvantages the future development of space situational awareness. Therefore, this paper further reviews and analyzes research advancements in key technologies for space situational awareness, emphasizing target recognition and monitoring. Many mature and emerging methods are presented for these technologies while discussing application advantages and limitations. Specially, the research prospects of multiagent and synergetic constellation technologies are expected for future situational awareness. This paper indicates the future directions of the key technologies, aiming to provide references for space-based situational awareness to realize space sustainability.},
  copyright = {http://creativecommons.org/licenses/by/4.0/},
  langid = {english},
  annotation = {titleTranslation: 天基态势感知关键技术的研究进展\\
abstractTranslation: 由于空间碎片日益增多，空间环境变得高度拥挤，严重威胁在轨航天器的安全。天基态势感知作为一种涵盖威胁认知、分析与决策的综合能力，对于保障空间安全、维护正常秩序具有重要意义。各类空间态势感知系统已被设计并发射部署。数据采集、目标识别与监视作为关键技术，贡献显著，同时多种先进算法被探索作为技术支撑。然而，针对这些技术与具体算法的全面综述鲜有出现，这不利于空间态势感知的未来发展。因此，本文进一步回顾并分析了空间态势感知关键技术的研究进展，重点关注目标识别与监视。针对这些技术，本文介绍了多种成熟及新兴方法，并讨论了其应用优势与局限性。特别地，多智能体与协同星座技术的研究前景有望用于未来态势感知。本文指出了关键技术未来发展方向，旨在为天基态势感知实现空间可持续性提供参考。}
}


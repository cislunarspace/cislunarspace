@article{greavesAutonomousOpticalonlySpacecrafttospacecraft2023,
  title = {Autonomous Optical-Only Spacecraft-to-Spacecraft Absolute Tracking and Maneuver Classification in Cislunar Space},
  author = {Greaves, Jesse A. and Scheeres, Daniel J.},
  year = 2023,
  month = nov,
  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {46},
  number = {11},
  pages = {2092--2109},
  issn = {0731-5090, 1533-3884},
  doi = {10.2514/1.G007223},
  urldate = {2025-11-27},
  abstract = {Traditional concerns regarding spacecraft state estimation are exacerbated in cislunar space due to highly nonlinear dynamics, limited observational information, and increasingly overloaded Earth-based resources. These challenges motivate research into space-based navigation and observation capabilities that provide opportunities for autonomy. This paper demonstrates that relative optical measurements provide full inertial estimates of an agent and target spacecraft, while simultaneously enabling classification of unknown maneuvers in the cislunar environment. To achieve this objective two subtasks are demonstrated. First, the spacecraft-to-spacecraft absolute tracking method, which estimates the absolute state of two vehicles using relative measurements, is tested for observability and shown to produce consistent filter solutions given optical sensors. Second, maneuver classification is performed by labeling an estimated control profile generated from the optimal control based estimator. Collectively, this sequential methodology enables an agent craft to autonomously navigate itself while observing a target craft and classifying its maneuvers.},
  langid = {english},
  annotation = {titleTranslation: 地月空间仅基于光学信息的航天器自主绝对跟踪与机动分类\\
abstractTranslation: 传统上对航天器状态估计的担忧在地月空间因高度非线性动力学、有限的观测信息以及日益过载的地球资源而加剧。这些挑战促使人们对天基导航与观测能力展开研究，从而为自主性提供机会。本文证明，相对光学测量能够提供主体航天器与目标航天器的完整惯性估计，同时实现对地月环境中未知机动的分类。为实现此目标，本文将演示两个子任务。首先，测试了利用相对测量估计两航天器绝对状态的航天器间绝对跟踪方法的可观测性，并证明其在光学传感器下能产生一致的滤波解。其次，通过标注基于最优控制的估计器生成的估计控制剖面，进行机动分类。综合而言，这一顺序方法使得主体航天器能够在观测目标航天器并对其机动进行分类的同时，进行自主导航。},
  file = {/home/ouyangjiahong/Zotero/storage/548Y4R9E/Greaves和Scheeres - 2023 - Autonomous optical-only spacecraft-to-spacecraft absolute tracking and maneuver classification in ci.pdf}
}

@inproceedings{greavesEstimationStochasticEvents2020,
  title = {Estimation of Stochastic Events for Vehicles in {{NRHOs}}},
  booktitle = {{{AIAA SciTech Forum}} and {{Exposition}}},
  author = {Greaves, Jesse A. and Scheeres, Daniel J.},
  year = 2020,
  address = {Orlando},
  doi = {10.2514/6.2020-0227},
  abstract = {Cislunar space will become densely trafficked due to international interest in the development of a deep space highway. This population boom along with the chaotic dynamics of cislunar travel will result in navigational challenges that demand enhanced observational abilities to manage. To improve cislunar navigation the ballistic Optimal Control Based Estimator (OCBE) can be utilized to identify unmodeled perturbations, and subsequently identified events are used to refine the perturbation models through the Expectation-Maximization (EM) algorithm. Non-traditional observation methods such as relative ranging from other spacecraft, high altitude GPS, and hypothetical Moon-based radar systems are examined to determine if they can appropriately supplement traditional Earth-based radar. These methods and models are then applied to a simulation of a crewed spacecraft placed in a Near Rectilinear Halo Orbit (NRHO) to model NASA's proposed Lunar Gateway. It is shown that the OCBE provides enhanced tracking over the standard Extended Kalman Filter (EKF), and can effectively identify larger perturbations in real-time and smaller perturbations in post-processing. The EM algorithm is then able to refine the perturbation model estimates with information from the OCBE. Finally, it is determined that while Earth-based radar is effective for the desired perturbation detection, adding a lunar radar increases event detectability and reconstruction.},
  langid = {english},
  annotation = {titleTranslation: 近地晕轮轨道中飞行器随机事件的概率估算}
}

@article{grebowDesignOptimalLowthrust2011,
  title = {Design of Optimal Low-Thrust Lunar Pole-Sitter Missions},
  author = {Grebow, Daniel J. and Ozimek, Martin T. and Howell, Kathleen C.},
  year = 2011,
  month = jan,
  journal = {Journal of Astronautical Sciences},
  volume = {58},
  number = {1},
  pages = {55--79},
  issn = {2195-0571},
  doi = {10.1007/BF03321159},
  abstract = {Using a thruster similar to Deep Space 1's NSTAR, pole-sitting low-thrust trajectories are discovered in the vicinity of the L1 and L2 libration points. The trajectories are computed with a seventh-degree Gauss-Lobatto collocation scheme that automatically positions thrusting and coasting arcs, and aligns the thruster as necessary to satisfy the problem constraints. The trajectories appear to lie on slightly deformed surfaces corresponding to the L1 and L2 halo orbit families. A collocation scheme is also developed that first incorporates spiraling out from low-Earth orbit, and finally spiraling down to a stable lunar orbit for continued uncontrolled surveillance of the lunar south pole. Using direct transcription via collocation, the pole-sitting coverage time is maximized to 554.18 days, and the minimum elevation angle associated with the optimal trajectory is 13.0{$^\circ$}.},
  langid = {english},
  annotation = {titleTranslation: 最优低推力月球极轨悬停任务设计\\
abstractTranslation: 使用类似于Deep Space 1的NSTAR推进器，在L1和L2平动点附近发现了极地驻留低推力轨迹。这些轨迹通过七阶Gauss-Lobatto配点法计算，该方法自动定位推力弧段与滑行弧段，并根据问题约束调整推进器方向。轨迹似乎位于对应L1和L2晕轨道族的轻微变形曲面上。还开发了一种配点方案，该方案首先包含从低地球轨道螺旋上升，最后螺旋下降至稳定的月球轨道，以对月球南极进行持续非受控监视。通过配点法的直接转录，极地驻留覆盖时间最大化至554.18天，最优轨迹对应的最小仰角为13.0{$^\circ$}},
  file = {/home/ouyangjiahong/Zotero/storage/2S96D9SK/Grebow 等 - 2011 - Design of optimal low-thrust lunar pole-sitter missions.pdf}
}


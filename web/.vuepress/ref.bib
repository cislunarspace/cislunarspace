@article{boikoParameterTuningSecondorder2006,
  title = {Parameter Tuning of Second-Order Sliding Mode Controllers for Linear Plants with Dynamic Actuators},
  author = {Boiko, I. and Fridman, L. and Iriarte, R. and Pisano, A. and Usai, E.},
  year = 2006,
  month = may,
  journal = {Automatica},
  volume = {42},
  number = {5},
  pages = {833--839},
  issn = {00051098},
  doi = {10.1016/j.automatica.2006.01.009},
  urldate = {2025-09-25},
  abstract = {Tuning of second-order sliding mode control (2-SMC) algorithms in linear systems with dynamic actuators is considered. By means of a describing function (DF) approach, it is investigated how the parameters of a 2-SMC algorithm (the so-called ``generalized sub-optimal'' algorithm) affect the frequency and the magnitude of the limit cycles that occur when the overall relative degree of the plant plus the actuator is three or more. Explicit formulas are given that allow for setting the parameters of the algorithm to obtain a periodic solution with the prescribed characteristics. By means of simulation examples, we show that the estimated chattering parameters are in good agreement with the actual ones. We also show that the proposed design procedure can also be useful when the local linearization of a nonlinear dynamics is sufficiently accurate. 2006 Elsevier Ltd. All rights reserved.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid = {english},
  annotation = {titleTranslation: 线性系统动态执行器二阶滑模控制器参数整定\\
abstractTranslation: 考虑线性系统中带有动态执行器的二阶滑模控制(2-SMC)算法的调谐问题。通过描述函数(DF)方法，研究了2-SMC算法（即所谓的``广义次优''算法）的参数如何影响当被控对象加执行器的整体相对度为三或更高时产生的极限环的频率和幅值。给出了显式公式，允许设置算法参数以获得具有指定特性的周期解。通过仿真示例，我们表明估算的抖振参数与实际参数非常吻合。我们还表明，当非线性动力学的局部线性化足够精确时，所提出的设计方法也是有用的。2006 Elsevier Ltd. 保留所有权利},
  file = {/home/ouyangjiahong/Zotero/storage/KI2I32M5/Boiko 等 - 2006 - Parameter tuning of second-order sliding mode controllers for linear plants with dynamic actuators.pdf}
}

@article{boldrinRotationalMotionNEAs2020,
  title = {On the Rotational Motion of {{NEAs}} during Close Encounters with the {{Earth}}},
  author = {Boldrin, Luiz A. G. and Araujo, Rosana A. N. and Winter, Othon C.},
  year = 2020,
  month = may,
  journal = {European Physical Journal Special Topics},
  volume = {229},
  number = {8},
  pages = {1391--1403},
  issn = {1951-6355, 1951-6401},
  doi = {10.1140/epjst/e2020-900200-5},
  urldate = {2025-11-27},
  abstract = {During their lifetime, the Near-Earth Asteroids (NEAs) suffer numerous close encounters (CE) with Earth, Mars and Venus. It has been demonstrated that gravitational interactions during close planetary encounters can alter an asteroid's spin state, and hence, along with collisions, play a role in the rotational evolution of NEAs. The variation of the rotational angular momentum during the encounters can increase or decrease the rotation rate depending on the initial condition. In addition to the rotation rate, close encounters cause variation in the movement of precession and nutation of the asteroid. Using a numerical model that takes into account the spin-orbit coupling of a body with ellipsoidal shape, the subject of this study is to analyze the rotational motion (rotation, precession and nutation) of asteroids during CE with the Earth for different initial conditions. We computed the variation of the obliquity and the variation of spin period after the CE. We found significant change in obliquity and spin period only in cases with strong encounter, that is in cases that the impact parameter of the encounter (1.2 {$\leq$} d {$\leq$} 7 (Earth radii) and the relative velocity (v) are small. Our results also show that the variation of rotational motion due to the close encounter is capable of tumbling the axis of rotation and gravitational rupture may occur in a few cases.},
  langid = {english},
  annotation = {titleTranslation: 近地小行星在近地遭遇期间的旋转运动研究\\
abstractTranslation: 近地小行星（NEAs）在其生命周期中会经历多次与地球、火星和金星的近距离交会（CE）。研究表明，行星近距离交会过程中的引力相互作用能够改变小行星的自旋状态，因此与碰撞共同对近地小行星的自转演化产生影响。交会期间自转角动量的变化可能根据初始条件增加或减小自转速率。除自转速率外，近距离交会还会引起小行星进动和章动的变化。本研究利用考虑椭球体自旋-轨道耦合的数值模型，针对不同初始条件分析了小行星与地球近距离交会期间的自转运动（自转、进动和章动）。我们计算了交会后倾角与自转周期的变化。仅在强交会情形下------即交会撞击参数（1.2 {$\leq$} d {$\leq$} 7，地球半径）与相对速度（v）均较小时------观测到倾角和自转周期的显著变化。结果还表明，近距离交会引起的自转运动变化足以使自转轴翻滚，在少数情况下可能引发引力破裂。},
  file = {/home/ouyangjiahong/Zotero/storage/XFBUDZYS/Boldrin 等 - 2020 - On the rotational motion of NEAs during close encounters with the Earth.pdf}
}


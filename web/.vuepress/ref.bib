@article{sousa-silvaFastEarthMoon2018,
  title = {Fast Earth--Moon Transfers with Ballistic Capture},
  author = {{Sousa-Silva}, Priscilla and Terra, Maisa O. and Ceriotti, Matteo},
  year = 2018,

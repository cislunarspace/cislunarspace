@inproceedings{parkerLowenergyTransfersDistant2015,
  title = {Low-Energy Transfers to Distant Retrograde Orbits},
  booktitle = {Spaceflight {{Mechanics}} 2015: {{Proceedings}} of the {{AAS}}/{{AIAA}} 25th Space Flight Mechanics Meeting},
  author = {Parker, Jeffrey S. and Bezrouk, Collin J. and Davis, Kathryn E.},

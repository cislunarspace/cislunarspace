@article{yangNaturalNonnaturalClose2023,
  title = {Natural and Non-Natural Close Formation Flight on Distant Retrograde Orbits},
  author = {Yang, Chihang and Fu, Honglan and Zhang, Hao},
  year = 2023,
  journal = {Hangkong Xuebao/Acta Aeronautica Et Astronautica Sinica},
  volume = {Vol.44},
  number = {No.5},
  pages = {229},
  abstract = {Distant Retrograde Orbits（DROs）are a kind of periodic orbits in the Earth-Moon system. DROs are appropriate for long-term missions due to favorable stability. Rendezvous and docking is a basic technology for the supplement of long-term missions，as well as close formation flying for some flying-around tasks. It is thus needed to analyze the close relative motion in DROs and furthermore develop close formation designs. Based on the Floquet theory，a fundamental solution for linear relative dynamics in DROs is obtained. A natural formation is designed based on the natural periodic solution for the linear relative dynamics. Characteristics of the natural formation are analyzed. Moreover，non-natural formations for fast circumnavigate is designed with impulse maneuvers. The fuel consumption of different types of circular reference orbits are analyzed to guide formation designs. Finally，a type of reference trajectories is designed for transfer between two arbitrary positions with safety guaranteed.},
  langid = {english},
  keywords = {circular restricted threebody problem,distant retrograde orbits,Floquet theory,formation design,relative motion},
  annotation = {titleTranslation: 自然与非自然编队飞行在远距离逆行轨道上的实现\\
abstractTranslation: 远距离逆行轨道（DROs）是一种存在于地月系统中的周期性轨道。由于其良好的稳定性，DROs适用于长期任务。交会对接是长期任务补给的关键技术，同时，针对某些绕飞任务，近距离编队飞行也至关重要。因此，有必要分析DROs中的近距离相对运动，并进一步开发近距离编队设计方案。基于Floquet理论，得到了DROs中线性相对动力学的基本解。根据线性相对动力学的自然周期解，设计了一种自然编队，并分析了该编队的特性。此外，针对快速绕飞任务，利用脉冲机动设计了非自然编队。分析了不同类型圆形参考轨道的燃料消耗，以指导编队设计。最后，设计了一类参考轨迹，用于在保障安全性的前提下实现两个任意位置间的转移。}
}


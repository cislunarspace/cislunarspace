@inproceedings{liuLearningbasedOptimalPursuing2024,
  title = {Learning-Based Optimal Pursuing Strategies against Random Orbital Evaders},
  booktitle = {Proceedings of 2023 7th {{Chinese Conference}} on {{Swarm Intelligence}} and {{Cooperative Control}}},
  author = {Liu, Zhaoyang and Liang, Xi and Dang, Zhaohui and Su, Ganghua},
  editor = {Hua, Yongzhao and Liu, Yishi and Han, Liang},
  year = 2024,
  pages = {453--464},
  publisher = {Springer Nature},
  address = {Singapore},
  doi = {10.1007/978-981-97-3324-8_38},
  abstract = {In the realm of one-to-one orbital pursuit-evasion scenarios involving an evader executing erratic maneuvers, this paper introduces an optimal pursuit strategy employing the deep deterministic policy gradient (DDPG) algorithm. We establish a dynamic model, capturing close-range relative motion dynamics and formulating mathematical representations for pursuers and evaders during multiple impulsive maneuvers. Taking into account key considerations of fuel consumption and interception time, we formulate a central cost function that transforms the pursuit-evasion problem into an optimization challenge with intricate constraints. Considering the characteristics of the impulsive maneuver OPEG mission, we develop a representative reward function, collectively training pursuers to predict state changes between consecutive impulsive maneuvers, facilitating the derivation of pursued strategies. Validated through numerical simulations, the results underscore DDPG-trained pursuers' efficacy in apprehending evaders employing random maneuvering tactics, demonstrating the approach's ability to identify effective pursuit strategies within intricate dynamical constraints. This approach empowers pursuers to adapt and employ diverse intercepting tactics, ensuring consistently high success rates within one-to-one orbital pursuit-evasion problems. As research progresses, the application of these strategies holds promise for addressing broader challenges in non-cooperative spacecraft scenarios and beyond.},
  isbn = {978-981-97-3324-8},
  langid = {english},
  keywords = {Artificial intelligence,Deep Deterministic Policy Gradient (DDPG),Impulsive maneuvers,Orbital Pursuit-Evasion Game (OPEG)},
  annotation = {titleTranslation: 基于学习的针对随机轨道逃逸者的最优追击策略},
  file = {/home/ouyangjiahong/Zotero/storage/AKF7T4YP/Liu 等 - 2024 - Learning-based optimal pursuing strategies against random orbital evaders.pdf;/home/ouyangjiahong/Zotero/storage/HKSE3ZS3/Liu 等 - 2024 - Learning-based optimal pursuing strategies against random orbital evaders.pdf}
}


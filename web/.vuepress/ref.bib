@inproceedings{welchMissionConsiderationsDirect2014,
  title = {Mission Considerations for Direct Transfers to a Distant Retrograde Orbit},
  booktitle = {37th {{Annual AAS Rocky Mountain Section Guidance}} and {{Control Conference}}, 2014},
  author = {Welch, Chelsea M. and Parker, Jeffrey S.},
  year = 2014,
  series = {37th {{Annual AAS Rocky Mountain Section Guidance}} and {{Control Conference}}, 2014},
  address = {Breckenridge},
  abstract = {This paper discusses the applications of Distant Retrograde Orbits (DROs) about the Moon in support of advanced concepts such as NASA's Asteroid Redirect Mission. It studies how to build a direct transfer from a low Earth orbit to a DRO, paying attention to the guidance, navigation, and control challenges of each transfer option. The characteristics of planar DROs in the Earth-Moon system are examined. The paper focuses on a DRO that is in a 2:1 resonance with the lunar synodic period. Trade studies illustrate the relationships between the transfer trajectory duration, required launch energy, and DRO orbit insertion {$\Delta$}v cost.},
  langid = {english},
  annotation = {titleTranslation: 远距离逆行轨道直接转移任务考量}
}

@article{welchMissionConsiderationsTransfers2015a,
  title = {Mission Considerations for Transfers to a Distant Retrograde Orbit},
  author = {Welch, Chelsea M. and Parker, Jeffrey S. and Buxton, Caley},
  year = 2015,
  month = jun,
  journal = {Journal of Astronautical Sciences},
  volume = {62},
  number = {2},
  pages = {101--124},
  issn = {0021-9142, 2195-0571},
  doi = {10.1007/s40295-015-0039-z},
  urldate = {2026-04-29},
  abstract = {This paper discusses the applications of Distant Retrograde Orbits (DROs) about the Moon in support of advanced concepts such as NASA's Asteroid Redirect Mission. It studies how to build a direct transfer from a low Earth orbit to a DRO, paying attention to the navigation challenges of each transfer option. The characteristics of planar DROs in the Earth-Moon system are examined. The paper focuses on a DRO that is in a 2:1 resonance with the lunar synodic period. Trade studies illustrate the relationships between the transfer trajectory duration, required launch energy, and DRO orbit insertion v cost. In addition, powered lunar flyby transfers are explored to determine potential cost savings in v. These investigations are conducted in both the Circular Restricted Three-Body system and in a high-fidelity model of the solar system.},
  langid = {english},
  keywords = {ARM,Asteroid redirect mission,Direct transfer,Distant retrograde orbit,DRO,Powered lunar flyby},
  annotation = {abstractTranslation: 本文探讨了月球周围远距逆行轨道（DRO）在支持如NASA小行星重定向任务等先进概念中的应用。研究了如何从低地球轨道直接转移至DRO，重点关注各转移方案的导航挑战。分析了地月系统中平面DRO的特性，并聚焦于与月球朔望周期呈2:1共振的DRO。折衷研究展示了转移轨迹持续时间、所需发射能量与DRO入轨速度增量成本之间的关系。此外，还探讨了借助月球动力飞越的转移方案，以评估速度增量成本节约的潜力。上述研究在圆形限制性三体系统以及高保真太阳系模型中均进行了验证。},
  file = {/home/ouyangjiahong/Zotero/storage/FC8U57WA/Welch 等 - 2015 - Mission considerations for transfers to a distant retrograde orbit.pdf}
}


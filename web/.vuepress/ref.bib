@article{jacksonkulikStateTransitionTensors2023,
  title = {State Transition Tensors for Continuous-Thrust Control of Three-Body Relative Motion},
  author = {Jackson Kulik, William Clark And Dmitry},
  year = 2023,
  journal = {Journal Of Guidance, Control, And Dynamics},

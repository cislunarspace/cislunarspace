@article{anselmoRankingUpperStages2016,
  title = {Ranking Upper Stages in Low Earth Orbit for Active Removal},
  author = {Anselmo, L. and Pardini, C.},
  year = 2016,
  month = may,
  journal = {Acta Astronautica},
  volume = {122},
  pages = {19--27},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2016.01.019},
  urldate = {2025-12-01},
  abstract = {This paper addresses the problem of ranking the upper stages in orbit in order to evaluate their potential detrimental effects on the debris environment over the long-term, and the relative advantage of having them actively de-orbited. To do so, a new ranking scheme is introduced, applicable to any object in low Earth orbit (LEO) and able to prioritize the target objects potentially most critical for the future preservation of the LEO protected region. Applying the proposed approach, it was found, for instance, that the 22 most massive upper stages abandoned in LEO, at the beginning of 2015, are on the whole equivalent to several hundred average intact objects in sun-synchronous orbit, regarding their latent detrimental effects on the debris environment over the next 200 years. Most of them could therefore be the top priority targets of any worldwide coordinated effort for active removal and the prevention of new collisional debris. The ranking scheme was also applied to other main models of rocket bodies currently in orbit, trying to identify the combinations of orbital elements and upper stage types requiring particular attention.},
  langid = {english},
  annotation = {titleTranslation: 近地轨道现役末级火箭残骸清除优先级排序\\
abstractTranslation: 本文旨在对在轨末级火箭进行排序，以评估其对碎片环境长期潜在的负面影响，以及主动离轨的相对优势。为此，引入了一种新的排序方案，适用于低地球轨道（LEO）中的任何物体，并能够优先处理对未来LEO保护区保护可能最为关键的目标物体。应用所提出的方法发现，例如，截至2015年初，遗留在LEO中的22个质量最大的末级火箭，就其未来200年对碎片环境的潜在负面影响而言，总体上相当于太阳同步轨道中数百个平均完整物体。因此，它们可能成为任何全球协调主动移除和预防新碰撞碎片行动的首要目标。该排序方案还应用于目前在轨的其他主要火箭体模型，试图识别需要特别关注的轨道要素与末级火箭类型的组合。},
  file = {/home/ouyangjiahong/Zotero/storage/F65T8XD3/Anselmo和Pardini - 2016 - Ranking upper stages in low earth orbit for active removal.pdf}
}


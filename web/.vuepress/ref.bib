@phdthesis{RenJingMianXiangKongJianWuZiYunShuDeDiYueKongJianGuiDaoYouHuaSheJi2022,
  type = {{博士学位论文}},
  title = {{面向空间物资运输的地月空间轨道优化设计}},
  author = {{任婧}},
  year = 2022,
  address = {北京},
  abstract = {建立月球基地、经由地月空间去往更遥远的深空，对地月空间内的物资运输体系设计提出了更高要求。本文重点针对地月系统中平面周期轨道作为空间节点时与其他垂直空间节点可达性差、对物资运输问题相同节点需要多种转移方案、圆型限制性三体问题中求解最优轨道收敛难度大的问题开展研究。论文主要研究内容包含以下几个方面: 针对地月空间运输体系中的节点设计问题，研究了大幅值逆行轨道(Distant Retrograde Orbit，DRO)的垂直分岔周期轨道族设计方法。基于非线性动力学分岔理论和周期性定理，确定了能够生成分岔轨道族的共振比和对称类型;在此基础上通过微分修正算法和数值延拓获得了30族垂直分岔周期轨道;最后对求得的周期轨道族进行稳定性分析，获得了具有垂直方向运动分量且稳定的三维DROs。 针对月球与空间节点间的转移问题，系统地研究了月球与DROs间的两脉冲切向转移轨道设计方法。通过基于碰撞带图谱的转移轨道初值搜索方法预估了在x轴入轨的12族转移轨道初值;在此基础上通过微分修正算法和数值延拓获得了由不同停泊轨道高度出发，在不同相位入轨的18族月球至DROs的两脉冲转移轨道，并且对求得的全部转移轨道族的时间和速度增量消耗进行分析，总结了不同族转移轨道的特性，并给出了速度增量消耗的估算方法。另外，提出了基于局部Lyapunov指数的转移轨道稳定性指标，用于分析转移轨道上不同位置的小扰动对入轨精度的影响。 针对地球与空间节点间的转移问题，系统地研究了地球与三角平动点附近的短周期轨道(Shortperiodic orbit，SPO)的转移轨道设计与优化方法。通过基于碰撞带图谱的转移轨道初值搜索方法、微分修正算法和数值延拓获得了2族直接转移轨道和2族月球引力辅助转移轨道;对直接转移轨道，建立了基于主矢量理论的优化模型并通过序列二次规划算法求解，获得了最省燃料直接转移轨道;对存在近月点高度约束的月球引力辅助转移轨道，基于最优控制理论推导了含内点约束的一阶最优必要性条件，设计了一种迭代求解算法并获得了最省燃料月球引力辅助转移轨道。 针对空间节点间的转移问题，提出了以出发速度方向角为优化变量的快速优化方法。对x-y平面中SPO至DRO的转移轨道设计了出发速度方向约束下的微分修正算法，并基于该算法建立了以出发速度方向为优化变量的优化模型并通过全局优化算法快速求解，获得了SPO至DRO各相位的最省燃料两脉冲转移轨道，仿真结果表明求得的解满足主矢量理论下的最优必要性条件。最后，将平面模型中出发速度方向约束下的微分修正算法和快速优化模型拓展至三维模型，获得了SPO至L2点附近的Halo轨道各相位的最省燃料两脉冲转移轨道。},
  langid = {chinese},
  school = {中国科学院大学},
  keywords = {;;;},
  file = {/home/ouyangjiahong/Zotero/storage/FNUNDAHI/任婧 - 2022 - 面向空间物资运输的地月空间轨道优化设计.pdf;/home/ouyangjiahong/Zotero/storage/SH2M3IBI/任婧 - 2022 - 面向空间物资运输的地月空间轨道优化设计.pdf}
}


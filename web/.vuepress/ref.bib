  doi = {10.27052/d.cnki.gzjgu.2021.000665},
  urldate = {2026-04-05},
  abstract = {本文主要研究美国陆军旅级情报部队冷战后期以来的建设情况。通过对其不同历史时期的发展脉络进行梳理和对照比较,基本理清了该类型部队的历史沿革。对战区军事情报旅、职能情报单位和远征军事情报旅的建设现状和作战职能进行了详细阐述,并对其主要建设举措和建设特点进行归纳,特别突出理论建设和人才培养等重点内容。经过对三类旅级情报部队建设的探析,理解认识其发展建设规律,并结合我陆军情报部队正处于军改后起步发展阶段的实际情况,提出完善情报理论、构建多源情报体系和培塑情报人才等针对性思考建议。本文主要分为五个章节:第一章为绪论;第二章对美国陆军旅级情报部队的历史沿革进行回顾;第三章论述了三种旅级情报部队的建设现状和作战职能;第四章对旅级情报部队的建设举措和特点进行归纳分析;第五章结合我陆军旅级情报部队的发展现状,就下步发展方向提出思考建议。},
  collaborator = {{胡欣} and {齐战兵}},
  langid = {chinese},
  school = {国防科技大学},
  annotation = {Major: 军事硕士（专业学位）},
  file = {/home/ouyangjiahong/Zotero/storage/I3CB83CA/周晶 - 2024 - 冷战后期以来美国陆军旅级情报部队建设研究.pdf}
}

@article{ZhouJingPingDongDianZhouQiGuiDaoJianXiaoTuiLiZhuanYiDeGaussWeiPuFa2020,
  title = {{{平动点周期轨道间小推力转移的Gauss伪谱法}}},
  author = {{周敬} and {胡军}},
  year = 2020,
  journal = {中国空间科学技术},
  number = {第5期},
  pages = {42--52},
  abstract = {针对三体问题共线平动点附近周期轨道间的小推力转移问题,构造了一种新的形状函数,在此基础上提出了一种基于Gauss伪谱法的优化设计方法。首先,建立小推力轨道转移动力学模型,参考初始轨道和目标轨道的类型,构造一种新的形状函数以近似小推力转移轨道。为满足不同的约束要求,提出了振幅和相位按多项式变化的假设,推导了小推力转移轨道的近似解析解;然后利用Gauss伪谱法将小推力轨道转移的最优控制问题转化为非线性规划问题,并对推导的近似解析解进行解算和处理,为Gauss伪谱法求解非线性规划问题提供较为有效的控制变量的初始猜测值;最后以地月系统L\textexclamdown sub\textquestiondown 1\textexclamdown/sub\textquestiondown 点附近Halo轨道间的小推力转移问题为例进行了仿真分析。仿真结果表明,小推力转移轨道近似解析解具备有效性和普适性,使得Gauss伪谱法的迭代效率提高55},
  keywords = {;;;;Gauss;}
}


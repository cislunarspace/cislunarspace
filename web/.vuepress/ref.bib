@article{galan-vioqueContinuationPeriodicOrbits2014,
  title = {Continuation of Periodic Orbits in Symmetric Hamiltonian and Conservative Systems},
  author = {{Galan-Vioque}, J. and Almaraz, F. J. M. and Mac{\'i}as, E. F.},
  year = 2014,

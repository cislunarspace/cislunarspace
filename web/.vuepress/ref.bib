@article{catanzaroAntColonyOptimization2007,
  title = {An Ant Colony Optimization Algorithm for Phylogenetic Estimation under the Minimum Evolution Principle},
  author = {Catanzaro, Daniele and Pesenti, Rafflaele and Milinkovitch, Michel C.},
  year = 2007,
  journal = {BMC Evolutionary Biology},
  volume = {Vol.7},
  number = {No.1},
  pages = {228},
  issn = {1471-2148},
  doi = {10.1186/1471-2148-7-228},
  abstract = {BACKGROUND: Distance matrix methods constitute a major family of phylogenetic estimation methods, and the minimum evolution (ME) principle (aiming at recovering the phylogeny with shortest length) is one of the most commonly used optimality criteria for estimating phylogenetic trees. The major difficulty for its application is that the number of possible phylogenies grows exponentially with the number of taxa analyzed and the minimum evolution principle is known to belong to the NRho- hard class of problems. RESULTS: In this paper, we introduce an Ant Colony Optimization (ACO) algorithm to estimate phylogenies under the minimum evolution principle. ACO is an optimization technique inspired from the foraging behavior of real ant colonies. This behavior is exploited in artificial ant colonies for the search of approximate solutions to discrete optimization problems. CONCLUSION: We show that the ACO algorithm is potentially competitive in comparison with state-of-the-art algorithms for the minimum evolution principle. This is the first application of an ACO algorithm to the phylogenetic estimation problem.},
  langid = {english},
  annotation = {titleTranslation: 基于最小进化原理的系统发育估计蚁群优化算法\\
abstractTranslation: 背景：距离矩阵方法是系统发育估计方法中的一个主要分支，最小进化原则（旨在恢复具有最短长度的系统发育树）是估计系统发育树时最常用的最优性准则之一。其应用的主要困难在于，可能的系统发育树数量随分析类群数呈指数增长，且已知最小进化原则属于NRho-hard问题类。  \\
结果：本文提出了一种基于蚁群优化（ACO）算法在最小进化原则下估计系统发育树的方法。ACO是一种受真实蚁群觅食行为启发的优化技术，该行为被用于人工蚁群以搜索离散优化问题的近似解。  \\
结论：我们证明，与最小进化原则下的前沿算法相比，ACO算法具有潜在竞争力。这是ACO算法首次应用于系统发育估计问题}
}


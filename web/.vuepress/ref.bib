@article{pucaccoDynamicalStabilityLaplace2024,
  title = {Dynamical Stability of the Laplace Resonance},
  author = {Pucacco, Giuseppe},
  year = 2024,
  month = dec,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {6},
  pages = {51--76},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10221-3},
  urldate = {2025-10-01},
  abstract = {We analyse the stability of the de Sitter equilibria in multi-resonant planetary systems. The de Sitter equilibrium is the dynamical state of the Laplace resonance in which all resonant arguments are librating. The sequence of equilibria exists all along the possible states balancing resonance offsets and forced eccentricities. Possible additional new de Sitter equilibria may exist when at least one of the forced eccentricities is large (the paradigmatic case is Gliese 876). In the present work, these families of equilibria are traced up to crossing exact commensurability, where approximate first-order solutions diverge. Explicit exact location of the equilibria is determined allowing us to verify the Lyapunov stability of the standard de Sitter equilibrium and of the stable branches of the additional ones.},
  langid = {english},
  annotation = {titleTranslation: 拉普拉斯共振的动力学稳定性\\
abstractTranslation: 我们分析了多共振行星系统中德西特平衡态的稳定性。德西特平衡是拉普拉斯共振的一种动力学状态，其中所有共振辐角均在振动。这一平衡序列存在于所有可能的状态中，平衡了共振偏移与强迫偏心率。当至少一个强迫偏心率较大时（典型例子是Gliese 876），可能存在新的附加德西特平衡态。在本工作中，这些平衡族被追踪至穿越精确通约点（此处一阶近似解发散）的边界。通过精确确定平衡态的位置，我们得以验证标准德西特平衡态以及附加平衡态稳定分支的Lyapunov稳定性。},
  file = {/home/ouyangjiahong/Zotero/storage/NNYB2ZSH/Pucacco - 2024 - Dynamical stability of the laplace resonance.pdf}
}

@article{pucaccoEnergyMomentumMap2014,
  title = {An Energy--Momentum Map for the Time-Reversal Symmetric 1:1 Resonance with Symmetry},
  shorttitle = {An Energy--Momentum Map for the Time-Reversal Symmetric 1},
  author = {Pucacco, Giuseppe and Marchesiello, Antonella},
  year = 2014,
  month = mar,
  journal = {Physica D: Nonlinear Phenomena},
  volume = {271},
  pages = {10--18},
  issn = {01672789},
  doi = {10.1016/j.physd.2013.12.009},
  urldate = {2025-11-25},
  abstract = {We present a general analysis of the bifurcation sequences of periodic orbits in general position of a family of reversible 1:1 resonant Hamiltonian normal forms invariant under Z2\texttimes Z2 symmetry. The rich structure of these classical systems is investigated both with a singularity theory approach and geometric methods. The geometric approach readily allows to find an energy--momentum map describing the phase space structure of each member of the family and a catastrophe map that captures its global features. Quadrature formulas for the actions, periods and rotation number are also provided.},
  langid = {english},
  annotation = {titleTranslation: 时间反演对称下1:1共振的能量-动量映射（含对称性）\\
abstractTranslation: 我们给出了关于一族在Z2\texttimes Z2对称性下不变的可逆1:1共振哈密顿规范型周期轨道一般位置分岔序列的通用分析。通过奇点理论方法和几何手段，研究了这些经典系统的丰富结构。几何方法便于构造描述该族中每个成员相空间结构的能量-动量映射，以及刻画其全局特征的突变映射。此外，还提供了作用量、周期和旋转数的求积公式。},

  number = {No.2},
  pages = {268},
  abstract = {Deploying the space station on a stable periodic orbit（e. g. ，distant retrograde orbits，DROs）in the vicinity of the Moon can significantly reduce the lunar exploration cost，and the space station can also be used as a steppingstone for manned asteroid or mars missions. Reducing fuel consumption is an important issue during construction and cargo resupply of the cislunar station. For transter trajectory from Earth into DRO，DRO insertion cost can be effectively saved with the aid of weak stability Boundary（WSB）transfer，but reading WSB directly requires higher launch velocity. This paper aims at improving the numerical sensitivity of transfer trajectory which leverage Lunar Gravity Assist（LGA）and WSB transfer simnltaneously. The initial guess of trajectories are obtained by``perilune Poincare map'' and``v infinity matching''strategies，then multiple shooting with analytic gradient is applied under high fidelity model，better computerational efficiency are obtained by applying improved methods. In numerical simulation，for the DRO with a resonant ratio of 2{$:$}1，for the minimum cost solution，the Earth launching injection is 3. 127 km/s（60-70 m/s is reduced compared with directly launching into WSB）. The time of flight is 102. 88 d，and DRO insertion maneuver only needs 66.1 m/s.},
  langid = {english},
  keywords = {Distant Retrograde Orbit (DRO),lunar gravity assist,N-body problem,Poincare map,trajectory optimization,weak stability boundary},
  annotation = {titleTranslation: 借助月球引力的低能耗地月转移至远距离逆行轨道（DRO）\\
abstractTranslation: 在月球附近稳定周期轨道（例如远距离逆行轨道，DRO）上部署空间站可显著降低月球探测成本，同时该空间站还可作为载人小行星或火星任务的跳板。降低燃料消耗是地月空间站建设与货运补给过程中的关键问题。对于从地球到DRO的转移轨道而言，借助弱稳定边界（WSB）转移可有效节省DRO入轨成本，但直接进入WSB需要更高的发射速度。本文旨在改进同时利用月球引力辅助（LGA）与WSB转移的转移轨道的数值敏感性。初始猜测轨迹通过``近月点庞加莱映射''与``速度无穷匹配''策略获取，随后在高保真模型下采用带解析梯度的多重打靶法，并通过改进方法获得了更优的计算效率。数值仿真中，针对共振比为2:1的DRO，最小成本解对应的地球发射速度为3.127 km/s（相比直接发射进入WSB节省60-70 m/s），飞行时间为102.88天，DRO入轨机动仅需66.1 m/s。}
}

@article{zhangNonlinear6DOFControl2012,
  title = {Nonlinear 6-{{DOF}} Control of Spacecraft Docking with Inter-Satellite Electromagnetic Force},
  author = {Zhang, Yuan-wen and Yang, Le-ping and Zhu, Yan-wei and Huang, Huan and Cai, Wei-wei},
  year = 2012,
  month = aug,
  journal = {Acta Astronautica},
  volume = {77},
  pages = {97--108},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2012.03.020},
  urldate = {2025-10-16},
  abstract = {Compared to traditional docking systems, spacecraft docking with inter-satellite electromagnetic mechanism has distinct advantages. However, its 6-DOF control problem has not been adequately investigated. From our knowledge, this paper attempts to study the 6-DOF control problem for the first time. Based on the far-field electromagnetic force model and Hill's model, the dynamic model of translational motion is derived; using tracking control strategy, LQR method and estimate of Extended State Observer (ESO), an optimal and robust translational controller is designed to satisfy relative position/velocity requirements of soft docking. Representing the attitude of the docking spacecraft pair by unit quaternion, the attitude dynamic and kinematic models with quaternion expression are derived; using behavior-based coordinated control approach and ESO, a decentralized attitude controller is designed to simultaneously align one spacecraft with its absolute desired attitude and with the other spacecraft of the docking pair, requiring no angular velocity measurement and exhibiting better robust capability. The feasibility and performance of this proposed 6DOF controller are validated by theoretical deduction and simulation results.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid = {english},
  annotation = {titleTranslation: 基于星间电磁力的航天器对接非线性六自由度控制\\
abstractTranslation: 与传统的对接系统相比，采用星间电磁机构的航天器对接具有明显优势。然而，其六自由度控制问题尚未得到充分研究。据我们所知，本文首次尝试研究该六自由度控制问题。基于远场电磁力模型和Hill模型，推导了平动动力学模型；利用跟踪控制策略、LQR方法以及扩展状态观测器(ESO)的估计，设计了一种最优且鲁棒的平动控制器，以满足软对接的相对位置/速度要求。通过单位四元数表示对接航天器对的姿态，推导了基于四元数表达的姿态动力学与运动学模型；采用基于行为的协调控制方法和ESO，设计了一种分布式姿态控制器，能够同时使一个航天器对其绝对期望姿态以及对接对中的另一个航天器进行对准，且无需角速度测量，并展现出更强的鲁棒能力。通过理论推导和仿真结果验证了所提出的六自由度控制器的可行性与性能},
  file = {/home/ouyangjiahong/Zotero/storage/SXEUVAV9/Zhang 等 - 2012 - Nonlinear 6-DOF control of spacecraft docking with inter-satellite electromagnetic force.pdf}
}

@article{zhangNovelMethodPeriodic2011,
  title = {A Novel Method of Periodic Orbit Computation in Circular Restricted Three-Body Problem},
  author = {Zhang, HanQing and Li, YanJun and Zhang, Ke},
  year = 2011,
  month = aug,
  journal = {Science China Technological Sciences},
  volume = {54},
  number = {8},
  pages = {2197--2203},
  issn = {1862-281X},
  doi = {10.1007/s11431-011-4441-x},
  urldate = {2026-01-04},
  abstract = {Periodic orbits are fundamental keys to understand the dynamical system of circular restricted three-body problem, and they play important roles in practical deep-space exploration. Current methods of periodic orbit computation need a high-order analytical approximate solution to start the iteration process, thus making the computation complicated and limiting the types of periodic orbits that can be obtained. By utilizing the symmetry of the restricted three-body problem, a special kind of flow function is constructed, so as to map a state on the plane of symmetry to another state that also lies in this plane. Based on this flow function, a new method of periodic orbit computation is derived. This method needs neither a starting analytic approximation nor the state transition matrix to be computed, so it can be conveniently implemented on a computer. Besides, this method is unaffected by the nonlinearity of the dynamical system, allowing a large set of periodic orbits which have x-z plane symmetry to be computed numerically. As examples, some planar periodic orbits (e.g. Lyapunov orbit) and spatial periodic orbits (e.g. Halo orbit) are computed. By further combining with a differential correction process, the method introduced here can be used to design resonant orbits that can jump between different resonant frequencies. One such resonant orbit is given in this paper, verifying the efficiency of this method.},
  langid = {english},
  keywords = {circular restricted three-body problem,libration point,numerical method,periodic orbit,resonant orbit},
  annotation = {titleTranslation: 圆型限制性三体问题中周期轨道计算的一种新方法\\
abstractTranslation: 周期轨道是理解圆形限制性三体问题动力学系统的关键基础，在实际深空探测任务中具有重要作用。现有周期轨道计算方法需要高阶解析近似解以启动迭代过程，导致计算复杂且可获取的周期轨道类型受限。通过利用限制性三体问题的对称性，本文构建了一种特殊的流函数，可将对称平面上的状态映射至该平面上的另一状态。基于此流函数，推导出一种新的周期轨道计算方法。该方法既无需起始解析近似解，也无需计算状态转移矩阵，便于计算机实现。此外，该方法不受动力学系统非线性影响，可数值计算大量具有x-z平面对称性的周期轨道。作为示例，文中计算了若干平面周期轨道（如李雅普诺夫轨道）与空间周期轨道（如晕轨道）。通过进一步结合微分校正流程，所提方法可用于设计能在不同共振频率间跃迁的共振轨道。本文给出了一个此类共振轨道算例，验证了该方法的有效性。}
}

@article{zhangNumericalContinuationFamilies2019,
  title = {Numerical Continuation of Families of Periodic Orbits in the Circular Restricted Three-Body Problem},
  author = {Zhang, Renyong},
  year = 2019,
  journal = {The International Conference on Computational \& Experimental Engineering and Sciences},
  volume = {Vol.21},
  number = {No.2},
  pages = {22--24},
  doi = {10.32604/icces.2019.04656},
  abstract = {This article aims to give a method for the fast numerical computation and continuation of families of periodic orbits in the strong nonlinear circular restricted three-body problem, and we focus our attention on those in the Earth-moon system. This work is primarily motivated by a series of missions and plans that take advantages of the three-body periodic orbits associated with the collinear equilibrium points, L1, L2 and L3 or two gravitational celestial bodies. We describe the method used that allows to follow individual families of periodic orbits by numerical continuation, which based on Jacobi energy surface, of strong nonlinear equations. The stability of these bifurcation orbits of the dynamics is examined and it is found that in each case there are two subintervals of range of mass parameter for which these orbits are stable. The investigation shows that the method can fast generate a great families of the periodic orbits including Lyapunov Orbit, Halo Orbit, Near Rectilinear Halo Orbits (NRHOs), Butterfly Orbits, Distant Retrograde Orbits (DROs), and Direct Periodic Orbits (DPOs).},
  langid = {english},
  annotation = {titleTranslation: 圆型限制性三体问题中周期轨道族的数值延拓\\
abstractTranslation: 本文旨在提出一种在强非线性圆型限制性三体问题中快速数值计算和延拓周期轨道族的方法，并重点关注地月系统中的轨道。此项工作主要受一系列利用与两个引力天体共线平衡点L1、L2和L3相关的三体周期轨道的任务和计划的推动。我们描述了所采用的方法，该方法基于Jacobi能量面，通过数值延拓跟踪强非线性方程下的单个周期轨道族。研究了这些动力学分岔轨道的稳定性，发现在每种情况下都存在两个质量参数子区间，使得这些轨道是稳定的。研究表明，该方法能够快速生成大量周期轨道族，包括Lyapunov轨道、晕轨道、近直线晕轨道（NRHOs）、蝴蝶轨道、远距离逆行轨道（DROs）以及直接周期轨道（DPOs）},
  file = {/home/ouyangjiahong/Zotero/storage/9F4JF7IL/Zhang - 2019 - Numerical continuation of families of periodic orbits in the circular restricted three-body problem.pdf}
}

@article{zhangOptimalDesignMars2023,
  title = {Optimal Design of {{Mars}} Immigration by Using Reusable Transporters from the {{Earth}}--Moon System},
  author = {Zhang, Guoxu and Pang, Bo and Sun, Yangyuxi and Zhou, Xingyu and Shang, Yunong and Chen, Cheng and Lu, Meng and Zhang, Yuhang and Jin, Zihan and Zhang, Yining and Qiao, Penghao and Liu, Yue and Zhu, Zhengfan and Qian, Y. J. and Wen, Changxuan},
  year = 2023,
  journal = {Acta Astronautica},
  volume = {Vol.207},
  number = {Suppl C},
  pages = {129--152},
  doi = {10.1016/j.actaastro.2023.02.042},
  abstract = {In the 2016 International Astronautical Congress, SpaceX's Mars immigration plan was first formally proposed alongside a fully-reusable transportation infrastructure. In the 12th edition of the China Trajectory Optimization Competition (CTOC-12) held in 2022, a Mars transportation trajectory design problem using reusable transporters from a parking distant retrograde orbit (DRO) in the Earth--Moon system was released. It is expected to transport as many immigrants as possible using a maximum of 50 transporters within a total of 20 years. The BIT-DFH-BJUT team reported a solution that can deliver 9080 immigrants to Mars, which ranked first in the competition. In this paper, the methods and results from the winning team are presented, primarily including an overall analysis, underlying round-trip trajectory design, and top-level scheduling. Specifically, a round-trip is divided into four phases, leaving the DRO to man-boarding at the perigee, Earth--Mars interplanetary transfer, Mars's return to the Earth, and return to the DRO. An overall optimization framework is constructed by synthesizing techniques such as data set creation and patching, differential evolution, nonlinear programming, greedy algorithm, and mixed-integer programming. Finally, we outline the final solution of our team and compare the results with those from the top five teams. This competition demonstrates that a large-scale Mars immigration plan is possible by using reusable transporters from the Earth--Moon system.},
  langid = {english},
  keywords = {China trajectory optimization competition,Distant retrograde orbit,Mars immigration,Reusable transporters},
  annotation = {titleTranslation: 利用地月系统可重复使用运输器实现火星移民的最优设计\\
abstractTranslation: 在2016年国际宇航大会上，SpaceX的火星移民计划首次正式提出，并同步构建了完全可重复使用的运输基础设施。2022年举办的第十二届中国轨道优化竞赛（CTOC-12）中，发布了一项利用地月系统停车场远距离逆行轨道（DRO）可重复使用运输器的火星运输轨道设计问题，要求在20年内用至多50艘运输器运送尽可能多的移民。BIT-DFH-BJUT团队提交的方案可实现向火星运送9080名移民，在该竞赛中位列第一。本文介绍了该优胜团队的方法与成果，主要包括总体分析、基础往返轨道设计及顶层调度。具体而言，往返过程分为四个阶段：离开DRO至近地点人员登船、地火行星际转移、火星返地、及返回DRO。通过整合数据集构建与拼接、差分进化、非线性规划、贪婪算法及混合整数规划等技术，构建了整体优化框架。最后，我们概述了团队的最终方案，并将结果与排名前五的团队进行了对比。本次竞赛表明，利用地月系统的可重复使用运输器实现大规模火星移民计划是可行的。}
}

@article{zhangOptimalPredictiveSlidingmode2022,
  title = {Optimal Predictive Sliding-Mode Guidance Law for Intercepting near-Space Hypersonic Maneuvering Target},
  author = {Zhang, Bolun and Zhou, Di},
  year = 2022,
  journal = {Chinese Journal of Aeronautics},
  volume = {35},
  number = {4},
  pages = {320--331},
  issn = {1000-9361},
  doi = {10.1016/j.cja.2021.05.021},
  abstract = {The design of optimal guidance law for intercepting a near-space hypersonic maneuvering target with bounded inputs is considered. Firstly, a maneuvering model for near-space hypersonic aircraft is given. Then, the aircraft acceleration prediction can be obtained using this model with two neural networks. By using the target acceleration prediction, which is taken into account when calculating the Zero Effort Miss (ZEM), an optimal sliding-mode guidance law is proposed to fulfill the guidance task. An adaptive sliding-mode switch term is designed to deal with actuator saturation and prediction errors. Finally, numerical simulations show that the proposed guidance law can reduce the energy consumption and the terminal acceleration command of the interceptor effectively.},
  langid = {english},
  keywords = {Adaptive sliding-mode control,Near-space hypersonic aircraft,Neural networks,Optimal control,Predictive guidance law},
  annotation = {titleTranslation: 拦截临近空间高超声速机动目标的最优预测滑模制导律\\
abstractTranslation: 考虑有界输入下拦截临近空间高超声速机动目标的最优制导律设计。首先，建立临近空间高超声速飞行器的机动模型；然后，利用该模型结合两个神经网络获取飞行器加速度预测值。在计算零脱靶量（ZEM）时引入目标加速度预测，提出一种最优滑模制导律以完成制导任务。设计自适应滑模切换项应对执行器饱和与预测误差。最后，数值仿真表明，所提制导律能有效降低拦截器能量消耗与末端加速度指令}
}


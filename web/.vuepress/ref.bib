@article{pengEarthmoonSpaceStation2024,
  title = {Earth-Moon Space Station Orbit Design Based on Three-Body Problem},
  author = {Peng, Lei and Liang, Yuying and Shi, Peng and Jing, Qianfeng},
  year = 2024,
  journal = {Feixing Lixue = Flight Dynamics},
  volume = {Vol.42},
  number = {No.5},
  pages = {26},
  issn = {1002-0853},
  abstract = {To meet the needs of constructing future Earth-Moon space station, the orbit selection and transfer trajectory design of the station has been implemented. Based on the Earth-Moon space periodic orbits, the southern L2 near-rectilinear halo orbit（NRHO） is selected as the target orbit by comprehensively considering the orbit configuration and stability. Considering the high stability of NRHO and the difficulty to transfer, the optimal transfer from the lunar transfer orbit to NRHO is designed based on the three-body Lambert algorithm through the lunar gravity assist. To overcome the defect that NRHO has no obvious manifold structure, the theory of the principal stretching direction in phase space based on the Cauchy-Green tensor is proposed to obtain the most effective impulse exerting direction, and then the low-energy transfer trajectory is derived by patching the Lambert segment with the inverse integral trajectory along the principal stretching direction. The research results indicate that the lunar gravity assist transfer can be used as an ideal orbit for manned transfer, and the low-energy transfer trajectory using the Lambert patching method can effectively shorten the transfer time and provide a reference for the cargo spacecraft to the space station.},
  langid = {english},
  annotation = {titleTranslation: 基于三体问题的地月空间站轨道设计\\
abstractTranslation: 为满足未来地月空间站建设需求，开展了空间站轨道选择与转移轨迹设计。基于地月空间周期轨道，综合考虑轨道构型与稳定性，选取南向L2近直线晕轨道（NRHO）作为目标轨道。针对NRHO稳定性高、转移难度大的特点，借助月球引力辅助，基于三体Lambert算法设计了从月球转移轨道至NRHO的最优转移方案。为克服NRHO无明显流形结构的缺陷，提出基于Cauchy-Green张量的相空间主拉伸方向理论，获取最有效的脉冲施加方向，进而通过将Lambert段与沿主拉伸方向逆积分的轨迹拼接，得到低能量转移轨迹。研究结果表明，月球引力辅助转移可作为理想的载人转移轨道，而采用Lambert拼接法的低能量转移轨迹可有效缩短转移时间，为货运飞船前往空间站提供参考。}
}

@article{PengJinXianMeiJunDianCiKongJianZuoZhanYanJiu2024,
  title = {{美军电磁空间作战研究}},
  author = {{彭进先} and {桑苗苗} and {耿丹} and {周伦} and {王晓} and {黄永亮}},

@article{heiligersExtensionEarthmoonLibration2016,
  title = {Extension of {{Earth-moon}} Libration Point Orbits with Solar Sail Propulsion},
  author = {Heiligers, Jeannette and Macdonald, Malcolm and Parker, Jeffrey S.},
  year = 2016,
  journal = {Astrophysics and Space Science},
  volume = {Vol.361},
  number = {No.7},
  doi = {10.1007/s10509-016-2783-3},
  abstract = {This paper presents families of libration point orbits in the Earth-Moon system that originate from complementing the classical circular restricted three-body problem with a solar sail. Through the use of a differential correction scheme in combination with a continuation on the solar sail induced acceleration, families of Lyapunov, halo, vertical Lyapunov, Earth-centred, and distant retrograde orbits are created. As the solar sail circular restricted three-body problem is non-autonomous, a constraint defined within the differential correction scheme ensures that all orbits are periodic with the Sun's motion around the Earth-Moon system. The continuation method then starts from a classical libration point orbit with a suitable period and increases the solar sail acceleration magnitude to obtain families of orbits that are parametrised by this acceleration. Furthermore, different solar sail steering laws are considered (both in-plane and out-of-plane, and either fixed in the synodic frame or fixed with respect to the direction of Sunlight), adding to the wealth of families of solar sail enabled libration point orbits presented. Finally, the linear stability properties of the generated orbits are investigated to assess the need for active orbital control. It is shown that the solar sail induced acceleration can have a positive effect on the stability of some orbit families, especially those at the \textbackslash (L\_2\textbackslash ) point, but that it most often (further) destabilises the orbit. Active control will therefore be needed to ensure long-term survivability of these orbits.},
  langid = {english},
  keywords = {Differential corrector,Distant retrograde orbits,Earth-Moon system,Halo orbits,Libration point orbits,Lyapunov orbits,Solar sailing,Vertical Lyapunov orbits},
  annotation = {titleTranslation: 利用太阳帆推进扩展地月平动点轨道\\
abstractTranslation: 本文提出了在地月系统中通过将太阳帆引入经典圆型限制性三体问题而衍生出的平动点轨道族。利用差分校正方案结合太阳帆诱导加速度的延拓方法，生成了Lyapunov轨道族、halo轨道族、垂直Lyapunov轨道族、地心轨道族以及远距离逆行轨道族。由于太阳帆圆型限制性三体问题是非自治的，差分校正方案中定义的约束条件确保所有轨道与太阳绕地月系统的运动具有周期性。延拓方法从具有合适周期的经典平动点轨道出发，通过增大太阳帆加速度幅值，获得以该加速度为参数的轨道族。此外，考虑了不同的太阳帆转向律（包括面内与面外转向，以及固定在会合系中或相对于阳光方向固定），进一步丰富了所呈现的太阳帆驱动平动点轨道族。最后，研究了生成轨道的线性稳定性特性，以评估主动轨道控制的需求。结果表明，太阳帆诱导加速度对某些轨道族（尤其是\textbackslash (L\_2\textbackslash )点附近的轨道族）的稳定性具有积极影响，但更多情况下会（进一步）使轨道失稳。因此，需要主动控制以确保这些轨道的长期生存能力。}
}


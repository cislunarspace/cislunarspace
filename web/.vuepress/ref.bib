@article{WangYingJieXinXiFeiWanBeiXiaDuoHangTianQiGuiDaoBoYiQiangHuaXueXiFangFa2023,
  title = {{信息非完备下多航天器轨道博弈强化学习方法}},
  author = {{王英杰} and {袁利} and {汤亮} and {黄煌} and {耿远卓}},

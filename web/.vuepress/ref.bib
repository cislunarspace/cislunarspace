@article{nieLunarFrozenOrbits2018,
  title = {Lunar Frozen Orbits Revisited},
  author = {Nie, Tao and Gurfil, Pini},
  year = 2018,
  month = sep,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {130},
  number = {10},
  pages = {61},
  issn = {1572-9478},
  doi = {10.1007/s10569-018-9858-0},
  urldate = {2026-05-22},
  abstract = {Lunar frozen orbits, characterized by constant orbital elements on average, have been previously found using various dynamical models, incorporating the gravitational field of the Moon and the third-body perturbation exerted by the Earth. The resulting mean orbital elements must be converted to osculating elements to initialize the orbiter position and velocity in the lunar frame. Thus far, however, there has not been an explicit transformation from mean to osculating elements, which includes the zonal harmonic \$\$J\_2\$\$, the sectorial harmonic \$\$C\_\textbraceleft 22\textbraceright\$\$, and the Earth third-body effect. In the current paper, we derive the dynamics of a lunar orbiter under the mentioned perturbations, which are shown to be dominant for the evolution of circumlunar orbits, and use von Zeipel's method to obtain a transformation between mean and osculating elements. Whereas the dynamics of the mean elements do not include \$\$C\_\textbraceleft 22\textbraceright\$\$, and hence does not affect the equilibria leading to frozen orbits, \$\$C\_\textbraceleft 22\textbraceright\$\$is present in the mean-to-osculating transformation, hence affecting the initialization of the physical circumlunar orbit. Simulations show that by using the newly-derived transformation, frozen orbits exhibit better behavior in terms of long-term stability about the mean values of eccentricity and argument of periapsis, especially for high orbits.},
  langid = {english},
  keywords = {Frozen orbit,Third-body effects,Von Zeipel's method},
  annotation = {titleTranslation: 月球冻结轨道再探},
  file = {/home/ouyangjiahong/Zotero/storage/8HBC9HPD/Nie和Gurfil - 2018 - Lunar frozen orbits revisited.pdf}
}

@article{NieMingYanDiYueKongJianAnQuanBaoZhangDeDangDaiGuoJiFaTiaoZhanYuZhongGuoDuiCe2023,
  title = {地月空间安全保障的当代国际法挑战与中国对策},
  author = {{聂明岩}},
  year = 2023,
  journal = {南京航空航天大学学报(社会科学版)},
  number = {第3期},
  pages = {86--93},
  abstract = {随着新一轮月球竞赛的兴起，地球静止轨道之上直至月球的地月空间的战略地位受到高度重视。以美国为代表的空间强国通过推出单边措施及发起``小圈子''多边合作的方式，分别从地月空间军事利用、私人实体对月球及天体资源商业开采、地月空间与月球活动秩序塑造等方面进行布局，对地月空间安全造成了威胁。以1967年《外空条约》和1979年《月球协定》为代表的国际条约虽适用于地月空间安全保障，但存在对外空和月球及天体和平利用规定的``双轨制''、对私人实体开采月球及天体资源规定不清晰以及对地月空间及月球活动秩序规定的缺失等问题。我国探月工程取得了巨大成就，从未来发展角度看，我国应细化``人类命运共同体''理论的指导意义以适应地月空间安全保障的特殊性；修改《PPWT草案》，纳入地月空间安全保障内容，构建``硬法''与``软法''结合的综合性框架；此外，应在中、俄国际月球科研站项目基础上，推动制定多边地月空间及月球活动秩序保障规则。},
  keywords = {;;;},
  file = {/home/ouyangjiahong/Zotero/storage/CGPT9KDU/聂明岩 - 2023 - 地月空间安全保障的当代国际法挑战与中国对策.pdf}
}

@article{NieMingYanFangZhiDiYueKongJianJunBeiJingSaiJiWuQiHuaDeGuoJiFaKunJingYuZhongGuoYingDui2025,
  title = {{防止地月空间军备竞赛及武器化的国际法困境与中国应对}},
  author = {{聂明岩} and {于焕}},
  year = 2025,
  journal = {中国航天},
  number = {9},
  pages = {35--40},
  issn = {1002-7742},
  urldate = {2026-04-23},
  abstract = {防止地月空间军备竞赛与武器化，是保障新一轮月球探索与开发安全、可持续开展的关键前提。与传统以地球同步轨道以下为重点的人类外空活动不同，地月空间主要服务于月球表面项目，其特殊性对现行国际法提出了新的挑战。以1967年《外空条约》为代表的国际规则确立了``和平目的''与``专为和平目的''的区别适用模式，分别针对外层空间和月球及其他天体，但该模式在规制地月空间军事行为方面存在明显不足。当前，围绕``硬法''与``软法''的规则路径存在分歧，对地月空间特殊性重视不足，这进一步加剧了国际军控规则制定的复杂性。在此背景下，作为负责任的航天大国，中国可在完善《PPWT草案》的基础上，推动将地月空间纳入``专为和平目的''原则的适用范围，必要时可倡议修改《外空条约》。同时，应积极参与``软法''规则制定进程，寻求与美国在相关议题上的合作与协调，逐步构建``硬法''与``软法''相结合的综合性地月空间规则体系，为该区域活动的安全与稳定发展贡献力量。},
  langid = {chinese},
  annotation = {original-container-title: Aerospace China\\

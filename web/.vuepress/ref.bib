@article{chenDistantRetrogradeOrbits2022,
  title = {Distant Retrograde Orbits and Its Bifurcations in {{Earth-moon}} System},
  author = {Chen, Guanhua and Yang, Chihang and Zhang, Chen and Zhang, Hao},
  year = 2022,
  journal = {Beijing Hangkong Hangtian Daxue Xuebao/Journal of Beijing University of Aeronautics and Astronautics},
  volume = {Vol.48},
  number = {No.12},
  pages = {2576--2588},
  abstract = {There exists a type of stable retrograde orbit around the Moon called distant retrograde orbit (DRO) in the Earth-Moon system. The circular restricted three-body problem (CR3BP) is taken as the dynamical model to study the dynamical structure around DRO. It is possible to determine the bifurcation point and type using Broucke's stability diagram. The numerical continuation method is used to calculate several new orbital branches. Tangent and multi-period bifurcations are the two primary forms of DRO bifurcations (starting from period tripling). New orbit families include planar orbits and 3D orbits. The characteristics of the new orbit family are discussed, including shape, period, energy, stability, hyperbolic manifold structure. The relationship between orbital period and energy is discussed. The bifurcation structure and the hyperbolic manifold structure of multi-periodic orbits are presented geometrically. The dynamic structure will provide theoretical support for the mission based on DRO families.},
  langid = {english},
  keywords = {bifurcation,distant retrograde orbit,multi-period orbit,numerical continuation,orbital stability},
  annotation = {titleTranslation: 地月系统中的远距离逆行轨道及其分岔}
}

@article{chenDynamicPathPlanning2026,
  title = {A Dynamic Path Planning and Tracking Control of Autonomous Vehicles: An Integrated Approach Using Improved A*, Fuzzy {{DWA}}, and Fuzzy {{PID}}},
  shorttitle = {A Dynamic Path Planning and Tracking Control of Autonomous Vehicles},
  author = {Chen, Hao and Wang, Xiuyang and Wei, Chongfeng and Hu, Chuan and Zhang, Xi},
  year = 2026,
  journal = {IEEE Transactions on Automation Science and Engineering},
  volume = {23},
  pages = {2800--2813},
  issn = {1558-3783},
  doi = {10.1109/TASE.2026.3653413},
  urldate = {2026-04-23},
  abstract = {This paper presents a systematic investigation into path planning and trajectory tracking for autonomous vehicles. By integrating an improved A \textasciicircum\textbackslash ast algorithm, a fuzzy dynamic window approach, and a Fuzzy PID control strategy, the proposed method enables effective driving of an autonomous vehicle. Firstly, in the global path planning phase, to address the issues of low computational efficiency and suboptimal path quality in traditional A \textasciicircum\textbackslash ast algorithms for large-scale map searches, an improved A \textasciicircum\textbackslash ast algorithm incorporating an enhanced heuristic function, redundant node removal strategy, and path smoothing approach is introduced, significantly increasing search efficiency and optimizing path quality. Secondly, in the local path planning phase, the dynamic adjustment of vehicle speed and steering is achieved by combining fuzzy logic control with the dynamic window approach. This allows for smooth obstacle avoidance in dynamic environments. Furthermore, a path smoothing algorithm is integrated to refine the generated trajectory, ensuring its continuity and smoothness. Finally, a Fuzzy PID control algorithm is integrated into the trajectory tracking controller. By introducing fuzzy logic, the PID parameters are adaptively adjusted to ensure precise vehicle following of the planned path, improving path tracking stability and response speed. The proposed method is validated and evaluated in a variety of complex road scenarios using a real vehicle based on ROS. The simulation and real-world experimental results clearly illustrate that the proposed method achieves substantially better performance than conventional approaches with regard to path planning efficiency, obstacle avoidance success rate, and path smoothness. Note to Practitioners---This paper is motivated to provide a quick and responsive path planning and trajectory tracking autonomous method for Ackermann models that can arrive at the destination from the beginning point without encountering any unforeseen obstacles. The current graph search-based A \textasciicircum\textbackslash ast algorithm for global path planning is inefficient and prone to too many inflection points; The DWA algorithm, which performs well in real-time, is inefficient for local obstacle avoidance because of its fixed evaluation function, and the conventional PID algorithm has poor tracking accuracy in complex scenes. In order to solve the above problems, this paper proposes an improved A \textasciicircum\textbackslash ast algorithm integrating heuristic function, Douglas-Peucker node optimization algorithm and B-spline smoothing algorithm, which effectively improves the global path planning efficiency. A Fuzzy DWA algorithm with two inputs and three outputs is designed for local path planning to improve the stability of dynamic obstacle avoidance, and a B-spline algorithm is subsequently employed to smooth the selected trajectory, thereby enhancing the stability and fluidity of the vehicle's motion. Finally, the accuracy of trajectory tracking is improved by designing the three key parameters of PID when the fuzzy rule can be dynamically adjusted when facing different scenes. In our follow-up research, we will further optimize the existing algorithms and integrate sensors with higher accuracy for autonomous driving in more complex road environments.},
  langid = {english},
  keywords = {Accuracy,autonomous vehicle,Autonomous vehicles,Collision avoidance,fuzzy DWA,fuzzy PID,Heuristic algorithms,improved A* algorithm,Path planning and tracking control,Real-time systems,Smoothing methods,Splines (mathematics),Trajectory,Trajectory tracking,Vehicle dynamics},
  annotation = {titleTranslation: 自动驾驶车辆动态路径规划与跟踪控制：一种融合改进A*、模糊DWA与模糊PID的集成方法\\
abstractTranslation: 本文对自主车辆的路径规划与轨迹跟踪问题进行了系统性研究。通过融合改进的A\textasciicircum *算法、模糊动态窗口法与模糊PID控制策略，所提出的方法能够有效实现自主车辆的驾驶。首先，在全局路径规划阶段，针对传统A\textasciicircum *算法在大规模地图搜索中计算效率低且路径质量欠佳的问题，引入了一种改进的A\textasciicircum *算法，该算法包含增强型启发函数、冗余节点剔除策略及路径平滑方法，显著提升了搜索效率并优化了路径质量。其次，在局部路径规划阶段，通过将模糊逻辑控制与动态窗口法相结合，实现了车辆速度与转向的动态调节，从而在动态环境中实现平稳避障。此外，集成了一种路径平滑算法对生成的轨迹进行优化，确保其连续性与平滑性。最后，将模糊PID控制算法融入轨迹跟踪控制器中，通过引入模糊逻辑自适应调整PID参数，确保车辆精确跟随规划路径，提升了路径跟踪的稳定性与响应速度。所提出的方法在基于ROS的实车上，于多种复杂道路场景下进行了验证与评估。仿真与实际实验结果清晰表明，相较于传统方法，该方法在路径规划效率、避障成功率及路径平滑度方面均取得了显著更优的性能。\\
\\
致实践者------本文旨在为阿克曼模型提供一种快速响应的自主路径规划与轨迹跟踪方法，使其能从起点到达终点而不遭遇任何意外障碍。当前基于图搜索的A\textasciicircum *算法用于全局路径规划时效率低下且易产生过多拐点；DWA算法虽实时性较好，但因评估函数固定而局部避障效率不足；传统PID算法在复杂场景下跟踪精度较差。为解决上述问题，本文提出了一种融合启发函数、Douglas-Peucker节点优化算法及B样条平滑算法的改进A\textasciicircum *算法，有效提升了全局路径规划效率。针对局部路径规划，设计了一种双输入三输出的模糊DWA算法，以提高动态避障的稳定性，并随后采用B样条算法对选定轨迹进行平滑处理，从而增强车辆运动的稳定性与流畅性。最后，通过设计模糊规则使其在不同场景下能动态调整PID的三个关键参数，提升了轨迹跟踪的精度。在后续研究中，我们将进一步优化现有算法，并集成更高精度的传感器，以应对更复杂道路环境下的自动驾驶。},
  file = {/home/ouyangjiahong/Zotero/storage/JMMM7B8Z/Chen 等 - 2026 - A dynamic path planning and tracking control of autonomous vehicles an integrated approach using im.pdf}
}

@inproceedings{chenEarthmoonSpaceDRO2024,
  title = {Earth-Moon Space {{DRO}} Calculation Based on the Optimization Algorithm},
  booktitle = {2024 10th {{Asia Conference}} on {{Mechanical Engineering}} and {{Aerospace Engineering}} ({{MEAE}})},
  author = {Chen, Yujie and Zhu, Yanwei and Chan, Meichen and Qiao, Chenyuan and Qiu, Haipeng and Zhang, Chengming},
  year = 2024,
  series = {2024 10th {{Asia Conference}} on {{Mechanical Engineering}} and {{Aerospace Engineering}} ({{MEAE}})},
  address = {Taichang, China},
  doi = {10.1109/MEAE62008.2024.11026586},
  abstract = {The Distant Retrograde Orbits (DROs) in Earth-Moon space have attracted a large amount of attention because of its strategic position in Earth-Moon space and its excellent stability. The efficient and highly accurate solution of the DROs is a crucial step in the design of DROs. In this paper, DRO calculation method based on the differential evolution algorithm is proposed. The objective function is the position and velocity demand after half a period of orbit propagation. The two parameters of orbit period and Y-direction velocity are optimized simultaneously. Compared with the traditional differential correction method, this optimization method can converge without solving high-precision approximate solutions, which is more concise and efficient. In the meanwhile, this method can maintain the same solution accuracy and orbit stability than the traditional differential correction method. In this study, the stability, Jacobi energy, precision and other indexes are analyzed between traditional differential correction and the optimization method.},
  langid = {english},
  annotation = {titleTranslation: 基于优化算法的地月空间DRO轨道计算},
  file = {/home/ouyangjiahong/Zotero/storage/2DPGWFNE/Chen 等 - 2024 - Earth-moon space DRO calculation based on the optimization algorithm.pdf}
}


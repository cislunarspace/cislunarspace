@article{bertrandNewSmoothingTechniques2002a,
  title = {New Smoothing Techniques for Solving Bang--Bang Optimal Control Problems---Numerical Results and Statistical Interpretation},
  author = {Bertrand, R. and Epenoy, R.},
  year = 2002,
  journal = {Optimal Control Applications and Methods},
  volume = {23},
  number = {4},
  pages = {171--197},
  issn = {1099-1514},
  doi = {10.1002/oca.709},
  urldate = {2026-03-19},
  abstract = {In this paper, we investigate the solution of bang-bang optimal control problems by shooting methods. We will show how modifying the performance index by a term depending on a small parameter {$\varepsilon$} yields more regular controls and shooting functions. A continuation procedure on {$\varepsilon$} will lead us to a good approximation of the initial solution. Then, a statistical interpretation of the method is given, providing us with a general framework for building new regular controls. Finally, two numerical examples are solved illustrating the interest of our method. Copyright \copyright{} 2002 John Wiley \& Sons, Ltd.},

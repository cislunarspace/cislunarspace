@inproceedings{fedelerLunarObserverEfficacy2022,
  title = {Lunar Observer Efficacy for {{NRHO}} Target Tracking},
  booktitle = {73rd {{International Astronautical Congress}}, {{IAC}} 2022},
  author = {Fedeler, Samuel J. and Holzinger, Marcus J. and Whitacre, William},
  year = 2022,
  address = {Paris},
  abstract = {As objects proliferate the near-lunar environment, there is a pressing need for novel ways to maintain state estimates across the growing population. A Monte Carlo Tree Search (MCTS)based method is presented as a means to task sets of observers to track known space objects. Specific focus in this work is given to lunar observers, which offer a combination of high angular resolution and a breadth of viewing angles for Halo orbits. Methods are applied with consideration for maneuvering objects, leveraging knowledge of maneuver feasibility and behaviors indicative of dynamics mismodeling observed through measurement residuals. A novel indicator for viability of both stationkeeping and departure maneuvers is presented utilizing the Cauchy Green stress tensor (CGT). The unscented Optimal Control Based Estimator (U-OCBE) is utilized in tandem with a novel smoother for evaluating dynamics mismodeling. Results are then presented for several cases comparing uniform observational cadences and MCTS-based tasking. The methods are demonstrated to be robust for scenarios in which stationkeeping maneuvers are convoluted with large injection errors. Combined, the results demonstrate the utility of both MCTS and the developed heuristics for maintaining custody of space objects in a previously challenging tracking problem. These results reveal that lunar observers may act as critical resources for supporting high priority spacecraft in the cislunar domain.},
  langid = {english},
  annotation = {titleTranslation: 月球观测器对近直线晕轨道目标跟踪效能}
}


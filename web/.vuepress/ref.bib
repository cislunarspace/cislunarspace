@inproceedings{capannoloMinimumCostRelative2020,
  title = {Minimum Cost Relative Dynamics in Cislunar Environment},
  booktitle = {71st {{International Astronautical Congress}}, {{IAC}} 2020},
  author = {Capannolo, Andrea and Lavagna, Mich{\`e}le},
  year = 2020,
  address = {Virtual, Online},
  abstract = {The last decade has been characterized by a renewed interest in human exploration of the solar system, which brought to the creation of a thorough roadmap for the next Moon and Mars manned missions. The Artemis program represents the first step towards that goal, aiming at bringing the humankind back on the Lunar surface by 2024, and laying the foundations for the future exploration and colonization of Mars. Among the objectives, the program started developing a station orbiting around the Moon (Gateway), to serve as home base for astronauts expeditions and as infrastructure for Moon and deep space science. The station will orbit on a Nearly-Rectilinear Halo Orbit (NRHO), generated by the Earth-Moon binary system gravity, that exposes the spacecraft to lunar proximity as well as to deep space environment. The selected trajectory provides several advantages, such as accessibility to various deep space destinations, continuous visibility from Earth, and low orbital maintenance costs. Nevertheless, the complexity of the multibody environment requires a detailed study on the dynamics in the surroundings of the target orbit. In particular, the Gateway will pose the challenge of performing relative maneuvers around the station, to allow approach and departure of spacecraft. The paper explores the topic of relative orbital transfers around NRHO, in the framework of the Circular Restricted Three-Body Problem (CRTBP). By leveraging the invariant tori formulation, quasi periodic orbit families are developed around the NRHO, to provide a natural bounded motion of the spacecraft targeting the Gateway. Then, tori surfaces are exploited to develop relative transfers through homoclinic connections, by departing from the surface and returning to it at the desired location. Three transfer strategies are explored and compared, leveraging two maneuvers first, then introducing a third mid-maneuver, initially centered at half of the transfer time and then shifted to optimize costs. Cost maps are drawn to identify cheapest transfers, and their relations with relative positions of spacecraft are identified to provide a basis for the development of a guidance strategy.},
  langid = {english},
  annotation = {titleTranslation: 地月环境中最小成本相对动力学}
}

@article{capannoloModelPredictiveControl2023,
  title = {Model Predictive Control for Formation Reconfiguration Exploiting Quasi-Periodic Tori in the Cislunar Environment},
  author = {Capannolo, Andrea and Zanotti, Giovanni and Lavagna, Mich{\`e}le and Cataldo, Giuseppe},
  year = 2023,
  journal = {Nonlinear Dynamics},
  volume = {Vol.111},
  number = {No.8},
  pages = {6941--6959},
  issn = {0924-090X},
  doi = {10.1007/s11071-022-08214-8},
  abstract = {Given the numerous possibilities that formation flying space missions can enable, being able to design and govern relative trajectories in this scenario is fundamental. Particularly interesting, due to the installation and operation of the Lunar Gateway, which will represent the next human outpost in the cislunar environment, will be the exploitation of formation flying missions in the vicinity of this lunar station. The nonlinear dynamics by which the Earth-Moon system is characterised offers the possibility to find bounded relative trajectories which can be used to design the formation. In order to best exploit the formation potential, some reconfiguration manoeuvres can be used, which by changing the relative geometry can increase the versatility and adaptation of the mission. In this paper, a Model Predictive Guidance and Control strategy is proposed and applied to perform rephasing manoeuvres in the harsh environment of the Near Rectilinear Halo Orbits. By including first a limited thrust constraint and then a collision avoidance, a more mission-oriented approach is provided to the system. To further increase the robustness of the on-board algorithms, an adaptive logic is provided to the different tuning weights involved in the Model Predictive Control scheme. In this way, a more flexible system is obtained, which is capable of optimally working also in the presence of a high-fidelity simulation scenario, including discrepancies with the simplified on-board dynamical model.},
  langid = {english},
  keywords = {Formation flying,Model predictive control,Multi-body gravitational dynamics,Quasi-periodic Tori},
  annotation = {titleTranslation: 基于地月空间准周期不变环的编队重构模型预测控制\\
abstractTranslation: 鉴于编队飞行空间任务所能实现的诸多可能性，在此类场景中设计与控制相对轨迹是基础性的。尤为引人关注的是，随着月球门户（Lunar Gateway）的部署与运行------这将成为地月空间中的下一个人类前哨站------利用该月球站附近的编队飞行任务将具有重要意义。地月系统所特有的非线性动力学特性，为寻找可用于设计编队的有界相对轨迹提供了可能。为充分挖掘编队潜力，可采用若干重构机动，通过改变相对几何构型来提升任务的多功能性与适应性。本文提出一种模型预测制导与控制策略，并将其应用于近直线型晕轨道（Near Rectilinear Halo Orbits）这一严苛环境中的相位调整机动。通过首先引入有限推力约束，进而加入碰撞规避机制，为系统提供了更具任务导向性的方案。为进一步增强星上算法的鲁棒性，针对模型预测控制方案中不同的调谐权重引入自适应逻辑。由此，获得了一个更加灵活的系统，即使在存在与简化星上动力学模型偏差的高保真仿真场景下，也能实现最优运行。}
}


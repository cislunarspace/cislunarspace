@inproceedings{humiClosedFormSolution2004,
  title = {Closed- Form Solution of the Orbit Equation for near- Circular or near- Rectilinear Arcs with Drag},
  booktitle = {American {{Institute}} of {{Aeronautics}} and {{Astronautics Guidance}}, {{Navigation}}, and {{Control Conference}}},
  author = {Humi, Mayer and Carter, Thomas},
  year = 2004,
  address = {Providence, RI, United States},
  doi = {10.2514/6.2004-5302},
  abstract = {This paper considers the restricted two-body problem in the presence of drag that varies with a power of the magnitude of the velocity. In general the orbit equation for this problem is an integro-differential equation. For extreme cases in which the motion is mostly tangential or mostly radial and the drag varies with the square of the magnitude of the velocity, conditions are found in which the orbit equation can be transformed to an ordinary differential equation. For a model atmosphere in which the density varies as I/R**2 where R is the distance from the center of attraction we provide closed-form solutions to this differential equation. This extends previous work in which the density of the model atmosphere varies as 1/ R. 13 Refs.},
  langid = {english},
  annotation = {titleTranslation: 近圆或近直线弧段带阻力轨道方程的闭合形式解}
}

@article{humiDesignSatelliteOrbits2024,
  title = {Design of Satellite Orbits in the Sun--Earth--Moon System},
  author = {Humi, Mayer},
  year = 2024,
  month = dec,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {6},
  pages = {48--60},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10220-4},
  urldate = {2025-10-01},
  abstract = {The treatment of the restricted three-body problem and its application to satellites in close Earth orbits appeared in many research papers and monographs. However for more general satellite orbits which circle between the Earth and the Moon, the impact of the Sun presence cannot be ignored and one has to consider these orbits in the context of the restricted fourbody problem. For such satellites, we present in this paper a procedure that can be used to evaluate the thrust that is needed to keep them in a specified orbit. Specifically, we apply this procedure to two families of orbits which circle around the Earth and the Moon. The first family consists of elliptic orbits while the second consists of orbits in the shape of the figure eight (which resemble the orbit to be used by NASA for the Artemis project). We observe that in this paper we shall consider only satellite orbits in the Sun--Earth--Moon system. However, the methods described hereby can be adapted to other restricted four-body problems.},
  langid = {english},
  annotation = {titleTranslation: 日地月系统中的卫星轨道设计\\
abstractTranslation: 限制性三体问题的处理及其在近地轨道卫星中的应用已出现在众多研究论文和专著中。然而，对于在地球与月球之间运行的更一般卫星轨道，太阳存在的影响不可忽略，必须在限制性四体问题的背景下考虑这些轨道。针对此类卫星，本文提出了一种可用于评估维持其指定轨道所需推力的方法。具体而言，我们将该方法应用于环绕地球与月球的两类轨道族：第一类为椭圆轨道，第二类为数字8形轨道（与NASA Artemis项目计划采用的轨道相似）。需指出的是，本文仅考虑日-地-月系统中的卫星轨道，但文中所述方法可适用于其他限制性四体问题。},
  file = {/home/ouyangjiahong/Zotero/storage/ILKFHF8Q/Humi - 2024 - Design of satellite orbits in the sun–earth–moon system.pdf}
}


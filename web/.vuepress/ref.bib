@article{perez-palauFuelOptimizationLowthrust2018,
  title = {Fuel Optimization for Low-Thrust {{Earth}}--{{Moon}} Transfer via Indirect Optimal Control},
  author = {{P{\'e}rez-Palau}, Daniel and Epenoy, Richard},
  year = 2018,
  month = feb,
  journal = {Celestial Mechanics and Dynamical Astronomy},
  volume = {130},
  number = {2},
  pages = {21},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-017-9808-2},
  urldate = {2025-09-25},
  abstract = {The problem of designing low-energy transfers between the Earth and the Moon has attracted recently a major interest from the scientific community. In this paper, an indirect optimal control approach is used to determine minimum-fuel low-thrust transfers between a low Earth orbit and a Lunar orbit in the Sun--Earth--Moon Bicircular Restricted FourBody Problem. First, the optimal control problem is formulated and its necessary optimality conditions are derived from Pontryagin's Maximum Principle. Then, two different solution methods are proposed to overcome the numerical difficulties arising from the huge sensitivity of the problem's state and costate equations. The first one consists in the use of continuation techniques. The second one is based on a massive exploration of the set of unknown variables appearing in the optimality conditions. The dimension of the search space is reduced by considering adapted variables leading to a reduction of the computational time. The trajectories found are classified in several families according to their shape, transfer duration and fuel expenditure. Finally, an analysis based on the dynamical structure provided by the invariant manifolds of the two underlying Circular Restricted Three-Body Problems, Earth--Moon and Sun--Earth is presented leading to a physical interpretation of the different families of trajectories.},
  langid = {english},
  annotation = {titleTranslation: 基于间接最优控制的低推力地月转移燃料优化\\
abstractTranslation: 地球与月球之间低能耗转移轨道设计问题近年来引起了科学界的高度关注。本文采用间接最优控制方法，在日-地-月双圆限制四体问题框架下，确定低地球轨道与月球轨道之间最小燃料消耗的低推力转移方案。首先，建立最优控制问题模型，并基于庞特里亚金极大值原理推导其最优性必要条件。随后，针对系统状态方程与协态方程存在的高敏感性引发的数值困难，提出两种不同的求解方法：第一种方法采用延拓技术；第二种方法通过对最优性条件中未知变量集合进行大规模搜索实现，通过引入适配变量降低搜索空间维度，从而缩短计算时间。根据轨道形状、转移时长及燃料消耗特征，所得轨道分为若干类别。最后，基于地-月系统和日-地系统两类经典圆限制三体问题中不变流形提供的动力学结构，对各类轨道的物理机理进行了解释分析。},
  file = {/home/ouyangjiahong/Zotero/storage/93LKQW8J/Pérez-Palau和Epenoy - 2018 - Fuel optimization for low-thrust Earth–Moon transfer via indirect optimal control.pdf}
}


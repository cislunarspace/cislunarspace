@article{villacEscapingTrajectoriesHill2003,
  title = {Escaping Trajectories in the Hill Three-Body Problem and Applications},
  author = {Villac, Benjamin F and Scheeres, Daniel Jay},
  year = 2003,
  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {26},
  number = {2},
  pages = {224--232},
  doi = {10.2514/2.5062},
  abstract = {Low-energy escaping trajectories in the Hill three-body problem are investigated numerically using a Poincare\'  map that relates the crossing of a plane containing one of the collinear libration points back to the rst periapsis passage. This set of periapsis points is con ned in a small region that determines some conditions for escape from any planetary satellite. In particular, the minimum energy to escape from a given circular orbit is obtained together with restrictions on the initial conditions (inclination, argument of periapsis, and longitude of the ascending node). This leads to a new optimal transfer criterion for the class of directly escaping trajectories. Savings on the order of 130 m/s in the case of Europa are obtained when compared to a classic two-body model. The results are also extended to the problem of low-energy capture. Numerical applications are given for the cases of Miranda, Europa, Titan, and Triton.},
  langid = {english},
  annotation = {titleTranslation: 希尔三体问题中的逃逸轨道及其应用\\
abstractTranslation: 低能逃逸轨道在希尔三体问题中通过庞加莱映射进行数值研究，该映射将穿越某一共线平动点所在平面的轨道与首次近心点通过联系起来。这一近心点集合局限于一个小区间内，该区间决定了从任何行星卫星逃逸的若干条件。特别地，从给定圆轨道逃逸所需的最小能量得以获得，同时明确了初始条件（倾角、近心点幅角及升交点黄经）的限制。由此得出直接逃逸轨道类别的一个新最优转移判据。与经典二体模型相比，在欧罗巴案例中可节省约130米/秒的速度增量。该结果还扩展至低能捕获问题。文中给出了米兰达、欧罗巴、土卫六和海卫一数值应用实例。},
  file = {/home/ouyangjiahong/Zotero/storage/D8F6AAGE/Villac和Scheeres - 2003 - Escaping trajectories in the hill three-body problem and applications.pdf}
}

@inproceedings{villacImpulsiveTransferStrategies2008,
  title = {Impulsive Transfer Strategies along Stable Periodic Orbit Families},
  booktitle = {{{AAS}}/{{AIAA}} 18th {{Space Flight Mechanics Meeting}}},
  author = {Villac, B. F.},
  year = 2008,
  series = {{{AAS}}/{{AIAA}} 18th {{Space Flight Mechanics Meeting}}},
  address = {Galveston, TX},
  abstract = {This paper describes some impulsive transfer strategies that generalize the classic Hohmann transfers and allow us to robustly guide a spacecraft along stable, natural families of periodic orbits. Such families often represent a safe and stable pathway from different regimes of motion in an otherwise unstable orbital environment. The proposed strategies thus ensure strong stability and recovery proper-ties of spacecraft transfers for risk sensitive missions. As a result, this research should be useful for missions planning with constraining back-up options requirements. Examples of transfers along distant retrograde families in the neighborhood of the Jupiter's moon Europa are considered.},
  langid = {english},
  annotation = {titleTranslation: 沿稳定周期轨道族的脉冲式转移策略}

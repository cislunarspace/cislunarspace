@article{chenAutonomousOrbitDetermination2025,
  title = {Autonomous Orbit Determination of {{LLO}} Satellite Using {{DRO}}--{{LLO}} Links and Lunar Laser Ranging},
  author = {Chen, Shixu and Li, Shuanglin and Pu, Jinghui and Xu, Yingjie and Wang, Wenbin},
  year = 2025,
  journal = {Aerospace},
  volume = {Vol.12},
  number = {No.7},
  pages = {576},
  doi = {10.3390/aerospace12070576},
  abstract = {A stable and high-precision autonomous orbit determination scheme for a Low Lunar Orbit (LLO) spacecraft is proposed, leveraging satellite-to-satellite tracking (SST) measurement data and lunar laser ranging data. One satellite orbits around the LLO, while the other satellite orbits around the Distant Retrograde Orbit (DRO). An inter-satellite ranging link is established between the two satellites, while the LLO satellite conducts laser ranging with a Corner Cube Reflector (CCR) on the lunar surface. Both inter-satellite ranging data and lunar laser ranging data are acquired through measurements. By integrating these data with orbital dynamics and employing the Extended Kalman Filter (EKF) method, the position and velocity states of the two formation satellites are estimated. This orbit determination scheme operates independently of ground measurement and control stations, achieving a high degree of autonomy. Simulation results demonstrate that the position accuracy of the LLO satellite can reach 0.1 m, and that of the DRO satellite can reach 10 m. Compared to the autonomous orbit determination scheme relying solely on SST measurement data, this proposed scheme exhibits several advantages, including shorter convergence time, higher convergence accuracy, and enhanced robustness of the navigation system against initial orbit errors and orbital dynamic model errors. It can provide a valuable engineering reference for the autonomous navigation of lunar-orbiting satellites.},
  langid = {english},
  keywords = {autonomous orbit determination,DRO,LiAISON,LLO,lunar laser ranging},
  annotation = {titleTranslation: 利用DRO-LLO链路与月球激光测距实现低月球轨道卫星自主定轨\\
abstractTranslation: 提出了一种基于卫星对卫星跟踪测量数据与月球激光测距数据的低月球轨道航天器稳定高精度自主定轨方案。其中一颗卫星运行于低月球轨道，另一颗卫星运行于远距离逆行轨道。两颗卫星之间建立星间测距链路，同时低月球轨道卫星与月球表面的角反射器进行激光测距。通过测量获取星间测距数据与月球激光测距数据。结合轨道动力学与扩展卡尔曼滤波方法，对这两颗编队卫星的位置与速度状态进行估计。该定轨方案不依赖地面测控站，实现了高度自主性。仿真结果表明，低月球轨道卫星的位置精度可达0.1米，远距离逆行轨道卫星的位置精度可达10米。与仅依靠星间测距数据的自主定轨方案相比，所提方案具有收敛时间短、收敛精度高、导航系统对初始轨道误差和轨道动力学模型误差的鲁棒性更强等优势，可为月球轨道卫星的自主导航提供有价值的工程参考。}
}

@article{chenCalculatingQuasiperiodicDistant2024,
  title = {Calculating the Quasi-Periodic Distant Retrograde Orbit under the Ephemeris Model Based on the Adaptive Two-Level Differential Correction},
  author = {Chen, Yujie and Zhu, Yanwei and Chan, Meichen and Qiao, Chenyuan and Qiu, Haipeng},
  year = 2024,
  month = dec,
  journal = {Astrophysics and Space Science},
  volume = {369},
  number = {12},
  pages = {123},
  issn = {1572-946X},
  doi = {10.1007/s10509-024-04390-8},
  abstract = {Research on the dynamics of multi-body motion in the Earth-Moon space is a crucial area in current spacecraft motion studies. Distant Retrograde Orbits (DROs) are highly valuable trajectories in the Earth-Moon space. Under the ephemeris model, DROs will become quasi-periodic. Efficiently computing quasi-periodic DROs in the ephemeris model is a pressing issue. This paper addresses the problems of high computational time cost and significant divergence over multiple orbit cycles when calculating quasi-periodic DROs under the ephemeris model and proposes an adaptive two-level differential correction algorithm based on differential evolution. The traditional two-level differential correction selects patch points at equal intervals, while the DRO states are different with different amplitudes, choosing patch points at equal intervals is simple but not suitable for most DRO. Each quasi-periodic DRO should have its own patch points position. The adaptive two-level differential correction algorithm firstly uses differential evolution to obtain the optimal solution of the position of the patch points and then two-level differential correction is played. This algorithm significantly improving both computational efficiency and orbital convergence. Simulation results show that this algorithm significantly reduces computational costs and achieves better convergence compared to traditional two-level differential correction algorithm. This study has a reference value for the design of long-term quasi-periodic DRO, and provides a new idea for the selection strategy of patch points in the two-level differential correction algorithm and the multiple shooting algorithm.},
  langid = {english},
  keywords = {Differential evolution algorithm,Distant retrograde orbit (DRO),Ephemeris model,Two-level differential correction},
  annotation = {titleTranslation: 基于自适应两级微分修正的星历模型下准周期远距离逆行轨道计算\\
abstractTranslation: 地月空间多体运动动力学研究是当前航天器运动学的重要领域。远距离逆行轨道（DRO）是地月空间中极具价值的轨迹类型。在星历模型下，DRO会呈现准周期特性。如何在星历模型中高效计算准周期DRO是亟待解决的问题。本文针对星历模型下准周期DRO计算耗时高、多圈次发散明显的问题，提出了一种基于差分进化的自适应双层微分校正算法。传统双层微分校正算法在拼接点选取时采用等间隔方式，而DRO状态随振幅不同存在差异，等间隔选取方式虽简单却不适用于多数DRO。每个准周期DRO应有其对应的最优拼接点位置。自适应双层微分校正算法首先通过差分进化获取拼接点位置的最优解，再执行双层微分校正。该算法显著提升了计算效率与轨道收敛性。仿真结果表明，相较于传统双层微分校正算法，本算法在保证精度的同时大幅降低了计算成本，并实现了更优的收敛效果。本研究对长期准周期DRO轨道设计具有参考价值，并为双层微分校正算法及多重打靶算法中的拼接点选取策略提供了新思路。},
  file = {/home/ouyangjiahong/Zotero/storage/32ZJGTPQ/Chen 等 - 2024 - Calculating the quasi-periodic distant retrograde orbit under the ephemeris model based on the adapt.pdf}
}


@article{sunDeepLearningBasedRadar2021,
  title = {Deep Learning-Based Radar Composite Reflectivity Factor Estimations from Fengyun-{{4A}} Geostationary Satellite Observations},
  author = {Sun, Fenglin and Li, Bo and Min, Min and Qin, Danyu},
  year = 2021,
  month = jun,
  journal = {Remote Sensing},
  volume = {13},
  number = {11},
  pages = {2229},
  issn = {2072-4292},
  doi = {10.3390/rs13112229},
  urldate = {2026-05-11},
  abstract = {Ground-based weather radar data plays an essential role in monitoring severe convective weather. The detection of such weather systems in time is critical for saving people's lives and property. However, the limited spatial coverage of radars over the ocean and mountainous regions greatly limits their effective application. In this study, we propose a novel framework of a deep learning-based model to retrieve the radar composite reflectivity factor (RCRF) maps from the Fengyun-4A new-generation geostationary satellite data. The suggested framework consists of three main processes, i.e., satellite and radar data preprocessing, the deep learning-based regression model for retrieving the RCRF maps, as well as the testing and validation of the model. In addition, three typical cases are also analyzed and studied, including a cluster of rapidly developing convective cells, a Northeast China cold vortex, and the Super Typhoon Haishen. Compared with the high-quality precipitation rate products from the integrated Multi-satellite Retrievals for Global Precipitation Measurement, it is found that the retrieved RCRF maps are in good agreement with the precipitation pattern. The statistical results show that retrieved RCRF maps have an R-square of 0.88-0.96, a mean absolute error of 0.3-0.6 dBZ, and a root-mean-square error of 1.2-2.4 dBZ.},
  langid = {english},
  annotation = {titleTranslation: 基于深度学习的风云四号A星静止卫星观测雷达组合反射率因子估计\\
abstractTranslation: 地基天气雷达数据在监测强对流天气中发挥着至关重要的作用，及时探测此类天气系统对于保护人民生命财产安全至关重要。然而，雷达在海洋和山区的空间覆盖范围有限，极大地限制了其有效应用。本研究提出了一种基于深度学习模型的新框架，用于从风云四号新一代静止卫星数据中反演雷达组合反射率因子（RCRF）图。该框架包括三个主要过程：卫星与雷达数据预处理、基于深度学习的RCRF图反演回归模型，以及模型的测试与验证。此外，还分析研究了三个典型个例，包括一组快速发展的对流单体、东北冷涡以及超强台风``海神''。与集成多卫星反演的全球降水测量高质量降水率产品相比，反演得到的RCRF图与降水分布高度一致。统计结果显示，反演的RCRF图决定系数为0.88--0.96，平均绝对误差为0.3--0.6 dBZ，均方根误差为1.2--2.4 dBZ},
  file = {/home/ouyangjiahong/Zotero/storage/2SUDMZC4/Sun 等 - 2021 - Deep learning-based radar composite reflectivity factor estimations from fengyun-4A geostationary sa.pdf}
}


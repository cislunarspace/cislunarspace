@phdthesis{topolcsikEfficientOpticalNavigation2025,
  type = {博士论文},
  title = {An Efficient Optical Navigation Model for Cislunar Exploration: Limits of Horizon-Based Autonomy},
  shorttitle = {An Efficient Optical Navigation Model for Cislunar Exploration},
  author = {Topolcsik, Emma R.},
  year = 2025,
  journal = {ProQuest Dissertations and Theses},
  abstract = {With the expanding plans for lunar missions in the space industry, there is a demand for low-cost and performant navigation solutions in cislunar space (i.e., Earth-Moon system). Supporting missions with ground communications drives up costs and limits accessibility. Future cislunar missions will benefit from implementing autonomous capabilities, including optical navigation (OPNAV). However, evaluating the performance of OPNAV in cislunar space and performing comprehensive navigation analyses is computationally expensive: i.e., involving image generation, image processing (horizon detection), position estimation, and Kalman filtering. Previous literature has generated data and evaluated the performance of horizon-based position estimation algorithms. This thesis proposes to interpolate this pre-computed data, which allows efficient incorporation of high-fidelity position estimation measurements into a Kalman filter, for Monte Carlo analysis, and provides a thorough assessment of OPNAV performance in cislunar space through enabled lower-demand simulations. This work: (1) proposes and validates the interpolation of pre-computed grids of measurement errors as a function of observation geometry, distance, and time, (2) provides a solution to and assesses the performance of measurement bias estimation, and (3) provides insights into the navigation accuracies and limits of autonomous OPNAV along lunar distant retrograde orbits. Results demonstrated 1 - {$\sigma$} navigation accuracies from 0.037--58.73 km for a family of DROs up to 125,526 km in size. Measurement bias was found to increase linearly with DRO size, resulting in a quadratic increase in navigation error. A line of best fit was developed to approximate OPNAV performance expectations for DROs within 20,000--130,000 km. Future work should investigate the factors contributing to the framework's sensitivity, with particular emphasis on the impacts of bias process noise and orbital position. The proposed approach, results, and discussion in this study will prove valuable to future cislunar space missions featuring OPNAV and provide an efficient analysis tool and comprehensive study of OPNAV capabilities for a new era of space exploration.},
  isbn = {9798293817962},
  langid = {english},
  school = {Purdue University},
  keywords = {0216:Computational physics,0367:Aeronomy,0538:Aerospace engineering,Aeronomy,Aerospace engineering,Cislunar space,Computational physics,Horizon detection,Space exploration},
  annotation = {titleTranslation: 一种用于地月探测的高效光学导航模型：基于地平线自主导航的局限性},
  file = {/home/ouyangjiahong/Zotero/storage/J537VAEK/Topolcsik - 2025 - An efficient optical navigation model for cislunar exploration limits of horizon-based autonomy.pdf}
}


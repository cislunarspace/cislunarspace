@article{galesModelingResonantDynamics2025,
  title = {Modeling the Resonant Dynamics of Infinitesimal Particles Orbiting Nonspherical Rotating Bodies},
  author = {Gale{\c s}, Catalin and Apetrii, Marius and Nadabaic{\u a}, Gabriela},
  year = 2025,
  month = oct,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},
  number = {5},
  pages = {28--70},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-025-10258-y},
  urldate = {2025-10-01},
  abstract = {Abstract                            This work proposes a model to investigate the resonant dynamics of infinitesimal particles orbiting a nonspherical rotating body (a planet, a dwarf planet or an asteroid), under the additional perturbations induced by the attraction of the Sun and the solar radiation pressure. Assuming that the nonspherical body rotates uniformly around a fixed axis and revolves around the Sun on a Keplerian orbit, the spherical harmonics approach is considered to model the gravitational potential of the nonspherical body and various expansions in terms of the orbital elements are used to model the third-body perturbations and the disturbances induced by the solar radiation pressure. Classifying the terms of expansions, two types of resonances that influence the dynamics around a nonspherical body are discussed. One type of resonance occurs whenever there is a commensurability between the orbital period of the infinitesimal particle and the rotation period of the nonspherical body. This is called a sectoral--tesseral resonance and its effects can be noticed on moderate time scales. We show that each sectoral--tesseral resonance splits into a multiplet of resonances that could overlap and lead to complex evolution of the orbital elements. The location of each component of the resonance multiplet is estimated analytically and the occurrence of phenomenon of resonance overlap is predicted. The other type of resonance, called secular, involves the frequency of slow angles and is due to the complex interaction between the oblateness of the nonspherical body, the attraction of the Sun and the solar radiation pressure. Although secular resonances are extensively studied in the Earth's environment, and recently in the Moon's environment, little attention is paid to understand their effects in case of dynamics around other solar system bodies. We classify the secular resonances and discuss their location in the parameter space and in the physical space. An averaged Hamiltonian, capable of characterizing the sectoral--tesseral resonances                                                   \$\$j:\textbackslash ell \$\$                                                               j                       :                       {$\ell$}                                                                                       , with                                                   \$\$j\textbackslash in \textbackslash\textbraceleft 1,2,3,4\textbackslash\textbraceright\$\$                                                               j                       {$\in$}                       \textbraceleft{}                       1                       ,                       2                       ,                       3                       ,                       4                       \textbraceright{}                                                                                       and                                                   \$\$\textbackslash ell \textbackslash in \textbackslash\textbraceleft 1,2,3\textbackslash\textbraceright\$\$                                                               {$\ell$}                       {$\in$}                       \textbraceleft{}                       1                       ,                       2                       ,                       3                       \textbraceright{}                                                                                       , and the secular resonances is derived. Finally, as an application of the derived Hamiltonian, the 1~:~1 sectoral--tesseral resonance around Vesta is discussed, showing how the components of the resonance multiplet overlap to generate a complex dynamical evolution of the orbital elements. In particular, a mechanism that leads to very fast and large-amplitude variations of eccentricity is analyzed, although the usual effect of sectoral--tesseral resonances is the variation of the semimajor axis.},
  langid = {english},
  annotation = {titleTranslation: 非球形旋转天体周围微粒子轨道共振动力学建模\\
abstractTranslation: 摘要  \\
本文提出一个模型，用于研究在太阳引力和太阳辐射压的附加摄动下，绕非球面旋转体（行星、矮行星或小行星）运行的无穷小粒子的共振动力学。假设该非球面体绕固定轴匀速自转，并沿开普勒轨道绕太阳公转，采用球谐函数方法描述非球面体的引力势，并利用轨道元素的多种展开形式来建模第三体摄动及太阳辐射压引起的扰动。通过对展开项进行分类，讨论了影响非球面体周围动力学的两类共振。其中一类共振发生在无穷小粒子的轨道周期与非球面体的自转周期成可公度关系时，称为扇形-田形共振，其效应可在中等时间尺度上观察到。研究表明，每个扇形-田形共振会分裂为多重共振，这些共振可能重叠并导致轨道元素的复杂演化。我们解析估算了共振多重态中各分量的位置，并预测了共振重叠现象的发生。另一类共振称为长期共振，涉及慢变角频率，由非球面体的扁率、太阳引力及太阳辐射压之间的复杂交互作用引起。尽管长期共振在地球环境中已被广泛研究，近期也在月球环境中有所探讨，但对其在太阳系其他天体周围动力学中的影响关注甚少。我们对长期共振进行分类，并讨论其在参数空间和物理空间中的位置。推导了一个平均哈密顿量，能够表征扇形-田形共振\$j:\textbackslash ell\$（其中\$j\textbackslash in\textbackslash\textbraceleft 1,2,3,4\textbackslash\textbraceright\$，\$\textbackslash ell\textbackslash in\textbackslash\textbraceleft 1,2,3\textbackslash\textbraceright\$）以及长期共振。最后，作为所推导哈密顿量的应用，讨论了Vesta周围的1:1扇形-田形共振，展示了共振多重态各分量如何重叠以产生轨道元素的复杂动力学演化。特别地，分析了一种导致偏心率发生极快且大幅变化的机制，尽管扇形-田形共振的通常效应是半长轴的变化。},
  file = {/home/ouyangjiahong/Zotero/storage/VHQRMSB9/Galeş 等 - 2025 - Modeling the resonant dynamics of infinitesimal particles orbiting nonspherical rotating bodies.pdf}
}

@article{gallbrechtMoonEffectivePropellant2024,
  title = {The Moon as an Effective Propellant Source: A Comprehensive Exergy Analysis from Extraction to Depot},
  shorttitle = {The Moon as an Effective Propellant Source},
  author = {Gallbrecht, M.M. and Cervone, A. and {Vincent-Bonnieu}, S.},
  year = 2024,
  month = may,
  journal = {Acta Astronautica},
  volume = {218},
  pages = {307--313},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2024.02.035},
  urldate = {2025-09-25},
  abstract = {Establishing a permanent lunar base has gained increasing attention since it offers opportunities for international cooperation and the commercialization of space, forming the foundation and testing ground for a human existence independent from Earth. Essential to future missions beyond cislunar space is the exploration and in situ processing of the Moon's resources, especially the sustainable production of energetic resources and propellants. Utilizing in situ generated propellants can dramatically reduce transportation costs by removing the need to source propellants from Earth. Resources on the Moon are limited, and the extraction of available resources are energy-intensive processes demanding advanced techniques and technologies. Consequently, one of the biggest challenges lies in developing process architectures with a positive energy balance, for which comprehensive analyses are still missing. The focus currently lies on the extraction of water ice from lunar regolith and the production of hydrogen and oxygen through water electrolysis. However, alternative fuel and process options may reduce the energy cost while providing equivalent energetic revenue. In the scope of this research, the infrastructure and technologies required for extraction, refining, and storing are assumed to exist in cislunar space; therefore, only the operating cost is considered. Exergy analyses of in situ extraction methods are conducted to investigate whether the required energetic budget allows sustainable implementation. The analysis includes extraction methods and propellant options to reveal the extent to which alternatives to hydrogen are feasible. Exergy analyses determine thermodynamic losses of energy flows giving the ground for process optimization. The exergy destructed represents the margin of improvement within the process architecture and thus reflects the process's thermodynamic and economic value while allowing a more distinct examination of energy use. Assuming the availability of water and carbon dioxide ice in permanently shadowed regions, the analysis shows that choosing methane instead of hydrogen in combination with oxygen as propellants can reduce the required exergy input by up to a third. An example mission allows to directly compare the operating cost of the extraction processes for the different propellant options. The mission entails a spacecraft propelled by a liquid bipropellant engine utilizing the extracted propellant and transporting a payload of the same propellant to a depot located in lunar near-rectilinear halo orbit (NRHO). Although abundant in space, the results suggest that hydrogen may not be the only or even energetically cost-effective resource for developing cislunar and Martian space infrastructures. Likewise, sustainable extraction of propellants suitable for current and future propulsion systems will foster humanity's reach further into the solar system.},
  langid = {english},
  keywords = {Depot,Economical,Exergy,Moon,Propellent},
  annotation = {titleTranslation: 月球作为高效推进剂来源：从提取到存储的全面㶲分析\\
abstractTranslation: 建立永久性月球基地正日益受到关注，因为它为国际航天合作与空间商业化提供了契机，并成为人类脱离地球独立生存的基础与试验场。地月空间以外的未来任务，关键在于月球资源的勘探与原位加工，尤其是能源与推进剂的可持续生产。利用原位生成的推进剂可大幅降低运输成本，因为无需再从地球获取推进剂。月球资源有限，而可用资源的提取是高能耗过程，需要先进的技术与工艺。因此，最大的挑战之一在于开发具有正能量平衡的工艺架构，而目前对此仍缺乏全面分析。当前重点在于从月球风化层中提取水冰，并通过水电解生产氢和氧。然而，替代燃料和工艺方案可能在提供同等能量收益的同时降低能耗。在本研究范围内，假设地月空间中已存在提取、精炼和储存所需的基础设施与技术，因此仅考虑运行成本。通过对原位提取方法进行㶲分析，研究所需的能量预算能否支撑可持续实施。分析涵盖多种提取方法与推进剂方案，以揭示氢的替代方案在多大程度上可行。㶲分析可确定能量流的热力学损失，为工艺优化提供基础。被破坏的㶲代表了工艺架构中的改进空间，从而反映了工艺的热力学与经济价值，同时允许更清晰地审视能量利用。假设永久阴影区存在水冰和二氧化碳冰，分析表明，若选用甲烷替代氢与氧组合作为推进剂，所需㶲输入可减少多达三分之一。通过一个示例任务，可直接比较不同推进剂方案下提取工艺的运行成本。该任务涉及一艘使用液体双组元推进剂发动机的航天器，该发动机利用所提取的推进剂，并将同等质量的推进剂运送至月球近直线晕轨道（NRHO）上的存储站。尽管太空中氢资源丰富，但结果表明，氢可能并非开发地月空间及火星空间基础设施的唯一甚至能量上最经济的资源。同样，可持续提取适用于当前及未来推进系统的推进剂，将助力人类进一步深入太阳系},
  file = {/home/ouyangjiahong/Zotero/storage/QNAA2AU7/Gallbrecht 等 - 2024 - The moon as an effective propellant source a comprehensive exergy analysis from extraction to depot.pdf}
}

@article{galulloClosedLoopGuidance2022,
  title = {Closed Loop Guidance during Close Range Rendezvous in a Three Body Problem},
  author = {Galullo, Michele and Bucchioni, Giordana and Franzini, Giovanni and Innocenti, Mario},
  year = 2022,
  month = feb,
  journal = {Journal of Astronautical Sciences},
  volume = {69},
  number = {1},
  pages = {28--50},
  issn = {0021-9142, 2195-0571},
  doi = {10.1007/s40295-021-00289-6},
  urldate = {2025-11-27},
  abstract = {The paper presents a novel application of the State Dependent Riccati Equation (SDRE) guidance approach with state constraints for a chaser spacecraft in the close proximity of a passive target. The dynamics are described by full 6 degree of freedom rigid-body relative motion. The final trajectory is defined by a passively safe approaching cone, which acts as path constraint and follows the attitude motion of target. A Near Rectilinear Halo Orbit in the Earth-Moon system is the selected rendezvous scenario to fully validate the proposed solution, even though the parameters related to the constraints and weighting functions are kept as general as possible, thus applicable to other similar missions.},
  langid = {english},
  keywords = {Guidance,NRHO,Rendezvous,Three body problem},
  annotation = {titleTranslation: 三体问题中近距离交会闭环制导\\
abstractTranslation: 本文提出了一种新颖的状态相关黎卡提方程（SDRE）制导方法，并针对追踪航天器在被动目标近距离接近过程中的状态约束问题进行了应用。动力学模型采用完整的六自由度刚体相对运动描述。最终轨迹由被动安全接近锥定义，该锥体作为路径约束，并随目标的姿态运动而变化。为充分验证所提出的方案，选取了地月系统内的近直线晕轨道作为交会场景，尽管约束与加权函数的相关参数被尽可能保持通用，以便适用于其他类似任务。},
  file = {/home/ouyangjiahong/Zotero/storage/V453E2GS/Galullo 等 - 2022 - Closed loop guidance during close range rendezvous in a three body problem.pdf}
}

@article{gambarottoMonitoringCislunarFragmentation2025,
  title = {Monitoring Cislunar Fragmentation Events Using a Constellation of Space-Based Observers},
  author = {Gambarotto, C. and Grattagliano, P. and De Maria, L. and Montaruli, M. F.},
  year = 2025,
  journal = {Acta Astronautica},
  abstract = {The increasing number of Cislunar missions in recent decades, driven by Moon's economic, scientific, military, and commercial potential, has increased concerns about collision threats, and the widespread proliferation of debris. To safeguard future missions and infrastructure, a robust Space Traffic Management system is essential. However, current sensor capabilities are insufficient for large-scale Cislunar Space Situational Awareness, leaving a critical observational gap in this appealing region. Currently, a constellation of space-based passive optical sensors, strategically positioned to cover key areas, remains the only viable solution. While previous studies explored the observational capabilities of various Cislunar orbits for tracking individual objects on specific trajectories, none systematically analyzed their effectiveness in monitoring debris clouds generated by collision events. This study addresses this gap by assessing the observational potential of key Cislunar and lunar orbital families in tracking debris clouds over time, offering critical insights for the sustainable planning of future Cislunar operations. Twenty-nine orbits from distinct orbital families are selected to host the observers, based on their stability and SSA relevance, and eleven catastrophic collision events, spatially distributed across the region, are simulated using the NASA Standard Breakup Model. The resulting debris are propagated within the Circular Restricted Three-Body Problem dynamical framework over a three-month period. The possible impact threats to the Earth, the Moon, and spacecraft in Geostationary Orbit (GEO) are assessed, as well as the observers' performance in tracking the debris. Results indicate moderate risks to the two celestial bodies but no significant threats to GEO belt assets. The L2 Halo orbit family emerges as the most effective for long-term debris monitoring, achieving the highest performance when integrated into a constellation with small Lyapunov, Distant Retrograde, and Elliptical Lunar Orbits. Notably, the primary factors limiting fragment detectability include the vast spatial extent of the Cislunar region and occasional obstructions by celestial bodies.},
  langid = {english},
  keywords = {Cislunar space,Fragmentation events,Space debris,Space Surveillance and Tracking,Space-based observations},
  annotation = {titleTranslation: 利用天基观测星座监测地月空间碎片事件\\
abstractTranslation: 近几十年来，受月球在经济、科学、军事和商业方面潜力的驱动，地月空间（Cislunar）任务数量不断增加，由此引发了对碰撞威胁及碎片广泛扩散的担忧。为保障未来任务与基础设施的安全，建立稳健的空间交通管理系统至关重要。然而，现有传感器能力不足以支撑大规模地月空间态势感知，导致这一极具吸引力的区域存在关键的观测空白。目前，唯一可行的解决方案是部署由天基被动光学传感器组成的星座，并战略性地将其布设在覆盖关键区域的位置。既往研究虽探讨了不同地月轨道对特定轨迹上单个目标的观测能力，但尚未系统分析这些轨道在监测碰撞事件所产生碎片云方面的有效性。本研究填补了这一空白，评估了关键地月轨道族与月球轨道族随时间跟踪碎片云的观测潜力，为未来地月空间运行的可持续规划提供了重要见解。基于稳定性与空间态势感知相关性，从不同轨道族中选取了29条轨道作为观测平台，并利用NASA标准解体模型模拟了空间分布在该区域的11次灾难性碰撞事件。随后在圆型限制性三体问题动力学框架内，对产生的碎片进行了为期三个月的传播分析。评估了碎片对地球、月球及地球静止轨道（GEO）航天器可能造成的碰撞威胁，同时分析了观测平台的跟踪性能。结果表明，对两个天体的风险较为中等，但对GEO带资产不构成显著威胁。L2 Halo轨道族在长期碎片监测中表现最佳，当与小Lyapunov轨道、远距离逆行轨道以及椭圆月球轨道组成星座时，其性能达到最优。值得注意的是，限制碎片可探测性的主要因素包括地月空间广阔的分布范围以及天体偶尔产生的遮挡}
}

@article{gambhireReviewSlidingMode2021,
  title = {Review of Sliding Mode Based Control Techniques for Control System Applications},
  author = {Gambhire, S. J. and Kishore, D. Ravi and Londhe, P. S. and Pawar, S. N.},
  year = 2021,
  month = mar,
  journal = {International Journal of Dynamics and Control},
  volume = {9},
  number = {1},
  pages = {363--378},
  issn = {2195-268X, 2195-2698},
  doi = {10.1007/s40435-020-00638-7},
  urldate = {2025-09-25},
  abstract = {In recent development in the control area, advanced control schemes are well established for the systems under the influence of parametric uncertainties due to modelling error, nonlinearities, and the external disturbances. Among the different robust control schemes sliding mode control (SMC) has made attention for the control engineer due to its merits. SMC has grown rapidly as a control in comparison with other robust control strategies due to its distinguish features like insensitive to matched uncertainties, reduced order sliding mode equations, zero error convergence of closed loop system and it offers a nonlinear control. The objective of this paper is to present the literature review of SMC development in an era of control technology. The development of SMC based technique with integration of intelligent control in the field of control engineering has been surveyed by considering numerous applications.},
  langid = {english},
  annotation = {titleTranslation: 控制系统应用中基于滑模控制技术的综述\\
abstractTranslation: 在控制领域的最新发展中，针对因建模误差、非线性因素及外部扰动导致的参数不确定性系统，先进控制方案已得到充分确立。在诸多鲁棒控制策略中，滑模控制（SMC）因其优点而备受控制工程师关注。与其他鲁棒控制方法相比，SMC凭借其对匹配不确定性不敏感、降阶滑动模态方程、闭环系统零误差收敛以及提供非线性控制等显著特性，得以迅速发展。本文旨在综述SMC在控制技术时代的发展历程。通过考虑众多应用场景，对基于SMC的技术与智能控制相结合在控制工程领域的发展进行了调研。},
  file = {/home/ouyangjiahong/Zotero/storage/ELHUJZJH/Gambhire 等 - 2021 - Review of sliding mode based control techniques for control system applications.pdf}
}


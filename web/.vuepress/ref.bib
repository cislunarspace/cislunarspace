@article{YinZhiDiQiuKeXueHeShenKongTanCeDeYinLiChangJianMoLiLunYanJiuJinZhan2024,
  title = {{地球科学和深空探测的引力场建模理论研究进展}},
  author = {{尹智} and {张克非} and {段亚博} and {刘军生} and {穆庆禄}},
  year = 2024,
  journal = {地球与行星物理论评（中英文）},
  volume = {55},
  number = {5},
  pages = {501--512},
  issn = {2097-1893},
  doi = {10.19975/j.dqyxx.2024-002},
  abstract = {不规则天体引力场建模是当前地球科学和深空探测研究领域面对的共同难题.本文梳理了这两个领域中引力场建模理论的发展历程以及近10年研究进展，重点介绍引力场多极展开理论和引力场势流模拟理论.引力场多极展开理论将电磁学和量子力学中常用的复变函数公式体系引入引力场研究领域，比实变函数公式体系更简洁地表述天体（内外部）引力场结构；通过充分利用复变函数运算规则，能直观有效解决与引力场相关的天体动力学问题.引力场势流模拟理论利用天体外部引力矢量和势流速度矢量的等价性（即两者都是无源无旋矢量场），将计算流体动力学数值计算方法引入引力场建模领域，通过求解势流速度场实现天体外部引力场建模；此理论不依赖于扰动理论，能有效克服常规方法在反演不规则天体引力场过程中存在的``解发散''问题.这两种引力场建模理论的共同创新性在于通过将其它领域中看似不相关的数学理论引入到本领域，实现本领域的问题求解和理论推进，对后续理论研究起到一定借鉴意义.此外，本文根据天体引力场的定义公式及其变体形式，对地球科学和深空探测领域已有的引力场建模理论研究进行分类、对比和分析，总结各自优缺点，对相关学者选用合适引力场建模方法提供有益参考.},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/YE2GKGL3/尹智 等 - 2024 - 地球科学和深空探测的引力场建模理论研究进展.pdf}
}


@article{bevilacquaOnlineGenerationQuasioptimal2009,
  title = {Online Generation of Quasi-Optimal Spacecraft Rendezvous Trajectories},
  author = {Bevilacqua, R. and Romano, M. and Yakimenko, O.},
  year = 2009,
  month = jan,
  journal = {Acta Astronautica},
  volume = {64},
  number = {2},
  pages = {345--358},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2008.08.001},
  urldate = {2026-01-28},
  abstract = {A direct method for rapid generation of combined time-propellant near-optimal trajectories of proximity maneuvers of a chaser spacecraft required to dock a target one, with predetermined thrust history along a master direction, is presented. The predetermined thrust history is generated by applying the Pontryagin maximum principle. The new direct method, already implemented and tested on board real aircraft, is based on three concepts: high-order polynomials as reference functions, preset on--off sequence of a master control, and reduction of the optimization problem to the determination of a small set of parameters. Presetting the master control, the remaining controls act as slaves, guarantying the chaser to move along the desired path. Seeking of the optimum strategy is transformed into a nonlinear programming problem, and then numerically solved through an ad hoc algorithm in accelerated time scale. Examples are reported to prove the rapidness of the approach to generate a sub-optimal docking trajectory.},
  langid = {english},
  keywords = {Direct methods,Online optimization,Spacecraft rendezvous},
  annotation = {titleTranslation: 航天器准最优交会轨迹的在线生成\\
abstractTranslation: 提出了一种直接方法，用于快速生成追踪航天器与目标航天器对接所需的接近机动中同时考虑时间和推进剂的近最优轨迹，并沿主方向预设推力历程。预设推力历程通过应用庞特里亚金最大值原理生成。这种新直接方法已在真实飞行器上实现并测试，基于三个概念：高阶多项式作为参考函数、预设主控制的开关序列、以及将优化问题简化为确定少量参数。预设主控制后，其余控制作为从控制，确保追踪器沿预定路径运动。寻求最优策略转化为非线性规划问题，然后通过专用算法在加速时间尺度上数值求解。报告了示例以证明该方法生成次优对接轨迹的快速性},
  file = {/home/ouyangjiahong/Zotero/storage/N837GNSY/S0094576508002919.html}
}


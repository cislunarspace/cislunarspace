@article{YiKeXingDaiYouShiJianHeJiaoDuYueShuDeFeiXingQiSanWeiShiLiangXieTongZhiDaoLu2025,
  title = {{带有时间和角度约束的飞行器三维矢量协同制导律}},
  author = {{弋可行} and {韩治国} and {张科} and {崔颢} and {肖明昊}},
  year = 2025,
  journal = {宇航学报},
  volume = {46},
  number = {7},
  pages = {1410--1422},
  issn = {1000-1328},
  abstract = {针对多飞行器对大型重要目标的协同攻击问题，提出了一种带有时间和角度约束的三维矢量协同制导律。基于最优误差动力学理论，设计了有效纯比例导引下的二维碰撞角度控制制导律，能够使飞行器终端视线角收敛至期望值，且具有良好的初始性能。然后基于矢量制导方法，将二维碰撞角度控制制导律拓展至三维，并引入时间约束偏置项，推导了飞行时间误差的动力学表达式。基于固定时间收敛理论得到了同时带有时间和角度约束的三维制导律，该制导律既能保证飞行器以期望时间攻击目标，又能在无需平面解耦的条件下满足碰撞角度约束。最后，通过数值仿真验证了所提出制导律的有效性，且该制导律能够应用于多飞行器协同攻击，具有较高的制导精度和协同精度。},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/K23VM5XI/弋可行 等 - 2025 - 带有时间和角度约束的飞行器三维矢量协同制导律.pdf}
}


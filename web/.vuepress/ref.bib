@article{WuDanRenZhiJiaoHuShiJiaoXiaSheJiaoJiQiRenQingGanJiSuanYanJiuWenXianZongShuYuLiLunMoXingGouJian2026,
  title = {{人智交互视角下社交机器人情感计算研究------文献综述与理论模型构建}},
  author = {{吴丹} and {徐华卿}},
  year = 2026,

@article{sosnicaGPSGLONASSGalileo2022,
  title = {{{GPS}}, {{GLONASS}}, and Galileo Orbit Geometry Variations Caused by General Relativity Focusing on Galileo in Eccentric Orbits},
  author = {So{\'s}nica, Krzysztof and Bury, Grzegorz and Zajdel, Rados{\l}aw and {Ventura-Traveset}, Javier and Mendes, Luis},
  year = 2022,
  month = jan,
  journal = {GPS Solutions},
  volume = {26},
  number = {1},
  pages = {5--17},
  issn = {1080-5370, 1521-1886},
  doi = {10.1007/s10291-021-01192-1},
  urldate = {2025-11-27},
  abstract = {Three main effects from general relativity (GR) may change the geometry and orientation of artificial earth satellite orbits, i.e., the Schwarzschild, Lense--Thirring, and De Sitter effects. So far, the verification of GR effects was mainly based on the observations of changes in the orientation of satellite orbital planes. We directly observe changes of the satellite orbit geometry caused by GR represented by the semimajor axis and eccentricity. We measure the variations of orbit size and shape of GPS, GLONASS, and Galileo satellites in circular and eccentric orbits and compare the results to the theoretical effects using three years of real GNSS data. We derive a solution that assumes the GR to be true, and a second solution, in which the post-Newtonian parameters are estimated, thus, allowing satellites to find their best spacetime curvature. For eccentric Galileo, GR changes the orbital shape and size in perigee in such a way that the orbit becomes smaller but more circular. In the apogee, the semimajor axis decreases but eccentricity increases, and thus, the orbit becomes more eccentric. Hence, the orbital size variabilities for eccentric orbits are greatly compensated by the orbital shape changes, and thus the total effect of satellite height change is much smaller than the effects for the size and shape of the orbit, individually. The mean semimajor axis offset based on all GPS, GLONASS, and Galileo satellites is - 17.41 \textpm{} 2.90 mm, which gives a relative error of 0.36\% with respect to the theoretical value.},
  langid = {english},
  annotation = {titleTranslation: GPS、GLONASS与伽利略系统的轨道几何变化由广义相对论效应引起------聚焦于伽利略系统在偏心轨道上的影响\\
abstractTranslation: 广义相对论（GR）对人工地球卫星轨道几何和取向的三大主要影响分别是Schwarzschild效应、Lense-Thirring效应和De Sitter效应。迄今为止，对GR效应的验证主要基于卫星轨道平面取向变化的观测。我们直接观测由GR引起的卫星轨道几何变化，表现为半长轴和偏心率的变化。我们利用三年真实GNSS数据，测量了GPS、GLONASS和Galileo卫星在圆形和偏心轨道上的轨道大小和形状变化，并将结果与理论效应进行比较。我们推导出一个假设GR成立的解，以及另一个估计后牛顿参数从而让卫星自行寻找最佳时空曲率的解。对于偏心轨道Galileo卫星，GR在近地点改变轨道形状和大小，使得轨道变小但更圆；在远地点，半长轴减小但偏心率增大，因此轨道变得更偏心。因此，偏心轨道的轨道大小变化在很大程度上被轨道形状变化所补偿，导致卫星高度变化的总效应远小于轨道大小和形状各自的效应。基于所有GPS、GLONASS和Galileo卫星的平均半长轴偏移为-17.41 \textpm{} 2.90 mm，相对于理论值的相对误差为0.36\%},
  file = {/home/ouyangjiahong/Zotero/storage/TTS7QFDX/Sośnica 等 - 2022 - GPS, GLONASS, and galileo orbit geometry variations caused by general relativity focusing on galileo.pdf}
}


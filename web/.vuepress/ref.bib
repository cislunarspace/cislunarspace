@article{lizy-destrezRendezvousStrategiesVicinity2019,
  title = {Rendezvous Strategies in the Vicinity of {{Earth-moon}} Lagrangian Points},
  author = {{Lizy-Destrez}, Stephanie and Beauregard, Laurent and Blazquez, Emmanuel and Campolo, Antonino and Manglativi, Sara and Quet, Victor},
  year = 2019,
  month = jan,
  journal = {Frontiers in Astronomy and Space Sciences},
  volume = {5},
  pages = {45--64},
  issn = {2296-987X},
  doi = {10.3389/fspas.2018.00045},
  urldate = {2025-11-27},
  abstract = {In the context of Human Spaceflight exploration mission scenario, with the Lunar Orbital Platform- Gateway (LOP-G) orbiting about Earth-Moon Lagrangian Point (EML), Rendezvous and Docking (RVD) operational activities are mandatory and critical for the deployment and utilization of the LOP-G (station assembly, crew rotations, cargo delivery, lunar sample return). There is extensive experience with RVD in the two-body problem: in Low Earth Orbit (LEO) to various space stations, or around quasi-circular Low Lunar Orbits (LLO), the latter by Apollo by means of manual RVD. However, the RVD problem in non-Keplerian environments has rarely been addressed and no RVD has been performed to this date in the vicinity of Lagrangian points (LP) where Keplerian dynamics are no longer applicable. Dynamics in such regions are more complex, but multi-body dynamics also come with strong advantages that need to be further researched by the work proposed here. The aim of this paper is to present methods and results of investigations conducted to first set up strategies for far and close rendezvous between a target (the LOP-G, for example) and a chaser (cargo, crew vehicle, ascent and descent vehicle, station modules, etc.) depending on target and chaser orbit. Semi-analytical tools have been developed to compute and model families of orbits about the Lagrangian points in the Circular Restricted Three Body Problem (CR3BP) like NRHO, DRO, Lyapunov, Halo and Lissajous orbits. As far as close rendezvous is concerned, implementation of different linear and non-linear models used to describe cis-lunar relative motion will be discussed and compared, in particular for NRHO and DRO.},
  langid = {english},
  keywords = {CR3BP,Earth-Moon system,Lagrangian points- Relative motion,Rendezvous,Trajectory},
  annotation = {titleTranslation: 地月拉格朗日点附近的交会对接策略\\
abstractTranslation: 在载人航天探索任务场景中，随着月球轨道平台-门户（LOP-G）在地月拉格朗日点（EML）附近运行，交会对接（RVD）操作对于LOP-G的部署与利用（如空间站组装、乘员轮换、货物运输、月球样品返回）至关重要且必不可少。目前，在二体问题中已有丰富的RVD经验：在近地轨道（LEO）与各类空间站对接，或在近圆低月球轨道（LLO）上------阿波罗任务通过手动RVD实现了后者。然而，非开普勒环境下的RVD问题鲜有涉及，且迄今为止尚未在拉格朗日点（LP）附近执行过任何RVD操作，因为在此区域开普勒动力学已不再适用。该区域的动力学更为复杂，但多体动力学也带来了显著优势，需通过本文提出的研究工作进一步探索。本文旨在展示研究方法与结果，首先依据目标飞行器（例如LOP-G）与追踪飞行器（如货运飞船、载人飞船、上升/下降飞行器、空间站舱段等）的轨道特性，制定远距离及近距离交会策略。已开发半分析工具，用于计算和建模圆型限制性三体问题（CR3BP）中拉格朗日点附近的轨道族，包括NRHO、DRO、Lyapunov、Halo及Lissajous轨道。针对近距离交会，将讨论并比较用于描述地月空间相对运动的不同线性与非线性模型，特别针对NRHO与DRO轨道},
  file = {/home/ouyangjiahong/Zotero/storage/ZWWXFIQ8/Lizy-Destrez 等 - 2019 - Rendezvous strategies in the vicinity of Earth-moon lagrangian points.pdf}
}


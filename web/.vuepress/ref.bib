@article{liEfficientReachableDomain2025,
  title = {Efficient Reachable Domain Search-Tracking for Cislunar Non-Cooperative Targets via Designed Quadrature},
  author = {Li, Kaige and Wang, Yidi and Zheng, Wei},
  year = 2025,
  month = dec,
  journal = {Aerospace},
  volume = {12},
  number = {12},
  pages = {1056},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2226-4310},
  doi = {10.3390/aerospace12121056},
  urldate = {2026-04-23},
  abstract = {To address the triple challenges of data sparsity, highly nonlinear dynamics, and maneuver uncertainty in tracking non-cooperative targets in cislunar space, we propose a collaborative framework combining Particle Filter (PF) and Unscented Kalman Filter (UKF). This framework optimizes search efficiency through a two-phase strategy: in the search phase, PF constructs the target reachable domain and leverages undetected information to dynamically shrink the search scope; upon target detection, the framework switches to UKF for high-precision and low-overhead tracking. To overcome the computational bottleneck in high-dimensional reachable domain integration, we integrate a non-product-type Designed Quadrature (DQ) method---one that generates minimal quadrature point sets to replace traditional Monte Carlo sampling by matching the moment conditions of mixed distributions via Gauss--Newton optimization. Distinct from existing single-filter or reachability modeling approaches, the key novelties of this work lie in a two-phase PF-UKF switching framework tailored to the unique cislunar environment resolving the trade-off between search capability and computational efficiency and integration of the non-product DQ method to break the dimensionality curse in high-dimensional reachable domain computation ensuring both moment-matching accuracy and real-time performance. This work holds potential to support space domain awareness and cislunar mission safety: reliable tracking of non-cooperative targets is a key prerequisite for avoiding collisions, safeguarding space assets, and enabling effective space defense, and the proposed framework provides a feasible technical path for this goal through simulation validation. Simulations demonstrate that on a three-dimensional Distant Retrograde Orbit (DRO) observation platform, successful recapture of cislunar transfer orbit targets can be achieved. Under fifth-order accuracy conditions, the system exhibits a position error of 3.745\texttimes 10-1km and a velocity tracking error of 9.703\texttimes 10-3m/s for target search-and-tracking tasks, with a system response time of 1.8343 h. Compared with the traditional PF + numerical integration method, our proposed PF-UKF framework achieves an 86.7\% reduction in time cost and a 24.1\% reduction in position error.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  annotation = {titleTranslation: 基于设计求积法的地月空间非合作目标可达域高效搜索跟踪\\
abstractTranslation: 针对地月空间非合作目标跟踪中数据稀疏、强非线性动力学及机动不确定性的三重挑战，本文提出了一种融合粒子滤波（PF）与无迹卡尔曼滤波（UKF）的协同框架。该框架通过两阶段策略优化搜索效率：在搜索阶段，PF构建目标可达域并利用未检测信息动态收缩搜索范围；当目标被检测到后，框架切换至UKF以实现高精度、低开销的跟踪。为突破高维可达域积分中的计算瓶颈，我们集成了一种非乘积型设计求积（DQ）方法------通过高斯-牛顿优化匹配混合分布的矩条件，生成最小求积点集以替代传统蒙特卡洛采样。区别于现有单一滤波器或可达性建模方法，本工作的关键创新在于：一是针对地月空间独特环境定制了PF-UKF两阶段切换框架，解决了搜索能力与计算效率之间的权衡问题；二是集成了非乘积型DQ方法以突破高维可达域计算中的维数灾难，同时保障矩匹配精度与实时性能。本工作对空间态势感知与地月任务安全具有潜在支撑价值：非合作目标的可靠跟踪是避免碰撞、保护空间资产及实现有效空间防御的关键前提，而所提框架通过仿真验证为该目标提供了可行的技术路径。仿真结果表明，在三维远距逆行轨道（DRO）观测平台上，可实现地月转移轨道目标的成功重捕。在五阶精度条件下，系统在目标搜索跟踪任务中的位置误差为3.745\texttimes 10{$^{-1}$} km，速度跟踪误差为9.703\texttimes 10{$^{-3}$} m/s，系统响应时间为1.8343 h。与传统PF+数值积分方法相比，本文提出的PF-UKF框架时间成本降低86.7\%，位置误差降低24.1\%},
  file = {/home/ouyangjiahong/Zotero/storage/UL3AIMWT/Li 等 - 2025 - Efficient reachable domain search-tracking for cislunar non-cooperative targets via designed quadrat.pdf}
}


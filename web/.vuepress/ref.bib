@article{cuiTwoimpulseTransfersLunar2025,
  title = {Two-Impulse Transfers from Lunar Distant Retrograde Orbits to Resonant Orbits},
  author = {Cui, Shuhao and Wang, Yue and Zhang, Ruikang and Zhang, Hao and Gao, Yang},
  year = 2025,
  month = jun,
  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {48},
  number = {6},
  pages = {1348--1365},
  publisher = {{American Institute of Aeronautics and Astronautics}},
  issn = {0731-5090},
  doi = {10.2514/1.G008582},
  urldate = {2026-01-04},
  abstract = {As unique types of orbits in the cislunar space, distant retrograde orbits (DROs) and resonant orbits (ROs) are of great significance in future cislunar explorations, and the transfer between them deserves special attention. The design of transfer trajectories between these two kinds of orbits remains a challenge due to their stability. In this study, a novel transfer pathway from DROs and ROs is constructed based on a search and optimization methodology, which could offer an alternative for mission design related to these two orbits. Two-impulse transfers for both planar and nonplanar cases are designed in the circular restricted three-body problem, and three types of transfer orbits are obtained and characterized, including the direct transfer, the lunar gravity assisted transfer, and the external transfer. Planar transfers are also refined in the bicircular restricted four-body problem in consideration of the solar gravity. Furthermore, representative transfer orbits are transitioned into the ephemeris model to validate the preliminary design, and the result indicates that the transfer cost fluctuates with different departure epochs for all types of transfers.},
  langid = {english},
  keywords = {Bicircular Restricted Four-Body Problem,Circular Restricted Three-Body Problem,Cislunar Space,Distant Retrograde Orbits,Ephemeris Model,Lunar Gravity Assist,Resonant Orbits,Trajectory Optimization,Transfer trajectory,Weak Stability Boundary},
  annotation = {abstractTranslation: 作为地月空间中的独特轨道类型，远距离逆行轨道与共振轨道在未来地月探测中具有重要意义，其间的转移问题值得特别关注。由于这两类轨道的稳定性特性，其间的转移轨迹设计仍具挑战。本研究基于搜索优化方法构建了从远距离逆行轨道至共振轨道的新型转移路径，为相关任务设计提供了替代方案。在圆型限制性三体问题框架下，设计了平面与非平面情形的双脉冲转移轨道，获得并表征了三类转移轨道构型：直接转移、月球引力辅助转移及外缘转移。同时考虑太阳引力影响，在双圆限制性四体模型中对平面转移轨迹进行了精细化设计。此外，将典型转移轨道转换至星历模型中以验证初步设计，结果表明所有类型的转移能耗均随出发历元不同而波动。\\
titleTranslation: 从月球远距离逆行轨道至共振轨道的双脉冲转移},
  file = {/home/ouyangjiahong/Zotero/storage/D75I8M9V/Cui 等 - 2025 - Two-impulse transfers from lunar distant retrograde orbits to resonant orbits.pdf}
}


@article{morselliHighOrderMethod2014,
  title = {A High Order Method for Orbital Conjunctions Analysis: Sensitivity to Initial Uncertainties},
  shorttitle = {A High Order Method for Orbital Conjunctions Analysis},
  author = {Morselli, Alessandro and Armellin, Roberto and Di Lizia, Pierluigi and Bernelli Zazzera, Franco},
  year = 2014,
  month = feb,
  journal = {Advances in Space Research},
  volume = {53},
  number = {3},
  pages = {490--508},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2013.11.038},
  urldate = {2026-02-18},
  abstract = {A high order method to quickly assess the effect that uncertainties produce on orbital conjunctions through a numerical high-fidelity propagator is presented. In particular, the dependency of time and distance of closest approach to initial uncertainties on position and velocity of both objects involved in a conjunction is studied. The approach relies on a numerical integration based on differential algebraic techniques and a high-order algorithm that expands the time and distance of closest approach in Taylor series with respect to relevant uncertainties. The modeled perturbations are atmospheric drag, using NRLMSISE-00 air density model, solar radiation pressure with shadow, third body perturbation using JPL's DE405 ephemeris, and EGM2008 gravity model. The polynomial approximation of the final position is used as an input to compute analytically the expansion of time and distance of closest approach. As a result, the analysis of a close encounter can be performed through fast, multiple evaluations of Taylor polynomials. Test cases with objects ranging from LEO to GEO regimes are considered to assess the performances and the accuracy of the proposed method.},
  langid = {english},
  keywords = {Conjunction analysis,Differential algebra,Space debris},
  annotation = {titleTranslation: 高阶轨道交会分析方法：对初始不确定性的敏感性\\
abstractTranslation: 本文提出了一种高阶方法，能够通过数值高保真传播器快速评估不确定性对轨道交会影响。具体而言，研究了交会过程中两个物体的时间与最近距离对初始位置和速度不确定性的依赖关系。该方法基于微分代数技术的数值积分，并采用一种高阶算法，将时间与最近距离展开为关于相关不确定性的泰勒级数。所考虑的摄动包括：利用NRLMSISE-00大气密度模型的大气阻力、含阴影的太阳辐射压、采用JPL的DE405星历的第三体摄动，以及EGM2008重力模型。最终位置的多项式近似被用作输入，以解析计算时间与最近距离的展开式。因此，通过对泰勒多项式进行快速多次评估，即可完成对近距离交会的分析。针对从低地球轨道到地球静止轨道区域的目标物体，通过测试案例评估了所提方法的性能与精度},
  file = {/home/ouyangjiahong/Zotero/storage/G4ZSL7J6/Morselli 等 - 2014 - A high order method for orbital conjunctions analysis sensitivity to initial uncertainties.pdf;/home/ouyangjiahong/Zotero/storage/5T6BV3TD/S0273117713007412.html}
}


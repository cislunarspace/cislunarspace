@phdthesis{WangAiXueDuoTianTiYinLiChangXiaDeDROZhuanYiGuiDaoSheJi2021,
  type = {{硕士学位论文}},
  title = {{多天体引力场下的DRO转移轨道设计}},
  author = {{王艾雪}},
  year = 2021,
  address = {北京},
  abstract = {地月远距离逆行轨道（Distant Retrograde Orbits, DRO）是地月空间中的一类周期轨道。这类轨道具有长期稳定、入轨能量低的特点，可作为未来载人月球以及载人火星任务的中转站。本文围绕以DRO轨道为目标的转移轨道设计问题，从面向载人任务的DRO入轨问题、以DRO为基地的转移轨道的优化设计问题、地月空间轨道软件研发等方面展开研究。面向载人任务的DRO入轨问题应重点考虑任务安全性，并综合考虑飞行时间和脉冲消耗。本文基于地月自由往返轨道设计了DRO两脉冲直接转移和四脉冲月球借力转移轨道。首先在圆型限制性三体模型下计算了4类自由往返轨道的解族，其次采用地心顺行月心逆行自由返回轨道，获得了直接入轨和月球借力两种方式进入不同周期DRO所需的飞行时间和脉冲消耗。数值仿真表明，对于共振比2:1的DRO轨道，直接入轨方式所需的速度脉冲约为607m/s，飞行时间约为6.17天，载人飞行器在DRO入轨脉冲失效的情况下也可无动力返回地球。四脉冲月球借力方式所需的速度脉冲约为241m/s，飞行时间约为14.53天，由于这种方式不能直接在自由返回轨道上施加DRO入轨脉冲，因而更适合货运任务。面向地月空间以DRO为基地的转移轨道设计问题，本文基于四体动力学模型提出了LEO、MEO、GEO与DRO之间的脉冲式转移方案。首先在四体动力学模型下针对两脉冲直接转移和三脉冲月球借力方案分别构造了局部优化问题。通过数值仿真，证明了该算法支持LEO到DRO、DRO到MEO、DRO到GEO以及3:1DRO到2:1DRO多种转移方案，通过仿真计算得到了几类转移方案的帕累托最优解，并获得直接入轨和月球借力两种方式转移过程中所需要的飞行时间和脉冲消耗。仿真结果表明该优化算法支持不同轨道倾角，各种几何形状、轨道出发/到达位置、飞行时间和机动能力要求的转移方案。基于前文的研究成果，本文研制地月空间转移轨道设计软件。该软件用于近地空间LEO到DRO轨道族转移轨道设计，软件支持两脉冲直接转移和三脉冲月球借力两种转移方式，并且支持在转移轨道在高精度模型下的修正。},
  langid = {chinese},
  school = {中国科学院大学},
  keywords = {;;DRO;;}
}


@article{JinShouCongJiYuNRHODeYueQiuQuanQiuDingWeiXiTongXingZuoYanJiu2025,
  title = {{基于NRHO的月球全球定位系统星座研究}},
  author = {{晋守聪} and {程潏} and {刘磊} and {陈钢}},

@article{inampudiTwocraftTetherFormation2011,
  title = {Two-Craft Tether Formation Relative Equilibria about Circular Orbits and Libration Points},
  author = {Inampudi, Ravi and Schaub, Hanspeter},
  year = 2011,
  month = jun,
  journal = {Acta Astronautica},
  volume = {68},
  number = {11-12},
  pages = {1761--1773},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2011.02.003},
  urldate = {2025-11-27},
  abstract = {The relative equilibria of a two spacecraft tether formation connected by line-of-sight elastic forces moving in the context of a restricted two-body system and a circularly restricted three-body system are investigated. For a two spacecraft formation moving in a central gravitational field, a common assumption is that the center of the circular orbit is located at the primary mass and the center of mass of the formation orbits around the primary in a great-circle orbit. The relative equilibrium is called great-circle if the center of mass of the formation moves on the plane with the center of the gravitational field residing on it; otherwise, it is called a nongreat-circle orbit. Previous research shows that nongreat-circle equilibria in low Earth orbits exhibit a deflection of about a degree from the great-circle equilibria when spacecraft with unequal masses are separated by 350 km. This paper studies these equilibria (radial, along-track and orbit-normal in circular Earth orbit and Earth--Moon Libration points) for a range of inter-craft distances and semi-major axes of the formation center of mass. In the context of a two-spacecraft Coulomb formation with separation distances on the order of dozens of meters, this paper shows that the equilibria deflections are negligible (less than 10 61) even for very heterogeneous mass distributions. Furthermore, the nongreat-circle equilibria conditions for a two spacecraft tether structure at the Lagrangian libration points are developed.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid = {english},
  annotation = {titleTranslation: 关于圆轨道和拉格朗日点的双航天器系留编队相对平衡态},
  file = {/home/ouyangjiahong/Zotero/storage/Q7ZE5I4P/Inampudi和Schaub - 2011 - Two-craft tether formation relative equilibria about circular orbits and libration points.pdf}
}

@inproceedings{indacoStructureNRHOtoLLOAbort2024,
  title = {Structure of the {{NRHO-to-LLO}} Abort Trajectory Design Space},
  booktitle = {{{AIAA SCITECH}} 2024 {{Forum}}},
  author = {Indaco, M. and Taheri, E. and Guzzetti, D.},
  year = 2024,
  address = {Orlando, FL, USA},
  doi = {10.2514/6.2024-1452},
  abstract = {Starting from Artemis III, the Deep Space Gateway (DSG) will serve as a staging point for the Human Landing System (HLS), enabling access to multiple regions of the Moon. As the crew's safety constitutes a primary concern, abort maneuver capabilities must be considered. The uncertainty of the mission parameters makes identifying all possible strategies demanding. Traditional approaches relying on full scanning of the parameter space rapidly become computationally intractable as the number of parameters increases. Also, common black-box methods do not typically provide insights into the underlying environment dynamics, which, instead, may be exploited during the mission design process. We investigate the complex structure of the cislunar dynamical environment for a reference NRHO-to-LLO abort scenario and investigate the solution space structure through two search strategies: direct search and flow-informed search. The first strategy directly employs numerical methods to identify abort trajectory solutions. In this regard, we discuss improving the convergence structure to explore the parameter space more rapidly. Our pipeline relies on surrogate models trained via adaptive sampling enabling fast generation of initial guesses, which are then corrected to recover abort trajectories within the defined scenario. In the second approach, we explore finite-time Lyapunov exponent (FTLE) maps to identify characteristic features of the dynamical structure that may aid trajectory design. Both approaches demonstrate to be promising, hinting at the possibility of a unified, more effective method for investigating the large design space, potentially enabling further reduction of computational costs and more informed solutions.},
  langid = {english},
  annotation = {我们针对一条从近直线晕轨道（NRHO）至低月球轨道（LLO）的中止任务基准场景，研究了地月空间动力学环境的复杂结构，并通过两种搜索策略探索解空间构型：直接搜索与流形信息引导搜索。第一种策略直接采用数值方法识别中止轨迹解，并重点讨论了如何优化收敛结构以加速参数空间探索。我们的流程基于自适应采样训练的代理模型，可快速生成初始猜测值，再通过校正得到符合场景定义的中止轨迹。第二种方法通过有限时间李雅普诺夫指数（FTLE）图谱识别动力学结构的特征，以辅助轨迹设计。两种方法均展现出良好潜力，预示着未来可能形成一种统一且更高效的大型设计空间探索方法，从而进一步降低计算成本，获得更具洞察力的解决方案。\\
titleTranslation: NRHO至LLO中止弹道设计空间的结构\\
abstractTranslation: 自阿尔忒弥斯三号任务起，深空门户（DSG）将作为载人着陆系统（HLS）的中转站，为月球多区域探测提供支持。鉴于航天员安全是首要考量，必须将中止机动能力纳入设计范畴。任务参数的不确定性使得全面识别可行策略变得尤为复杂。传统方法依赖对参数空间的全局扫描，随着参数数量增加，其计算量会迅速超出可行范围。此外，常见的黑箱方法通常无法揭示深层环境动力学特性，而这些特性恰恰可能在任务设计过程中发挥关键作用。},
  file = {/home/ouyangjiahong/Zotero/storage/9DE6M5EQ/Indaco 等 - 2024 - Structure of the NRHO-to-LLO abort trajectory design space.pdf}
}

@article{innocentiDynamicsControlAnalysis2022,
  title = {Dynamics and Control Analysis during Rendezvous in Non-Keplerian Earth---Moon Orbits},
  author = {Innocenti, Mario and Bucchioni, Giordana and Franzini, Giovanni and Galullo, Michele and Onofrio, Fabio D' and Cropp, Alexander and Casasco, Massimo},
  year = 2022,
  month = oct,
  journal = {Frontiers in Space Technologies},
  volume = {3},
  pages = {929179},
  issn = {2673-5075},
  doi = {10.3389/frspt.2022.929179},
  urldate = {2025-11-27},
  abstract = {The paper describes the development of a framework capable of addressing some fundamental issues in the analysis of proximity operations between two spacecraft that are operating within a three-body model defined by two primaries and the spacecraft themselves. The main objective is to enable the capability of analysing dynamic and control issues during an automated rendezvous between a vehicle and a passive space station orbiting around the Earth - Moon L2 Lagrangian point on a near rectilinear halo orbit. The paper presents first a restricted three body model dynamics and a nominal approach trajectory, followed by an analysis of the influence of assumed actuators and sensors. Critical aspects such as selected failures are investigated, in order to ensure passive safety of the mission using impulsive maneuvers. An example of closed loop guidance in the near range is also presented and the overall performance are validated with an Ephemeris model available in the literature.},
  langid = {english},
  annotation = {titleTranslation: 非开普勒地月轨道交会过程中的动力学与控制分析\\
abstractTranslation: 本文描述了一个框架的开发，该框架能够解决在两艘航天器之间进行近距离操作分析时的一些基本问题，这些航天器运行在一个由两个主天体及航天器自身定义的三体模型内。主要目标是实现自动交会过程中动力学与控制问题的分析能力，该交会涉及一个飞行器与一个被动空间站，该空间站环绕地月L2拉格朗日点附近的一条近直线晕轨道运行。论文首先介绍了限制性三体模型动力学和一条标称接近轨迹，随后分析了所假设的执行器与传感器的影响。研究了诸如选定故障等关键方面，以确保通过脉冲机动实现任务的被动安全。文中还给出了一个近程闭环制导的示例，并利用文献中可用的星历模型验证了整体性能。},
  file = {/home/ouyangjiahong/Zotero/storage/FT7W3R2W/Innocenti 等 - 2022 - Dynamics and control analysis during rendezvous in non-keplerian earth—moon orbits.pdf}
}


@article{QianYingJingDiYuePingDongDianNiZhouQiGuiDaoTanCeQiZiZhuDaoHangFangFaYanJiu2013,
  title = {{地月平动点拟周期轨道探测器自主导航方法研究}},
  author = {{钱霙婧} and {荆武兴} and {高长生} and {韦文书}},

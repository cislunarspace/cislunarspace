@article{QuJinYueKongJianSanWeiZhouQiGuiDaoBianGuiCeLueYanJiu2025,
  title = {{近月空间三维周期轨道变轨策略研究}},
  author = {{屈琮渊} and {陈丹鹤} and {刘培彦} and {罗敬升} and Abderrahman, Haddouche},
  year = 2025,
  journal = {载人航天},
  number = {第5期},
  pages = {578--586},
  issn = {1674-5825},
  abstract = {近直线晕轨道（NRHO）与Butterfly轨道因其轨道立体特性，具有无月球遮挡通讯以及探测月球极区便利等优势，优先被考虑作为未来中继通信、载人登月等空间任务的中转轨道。出于卫星变轨任务需求，需要研究综合引力作用下地月空间中针对上述轨道的低能量变轨方案。基于双圆限制性四体系统，设计了针对NRHO和Butterfly轨道的双脉冲方案。首先基于微分修正方法计算了目标转移轨道族，其次计算了双圆四体系统下由周期共振比2 {$:$}1月球周期的L\textsubscript{2} 南NRHO至不同周期NRHO和Butterfly轨道的最优变轨相位族。仿真表明，变轨相位与脉冲消耗不随目标轨道变化呈现单调增减性质，最优转移轨道由多个解集拼接而成，且四体系统最优变轨脉冲消耗与转移时间小于三体系统。针对南族NRHO内转移，脉冲消耗范围为（0.007 km／s，0.096 km／s），至北族NRHO转移消耗范围是（0.079 km／s，0.195 km／s），至Butterfly轨道脉冲消耗范围是（0.121 km／s，0.169 km／s）。},
  langid = {chinese},
  keywords = {;NRHO;Butterfly;;}
}


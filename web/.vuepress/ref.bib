@article{NiuYanMianXiangRenGongZhiNengXiTongDeKuaCengJiAnQuanLouDongFenXiYuLiangHuaJianMo2026,
  title = {{面向人工智能系统的跨层级安全漏洞分析与量化建模}},
  author = {{钮艳} and {刘权} and {田川} and {刘洋} and {马小青} and {翟梦璇}},
  year = 2026,
  journal = {北京理工大学学报},
  volume = {46},
  number = {3},
  pages = {325--332},
  doi = {10.15918/j.tbit1001-0645.2025.148},
  urldate = {2026-05-19},
  abstract = {针对人工智能（AI）系统因高复杂性与跨层耦合性而产生的安全威胁，提出一种跨层级安全漏洞的量化分析方法.该方法构建一个涵盖硬件、网络、基础软件、数据、模型算法、智能体与应用层的七层技术架构，并结合漏洞库数据系统性识别各层脆弱点.建立一个由威胁传导概率模型（TCPM）、风险扩散强度模型（RDIM）和防御成本效益模型（DCEM）构成的耦合建模体系.该体系分别用于量化威胁在层级间的传播概率、评估风险沿攻击链的扩散强度，以及测算不同防御措施的成本效益.对1 841个AI相关漏洞的统计分析表明，中高危漏洞占比达65.2\%.以英伟达容器工具包（CVE-2024-0132）漏洞为例的案例验证显示：该漏洞从基础软件层向上传导的概率均超过0.96；经逐层放大后，应用层的最终风险强度达到0.922，属严重风险；在3种防御措施中，针对源头的容器补丁升级成本效益比最高，为0.052.结论表明，该模型体系能够有效揭示AI系统中的风险放大效应与关键防御节点，为制定精准、经济的安全防护策略提供了定量决策依据.},
  langid = {chinese},
  annotation = {Fund: 国家自然科学基金资助项目(62302022)；},
  file = {/home/ouyangjiahong/Zotero/storage/JZFEVZQI/钮艳 等 - 2026 - 面向人工智能系统的跨层级安全漏洞分析与量化建模.pdf}
}

@article{nobiliFirstTestWeak2025,
  title = {On the First Test of the Weak Equivalence Principle in Low Earth Orbit},
  author = {Nobili, Anna M. and Anselmi, Alberto},
  year = 2025,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},
  number = {1},
  pages = {3--24},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10233-z},
  urldate = {2025-10-01},
  abstract = {The Weak Equivalence Principle is the founding pillar of General Relativity, and as such, it should be verified as precisely as possible. The Microscope experiment tested it in low Earth orbit, finding that Pt and Ti test masses fall toward Earth with the same acceleration to about 1 part in 1015, an improvement of about two orders of magnitude over ground tests. Space missions, even if small, are expensive and hard to replicate; yet, the essence of physics is repeatability. This work is an assessment of the Microscope results based on the laws of physics and knowledge from previous experiments, focusing on the limiting thermal noise and the treatment of acceleration outliers. Thermal noise reveals anomalies that we explain by stray sub-{$\mu$}V potentials caused by patch charges, giving rise to an unstable zero. The measurements were affected by numerous acceleration spikes occurring at the synodic frequencies relative to the Earth (the signal frequency) and the Sun, which we interpret as evidence of a thermal origin. In Microscope authors' analysis, the spikes were removed and the resulting gaps replaced with artificial data (up to 35\%, 40\% of the sessions data), which retain memory of the gaps and may simulate or cancel an effect (signal or systematic). An alternative approach based exclusively on real measured data would avoid any ambiguity. The lessons of Microscope are crucial to any future improved mission.},
  langid = {english},
  annotation = {titleTranslation: 首次在近地轨道对弱等效原理进行的测试\\
abstractTranslation: 弱等效原理是广义相对论的基本支柱，因此必须尽可能精确地加以验证。显微实验在近地轨道对其进行了检验，发现铂和钛测试质量以约1\texttimes 10{$^{-15}$}的精度以相同加速度落向地球，相比地面测试提升了约两个数量级。太空任务即便规模较小，也成本高昂且难以复现；然而物理学的本质在于可重复性。本文基于物理学定律及先前实验知识对显微实验结果进行评估，重点关注极限热噪声与加速度异常值的处理。热噪声揭示了由斑电荷引起的亚微伏级寄生电势导致的异常现象，进而产生不稳定的零点。测量结果受到大量加速度尖峰的影响，这些尖峰出现在相对于地球（信号频率）和太阳的会合频率上，我们将其解释为热起源的证据。在显微实验作者的分析中，这些尖峰被移除，产生的数据空缺被人工数据替代（占会话数据的35\%至40\%），这些人工数据保留了空缺的记忆，可能模拟或抵消某种效应（信号或系统误差）。一种完全基于实测数据的替代方法将避免任何歧义。显微实验的经验教训对未来任何改进型任务都至关重要。},
  file = {/home/ouyangjiahong/Zotero/storage/XVQTKK7B/Nobili和Anselmi - 2025 - On the first test of the weak equivalence principle in low earth orbit.pdf}
}


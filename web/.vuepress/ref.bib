@article{bettsVeryLowthrustTrajectory2000,
  title = {Very Low-Thrust Trajectory Optimization Using a Direct {{SQP}} Method},
  author = {Betts, John T.},
  year = 2000,
  month = aug,
  journal = {Journal of Computational and Applied Mathematics},
  volume = {120},

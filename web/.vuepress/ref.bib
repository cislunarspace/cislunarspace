  booktitle = {{{AIAA SciTech Forum}} and {{Exposition}}},
  author = {Thompson, Michael R. and Bolliger, Matthew and R{\'e}, Nathan P. and Davis, Diane C.},
  year = 2022,
  address = {San Diego, CA, United states},
  doi = {10.2514/6.2022-2275},
  abstract = {Stationkeeping strategies for spacecraft in Near Rectilinear Halo Orbits (NRHOs) have been well-studied in recent years, with a particular focus on NASAs upcoming Lunar Gateway. Most of these strategies involve propagating the current best-estimate of a trajectory forward and designing a maneuver to reach a target that exists multiple revolutions into the future. This study focuses on quantifying the dispersions on that propagated trajectory and examining the effect of potential changes to the targeting strategy on these dispersions. A better understanding of the true dispersions of future states as they relate to NRHO stationkeeping can potentially be utilized to develop stationkeeping strategies that lower delta-v costs over the current baseline strategies.},
  langid = {english},
  annotation = {titleTranslation: 近直线晕轨道站位保持策略中的下游不确定性分析}
}


@book{LiuLeiPingDongDianGuiDaoDongLiXueYuTanYueGongChengYingYong2025,
  title = {{平动点轨道动力学与探月工程应用}},
  author = {{刘磊} and {刘勇}},
  year = 2025,
  month = jan,
  publisher = {北京：科学出版社},
  abstract = {本书面向平动点在学术研究领域日益受关注、在工程应用领域日趋受重视的发展趋势，介绍平动点轨道动力学、平动点轨道设计与控制相关理论与方法，尤其是平动点轨道在我国月球探测工程中的实际应用等内容。本书从国内外平动点任务、平动点轨道动力学研究与应用现状梳理提炼关键技术，聚焦平动点轨道动力学中的平动点轨道设计与控制方法，介绍平动点轨道理论与方法的实际工程任务应用，从而将学术研究与我国月球、深空探测任务实践紧密结合，为平动点在我国后续空间探测任务中的应用提供思路和参考。 本书可供月球和深空探测领域的研究人员、任务设计人员与实施人员参考，也可作为空间任务设计和轨道力学等相关专业的教学用书。},
  isbn = {978-7-03-080171-5},
  langid = {chinese}
}


@inproceedings{renDROTransferDesign2024,
  title = {{{DRO}} Transfer Design Method Based on the Stretching Directions in Cisiunar Space},
  booktitle = {2024 {{IAF Space Exploration Symposium}} at the 75th {{International Astronautical Congress}}, {{IAC}} 2024},
  author = {Ren, Chan and Zhang, Renyong and Zhou, Zhuangcaiqing},
  year = 2024,
  series = {2024 {{IAF Space Exploration Symposium}} at the 75th {{International Astronautical Congress}}, {{IAC}} 2024},
  address = {Milan},
  abstract = {Addressing the transfer design issue of distant retrograde orbits (DRO) in the relatively stable Earth-Moon space where the theory of invariant manifolds is no longer applicable, this paper proposes a DRO orbit transfer design method based on the maximum stretching direction. Firstly, the characteristics of DRO orbits are analysed using the stretching direction theory. Secondly, a method based on the maximum stretching direction is studied to achieve orbital phase modulation and transfer design of DRO. The method is expected to provide key insights and strategies for multi- satellite missions and spacecraft docking technologies in the multi-body dynamics environment of life Earth-Moon System.},
  langid = {english},
  annotation = {titleTranslation: 基于地月空间拉伸方向的远距逆行轨道转移设计方法}

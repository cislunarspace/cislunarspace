@inproceedings{subudhiFueloptimalStationkeepingStrategy2020,
  title = {A near Fuel-Optimal Station-Keeping Strategy for Halo Orbits},
  booktitle = {2020 59th {{IEEE Conference}} on {{Decision}} and {{Control}} ({{CDC}})},
  author = {Subudhi, Chinari Subhechha and Vutukuri, Srianish and Padhi, Radhakant},
  year = 2020,
  address = {Jeju, Korea (South)},
  doi = {10.1109/CDC42340.2020.9304327},
  abstract = {In this paper, a near fuel-optimal, receding horizon based station-keeping strategy is designed and implemented to estimate a two-year average station-keeping cost on a L1 Halo orbit in Sun-Earth Circular Restricted Three-Body problem. Impulsive Model Predictive Static Programming, a finite time, non-linear optimal control technique is used to obtain optimal station-keeping maneuvers. The technique involves calculation of sensitivity matrices which are done in a computationally efficient manner owing to their recursive nature. The algorithm is iterative where the guess station-keeping maneuvers are optimally updated by a closed-form equation until an output terminal constraint as well as an optimal cost function are satisfied. The effect of station-keeping horizon time on the total maneuver cost was analyzed in the presence of Solar Radiation Pressure and uncertainties associated with orbit insertion, tracking and maneuver execution errors.},
  langid = {english},
  keywords = {Circular Restricted Three Body Problem,Force,Halo orbits,Mathematical model,Model Predictive Static Programming,Orbits,Predictive models,Space vehicles,Station-keeping,Trajectory,Uncertainty},
  annotation = {titleTranslation: 一种近燃料最优的晕轨道位置保持策略}
}

@article{SuFengYiTiHuaWeiSheShiYuXiaMeiGuoGuoJiaFanQingBaoZhanLuePingXiJiQiShi2025,
  title = {{``一体化威慑''视阈下《美国国家反情报战略》评析及启示}},
  author = {{粟锋} and {黄晞} and {李永杰}},
  year = 2025,
  journal = {情报杂志},
  volume = {44},
  number = {1},
  pages = {74--80},
  urldate = {2026-04-05},
  abstract = {[研究目的]从``一体化威慑''视阈把握2024年美国《国家反情报战略》,研判美国反情报工作的战略动向和最新调整，旨在为中国反情报工作提供参考和启示。[研究方法]采用文本分析和历史分析相结合的方法，通过与拜登政府《国家安全战略》《国防战略》等文本进行关联分析，与前六版美国《国家反情报战略》进行历史比较，揭示拜登政府《国家反情报战略》的内容架构及逻辑，并对其战略影响及限度进行评估。[研究结果/结论]研究表明，2024年美国《国家反情报战略》为拜登政府``一体化威慑''战略提供决策支持，其设定``三大支柱九项目标''积极响应``一体化威慑''战略，在反情报领域对中国实施``一体化威慑'',由于具体实施难以落地而影响有限。基于此，要从理论创新、组织统筹和积极行动三个维度加快构建具有中国特色的反情报体系。},
  langid = {chinese},
  annotation = {Fund: 国家社会科学基金青年项目``习近平总书记关于应对外部环境风险的重要论述研究''(编号:21CKS044)研究成果；},

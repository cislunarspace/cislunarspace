@article{furfaroLeastsquaresSolutionClass2020,
  title = {Least-Squares Solution of a Class of Optimal Space Guidance Problems via Theory of Connections},
  author = {Furfaro, Roberto and Mortari, Daniele},
  year = 2020,
  month = mar,
  journal = {Acta Astronautica},
  volume = {168},
  pages = {92--103},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2019.05.050},
  urldate = {2026-02-04},
  abstract = {In this paper, we apply a newly developed method to solve boundary value problems for differential equations to solve optimal space guidance problems in a fast and accurate fashion. The method relies on the least-squares solution of differential equations via orthogonal polynomials expansion and constrained expression as derived via Theory of Connection (ToC). The application of the optimal control theory to derive the first order necessary conditions for optimality, yields a Two-Point Boundary Value Problem (TPBVP) that must be solved to find state and costate. Combining orthogonal polynomials expansion and ToC, we solve the TPBVP for a class of optimal guidance problems including energy-optimal landing on planetary bodies and fixed-time optimal intercept for a target-interceptor scenario. The performance analysis in terms of accuracy shows the potential of the proposed methodology as applied to optimal guidance problems.},
  langid = {english},
  keywords = {Optimal guidance,Planetary landing,Theory of Connections},
  annotation = {titleTranslation: 一类最优空间制导问题的最小二乘解：基于连接理论\\
abstractTranslation: 在本文中，我们应用一种新方法求解微分方程边值问题，以快速准确地解决最优空间制导问题。该方法基于通过正交多项式展开和由连接理论（ToC）导出的约束表达对微分方程进行最小二乘求解。应用最优控制理论推导最优性的一阶必要条件，产生一个需要求解以得到状态和协态的两点边值问题（TPBVP）。结合正交多项式展开和ToC，我们解决了一类最优制导问题的TPBVP，包括行星体上的能量最优着陆以及目标-拦截器场景下的固定时间最优拦截。精度方面的性能分析显示了所提方法在最优制导问题中的应用潜力},
  file = {/home/ouyangjiahong/Zotero/storage/FFU5RSPN/Furfaro和Mortari - 2020 - Least-squares solution of a class of optimal space guidance problems via theory of connections.pdf;/home/ouyangjiahong/Zotero/storage/4YT9AXQT/S0094576519302292.html}
}

@article{fuStochasticOptimizationStationkeeping2022,
  title = {Stochastic Optimization for Stationkeeping of Periodic Orbits Using a High-Order Target Point Approach},
  author = {Fu, Xiaoyu and Baresi, Nicola and Armellin, Roberto},
  year = 2022,
  journal = {Advances in Space Research},
  volume = {Vol.70},
  number = {No.1},
  pages = {96--111},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2022.04.039},
  abstract = {Periodic orbits in the Restricted Three-Body Problem are widely adopted as nominal trajectories by different missions. To maintain periodic orbits in a three-body regime, a stationkeeping strategy based on a high-order Target Point Approach (TPA) is proposed, where fuel-optimal and error-robust TPA parameters are acquired from stochastic global optimization. Accurate TPA maneuvers are calculated in a high-order fashion enabled by Differential Algebra techniques. Orbit determination epoch is selected using a sensitivity analysis based on the convergence radius of a stroboscopic map. Stochasticity is handled by incorporating Monte Carlo simulations in the process of optimization and the evaluation of high-order ODE expansions is employed to supplant the time-consuming numerical integration. Two specific types of periodic orbits, Near Rectilinear Halo Orbits and Quasi-Satellite Orbits, are investigated to demonstrate the validity and efficiency of the strategy.},
  langid = {english},
  keywords = {Differential Algebra,Periodic orbits,Stationkeeping,Stochastic optimization,Target Point Approach},
  annotation = {titleTranslation: 基于高阶目标点方法的周期轨道站位保持随机优化\\
abstractTranslation: 受限三体问题中的周期轨道被广泛用作不同任务的标称轨迹。为维持三体环境下的周期轨道，提出了一种基于高阶目标点法（TPA）的站位保持策略，其中燃料最优且对误差鲁棒的TPA参数通过随机全局优化获得。精确的TPA机动计算借助微分代数技术以高阶方式实现。基于频闪映射收敛半径的灵敏度分析选取定轨历元。随机性通过在优化过程中融入蒙特卡洛仿真进行处理，并采用高阶常微分方程展开计算替代耗时的数值积分。为验证该策略的有效性与高效性，研究了两种特定类型的周期轨道------近直线晕轨道与准卫星轨道}
}


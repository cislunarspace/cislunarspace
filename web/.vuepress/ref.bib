@article{caillauMinimumFuelControl2012,
  title = {Minimum Fuel Control of the Planar Circular Restricted Three-Body Problem},
  author = {Caillau, J.-B. and Daoud, B. and Gergaud, J.},
  year = 2012,
  month = oct,
  journal = {Celestial Mechanics and Dynamical Astronomy},
  volume = {114},
  number = {1-2},
  pages = {137--150},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-012-9443-x},
  urldate = {2025-09-25},
  abstract = {The circular restricted three-body problem is considered to model the dynamics of an artificial body submitted to the attraction of two planets. Minimization of the fuel consumption of the spacecraft during the transfer, e.g. from the Earth to the Moon, is considered. In the light of the controllability results of Caillau and Daoud (SIAM J Control Optim, 2012), existence for this optimal control problem is discussed under simplifying assumptions. Thanks to Pontryagin maximum principle, the properties of fuel minimizing controls is detailed, revealing a bang-bang structure which is typical of L1-minimization problems. Because of the resulting non-smoothness of the Hamiltonian two-point boundary value problem, it is difficult to use shooting methods to compute numerical solutions (even with multiple shooting, as many switchings on the control occur when low thrusts are considered). To overcome these difficulties, two homotopies are introduced: One connects the investigated problem to the minimization of the L2-norm of the control, while the other introduces an interior penalization in the form of a logarithmic barrier. The combination of shooting with these continuation procedures allows to compute fuel optimal transfers for medium or low thrusts in the Earth--Moon system from a geostationary orbit, either towards the L1 Lagrange point or towards a circular orbit around the Moon. To ensure local optimality of the computed trajectories, second order conditions are evaluated using conjugate point tests.},
  copyright = {http://www.springer.com/tdm},
  langid = {english},
  annotation = {titleTranslation: 平面圆形限制性三体问题的最小燃料控制\\
abstractTranslation: 考虑采用圆形限制性三体问题来模拟受两颗行星引力作用的人造天体动力学。研究航天器在转移过程中（例如从地球到月球）的燃料消耗最小化问题。基于Caillau与Daoud（SIAM J Control Optim, 2012）的可控性结果，在简化假设下讨论了该最优控制问题的存在性。借助庞特里亚金极大值原理，详细阐述了燃料最小化控制的性质，揭示了L1范数最小化问题典型的``bang-bang''结构。由于由此导致的哈密顿两点边值问题非光滑性，即便采用多重打靶法，在考虑低推力时控制切换频繁，数值求解仍然困难。为克服这些困难，引入两种同伦方法：一种将所研究问题与L2范数控制最小化问题相连，另一种则以对数障碍函数形式引入内部惩罚。将打靶法与此类延拓过程相结合，即可计算地球-月球系统中从地球静止轨道出发、前往L1拉格朗日点或月球周围圆形轨道的中等或低推力燃料最优转移。为验证所得轨迹的局部最优性，利用共轭点检验评估二阶条件。},
  file = {/home/ouyangjiahong/Zotero/storage/7P53A6KM/Caillau 等 - 2012 - Minimum fuel control of the planar circular restricted three-body problem.pdf}
}


@article{coakleyReviewMethodsMatch2014,
  title = {A Review of Methods to Match Building Energy Simulation Models to Measured Data},
  author = {Coakley, Daniel and Raftery, Paul and Keane, Marcus},
  year = 2014,
  month = sep,
  journal = {Renewable and Sustainable Energy Reviews},
  volume = {37},
  pages = {123--141},
  issn = {1364-0321},
  doi = {10.1016/j.rser.2014.05.007},
  urldate = {2026-02-19},
  abstract = {Whole building energy simulation (BES) models play a significant role in the design and optimisation of buildings. Simulation models may be used to compare the cost-effectiveness of energy-conservation measures (ECMs) in the design stage as well as assessing various performance optimisation measures during the operational stage. However, due to the complexity of the built environment and prevalence of large numbers of independent interacting variables, it is difficult to achieve an accurate representation of real-world building operation. Therefore, by reconciling model outputs with measured data, we can achieve more accurate and reliable results. This reconciliation of model outputs with measured data is known as calibration. This paper presents a detailed review of current approaches to model development and calibration, highlighting the importance of uncertainty in the calibration process. This is accompanied by a detailed assessment of the various analytical and mathematical/statistical tools employed by practitioners to date, as well as a discussion on both the problems and the merits of the presented approaches.},
  langid = {english},
  keywords = {Calibration,EnergyPlus,Optimisation,Review,Simulation,Uncertainty},
  annotation = {titleTranslation: 建筑能耗模拟模型与实测数据匹配方法综述\\
abstractTranslation: 整栋建筑能耗模拟（BES）模型在建筑设计与优化中具有重要作用。在设计阶段，可运用模拟模型比较节能措施（ECMs）的成本效益；在运行阶段，亦可借以评估多种性能优化方案。然而，由于建筑环境的复杂性以及大量独立交互变量的普遍存在，精准还原真实建筑运行状态颇具挑战。因此，通过将模型输出与实测数据相校准，我们能够获得更准确、可靠的结果。这种模型输出与实测数据的校准过程被称为标定。本文详细综述了当前模型开发与标定的主流方法，强调了不确定性在校准过程中的重要性。同时，本文系统评估了从业者迄今所使用的各类分析与数理/统计工具，并对所提方法的优势与不足进行了讨论},

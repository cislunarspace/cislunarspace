@article{luquearrieroSystemArchitectureGNC2018,
  title = {System Architecture and {{GNC}} Algorithms for Lunar Surface Precision Landing and Transfer Trajectories Optimization},
  author = {Luque Arriero, D. and Artuso, G. and Bigi, G. and Crema, M. and Dragoni, M. and Governale, G. and Hacene Lhadj, K. and Tanner, D. J.},
  year = 2018,
  journal = {Proceedings of the International Astronautical Congress, IAC},
  issn = {0074-1795},
  abstract = {Space Exploration is currently at the center of a renewed wave of interest, with particular attention devoted to manned missions towards the Moon, Mars and beyond. In line with ESA Exploration Roadmap, current efforts are being focused on the concept of a Moon village, capable of functioning as a permanent human outpost and thought as intermediate step for further exploration towards more remote destinations. The sustained human presence at the outpost demands for frequent transfers between the lunar surface and the Deep Space Gateway (DSG) required for the provision of resources to the village and for crew transportation. The landing and take-off of transfer vehicles is expected to exploit spaceport facilities, built in specific locations on the lunar surface and, therefore, requiring the landing procedure to be as precise and reliable as possible, with the aim of reducing the risk of damage to structures or vehicles. A further constraint concerns the minimization of propellant consumption during transfers between the surface and the lunar orbit. Approaches based on Convex Optimization have already been successfully employed in space applications to increase performances and reliability of landing procedures. Characterised by efficient and deterministic convergence capabilities, the associated algorithms are able to provide numerical solutions to minimization problems with computational times compatible with real-time onboard applications. The purpose of this paper is to provide an overview of the architecture of the systems involved in the guidance, navigation and control of transfer elements required to travel between the lunar surface and the DSG. Special attention is devoted to Convex Optimization algorithms for trajectory optimization and control, analysing both the landing and the DSG targeting processes.},
  langid = {english},
  keywords = {Convex Optimisation,CR3BP,GMAT,LOP-G,NRHO},
  annotation = {titleTranslation: 月球表面精确着陆与转移轨迹优化的系统架构与制导导航控制算法\\
abstractTranslation: 太空探索目前正处于新一轮关注浪潮的中心，其中载人登月、登火及更远深空任务尤其受到重视。根据欧洲空间局（ESA）探索路线图，当前工作聚焦于``月球村''概念------该基地旨在成为永久性人类前哨站，并被视为向更远目标进一步探索的中继步骤。为实现前哨站的持续人类驻留，需频繁往返于月面与深空门户（DSG）之间，以保障物资供应及人员运输。转移飞行器的着陆与起飞预计将利用建在月面特定位置的太空港设施，因此要求着陆程序尽可能精确可靠，以降低对结构或飞行器造成损坏的风险。另一约束条件涉及在月面与月球轨道间转移过程中推进剂消耗的最小化。基于凸优化的方法已在空间应用领域成功用于提升着陆程序的性能与可靠性。这类算法具有高效且确定性收敛的特性，能够以与实时星载应用兼容的计算时间，为最小化问题提供数值解。本文旨在概述用于月面与DSG之间转移飞行器的制导、导航与控制系统架构，并重点分析用于轨迹优化与控制的凸优化算法，分别探讨着陆过程与DSG目标瞄准过程。}
}


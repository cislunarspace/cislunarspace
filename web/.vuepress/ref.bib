@article{deitosAdvantagesExploitingHierarchical2017,
  title = {On the Advantages of Exploiting the Hierarchical Structure of Astrodynamical Models},
  author = {Dei Tos, Diogene Alessandro and Topputo, Francesco},
  year = 2017,
  month = jul,
  journal = {Acta Astronautica},
  volume = {136},
  pages = {236--247},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2017.02.025},
  urldate = {2025-11-06},
  abstract = {In this paper an algorithm is developed that combines the capabilities and advantages of several different astrodynamical models of increasing complexity. Splitting these models in a strict hierarchical order yields a clearer grasp on what is available. With the effort of developing a comprehensive model overhead, the equations for the spacecraft motion in simpler models can be readily obtained as particular cases. The proposed algorithm embeds the circular and elliptic restricted three-body problems, the four-body bicircular and concentric models, an averaged n-body model, and, at the top hierarchic ladder, the full ephemeris SPICE-based restricted n-body problem. The equations of motion are reduced to the assignment of 13 time-varying coefficients, which multiply the states and the gravitational potential to reproduce the proper vector field. This approach yields an efficient and quick way to check solutions for different dynamics and parameters. We show that in bottom-up applications, a gradual increase of model complexity benefits accuracy, the chances of success and the convergence rate of a continuation algorithm. Case studies are simple periodic orbits and low-energy transfers.},
  langid = {english},
  annotation = {titleTranslation: 论利用天体动力学模型层级结构的优势\\
abstractTranslation: 本文提出了一种算法，该算法融合了多种不同复杂程度的天体动力学模型的能力与优势。通过将这些模型按照严格的层级顺序拆分，可更清晰地理解现有模型体系。在构建综合模型框架的总体努力下，更简化的航天器运动方程可视为特例而直接导出。所提算法涵盖了圆型与椭圆型限制性三体问题、四体双圆与同心模型、平均化n体模型，以及层级顶端的基于完整星历SPICE的限制性n体问题。运动方程被简化为13个时变系数，这些系数作用于状态量与引力势，以生成正确的矢量场。该方法能够高效快速地检验不同动力学条件与参数下的解。研究表明，在自下而上的应用中，逐步增加模型复杂度有助于提升精度、成功概率以及延拓算法的收敛速度。案例研究选取了简单周期轨道与低能量转移轨道。},
  file = {/home/ouyangjiahong/Zotero/storage/RWMAME9T/Dei Tos和Topputo - 2017 - On the advantages of exploiting the hierarchical structure of astrodynamical models.pdf}
}


@article{feldhackerReducedCostMission2016,
  title = {Reduced Cost Mission Design Using Surrogate Models},
  author = {Feldhacker, Juliana D. and Jones, Brandon A. and Doostan, Alireza and Hampton, Jerrad},
  year = 2016,
  month = jan,
  journal = {Advances in Space Research},
  volume = {57},
  number = {2},
  pages = {588--603},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2015.11.002},
  urldate = {2025-12-15},
  abstract = {This paper uses surrogate models to reduce the computational cost associated with spacecraft mission design in three-body dynamical systems. Sampling-based least squares regression is used to project the system response onto a set of orthogonal bases, providing a representation of the {$\Delta$}V required for rendezvous as a reduced-order surrogate model. Models are presented for mid-field rendezvous of spacecraft in orbits in the Earth--Moon circular restricted three-body problem, including a halo orbit about the Earth--Moon L2 libration point (EML-2) and a distant retrograde orbit (DRO) about the Moon. In each case, the initial position of the spacecraft, the time of flight, and the separation between the chaser and the target vehicles are all considered as design inputs. The results show that sample sizes on the order of 102 are sufficient to produce accurate surrogates, with RMS errors reaching 0.2m/s for the halo orbit and falling below 0.01m/s for the DRO. A single function call to the resulting surrogate is up to two orders of magnitude faster than computing the same solution using full fidelity propagators. The expansion coefficients solved for in the surrogates are then used to conduct a global sensitivity analysis of the {$\Delta$}V on each of the input parameters, which identifies the separation between the spacecraft as the primary contributor to the {$\Delta$}V cost. Finally, the models are demonstrated to be useful for cheap evaluation of the cost function in constrained optimization problems seeking to minimize the {$\Delta$}V required for rendezvous. These surrogate models show significant advantages for mission design in three-body systems, in terms of both computational cost and capabilities, over traditional Monte Carlo methods.},
  langid = {english},
  keywords = {Asymptotic sampling,Maneuver design,Spacecraft rendezvous,Surrogate model},
  annotation = {titleTranslation: 基于代理模型的低成本任务设计\\
abstractTranslation: 本文采用代理模型来降低三体动力学系统中航天器任务设计的计算成本。通过基于采样的最小二乘回归，将系统响应投影到一组正交基上，从而得到交会所需{$\Delta$}V的降阶代理模型表示。针对地月圆形限制性三体问题中的中程交会场景，分别建立了绕地月L2拉格朗日点（EML-2）晕轨道以及月球远距离逆行轨道（DRO）上的航天器模型。每种情况下，均将航天器初始位置、飞行时间以及追踪航天器与目标航天器之间的分离距离作为设计输入。结果表明，约10{$^2$}量级的样本量足以生成精确的代理模型，其中晕轨道的均方根误差达到0.2 m/s，而DRO的误差低于0.01 m/s。调用一次生成的代理模型比使用全精度传播器计算相同解快两个数量级。进一步利用代理模型中求解的展开系数，对每个输入参数进行{$\Delta$}V全局灵敏度分析，发现航天器之间的分离距离是{$\Delta$}V成本的主要贡献因素。最后，证明该模型在求解以最小化交会所需{$\Delta$}V为目标的约束优化问题时，可用于低成本评估代价函数。相比传统蒙特卡洛方法，这些代理模型在三体系统任务设计的计算成本和能力方面均显示出显著优势。},
  file = {/home/ouyangjiahong/Zotero/storage/WNQGBV65/Feldhacker 等 - 2016 - Reduced cost mission design using surrogate models.pdf;/home/ouyangjiahong/Zotero/storage/V2CP3LB6/S0273117715007887.html}
}

@article{fengDetectorPerformanceGammaray2024,
  title = {Detector Performance of the Gamma-Ray Transient Monitor Onboard {{DRO-a}} Satellite},
  author = {Feng, Pei-Yi and An, Zheng-Hua and Zhang, Da-Li and Wang, Chen-Wei and Zheng, Chao and Yang, Sheng and Xiong, Shao-Lin and Liu, Jia-Cong and Li, Xin-Qiao and Gong, Ke and Liu, Xiao-Jing and Gao, Min and Wen, Xiang-Yang and Liu, Ya-Qing and Zhao, Xiao-Yun and Zhang, Fan and Lu, Xi-Lei Sun Hong},
  year = 2024,
  journal = {Science China Physics, Mechanics \& Astronomy},
  volume = {Vol.67},
  number = {No.11},
  pages = {111013},
  doi = {10.1007/s11433-024-2458-9},
  abstract = {The Gamma-ray Transient Monitor (GTM) is an all-sky monitor onboard the Distant Retrograde Orbit-A (DRO-A) satellite with the scientific objective of detecting gamma-ray transients ranging from 20 keV to 1 MeV. The GTM was equipped with five Gamma-ray Transient Probe (GTP) detector modules utilizing a NaI(Tl) scintillator coupled with a SiPM array. To reduce the SiPM noise, GTP uses a dedicated dual-channel coincident readout design. In this work, we first studied the impact of different coincidence times on the detection efficiency and ultimately selected a 0.5 \textmu s time coincidence window for offline data processing. To test the performance of the GTPs and validate the Monte-Carlo-simulated energy response, we conducted comprehensive ground calibration tests using the Hard X-ray Calibration Facility (HXCF) and radioactive sources, including the energy response, detection efficiency, spatial response, bias-voltage response, and temperature dependence. We extensively present the ground calibration results and validate the design and mass model of the GTP detector, thus providing the foundation for in-flight observations and scientific data analysis.},
  langid = {english},
  keywords = {DRO-A satellite,energy response,gamma-ray detector,ground calibration,NaI(Tl) detector},
  annotation = {titleTranslation: DRO-a卫星搭载的伽马射线瞬变监测器探测器性能\\
abstractTranslation: 伽马射线瞬变监测器（GTM）是搭载于远距离逆行轨道-A（DRO-A）卫星上的全天区监测器，其科学目标是探测能量范围从20 keV到1 MeV的伽马射线瞬变事件。GTM配备了五个伽马射线瞬变探针（GTP）探测模块，采用NaI(Tl)闪烁体耦合SiPM阵列的设计。为降低SiPM噪声，GTP采用了专用的双通道符合读出方案。本研究首先分析了不同符合时间对探测效率的影响，最终选定0.5 {$\mu$}s的时间符合窗口用于离线数据处理。为测试GTP的性能并验证蒙特卡洛模拟的能量响应，我们利用硬X射线校准装置（HXCF）及放射源开展了全面的地面标定测试，内容包括能量响应、探测效率、空间响应、偏压响应及温度依赖性。本文详尽呈现了地面标定结果，并验证了GTP探测器的设计与质量模型，从而为在轨观测与科学数据分析奠定基础}
}


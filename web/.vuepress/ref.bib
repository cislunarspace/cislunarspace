@inproceedings{laraFastEfficientAlgorithm2018,
  title = {A Fast an Efficient Algorithm for the Computation of Distant Retrograde Orbits},
  booktitle = {7th {{International Conference}} on {{Astrodynamics Tools}} and {{Techniques}} ({{ICATT}} 2018)},
  author = {Lara, Martin},
  year = 2018,
  series = {7th {{International Conference}} on {{Astrodynamics Tools}} and {{Techniques}} ({{ICATT}} 2018)},
  address = {We\ss ling, Germany},
  abstract = {The construction of an algorithm for the computation of dis- tant retrograde orbits based on the use of Lindstedt series is discussed. The solution is split into the time history of the mean elements, which is useful in the description of the long- term dynamics, and a set of short-period corrections that pro- vide reasonably accurate ephemeris. It is shown that the ana- lytical solution reproduces quite well the behavior of typical distant retrograde orbits with small librations about the co- orbital primary, but it also captures the main features of the dynamics of orbits with large amplitude librations.},
  langid = {english},
  annotation = {titleTranslation: 一种用于计算远距离逆行轨道的快速高效算法}
}

@inproceedings{laraHigherOrderAnalytical2018,
  title = {Higher Order Analytical Solution to the Distant Retrograde Orbits Problem},
  booktitle = {69th {{International Astronautical Congress}}: \#{{InvolvingEveryone}}, {{IAC}} 2018},
  author = {Lara, Martin},
  year = 2018,
  series = {69th {{International Astronautical Congress}}: \#{{InvolvingEveryone}}, {{IAC}} 2018},
  address = {Bremen},
  abstract = {Approximate analytical solutions to the Distant Retrograde Orbits problem are available in the literature. However, because the problem inherently depends on special functions, these solutions are commonly constrained to providing rough approximations of the qualitative dynamics. Here, we rely on perturbation methods and succeed in computing a higher order analytical solution that extends the range of applicability of previous solutions to the problem of relative, quasi-satellite orbits with large librations.},
  langid = {english},
  annotation = {titleTranslation: 高阶解析解在远距离逆行轨道问题中的应用}
}

@article{laraNonlinearLibrationsDistant2018,
  title = {Nonlinear Librations of Distant Retrograde Orbits: A Perturbative Approach---the Hill Problem Case},
  shorttitle = {Nonlinear Librations of Distant Retrograde Orbits},
  author = {Lara, Martin},
  year = 2018,
  month = sep,
  journal = {Nonlinear Dynamics},
  volume = {93},
  number = {4},
  pages = {2019--2038},
  issn = {0924-090X, 1573-269X},
  doi = {10.1007/s11071-018-4304-0},
  urldate = {2025-11-20},
  abstract = {The non-integrability of the Hill problem makes its global dynamics be necessarily approached numerically. However, the analytical approach is feasible in the computation of relevant solutions. In particular, the nonlinear dynamics of the Hill problem has been thoroughly investigated by perturbation methods in two cases: when the motion is close to the origin, and in the case of motion about the libration points. Out of the Hill sphere, the analytical approach is also feasible, at least in the case of distant retrograde orbits. Previous analytical investigations of this last case succeeded in the qualitative description of the dynamics, but they commonly failed in providing accurate results. This is a consequence of the essential dependance of the dynamics on elliptic functions, a fact that makes progress in the perturbation approach beyond the lower orders of the solution really difficult. An alternative perturbation approach is proposed here that allows to provide a very simple low-order analytical solution in trigonometric functions, on the one hand, and, while still depending on special functions, to compute higher orders of the solution, on the other.},
  langid = {english},
  annotation = {titleTranslation: 远距离逆行轨道的非线性天平动：一种摄动方法------以希尔问题为例\\
abstractTranslation: 希尔问题的不可积性使其全局动力学必须通过数值方法进行研究。然而，在计算相关解时，解析方法是可行的。具体而言，希尔问题的非线性动力学已在两种情况下通过摄动方法得到深入研究：运动接近原点时，以及围绕平动点的运动。在希尔球之外，解析方法同样可行，至少对于远距离逆行轨道的情况是如此。以往针对后一种情况的解析研究成功实现了对动力学的定性描述，但通常无法提供精确结果。这是因为动力学本质依赖椭圆函数，这一事实使得摄动方法在超越低阶解方面进展极其困难。本文提出了一种替代的摄动方法，一方面能够提供非常简单的、以三角函数表示的低阶解析解，另一方面，在仍需依赖特殊函数的前提下，可以计算更高阶的解},
  file = {/home/ouyangjiahong/Zotero/storage/4T9XI6AC/Lara - 2018 - Nonlinear librations of distant retrograde orbits a perturbative approach—the hill problem case.pdf}
}

@article{lariNatureLaplaceResonance2024,
  title = {The Nature of the Laplace Resonance between the Galilean Moons},
  author = {Lari, Giacomo and Saillenfest, Melaine},
  year = 2024,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {3},
  pages = {19--41},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10191-6},
  urldate = {2025-10-01},
  abstract = {The Laplace resonance is a mean-motion resonance that involves the three inner Galilean moons of Jupiter. However, its true nature is in part unclear; in particular, different views can be found in the literature on whether the Laplace resonance is a pure three-body resonance or a mere superposition of two-body resonances. To settle this question, we conduct a thorough analysis of the many resonances involved, starting from the two-body 2:1 commensurabilities of the couples Io--Europa and Europa--Ganymede, and ending with the three-body 4:2:1 commensurability between the three moons. By artificially varying the parameters of the system and monitoring its fundamental frequencies, we cartography all resonances involved and their interactions. From the analysis of the individual 2:1 commensurabilities, we find that despite the oscillation of the resonant angles they are not genuine resonances, as the trajectory of the system in the phase space is not enclosed by separatrices. On the contrary, as suggested by previous works, we show that the only current true mean-motion resonance is the pure three-body resonance between all three satellites. Moreover, we find that the current values of the moons' orbital elements make the Laplace resonance sufficiently separated from the individual two-body 2:1 resonances, preventing chaotic effects from appearing.},
  langid = {english},
  annotation = {titleTranslation: 伽利略月球之间拉普拉斯共振的性质。\\
abstractTranslation: 拉普拉斯共振是涉及木星三颗内侧伽利略卫星的平均运动共振。然而，其本质在某种程度上尚未明确；特别是在文献中，关于拉普拉斯共振究竟是纯粹的三体共振，还是仅仅为二体共振的叠加，存在不同观点。为解答此问题，我们对所涉及的诸多共振进行了深入分析，从木卫一--木卫二和木卫二--木卫三之间的2:1二体可公度性入手，直至三颗卫星间的4:2:1三体可公度性。通过人为改变系统参数并监测其基频，我们绘制了所有相关共振及其相互作用的图谱。对单个2:1可公度性的分析表明，尽管存在共振角的振荡，但它们并非真正的共振，因为系统在相空间中的轨迹并未被分界线包围。相反，正如先前研究所指出的，我们证实目前唯一的真正平均运动共振是纯粹的三体共振，涉及全部三颗卫星。此外，我们发现当前卫星轨道根数的取值使得拉普拉斯共振与单个二体2:1共振充分分离，从而避免了混沌效应的出现。},
  file = {/home/ouyangjiahong/Zotero/storage/Z3XUJ2B4/Lari和Saillenfest - 2024 - The nature of the laplace resonance between the galilean moons.pdf}
}


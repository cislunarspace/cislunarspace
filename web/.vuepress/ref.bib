@phdthesis{DuBingXiaoMianXiangZaiGuiJiaZhuDeDuoHangTianQiJiaoHuiRenWuGuiHuaFangFaYanJiu2014,
  type = {{硕士学位论文}},
  title = {{面向在轨加注的多航天器交会任务规划方法研究}},
  author = {{都柄晓}},
  year = 2014,
  address = {长沙},
  abstract = {在轨加注是一种通过服务航天器对在轨运行目标航天器的推进剂等耗费品进行补给的在轨服务方式,在轨加注任务的经济性要求在一次任务中对多颗卫星进行服务,任务规划是实现在轨加注任务经济性的前提。本文以在轨加注为背景,开展多航天器交会任务规划研究。1、采用双脉冲多圈交会作为机动方式,建立了脉冲作用下的交会动力学模型。基于固定起始点与时间的计算方法,探究了起始滑移与终端滑移对轨道转移冲量消耗的影响。通过在等高图上作辅助线的方法,设计了轨道转移的滑移律。实现了给定时间内移动目标交会的快速寻优。2、针对地球同步轨道在轨加注任务规划问题,在加注过程中充分考虑目标星燃料的需求量与服务星燃料的携带量,在小角度下忽略共面机动的燃料消耗,仅考虑轨道面的改变,对轨道转移的燃料消耗进行快速估算。建立了``多对多''GSO卫星的在轨加注任务规划模型,并将问题进行了分解。考虑了发射入轨的燃料消耗,以及由火箭运载能力和卫星的燃料携带能力的差异带来的一箭多星的可能性。算例结果验证了模型与算法的有效性与可行性。3、针对异面圆轨道分布式加注任务规划问题,考虑同一轨道面内的卫星位置互换,将该问题表述为一个非完全的赋权三部图匹配问题(AP3)。采用遗传算法对异面卫星间的变轨进行求解,求出所有可能的组合情况,再采用自编整数编码遗传算法将非完全AP3转化为完全二部图,利用Kuhn-Mundres算法对二部图的匹配进行求解。结果表明,针对异面角度相差较小的情况,算法具有较好的收敛性,燃料传输的代价在可接受的范围内。4、针对基于合作交会的一对多在轨加注任务规划问题,选取圆轨道上卫星星座作为加注目标,建立了基于合作机动的多航天器加注任务规划模型,通过使目标星实施有利于任务的合作机动,先改变目标星的位置,然后再使服务星与之交会,从而为整体任务带来优化。建立了两层混合优化模型,设计了多岛遗传算法与序列二次规划相结合的优化算法求解上层的服务星路径优化,保证了求解过程的全局最优与快速收敛。推导了一种解析方法用于快速计算下层的目标星机动位置选择。算例结果表明,基于合作交会的一对多在轨加注策略要明显优于非合作的一对多加注策略。论文工作可以为一对多、多对多以及分布式策略下的多航天器在轨加注的交会任务规划提供有价值的参考。},
  collaborator = {{赵勇}},
  langid = {chinese},
  school = {国防科学技术大学},
  annotation = {CNKICite: 15},
  file = {/home/ouyangjiahong/Zotero/storage/AQFCPK33/都柄晓 - 2014 - 面向在轨加注的多航天器交会任务规划方法研究.pdf}
}


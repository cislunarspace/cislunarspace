@article{zuehlkeRendezvousProximityOperations2023,
  title = {Rendezvous and Proximity Operations in Cislunar Space Using Linearized Dynamics for Estimation},
  author = {Zuehlke, David and Tiwari, Madhur and Jebari, Khalid and Kidambi, Krishna Bhavithavya},
  year = 2023,
  month = jul,
  journal = {Aerospace},
  volume = {10},
  number = {8},
  pages = {674--705},
  issn = {2226-4310},
  doi = {10.3390/aerospace10080674},
  urldate = {2025-11-25},
  abstract = {As interest in Moon exploration grows, and efforts to establish an orbiting outpost intensify, accurate modeling of spacecraft dynamics in cislunar space is becoming increasingly important. Contrary to satellites in Low Earth Orbit (LEO), where it takes around 5 ms to communicate back and forth with a ground station, it can take up to 2.4 s to communicate with satellites near the Moon. This delay in communication can make the difference between a successful docking and a catastrophic collision for a remotely controlled satellite. Moreover, due to the unstable nature of trajectories in cislunar space, it is necessary to design spacecraft that can autonomously make frequent maneuvers to stay on track with a reference orbit. The communication delay and unstable trajectories are exactly why autonomous navigation is critical for proximity operations and rendezvous and docking missions in cislunar space. Because spacecraft computational hardware is limited, reducing the computational complexity of navigational algorithms is both desirable and often necessary. By the introduction of a linear system approach to the deputy spacecraft motion, this research avoids the computational burden of integrating the deputy relative equations of motion. In this research, the relative CR3BP equations of motion are derived and linearized using a matrix exponential approximation. This research continues the development of the matrix exponential linearized relative circular restricted three-body problem (CR3BP) equations by applying the dynamics model to estimation and control applications. A simulation is performed to compare state estimation results obtained from using the linearized equations of motion utilizing a Kalman filter and for state estimation utilizing an unscented Kalman filter with the full nonlinear equations of motion. The linearized exponential model is shown to be sufficient for state estimation in the presence of noisy measurements for an example scenario. Additionally, a linear quadratic regulator (LQR) controller was added to optimally control a deputy spacecraft to rendezvous with a chief spacecraft in cislunar space. The contribution of this work is twofold: to provide a proof of concept that the matrix exponential solution for the linearized relative CR3BP equations can be used as the dynamics model for state estimation, as well as to simulate an optimal rendezvous maneuver in the presence of measurement noise.},
  langid = {english},
  annotation = {titleTranslation: 使用线性动力学进行估计的地月空间中的交会和邻近操作\\
abstractTranslation: 随着人类对月球探索的兴趣日益增长以及建立轨道前哨站的努力不断推进，对地月空间中航天器动力学进行精确建模正变得愈发重要。与近地轨道（LEO）卫星不同------其与地面站往返通信仅需约5毫秒------而月球附近的卫星通信延迟可长达2.4秒。对于远程操控的卫星而言，这一通信延迟可能决定着成功对接与灾难性碰撞的差别。此外，由于地月空间轨迹具有不稳定性，必须设计能够自主进行频繁机动以保持在参考轨道上的航天器。正是通信延迟与轨迹不稳定性，使得自主导航对于地月空间的近距离操作、交会对接任务至关重要。由于航天器计算硬件资源有限，降低导航算法的计算复杂度既符合需求也往往是必要的。本文通过引入线性系统方法描述从星运动，避免了积分从星相对运动方程带来的计算负担。本研究推导了相对CR3BP运动方程，并利用矩阵指数近似对其线性化。进一步将矩阵指数线性化圆形限制性三体问题（CR3BP）方程应用于估计与控制，完善了该动力学模型。通过仿真对比了基于线性化运动方程结合卡尔曼滤波的状态估计结果，与采用全非线性运动方程结合无迹卡尔曼滤波的状态估计结果。示例场景表明，在存在测量噪声的条件下，线性化指数模型足以用于状态估计。此外，还添加了线性二次型调节器（LQR）控制器，以优化控制从星在地月空间与主星交会。本研究的贡献有二：其一，证明线性化相对CR3BP方程的矩阵指数解可作为状态估计的动力学模型；其二，在存在测量噪声的情况下仿真了最优交会机动。},
  file = {/home/ouyangjiahong/Zotero/storage/K48NAPTG/Zuehlke 等 - 2023 - Rendezvous and proximity operations in cislunar space using linearized dynamics for estimation.pdf}
}

@article{zuianiDirectTranscriptionLowthrust2012,
  title = {Direct Transcription of Low-Thrust Trajectories with Finite Trajectory Elements},
  author = {Zuiani, Federico and Vasile, Massimiliano and Palmas, Alessandro and Avanzini, Giulio},
  year = 2012,
  month = mar,
  journal = {Acta Astronautica},
  volume = {72},
  pages = {108--120},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2011.09.011},
  urldate = {2026-01-26},
  abstract = {This paper presents a novel approach to the design of low-thrust trajectories, based on a first order approximated analytical solution of Gauss planetary equations. This analytical solution is shown to have a better accuracy than a second-order explicit numerical integrator and at a lower computational cost. Hence, it can be employed for the fast propagation of perturbed Keplerian motion when moderate accuracy is required. The analytical solution was integrated in a direct transcription method based on a decomposition of the trajectory into direct finite perturbative elements (DFPET). DFPET were applied to the solution of two-point boundary transfer problems. Furthermore the paper presents an example of the use of DFPET for the solution of a multiobjective trajectory optimisation problem in which both the total {$\Delta$}V and transfer time are minimised with respect to departure and arrival dates. Two transfer problems were used as test cases: a direct transfer from Earth to Mars and a spiral from a low Earth orbit to the International Space Station.},
  langid = {english},
  keywords = {Global optimisation,Low-thrust,Orbital dynamics,Trajectory optimisation},
  annotation = {titleTranslation: 有限轨迹单元下的低推力轨道直接转录法\\
abstractTranslation: 本文提出了一种基于高斯行星方程一阶近似解析解的低推力轨迹设计新方法。该解析解在计算成本更低的情况下，精度优于二阶显式数值积分器，因此可在中等精度要求下用于摄动开普勒运动的快速传播。该解析解被集成到基于轨迹分解为直接有限摄动单元（DFPET）的直接转录方法中，DFPET被应用于两点边界转移问题的求解。此外，本文给出了一个使用DFPET解决多目标轨迹优化问题的示例，其中总{$\Delta$}V和转移时间均相对于出发和到达日期进行最小化。两个转移问题被用作测试案例：从地球到火星的直接转移，以及从低地球轨道到国际空间站的螺旋转移},
  file = {/home/ouyangjiahong/Zotero/storage/299CYQ5L/Zuiani 等 - 2012 - Direct transcription of low-thrust trajectories with finite trajectory elements.pdf;/home/ouyangjiahong/Zotero/storage/WXAC7YI2/S0094576511002852.html}
}

@article{ZuoGuangXianJinKongJianYunShuXiTongQiDongSheJiZongShu2021,
  title = {先进空间运输系统气动设计综述},
  author = {{左光} and {艾邦成}},
  year = 2021,
  journal = {航空学报},
  volume = {42},
  number = {2},
  pages = {1--11},
  abstract = {天地往返运输系统是能够自由进出空间轨道、安全返回地球表面、执行天地往返运输任务的航天运输体系.近年来,随着先进动力、新材料、新工艺的带动效应逐渐显现,各航天集团开始了新一轮先进天地往返系统的研究,其中大量研究项目针对具备完全可重复使用、可大幅降低运送有效载荷进入太空成本的先进天地往返运输系统展开.本文针对这一热点领域进行综述性研究,对不同类型进出大气层飞行器的气动设计特点进行了分析,结果表明跨大气层飞行器是天地往返运输系统的主要载体,认为未来主要以火箭助推入轨滑翔再入和水平起飞水平返回为主要发展方向,两类飞行在气动设计方面有高超飞行器宽域飞行适应性的共性难题,同时在气动-动力一体化化设计方面又有较大的差异.},
  file = {/home/ouyangjiahong/Zotero/storage/2G47BXQR/左光和艾邦成 - 2021 - 先进空间运输系统气动设计综述.pdf}
}


@article{houQuasiperiodicMotionsCollinear2011a,
  title = {On Quasi-Periodic Motions around the Collinear Libration Points in the Real Earth--Moon System},
  author = {Hou, X. Y. and Liu, L.},
  year = 2011,
  month = may,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {110},
  number = {1},
  pages = {71--98},
  issn = {1572-9478},
  doi = {10.1007/s10569-011-9340-8},
  urldate = {2026-02-25},
  abstract = {Due to various perturbations, the collinear libration points of the real Earth--Moon system are not equilibrium points anymore. Under the assumption that the Moon's motion is quasi-periodic, special quasi-periodic orbits called dynamical substitutes exist. These dynamical substitutes replace the geometrical collinear libration points as time-varying equilibrium points. In the paper, the dynamical substitutes of the three collinear libration points in the real Earth--Moon system are computed. For the points L1 and L2, linearized motions around the dynamical substitutes are described, and the variational equations of the dynamical substitutes are reduced to a form with a near constant coefficient matrix. Then higher order analytical formulae of the central manifolds are constructed. Using these analytical solutions as initial seeds, Lissajous orbits and halo orbits are computed with numerical algorithms.},
  langid = {english},
  keywords = {Collinear libration point,Dynamical substitute,Earth-Moon system,Halo orbit,Lissajous orbit,Quasi-periodic orbits},
  annotation = {论文摘要：受各类摄动影响，真实地月系统的共线平动点已非严格意义上的平衡点。在月球运动呈拟周期性的假设下，存在一类特殊的拟周期轨道，即动力学替代轨道。这些动力学替代轨道作为时变平衡点，取代了几何意义上的共线平动点。本文计算了真实地月系统中三个共线平动点的动力学替代轨道。针对L1与L2点，描述了动力学替代轨道附近的线性化运动，并将其变分方程简化为近常系数矩阵形式。进而构建了中心流形的高阶解析表达式。以这些解析解为初始迭代值，通过数值算法计算出利萨如轨道与晕轨道。\\
titleTranslation: 真实地月系统中平动点附近的拟周期运动研究\\
abstractTranslation: 由于各种摄动的影响，真实地月系统中的共线平动点不再是平衡点。在月球运动为准周期的假设下，存在一类特殊的准周期轨道，称为动力学替代。这些动力学替代取代了几何共线平动点，成为时变平衡点。本文计算了真实地月系统中三个共线平动点的动力学替代。对于L1和L2点，描述了动力学替代附近的线性化运动，将其变分方程化为近常系数矩阵的形式。随后构建了中心流形的高阶解析公式。以这些解析解为初值，利用数值算法计算了Lissajous轨道和halo轨道},
  file = {/home/ouyangjiahong/Zotero/storage/G2HZAEAZ/Hou和Liu - 2011 - On quasi-periodic motions around the collinear libration points in the real earth–moon system.pdf;/home/ouyangjiahong/Zotero/storage/NK3FT8NQ/Hou和Liu - 2011 - On quasi-periodic motions around the collinear libration points in the real Earth–Moon system.pdf}
}

@article{houQuasiperiodicMotionsTriangular2010a,
  title = {On Quasi-Periodic Motions around the Triangular Libration Points of the Real Earth--Moon System},
  author = {Hou, X. Y. and Liu, L.},
  year = 2010,
  month = nov,
  journal = {Celestial Mechanics \& Dynamical Astronomy},

@article{shuAnalysisPitchforkBifurcations2025,
  title = {Analysis of Pitchfork Bifurcations and Symmetry Breaking in the Elliptic Restricted Three-Body Problem},
  author = {Shu, Haozhe and Lin, Mingpei},
  year = 2025,
  month = aug,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},
  number = {4},
  pages = {21--43},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-025-10252-4},
  urldate = {2025-10-01},
  abstract = {A unified framework is proposed to quantitatively characterize pitchfork bifurcations and associated symmetry breaking in the elliptic restricted three-body problem (ERTBP). It is known that planar/vertical Lyapunov orbits and Lissajous orbits near the collinear libration points undergo pitchfork bifurcations with varying orbital energy. These bifurcations induce symmetry breaking, generating bifurcated families including halo/quasi-halo orbits, axial/quasi-axial orbits, and their corresponding invariant manifolds. Traditional semianalytical methods for constructing halo orbits, based on resonant bifurcation mechanisms, have obstacles in fully exploiting the intrinsic symmetry breaking characteristics in pitchfork bifurcations. In this paper, a unified trigonometric series-based framework is proposed to analyze these bifurcated families from the perspective of coupling-induced bifurcation mechanisms. By introducing a coupling coefficient and various bifurcation equations into the ERTBP, different symmetry breaking is achieved when the coupling coefficient is nonzero. This unified semi-analytical framework captures bifurcations of both periodic/quasi-periodic and transit/non-transit orbits. Furthermore, it reveals that pitchfork bifurcation solutions in the ERTBP fundamentally depend solely on the orbital eccentricity and three amplitude parameters of the system's degrees of freedom, governing both the elliptic direction and the hyperbolic one.},
  langid = {english},
  annotation = {titleTranslation: 椭圆型限制性三体问题中的叉式分岔与对称性破缺分析\\
abstractTranslation: 提出一个统一框架，用于定量描述椭圆型限制性三体问题（ERTBP）中的叉型分岔及伴随的对称性破缺。已知平面/垂直李雅普诺夫轨道及共线平动点附近的利萨如轨道会随轨道能量变化而发生叉型分岔。这些分岔引发对称性破缺，产生包括晕/准晕轨道、轴向/准轴向轨道及其对应不变流形在内的分岔族。传统基于共振分岔机制构建晕轨道的半解析方法，难以充分利用叉型分岔中固有的对称性破缺特性。本文从耦合诱导分岔机制的角度，提出一种基于三角级数的统一框架来分析这些分岔族。通过将耦合系数及多种分岔方程引入ERTBP，当耦合系数非零时实现不同的对称性破缺。该统一半解析框架能够捕捉周期/准周期轨道以及过渡/非过渡轨道的分岔。此外，它揭示了ERTBP中的叉型分岔解本质上仅依赖于轨道偏心率及系统自由度的三个振幅参数，这些参数同时支配椭圆方向与双曲方向},
  file = {/home/ouyangjiahong/Zotero/storage/FBGKYZ8W/Shu和Lin - 2025 - Analysis of pitchfork bifurcations and symmetry breaking in the elliptic restricted three-body probl.pdf}
}

@article{shuanglinSinglebeamDifferentialRelative2023,
  title = {Single-Beam Differential Relative Navigation of {{DRO}} Satellite Formation},
  author = {Shuanglin, L. I. and Jinghui, P. U. and Pengbin, Guo and Wenbin, Wang and Wei, Zhang},
  year = 2023,
  journal = {Journal of Deep Space Exploration},
  volume = {Vol.10},
  number = {No.2},
  pages = {211--219},
  abstract = {This paper proposes a single-beam differential relative navigation method to solve the relative navigation requirements of Distant Retrograde Orbit (DRO) satellite formation in cislunar space. The formation of two DRO satellites can be covered by a beam of measurement sent by a Low Earth Orbit (LEO) satellite, thus establishing two Satellite-to-Satellite Tracking (SST) links with the LEO satellite at the same time. Then differential measurement data can be obtained by these two SST links. This method can get relative states of the DRO satellite information by combining the differential measurement data and three-body orbital dynamics model. DRO is in the space with high asymmetry of the Earth-Moon three-body gravitational field, according to the LiAISON principle, a SST link established between the satellite running on this orbit and an LEO satellite can realize autonomous navigation, thus determining the absolute orbit states of one of the DRO formation satellites and the LEO satellite. The single-beam differential relative navigation method uses the absolute states of two satellites as constraints, and the advantage of using differential measurement data to eliminate common errors can obtain high-precision relative states of DRO satellite formation. In the simulation test, the relative navigation performance of the single-beam differential relative navigation method of the short-distance DRO satellite formation (inter-satellite distance of 50 km) and the long-distance DRO satellite formation (the distance between the satellites is about tens of thousands of kilometers) is tested. And the results show that, when the inter-satellite ranging noise is 0.5 m, the relative navigation accuracy calculated by the method proposed in this paper is 5 m (1 {$\sigma$}), which is 4 times higher than the relative navigation accuracy calculated by differencing the absolute orbit.},
  langid = {english},
  keywords = {cislunar space,Distant Retrograde Orbit (DRO),LiAISON,relative navigation,Satellite-to-Satellite Tracking (SST)},
  annotation = {titleTranslation: 单波束差分相对导航在DRO卫星编队中的应用\\
abstractTranslation: 本文提出了一种单波束差分相对导航方法，以解决地月空间远距离逆行轨道（DRO）卫星编队的相对导航需求。两颗DRO卫星组成的编队可被低地球轨道（LEO）卫星发射的一个测量波束覆盖，从而同时与LEO卫星建立两条星间跟踪（SST）链路，进而通过这两条SST链路获取差分测量数据。该方法将差分测量数据与三体轨道动力学模型相结合，能够解算DRO卫星的相对状态信息。DRO位于地月三体引力场高度非对称的空间中，根据LiAISON原理，运行在该轨道上的卫星与LEO卫星之间建立的SST链路可实现自主导航，从而确定DRO编队中一颗卫星及LEO卫星的绝对轨道状态。单波束差分相对导航方法以两颗卫星的绝对状态为约束，并利用差分测量数据消除公共误差的优势，可获得DRO卫星编队的高精度相对状态。仿真测试中，对短距离DRO卫星编队（星间距50 km）和长距离DRO卫星编队（星间距约数万公里）的单波束差分相对导航方法的相对导航性能进行了验证。结果表明，当星间测距噪声为0.5 m时，本文方法计算的相对导航精度为5 m（1 {$\sigma$}），相比直接对绝对轨道作差得到的相对导航精度提升了4倍}
}

@inproceedings{shusterDevelopmentAnalysisNRHO2019,
  title = {Development and Analysis of {{NRHO}} Rendezvous Reference Trajectories Using Convex Optimization},

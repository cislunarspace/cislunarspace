@article{HouRuiHangTianQiJinJuChiXiaoTuiLiDiJinGuiJiYouHuaFangFa2025,
  title = {{航天器近距离小推力抵近轨迹优化方法}},
  author = {{侯锐} and {唐蕊} and {韩宏伟} and {黄攀峰}},
  year = 2025,
  journal = {宇航学报},
  volume = {46},
  number = {8},
  pages = {1555--1564},
  issn = {1000-1328},
  abstract = {近年来，随着在轨卫星数量的急剧增加，面向空间目标在轨服务的抵近操作成为航天器操控任务的重要阶段。同时，随着电推进技术的迅速发展，高效能小推力机动逐渐成为当前轨道机动的主要形式。针对空间目标近距离抵近交会/飞越任务需求，提出了基于凸优化的小推力抵近轨迹快速优化设计方法。首先，针对近距离小推力抵近过程中的非线性动力学，通过模型假设和参数近似来线性化。然后，针对推力矢量带来的二阶等式约束，给出了基于参数正则策略实现约束边界激活，从而实现了无损凸化。之后，为了增强小推力轨迹优化问题的收敛性，构建了基于终端约束松弛的罚函数项，提升了轨迹优化算法的鲁棒性。最后，分别给出了面向目标交会和飞越任务的抵近轨迹数值仿真结果，验证了该算法的有效性。此方法可以快速得到最优小推力抵近轨迹，能够应用于未来空间目标在轨服务中在线决策与制导开环设计。},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/4T7C5RHN/侯锐 等 - 2025 - 航天器近距离小推力抵近轨迹优化方法.pdf}
}

@article{houStableMotionsTriangular2015,
  title = {Stable Motions around Triangular Libration Points in the Real Earth--Moon System},
  author = {Hou, X. Y. and Xin, X. and Scheeres, D. J. and Wang, J.},
  year = 2015,
  month = dec,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {454},
  number = {4},
  pages = {4172--4181},
  issn = {0035-8711},
  doi = {10.1093/mnras/stv2216},
  urldate = {2026-02-25},
  abstract = {Stable motions around the triangular libration points (TLP) in the Earth--Moon system perturbed by Sun are described. Two special quasi-periodic orbits around each TLP (called dynamical substitutes in this paper) are given. They were previously described in the planar Sun--Earth--Moon system by Kamel and are numerically obtained in the spatial Sun--Earth--Moon system. Linearized motions around the dynamical substitute are described in a semi-analytical way. The size of the stable region around the substitute is described via a numerical approach, along with the resonance mechanisms that determine the boundary of the stable region. Possible temporary capture from the near Earth objects population is discussed. An observation algorithm to search permanent or temporarily captured objects in this region is given. Some potential applications of the TLPs of the Earth--Moon system in space missions are discussed.},
  langid = {english},
  annotation = {titleTranslation: 真实地月系统三角平动点附近的稳定运动\\
abstractTranslation: 描述了受太阳扰动的地月系统中三角平动点（TLP）附近的稳定运动。给出了每个TLP附近的两条特殊拟周期轨道（本文称为动力学替代轨道）。这些轨道此前由Kamel在平面日-地-月系统中描述，并在空间日-地-月系统中通过数值方法获得。以半解析方式描述了动力学替代轨道附近的线性化运动。通过数值方法描述了替代轨道附近稳定区域的大小，以及决定稳定区域边界的共振机制。讨论了近地天体群可能的临时捕获问题。给出了在该区域搜索永久或临时捕获天体的观测算法。最后探讨了地月系统TLP在空间任务中的一些潜在应用},
  file = {/home/ouyangjiahong/Zotero/storage/G3LR3QGM/Hou 等 - 2015 - Stable motions around triangular libration points in the real earth–moon system.pdf;/home/ouyangjiahong/Zotero/storage/I3ZFICVY/stv2216.html}
}


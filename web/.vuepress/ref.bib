@article{nieAnalyticalPropagationThirdbody2026,
  title = {Analytical Propagation for Third-Body Perturbed Orbits},
  author = {Nie, Tao and Li, Jinfeng and Zhang, Shijie and Ren, Jiadong and Xu, Rui},
  year = 2026,
  month = apr,
  journal = {Chinese Journal of Aeronautics},
  volume = {39},
  number = {4},
  pages = {103865},
  issn = {1000-9361},
  doi = {10.1016/j.cja.2025.103865},
  urldate = {2026-05-13},
  abstract = {With the increasing complexity of space missions, traditional Keplerian models no longer satisfy the precision requirements for spacecraft orbital calculations in modern deep space exploration and lunar transfer missions. Unlike J2 perturbations, third-body perturbations induce long-period oscillations in orbital eccentricity and inclination, resulting in significant nonlinear changes in long-term orbital evolution that present challenges for deriving analytical solutions. This paper proposes an analytical method for spacecraft orbit propagation under third-body perturbations, which divides the calculation into long-term and periodic components. The long-period terms are determined by solving the mean orbital dynamics using elliptical integrals, while the periodic terms are computed using von Zeipel theory. The proposed method enables the analytical computation of satellite orbital states at arbitrary epochs. This method accounts for the perturbing body's orbital eccentricity and inclination, making it applicable to all scenarios, including both circulating and librating orbit types. The effectiveness of the proposed method is verified through numerical simulations. This analytical propagation method provides robust support for orbital optimization and autonomous control in deep space exploration missions.},
  langid = {american},
  keywords = {Autonomous control,Elliptic integral,Orbit propagation,Third-body perturbation,Von Zeipel},
  annotation = {titleTranslation: 第三体摄动轨道的解析传播\\
abstractTranslation: 随着空间任务复杂度的不断提升，传统开普勒模型已无法满足现代深空探测及月球转移任务中航天器轨道计算对精度的要求。与J2摄动不同，第三方体摄动会引起轨道偏心率和倾角的长期期振荡，导致轨道长期演化呈现显著非线性变化，给解析解的推导带来挑战。本文提出一种考虑第三方体摄动的航天器轨道传播解析方法，将计算分为长期项和周期项两部分。长期项通过椭圆积分求解平均轨道动力学获得，周期项则基于von Zeipel理论计算。该方法能够解析计算任意时刻的卫星轨道状态，并考虑了摄动体的轨道偏心率和倾角，适用于包括循环型和天平动型在内的所有轨道类型。数值仿真验证了所提方法的有效性。该解析传播方法为深空探测任务中的轨道优化与自主控制提供了有力支撑。},
  file = {/home/ouyangjiahong/Zotero/storage/G4PLVI5J/Nie 等 - 2026 - Analytical propagation for third-body perturbed orbits.pdf;/home/ouyangjiahong/Zotero/storage/H4KSRIEJ/S1000936125004716.html}
}


@article{kikuchiCislunarTransferTrajectory2025,
  title = {Cislunar Transfer Trajectory for Reusable {{OTV}} via {{NRHO}} between Propellant Infrastructure and Gateway},
  author = {Kikuchi, Junji and Ueda, Satoshi},
  year = 2025,
  journal = {Acta Astronautica},
  volume = {Vol.236},
  pages = {332--342},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2025.06.038},
  abstract = {Recently, cargo transport missions to the Moon using an Orbital Transfer Vehicle (OTV) have been proposed. A reusable OTV for refueling is essential to facilitate transportation in cislunar space. One study proposed a Propellant Infrastructure (PI) to be placed in a Low Earth Orbit (LEO), but this requires a large {$\Delta$}V for the OTV to transfer between LEO and the Moon. The transporting cargo in cislunar space is inefficient due to the large system requirements for the OTV. This study investigated a Propellant Infrastructure (PI) in a long elliptical orbit around the Earth. The Near-Rectilinear Halo Orbit (NRHO) is a candidate orbit of Gateway and was set as the destination in this analysis. The design of a cislunar trajectory uses the Perilune Rendezvous Method (PRM), which transfers to NRHO with high {$\Delta$}V efficiency by utilizing perturbation by the Earth. The PRM can also flexibly control time of flight and rendezvous with the PI, where it coincides with the orbital plane. This paper presents a cislunar trajectory between an elliptical Earth orbit and NRHO. This method will facilitate cislunar space development by the reusable OTV system requiring only a small {$\Delta$}V.},
  langid = {english},
  keywords = {Cislunar,Gateway,NRHO,OTV,Perilune rendezvous method},
  annotation = {titleTranslation: 可重复使用轨道转移飞行器经由近直线晕轨道在地球轨道推进剂基础设施与月球门户间的地月转移轨迹\\
abstractTranslation: 近期，有研究提出了利用轨道转移飞行器（OTV）向月球运送货物任务。可重复加注的轨道转移飞行器对于促进地月空间运输至关重要。一项研究提出在近地轨道（LEO）部署推进剂基础设施（PI），但这需要OTV在LEO与月球之间转移时具备较大的速度增量（{$\Delta$}V）。由于OTV系统需求庞大，地月空间货物运输效率低下。本研究探讨了在地球周围长椭圆轨道上部署推进剂基础设施（PI）的方案。近直线晕轨道（NRHO）是Gateway的候选轨道，本分析将其设为目的地。地月转移轨迹采用近月点交会方法（PRM）设计，该方法通过利用地球摄动实现向NRHO的高{$\Delta$}V效率转移。PRM还能灵活控制飞行时间，并实现在轨道平面与推进剂基础设施交会。本文展示了一种介于地球椭圆轨道与NRHO之间的地月转移轨迹。该方法仅需较小的{$\Delta$}V即可通过可重复使用OTV系统推动地月空间开发},
  file = {/home/ouyangjiahong/Zotero/storage/S7HG9IRA/Kikuchi和Ueda - 2025 - Cislunar transfer trajectory for reusable OTV via NRHO between propellant infrastructure and gateway.pdf}
}

@article{kikuchiComparisonTransferTrajectory2024,
  title = {Comparison of Transfer Trajectory to {{NRHO}} and Operation Plan for Logistics Resupply Mission to Gateway},
  author = {Kikuchi, Junji and Nakamura, Ryo and Ueda, Satoshi},
  year = 2024,
  journal = {Acta Astronautica},
  volume = {Vol.223},
  number = {No.0},
  pages = {577--584},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2024.07.038},
  abstract = {NASA and other space agencies have been planning the construction of a space station in lunar orbit called the Gateway. They have also begun studies for its resupply missions using an HTV-X. There are several ways to transition to NRHO, a candidate orbit. In-Direct Transfer (IDT) has a short transition period of seven days, but the required {$\Delta$}V is inefficient at more than 400 m/s. The Weak Stability Boundary (WSB) transfer requires a small {$\Delta$}V, less than 100 m/s, but the transition period is more than 100 days. This paper proposes the Perilune Rendezvous Method (PRM), recently discovered in 2022. Its transition period is two weeks longer than IDT, but the period is much shorter than WSB. The required {$\Delta$}V is 40 m/s lower than IDT but still larger than WSB. The PRM has an intermediate {$\Delta$}V and a transition period between IDT and WSB. Since fuel consumption and transition duration requirements depend on the mission, the PRM expands the scope of future cargo transportation. To adopt the PRM in a mission, an efficient trajectory correction plan was found based on a Monte Carlo analysis that considered navigation and control errors. It confirmed that the PRM could rendezvous with Gateway with higher accuracy than IDT.},
  langid = {english},
  keywords = {Gateway,HTV-X,NRHO,Perilune rendezvous method,WSB},
  annotation = {titleTranslation: NRHO转移轨道对比及门户空间站后勤补给任务运行方案\\
abstractTranslation: NASA及其他航天机构一直在规划在月球轨道上建造一个名为Gateway的空间站，并已着手研究利用HTV-X进行补给任务。有多种方式可转移至候选轨道NRHO。直接转移（IDT）转移周期短，仅需七天，但所需{$\Delta$}V超过400 m/s，效率较低。弱稳定边界（WSB）转移所需{$\Delta$}V很小，不到100 m/s，但转移周期超过100天。本文提出了2022年最新发现的近月点交会方法（PRM）。其转移周期比IDT长两周，但远短于WSB；所需{$\Delta$}V比IDT低40 m/s，但仍大于WSB。PRM的{$\Delta$}V与转移周期介于IDT与WSB之间。由于燃料消耗与转移时长要求取决于任务，PRM拓展了未来货物运输的适用范围。为在任务中采用PRM，基于考虑导航与控制误差的蒙特卡洛分析，找到了高效的轨迹修正方案。该方案确认PRM能以高于IDT的精度与Gateway实现交会。},
  file = {/home/ouyangjiahong/Zotero/storage/3XDEJYGS/Kikuchi 等 - 2024 - Comparison of transfer trajectory to NRHO and operation plan for logistics resupply mission to gatew.pdf}
}

@inproceedings{kikuchiExtendedPeriluneRendezvous2023,
  title = {Extended Perilune Rendezvous Method for Low Delta-{{V}} Transition to {{NRHO}}},
  booktitle = {74th {{International Astronautical Congress}}, {{IAC}} 2023},
  author = {Kikuchi, Junji and Nakamura, Ryo and Ueda, Satoshi},
  year = 2023,
  address = {Baku, Azerbaijan},
  abstract = {The construction of Gateway in lunar orbit is planned as a post-ISS mission by NASA, and JAXA is considering a cargo supply mission to provide service. The Near-Rectilinear Halo Orbit (NRHO) is a candidate for a Gateway orbit, and several methods for the transfer trajectory are being researched. The In-Direct Transfer (IDT) has a short transition period of seven days, but the {$\Delta$}V application is inefficient. The Weak Stability Boundary (WSB) transfer maintains a small {$\Delta$}V, but the transition takes over 100 days. However, a trajectory intermediate between IDT and WSB has not been actively studied yet. This paper proposes the Extended Perilune Rendezvous Method (EPRM) of intermediate transfer to NRHO. This method reduces {$\Delta$}V by orbiting in an elliptical lunar orbit for over two weeks. EPRM has several transition methods corresponding to {$\Delta$}V and transition periods. This paper systematically reveals the transition mechanisms. Moreover, an effective TCM considering several error types is presented for an actual mission. Finally, the rendezvous accuracy with Gateway is discussed.},
  langid = {english},
  keywords = {Gateway,HTV-X,NRHO,Orion,Perilune Rendezvous Method,WSB},
  annotation = {titleTranslation: 近地点扩展交会方法：实现进入近直线晕轨道的低能量转移}
}


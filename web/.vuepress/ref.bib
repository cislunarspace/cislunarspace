@inproceedings{villacMappingLongtermStability2005,
  title = {Mapping Long-Term Stability Regions Using the Fast Lyapunov Indicator},
  booktitle = {Spaceflight {{Mechanics}} 2005 Pt.2},
  author = {Villac, Benjamin F. and Aiello, John J. and Aas, American Astronautical Society},
  year = 2005,
  series = {Spaceflight {{Mechanics}} 2005 Pt.2},
  address = {Copper Mountain,CO},
  abstract = {The determination and characterization of long-term stability regions around periodic orbits (i.e. small, bounded variations in the action elements of a spacecraft for several hundred to a thousand years) is addressed using a modern numerical tool for the detection of chaotic motion: the Fast Lyapunov Indicator (FLI). Long-term stability regions are important for spacecraft applications as they can be used as disposal regions for end of mission requirements. The method is applied to the case of distant retrograde orbits around the Jupiter's moon Europa. It is shown that the extent of the stability region decreases with the stability index of the periodic orbit family, reducing to an empty set in a neighborhood of the colinear libration point regions.},
  langid = {english},
  annotation = {titleTranslation: 基于快速李雅普诺夫指标的长周期稳定区域映射}
}

@article{villegas-pintoResonantQuasiperiodicNearrectilinear2023a,
  title = {Resonant Quasi-Periodic near-Rectilinear Halo Orbits in the Elliptic-Circular Earth-Moon-Sun Problem},
  author = {{Villegas-Pinto}, Daniel and Baresi, Nicola and Locoche, Slim and Hestroffer, Daniel},
  year = 2023,
  month = jan,
  journal = {Advances in Space Research},
  volume = {71},
  number = {1},
  pages = {336--354},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2022.08.011},
  urldate = {2026-02-25},
  abstract = {Motivated by the near-future re-exploration of the cislunar space, this paper investigates dynamical substitutes of the Earth-Moon's resonant Near-Rectilinear Halo Orbits (NRHOs) under the Elliptic-Circular Restricted Four-Body Problem formulation of the Earth-Moon-Sun system. This model considers that the Earth and Moon move in elliptical orbits about each other and that a third body, the Sun, moves in a circular orbit about the Earth-Moon barycenter. By making use of this higher-fidelity dynamical model, we are able to incorporate the Sun's influence and the Moon's eccentricity, two of the most significant perturbations of the cislunar environment. As a result of these perturbations, resonant periodic NRHOs of the Earth-Moon Circular Restricted Three-Body Problem (CR3BP) are hereby replaced by two-dimensional quasi-periodic tori that better represent the dynamical evolution of satellites near the vicinity of the Moon. We present the steps and algorithms needed to compute these dynamical structures in the Elliptic-Circular model and subsequently assess their utility for spacecraft missions. We focus on the planned orbit for the NASA-led Lunar Gateway mission, a 9:2 synodic resonant L2 southern NRHO, as well as on the 4:1 synodic and 4:1 sidereal resonances, due to the proximity to the nominal orbit and their advantageous dynamical properties. We verify that the dynamical equivalents of these orbits preserve key dynamical attributes such as eclipse avoidance and near-linear stability. Furthermore, we find that the higher dimensionality of quasi-periodic solutions offers interesting alternatives to mission designers in terms of phasing maneuvers and low-altitude scientific observations.},
  langid = {english},
  keywords = {Dynamical systems theory,Lunar Gateway,Near-rectilinear Halo orbit,Quasi-periodic tori,Restricted four-body problem,Synodic and sidereal resonant orbits},
  annotation = {titleTranslation: 椭圆-圆形地月日问题中的共振准周期近直线晕轨道\\
abstractTranslation: 受近期地月空间再次探索的驱动，本文研究了在地月日系统的椭圆-圆型限制性四体问题框架下，地球-月球共振近直线晕轨道（NRHOs）的动力学替代解。该模型假设地球与月球绕彼此沿椭圆轨道运动，而第三个天体------太阳则绕地月质心沿圆形轨道运行。借助这一高保真动力学模型，我们能够纳入太阳引力和月球偏心率这两个地月空间最显著的摄动因素。在这些摄动作用下，地球-月球圆型限制性三体问题（CR3BP）中的共振周期NRHOs被二维准周期环面所取代，从而更真实地反映卫星在月球附近的动力学演化。我们给出了在椭圆-圆型模型中计算这些动力学结构的步骤与算法，并评估了它们对航天器任务的实用性。本文重点分析了NASA主导的``月球门户''任务所规划的轨道------一条9:2会合共振的L2南极NRHO，以及4:1会合共振和4:1恒星共振，因为这两者接近标称轨道且具有有利的动力学特性。我们验证了这些轨道的动力学等效物保留了关键动力学属性，如规避地影和近线性稳定性。此外，我们发现准周期解的高维性为任务设计者在相位调整机动和低高度科学观测方面提供了有趣的替代方案},
  file = {/home/ouyangjiahong/Zotero/storage/S2Y36SWJ/Villegas-Pinto 等 - 2023 - Resonant quasi-periodic near-rectilinear halo orbits in the elliptic-circular earth-moon-sun problem.pdf;/home/ouyangjiahong/Zotero/storage/FVIJQACJ/S0273117722007293.html}
}

@inproceedings{villegas-pintoTransfersResonantQuasiperiodic2022,
  title = {Transfers to Resonant Quasi-Periodic near-Rectilinear Halo Orbits in the {{Earth-moon-sun}} Elliptic-Circular Problem},
  booktitle = {73rd {{International Astronautical Congress}}, {{IAC}} 2022},
  author = {{Villegas-Pinto}, Daniel and Locoche, Slim and Baresi, Nicola and Hestroffer, Daniel},
  year = 2022,
  address = {Paris},
  abstract = {In the context of the future Lunar Gateway mission and the envisioned cargo missions set to resupply the station, this paper investigates transfers arising from natural connections between Earth vicinity and lunar quasi-periodic trajectories that are resonant with either the synodic (29.5 days) or the sidereal (27 days) periods. In this work, we extend previous studies by including, in addition to the gravitational influence of the Earth, Moon, and Sun, another major perturbation of the cislunar environment, the Moon's eccentricity. To do so, we make use of the Elliptic-Circular Restricted Four-Body Problem (ECR4BP) dynamical model and apply it to the Earth-Moon-Sun system. This model, which can be seen as a generalization of the Bicircular model, considers that the Earth and Moon orbit each other in elliptical orbits, and that the Sun remains in a circular co-planar orbit about the Earth-Moon barycenter. In the Elliptic-Circular model, the Lunar Gateway's planned orbit ? a synodic resonant Near-Rectilinear Halo Orbit (NRHO) ? is replaced by a two-dimensional synodic resonant quasi-periodic torus. We present the quasi-periodic tori associated with the Gateway's planned synodic resonant orbit and two additional resonances, one synodic and one sidereal resonant quasi-periodic NRHO, due to their proximity and similarity to the baseline trajectory. We then compute their stable and unstable invariant manifolds, finding natural transfer trajectories between the Earth vicinity and these quasi-periodic resonant NRHOs in the Elliptic-Circular system. These trajectories are first analyzed in the Elliptic-Circular model and finally translated to an ephemeris model. In the ephemeris model, the trajectories are used as initial guesses for an optimization routine that produces the final transfer trajectories.},
  langid = {english},
  annotation = {titleTranslation: 在地-月-日椭圆-圆形问题中向共振准周期近直线晕轨道的转移}
}


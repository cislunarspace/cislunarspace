@article{alvaradoExploringDesignSpace2025,
  title = {Exploring the Design Space of Low-Thrust Transfers with Ballistic Terminal Coast Segments in Cis-Lunar Space},
  author = {Alvarado, Kevin I. and Singh, Sandeep K.},
  year = 2025,
  month = mar,
  journal = {Aerospace},
  volume = {12},
  number = {3},
  pages = {217--241},
  issn = {2226-4310},
  doi = {10.3390/aerospace12030217},
  urldate = {2025-11-25},
  abstract = {Spacecraft catering to the Lunar Gateway or other ``permanent'' stations in the lunar vicinity would require frequent travel between periodic orbits around the Earth--Moon L1 and L2 Lagrange points. The transition through the Hill sphere is often characterized by close passages of our nearest neighbor---rendering the optimization problem numerically challenging due to the increased local sensitivities. Depending on the mission requirements and resource constraints, transfer architectures must be studied, and trade-offs between flight time and fuel consumption quantified. While direct low-thrust transfers between the circular restricted three-body problem periodic orbit families have been studied, the asymptotic flow in the neighborhood of the periodic orbits could be leveraged for expansion and densification of the solution space. This paper presents an approach to achieve a dense mapping of manifold-assisted, low-thrust transfers based on initial and terminal coast segments. Continuation schemes are utilized to attain the powered intermediate time-optimal segment through a multi-shooting approach. Interesting insights regarding the linear correlation between ∆V and change in reduced two-body osculating elements associated with the initial-terminal conditions are discussed. These insights could inform the subsequent filtering of the osculating selenocentric periapsis map and provide additional interesting and efficient solutions. The described approach is anticipated to be extremely useful for future crewed and robotic cis-lunar operations.},
  langid = {english},
  annotation = {titleTranslation: 探索地月空间中带有弹道末端滑行段的低推力转移轨道设计空间\\
abstractTranslation: 服务于月球门户或月球附近其他``永久性''空间站的航天器，需频繁往返于地月系统L1和L2拉格朗日点附近的周期轨道之间。穿越希尔球的过程通常伴随着接近我们最近邻居的近距离飞越------由于局部敏感性增加，这使得优化问题在数值上极具挑战性。根据任务需求和资源限制，必须研究转移架构，并对飞行时间和燃料消耗进行权衡分析。尽管圆型限制性三体问题中周期轨道族之间的直接低推力转移已有研究，但周期轨道邻域内的渐近流可用于扩展和加密解空间。本文提出了一种基于初始和末端滑行段实现流形辅助低推力转移密集映射的方法。利用延拓方案，通过多重打靶法获得动力中间时间最优段。讨论了与初末条件相关的∆V与简化二体密切轨道要素变化之间的线性相关性，这些洞察可为后续筛选月球中心密切近地点映射图提供参考，并产生其他有趣且高效的解。所述方法预计将对未来载人及无人地月空间操作极具价值。},
  file = {/home/ouyangjiahong/Zotero/storage/AWTLC5MQ/Alvarado和Singh - 2025 - Exploring the design space of low-thrust transfers with ballistic terminal coast segments in cis-lun.pdf}
}


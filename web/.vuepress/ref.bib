@article{bijjahalliAdvancesIntelligentAutonomous2020,
  title = {Advances in Intelligent and Autonomous Navigation Systems for Small {{UAS}}},
  author = {Bijjahalli, Suraj and Sabatini, Roberto and Gardi, Alessandro},
  year = 2020,
  month = may,
  journal = {Progress in Aerospace Sciences},
  volume = {115},
  pages = {100617},
  issn = {03760421},
  doi = {10.1016/j.paerosci.2020.100617},
  urldate = {2025-11-27},
  abstract = {A significant growth in Unmanned Aircraft System (UAS) operations has been observed over the past decade, largely driven by the emergence of new commercial opportunities and use-cases. This has posed new technological and regulatory challenges in order to address the complex safety, efficiency and sustainability requirements associated with UAS operations in an increasingly congested airspace. The growing need for trusted autonomy in UAS operations imposes demanding performance requirements on Navigation and Guidance Systems (NGS), both in terms of accuracy, integrity, continuity and availability. In most current NGS implementations, system autonomy is tightly constrained within a specified set of operational and environmental conditions through a large number of explicit rules. Recent breakthroughs in Artificial Intelligence (AI)-based methods and the emergence of highly-parallelized processor boards with low form-factor has led to the opportunity to employ Machine Learning (ML) techniques to enhance navigation system performance, particularly for small UAS (sUAS), which account for the majority of current and future unmanned aircraft use-cases. sUAS navigation systems typically employ diverse low Size, Weight, Power and Cost (SWaP-C) sensors such as Global Navigation Satellite System (GNSS) receivers, MEMS-IMUs, magnetometers, cameras and Lidars for localization, obstacle detection and avoidance. This paper presents a comprehensive review of conventional sUAS navigation systems, including aspects such as system architecture, sensing modalities and data-fusion algorithms. Additionally, performance monitoring and augmentation strategies are critically reviewed and assessed against current and future UAS Traffic Management (UTM) requirements. The primary focus is on the identification of key gaps in the literature where the use of AI-based methods can potentially enhance navigation performance. A critical review of AI-based methods and their application to sUAS navigation is conducted, along with an assessment of the performance benefits they provide over conventional navigation systems. Reviewed methods include but are not restricted to Artificial Neural Networks (ANN) such as Convolutional and Recurrent Neural Networks (CNN and RNN), Support Vector Machines (SVM) and ensemble techniques. The key challenges associated with adapting these methods to address sUAS operational objectives are clearly identified. The review also covers the assurance of predictable, deterministic system behaviour which is a key requirement to support system certification. The review and analysis will inform the reader of the applicability of various AI/ML methods to sUAS navigation and autonomous system integrity monitoring, and its likely role in the ongoing UTM evolution.},
  langid = {english},
  annotation = {titleTranslation: 小型无人机智能自主导航系统的进展\\
abstractTranslation: 过去十年间，无人航空系统（UAS）的运营量显著增长，主要得益于新兴商业机遇和应用场景的涌现。这带来了新的技术和监管挑战，以应对在日益拥挤的空域中UAS运营所涉及的复杂安全、效率和可持续性要求。对UAS运营中可信自主性的日益增长的需求，对导航与制导系统（NGS）在精度、完整性、连续性和可用性方面提出了严苛的性能要求。在大多数现行NGS实现中，系统自主性通过大量显式规则被严格限制在特定运行与环境条件范围内。近年来，基于人工智能（AI）方法的突破以及低外形因子高度并行处理器板的出现，为利用机器学习（ML）技术提升导航系统性能创造了机遇，尤其适用于小型UAS（sUAS）------这类系统占据当前及未来无人航空器应用场景的绝大多数。sUAS导航系统通常采用多种低尺寸、重量、功耗与成本（SWaP-C）传感器，例如全球导航卫星系统（GNSS）接收机、微机电惯性测量单元（MEMS-IMU）、磁力计、相机和激光雷达（Lidar），用于定位、障碍物检测与规避。本文对传统sUAS导航系统进行了全面综述，涵盖系统架构、传感模式及数据融合算法等方面。此外，对性能监测与增强策略进行了批判性评述，并对照当前及未来UAS交通管理（UTM）要求进行了评估。重点在于识别文献中的关键空白，即AI方法可潜在提升导航性能的领域。本文对基于AI的方法及其在sUAS导航中的应用进行了批判性评述，并评估了其相对于传统导航系统所带来的性能优势。评述的方法包括但不限于人工神经网络（ANN）------如卷积神经网络（CNN）和循环神经网络（RNN）------支持向量机（SVM）及集成技术。文中明确指出了将这些方法应用于实现sUAS运营目标所面临的关键挑战。本综述还涉及可预测、确定性系统行为的保障问题，这是支持系统认证的关键要求。本综述与分析将向读者阐明各种AI/ML方法在sUAS导航及自主系统完整性监测中的适用性，及其在UTM持续演进中可能发挥的作用。},
  file = {/home/ouyangjiahong/Zotero/storage/5E4KXSCK/Bijjahalli 等 - 2020 - Advances in intelligent and autonomous navigation systems for small UAS.pdf}
}

@article{biktimirovSatelliteFormationFlying2022,
  title = {Satellite Formation Flying for Space Advertising: From Technically Feasible to Economically Viable},
  shorttitle = {Satellite Formation Flying for Space Advertising},
  author = {Biktimirov, Shamil and Belyj, Gleb and Pritykin, Dmitry},
  year = 2022,
  month = aug,
  journal = {Aerospace},
  volume = {9},
  number = {8},
  pages = {419--446},
  issn = {2226-4310},
  doi = {10.3390/aerospace9080419},
  urldate = {2025-11-27},
  abstract = {The paper presents a feasibility study of satellite formation-flying missions for space advertising. To estimate a space advertising mission viability, the global population coverage model is designed and the demonstration schedule with a focus on larger cities is optimized for the formation of small satellites deployed in repeat ground track Sun-synchronous orbits. Monetization of an image demonstration over a city depends on the city population, outdoor advertising cost, and parameters limiting the number of potential advertising observations. Formation lifetime expressed in terms of fuel consumption for image reconfigurations and maintenance is one of the key factors and is analyzed via numerical simulation of satellite formation-flying dynamics and control.},
  langid = {english},
  annotation = {titleTranslation: 用于太空广告的卫星编队飞行：从技术可行到经济可行\\
abstractTranslation: 本文对用于太空广告的卫星编队飞行任务进行了可行性研究。为评估太空广告任务的可行性，设计了全球人口覆盖模型，并针对部署在重复地面轨迹太阳同步轨道上的小型卫星编队，优化了以大城市为重点的演示计划。图像演示在城市中的商业化收益取决于城市人口、户外广告成本以及限制潜在广告观测次数的参数。编队寿命（以图像重构与维持的燃料消耗表示）是关键因素之一，并通过卫星编队飞行动力学与控制的数值仿真进行了分析},
  file = {/home/ouyangjiahong/Zotero/storage/KB8VJFDC/Biktimirov 等 - 2022 - Satellite formation flying for space advertising from technically feasible to economically viable.pdf}
}

@article{biondiAttitudeRecoveryFeature2017,
  title = {Attitude Recovery from Feature Tracking for Estimating Angular Rate of Non-Cooperative Spacecraft},
  author = {Biondi, G. and Mauro, S. and Mohtar, T. and Pastorelli, S. and Sorli, M.},
  year = 2017,
  month = jan,
  journal = {Mechanical Systems and Signal Processing},
  volume = {83},
  pages = {321--336},
  issn = {08883270},
  doi = {10.1016/j.ymssp.2016.06.017},
  urldate = {2025-11-27},
  abstract = {This paper presents a fault-tolerant method for estimating the angular rate of uncontrolled bodies in space, such as failed spacecrafts. The bodies are assumed to be free of any sensors; however, a planned mission is assumed to track several features of the object by means of stereo-vision sensors. Tracking bodies in the space environment using these sensors is not, in general, an easy task: obtainable information regarding the attitude of the body is often corrupted or partial. The developed method exploits this partial information to completely recover the attitude of the body using a basis pursuit approach. An unscented Kalman filter can then be used to estimate the angular rate of the body.},
  langid = {english},
  annotation = {titleTranslation: 基于特征追踪的非合作航天器角速率估计姿态恢复方法\\
abstractTranslation: 本文提出了一种用于估算空间非受控物体（如失效航天器）角速度的容错方法。假设这些物体没有任何传感器，但计划中的任务通过立体视觉传感器追踪物体的多个特征。通常，利用这些传感器在空间环境中追踪物体并非易事：可获取的关于物体姿态的信息往往存在噪声或不完整。所提出的方法利用这些不完整信息，通过基追踪方法完全恢复物体的姿态。随后，可使用无迹卡尔曼滤波器来估算物体的角速度},
  file = {/home/ouyangjiahong/Zotero/storage/QL2RWRAB/Biondi 等 - 2017 - Attitude recovery from feature tracking for estimating angular rate of non-cooperative spacecraft.pdf}
}


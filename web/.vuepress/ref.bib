@article{bezroukLongTermEvolution2017,
  title = {Long Term Evolution of Distant Retrograde Orbits in the {{Earth-moon}} System},
  author = {Bezrouk, Collin and Parker, Jeffrey S.},
  year = 2017,
  month = sep,
  journal = {Astrophysics and Space Science},
  volume = {362},
  number = {9},
  pages = {176--187},
  issn = {0004-640X, 1572-946X},
  doi = {10.1007/s10509-017-3158-0},
  urldate = {2025-11-20},
  abstract = {This work studies the evolution of several Distant Retrograde Orbits (DROs) of varying size in the Earth-Moon system over durations up to tens of millennia. This analysis is relevant for missions requiring a completely hands off, long duration quarantine orbit, such as a Mars Sample Return mission or the Asteroid Redirect Mission. Four DROs are selected from four stable size regions and are propagated for up to 30,000 years with an integrator that uses extended precision arithmetic techniques and a high fidelity dynamical model. The evolution of the orbit's size, shape, orientation, period, out-of-plane amplitude, and Jacobi constant are tracked. It has been found that small DROs, with minor axis amplitudes of approximately 45,000 km or less decay in size and period largely due to the Moon's solid tides. Larger DROs (62,000 km and up) are more influenced by the gravity of bodies external to the Earth-Moon system, and remain bound to the Moon for significantly less time.},
  langid = {english},
  keywords = {Distant retrograde orbit,Dtability,Variable precision arithmetic},
  annotation = {titleTranslation: 地月系统中远距离逆行轨道的长期演化\\
abstractTranslation: 本研究探讨了地月系统中不同尺寸的若干远距离逆行轨道（DRO）在长达数万年的时间尺度上的演化过程。该分析对于需要完全无人值守、长期隔离轨道的任务（如火星样本返回任务或小行星重定向任务）具有重要意义。从四个稳定尺寸区域中选取了四条DRO，并采用扩展精度算术技术和高保真动力学模型的积分器，将其传播长达30,000年。跟踪了轨道尺寸、形状、方向、周期、面外振幅以及雅可比常数的演化情况。研究发现，短轴振幅约为45,000公里或更小的小型DRO，其尺寸和周期会因月球固体潮汐作用而显著衰减。而较大的DRO（62,000公里及以上）则更多地受到地月系统外部天体引力的影响，其束缚于月球的时间显著缩短。},
  file = {/home/ouyangjiahong/Zotero/storage/XAXY4DIU/Bezrouk和Parker - 2017 - Long term evolution of distant retrograde orbits in the Earth-moon system.pdf}
}

@article{bhadauriaCislunarKeyRegion2025,
  title = {Cislunar Key Region Surveillance Optimization},
  author = {Bhadauria, Surabhi and Frueh, Arly Black Carolin},
  year = 2025,
  journal = {Journal of Astronautical Sciences},
  volume = {Vol.72},
  number = {No.5},
  doi = {10.1007/s40295-025-00522-6},
  abstract = {Cislunar space's growing importance necessitates robust space domain awareness for its safe and sustainable utilization. Current ground-based surveillance is insufficient to cover the entire Cislunar region of interest, leaving large blind spots. Space-based optical sensors can address this, but due to the vastness of the Cislunar space, sensor placement is challenging. With limited resources, identifying and prioritizing regions of interest for space object custody is crucial. This paper proposes an optimized sensor distribution strategy for Cislunar Space Domain Awareness (CSDA), to maintain custody of objects of interest in the \textbackslash (L\_2\textbackslash ) Lyapunov and Near Rectilinear Halo Orbits (NRHO), able to perform maneuvers at unknown times. As examples, this work focuses on identifying the key regions spanned by these maneuvering objects in \textbackslash (L\_2\textbackslash ) Lyapunov and Near Rectilinear Halo Orbits, with maneuver sizes of 0.05 km/s \textbackslash (\textbackslash Delta v\textbackslash ) to 0.5 km/s \textbackslash (\textbackslash Delta v\textbackslash ). Using dynamical deviation flow in the Circular Restricted Three-Body Problem (CR3BP), critical surveillance regions are identified. The optimal sensor locations are determined by optimizing surveillance coverage for maintained custody using visibility maps.},
  langid = {english},
  keywords = {\(L_2\) Bifurcating Orbit,Cislunar,NRHO,Space domain awareness,Surveillance},
  annotation = {titleTranslation: 地月关键区域监视优化\\
abstractTranslation: 地月空间的重要性日益凸显，需要强大的空间态势感知能力来确保其安全与可持续利用。当前基于地面的监视手段无法覆盖整个感兴趣的地月区域，存在大量盲区。天基光学传感器可弥补这一不足，但由于地月空间广袤无垠，传感器的部署面临挑战。在资源有限的情况下，识别并优先确定空间目标监护的感兴趣区域至关重要。本文提出了一种针对地月空间态势感知（CSDA）的优化传感器分布策略，用于维护 \textbackslash (L\_2\textbackslash ) Lyapunov轨道及近直线晕轨道（NRHO）中感兴趣目标的监护，这些目标能够在未知时刻执行机动。作为示例，本研究聚焦于识别这些机动目标在 \textbackslash (L\_2\textbackslash ) Lyapunov轨道与近直线晕轨道中覆盖的关键区域，机动量级为0.05 km/s \textbackslash (\textbackslash Delta v\textbackslash ) 至0.5 km/s \textbackslash (\textbackslash Delta v\textbackslash )。利用圆型限制性三体问题（CR3BP）中的动力学偏差流，识别出关键监视区域。通过可见性图优化监视覆盖范围，从而确定最优传感器位置，以维持对目标的持续监护},
  file = {/home/ouyangjiahong/Zotero/storage/FCBVVQ68/Bhadauria和Frueh - 2025 - Cislunar key region surveillance optimization.pdf}
}


  title = {空间绳系卫星系统动力学建模及仿真研究},
  author = {{李强}},
  year = 2007,
  abstract = {空间绳系系统是当代空间技术发展的一个新领域,具有广阔的应用前景。自二十世纪六、七十年代开始,对空间绳系系统相关问题的研究一直持续至今。本文以空间绳系机动和绳网抛撒问题为背景,采用珠式模型和Newton-Euler方法对空间绳系系统动力学及控制问题进行建模和仿真分析。首先简要回顾了空间绳系系统动力学问题的研究概况,并对绳系动力学模型进行了简要介绍。然后在轨道坐标系中建立空间系绳的珠式模型,采用Newton-Euler方法推导系绳的相对运动动力学方程,并与Lagrange能量法所建动力学方程进行比较。本文推导动力学方程所采用的Newton-Euler法,从珠式模型系绳的局部入手,分析单个珠点的受力而得出动力学方程;而Lagrange能量法从绳系系统的整体入手,分析系统的能量,采用Lagrange公式求导得出珠点的动力学方程。然后进一步对绳系系统释放、收拢以及稳定保持等运动过程建模,并考虑了应力控制、速率控制以及子星喷气推力控制等几种常见的控制方式。最后针对应力控制和速率控制方式,对珠式模型和不考虑系绳质量和形状特性的简化模型的动力学特性进行了仿真分析,并对结果进行了比较分析。从珠式模...},
  school = {国防科学技术大学},
  keywords = {;;;Newton-Euler;;;},
  file = {/home/ouyangjiahong/Zotero/storage/DC872SX3/李强 - 2007 - 空间绳系卫星系统动力学建模及仿真研究.pdf}
}


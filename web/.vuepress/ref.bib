@article{ZhangZhiQiJianZaiHeYiTiHuaSheJiFangFa2026,
  title = {{器箭载荷一体化设计方法}},
  author = {{张智} and {王檑} and {刘晖} and {胡晓军} and {王紫扬}},
  year = 2026,
  month = mar,
  journal = {中国空间科学技术},
  volume = {46},

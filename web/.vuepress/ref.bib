@article{ShiZhengJiYuLuanShengTuJuanJiShenJingWangLuoDeXiaoYangBenQianYiXueXiShiNeiZhiWenDingWei2025,
  title = {{基于孪生图卷积神经网络的小样本迁移学习室内指纹定位}},
  author = {{施政} and {顾浩} and {黄浩} and {王禹} and {夏文超} and {赵海涛} and {朱洪波}},

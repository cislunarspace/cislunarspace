@article{jiaNearearthAsteroidsOrbit2024,
  title = {Near-Earth Asteroids Orbit Determination by {{DRO}} Space-Based Optical Observations},
  author = {Jia, Liu and {Ye-zhi}, Song and {Cheng-li}, Huang and {Xiao-gong}, H. U. and {Long-yu}, Tan},
  year = 2024,
  journal = {Chinese Astronomy and Astrophysics},
  volume = {Vol.48},
  number = {No.2},
  pages = {292--315},
  doi = {10.1016/j.chinastron.2024.05.010},
  abstract = {In response to the problem that ground-based optical monitoring systems cannot monitor near-Earth asteroids which are in the direction too close to the Sun on the celestial sphere, we raise a method that tracks and determines the orbit of asteroids by Distant Retrograde Orbit (DRO) platforms with optical monitoring. Through data filtering by visibility analysis and the initial orbit information of the asteroids provided by Jet Propulsion Laboratory (JPL), the asteroids' orbits are determined and compared with the reference orbit. Simulation results show that with a measurement accuracy of two arcseconds and an arc length of three years, the orbit determination accuracy of the DRO platform for near-Earth asteroids selected in the simulation example can reach tens of kilometers, especially the asteroids with Atira orbits to an accuracy of fewer than ten kilometers. In conclusion, the near-Earth asteroids monitoring systems based on DRO platforms are capable to provide sufficient monitoring effectiveness which enables precisely tracking of the target asteroids and forecast of their positions.},
  langid = {english},
  keywords = {asteroids: near-Earth asteroids,celestial mechanics: orbit determination,methods: space-based optical monitoring,minor planets,numerical,spacecraft: distant retrograde orbit (DRO)satellite},
  annotation = {titleTranslation: 基于DRO天基光学观测的近地小行星轨道确定\\
abstractTranslation: 针对地基光学监测系统无法监测天球上距太阳方向过近的近地小行星这一问题，我们提出一种利用远距离逆行轨道（DRO）平台进行光学监测来跟踪并确定小行星轨道的方法。通过可见性分析进行数据筛选，并结合喷气推进实验室（JPL）提供的小行星初始轨道信息，确定小行星轨道并与参考轨道进行对比。仿真结果表明，在测量精度为两角秒、弧长为三年的条件下，DRO平台对仿真示例中选取的近地小行星的定轨精度可达数十公里，尤其是对于Atira型小行星，精度可优于十公里。综上，基于DRO平台的近地小行星监测系统能够提供充分的监测效能，从而实现对目标小行星的精确跟踪及其位置预报。}
}


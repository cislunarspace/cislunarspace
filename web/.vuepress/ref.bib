@article{kakiCoplanarCirculartocircularOrbit2023,
  title = {Coplanar Circular-to-Circular Orbit Transfer Guidance with Constant-Thrust Acceleration},
  author = {Kaki, Siddarth and Akella, Maruthi R.},
  year = 2023,
  month = dec,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {6},

@article{allchornPolicingExtremismGamingadjacent2025,
  title = {Policing Extremism on Gaming-Adjacent Platforms: Awful but Lawful?},
  shorttitle = {Policing Extremism on Gaming-Adjacent Platforms},
  author = {Allchorn, William and Orofino, Elisa},
  year = 2025,

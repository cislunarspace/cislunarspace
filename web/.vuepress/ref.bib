@article{qinOrbitTrackingData2019,
  title = {Orbit and Tracking Data Evaluation of Chang'{{E-4}} Relay Satellite},
  author = {Qin, Songhe and Huang, Yong and Li, Peijia and Shan, Quan and Fan, Min and Hu, Xiaogong and Wang, Guangli},
  year = 2019,
  month = aug,
  journal = {Advances in Space Research},
  volume = {64},
  number = {4},
  pages = {836--846},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2019.05.028},
  urldate = {2026-03-02},
  abstract = {A lander and a rover were placed on the Moon in China's Chang'E-4 Lunar exploration mission, which is the first lander on the far side of the Moon. To provide communication and telemetry between the Earth and the lander, the CE-4 relay satellite (Queqiao) was launched firstly to the Earth-Moon L2 region in May 2018. The orbit precision of the Chang'E-4 relay satellite is evaluated in this paper. The ground tracking data including Ranging, Doppler, VLBI delay and rate are processed using a batch least squares method. The results show that the residual RMS of ranging, Doppler, VLBI delay and VLBI delay rate based on S-band are about 0.53\,m, 0.37\,mm/s, 1.16\,ns and 0.67\,ps/s, respectively. Compared with the previous missions (CE-1/CE-2/CE-5T1) using S-band tracking systems, the measurement precision of the CE-4 relay satellite is significantly improved. Furthermore, the analysis shows that VLBI data can improve the precision of orbit determination and prediction of the halo orbit around the Earth-Moon L2 point: the position precision is better than 100\,m and the velocity precision is better than 2\,mm/s. Since the CE-4 relay satellite is less than 300\,km away from the lunar surface when it flies by the Moon, the lunar non-spherical gravitation has a significant influence on the orbit determination, and the lunar gravity field need to be considered when the Earth is chosen as the central body.},
  langid = {english},
  keywords = {CE-4 relay satellite,L2 point of Earth-Moon system,Orbit determination},
  annotation = {论文摘要：在中国嫦娥四号月球探测任务中，着陆器与巡视器成功登陆月球背面，实现了人类首次月背软着陆。为建立地球与着陆器间的通信及遥测链路，嫦娥四号中继卫星（鹊桥）于2018年5月率先发射至地月L2点区域。本文对嫦娥四号中继卫星的轨道精度进行了评估。采用批处理最小二乘法对地面跟踪数据（包括测距、多普勒、VLBI时延与时延率）进行处理。结果表明：基于S波段的测距、多普勒、VLBI时延与VLBI时延率残差RMS分别约为0.53米、0.37毫米/秒、1.16纳秒和0.67皮秒/秒。与先前使用S波段跟踪系统的探测任务（嫦娥一号/二号/五号T1）相比，嫦娥四号中继卫星的测量精度显著提升。进一步分析表明，VLBI数据能有效提升地月L2点晕轨道定轨与预报精度：位置精度优于100米，速度精度优于2毫米/秒。由于嫦娥四号中继卫星飞掠月球时距月面不足300公里，月球非球形引力对定轨影响显著，在以地球为中心天体时需考虑月球重力场的影响。\\
titleTranslation: 嫦娥四号中继卫星轨道与跟踪数据评估\\
abstractTranslation: 中国嫦娥四号月球探测任务在月球上部署了一台着陆器和一辆巡视车，这是首个在月球背面着陆的探测器。为提供地球与着陆器之间的通信与遥测，CE-4中继卫星（鹊桥）于2018年5月率先发射至地月L2区域。本文评估了嫦娥四号中继卫星的轨道精度。利用批处理最小二乘法处理了包括测距、多普勒、VLBI时延及时延率在内的地面跟踪数据。结果表明，基于S波段测得的测距、多普勒、VLBI时延和VLBI时延率的残差均方根分别约为0.53米、0.37毫米/秒、1.16纳秒和0.67皮秒/秒。与以往采用S波段跟踪系统的任务（CE-1/CE-2/CE-5T1）相比，CE-4中继卫星的测量精度显著提升。此外，分析表明，VLBI数据可提高地月L2点晕轨道的定轨与预报精度：位置精度优于100米，速度精度优于2毫米/秒。由于CE-4中继卫星在飞越月球时距月面不足300公里，月球非球形引力对轨道确定有显著影响，当以地球为中心天体时，需考虑月球重力场},
  file = {/home/ouyangjiahong/Zotero/storage/M54Z83HZ/Qin 等 - 2019 - Orbit and tracking data evaluation of chang’E-4 relay satellite.pdf;/home/ouyangjiahong/Zotero/storage/SEND84UJ/S0273117719303552.html}

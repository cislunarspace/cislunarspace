@article{zimovan-spreenDynamicalStructuresNearby2022,
  title = {Dynamical Structures Nearby {{NRHOs}} with Applications to Transfer Design in Cislunar Space},
  author = {{Zimovan-Spreen}, Emily M. and Howell, Kathleen C. and Davis, Diane C.},
  year = 2022,

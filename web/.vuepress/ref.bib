@article{fereoliMetareinforcementLearningSpacecraft2025,
  title = {Meta-Reinforcement Learning for Spacecraft Proximity Operations Guidance and Control in Cislunar Space},
  author = {Fereoli, Giovanni and Schaub, Hanspeter and Di Lizia, Pierluigi},
  year = 2025,
  journal = {Journal of Spacecraft and Rockets},
  volume = {Vol.62},
  number = {No.3},
  pages = {706--718},
  doi = {10.2514/1.A36100},
  abstract = {Innovative lightweight and model-free guidance algorithms are essential to achieve full autonomy of spacecraft and address future space exploration challenges. In the near future, this type of technology will be essential for cislunar space proximity operations, such as NASA's Artemis program and its Lunar Gateway project. In this scenario, a meta-reinforcement learning algorithm is employed to address the real-time optimal guidance problem of a spacecraft in the cislunar environment. Non-Keplerian orbits pose complex dynamics, where classic control theory may be less adaptable and more computationally expensive compared to machine learning approaches. Meta-RL stands out for its ability to learn how to learn through experience, training on various tasks to enhance efficiency, and effectiveness in tackling new ones. By modeling a stochastic optimal control problem within the circular restricted three-body problem framework as a Markov decision process, an LSTM-based network agent is trained using proximal policy optimization, considering operational constraints and stochastic effects for safety and robustness evaluation. Additionally, an MLP-based agent and an optimal control pseudo-spectral solution are assessed for comparison. The resulting tool autonomously guides spacecraft in cislunar proximity operations, approximating the optimal control solution with a versatile algorithmic framework. This ensures both robustness and computational efficiency.},
  langid = {english},
  keywords = {Computation theory,Computational efficiency,Control theory,DYNAMICS,Interplanetary flight,Learning algorithms,Lunar missions,Machine learning,Markov processes,Optimal control systems,Orbits,Spacecraft,Stochastic control systems,Stochastic systems},
  annotation = {titleTranslation: 面向地月空间的航天器近距离操作制导与控制元强化学习\\
abstractTranslation: 创新的轻量级无模型制导算法对于实现航天器完全自主并应对未来太空探索挑战至关重要。在不久的将来，这类技术将对地月空间邻近操作（如NASA的Artemis计划及其Lunar Gateway项目）不可或缺。在此场景下，采用元强化学习算法来解决航天器在地月环境中的实时最优制导问题。非开普勒轨道具有复杂的动力学特性，相较于机器学习方法，经典控制理论可能适应性较差且计算成本更高。元强化学习因其通过经验学习如何学习、针对多种任务进行训练以提升效率并有效处理新任务的能力而脱颖而出。通过在圆形限制性三体问题框架内将随机最优控制问题建模为马尔可夫决策过程，使用近端策略优化训练基于LSTM的网络智能体，并考虑操作约束和随机效应以评估安全性和鲁棒性。此外，还评估了基于MLP的智能体和最优控制伪谱解法作为对比。所生成的工具可自主引导航天器进行地月空间邻近操作，通过灵活算法框架逼近最优控制解，从而确保鲁棒性和计算效率}
}

@article{fernandez-guastiAnalyticFourbodyLimacon2025,
  title = {Analytic Four-Body Lima\c con Choreography},
  author = {{Fernandez-Guasti}, Manuel},
  year = 2025,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},
  number = {1},
  pages = {4--16},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10235-x},
  urldate = {2025-10-01},
  abstract = {The trajectories and interaction forces of four bodies with equal masses are analytically described. The bodies follow a choreographic motion in a trisectrix limax periodic orbit without collisions. The curve is similar to a numerical curve of a folded figure of eight. The center of mass is fixed at the origin. The moment of inertia, the non-zero angular momentum as well as the kinetic and potential energies of the system are constant. The interaction forces are not Newtonian but linear attractive and repulsive forces along the lines joining the bodies. To the best of our knowledge, this is the first analytical solution to a four-body choreography in a curve other than the circle.},
  langid = {english},
  annotation = {titleTranslation: 解析型四体利马萨舞姿轨道\\
abstractTranslation: 对四个等质量物体的轨迹和相互作用力进行了解析描述。这些物体在一条无碰撞的trisectrix limax周期轨道上执行编舞式运动。该曲线类似于折叠八字形的数值曲线。质心固定在原点。系统的转动惯量、非零角动量以及动能和势能均为常数。相互作用力并非牛顿力，而是沿物体连线的线性引力和斥力。据我们所知，这是除圆曲线外，四体编舞问题在非圆形曲线上的首个解析解},
  file = {/home/ouyangjiahong/Zotero/storage/GCG72VYL/Fernandez-Guasti - 2025 - Analytic four-body limaçon choreography.pdf}
}

@article{ferrariPeriodicMotionLibration2018,
  title = {Periodic Motion around Libration Points in the Elliptic Restricted Three-Body Problem},
  author = {Ferrari, Fabio and Lavagna, Michele},
  year = 2018,
  journal = {Nonlinear Dynamics},
  volume = {93},
  number = {2},
  pages = {453--462},
  publisher = {Springer},
  doi = {10.1007/s11071-018-4203-4},
  abstract = {Periodicity of motion around the collinear libration point associated with the Elliptic Restricted Three-Body Problem is studied. A survey of periodic solutions in the Circular Restricted Three-Body Problem is presented considering both Sun--Earth and Earth--Moon systems. Halo, Lyapunov and Vertical families around L1, L2 and L3 points are investigated, and their orbital period ranges through the entire family are reported. Resonant motions within the orbit families in the circular problem are identified and selected as suitable initial guess to find periodic orbits in the elliptic problem, which are targeted using a differential correction algorithm. Periodic solutions found are cataloged depending on the number of revolutions around libration points. Geometry, dynamical behavior and stability properties of single-revolution orbits are shown, as well as double-, triple- and quadruple-revolution solutions.},
  langid = {english},
  annotation = {titleTranslation: 椭圆型限制性三体问题中平动点附近的周期运动\\
abstractTranslation: 针对椭圆限制性三体问题中共线平动点附近的运动周期性进行研究。本文综述了圆型限制性三体问题中的周期性解，涵盖日-地系统与地-月系统。分析了L1、L2和L3点附近的晕轨道、Lyapunov轨道及垂直轨道族，并报告了各轨道族在整个族系中的轨道周期区间。识别了圆型问题中轨道族内部的共振运动，并将其作为椭圆问题中寻找周期轨道的合适初值，利用微分修正算法进行目标跟踪。根据绕平动点的公转圈数对求得的周期解进行分类。展示了单圈轨道的几何特征、动力学行为及稳定性性质，以及双圈、三圈和四圈公转解。},
  file = {/home/ouyangjiahong/Zotero/storage/Z8WBL659/Ferrari和Lavagna - 2018 - Periodic motion around libration points in the elliptic restricted three-body problem.pdf}
}

@article{ferraz-melloTidalFrictionSatellites2020,
  title = {Tidal Friction in Satellites and Planets. {{The}} New Version of the Creep Tide Theory},
  author = {{Ferraz-Mello}, Sylvio and Beaug{\'e}, Cristian and Folonier, Hugo A. and Gomes, Gabriel O.},
  year = 2020,
  month = may,
  journal = {European Physical Journal Special Topics},
  volume = {229},
  number = {8},
  pages = {1441--1462},
  issn = {1951-6355, 1951-6401},
  doi = {10.1140/epjst/e2020-900184-5},
  urldate = {2025-11-27},
  abstract = {Paper on the creep tide theory and its applications to satellites and planets with emphasis on a new set of differential equations allowing easier numerical studies. The creep tide theory is a new paradigm that does not fix a priori the tidal deformation of the body, but considers the deformation as a low-Reynolds-number flow. The evolution under tidal forces is ruled by an approximate solution of the Navier--Stokes equation depending on the body's viscosity with no ad hoc assumptions on its shape and orientation. It reproduces closely the results of Darwinian theories in the case of gaseous planets and stars, but the results are completely different in the case of stiff satellites and planets. It explains the tidal dissipations of Enceladus and Mimas. The extension of the theory to nonhomogeneous icy satellites with a subsurface ocean allows the amplitude of the forced oscillations around synchronization (librations) to be better determined.},
  langid = {english},
  annotation = {titleTranslation: 卫星与行星中的潮汐摩擦。蠕变潮汐理论新解},
  file = {/home/ouyangjiahong/Zotero/storage/INHA2ADZ/Ferraz-Mello 等 - 2020 - Tidal friction in satellites and planets. The new version of the creep tide theory.pdf}
}


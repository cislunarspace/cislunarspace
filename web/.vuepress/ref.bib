@article{moravcikDeepStackExpertlevelArtificial2017,
  title = {{{DeepStack}}: Expert-Level Artificial Intelligence in Heads-up No-Limit Poker},
  shorttitle = {{{DeepStack}}},
  author = {Morav{\v c}{\'i}k, Matej and Schmid, Martin and Burch, Neil and Lis{\'y}, Viliam and Morrill, Dustin and Bard, Nolan and Davis, Trevor and Waugh, Kevin and Johanson, Michael and Bowling, Michael},
  year = 2017,
  month = may,
  journal = {Science},
  volume = {356},
  number = {6337},
  pages = {508--513},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.aam6960},
  urldate = {2026-04-23},
  abstract = {Computer code based on continual problem re-solving beats human professional poker players at a two-player variant of poker.           ,              Artificial intelligence masters poker                            Computers can beat humans at games as complex as chess or go. In these and similar games, both players have access to the same information, as displayed on the board. Although computers have the ultimate poker face, it has been tricky to teach them to be good at poker, where players cannot see their opponents' cards. Morav\v c\'ik               et al.               built a code dubbed DeepStack that managed to beat professional poker players at a two-player poker variant called heads-up no-limit Texas hold'em. Instead of devising its strategy beforehand, DeepStack recalculated it at each step, taking into account the current state of the game. The principles behind DeepStack may enable advances in solving real-world problems that involve information asymmetry.                                         Science               , this issue p.               508                        ,              Artificial intelligence has seen several breakthroughs in recent years, with games often serving as milestones. A common feature of these games is that players have perfect information. Poker, the quintessential game of imperfect information, is a long-standing challenge problem in artificial intelligence. We introduce DeepStack, an algorithm for imperfect-information settings. It combines recursive reasoning to handle information asymmetry, decomposition to focus computation on the relevant decision, and a form of intuition that is automatically learned from self-play using deep learning. In a study involving 44,000 hands of poker, DeepStack defeated, with statistical significance, professional poker players in heads-up no-limit Texas hold'em. The approach is theoretically sound and is shown to produce strategies that are more difficult to exploit than prior approaches.},
  copyright = {http://www.sciencemag.org/about/science-licenses-journal-article-reuse},
  langid = {english},
  annotation = {titleTranslation: DeepStack：在单挑无限注德州扑克中达到专家水平的人工智能\\
abstractTranslation: 基于持续问题重解的计算机代码在两人扑克变体中击败了人类职业扑克选手。  \\
人工智能征服扑克  \\
计算机可以在像国际象棋或围棋这样复杂的游戏中击败人类。在这些和类似的游戏中，双方玩家都能获取相同的信息，如棋盘所示。尽管计算机拥有终极``扑克脸''，但教会它们擅长扑克却颇为棘手，因为玩家无法看到对手的牌。Morav\v c\'ik等人构建了一款名为DeepStack的代码，成功在一种名为``一对一无限注德州扑克''的两人扑克变体中击败了职业选手。DeepStack并非事先制定策略，而是在每一步根据当前游戏状态重新计算策略。DeepStack背后的原理可能推动解决涉及信息不对称的现实世界问题。  \\
《科学》，本期第508页  \\
近年来，人工智能取得了多项突破，游戏常作为里程碑。这些游戏的一个共同特点是玩家拥有完美信息。而扑克作为典型的不完美信息游戏，长期以来一直是人工智能领域的挑战性难题。我们介绍了DeepStack，一种适用于不完美信息场景的算法。它结合了递归推理以处理信息不对称、分解计算以聚焦相关决策，以及一种通过深度学习从自我对弈中自动习得的直觉形式。在一项涉及44,000手扑克的研究中，DeepStack以统计学显著性击败了职业扑克选手于一对一无限注德州扑克。该方法在理论上严谨可靠，并且被证明能产生比先前方法更难被利用的策略。},
  file = {/home/ouyangjiahong/Zotero/storage/WRMK8KTL/Moravčík 等 - 2017 - DeepStack expert-level artificial intelligence in heads-up no-limit poker.pdf}
}


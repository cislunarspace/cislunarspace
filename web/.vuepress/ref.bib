@article{vichiExploringPotentialNeural2025,
  title = {Exploring the Potential of Neural Networks in Early Detection of Potentially Hazardous Near-Earth Objects},
  author = {Vichi, Vanessa and Tommei, Giacomo},
  year = 2025,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},
  number = {3},
  pages = {17--34},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-025-10248-0},
  urldate = {2025-10-01},
  abstract = {We propose a novel method to estimate the minimum orbit intersection distance (MOID) of a near-earth object (NEO) based on artificial neural networks (NNs). The MOID is defined as the minimum distance between the two osculating Keplerian orbits of the Earth and the NEO as curves in the three-dimensional space; it is usually used as an indicator of the possibility of a collision between the asteroid and the Earth, at least for the period during which the Keplerian orbit of the asteroid provides a reliable approximation of the actual orbit. In the present work, the MOID is estimated with a multilayer feedforward NN that takes as input the coordinates of the asteroid at a specified epoch. The NN has been trained on an artificial dataset of about 800000 NEOs, generated with NEOPOP, and tested on the population of real near-earth asteroids (NEAs). The network exhibits near-instantaneous predictions of the MOID and achieves a mean absolute error of approximately 10-3 AU on the test set. This research represents a step forward in addressing the urgent need for effective impact monitoring techniques, partially answering the question of whether machine learning can serve as a preliminary filter for some problems of orbit determination.},
  langid = {english},
  annotation = {titleTranslation: 探索神经网络在早期探测潜在威胁近地天体中的应用潜力\\
abstractTranslation: 我们提出了一种基于人工神经网络（NN）估算近地天体（NEO）最小轨道交点距离（MOID）的新方法。MOID定义为地球与NEO的瞬时开普勒轨道作为三维空间曲线之间的最小距离；该指标通常用于评估小行星与地球发生碰撞的可能性，至少在小行星的开普勒轨道能可靠近似其实际轨道的时段内有效。本研究采用多层前馈神经网络估算MOID，输入为指定历元时刻的小行星星历坐标。该网络基于NEOPOP生成的约80万颗近地天体人工数据集进行训练，并在真实近地小行星（NEA）群体上完成测试。网络可实现近乎瞬时的MOID预测，测试集上的平均绝对误差约为10{$^{-3}$}天文单位。这项研究在应对有效撞击监测技术的迫切需求方面迈出了重要一步，部分回答了机器学习能否作为轨道确定问题中初步筛选工具的问题},
  file = {/home/ouyangjiahong/Zotero/storage/6WUFABZX/Vichi和Tommei - 2025 - Exploring the potential of neural networks in early detection of potentially hazardous near-earth ob.pdf}
}


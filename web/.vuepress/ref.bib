@article{decosterBuildingFutureCislunar2026,
  title = {Building the Future of Cislunar Surveillance: {{In}} Space Assembly and Manufacturing-Enabled Sensor Architectures for Large-Volume Space Situational Awareness},
  shorttitle = {Building the Future of Cislunar Surveillance},
  author = {DeCoster, Mallory E. and Awadallah, Ra'id and Goel, Aniket and Blodgett, David and Papadakis, Stergios and New, Alexander and Trexler, Morgana},
  year = 2026,
  month = jan,
  journal = {New Space},
  pages = {21680256251390412},
  issn = {2168-0256, 2168-0264},
  doi = {10.1177/21680256251390412},
  urldate = {2026-04-23},
  abstract = {Recent decades have seen increased interest in Cislunar operations. To ensure the safety of flight and peace of operations in the Cislunar domain, a capability to provide current and predictive knowledge of resident space objects in the domain is required, which, in turn, necessitates a dedicated space situational awareness (SSA) system. However, SSA in the Cislunar domain is notoriously difficult to achieve due to the inherently large volume and the chaotic nature of orbits in the regime. These characteristics produce challenges in establishing persistent monitoring and limit predictive capabilities. To address these challenges, this study detailed a trade space for achieving effective Cislunar SSA (CSSA) by leveraging improved capabilities offered through very large (5--10\texttimes{} the size of currently available space-based apertures) radio frequency and optical sensors. The approach presupposes a paradigm shift in space operations that enables on-orbit manufacturing of large, precise structures. We show that access to very large apertures enables timely, persistent, and accurate CSSA through higher signal-to-noise ratios, resolutions, and detection ranges in the operational environment that could not otherwise be achieved by leveraging a proliferated network of many smaller, conventionally sized sensors.},
  langid = {english},
  keywords = {Cislunar,in-space assembly and manufacturing (ISAM),remote sensing,space situational awareness (SSA)},
  annotation = {titleTranslation: 构建地月空间监视的未来：面向大容量空间态势感知的在轨组装与制造赋能传感器架构\\
abstractTranslation: 近几十年来，地月空间（Cislunar）领域的操作日益受到关注。为确保地月空间域内飞行安全与操作和平，需要具备提供该域内驻留空间物体当前状态及预测信息的能力，这进而要求建立专用的空间态势感知（SSA）系统。然而，由于地月空间体积庞大且轨道具有混沌特性，实现该区域的SSA难度极大。这些特点给建立持续监视带来了挑战，并限制了预测能力。为应对这些挑战，本研究详细阐述了通过利用超大（尺寸为现有天基孔径5-10倍）射频与光学传感器所提供的增强能力，来实现有效的地月空间态势感知（CSSA）的权衡方案。该方法预设了空间操作范式的转变，即在轨制造大型精密结构成为可能。我们证明，超大孔径能够通过更高的信噪比、分辨率和探测范围，在操作环境中实现及时、持续且精确的CSSA，而这些性能是无法通过部署大量传统尺寸的小型传感器网络来实现的},
  file = {/home/ouyangjiahong/Zotero/storage/XGBLB55H/DeCoster 等 - 2026 - Building the future of cislunar surveillance In space assembly and manufacturing-enabled sensor arc.pdf;/home/ouyangjiahong/Zotero/storage/HXBJQD88/21680256251390412.html}
}


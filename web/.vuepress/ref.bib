@article{daronchGenerationFlightDynamics2011,
  title = {On the Generation of Flight Dynamics Aerodynamic Tables by Computational Fluid Dynamics},
  author = {Da Ronch, A. and Ghoreyshi, M. and Badcock, K. J.},
  year = 2011,
  month = nov,
  journal = {Progress in Aerospace Sciences},
  series = {Special {{Issue}} - {{Modeling}} and {{Simulating Aircraft Stability}} and {{Control}}},
  volume = {47},
  number = {8},
  pages = {597--620},
  issn = {0376-0421},
  doi = {10.1016/j.paerosci.2011.09.001},
  urldate = {2026-01-27},
  abstract = {An approach for the generation of aerodynamic tables using computational fluid dynamics is discussed. For aircraft flight dynamics, forces and moments are often tabulated in multi-dimensional look-up tables, requiring a large number of calculations to fill the tables. A method to efficiently reduce the number of high-fidelity analyses is reviewed. The method uses a kriging-based surrogate model. Low-fidelity (computationally cheap) estimates are augmented with higher fidelity data. Data fusion combines the two datasets into one single database. The approach can also handle changes in aircraft geometry. Once constructed, the look-up tables can be used in real-time to fly the aircraft through the database. To demonstrate the capabilities of the framework presented, five test cases are considered. These include a transonic cruiser concept design, an unconventional configuration, two passenger jet aircraft, and a jet trainer aircraft. Investigations into the areas of flight handling qualities, stability and control characteristics and manoeuvring aircraft are made. To assess the accuracy of the simulations, numerical results are also compared with wind tunnel and flight test data.},
  langid = {english},
  keywords = {Adaptive-fidelity aerodynamics,Aerodynamic tables,Aircraft flight dynamics,Computational fluid dynamics,Kriging interpolation,Manoeuvring aircraft},
  annotation = {titleTranslation: 基于计算流体动力学生成飞行动力学气动数据表\\
abstractTranslation: 本文讨论了一种利用计算流体动力学生成气动数据表的方法。在飞行器飞行动力学中，力和力矩常以多维查找表形式存储，需大量计算来填充这些表格。回顾了一种高效减少高保真分析次数的方法，该方法采用基于克里金法的代理模型。低保真度（计算成本低）的估算值通过更高保真度的数据加以补充，数据融合将两个数据集合并为一个单一数据库。该方案还能处理飞行器几何形状的变化。构建完成后，查找表即可实时用于通过数据库操纵飞行器。为展示所提框架的能力，考虑了五个测试案例，包括一款跨音速巡航机概念设计、一种非常规构型、两款喷气式客机以及一款喷气式教练机。对飞行操纵品质、稳定性和控制特性以及机动飞行等领域进行了研究。为评估仿真精度，还将数值结果与风洞及飞行测试数据进行了对比},
  file = {/home/ouyangjiahong/Zotero/storage/T27IEM3M/Da Ronch 等 - 2011 - On the generation of flight dynamics aerodynamic tables by computational fluid dynamics.pdf;/home/ouyangjiahong/Zotero/storage/T5ASM675/S0376042111000789.html}
}


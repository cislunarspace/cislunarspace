  doi = {10.13700/j.bh.1001-5965.2023.0581},
  abstract = {针对空间中无先验信息的非合作目标意图难以判别的问题，提出一种基于模糊推理的意图识别方法，实现对目标意图的可溯源识别。以绕飞、打击和角度3种度量作为态势评估指标，综合利用非合作目标典型抵近行为的特征信息和领域专家知识构建意图识别数据集。通过聚类分析和隶属度划分对目标意图的特征数据进行模糊化处理，采用模糊决策树算法建立意图识别模型，实现对目标意图的可溯源准确识别。用数值方法进行仿真验证，验证了所提方法的有效性，且识别准确率优于比较方法。},
  langid = {chinese},
  annotation = {CNKICite: 1},
  file = {/home/ouyangjiahong/Zotero/storage/2G9U9YAY/杨卓 等 - 2025 - 基于模糊推理的空间非合作目标意图识别方法.pdf}
}


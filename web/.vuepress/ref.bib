@phdthesis{ZhangJinKongJianJiaoHuiYuanChengDaoYinBianGuiRenWuGuiHua2008,
  type = {{硕士学位论文}},
  title = {{空间交会远程导引变轨任务规划}},
  author = {{张进}},
  year = 2008,
  address = {长沙},
  urldate = {2026-01-29},
  abstract = {交会对接技术是我国载人航天工程二期需要掌握的关键技术,远程导引变轨任务规划是交会对接轨道设计与控制的关键问题之一。本文以解决远程导引轨道设计与控制问题为目的,系统研究了远程导引变轨任务事前规划、实时规划及轨道重构规划问题,主要研究成果如下:研究了考虑工程实际约束的远程导引变轨任务事前规划策略。1)根据Gauss摄动方程特性制定了特殊点变轨方案,通过对设计变量进行分组,提出了粗求解器与细求解器组合的简单迭代求解策略;2)基于近圆偏差线性方程提出了综合变轨两层规划模型,上层问题采用了并行模拟退火算法与序列二次规划算法相结合的混合求解策略,下层问题使用了基于可行域最速下降的线性迭代求解策略;3)通过将轨道圆化机动执行位置增加为设计变量,制定了修正特殊点变轨方案,并提出了两种不同的求解策略,包括非线性数值规划求解策略和基于近圆偏差线性方程非线性解的迭代求解策略。通过对摄动轨道远程导引问题的求解,测试和验证了提出的三种事前规划策略。研究了减小轨道偏差影响的远程导引变轨任务实时规划策略。1)应用试验设计方法分析了远程导引主要误差影响的敏感度,并使用近圆偏差线性方程对分析结果进行了解释;2)根据误差对终端条件的影响关系及各变轨方案的特点,制定了特殊点变轨实时规划方案并提出了简单迭代求解策略,制定了综合变轨实时规划方案并提出了线性迭代求解策略,制定了修正特殊点变轨实时规划方案并提出了基于线性迭代和非线性数值规划的求解策略;3)采用Monte Carlo仿真分析了综合变轨和修正特殊点变轨在误差影响下的终端精度。仿真结果表明根据设计的实时规划策略,两种变轨策略均可获得较高的终端精度,综合变轨终端相对位置精度与修正特殊点变轨相近,终端相对速度精度略好于修正特殊点变轨。研究了远程导引变轨故障后轨道重构规划策略。1)分析了远程导引变轨故障后轨道重构的主要约束条件,提出了轨道重构设计原则;2)对无推力方向限制的重构任务提出了基于多圈Lambert交会算法的迭代求解策略,对有推力方向限制的重构任务提出了基于相位估计的非线性数值规划求解策略。通过对一个发动机开启/关闭故障后轨道重构问题的求解,测试和验证了提出的求解策略。开发了远程导引变轨任务规划软件。根据面向对象的程序设计思想,采用标准C++语言编码,在Visual C++ 6.0环境下开发了集成论文研究成果的远程导引变轨任务规划软件。...},
  collaborator = {{唐国金}},
  langid = {chinese},
  school = {国防科学技术大学},
  annotation = {album: 工程科技II辑\\
CLC: V412.41\\
dbcode: CMFD\\
dbname: CMFD2010\\
download: 793\\
filename: 2009213869.nh\\
major: 航空宇航科学与技术}
}

@article{ZhangJinYiZhongDongTaiSuoDingShiDuoXingXieTongRenWuGuiHuaDeA2CSuanFa2024,
  title = {{一种动态锁定式多星协同任务规划的A2C算法}},
  author = {{张晋} and {赵雪婷} and {李博文}},
  year = 2024,
  journal = {宇航学报},
  volume = {45},
  number = {5},
  pages = {700--710},
  issn = {1000-1328},
  abstract = {提出了一种基于强化学习算法的多星协同任务规划方法。该方法将多星协同任务规划视为多个双星协同规划，采用相邻双星锁定的方式来共享双星任务规划结果信息，基于A2C（优势动作评价）强化学习算法对双星任务规划的结果进行再调整。针对多星协同任务规划状态空间复杂且变化的问题，设计了两级状态空间和价值评价函数决策的方法，对强化学习所依赖的状态空间进行维度限制，确保智能体对任务进行调整的过程不影响状态空间维度。算法设计过程考虑了多种约束条件，设置了天气、成像质量和成像优先级等可调参数作为强化学习A2C算法的评价参数，这些可调参数有助于用户自定义决策评价体系。最后，通过仿真验证了算法的可行性。仿真结果表明，该算法多星协同任务规划的组合任务抛弃率小于10\%。},
  langid = {chinese},
  annotation = {CNKICite: 1},
  file = {/home/ouyangjiahong/Zotero/storage/TVQTNQ6E/张晋 等 - 2024 - 一种动态锁定式多星协同任务规划的A2C算法.pdf}
}

@phdthesis{ZhangJinZhuDongShiXiaZhiJiaZhiDeXiTongSheJiHeBianSuYunDongKongZhiYanJiu2024,
  type = {{硕士学位论文}},
  title = {{主动式下肢假肢的系统设计和变速运动控制研究}},
  author = {{张津}},
  year = 2024,
  address = {长沙},
  doi = {10.27052/d.cnki.gzjgu.2022.000148},
  urldate = {2025-10-07},
  abstract = {由于疾病和各种事故,下肢截肢者的人数逐渐增加,截止到2018年,截肢者的人数已经超过170万人。而随着生活水平的提高和科技的进步,截肢者对于假肢的要求也越来越高,因此主动式下肢假肢的研发成为了当前的研究热点。针对主动式假肢,人们提出了多种控制方法,但大多数方法都用不同的控制器将步态周期分成多个顺序周期,需要调整大量参数来配置每个控制器,且容易在控制器切换时造成控制信号突变,发生危险。目前较为热门的控制算法是采用虚拟约束的方法将步态周期统一的方式,实现对假肢的连续控制,但该方法期望关节角通常采用单一速度下关节轨迹的拟合函数来计算,在变速行走时效果较差。本文提出了一种基于虚拟约束的动力假肢平滑变速控制策略,并根据实验需求,设计了步态数据采集系统和假肢控制系统,主要内容如下:1.结合期望轨迹面函数的需求,改进了相位变量的计算方法,实现了相位变量对行走速度的快速准确跟踪。本文在基于髋关节角与微分计算相位变量的基础上,对计算得到的原始相位变量进行滤波,实现了相位角速度对行走速度的快速稳定跟踪,并通过相位角来实时预测当前状态在整个步态周期中所处的位置,得到的相位角和相位角速度轨迹不仅始终保持平滑,在行走速度发生变化时也实现了迅速跟踪,为期望关节角的准确预测打下了良好的基础。2.为了得到健全者在不同行走速度下的步态数据,本文进行了数据采集系统的开发,实现了对单腿行走数据的实时采集与记录,并对得到的数据进行了预处理。此外,本文通过天文学领域的Lomb-Scargle周期图方法对非均匀采样的相位角-关节轨迹数据集进行了特征提取,并采用最小二乘法建立了拟合函数,解决了离散傅里叶变换等常用方法无法对非均匀数据集进行分析的问题。3.提出了一种新的期望轨迹生成算法。人以不同速度行走时,产生的各关节运动轨迹并不相同,因此需要根据当前的运动速度来选择合适的期望轨迹。本文通过对不同速度轨迹拟合函数的系数进行分析,发现随着行走速度的变化,拟合函数系数的变化是有规律的。因此,对轨迹函数对应系数构成的曲线进行多项式拟合,使轨迹函数系数随着行走速度的变化而平滑过渡,实现平滑连续预测关节角的效果。4.完成了主动式下肢假肢控制系统的设计和开发,并在该系统上进行了算法的实验研究,验证了该假肢控制系统的可靠性和稳定性,并对新算法进行了实验,验证了新算法与传统算法相比,在预测性、平稳性和变速性上更具优势。本文工作具有一定创新性,也解决了实验室动力假肢项目控制系统的有无问题。本文分别采取了仿真、遥操作实验与穿戴实验对该方案与基于髋关节角积分计算相位的方案进行了对比,发现该方案对速度的适应性较好,生成的轨迹与健全者的行走轨迹相似度更高。另外,本文评估了该算法对行走速度变化的感知能力,发现随着行走速度的变化,预测得到的相位角速度可以在极短的时间内变化到相应的值。因此,提出的方案可以使截肢者行走时在不同的速度之间平滑切换,提高了假肢的变速行走能力。},
  collaborator = {{韦庆} and {安宏雷}},
  langid = {chinese},
  school = {国防科技大学},
  annotation = {album: 基础科学;医药卫生科技;信息科技\\
CLC: R318;TP242\\
dbcode: CMFD\\
dbname: CMFD202401\\
download: 95\\
filename: 1023896162.nh\\
foundation: 国家重点研发计划项目``膝踝一体化仿生智能下肢假肢关键技术与应用研究'',研究的课题为``多运动模式人机协同控制系统开发''；\\
major: 工程硕士（专业学位）},
  file = {/home/ouyangjiahong/Zotero/storage/FF9J8VXF/张津 - 2024 - 主动式下肢假肢的系统设计和变速运动控制研究.pdf}
}


@article{guzzoTheoryApplicationsFast2023,
  title = {Theory and Applications of Fast Lyapunov Indicators to Model Problems of Celestial Mechanics},
  author = {Guzzo, Massimiliano and Lega, Elena},
  year = 2023,
  month = aug,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {4},
  pages = {37},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10152-5},
  urldate = {2025-10-01},
  abstract = {In the last decades, we have seen a rapid increment in the use of finite-time chaos indicators in celestial mechanics. They have been used to analyze the complex dynamics of planetary systems, of minor planets and of space debris. In fact, theoretical studies on fundamental dynamical models have revealed that, computed on short time intervals, they allow to efficiently detect resonances, represent the phase portraits of complex dynamics, compute center-stable-unstable manifolds as well as Lagrangian coherent structures. In this paper, we focus on applications of the fast Lyapunov indicator (FLI) and review through examples why its computation is particularly powerful for those systems whose solutions may have an asymptotic behavior very different from the short-term one, as it is the case of sequences of close encounters in gravitational systems and the advection of particles in aperiodic flows. The main case study here considered is the computation of the manifold tubes and the related transit orbits in the restricted three-body problem. We also provide a new application of the FLI to a complex problem of planetary hydrodynamics, such as the detection of the stable and unstable manifolds guiding the motions of particles advected by the gas of a protoplanetary nebula.},
  langid = {english},
  annotation = {titleTranslation: 快速李雅普诺夫指标在天体力学问题建模中的理论与应用。},
  file = {/home/ouyangjiahong/Zotero/storage/XJJNG7FJ/Guzzo和Lega - 2023 - Theory and applications of fast lyapunov indicators to model problems of celestial mechanics.pdf}
}

@article{haapalaIncorporatingEvolutionMultibody2015,
  title = {Incorporating the Evolution of Multi-Body Orbits into the Trajectory Trade Space and Design Process},
  author = {Haapala, Amanda F. and Howell, Kathleen C. and Folta, David C.},
  year = 2015,
  month = jul,
  journal = {Acta Astronautica},
  volume = {112},
  pages = {1--18},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2015.02.024},
  urldate = {2025-11-27},
  abstract = {Libration point orbits have been incorporated in many missions, with the capability of orbiting near L1 and L2 in the Earth--Moon system recently demonstrated during the ARTEMIS mission. While the orbits in the vicinity of the collinear libration points have been well studied, knowledge about the availability and evolution of these orbits is not generally exploited during the mission design process. In this investigation, strategies to display information about the global solution space in the vicinity of the libration points are explored, facilitating a rapid assessment of the available solutions for a range of energy levels. A design process is presented that exploits information about the available orbit structures, and is demonstrated for several sample design scenarios, including transfers to and between libration point orbits.},
  langid = {english},
  annotation = {titleTranslation: 将多体轨道演化纳入轨迹权衡空间与设计流程。\\
abstractTranslation: 平动点轨道已被纳入多项任务中，近期ARTEMIS任务验证了在地月系统L1和L2附近运行的能力。虽然共线平动点附近的轨道已得到充分研究，但这些轨道的可用性和演化规律通常在任务设计过程中未被充分利用。本研究探索了在平动点附近显示全局解空间信息的策略，以促进对不同能量水平下可用解的快速评估。提出了一种利用已知轨道结构信息的设计流程，并通过多个示例设计场景（包括往返于平动点轨道的转移）进行了验证。},
  file = {/home/ouyangjiahong/Zotero/storage/GXNVEM6L/Haapala 等 - 2015 - Incorporating the evolution of multi-body orbits into the trajectory trade space and design process.pdf}
}

@article{haapalaRepresentationsHigherdimensionalPoincare2014,
  title = {Representations of Higher-Dimensional Poincar\'e Maps with Applications to Spacecraft Trajectory Design},
  author = {Haapala, Amanda F. and Howell, Kathleen C.},
  year = 2014,
  month = mar,
  journal = {Acta Astronautica},
  volume = {96},
  pages = {23--41},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2013.11.019},
  urldate = {2025-11-27},
  abstract = {The Circular Restricted Three-Body Problem (CR3BP) offers a useful framework for preliminary trajectory design in multi-body regimes. While the CR3BP offers a simplified model with useful symmetries, trajectory design in this dynamical regime is often nontrivial. It is essential to gain insight into the available solution space to generate trajectories that meet a variety of constraints. The Poincar\'e map is a powerful tool that, in combination with a constraint on the energy level, allows a reduction in dimension such that, for the planar problem, the system is reduced to two-dimensions and the phase space is fully represented by the projection onto a plane. In the spatial problem, however, Poincar\'e maps must represent at least four states and are therefore challenging to visualize. In this investigation, a method to represent the information contained in higherdimensional Poincar\'e maps using a two-dimensional image for visualization is explored and is applied for trajectory design. Four-dimensional map representations are demonstrated to compute transfers, including heteroclinic and homoclinic connections, between periodic and quasi-periodic orbits in the spatial problem. Alternative maps, such as the periapse Poincar\'e map, require that at least five Cartesian states be represented. Map representations are generated to visualize the full state associated with crossings of the periapse map, and are employed to locate families of periodic orbits about the Moon, as well as transfers to these orbits via transit trajectories.},
  langid = {english},
  annotation = {titleTranslation: 高维庞加莱图的表示及其在航天器轨迹设计中的应用\\
abstractTranslation: 圆型限制性三体问题（CR3BP）为多体动力学环境下的初步轨道设计提供了有效框架。尽管CR3BP通过简化模型保留了有用的对称性，但在此动力学体系中进行轨道设计往往并非易事。深入理解可用的解空间对于生成满足多种约束条件的轨道至关重要。庞加莱映射作为一种强大工具，结合能量层约束，可实现维度约化：在平面问题中，系统被降为二维，相空间可通过投影完全表征于平面之上。然而，在空间问题中，庞加莱映射必须至少表示四个状态量，因而可视化难度显著增加。本研究探索了一种方法，利用二维图像呈现高维庞加莱映射所蕴含的信息，并将其应用于轨道设计。通过展示四维映射表示法，计算了空间问题中周期轨道与拟周期轨道之间的转移，包括异宿连接与同宿连接。此外，诸如近心点庞加莱映射等替代映射，需至少表征五个笛卡尔状态量。本文构建了映射表示图，用以可视化与近心点映射穿越相关的完整状态，并据此定位月球附近的周期轨道族，以及通过过境轨道实现向这些轨道的转移。},
  file = {/home/ouyangjiahong/Zotero/storage/VY2IP8UD/Haapala和Howell - 2014 - Representations of higher-dimensional poincaré maps with applications to spacecraft trajectory desig.pdf}
}


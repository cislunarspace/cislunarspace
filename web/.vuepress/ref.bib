  doi = {10.1016/j.asr.2010.12.005},
  urldate = {2025-11-27},
  abstract = {Compared with the circular restricted three-body problem, various perturbations exist in the real Earth--Moon system. Out of them, the ones from the Moon's orbit eccentricity and the Sun are the most prominent. For mission design around the collinear libration points in this system, these two perturbations should be taken into consideration. In fact, the collinear libration points are not equilibrium points anymore due to these perturbations. Instead, special quasi-periodic orbits called dynamical substitutes around them exist, playing the role of time-varying equilibrium points. Generally, these dynamical substitutes are unstable, thus station-keeping is necessary for probes around them. In the paper, a short description of the dynamical properties of these dynamical substitutes was made. Then two station-keeping strategies were proposed for small amplitude motions around them. The first strategy has no requirements on the motion amplitude in the x--y plane while the second one has. Taking the point L2 as an example, some numerical simulations were made. Motions with amplitude of 380 km and 3800 km were studied. It turns out that the cost of the two station-keeping strategies increases with increasing amplitude. Besides, the second strategy generally costs more than the first one.},
  langid = {english},
  annotation = {titleTranslation: 真实地月系统中共线平动点附近小振幅运动的轨道保持\\
abstractTranslation: 与圆形限制性三体问题相比，真实地月系统中存在多种摄动因素，其中月球轨道偏心率和太阳引力产生的摄动最为显著。在该系统的共线平动点附近进行任务设计时，需综合考虑这两类摄动的影响。实际上，由于这些摄动的存在，共线平动点已不再是平衡点，取而代之的是围绕它们存在的特殊拟周期轨道------即所谓``动力学替代点''，这些轨道扮演着时变平衡点的角色。此类动力学替代点通常不稳定，因此探测器在其附近运行时需实施轨道维持。本文简要描述了这些动力学替代点的动力学特性，并针对其周围的小振幅运动提出了两种轨道维持策略：第一种策略对x-y平面内的运动振幅无限制，而第二种策略则有此要求。以L2点为例进行了数值仿真，研究了振幅为380公里和3800公里的运动。结果表明，两种轨道维持策略的代价均随振幅增大而增加，且第二种策略的代价通常高于第一种。},
  file = {/home/ouyangjiahong/Zotero/storage/55TGVGBF/Hou 等 - 2011 - Station-keeping of small amplitude motions around the collinear libration point in the real earth–mo.pdf}
}

@article{HouXiaoLiYongWuZhiWenLinQingGuoWangXiaoWeiGengHaiHuangTianKunWoGuoKongJianTuiJinJiShuLingYuFaZhanSiKaoYuJianYi2024,

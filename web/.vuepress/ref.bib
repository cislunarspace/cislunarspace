@article{colonnawalewskiLunarNavigationPositioning2018,
  title = {Lunar Navigation and Positioning System Based on Cubesat Constellation},
  author = {Colonna Walewski, A. and Zhang, W. and Magnin, T. and Dragoni, M. and Du Roy, G. and Hacene Lhadj, K. and Maily, M. and Jain, G.},
  year = 2018,
  journal = {Proceedings of the International Astronautical Congress, IAC},
  issn = {0074-1795},
  abstract = {In the scenario of Moon exploration, the introduction of a Lunar navigation system is an essential asset to support surface operations. A precise positioning real-time system on an astronomical body plays a key role in enhancing robotics and human activities, allowing to plan safer and more reliable missions. The system will provide accurate data on the location of vehicles and direct Line-of-Sight links to every region of interest on the Lunar surface, thus suppressing occultation times for Earth communications. Moreover, with the aim of building settlements on the Moon, the system will also provide the capability of coordinating technologically advanced machines operating autonomously to conduct research and gather scientific data. Furthermore, the navigation fleet will also cooperate with In-Situ-Resource-Utilization systems by mapping raw resources and providing end-to-end communications with different ISRU subsystems. In this paper, it is described the feasibility of such a system, focusing in particular on CubeSats which allow to minimize mission costs without incurring in a substantial degradation of the signal. The Cubesats making up the navigation constellation will fly over non-circular orbits to ensure full coverage of the Lunar surface regions of interest, ensuring the capability of a continuous exchange of data with the Lunar Ground Segment. Finally, the comparatively short distance between Moon and Earth will facilitate the initial implementation of the concept in a Lunar orbit, paving the way for the employment of the same technology in future exploration missions on more distant celestial bodies, such as Mars.},
  langid = {english},
  keywords = {Cubesat,Lunar Navigation and Positioning,Moon,NRHO,South Pole},
  annotation = {titleTranslation: 基于立方星星座的月球导航与定位系统\\
abstractTranslation: 在月球探测场景中，建立月球导航系统是支持表面作业的关键资产。在天体上实现高精度实时定位系统，对于提升机器人与人类活动效能至关重要，从而能够规划更安全、更可靠的任务。该系统将提供车辆位置的精确数据，并与月球表面每个感兴趣区域建立直接视线链路，从而减少与地球通信时的掩星时间。此外，为在月球上建设定居点，该系统还将具备协调自主运行的高科技机器进行科研与科学数据采集的能力。更进一步，导航星座还将与原位资源利用系统协作，通过绘制原始资源分布图并提供与不同ISRU子系统之间的端到端通信。本文描述了此类系统的可行性，尤其聚焦于CubeSats，它们能够在不大幅降低信号质量的前提下最大程度降低任务成本。构成导航星座的CubeSats将运行于非圆形轨道，以确保全面覆盖月球表面感兴趣区域，并具备与月球地面段持续交换数据的能力。最后，月球与地球之间相对较近的距离将有利于该概念在月球轨道上的初期实施，从而为未来在更遥远天体（如火星）的探测任务中应用相同技术奠定基础。}
}


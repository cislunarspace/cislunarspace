  journal = {中国远程教育},
  volume = {46},
  number = {1},
  pages = {86--102},
  issn = {1009-458X},
  doi = {10.13541/j.cnki.chinade.2026.01.004},
  urldate = {2026-02-05},
  abstract = {科学教育作为培育科技创新人才的摇篮，其数智化转型进程深刻影响着国家创新体系的根基稳固性。基于技术中介视角，人工智能在科学教育中具有双重中介身份：一方面，作为知觉中介，人工智能通过重构科学认知的``现象场''，深刻影响学生对科学现象的感知与理解；另一方面，作为行为中介，人工智能通过塑造科学实践的``行动网络''，重新定义科学探究的流程与方式。然而，人工智能的深度介入也引发了两类显著的教育风险------认知输入异化与行为输出桎梏。在认知输入异化层面，表现为技术拟真遮蔽科学感知的本真性生成，以及智能交互对慢思考与探究欲的隐性消解；在行为输出桎梏层面，体现为数智场景割裂科学实践的情境关联性，以及程序预设对多元创造空间的算法窄化。为应对相关风险，提出科学教育数智化转型的推进策略：一是弱化技术符号化倾向，定制化设计科学现象的混合感知通道；二是破解认知垄断困境，重构科学认知中人机对话的权力分配；三是确立技术的工具性定位，构建身体导向的虚实科学实验闭环；四是激活人技对称互动，引导学生开展建构性的科学知识创生。},
  langid = {chinese},
  annotation = {original-container-title: Chinese Journal of Distance Education\\
AIF: 7.338\\
album: 社会科学II辑;信息科技\\
CIF: 10.191\\
CLC: G434\\

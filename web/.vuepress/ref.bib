@article{eubanksScientificReturnLunar2016,
  title = {Scientific Return of a Lunar Elevator},
  author = {Eubanks, Thomas Marshall and Radley, Charles F.},
  year = 2016,
  month = aug,
  journal = {Space Policy},
  volume = {37},
  pages = {97--102},
  issn = {02659646},
  doi = {10.1016/j.spacepol.2016.08.005},
  urldate = {2025-11-27},
  abstract = {The concept of a space elevator dates back to Tsilokovsky, but they are not commonly considered in nearterm plans for space exploration, perhaps because a terrestrial elevator would not be possible without considerable improvements in tether material. A Lunar Space Elevator (LSE), however, can be built with current technology using commercially available tether polymers. This paper considers missions leading to infrastructure capable of shortening the time, lowering the cost and enhancing the capabilities of robotic and human explorers. These missions use planetary scale tethers, strings many thousands of kilometers long stabilized either by rotation or by gravitational gradients. These systems promise major reduction in transport costs versus chemical rockets, in a rapid timeframe, for a modest investment. Science will thus benefit as well as commercial activities.},
  langid = {english},
  annotation = {titleTranslation: 月球电梯科学返回\\
abstractTranslation: 太空电梯的概念最早可追溯到Tsilokovsky，但在近期的太空探索计划中并不常见，或许是因为地面电梯需要大幅提升缆绳材料性能才能实现。然而，采用当前技术，利用市面上已有的聚合物缆绳便可以建造月球太空电梯（LSE）。本文探讨了旨在构建基础设施的任务，这些设施能够缩短时间、降低成本并增强机器人与人类探索者的能力。这些任务采用行星级缆绳------长度达数千公里的绳索，通过旋转或重力梯度保持稳定。相较于化学火箭，这些系统有望在短期内以较低的投资大幅降低运输成本。科学研究和商业活动也将因此受益},
  file = {/home/ouyangjiahong/Zotero/storage/M8K3KYQU/Eubanks和Radley - 2016 - Scientific return of a lunar elevator.pdf}
}


@article{liGravitationalRedshiftTest2026,
  title = {Gravitational Redshift Test in a Lunar Distant Retrograde Orbit Using a Compact Hydrogen Maser},
  author = {Li, Yang and Liu, Tong and Pei, Yuxian and Guan, Hongfei and Leng, Jiaxing and Shuai, Tao and Zhao, Yang and Qin, Chenggang and Wang, Wenbin and Shu, Leizheng and Gao, Yang},
  year = 2026,
  month = mar,
  journal = {Chinese Physics Letters},
  volume = {43},
  number = {3},
  pages = {031101},
  issn = {0256-307X, 1741-3540},
  doi = {10.1088/0256-307X/43/3/031101},
  urldate = {2026-04-23},
  abstract = {Abstract                            This letter reports a gravitational redshift measurement experiment using a satellite-based compact passive hydrogen maser (PHM) in a lunar distant retrograde orbit (DRO). In March 2024, the Chinese Academy of Sciences launched the DRO-A/B twin satellites, which entered a DRO in July 2024. This orbit has a geocentric distance of approximately 300,000--450,000 kilometers and a 2:1 resonance ratio. Employing microwave dual one-way ranging (DOWR), satellite-ground time-frequency comparisons were successfully achieved in April 2025 using the PHM aboard the DRO-A satellite. This study validated the in-orbit performance of the compact PHM and supported tests of the Einstein Equivalence Principle. The gravitational redshift measurement result is (8.74 \textpm{} 4.17) \texttimes{} 10               -3               . As the world's first fundamental physics experiment to deploy PHMs in a lunar DRO, this study provides significant new engineering approaches for testing gravitational theories in cislunar space.},
  langid = {english},
  annotation = {titleTranslation: 利用紧凑型氢脉泽在月球远距离逆行轨道进行引力红移测试\\
abstractTranslation: 摘要  \\
本文报道了一项利用月球远距离逆行轨道（DRO）中的星载紧凑型无源氢原子钟（PHM）进行引力红移测量的实验。2024年3月，中国科学院发射了DRO-A/B双星，并于2024年7月进入DRO轨道。该轨道的地心距离约为30万至45万公里，具有2:1共振比。通过采用微波双单向测距（DOWR）技术，并于2025年4月利用DRO-A卫星搭载的PHM成功实现了星地时频比对。本研究验证了紧凑型PHM的在轨性能，并支持了爱因斯坦等效原理的检验。引力红移测量结果为（8.74 \textpm{} 4.17）\texttimes{} 10{$^{-3}$}。作为全球首个在月球DRO中部署PHM的基础物理实验，本研究为地月空间引力理论的检验提供了重要的新型工程途径。},
  file = {/home/ouyangjiahong/Zotero/storage/Y5HRRF7I/Li 等 - 2026 - Gravitational redshift test in a lunar distant retrograde orbit using a compact hydrogen maser.pdf;/home/ouyangjiahong/Zotero/storage/K7JPF3KK/031101.html}
}


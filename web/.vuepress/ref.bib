@article{scantamburloOrbitDeterminationOne2024,
  title = {Orbit Determination from One Position Vector and a Very Short Arc of Optical Observations},
  author = {Scantamburlo, Erica and Gronchi, Giovanni F. and Ba{\`u}, Giulio},
  year = 2024,
  month = aug,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {4},
  pages = {30--51},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10201-7},
  urldate = {2025-10-01},
  abstract = {In this paper, we address the problem of computing a preliminary orbit of a celestial body from one topocentric position vector P1 and a very short arc (VSA) of optical observations A2. Using the conservation laws of the two-body dynamics, we write the problem as a system of 8 polynomial equations in 6 unknowns. We prove that this system is generically consistent, namely, for a generic choice of the data P1, A2, it always admits solutions in the complex field, even when P1, A2 do not correspond to the same celestial body. The consistency of the system is shown by deriving a univariate polynomial v of degree 8 in the unknown topocentric distance at the mean epoch of the observations of the VSA. Through Gr\"obner bases theory, we also show that the degree of v is minimum among the degrees of all the univariate polynomials solving this problem. Even though we can find solutions to our problem for a generic choice of P1, A2, most of these solutions are meaningless. In fact, acceptable solutions must be real and have to fulfill other constraints, including compatibility with Keplerian dynamics. We also propose a way to select or discard solutions taking into account the uncertainty in the data, if present. The proposed orbit determination method is relevant for different purposes, e.g., the computation of a preliminary orbit of an Earth satellite with radar and optical observations, the detection of maneuvres of an Earth satellite, and the recovery of asteroids which are lost due to a planetary close encounter. We conclude by showing some numerical tests in the case of asteroids undergoing a close encounter with the Earth.},
  langid = {english},
  annotation = {titleTranslation: 从一个位置矢量和一个很短的光学观测弧段确定轨道。\\
abstractTranslation: 本文探讨如何利用一个天顶位置向量P1和一段非常短的光学观测弧段A2来计算天体的初步轨道。基于二体动力学的守恒律，我们将问题转化为一个包含6个未知数的8个多项式方程组。我们证明了该方程组在一般意义下是相容的，即对于一般选择的数据P1、A2，即使P1、A2并非对应同一天体，该方程组在复数域内也总有解。通过推导一个关于VSA观测平均历元处未知天顶距离的8次单变量多项式v，我们证明了方程组的相容性。利用Gr\"obner基理论，我们还证明了v的次数是解决该问题的所有单变量多项式中的最小次数。尽管对于一般选择的P1、A2，我们可以找到问题的解，但其中大多数解是无意义的。实际上，可接受的解必须是实数，并且需要满足其他约束，包括与开普勒动力学的兼容性。我们还提出了一种在存在数据不确定性的情况下选择或剔除解的方法。所提出的轨道确定方法适用于多种目的，例如利用雷达和光学观测计算地球卫星的初步轨道、检测地球卫星的机动、以及恢复因行星近距离飞越而丢失的小行星。最后，我们展示了在遭遇地球近距离飞越的小行星案例中的数值测试结果。},
  file = {/home/ouyangjiahong/Zotero/storage/MWIFU2KE/Scantamburlo 等 - 2024 - Orbit determination from one position vector and a very short arc of optical observations.pdf}
}


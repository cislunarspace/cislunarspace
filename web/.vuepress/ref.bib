@article{przybylskaNonintegrabilityChargedThreebody2025,
  title = {Non-Integrability of Charged Three-Body Problem},
  author = {Przybylska, Maria and Maciejewski, Andrzej J.},
  year = 2025,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},
  number = {1},
  pages = {8--21},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-025-10237-3},
  urldate = {2025-10-01},
  abstract = {We consider the problem of n points with positive masses interacting pairwise with forces inversely proportional to the distance between them. In particular, it is the classical gravitational, Coulomb or photo-gravitational n-body problem. Under this general form of interaction, we investigate the integrability problem of three bodies. We show that the system is not integrable except in one case when two among three interaction constants vanish. In our investigation, we use the Morales--Ramis theorem concerning the integrability of a natural Hamiltonian system with a homogeneous potential and its generalization.},
  langid = {english},
  annotation = {titleTranslation: 带电三体问题的不可积性\\
abstractTranslation: 我们考虑n个具有正质量的点，它们之间相互作用力与距离成反比的问题。特别地，这是经典的引力、库仑或光引力n体问题。在这种一般形式的相互作用下，我们研究了三体的可积性问题。我们证明，除了两个相互作用常数为零的情况外，该系统不可积。在我们的研究中，我们使用了关于具有齐次势的自然哈密顿系统可积性的Morales--Ramis定理及其推广。},
  file = {/home/ouyangjiahong/Zotero/storage/G9P77R2M/Przybylska和Maciejewski - 2025 - Non-integrability of charged three-body problem.pdf}
}

@article{przybylskaNonintegrabilityPlanarElliptic2023,

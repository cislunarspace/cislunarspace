@article{yukikayamaLowthrustTrajectoryDesign2022,
  title = {Low-Thrust Trajectory Design with Successive Convex Optimization for Libration Point Orbits},
  author = {Yuki Kayama, Kathleen C. Howell Mai},
  year = 2022,
  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {Vol.45},
  number = {No.4},
  pages = {623--637},
  issn = {0731-5090},
  doi = {10.2514/1.G005916},
  abstract = {In space missions, numerical techniques for minimizing the fuel consumption of spacecraft using low-thrust propulsion are desirable. Among various nonlinear optimization methods, convex optimization has been attracting attention because it allows optimal solutions to emerge robustly and requires short computation times. In particular, trajectory design in the three-body problem near the Lagrange points involves instability and nonlinearity. Hence, this study considers the application of convex optimization to trajectory design with low-thrust propulsion in cislunar space and verifies that this technique performs well, even for sensitive and highly nonlinear dynamics. Specifically, the convex optimization scheme is applied in the transfer from a halo orbit to a near-rectilinear halo orbit where both are periodic as defined in the circular restricted three-body problem. As a further step, the transfer problem is transitioned to an ephemeris model. In addition, extensive investigations of the dependence on various parameters used in convex optimization are conducted, and a trajectory corrections maneuver method is constructed combined with the convex optimization process. This investigation provides valuable insight into the convex optimization technique in the three-body problem and facilitates the estimation of low-thrust trajectory designs for complex space missions.},
  langid = {english},
  annotation = {titleTranslation: 基于逐次凸优化的低推力平动点轨道轨迹设计\\
abstractTranslation: 在空间任务中，采用数值技术以最小化使用低推力推进的航天器燃料消耗是理想的选择。在众多非线性优化方法中，凸优化因其能稳健地得出最优解且计算时间短而备受关注。特别是在拉格朗日点附近的三体问题中，轨迹设计涉及不稳定性和非线性。因此，本研究考虑将凸优化应用于地月空间低推力推进的轨迹设计，并验证了该技术即使在敏感且高度非线性的动力学环境下也能表现良好。具体而言，凸优化方案被应用于从晕轨道到近直线晕轨道的转移，两者均为圆型限制性三体问题中定义的周期轨道。作为进一步步骤，转移问题被过渡到星历模型。此外，还对凸优化中使用的各种参数依赖性进行了广泛研究，并结合凸优化过程构建了轨迹修正机动方法。本研究为三体问题中的凸优化技术提供了宝贵见解，并有助于复杂空间任务中低推力轨迹设计的评估。}
}


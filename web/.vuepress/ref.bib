@article{benestLibrationEffectsRetrograde1976,
  title = {Libration Effects for Retrograde Satellites in the Restricted Three-Body Problem},
  author = {Benest, Daniel},
  year = 1976,
  month = mar,
  journal = {Celestial Mechanics},
  volume = {13},
  number = {2},
  pages = {203--215},
  issn = {1572-9478},
  doi = {10.1007/BF01232724},
  abstract = {Numerical explorations of the restricted problem have shown that for stable large nonperiodic retrograde satellite orbits, the motion can be decomposed into a fast `reference motion' and a slow libration aroundB2 We study here this libration in the circular plane Hill's case, for which the `reference motion' is elliptic. We establish the equations of motion for the coordinates of the centre of this ellipse. We find two integrals of motion: the first is the semi-major axis of the ellipse; the second is essentially Jacobi's integral, translated into the new coordinates. We give a formula for the period of the libration and we find its limiting value for small libration amplitudes. A numerical verification gives very good agreement for all these results.},
  langid = {english},
  annotation = {titleTranslation: 限制性三体问题中逆行卫星的平动点摄动效应\\
abstractTranslation: 受限问题的数值探索表明，对于稳定的大尺度非周期逆行卫星轨道，其运动可以分解为快速的`参考运动'和围绕B2的缓慢天平动。我们在此研究圆形平面希尔情况下的这种天平动，其中`参考运动'是椭圆形的。我们建立了该椭圆中心坐标的运动方程。我们找到了两个运动积分：第一个是椭圆的半长轴；第二个本质上是雅可比积分，转换到新坐标系后的形式。我们给出了天平动周期的公式，并找到了小振幅天平动的极限值。数值验证显示所有这些结果吻合良好。},
  file = {/home/ouyangjiahong/Zotero/storage/XKJLGJIZ/Benest - 1976 - Libration effects for retrograde satellites in the restricted three-body problem.pdf}
}

@article{bengocheaSymmetricPeriodicOrbits2024,
  title = {Symmetric Periodic Orbits near Binary Collision in a Restricted Four-Body Problem for the Figure-Eight Choreography},
  author = {Bengochea, Abimael and {Burgos-Garc{\'i}a}, Jaime and {P{\'e}rez-Chavela}, Ernesto},
  year = 2024,
  month = oct,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {5},
  pages = {42--62},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10214-2},
  urldate = {2025-10-01},
  abstract = {We study symmetric periodic orbits near collision in a nonautonomous restricted planar four-body problem. The restricted problem consists of a massless particle moving under the gravitational influence due to three bodies with the same positive mass (the primaries), following the figure-eight choreography. We use regularized coordinates, in order to deal numerically with motions near collision between the massless particle and one of the primaries. By means of reversing symmetries, we characterize the symmetric periodic orbits near collision. The initial conditions for these orbits were computed by solving numerically some boundary value problems. We explain theoretically, and confirm numerically, how different parts of the diagram of initial conditions are related due to the symmetry of the figure-eight choreography.},
  langid = {english},
  annotation = {titleTranslation: 限制性四体问题中``8''字型编队轨道附近靠近二体碰撞的对称周期轨道\\
abstractTranslation: 我们在非自治限制性平面四体问题中研究了碰撞附近的对称周期轨道。该限制性问题涉及一个无质量粒子，在三个具有相同正质量（主天体）并遵循8字形编队运动的天体的引力影响下运动。我们使用正则化坐标，以数值处理无质量粒子与其中一个主天体之间碰撞附近的运动。通过反演对称性，我们刻画了碰撞附近的对称周期轨道。这些轨道的初始条件通过数值求解某些边值问题计算得到。我们从理论上解释并数值上确认了初始条件图的不同部分如何因8字形编队运动的对称性而相互关联。},
  file = {/home/ouyangjiahong/Zotero/storage/LUS8V78J/Bengochea 等 - 2024 - Symmetric periodic orbits near binary collision in a restricted four-body problem for the figure-eig.pdf}
}

@article{benitezRelativisticFactorOrbital2008,
  title = {The Relativistic Factor in the Orbital Dynamics of Point Masses},
  author = {Benitez, Federico and Gallardo, Tabar{\'e}},
  year = 2008,
  month = jul,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {101},
  number = {3},
  pages = {289--307},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-008-9146-5},
  urldate = {2025-11-27},
  abstract = {There is a growing population of relativistically relevant minor bodies in the Solar System and a growing population of massive extrasolar planets with orbits very close to the central star where relativistic effects should have some signature. Our purpose is to review how general relativity affects the orbital dynamics of the planetary systems and to define a suitable relativistic correction for Solar System orbital studies when only point masses are considered. Using relativistic formulae for the N body problem suited for a planetary system given in the literature we present a series of numerical orbital integrations designed to test the relevance of the effects due to the general theory of relativity in the case of our Solar System. Comparison between different algorithms for accounting for the relativistic corrections are performed. Relativistic effects generated by the Sun or by the central star are the most relevant ones and produce evident modifications in the secular dynamics of the inner Solar System. The Kozai mechanism, for example, is modified due to the relativistic effects on the argument of the perihelion. Relativistic effects generated by planets instead are of very low relevance but detectable in numerical simulations.},
  langid = {english},
  annotation = {titleTranslation: 质点轨道动力学中的相对论因子\\
abstractTranslation: 太阳系中相对论性小天体的数量正在增加，同时轨道非常靠近中心恒星的大质量系外行星数量也在增长，在这些天体附近相对论效应应当留下某些特征。本文旨在回顾广义相对论如何影响行星系统的轨道动力学，并定义一种适用于仅考虑质点情况的太阳系轨道研究的相对论修正方案。利用文献中针对行星系统给出的N体问题相对论公式，我们进行了一系列数值轨道积分，以测试广义相对论效应在太阳系中的重要性。对不同算法在考虑相对论修正时的表现进行了比较。由太阳或中心恒星产生的相对论效应最为显著，并导致内太阳系长期动力学发生明显改变。例如，Kozai机制因相对论对近日点辐角的影响而发生改变。而行星产生的相对论效应虽然相关性极低，但在数值模拟中仍可探测到。},
  file = {/home/ouyangjiahong/Zotero/storage/J76ZYVIL/Benitez和Gallardo - 2008 - The relativistic factor in the orbital dynamics of point masses.pdf}
}


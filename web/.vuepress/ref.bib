@article{yarnoz$aG$Families2015,
  title = {On the \$a a and g\$ g Families of Orbits in the Hill Problem with Solar Radiation Pressure and Their Application to Asteroid Orbiters},
  author = {Yarnoz, DG Yarnoz Daniel Garcia and Scheeres, DJ Scheeres Daniel J. and McInnes, CR McInnes Colin R.},
  year = 2015,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {Vol.121},
  number = {No.4},
  pages = {365--384},
  doi = {10.1007/s10569-015-9604-9},
  abstract = {The focus of this paper is on the exploration of the \$a a and g g - g' g {$\prime$} families of planar symmetric periodic orbits around minor bodies under the effect of solar radiation pressure (SRP). An extended Hill problem with SRP allows the study of spacecraft trajectories in the vicinity of asteroids orbiting the Sun. The evolution of the a a and g g - g'\$ g {$\prime$} families is presented with SRP increasing from the classical Hill problem to levels characteristic of current and future planned missions to minor bodies, as well as one extreme case with very large SRP for a small asteroid. In addition, the implications of considering a spherical body are analysed, in terms of trajectories colliding with the asteroid and eclipses, which limits the feasibility of various family branches. Finally, the influence of SRP on the linear stability of feasible orbits is calculated.},
  langid = {english},
  keywords = {Asteroid exploration missions,Asteroids dynamics,Distant retrograde orbits,Henon's families,Hill problem,Periodic orbits,Solar radiation pressure},
  annotation = {titleTranslation: 论太阳辐射压力下希尔问题中的 \$a a\$ 与 \$g\$ 族轨道及其在小行星环绕航天器中的应用\\
abstractTranslation: 本文聚焦于研究在太阳辐射压（SRP）影响下，围绕小天体的平面对称周期轨道中的\$a a\$族和\$g g - g' g {$\prime\$$}族。通过引入带SRP的扩展希尔问题，可以研究绕太阳运行的小行星附近航天器的轨迹。文中展示了\$a a\$族和\$g g - g' g {$\prime\$$}族在SRP从经典希尔问题逐渐增强至当前及未来计划中小天体任务的特征水平，以及一个针对小行星的极大SRP极端情况下的演化过程。此外，还分析了考虑球形天体对轨迹与天体碰撞及星食现象的影响，这限制了各轨道分支的可行性。最后，计算了SRP对可行轨道线性稳定性的影响。}
}


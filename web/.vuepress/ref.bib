@article{leiExtensionsBrownHamiltonian2025,
  title = {Extensions of Brown Hamiltonian -- {{II}}. {{Analytical}} Study on the Modified von Zeipel--Lidov--Kozai Effects},
  author = {Lei, Hanlun and Grishin, Evgeni},
  year = 2025,
  month = jul,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {541},
  number = {4},
  pages = {3198--3213},
  issn = {0035-8711, 1365-2966},
  doi = {10.1093/mnras/staf1171},
  urldate = {2026-05-11},
  abstract = {ABSTRACT             In triple systems of weak hierarchies, non-linear perturbations arising from the periodic oscillations associated with the inner and outer binaries play a crucial role in shaping their long-term dynamical evolution. In this context, we have developed an extended Brown Hamiltonian in Paper I, which serves as a fundamental model for describing the modified von Zeipel--Lidov--Kozai (ZLK) oscillations. This work aims to analyse the characteristics of ZLK oscillations within this extended framework, focusing on phase-space structures, the location of ZLK centre, the maximum eccentricity reached, the boundaries of librating cycles, and the critical inclination required to trigger ZLK resonance. Under the extended Hamiltonian, we introduce the Lidov integral \$C\_\textbraceleft\textbackslash rm ZLK\textbraceright\$, which is a combination of the Hamiltonian and the z-component of angular momentum, to characterize the modified ZLK properties. It is found that the librating and circulating cycles are separated by \$C\_\textbraceleft\textbackslash rm ZLK\textbraceright =0\$, which is consistent with the classical theory. Furthermore, we derive analytical expressions of these ZLK properties using perturbation techniques. Analytical predictions are compared to numerical results, showing an excellent agreement between them. Notably, the results reveal that ZLK characteristics in prograde and retrograde regimes are no longer symmetric under the influence of Brown corrections. At last, we conduct N-body integrations about millions of orbits to generate dynamical maps, where the numerical structures are well captured by the analytical solutions derived from the extended model.},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  langid = {english},
  annotation = {titleTranslation: 布朗哈密顿量的扩展------II. 修正的von Zeipel-Lidov-Kozai效应的解析研究\\
abstractTranslation: 摘要  \\
在弱层级三体系统中，内双星和外双星周期振荡引起的非线性扰动对其长期动力学演化起着关键作用。在此背景下，我们在论文I中构建了一个扩展的Brown哈密顿量，作为描述修正von Zeipel--Lidov--Kozai (ZLK)振荡的基本模型。本文旨在分析该扩展框架下ZLK振荡的特性，重点关注相空间结构、ZLK中心的位置、达到的最大偏心率、天平动周期的边界以及触发ZLK共振所需的临界倾角。在扩展哈密顿量下，我们引入了Lidov积分\$C\_\textbraceleft\textbackslash rm ZLK\textbraceright\$（即哈密顿量与角动量z分量的组合），以表征修正后的ZLK性质。研究发现，天平动周期和循环周期由\$C\_\textbraceleft\textbackslash rm ZLK\textbraceright =0\$分隔，这与经典理论一致。此外，我们利用微扰技术推导了这些ZLK特性的解析表达式。将解析预测与数值结果进行比较，两者吻合良好。值得注意的是，结果表明，在Brown修正的影响下，顺行与逆行区域的ZLK特性不再对称。最后，我们进行了数百万条轨道的N体积分以生成动力学图，扩展模型推导出的解析解很好地捕捉了数值结构。}
}


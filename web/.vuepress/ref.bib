@article{kholshevnikovReviewWorksOrbital2007,
  title = {Review of the Works on the Orbital Evolution of Solar System Major Planets},
  author = {Kholshevnikov, K. V. and Kuznetsov, E. D.},
  year = 2007,
  month = aug,
  journal = {Solar System Research},
  volume = {41},
  number = {4},
  pages = {265--300},
  issn = {0038-0946, 1608-3423},
  doi = {10.1134/S0038094607040016},
  urldate = {2025-11-27},
  abstract = {The cognition history of the basic laws of motion of Solar system major planets is presented. Before Newton, the description of motion was purely kinematic, without relying on physics in view of its underdevelopment. From the standpoint of the modern mathematical theory of approximation, all of the models from Ptolemy's predecessors to Kepler inclusive differ only in details. The mathematical theory worked on an infinite time scale; the motion was represented by P. Bohl's quasi-periodic functions (a special case of H. Bohr's quasi-periodic functions). After Newton, the mathematical description of motion came to be based on physical principles and took the form of ordinary differential equations. The advent of General Relativity (GR) and other relativistic theories of gravitation in the 20th century changed little the mathematical situation in the field under consideration. Indeed, the GR effects in the Solar system are so small that the post-post-Newtonian approximation is sufficient. Therefore, the mathematical description using ordinary differential equations is retained. Moreover, the Lagrangian and Hamiltonian forms of the equations are retained. From the 18th century until the mid-20th century, all the theories of planetary motion needed for practice were constructed analytically by the small parameter method. In the early 20th century, Lyapunov and Poincar\'e established the convergence of the corresponding series for a sufficiently small time interval. Subsequently, K. Kholshevnikov estimated this interval to be on the order of several tens of thousands of years, which is in agreement with numerical experiments. The first works describing analytically (in the first approximation) the evolution on cosmogonic time scales appeared in the first half of the 19th century (Laplace, Lagrange, Gauss, Poisson). The averaging method was developed in the early 20th century based on these works. Powerful analytical and numerical methods that have allowed us to make significant progress in describing the orbital evolution of Solar system major planets appeared in the second half of the 20th century. This paper is devoted to their description.},
  copyright = {http://www.springer.com/tdm},
  langid = {english},
  annotation = {titleTranslation: 太阳系主要行星轨道演化研究述评\\
abstractTranslation: 本文介绍了太阳系大行星基本运动定律的认知历程。在牛顿之前，对运动的描述纯粹是运动学层面的，由于物理学尚未发展，因此不依赖于物理学原理。从现代数学逼近理论的角度看，从托勒密的前辈到开普勒的所有模型仅在细节上有所差异。该数学理论在无限时间尺度上成立；运动由P. Bohl的准周期函数（H. Bohr准周期函数的一个特例）表示。牛顿之后，对运动的数学描述开始基于物理原理，并以常微分方程的形式呈现。20世纪广义相对论及其他相对论性引力理论的出现，并未显著改变该领域数学描述的现状。事实上，太阳系中的广义相对论效应极其微小，后后牛顿近似已足够。因此，基于常微分方程的数学描述得以保留，且方程的拉格朗日形式与哈密顿形式亦得以延续。从18世纪至20世纪中期，所有实际所需的行星运动理论均采用小参数法以解析方式构建。20世纪初，Lyapunov与Poincar\'e证明了相应级数在足够小时的时间区间内的收敛性。随后，K. Kholshevnikov估计该区间约为数万年量级，这与数值实验结果相符。最早在宇宙时间尺度上描述轨道演化（一阶近似）的解析工作出现于19世纪上半叶（Laplace、Lagrange、Gauss、Poisson）。基于这些工作，20世纪初发展出了平均法。20世纪下半叶，强大的解析与数值方法得以涌现，使我们在描述太阳系大行星轨道演化方面取得了显著进展。本文即致力于对这些方法进行阐述。},
  file = {/home/ouyangjiahong/Zotero/storage/ZL4U7Z8M/Kholshevnikov和Kuznetsov - 2007 - Review of the works on the orbital evolution of solar system major planets.pdf}
}


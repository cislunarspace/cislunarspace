@article{xuDeterminationDoublySymmetric2023,
  title = {Determination of the Doubly Symmetric Periodic Orbits in the Restricted Three-Body Problem and Hill's Lunar Problem},
  author = {Xu, Xingbo},
  year = 2023,
  month = apr,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {2},
  pages = {8},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10121-y},
  urldate = {2025-10-01},
  abstract = {We review some recent progress on the research of the periodic orbits of the N-body problem, and numerically study the spatial doubly symmetric periodic orbits (SDSPs for short). Both comet- and lunar-type SDSPs in the circular restricted three-body problem are computed, as well as the Hill-type SDSPs in Hill's lunar problem. Double symmetries are exploited so that the SDSPs can be computed efficiently. The monodromy matrix can be calculated by the information of one fourth period. The periodicity conditions are solved by Broyden's method with a line-search, and some numerical examples show that the scheme is very efficient. For a fixed period ratio and a given acute angle, there exist sixteen cases of initial values. For the restricted three-body problem, the cases of ``Copenhagen problem'' and the Sun--Jupiter--asteroid model are considered. New SDSPs are also numerically found in Hill's lunar problem. Though the period ratio should be small theoretically, some new periodic orbits are found when the ratio is not too small, and the linear stability of the searched SDSPs is numerically determined.},
  langid = {english},
  annotation = {titleTranslation: 限制性三体问题和Hill ' s月球问题中双对称周期轨道的确定。\\
abstractTranslation: 我们综述了N体问题周期轨道研究的一些最新进展，并对空间双对称周期轨道（简称SDSPs）进行了数值研究。计算了圆型限制性三体问题中的彗星型和月球型SDSPs，以及希尔月球问题中的希尔型SDSPs。利用双对称性，可以高效地计算SDSPs。单值矩阵可通过四分之一周期的信息计算得出。周期条件采用带线搜索的Broyden方法求解，数值算例表明该方案非常高效。对于固定的周期比和给定的锐角，存在十六种初始值情形。在限制性三体问题中，考虑了``哥本哈根问题''以及太阳-木星-小行星模型。在希尔月球问题中也数值发现了新的SDSPs。尽管理论上周期比应较小，但当比值并非很小时仍发现了若干新的周期轨道，并对所搜寻到的SDSPs的线性稳定性进行了数值判定。},
  file = {/home/ouyangjiahong/Zotero/storage/Z5LEUNGE/Xu - 2023 - Determination of the doubly symmetric periodic orbits in the restricted three-body problem and hill’.pdf}
}


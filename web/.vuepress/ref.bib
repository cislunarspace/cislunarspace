@article{dealmeidajuniorComparisonsCircularRestricted2022,
  title = {Comparisons between the Circular Restricted Three-Body and Bi-Circular Four Body Problems for Transfers between the Two Smaller Primaries},
  author = {{de Almeida Junior}, Allan Kardec and {de Almeida Prado}, Antonio Fernando Bertachini},
  year = 2022,
  month = mar,
  journal = {Scientific Reports},
  volume = {12},
  number = {1},
  pages = {4148},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-022-08046-x},
  urldate = {2026-02-04},
  abstract = {Important properties of the dynamics of a spacecraft can be obtained from the Circular Restricted Three Body Problem and the Bi-Circular Bi-planar Four Body Problem. In this work, both systems are compared under the perspective of the costs involved in a transfer between the smaller primaries. An analytical approach shows several properties of the perturbation due to the gravity of the Sun and the motion of the smaller primaries around it over a spacecraft in the region of interest, like its behavior at and around the barycenter or at any point in a circle around the Sun. The costs involved in transfers between the smaller primaries are numerically evaluated and analyzed using the newly developed Theory of Functional Connections. The results show that the influence of this perturbation over the costs is significant for systems like the Sun--Earth--Moon or Sun--Mars--Phobos. On the other hand, it is also shown that this influence may be negligible for other very different systems, like the Sun--Saturn--Titan or Sun--Ida--Dactyl. Maps of perturbation are drawn in the region of interest, which can be used for mission designers. Finally, a new approach to describe the influence of the Sun over the tides of the smaller primaries is proposed under the Four Body Problem model.},
  copyright = {2022 The Author(s)},
  langid = {english},
  keywords = {Astronomy and astrophysics,Astronomy and planetary science,Engineering,Planetary science,Space physics},
  annotation = {titleTranslation: 圆形限制性三体问题与双圆形四体问题在双小主天体间转移轨道的对比研究\\
abstractTranslation: 从圆形限制性三体问题和双圆双平面四体问题中，可以获取航天器动力学的重要特性。本文从较小主星之间转移成本的视角，对两种系统进行了比较。解析方法揭示了太阳引力及较小主星绕太阳运动对目标区域航天器产生的若干摄动特性，例如在质心及其附近、或绕太阳圆周上任意点的行为。利用新开发的函数连接理论，对较小主星之间的转移成本进行了数值评估与分析。结果表明，对于太阳-地球-月球或太阳-火星-火卫一这类系统，该摄动对成本的影响显著。另一方面，对于其他截然不同的系统，如太阳-土星-土卫六或太阳-Ida-Dactyl，这种影响可能可以忽略。绘制了目标区域的摄动图，可供任务设计人员使用。最后，在四体问题模型下提出了一种描述太阳对较小主星潮汐影响的新方法},
  file = {/home/ouyangjiahong/Zotero/storage/LWKPAJBQ/de Almeida Junior和de Almeida Prado - 2022 - Comparisons between the circular restricted three-body and bi-circular four body problems for transf.pdf}
}


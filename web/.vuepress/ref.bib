@article{gregoryEnergyoptimalTrajectoryPlanning2013,
  title = {Energy-Optimal Trajectory Planning for the Pendubot and the Acrobot},
  author = {Gregory, John and Olivares, Alberto and Staffetti, Ernesto},
  year = 2013,
  journal = {Optimal Control Applications and Methods},
  volume = {34},
  number = {3},
  pages = {275--295},
  publisher = {Wiley Online Library},
  doi = {10.1002/oca.2020},
  abstract = {In this paper, we study the trajectory-planning problem for planar underactuated robot manipulators with two revolute joints in the presence of gravity. This problem is studied as an optimal control problem. We consider both possible models of planar underactuated robot manipulators, namely with the elbow joint not actuated, called Pendubot, and with the shoulder joint not actuated, called Acrobot. Our method consists of a numerical resolution of a reformulation of the optimal control problem, as an unconstrained calculus of variations problem, in which the dynamic equations of the mechanical system are regarded as constraints and treated by means of special derivative multipliers. We solve the resulting calculus of variations problem by using a numerical approach based on the Euler--Lagrange necessary condition in integral form. In which, time is discretized, and admissible variations for each variable are approximated using a linear combination of the piecewise continuous basis functions of time. In this way, a general method for the solution of optimal control problems with constraints is obtained, which, in particular, can deal with nonintegrable differential constraints arising from the dynamic models of underactuated planar robot manipulators with two revolute joints in the presence of gravity.},
  langid = {english},
  annotation = {titleTranslation: 摆杆机器人和倒立摆机器人的能量最优轨迹规划\\
abstractTranslation: 本文研究了重力作用下具有两个转动关节的平面欠驱动机器臂的轨迹规划问题。将该问题作为最优控制问题来处理。我们考虑了平面欠驱动机器臂的两种可能模型：肘关节未驱动的模型（称为Pendubot）以及肩关节未驱动的模型（称为Acrobot）。我们的方法包括对最优控制问题重新表述后进行数值求解，将其转化为无约束的变分问题，其中机械系统的动力学方程被视为约束，并通过特殊的导数乘子进行处理。我们采用基于积分形式的欧拉-拉格朗日必要条件的数值方法求解所得的变分问题。在该方法中，时间被离散化，每个变量的容许变分通过分段连续时间基函数的线性组合来近似。由此，得到了一种求解带有约束的最优控制问题的通用方法。特别地，该方法能够处理由重力作用下具有两个转动关节的欠驱动平面机器臂动力学模型导出的非可积微分约束},
  file = {/home/ouyangjiahong/Zotero/storage/9Y9QQV74/Gregory 等 - 2013 - Energy-optimal trajectory planning for the pendubot and the acrobot.pdf}
}


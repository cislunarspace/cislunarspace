@article{henrardPeriodicOrbitsEmanating1970,
  title = {Periodic Orbits Emanating from a Resonant Equilibrium},
  author = {Henrard, Jacques},
  year = 1970,
  month = sep,
  journal = {Celestial Mechanics},
  volume = {1},
  number = {3-4},
  pages = {437--466},
  issn = {0008-8714, 1572-9478},
  doi = {10.1007/BF01231143},
  urldate = {2025-11-25},
  abstract = {For a conservative Hamiltonian system with two degrees of freedom, in the case where the two frequencies at an equilibrium of the elliptic type are commensurable or close to being so, completely canonical transformations can be formally constructed in explicit terms under the form of Lie transforms to the effect that it renders one angle coordinate ignorable and gives to the transformed Hamiltonian the form of what Garfinkel calls an ideal problem of resonance. For the problem so reduced, the unnormalized residual being omitted, natural families of periodic orbits are analyzed, their emergence from the equilibrium is discussed as well as their characteristic exponents. Special attention is given to the evolution of the system of natural families under a continuous transition through the resonance band.},
  copyright = {http://www.springer.com/tdm},
  langid = {english},
  annotation = {titleTranslation: 源自共振平衡点的周期轨道\\
abstractTranslation: 对于一个具有两个自由度的保守哈密顿系统，当椭圆型平衡点的两个频率可公度或接近可公度时，可以显式地构造完全正则变换，其形式为李变换，使得其中一个角坐标变为可忽略，并将变换后的哈密顿量化为Garfinkel所称的理想共振问题形式。对于如此简化后的问题（忽略非正则化的残差），分析了周期轨道的自然族，讨论了它们从平衡点的涌现过程及其特征指数。特别关注了在连续穿过共振带的过程中，自然族系统的演化。},
  file = {/home/ouyangjiahong/Zotero/storage/ZHKJ3V9D/Henrard - 1970 - Periodic orbits emanating from a resonant equilibrium.pdf}
}


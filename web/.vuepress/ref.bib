@article{aoStationkeepingStrategiesClose2024,
  title = {Stationkeeping Strategies for Close Formation Flight on Distant Retrograde Orbits},
  author = {Ao, Haiyue and Yang, Chihang and Shi, Yu and Zhang, Hao},
  year = 2024,
  journal = {Hangkong Xuebao/Acta Aeronautica Et Astronautica Sinica},
  volume = {Vol.45},
  number = {No.22},
  abstract = {Distant Retrograde Orbit（DRO）is a family of large-scale，lunar-retrograde periodic orbits in the cislunar space. Due to its advantages of long-term stability and low-energy transfer，DRO has become a potential orbit for many cislunar space missions. Investigating close formation techniques on DRO is of great significance for cislunar on-orbit servicing. Considering navigation and execution errors，it is essential to study the uncertainty propagation of close relative motion on DRO and design stationkeeping strategies. The fundamental solution set of linearized relative motion on DRO obtained through the Floquet theory is introduced. Based on periodic solutions，analyses of sensitivity and safety uncertainty propagation of DRO formation flight are conducted using the Cauchy-Green tensor and unscented transformation，respectively. Based on these analyses and considering engineering constraints，it is found that keeping the maneuver frequency of 2 times per cycle and the maneuver locations at two perilunes is the near-optimal stationkeeping scheme. Following this，two stationkeeping algorithms are proposed based on the concepts of relative trajectory following and absolute phase bias. The simulation results show that both stationkeeping algorithms can ensure long-term safety and reasonable configuration of DRO close formation flight.},
  langid = {english},
  keywords = {circular restricted three-body problem,distant retrograde orbit (DRO),relative motion,station keeping,uncertainty propagation},
  annotation = {titleTranslation: 远距离逆行轨道上紧密编队飞行的位置保持策略\\
abstractTranslation: 远距离逆行轨道（DRO）是地月空间中的一族大规模、月球逆行周期轨道。凭借其长期稳定性与低能量转移的优势，DRO已成为多项地月空间任务的潜在轨道选择。研究DRO上的近距离编队技术对地月在轨服务具有重要意义。考虑到导航与执行误差，有必要分析DRO近距离相对运动的不确定性传播，并设计相应的站位保持策略。本文引入了基于Floquet理论得到的DRO线性化相对运动基本解集，并利用Cauchy-Green张量和无迹变换分别对DRO编队飞行的敏感性与安全性不确定性传播进行了分析。基于上述分析并结合工程约束，研究发现，每周期两次机动且机动位置位于两个近月点的方案接近最优站位保持策略。据此，进一步提出了基于相对轨迹跟踪和绝对相位偏差的两种站位保持算法。仿真结果表明，这两种算法均能保证DRO近距离编队飞行的长期安全性与构型合理性。}
}


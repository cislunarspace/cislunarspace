@inproceedings{jonesPhysicsinformedDomainSplitting2024,
  title = {Physics-Informed Domain Splitting for Orbit Uncertainty Propagation},
  booktitle = {{{AIAA SCITECH}} 2024 {{Forum}}},
  author = {Jones, B. A.},
  year = 2024,
  address = {Orlando, FL, USA},
  doi = {10.2514/6.2024-0203},
  abstract = {Uncertainty quantification in the presence of highly perturbed environments, such as in the context of the n-body problem, requires adaptive methods that maintain tractability while producing accurate density function prediction. Polynomial chaos expansions are a response surface quantifying the effect of the system's random inputs on the the quantities of interest, which provides knowledge of the propagated uncertainty. The multi-element polynomial chaos approach adaptively segments the domain of random inputs to maintain accuracy in scenarios where a global expansion requires an undesirable order, and have been successfully demonstrated in several astrodynamics scenarios in the context of n-body dynamics. To mitigate the increased computation cost that comes with domain segmentation, this paper presents an approach that redefines the space of random inputs using knowledge of the local, physics-derived dynamic sensitivities. This adaptation reduces the number of elements required in the expansion to achieve accuracy comparable to the non-adaptive approach, which is demonstrated for a near-rectilinear halo orbit and a lunar flyby. This work also proposes a related method for uncertainty propagation that combines Gaussian mixture methods with the principles of this new multi-element approach. The comparison demonstrates that the pure multi-element polynomial chaos approach yields the most efficient and accurate solution in the scenarios considered.},
  langid = {english},
  annotation = {titleTranslation: 基于物理信息的轨道不确定度传播域分割方法}
}

@inproceedings{joonhyungparkMissAnalysisLambert2000,

@inproceedings{pengQuasisolarSynchronousOrbit2023,
  title = {Quasi-Solar Synchronous Orbit around the Moon Based on Spatial Distant Retrograde Orbits},
  booktitle = {74th {{International Astronautical Congress}}, {{IAC}} 2023},
  author = {Peng, Lei and Liang, Yuying and Pushparaj, Nishanth and Shi, Peng},
  year = 2023,
  series = {74th {{International Astronautical Congress}}, {{IAC}} 2023},
  address = {Baku, Azerbaijan},
  abstract = {The last several decades have witnessed the rapid development of lunar exploration, promoting research on various types of lunar orbits including Distant Retrograde Orbits (DRO) that are feasible for orbiting tasks due to their stability. Many applications of DROs have been proposed in recent missions. This research proposes a new concept of quasi-solar synchronous orbit (QSSO) based on the spatial DROs in the multi-perturbed circular restricted three-body problem (CR3BP), including solar gravity, Moon's J2 and lunar obliquity. Different from the classic solar synchronous orbit, the QSSOs are then defined as those spatial (quasi-)DROs that own total lighting time larger than 95\% of its period with shadow intervals generally shorter than 150 minutes. Families of 3D-DROs are computed through bifurcation from the planar DROs, with each period-multiplying family of DROs having separate primary and secondary branches. The solution map is illustrated based on the archive of DRO families. Employing the planetary shadow model, the sunlight conditions of all the DRO members are simulated and the impact of z-amplitude is assessed, revealing that spatial DROs possess significant sunlight advantages over planar DROs. The distribution of QSSOs is then demonstrated by the indicator designed, comparing the sunlight conditions of different DRO families. Furthermore, the impact of the initial solar phase angle is explored by means of massive simulation, aiming to emphasize the importance of launch window selection in practical missions. The results would be important to better understand the sunlight condition of cislunar orbits and provide a guideline for the more financial trajectory and operation design in the Earth-Moon system.},
  langid = {english},
  keywords = {Bifurcation,Circular restricted three-body problem,Distant retrograde orbits,Quasi-solar synchronous orbit,Sunlight conditions},
  annotation = {titleTranslation: 基于空间远距离逆行轨道的月球准太阳同步轨道}
}


@article{huangli-lianSynchronizationFractionalOrder2013,
  title = {The Synchronization of Fractional Order Chaotic Systems with Different Orders Based on Adaptive Sliding Mode Control},
  author = {{Huang Li-Lian} and {Qi Xue} and {College of Information and Communication Engineering, Harbin Engineering University,Harbin 150001, China}},
  year = 2013,
  journal = {Acta Physica Sinica},
  volume = {62},
  number = {8},
  pages = {080507},
  issn = {1000-3290, 1000-3290},
  doi = {10.7498/aps.62.080507},
  urldate = {2025-10-15},
  abstract = {In this paper, based on sliding mode control and adaptive control theory, the synchronization of two different fractional order chaotic systems is investigated. First, a fractional sliding surface with strong robustness is designed and a suitable adaptive sliding controller is constructed, then the error states of the systems are controlled to the sliding surface via the method to guarantee the synchronized behaviors between two fractional chaotic systems. Numerical simulations on the hyper Chen chaotic systems and Chen chaotic system are also carried out respectively. Simulation results show that the generalized errors tend to zero after a short time, and the effectiveness and feasibility of this method are well verified.},
  langid = {english},
  annotation = {titleTranslation: 基于自适应滑模控制的异阶分数阶混沌系统同步\\
abstractTranslation: 本文基于滑模控制与自适应控制理论，研究了两个不同分数阶混沌系统的同步问题。首先，设计了一个具有强鲁棒性的分数阶滑模面，并构建了合适的自适应滑模控制器；随后，通过该方法将系统误差状态驱动至滑模面，从而保证两个分数阶混沌系统之间的同步行为。分别对超Chen混沌系统与Chen混沌系统进行了数值仿真。仿真结果表明，广义误差在短时间内趋于零，充分验证了该方法的有效性与可行性。},
  file = {/home/ouyangjiahong/Zotero/storage/YFH94YZ6/Huang Li-Lian 等 - 2013 - The synchronization of fractional order chaotic systems with different orders based on adaptive slid.pdf}
}


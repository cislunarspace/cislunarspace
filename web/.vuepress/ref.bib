@article{kolNaturalDynamicalReduction2023,
  title = {Natural Dynamical Reduction of the Three-Body Problem},
  author = {Kol, Barak},
  year = 2023,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {3},
  pages = {29},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10144-5},
  urldate = {2025-10-01},
  abstract = {The three-body problem is a fundamental long-standing open problem, with applications in all branches of physics, including astrophysics, nuclear physics and particle physics. In general, conserved quantities allow to reduce the formulation of a mechanical problem to fewer degrees of freedom, a process known as dynamical reduction. However, extant reductions are either non-general, or hide the problem's symmetry or include unexplained definitions. This paper presents a general and natural dynamical reduction, which avoids these issues. Any three-body configuration defines a triangle, and its orientation in space. Accordingly, we decompose the dynamical variables into the geometry (shape + size) and orientation of the triangle. The geometry variables are shown to describe the motion of an abstract point in a curved 3d space, subject to a potential-derived force and a magnetic-like force with a monopole charge. The orientation variables are shown to obey a dynamics analogous to the Euler equations for a rotating rigid body; only here the moments of inertia depend on the geometry variables, rather than being constant. The reduction rests on a novel symmetric solution to the center of mass constraint inspired by Lagrange's solution to the cubic. The formulation of the orientation variables is novel and rests on a partially known generalization of the Euler--Lagrange equations to non-coordinate velocities. Applications to global features, to the statistical solution, to special exact solutions and to economized simulations are presented. A generalization to the four-body problem is presented.},
  langid = {english},
  annotation = {titleTranslation: 三体问题的自然动力学约化。\\
abstractTranslation: 三体问题是一个基本且长期悬而未决的难题，其在物理学的各个分支中均有应用，包括天体物理学、核物理学和粒子物理学。通常，守恒量允许将力学问题的表述约化至更少的自由度，这一过程称为动力学约化。然而，现有的约化方法要么不具普适性，要么掩盖了问题的对称性，要么包含未加解释的定义。本文提出了一种普遍且自然的动力学约化，避免了这些问题。任意三体构型均可定义一个三角形及其在空间中的朝向。据此，我们将动力学变量分解为三角形的几何（形状+尺寸）和朝向。几何变量描述了一个抽象点在弯曲三维空间中的运动，该点受到势衍生力与带有磁单极荷的类磁力的作用。朝向变量则遵循类似于刚体旋转的欧拉方程动力学；区别在于，此处的转动惯量依赖于几何变量而非恒定。该约化基于一种受拉格朗日三次方程解启发而得出的质心约束的新型对称解。朝向变量的表述是新颖的，其依赖于对欧拉-拉格朗日方程在非坐标速度下的部分已知推广。本文还展示了该方法在全局特征、统计解、特殊精确解以及高效仿真中的应用，并给出了向四体问题的推广。},
  file = {/home/ouyangjiahong/Zotero/storage/8767MWD7/Kol - 2023 - Natural dynamical reduction of the three-body problem.pdf}
}


@article{choiDesignDeepSpace2022,
  title = {Design of Deep Space Missions Using a Dedicated Small Launch Vehicle},
  author = {Choi, Su-Jin and Loucks, Mike and West, Stephen and Seo, Daeban and Lee, Keejoo},
  year = 2022,
  journal = {Journal of the Korean Society for Aeronautical and Space Sciences},
  volume = {Vol.50},
  number = {No.12},
  pages = {877--888},
  issn = {1225-1348},
  doi = {10.5139/JKSAS.2022.50.12.877},
  abstract = {Recently, as the CAPSTONE, a precursor mission for Lunar Gateway, was launched on a small launch vehicle for the purpose of demonstrating communications and navigation technology in the NRHO, large attention was brought to this event that enabled high-impact deep space mission using dedicated small launch vehicle and small spacecraft. In this study, we introduced the concept of a dual launch operation and examined the capability of the new concept in the exploration of the Moon, Mars and asteroid. It turned out a single launch is sufficient for the lunar low orbit mission up to around 247 kg, and the dual launch option can transport 215 kg and 183 kg to nearby destinations as such as Mars and astroid Apophis respectively.},
  langid = {english},
  keywords = {Dedicated Small Launch Vehicle,Deep Space Mission,Mission Diversification,Single/Dual Launch},
  annotation = {titleTranslation: 使用专用小型运载火箭的深空任务设计\\
abstractTranslation: 最近，作为月球门户的前驱任务，CAPSTONE 搭乘小型运载火箭发射升空，旨在近直线晕轨道（NRHO）演示通信与导航技术。这一事件引起了广泛关注，因为它展示了利用专用小型运载火箭和小型航天器执行高影响力的深空任务的能力。在本研究中，我们引入了一种双发射操作概念，并考察了这一新概念在月球、火星及小行星探测中的潜力。结果表明，针对月球低轨道任务，单次发射足以支持约247公斤的有效载荷；而双发射方案则能将215公斤和183公斤的有效载荷分别送往火星及小行星阿波菲斯等近地目标}
}

@article{choiGeostationaryOrbitTransfer2021,
  title = {Geostationary Orbit Transfer with Lunar Gravity Assist from Non-Equatorial Launch Site},
  author = {Choi, Su-Jin and Carrico, John and Loucks, Mike and Lee, Hoonhee and Kwon, Sejin},
  year = 2021,
  month = dec,
  journal = {Journal of Astronautical Sciences},
  volume = {68},
  number = {4},
  pages = {1014--1033},
  issn = {0021-9142, 2195-0571},
  doi = {10.1007/s40295-021-00279-8},
  urldate = {2025-11-27},
  abstract = {We show that it is possible to launch a satellite to Geostationary Equatorial orbit (GEO) from the non-equatorial launch site (Naro Space Center in South Korea) even though that is located in the mid-latitudes of the northern hemisphere. When launched from this site, the equatorial inclination after separation will be 80{$^\circ$}. We use a lunar gravity assist (LGA) transfer to avoid the excessive ∆V costs of plane change maneuvers. There are eight possible paths for the LGA; there are four paths consisting of Earth departures and free-return types, and there are two nodes of the Moon's orbit (ascending and descending). We analyze trajectories over five launch periods for each path using a high-fidelity orbit propagation model. We show that the LGA changes the orbital energy of the ``cislunar'' free-returns more than for the ``circumlunar'' free-returns, resulting in less geostationary insertion ∆V for the cislunar free-returns. We also show that the geometrical ∆V variation over the different paths is greater than the seasonal ∆V variation. Our results indicate that an ascending departure and cislunar free-return at the descending node have lower ∆V requirements than the other paths, and lower than described in several previous studies.},
  langid = {english},
  annotation = {titleTranslation: 非赤道发射场借助月球引力辅助的地球静止轨道转移\\
abstractTranslation: 我们证明，从位于北半球中纬度的非赤道发射场（韩国罗老航天中心）发射卫星至地球静止赤道轨道（GEO）是可行的。从该场地发射后，分离后的赤道倾角将为80{$^\circ$}。我们采用月球引力辅助（LGA）转移以避免轨道面机动所需的过大∆V成本。LGA共有八条可能路径；其中四条路径包含地球出发与自由返回类型，月球轨道有两个节点（升交点和降交点）。我们利用高保真轨道传播模型，针对每条路径分析了五个发射窗口的轨迹。结果表明，LGA对``地月间''自由返回轨道能量的改变大于``环月''自由返回，从而使地月间自由返回的地球静止轨道入轨∆V更小。我们还发现，不同路径之间的几何∆V变化大于季节性∆V变化。我们的研究指出，升交点出发与降交点的地月间自由返回所需的∆V低于其他路径，且低于先前多项研究中的描述。},
  file = {/home/ouyangjiahong/Zotero/storage/ISC47EDN/Choi 等 - 2021 - Geostationary orbit transfer with lunar gravity assist from non-equatorial launch site.pdf}
}


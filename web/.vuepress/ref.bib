@article{huangAnalysisCislunarDRO2024,
  title = {Analysis of Cislunar {{DRO}} Orbit Determination Accuracy Using Earth-Based Simulated Observations},
  author = {Huang, Yidan and Huang, Yong and Fan, Min and Li, Peijia},
  year = 2024,
  journal = {Journal of Deep Space Exploration},
  volume = {Vol.11},
  number = {No.4},
  pages = {405--413},
  abstract = {Based on the existing tracking and measuring conditions of China's deep space exploration missions, the orbit determination accuracy of the DRO probe was simulated and analyzed. For the Cislunar space DRO exploration, the simulation adopted batch processing orbit determination method, selected celestial bodies centered on the Earth for orbit integration, and increased non-spherical gravitational perturbation of the moon. Under the current measurement conditions, the position and velocity accuracy of 2-day short-arc orbit determination using only range tracking data were the order of km and better than 3 cm/s respectively; for 7-day predictions, the maximum differences in the position and velocity are the order of ten kilometers and 6 cm/s respectively. When using ranging data combined with VLBI data, the position and velocity accuracy were the order of hundreds of meters and less than 0.4 cm/s respectively; for 7-day predictions, the maximum differences in the position and velocity were the order of kilometers and 2 cm/s respectively, which shows that VLBI data significantly improved the accuracy of short-arc orbit determination and prediction. Moreover, the position and velocity accuracy were better than 1 km and 1cm/s respectively when using 5-day long-arc range tracking data. For 7-day predictions, the maximum differences in the position and velocity were less than 2 km and 1cm/s respectively. This shows that an increase of ranging data significantly contributes to the accuracy of orbit determination and prediction for DRO.},
  langid = {english},
  keywords = {cislunar,Distant Retrograde Orbit (DRO),orbit determination,orbit prediction,Very Long Baseline Interferometry (VLBI)},
  annotation = {titleTranslation: 基于地基模拟观测的地月DRO定轨精度分析\\
abstractTranslation: 基于我国现有深空探测任务的跟踪测量条件，对DRO探测器的定轨精度进行了仿真分析。针对地月空间DRO探测，仿真采用批处理定轨方法，选择以地球为中心的星体进行轨道积分，并增加了月球非球形引力摄动。在当前测量条件下，仅使用测距数据进行2天短弧定轨的位置和速度精度分别为公里量级和优于3 cm/s；对于7天预报，位置和速度的最大偏差分别为十公里量级和6 cm/s。当使用测距数据结合VLBI数据时，位置和速度精度分别为百米量级和小于0.4 cm/s；对于7天预报，位置和速度的最大偏差分别为公里量级和2 cm/s，这表明VLBI数据显著提高了短弧定轨和预报的精度。此外，使用5天长弧测距数据时，位置和速度精度均优于1 km和1 cm/s。对于7天预报，位置和速度的最大偏差分别小于2 km和1 cm/s。这表明测距数据的增加对DRO探测器定轨和预报精度的提升有显著贡献。},
  file = {/home/ouyangjiahong/Zotero/storage/RJHQNU5N/Huang 等 - 2024 - Analysis of cislunar DRO orbit determination accuracy using earth-based simulated observations.pdf}
}


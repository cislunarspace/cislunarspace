@article{qiDetectionSystemEarth2023,
  title = {Detection System of near Earth Objects Based on the Axial Orbit in the Sun--Earth Circular Restricted Three-Body Problem},
  author = {Qi, Yi and Tang, Yuhua and Qiao, Dong and Li, Xiangyu and Ding, Ying},
  year = 2023,
  journal = {Acta Astronautica},
  volume = {Vol.208},
  number = {No.0},
  pages = {155--166},
  doi = {10.1016/j.actaastro.2023.04.013},
  abstract = {L 4 and L 5 axial orbits provide special locations to monitor and search for near Earth objects (NEOs) due to their offset locations. In this paper, we propose a detection system of NEOs on the axial orbit in the Sun--Earth circular restricted three-body problem. Taking the Sun exclusion zone into consideration, we design an observation strategy for space-based telescopes on axial orbits. Then, an observation accessibility measure for the motionless point is presented to evaluate the performances of the different axial orbits and formations. In addition, the detection performance of axial orbits is compared with the distant retrograde orbits (DROs) and Earth-displaced heliocentric orbits (EDHOs). Numerical simulations indicate that the detection performance of axial orbits for the motionless point is better than that of DROs but is inferior to EDHOs. On the other hand, the axial orbit is dynamical stable, but EDHOs are unstable and their fuel costs for maintenance cannot be ignored with the increase of service time. Furthermore, the detection system on axial orbits is applied to moving objects. For example, the detection system of the EDHOs cannot predict the Chelyabinsk asteroid impact, but it is possible for the DRO and axial orbits. Numerical simulations for 4000 virtual NEOs indicate that due to a better observation geometry, the detection system of axial orbits can find more NEOs than those of the DRO and EDHOs.},
  langid = {english},
  keywords = {L-4},
  annotation = {titleTranslation: 基于日地圆形限制性三体问题轴向轨道的近地天体探测系统\\
abstractTranslation: L4和L5轴向轨道因其偏移位置，为监测和搜索近地天体（NEOs）提供了特殊位置。本文在日地圆型限制性三体问题中，提出了一种基于轴向轨道的近地天体探测系统。考虑太阳规避区，我们为轴向轨道上的天基望远镜设计了观测策略。随后，提出了一种针对静止点的观测可达性度量，以评估不同轴向轨道及编队的性能。此外，将轴向轨道的探测性能与远距离逆行轨道（DROs）及地球偏离日心轨道（EDHOs）进行了比较。数值仿真表明，轴向轨道对静止点的探测性能优于DROs，但劣于EDHOs。另一方面，轴向轨道具有动力学稳定性，而EDHOs不稳定，其维持燃料成本随服役时间增加不可忽略。进一步地，将轴向轨道上的探测系统应用于运动目标。例如，EDHOs探测系统无法预测车里雅宾斯克小行星撞击事件，但DRO和轴向轨道则可能实现。针对4000个虚拟近地天体的数值仿真表明，由于更优的观测几何，轴向轨道探测系统能发现比DRO和EDHOs更多的近地天体。}
}

@article{QiHaoJieKongJianShengWangZaiHeFeiLiXiangZhuaBuGaiLuFenXi2026,
  title = {{空间绳网载荷非理想抓捕概率分析}},
  author = {{齐浩杰} and {竺伟梁} and {郭甲} and {何举} and {庞兆君} and {杜忠华}},
  year = 2026,
  journal = {宇航学报},
  volume = {47},
  number = {1},
  pages = {210--221},
  urldate = {2026-05-19},
  abstract = {针对空间绳网发射过程中存在的随机扰动误差问题，开展系统研究以分析各随机误差对目标抓捕的影响。通过建立随机扰动误差的随机过程模型及误差分布模型，量化误差特性；提出空间绳网抓捕成功的判据标准，并结合蒙特卡洛方法构建误差叠加条件下的抓捕概率模型；针对方形绳网特性，分析其最佳抓捕距离范围。数值仿真结果显示，发射随机扰动误差会导致网面中心点偏移及绳网展开率降低；理想工况下抓捕距离范围更广，而误差叠加作用下最佳抓捕范围显著缩减，直接影响绳网抓捕能力与范围。所建立的误差分布模型与抓捕概率模型为绳网发射参数优化及设计提供了关键理论支撑，具有一定的工程应用价值。},
  langid = {chinese},
  annotation = {Fund: 国防科工局空间碎片与近地小卫星防御科研项目（KJSP2020010303）；},
  file = {/home/ouyangjiahong/Zotero/storage/8GX4UL9H/齐浩杰 等 - 2026 - 空间绳网载荷非理想抓捕概率分析.pdf}
}


@article{choiPerformanceAnalysisSensor2017,
  title = {Performance Analysis of Sensor Systems for Space Situational Awareness},
  author = {Choi, Eun-Jung and Cho, Sungki and Jo, Jung Hyun and Park, Jang-Hyun and Chung, Taejin and Park, Jaewoo and Jeon, Hocheol and Yun, Ami and Lee, Yonghui},
  year = 2017,
  month = dec,
  journal = {Journal of Astronomy and Space Sciences},
  volume = {34},
  number = {4},
  pages = {303--313},
  issn = {2093-5587, 2093-1409},
  doi = {10.5140/JASS.2017.34.4.303},
  urldate = {2025-11-25},
  abstract = {With increased human activity in space, the risk of re-entry and collision between space objects is constantly increasing. Hence, the need for space situational awareness (SSA) programs has been acknowledged by many experienced space agencies. Optical and radar sensors, which enable the surveillance and tracking of space objects, are the most important technical components of SSA systems. In particular, combinations of radar systems and optical sensor networks play an outstanding role in SSA programs. At present, Korea operates the optical wide field patrol network (OWL-Net), the only optical system for tracking space objects. However, due to their dependence on weather conditions and observation time, it is not reasonable to use optical systems alone for SSA initiatives, as they have limited operational availability. Therefore, the strategies for developing radar systems should be considered for an efficient SSA system using currently available technology. The purpose of this paper is to analyze the performance of a radar system in detecting and tracking space objects. With the radar system investigated, the minimum sensitivity is defined as detection of a 1-m2 radar cross section (RCS) at an altitude of 2,000 km, with operating frequencies in the L, S, C, X or Ku-band. The results of power budget analysis showed that the maximum detection range of 2,000 km, which includes the low earth orbit (LEO) environment, can be achieved with a transmission power of 900 kW, transmit and receive antenna gains of 40 dB and 43 dB, respectively, a pulse width of 2 ms, and a signal processing gain of 13.3 dB, at a frequency of 1.3 GHz. We defined the key parameters of the radar following a performance analysis of the system. This research can thus provide guidelines for the conceptual design of radar systems for national SSA initiatives.},
  langid = {english},
  annotation = {titleTranslation: 空间态势感知传感器系统性能分析\\
abstractTranslation: 随着人类在太空活动的增加，空间物体再入和碰撞的风险不断上升。因此，许多经验丰富的航天机构已认识到空间态势感知（SSA）项目的必要性。用于监视和跟踪空间物体的光学传感器和雷达传感器是SSA系统最关键的技术组成部分。特别是雷达系统与光学传感器网络的组合在SSA项目中发挥着突出作用。目前，韩国运营着光学广域巡逻网（OWL-Net），这是唯一用于跟踪空间物体的光学系统。然而，由于光学系统依赖于天气条件和观测时间，仅靠光学系统开展SSA项目并不合理，因为其运行可用性有限。因此，应考虑利用现有技术开发雷达系统的策略，以构建高效的SSA系统。本文旨在分析雷达系统在探测和跟踪空间物体方面的性能。所研究的雷达系统的最小灵敏度定义为：在2000公里高度下，能够探测到雷达散射截面积（RCS）为1平方米的目标，工作频段为L、S、C、X或Ku波段。功率预算分析结果表明，在1.3 GHz频率下，采用900 kW发射功率、40 dB发射天线增益和43 dB接收天线增益、2 ms脉冲宽度以及13.3 dB信号处理增益，可实现包含低地球轨道（LEO）环境在内的2000公里最大探测距离。在系统性能分析之后，我们确定了雷达的关键参数。因此，本研究可为国家SSA项目中雷达系统的概念设计提供指导},
  file = {/home/ouyangjiahong/Zotero/storage/CG2EH3Q5/Choi 等 - 2017 - Performance analysis of sensor systems for space situational awareness.pdf}
}

@article{choiPracticalFactorizationSchur2015,
  title = {A Practical Factorization of a Schur Complement for {{PDE-constrained}} Distributed Optimal Control},
  author = {Choi, Youngsoo and Farhat, Charbel and Murray, Walter and Saunders, Michael},
  year = 2015,
  month = nov,
  journal = {Journal of Scientific Computing},
  volume = {65},
  number = {2},
  pages = {576--597},
  issn = {0885-7474, 1573-7691},
  doi = {10.1007/s10915-014-9976-0},
  urldate = {2025-11-27},
  abstract = {A distributed optimal control problem with the constraint of a linear elliptic partial differential equation is considered. A necessary optimality condition for this problem forms a saddle point system, the efficient and accurate solution of which is crucial. A new factorization of the Schur complement for such a system is proposed and its characteristics discussed. The factorization introduces two complex factors that are complex conjugate to each other. The proposed solution methodology involves the application of a parallel linear domain decomposition solver---FETI-DPH---for the solution of the subproblems with the complex factors. Numerical properties of FETI-DPH in this context are demonstrated, including numerical and parallel scalability and regularization dependence. The new factorization can be used to solve Schur complement systems arising in both range-space and full-space formulations. In both cases, numerical results indicate that the complex factorization is promising. Especially, in the full-space method with the new factorization, the number of iterations required for convergence is independent of regularization parameter values.},
  langid = {english},
  annotation = {titleTranslation: 偏微分方程约束分布式最优控制中舒尔补的一种实用分解方法\\
abstractTranslation: 考虑一个受线性椭圆型偏微分方程约束的分布式最优控制问题。该问题的一个必要最优性条件形成一个鞍点系统，其高效精确求解至关重要。针对该系统的Schur补提出了一种新的分解方法，并讨论了其特性。该分解引入了两个互为复共轭的复因子。所提出的求解方法涉及使用并行线性区域分解求解器------FETI-DPH------来求解含复因子的子问题。文中展示了FETI-DPH在此背景下的数值特性，包括数值可扩展性、并行可扩展性及正则化依赖性。新的分解可用于求解范围空间和全空间两种形式中产生的Schur补系统。在这两种情况下，数值结果表明复分解具有前景。特别是在采用新分解的全空间方法中，收敛所需的迭代次数不依赖于正则化参数值。},
  file = {/home/ouyangjiahong/Zotero/storage/ZY2TKCNL/Choi 等 - 2015 - A practical factorization of a schur complement for PDE-constrained distributed optimal control.pdf}

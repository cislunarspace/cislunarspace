@article{YangZhuoJiYuMoHuTuiLiDeKongJianFeiHeZuoMuBiaoYiTuShiBieFangFa2025,
  title = {{基于模糊推理的空间非合作目标意图识别方法}},
  author = {{杨卓} and {师鹏} and {周韬} and {李文龙}},
  year = 2025,
  journal = {北京航空航天大学学报},

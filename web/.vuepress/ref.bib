@article{ZhengYueYiZhongJiSuanSanTiWenTiZhouQiGuiDaoDeXinFangFa2017,
  title = {一种计算三体问题周期轨道的新方法},
  author = {{郑越} and {泮斌峰} and {唐硕}},
  year = 2017,
  journal = {宇航学报},
  volume = {38},

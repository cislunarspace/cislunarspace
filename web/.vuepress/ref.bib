@article{daquinDetectionSeparatricesChaotic2023,
  title = {Detection of Separatrices and Chaotic Seas Based on Orbit Amplitudes},
  author = {Daquin, J{\'e}r{\^o}me and Charalambous, Carolina},
  year = 2023,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {3},
  pages = {31},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10143-6},
  urldate = {2025-10-01},
  abstract = {The maximum eccentricity method (MEM, (Dvorak et al. in Astron Astrophys 426(2):L37--L40, 2004)) is a standard tool for the analysis of planetary systems and their stability. The method amounts to estimating the maximal stretch of orbits over sampled domains of initial conditions. The present paper leverages on the MEM to introduce a sharp detector of separatrices and chaotic seas. After introducing the MEM analogue for nearly-integrable action-angle Hamiltonians, i.e., diameters, we use low-dimensional dynamical systems with multi-resonant modes and junctions, supporting chaotic motions, to recognise the drivers of the diameter metric. Once this is appreciated, we present a second-derivative-based index measuring the regularity of this application. This quantity turns to be a sensitive and robust indicator to detect separatrices, resonant webs and chaotic seas. We discuss practical applications of this framework in the context of N -body simulations for the planetary case affected by mean-motion resonances, and demonstrate the ability of the index to distinguish minute structures of the phase space, otherwise undetected with the original MEM.},
  langid = {english},
  annotation = {titleTranslation: 基于轨道振幅的分离线与混沌海检测\\
abstractTranslation: 最大偏心率方法（MEM，(Dvorak et al. in Astron Astrophys 426(2):L37--L40, 2004)）是分析行星系统及其稳定性的标准工具。该方法通过估计初始条件采样域内轨道的最大拉伸程度来工作。本文利用MEM引入了一种用于探测分界线与混沌海的敏锐检测器。在引入近可积作用-角哈密顿量的MEM类似物（即直径）后，我们利用支持混沌运动的多共振模态与交汇点的低维动力系统，来识别直径度量的驱动因素。认识到这一点后，我们提出了一种基于二阶导数的指标，用于衡量该应用的规则性。该量被证明是检测分界线、共振网与混沌海的灵敏且鲁棒的指示器。我们讨论了该框架在受到平均运动共振影响的行星N体模拟中的实际应用，并展示了该指标识别相空间细微结构的能力------这些结构在原始MEM下无法被检测到},
  file = {/home/ouyangjiahong/Zotero/storage/IFCQ3W47/Daquin和Charalambous - 2023 - Detection of separatrices and chaotic seas based on orbit amplitudes.pdf}
}


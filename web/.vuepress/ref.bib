@article{armellinAsteroidCloseEncounters2010,
  title = {Asteroid Close Encounters Characterization Using Differential Algebra: The Case of Apophis},
  shorttitle = {Asteroid Close Encounters Characterization Using Differential Algebra},
  author = {Armellin, R. and Di Lizia, P. and {Bernelli-Zazzera}, F. and Berz, M.},

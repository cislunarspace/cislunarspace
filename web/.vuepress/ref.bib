@article{pedros-fauraForcedPeriodicMotion2024,
  title = {Forced Periodic Motion by Solar Radiation Pressure in the Polyhedral Gravity Model},
  author = {{Pedros-Faura}, Anivid and Brown, Gavin M. and McMahon, Jay W. and Scheeres, Daniel J.},
  year = 2024,
  month = oct,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {5},
  pages = {34--59},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10206-2},
  urldate = {2025-10-01},
  abstract = {The exploration of small bodies in our solar system is of great interest for the planetary science community due to their high scientific value. However, their generally weak and irregular gravity fields increase the difficulty associated with close proximity operations. Moreover, solar radiation pressure (SRP) can significantly perturb the motion of objects in their vicinity, particularly for bodies with high area-to-mass ratios. In this work, we adopt the polyhedral gravity model and identify natural dynamical structures that can be used for mission operations. Further, we study forced periodic motion in the body fixed frame while accounting for the effect of SRP with eclipses. Overall, our work seeks to identify suitable orbits and locations in the vicinity of small bodies that can be exploited for the design of science orbits. To obtain periodic orbits in the model accounting for SRP perturbations, we use a Melnikov function to find orbits that satisfy resonances with the asteroid spin and show no net change in energy over the orbit. We then use a differential correction scheme to find numerical solutions in the time-periodic model. Our test cases are potentially hazardous asteroid 101955 Bennu and main belt asteroid 16 Psyche.},
  langid = {english},
  annotation = {titleTranslation: 在多面体重力模型中，受到太阳辐射压力的强迫做周期运动。\\
abstractTranslation: 太阳系小天体的探测因其极高的科学价值而备受行星科学界的关注。然而，这些天体普遍较弱的、不规则的引力场增加了近距离操作任务的难度。此外，太阳辐射压（SRP）会显著扰动其附近物体的运动，尤其对面积质量比高的天体影响更为明显。本研究采用多面体引力模型，识别可用于任务操作的自然动力学结构。进一步地，我们在考虑日食影响的SRP条件下，于天体固连坐标系中研究了受迫周期运动。总体而言，我们的工作旨在寻找小天体附近可用于科学轨道设计的合适轨道和位置。为在考虑SRP扰动的模型中获得周期轨道，我们使用Melnikov函数寻找与小行星自旋共振且轨道能量净变化为零的轨道，随后采用微分校正方案在时间周期模型中求解数值解。测试案例为潜在危险小行星101955 Bennu和主带小行星16 Psyche},
  file = {/home/ouyangjiahong/Zotero/storage/UWTN8Y6M/Pedros-Faura 等 - 2024 - Forced periodic motion by solar radiation pressure in the polyhedral gravity model.pdf}
}


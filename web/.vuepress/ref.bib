@inproceedings{condonMissionTrajectoryDesign2020,
  title = {Mission and Trajectory Design Considerations for a Human Lunar Mission Originating from a near Rectilinear Halo Orbit},
  booktitle = {{{AIAA SciTech Forum}} and {{Exposition}}},
  author = {Condon, Gerald L. and Esty, C. Clark and Berry, Christopher F. and Downs, Sean P. and Ocampo, Cesar and Mahajan, Bharat and Burke, Laura M.},
  year = 2020,
  series = {{{AIAA SciTech Forum}} and {{Exposition}}},
  address = {Orlando},
  abstract = {NASA's current Moon landing goal, consistent with Space Policy Directive 1 (Dec 2017) and the Vice President's announcement on March 26,2019 to "... return American astronauts to the Moon within the next five years", envisions a human mission to the lunar surface sometime in 2024. This project, since named the Artemis Program, employs a Gateway station in a Near Rectilinear Halo Orbit (NRHO) as a pressurized staging location for missions to other possible destinations (e.g., Mars Missions, Asteroids, Distant Retrograde Orbits, and others). Unlike Apollo, the Artemis Program endeavors to revisit the lunar surface in an evolutionary vs. expeditionary manner with an intention to "... establish a permanent base ...", incorporate spacecraft reusability and refueling, and assess impacts of global access. This report examines mission considerations involved in this NRHO Gateway based lunar landing approach, the associated mission design and performance cost, off-nominal and abort modes and their impacts on the system, and an examination of the trades among flight mechanics and spacecraft element design and sizing.},
  langid = {english},
  annotation = {titleTranslation: 从近直线晕轨道出发的载人月球任务之任务与轨道设计考量}
}

@article{conduracheExactSolutionRelative2009,
  title = {Exact Solution to the Relative Orbital Motion in Eccentric Orbits},
  author = {Condurache, D. and Martinu{\c s}i, V.},
  year = 2009,
  month = feb,
  journal = {Solar System Research},
  volume = {43},
  number = {1},
  pages = {41--52},
  issn = {0038-0946, 1608-3423},
  doi = {10.1134/S0038094609010043},
  urldate = {2025-11-27},
  abstract = {This paper studies the relative orbital motion between arbitrary Keplerian trajectories. A closedform vectorial solution to the nonlinear initial value problem that models this type of motion with respect to a noninertial reference frame is offered. Without imposing any particular conditions on the leader or the deputy satellites trajectories, exact expressions for the relative law of motion and relative velocity are obtained in a closed form. This solution allows the parameterization of the relative motion manifold and offers new methods to study its geometrical and topological properties. The result presented in this paper opens the way to obtain new classes of approximate solutions to the equations of relative motion with time, an eccentric or true anomaly as independent variables.},
  copyright = {http://www.springer.com/tdm},
  langid = {english},
  annotation = {titleTranslation: 偏心轨道相对运动的精确解\\
abstractTranslation: 本文研究了任意开普勒轨道之间的相对轨道运动问题。针对描述此类运动（相对于非惯性参考系）的非线性初值问题，本文提出了一种闭合形式的矢量解。在不为主星或从星卫星轨道施加任何特定条件的情况下，获得了相对运动规律和相对速度的精确闭合表达式。该解实现了对相对运动流形的参数化，并提供了研究其几何与拓扑性质的新方法。本文所呈现的结果为以时间、偏近点角或真近点角作为自变量，获得相对运动方程的新一类近似解开辟了道路。},
  file = {/home/ouyangjiahong/Zotero/storage/EPU6GLTG/Condurache和Martinuşi - 2009 - Exact solution to the relative orbital motion in eccentric orbits.pdf}
}


@phdthesis{hebenstreitDevelopmentMAGEAnomaly2024,
  title = {Development of {{MAGE}}: An Anomaly Management Tool for Assisting Spacecraft Operators},
  shorttitle = {Development of {{MAGE}}},
  author = {Hebenstreit, Aneliese},
  year = 2024,
  journal = {ProQuest Dissertations and Theses},
  abstract = {MAGE formalizes a largely informal and experience-led decision-making process in small satellite anomaly management. It is especially useful when only limited telemetry data is available or novice groups of engineers -- like small-satellite university programs -- encounter anomalies. These groups tend to be resource constrained in schedule, budget, and expertise. By leveraging hybrid model-based methods and logical reasoning, MAGE provides a structured, formalized, high-level approach to fault detection, diagnosis, and resolution that can be navigated effectively by both novice and experienced operators. This comprehensive method extends beyond traditional fault trees, addressing the limitations posed by incomplete information and the potential biases of past experiences. The classification of anomalies is especially useful for understanding and resolving them. A detailed demonstration of the MAGE algorithm is presented using an HVAC system model, followed by a case study on the CAPSTONE mission. The study illustrates the practical application and benefits of MAGE, showcasing its ability to work with abstract models and limited data. Thus, this tool enables novice teams to manage spacecraft anomalies and potentially save their missions from failure. MAGE's versatility and its integration of operator intent further enhances its utility, making it a valuable tool for ensuring the success and reliability of future space missions.},
  isbn = {979-8-3468-1246-3},
  langid = {english},
  keywords = {0537:Engineering,0538:Aerospace engineering,0548:Mechanical engineering,Aerospace engineering,Anomaly management,Engineering,Fault detection isolation and resolution,Mechanical engineering,Mission assurance,Model-based methods,Small satellites},
  annotation = {titleTranslation: MAGE开发：一款辅助航天器操作员的异常管理工具},
  file = {/home/ouyangjiahong/Zotero/storage/FDFP2JA2/Hebenstreit - 2024 - Development of MAGE an anomaly management tool for assisting spacecraft operators.pdf}
}


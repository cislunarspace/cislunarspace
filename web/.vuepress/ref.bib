@article{chaoExploringMoreSolutions2022,
  title = {Exploring More Solutions for Low-Energy Transfers to Lunar Distant Retrograde Orbits},
  author = {Chao, Peng and Zhang, Hao and Changxuan, Wen and Zhengfan, Zhu and Gao, Yang},
  year = 2022,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {Vol.134},
  number = {No.1},
  pages = {1--38},
  abstract = {This study aims to explore more solutions for low-energy transfers to lunar distant retrograde orbits (DROs) from the vicinity of the Earth. Millions of transfer trajectories from a lunar free-return orbit (LFO) to a prescribed DRO were computed using multiple powered lunar flybys (PLFs) and weak-stability-boundary (WSB)-like ballistic transfer. We proposed a two-step design method, consisting of a database creation and trajectory patching, to construct low-energy LFO--DRO transfers in planar bicircular restricted four-body dynamics with the Sun, Earth, and Moon as primary bodies. The parallel computation technique allows the computation of millions of solutions with times of flight (TOFs) up to 135 days and a total velocity impulse ({$\Delta$}V) of no more than 350 m/s, although this design method requires substantial computational load. These solutions help us identify key flight information, such as the {$\Delta$}V--TOF Pareto fronts and launch windows for rendezvous with a station in a DRO. Low-energy transfers to a DRO can be achieved by exploiting single or multiple PLFs and WSB-like ballistic arcs at the expense of elongated TOFs. Moreover, triple PLFs render many more options for the spacecraft to accomplish the rendezvous of DROs. The WSB-like ballistic arcs to a DRO in this study exhibit new features compared with conventional and traditional WSB concepts.},
  langid = {english},
  keywords = {DESIGN,QUASI-SALITE},
  annotation = {titleTranslation: 探索更多通往月球远距离逆行轨道的低能量转移方案\\
abstractTranslation: 本研究旨在探索从地球附近进入月球远距离逆行轨道（DRO）的低能转移方案。通过多次动力月球飞越（PLF）与类似弱稳定边界（WSB）的弹道转移，计算了从月球自由返回轨道（LFO）到指定DRO的数百万条转移轨迹。我们提出了一种两步设计方法，包括数据库构建与轨迹拼接，以在日-地-月作为主天体的平面双圆限制四体动力学中构建低能LFO--DRO转移。尽管该方法计算负荷较大，但借助并行计算技术，可计算数百万条飞行时间（TOF）不超过135天、总速度冲量（{$\Delta$}V）不大于350 m/s的转移方案。这些方案有助于识别关键飞行信息，例如{$\Delta$}V--TOF帕累托前沿以及与DRO空间站交会的发射窗口。利用单次或多次PLF以及类似WSB的弹道弧段可实现低能转移至DRO，但代价是飞行时间延长。此外，三次PLF为航天器完成DRO交会提供了更多选择。与常规及传统WSB概念相比，本研究中用于DRO的类似WSB弹道弧段展现出新的特征},
  file = {/home/ouyangjiahong/Zotero/storage/M96TZBRL/Chao 等 - 2022 - Exploring more solutions for low-energy transfers to lunar distant retrograde orbits.pdf}
}


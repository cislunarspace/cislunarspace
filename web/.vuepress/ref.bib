@article{kasaeianSlidingModePredictive2017,
  title = {Sliding Mode Predictive Guidance for Terminal Rendezvous in Eccentric Orbits},
  author = {Kasaeian, Seyed Aliakbar and Assadian, Nima and Ebrahimi, Masoud},
  year = 2017,
  month = nov,
  journal = {Acta Astronautica},
  volume = {140},
  pages = {142--155},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2017.08.012},
  urldate = {2025-09-25},
  abstract = {This paper presents a robust guidance algorithm for a chaser spacecraft to rendezvous with a target spacecraft in Earth orbit. The basis of the proposed guidance method is finding an appropriate set of states as close as possible to the current states that would lead the spacecraft to the target in the desired mission time. In order to provide the prediction of states, the relative dynamics equations of motion are solved analytically for the chaser spacecraft rendezvous considering constant acceleration. Although the equations are solved for rendezvous with circular orbit target, it is shown by several simulations that the proposed guidance algorithm is applicable in perturbed elliptical orbits rendezvous as well. The sliding mode method as a robust nonlinear method is utilized as the steering law. The robust steering law tracks the desired states computed by the predictive guidance method. The Lyapunov stability method proves the asymptotic stability of the integrated guidance and steering laws. Because the proposed closed-loop guidance is simple and computationally easy, it is suitable for implementation in realtime applications. Some numerical simulations are conducted to show the performance of the proposed guidance method in different conditions. It is illustrated that compared with other steering laws, the fuel consumption is reduced utilizing the proposed guidance approach. The results reveal that the sliding mode guarantees the tracking of the required states and minimum final errors even in the presence of uncertainties and disturbances.},
  langid = {english},
  annotation = {titleTranslation: 偏心轨道末端交会的滑模预测制导\\
abstractTranslation: 本文提出了一种用于在地球轨道上实现追踪航天器与目标航天器交会的鲁棒制导算法。该制导方法的核心在于寻找一组尽可能接近当前状态且能在指定任务时间内引导航天器抵达目标点的适当状态。为提供状态预测，考虑恒定加速度情形，对追踪航天器交会的相对运动动力学方程进行了解析求解。尽管该方程是针对圆形轨道目标交会问题求解的，但多项仿真表明，所提出的制导算法同样适用于受摄动椭圆轨道交会场景。采用滑模方法作为鲁棒非线性转向律，该鲁棒转向律能够跟踪预测制导方法计算出的期望状态。李雅普诺夫稳定性方法证明了集成制导与转向律的渐近稳定性。由于所提出的闭环制导算法结构简单且计算便捷，适合实时应用。通过数值仿真展示了该制导方法在不同工况下的性能。结果表明，与其他转向律相比，采用所提制导方法能降低燃料消耗。研究进一步揭示，即使存在不确定性与扰动，滑模方法也能保证所需状态的跟踪精度及极小的终端误差。},
  file = {/home/ouyangjiahong/Zotero/storage/FQ2R4VXF/Kasaeian 等 - 2017 - Sliding mode predictive guidance for terminal rendezvous in eccentric orbits.pdf}
}

@article{kaspiHighprecisionTimingMillisecond1994,
  title = {High-Precision Timing of Millisecond Pulsars. {{III}}. {{Long-term}} Monitoring of {{PSRs B1855}}+09 and {{B1937}}+21},
  author = {Kaspi, V. M. and Taylor, J. H. and Ryba, M. F.},
  year = 1994,
  month = jun,
  journal = {Astrophysical Journal},
  volume = {428},
  pages = {713},
  publisher = {IOP},
  issn = {0004-637X},
  doi = {10.1086/174280},
  urldate = {2026-03-02},
  abstract = {Biweekly timing observations of PSRs B1855+09 and B1937+21 have been made at the Arecibo Observatory for more than 7 and 8 year, respectively, with uniform procedures and only a few modest gaps. On each observing date we measure an equivalent pulse arrival time for PSR B1855+09 at 1.4 GHz, with typical accuracies of about 0.8 micrometers and for PSR B1937 + 21 at both 1.4 and 2.4 GHz, with accuracies around 0.2 micrometers. The pulse arrival times are fitted to a simple model for each pulsar, yielding high-precision astrometric, rotational, and orbital parameters, and a diverse range of conclusions. The celestial coordinates and proper motions of the two pulsars are determined with uncertainties less than or equal to 0.12 mas and less than or equal to 0.06 mas/year in the reference frame of the DE200 planetary ephemeris. The annual parallaxes are found to be pi=1.1 +/- 0.3 mas and pi less than 0.28 mas for PSRs B1855+09 and B1937+21, respectively. The general relativistic Shapiro delay is measured in the PSR B1855+09 system and used to obtain masses m1 = 1.50 +0.26 -0.14 solar mass and m (sub2) = 0.258 +0.028-0.016solar mass for the pulsar and its orbiting companion. The extremely stable orbital period of this system provides a phenomenological limit on the secular change of Newton's gravitational constant, dot-G/G=(-9 +/- 18) x 10-12/year. Variations in the dispersion measure of PSR B1937 + 21 indicate that the spectrum of electron-density fluctuations in the interstellar medi um has a power-law index beta = 3.874 +/- 0.011, slightly steeper than the Kolmogorov value of 11/3, and we find no strong evidence for an 'inner scale' greater than about 2 x 109cm. In the residual pulse arrival times for PSR B1937+21 we have observed small systematic trends not explained by our deterministic timing model. We discuss a number of possible causes; although the results are not yet conclusive, the most straightforward interpretation is that the unmodeled noise (a few microseconds over 8 yr, or Delta t/T approximately equals 10-14 is inherent to the pulsar itself. In the present data set, PSR B1855+09 exhibits no discernible timing noise. With conventional assumptions we derive a limit Omega g h2 less than 6 x 10-8 (95\% confidence) for the energy density, per logarithmic frequency interval, in a cosmic background of stochastic gravitational waves. We discuss the feasibility of establishing a pulsar-based timescale that might be used to test the stabilities of the best available atomic clocks. In an Appendix, we propose guidelines for the archiving of pulsar timing observations. Instructions are provided for obtaining copies of our own archival data, via Internet.},
  langid = {english},
  keywords = {09,21,Analog To Digital Converters,Arrivals,ASTROMETRY,Astrophysics,Atomic Clocks,Average,Background Radiation,Data Acquisition,Dispersion,GRAVITATION,Gravitational Waves,ISM: GENERAL,Precision,Pulsars,RELATIVITY,Signals,Spectrometers,STARS: BINARIES: CLOSE,STARS: PULSARS: INDIVIDUAL ALPHANUMERIC: PSR B1855,STARS: PULSARS: INDIVIDUAL ALPHANUMERIC: PSR B1937,Stellar Rotation,Telescopes,Time Measurement,X Ray Binaries},
  annotation = {ADS Bibcode: 1994ApJ...428..713K\\
abstractTranslation: 在阿雷西博天文台，我们以统一规程对PSR B1855+09和PSR B1937+21进行了超过7年和8年的双周定时观测，期间仅有少量短暂中断。每次观测时，我们在1.4 GHz频率下测量PSR B1855+09的等效脉冲到达时间，典型精度约为0.8微秒；同时对PSR B1937+21在1.4 GHz和2.4 GHz两个频率进行测量，精度约为0.2微秒。将脉冲到达时间拟合至每颗脉冲星的简单模型，可获取高精度的天体测量、自转及轨道参数，并得出多种结论。在DE200行星历表参考系下，这两颗脉冲星的天球坐标和自行测定精度分别优于或等于0.12毫角秒和0.06毫角秒/年。PSR B1855+09与PSR B1937+21的年视差分别为{$\pi$}=1.1\textpm 0.3毫角秒和{$\pi<$}0.28毫角秒。在PSR B1855+09系统中测得了广义相对论夏皮罗延迟，并由此得到脉冲星及其轨道伴星的质量：m1 = 1.50 (+0.26, -0.14) 太阳质量，m2 = 0.258 (+0.028, -0.016) 太阳质量。该系统的轨道周期极其稳定，为牛顿引力常数的长期变化提供了现象学限制：\.G/G = (-9 \textpm{} 18) \texttimes{} 10{$^{-12}$}/年。PSR B1937+21色散量的变化表明，星际介质中电子密度涨落谱的幂律指数{$\beta$} = 3.874 \textpm{} 0.011，略陡于科尔莫戈罗夫值11/3，且未发现强证据支持存在大于约2\texttimes 10{$^9$}厘米的``内尺度''。在PSR B1937+21的脉冲到达时间残差中，我们观察到微小系统趋势，无法用确定性定时模型解释。我们讨论了多种可能原因；尽管结果尚不明确，最直接的解读是未建模噪声（8年内约几微秒，即{$\Delta$}t/T {$\approx$} 10{$^{-14}$}）源于脉冲星本身。在当前数据集中，PSR B1855+09未显现可辨别的定时噪声。基于常规假设，我们推导出宇宙随机引力波背景每对数频率间隔的能量密度上限为\textohm\_g h{$^2$} {$<$} 6 \texttimes{} 10{$^{-8}$}（95\%置信度）。我们还讨论了建立基于脉冲星的时间尺度的可行性，该时间尺度可用于检验现有最佳原子钟的稳定性。在附录中，我们提出了脉冲星定时观测数据存档的指导方针，并提供了通过互联网获取我们存档数据副本的说明。},
  file = {/home/ouyangjiahong/Zotero/storage/JJ384YTZ/Kaspi 等 - 1994 - High-precision timing of millisecond pulsars. III. Long-term monitoring of PSRs B1855+09 and B1937+2.pdf}
}


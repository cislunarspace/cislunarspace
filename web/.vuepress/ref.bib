@phdthesis{LuoHongBingKongJianSanTiDuiKangDaoYinYuBoYiWenTiYanJiu2022,
  type = {{博士学位论文}},
  title = {{空间三体对抗导引与博弈问题研究}},
  author = {{骆红冰}},
  year = 2022,
  address = {合肥},
  doi = {10.27517/d.cnki.gzkju.2022.001959},
  urldate = {2026-01-19},
  abstract = {三体对抗是传统追逃博弈中的一个新兴问题,在军事和民事领域逐渐受到广泛的关注。在如今战场中,高速来袭的导弹(攻击者)对关键目标有着巨大的威胁,传统的方法无法保证其安全,此时,可采用发射保卫者(导弹或其他诱导目标)的主动防御措施进行拦截对抗。因此,有效的主动目标防御导引策略与追击策略成为众多研究的重点。在设计主动防御导引策略时,为了使其最大可能地拦截攻击者,需要考虑对目标与保卫者方不利的情况,即攻击者的性能优于目标和保卫者且攻击者的导引信息不可知。而已有的相关工作为了便于分析,通常假设保卫者的性能能够媲美攻击者,或假设三体对抗的状态信息完全可知。由于在实际情况下个体的性能与导引信息的可知性会影响三体对抗的结果,针对攻击者性能优于目标与保卫者和攻击者的导引信息不可知的情况,分别考虑了二维平面中的主动防御导引设计和三维空间中的主动防御设计,开展了相关工作。主要内容包括:首先,考虑二维平面内目标-保卫者对抗具有更强机动性能的攻击者的三体对抗场景。基于三点导引法的概念,以目标和保卫者的侧向加速度为控制输入,建立视线角误差与视线角速度误差模型。在建立系统模型时,放宽攻击者导引信息(侧向加速度)可知的假设,只需要攻击者的侧向加速度是有上界的,将攻击者的侧向加速度作为系统的未知扰动来处理。结合输入-状态稳定性理论,为目标和保卫者提出了一种双自由度的协同视线导引律,从而能够采用静态优化的方法最小化目标和保卫者的瞬时侧向加速度。此外,基于最优控制方法设计了目标的最优规避策略,为了避免求解非线性两点边值问题,对攻击者采取纯追踪导引的情况进行了分析与设计。其次,考虑了三维空间中的三体对抗问题。为了消除模型线性化带来的系统偏差,分别从俯仰平面和偏航平面出发,将攻击者不可知的侧向加速度作为系统的扰动,建立了以目标和保卫者的侧向加速度为输入的二阶非线性系统模型来描述目标-保卫者-攻击者三者在三维空间中的相对运动。结合输入-状态稳定性理论,设计提出了一种三体对抗的三维协同视线导引律,使得视线角误差与视线角速度误差对于攻击者的机动是输入状态稳定的。进一步地,针对实际情况下视线角速度状态不可测的情况,设计了高增益观测器进行估计,再结合上述的三维协同视线导引律,通过理论分析证明了闭环系统的稳定性,即所设计导引律的有效性。然后,将三体对抗问题描述为一个多人的微分博弈问题。针对目标-保卫者-攻击者三者共面的情况,以三者的视线距离和攻击者-目标视线与攻击者-...},
  collaborator = {{季海波}},
  langid = {chinese},
  school = {中国科学技术大学},
  annotation = {album: 工程科技II辑\\
CLC: E91\\

  pages = {718--744},
  issn = {2195-0571},
  doi = {10.1007/s40295-022-00320-4},
  abstract = {The development of a methodology to move through cislunar space along fundamental dynamical pathways is relevant to NASA's goals for a cislunar transportation network. To enable an informed design approach for transfer trajectories departing from or arriving at a Near Rectilinear Halo Orbit (NRHO), higher-period orbits that bifurcate from the NRHO region of the \$\$L\_2\$\$halo orbit family are combined with other known structures, such as other Lagrange point and resonant orbits, in the Earth-Moon neighborhood. As a result of this design strategy, novel impulsive transfer options between NRHOs and distant retrograde orbits that possess predictable geometries are constructed. A strategy to enforce eclipse-free transfers using a path constraint is developed and verified in a higher-fidelity ephemeris model.},
  langid = {english},
  keywords = {Circular restricted three-body problem (CR3BP),Distant retrograde orbit (DRO),Eclipse,Gateway,Multi-body dynamics,Near rectilinear halo orbits (NRHO),Transfer design},
  annotation = {titleTranslation: 近直线晕轨道附近动力学结构及其在环月空间转移设计中的应用\\
abstractTranslation: 沿基本动力学路径穿越地月空间的方法开发，与美国国家航空航天局（NASA）建立地月运输网络的目标密切相关。为实现从近直线晕轨道（NRHO）出发或抵达该轨道的转移轨道设计提供依据，将L{$_2$}晕轨道族中NRHO区域分岔出的高周期轨道，与地月系邻域内的其他已知结构（如其他拉格朗日点轨道和共振轨道）相结合。基于此设计策略，构建了连接NRHO与具有可预测几何特征的远距离逆行轨道的新型脉冲转移方案。进一步开发了利用路径约束实现无日食转移的策略，并在高保真星历模型中进行了验证。},
  file = {/home/ouyangjiahong/Zotero/storage/5ADZ2PUY/Zimovan-Spreen 等 - 2022 - Dynamical structures nearby NRHOs with applications to transfer design in cislunar space.pdf}
}


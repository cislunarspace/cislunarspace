@article{nazariFrameworkFullNbody2023,
  title = {Framework for the Full {{N-body}} Problem in {{SE}}(3) and Its Reduction to the Circular Restricted Full Three-Body Problem},
  author = {Nazari, Morad and Canales, David and McCann, Brennan and Butcher, Eric and Howell, Kathleen},
  year = 2023,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {Vol.135},
  number = {No.4},
  pages = {1--27},
  issn = {0923-2958},
  doi = {10.1007/s10569-023-10156-1},
  abstract = {A novel, compact formalism of rigid body motion dynamics is presented in a general reference frame based on the geometric mechanics framework. This formalism, proposed on the special Euclidean space ( SE (3) ) of the Lie group, naturally accounts for the orbit/attitude coupling due to the gravitational moments and forces. It is demonstrated that the structure of the rigid body dynamics equations is preserved in different coordinate frames. Then, using the expression of gravitational potential, this global framework is applied to the circular restricted full three-body problem (CRF3BP) of a near-rectilinear halo orbit (NRHO) similar to that of Gateway, where the equations are uniquely provided in the body frame of the spacecraft and the barycentric rotating frame. For the sake of propagation and consistency with the classical circular restricted three-body problem (CR3BP), the equations of the CRF3BP are also presented in a non-dimensional form. Trajectories computed with different inertia tensors are compared with those obtained using the traditional equations of motion of a point-mass spacecraft subject to the gravitational fields of two larger primaries. The comparison between CRF3BP and CR3BP suggests: (a) the need for computation of customized families of halo orbits considering inertia properties of each spacecraft; and (b) the use of attitude-only control for station-keeping in future NRHO missions to reduce station-keeping costs which would otherwise be relatively large if the point-mass approximation were used.},
  langid = {english},
  keywords = {Circular restricted three-body problem (CR3BP),Geometric mechanics,Multi-body dynamical systems,Near-rectilinear halo orbit},
  annotation = {titleTranslation: SE(3) 中完整 N 体问题的框架及其向圆形限制性完整三体问题的约化\\
abstractTranslation: 基于几何力学框架，提出了一种在一般参考系中描述刚体运动动力学的紧凑新颖形式。该形式建立在李群的特殊欧几里得空间SE(3)上，能够自然地解释由引力矩和引力引起的轨道/姿态耦合。研究表明，刚体动力学方程的结构在不同坐标系下保持不变。随后，利用引力势表达式，将该全局框架应用于类似Gateway的近直线晕轨道（NRHO）的圆形受限全三体问题（CRF3BP），其中方程唯一地以航天器本体坐标系和质心旋转坐标系给出。为了便于传播并与经典圆形受限三体问题（CR3BP）保持一致，CRF3BP的方程也以无量纲形式给出。采用不同惯性张量计算的轨迹，与使用传统点质量航天器运动方程（受两个较大主天体引力场作用）所得结果进行了比较。CRF3BP与CR3BP的对比表明：(a) 需要考虑每艘航天器的惯性特性，计算定制化的晕轨道族；(b) 在未来的NRHO任务中，采用仅姿态控制的方式进行站位保持，以降低站位保持成本------若使用点质量近似，该成本将相对较高。}
}

@inproceedings{nebeleckyTrackingBiasEstimation2024,

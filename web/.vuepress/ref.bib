@article{turnerResultsLongdurationSimulation2016,
  title = {Results of Long-Duration Simulation of Distant Retrograde Orbits},
  author = {Turner, Gary},
  year = 2016,
  journal = {Aerospace},
  volume = {Vol.3},
  number = {No.4},
  pages = {37},
  doi = {10.3390/aerospace3040037},
  abstract = {Distant Retrograde Orbits in the Earth--Moon system are gaining in popularity as stable ``parking'' orbits for various conceptual missions. To investigate the stability of potential Distant Retrograde Orbits, simulations were executed, with propagation running over a thirty-year period. Initial conditions for the vehicle state were limited such that the position and velocity vectors were in the Earth--Moon orbital plane, with the velocity oriented such that it would produce retrograde motion about Moon. The resulting trajectories were investigated for stability in an environment that included the eccentric motion of Moon, non-spherical gravity of Earth and Moon, gravitational perturbations from Sun, Jupiter, and Venus, and the effects of radiation pressure. The results indicate that stability may be enhanced at certain resonant states within the Earth--Moon system.},
  langid = {english},
  keywords = {Distant Retrograde Orbit,DRO,dynamics,orbits-resonance,orbits-stability,radiation pressure},
  annotation = {titleTranslation: 远距离逆行轨道长时间仿真结果\\
abstractTranslation: 地球-月球系统中的远距离逆行轨道作为各种概念任务的稳定``停泊''轨道正日益受到青睐。为了研究潜在远距离逆行轨道的稳定性，开展了为期三十年的传播仿真。航天器状态的初始条件被限制为位置和速度矢量均处于地月轨道平面内，且速度方向设定为产生绕月逆行运动。在包含月球偏心运动、地球和月球非球形引力、太阳、木星和金星引力摄动以及辐射压力影响的环境中，对所得到的轨迹进行了稳定性研究。结果表明，在地月系统内部某些共振状态下，稳定性可能得到增强}
}


@misc{bhattacharyaRobustCislunarNavigation2025,
  title = {Robust Cislunar Navigation via {{LFT-based}} \$\textbackslash mathcal\textbraceleft{{H}}\textbraceright\_\textbackslash infty\$ Filtering with Bearing-Only Measurements},
  author = {Bhattacharya, Raktim},
  year = 2025,
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2510.04942},
  urldate = {2025-11-27},
  abstract = {This paper develops a robust estimation framework for cislunar navigation that embeds the Circular Restricted Three-Body Problem (CR3BP) dynamics and bearing-only optical measurements within a Linear Fractional Transformation (LFT) representation. A full-order \$\textbackslash mathcal\textbraceleft H\textbraceright\_\textbackslash infty\$ observer is synthesized with explicit \$\textbackslash mathcal\textbraceleft L\textbraceright\_2\$ performance bounds. The formulation yields a nonlinear estimator that operates directly on the governing equations and avoids reliance on local linearizations. Dominant nonlinearities are expressed as structured real uncertainties, while measurement fidelity is represented through range-dependent weighting with Earth-Moon distances reconstructed from line-of-sight geometry. The sensing architecture assumes passive star-tracker-class optical instruments, eliminating the need for time-of-flight ranging or precision clocks. Simulations demonstrate bounded estimation errors and smooth position tracking over multiple orbital periods, with the largest deviations observed in the out-of-plane states, consistent with the stiffness of the vertical dynamics and the limitations of angle-only observability. Application to a Near Rectilinear Halo Orbit (NRHO) illustrates that the framework can achieve robust onboard navigation with bounded estimation errors with flight-representative sensors.},
  copyright = {Creative Commons Attribution 4.0 International},
  langid = {english},
  keywords = {FOS: Electrical engineering electronic engineering information engineering,FOS: Mathematics,Optimization and Control (math.OC),Systems and Control (eess.SY)},
  annotation = {titleTranslation: 基于线性分式变换的鲁棒地月空间导航：仅用方位测量的\$\textbackslash mathcal\textbraceleft H\textbraceright\_\textbackslash infty\$滤波方法\\
abstractTranslation: 本文提出了一种用于地月空间导航的鲁棒估计框架，该框架将圆型限制性三体问题动力学与纯方位光学测量嵌入线性分式变换表示中。通过综合具有显式\$\textbackslash mathcal\textbraceleft L\textbraceright\_2\$性能界的全阶\$\textbackslash mathcal\textbraceleft H\textbraceright\_\textbackslash infty\$观测器，构建出直接基于控制方程运行、无需依赖局部线性化的非线性估计器。主导非线性被表述为结构化实不确定性，而测量保真度则通过距离相关加权表示------其地月距离由视线几何重构获得。该感知架构采用被动式星敏感器级光学仪器，无需飞行时间测距或精密时钟。仿真结果表明，在多个轨道周期内估计误差有界且位置跟踪平滑，最大偏差出现在平面外状态，这与垂直动力学的刚性及纯角度观测能力的局限性相符。在近直线晕轨道上的应用表明，该框架能够利用具有飞行代表性的传感器实现估计误差有界的鲁棒在轨导航。},
  file = {/home/ouyangjiahong/Zotero/storage/4LTC3X8X/Bhattacharya - 2025 - Robust cislunar navigation via LFT-based $mathcal H _infty$ filtering with bearing-only measuremen.pdf}
}


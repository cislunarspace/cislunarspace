  doi = {10.27052/d.cnki.gzjgu.2019.001041},
  urldate = {2026-04-05},
  abstract = {战后重建是冷战后美国日益重要的对外军事行动,``9{$\cdot$}11''事件之后更加快了这种趋势。美国的海外重建行动是以武力为基础,承载外交和发展功能的国家行为,军队在其中发挥着重要的作用。战后重建行动是军队与其它力量手段协调运用,实现国家利益的过程,也是军队在达成军事目标之后,配合国家其它权力手段实现战争的政治目的过程。论文从军队参与的角度,论述了美军如何参与战后重建。第一章为绪论部分,主要阐述论文的研究目的及价值,对核心概念进行界定;第二章为理论基础,分别对战后重建的概念演化、战后重建行动的指导理论等进行论述;第三、四章为论文的核心,主要探析美军战后重建的具体任务及跨机构协调问题,并结合案例进行研究。通过剖析美军如何透过跨机构协调机制,协调国家其它力量手段来实现美国的对外战略;在此基础上,再结合阿富汗和伊拉克战后重建的案例进行具体研究。最后一章基于上述研究,对美军参与战后重建行动的相关问题,做了特点总结和趋势判断。},
  collaborator = {{周辉}},
  langid = {chinese},
  school = {国防科技大学},
  keywords = {,"911"},
  annotation = {Major: 政治学},
  file = {/home/ouyangjiahong/Zotero/storage/QUZ4CFKW/毛琦 - 2022 - “9·11”事件后美军参与战后重建研究.pdf}
}


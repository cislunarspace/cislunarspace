@inproceedings{pengLowenergyRoundtripTransfer2023,
  title = {Low-Energy Round-Trip Transfer Orbit of {{DRO-NEA}}},
  booktitle = {Chinese {{Conference}} on {{Swarm Intelligence}} and {{Cooperative Control}}},
  author = {Peng, C.},
  year = 2023,
  series = {Chinese {{Conference}} on {{Swarm Intelligence}} and {{Cooperative Control}}},
  address = {Nanjing, China},
  abstract = {This study focuses on the low-energy transfer orbit for a probe flying over a near-Earth asteroid from a service station on DRO (Distant Retrograde Orbit) and then returning to the service station in the restricted Sun-Earth-Moon four-body problem. This low-energy transfer orbits are designed by using the solar and lunar gravity, which is found by the method of database creating and trajectory patching. Finally, a feasible solution with DeltaV (fuel consumption) less than 1 km/s is obtained. Based on the feasible solutions, it is found that probe can fly over a near-Earth asteroids from a DRO with low-energy cost by using the powered lunar flybys and WSB ballistic transfer, which envisions future near-Earth asteroids exploration missions.},
  langid = {english},
  annotation = {titleTranslation: DRO-NEA低能量往返转移轨道}
}

@article{pengLowenergyTransfersLunar2024,
  title = {Low-Energy Transfers to Lunar Distant Retrograde Orbits from Geostationary Transfer Orbits},
  author = {Peng, Chao and Shang, Yunong and He, Shengmao and Zhu, Zhengfan and Wen, Changxuan},
  year = 2024,
  journal = {Journal of Spacecraft and Rockets},
  volume = {61},
  number = {5},
  pages = {1293--1304},
  doi = {10.2514/1.A35623},
  abstract = {This study focuses on the low-energy transfers to lunar distant retrograde orbits (DROs) from geostationary transfer orbits (GTOs) in the bicircular-restricted sun-Earth-moon four-body problem. The low-energy transfer is essential for low-cost small satellites reaching out to the Moon, and the departure from GTO allows more rideshare opportunities. We first created several large-scale databases of trajectory segments, such as GTO to apogee in the weak-stability area, apogee to perilune, and DRO to perilune. Then, millions of GTO-DRO transfer trajectories with double powered lunar flybys (PLFs) and weak stability boundary (WSB) ballistic transfer were constructed through trajectory patching. The key flight information, such as the Delta V-time-of-flight Pareto fronts, launch windows, and the flight mode via WSB ballistic transfer, is obtained from feasible solutions. Results show that low-energy GTO-DRO transfers can be achieved by exploiting PLFs and WSB ballistic arcs, which suggests potential applications in the cislunar space.},
  langid = {english},
  keywords = {Distant Retrograde Orbit,Earth Centered Inertial,Geostationary Transfer Orbit,Lunar Orbit,Orbital Inclination,Powered Lunar Gravity Assist,Propellant,Small Satellites,Space Exploration and Technology},
  annotation = {titleTranslation: 从地球同步转移轨道至月球远距离逆行轨道的低能量转移\\
abstractTranslation: 本研究聚焦于双圆限制性日-地-月四体问题中从地球静止转移轨道(GTO)到月球远距离逆行轨道(DRO)的低能量转移。低能量转移对于低成本小型卫星抵达月球至关重要，而从GTO出发可提供更多共乘机会。我们首先构建了多个大规模的轨迹段数据库，例如从GTO到弱稳定区域远地点、远地点到近月点以及DRO到近月点的轨迹段。随后，通过轨迹拼接，构造了数百万条包含双动力月球飞越(PLFs)和弱稳定边界(WSB)弹道转移的GTO-DRO转移轨迹。从可行解中获取了关键飞行信息，如Delta V-飞行时间帕累托前沿、发射窗口以及通过WSB弹道转移的飞行模式。结果表明，利用PLFs和WSB弹道弧段可实现低能量GTO-DRO转移，这暗示了其在地月空间中的潜在应用},
  file = {/home/ouyangjiahong/Zotero/storage/I6ZR4GT3/Peng 等 - 2024 - Low-energy transfers to lunar distant retrograde orbits from geostationary transfer orbits.pdf}
}

@article{PengQiBoJiYuMoXingDeZaiRenDengYueQuanShouMingZhouQiGuZhangGuanLiFangFa2024,
  title = {{基于模型的载人登月全寿命周期故障管理方法}},
  author = {{彭祺擘} and {胡云鹏} and {武新峰} and {张海联}},
  year = 2024,
  journal = {宇航学报},
  volume = {45},
  number = {9},
  pages = {1386--1395},
  issn = {1000-1328},
  abstract = {故障管理是管控复杂系统风险的重要途径，需要在系统研制、应用各个阶段开展相应的工作。随着基于模型的系统工程（MBSE）在航天领域的应用，也必须将基于模型的故障管理纳入到系统发展的全寿命周期之中。以载人登月任务为背景，结合MBSE方法论和传统的故障管理方法，从技术层面提出了贯穿于载人登月任务全寿命周期的任务级故障管理方法，包括基于模型的故障管理概念设计、架构设计、需求分析与捕获、需求验证与确认、故障评估与分析、操作和维护。并详述了在MBSE背景下上述内容的实现方式。最后从载人登月任务层的视角，给出了全寿命周期下基于模型的故障管理过程，为未来载人登月任务的故障管理提供了一套可行的实施框架。},
  langid = {chinese},
  keywords = {,(MBSE)},
  annotation = {CNKICite: 5},
  file = {/home/ouyangjiahong/Zotero/storage/GDR4X8CB/彭祺擘 等 - 2024 - 基于模型的载人登月全寿命周期故障管理方法.pdf}
}

@article{PengQiBoJiYuQuJianShuDeYingJiFanHuiGuiDaoKeDaYuQiuJieFangFa2026,
  title = {{基于区间数的应急返回轨道可达域求解方法}},
  author = {{彭祺擘} and {陆林} and {张海联}},
  year = 2026,
  month = mar,
  journal = {中国空间科学技术},
  volume = {46},
  number = {2},
  pages = {36},
  issn = {1000-758X},
  doi = {10.16708/j.cnki.1000-758X.2026.0022},
  urldate = {2026-04-06},
  abstract = {针对环月飞行阶段的应急返回轨道，提出了一种基于区间数的可达域求解方法。首先，描述了环月飞行阶段采用单脉冲异面变轨方式的应急返回轨道问题，建立了应急返回轨道可达域的数学模型。其次，在设计单条应急返回轨道的基础上，结合改进的区间分支界定算法，提出了一种应急返回轨道可达域求解方法。然后，与传统的基于遍历搜索的可达域求解方法进行仿真对比，对比结果显示在不同参数配置下，该方法最少可以减少47.4\%的求解时间，最多可以减少96.5\%的求解时间，验证了所提方法的准确性和高效性。最后，利用该方法进行大量仿真计算，分析了应急返回轨道可达域的参数特性。研究结论可为未来月球探测应急返回轨道方案的选择与制定提供参考。},
  collaborator = {Peng, Qibo and Lu, Lin and Zhang, Hailian},
  langid = {chinese},
  keywords = {,</span>,<span>,<span>lunar exploration,contingency return trajectory,interval branch and bound algorithm</span>,interval number,reachable domain},
  annotation = {creatorsExt: [\textbraceleft "firstName":"","lastName":"彭祺擘","creatorType":"author","fieldMode":1,"original":"Peng \textbar\textbar{} Qibo"\textbraceright,\textbraceleft "firstName":"","lastName":"陆林","creatorType":"author","fieldMode":1,"original":"Lu \textbar\textbar{} Lin"\textbraceright,\textbraceleft "firstName":"","lastName":"张海联","creatorType":"author","fieldMode":1,"original":"Zhang \textbar\textbar{} Hailian"\textbraceright ]},

@article{xuAdaptiveRobustCubature2026,
  title = {Adaptive Robust Cubature Filtering-Based Autonomous Navigation for Cislunar Spacecraft Using Inter-Satellite Ranging and Angle Data},
  author = {Xu, Jun and Ma, Xin and Chen, Xiao},
  year = 2026,
  month = jan,
  journal = {Aerospace},
  volume = {13},
  number = {1},
  pages = {100--115},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2226-4310},
  doi = {10.3390/aerospace13010100},
  urldate = {2026-04-23},
  abstract = {The Linked Autonomous Interplanetary Satellite Orbit Navigation (LiAISON) technique enables cislunar spacecraft to obtain accurate position and velocity information, allowing full state estimation of two vehicles using only inter-satellite range (ISR) measurements when both their dynamical states are unknown. However, its stand-alone use leads to significantly increased orbit determination errors when the orbital planes of the two spacecraft are nearly coplanar, and is characterized by long initial convergence times and slow recovery following dynamical disturbances. To mitigate these issues, this study introduces an integrated navigation method that augments inter-satellite range measurements with line-of-sight vector angles relative to background stars. Additionally, an enhanced Adaptive Robust Cubature Kalman Filter (ARCKF) incorporating a chi-square test-based adaptive forgetting factor (AFF-ARCKF) is developed. This algorithm performs adaptive estimation of both process and measurement noise covariance matrices, improving convergence speed and accuracy while effectively suppressing the influence of measurement outliers. Numerical simulations involving spacecraft in Earth--Moon L4 planar orbits and distant retrograde orbits (DRO) confirm that the proposed method significantly enhances system observability under near-coplanar conditions. Comparative evaluations demonstrate that AFF-ARCKF achieves faster convergence compared to the standard ARCKF. Further analysis examining the effects of initial state errors and varying initial forgetting factors clarifies the operational boundaries and practical applicability of the proposed algorithm.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  annotation = {titleTranslation: 基于自适应鲁棒容积滤波的地月空间航天器自主导航方法：利用星间测距与角度数据\\
abstractTranslation: 链式自主星际卫星轨道导航（LiAISON）技术能够使地月空间航天器获取精确的位置与速度信息，在无需预先获知两航天器动力学状态的情况下，仅利用星间测距（ISR）测量值实现两者的完全状态估计。然而，当两航天器的轨道面近乎共面时，该技术的独立使用会导致定轨误差显著增大，且存在初始收敛时间长、受动力学扰动后恢复缓慢等问题。为缓解以上问题，本研究提出一种综合导航方法，在星间测距测量值基础上引入相对于背景恒星的视线矢量角。此外，还开发了一种增强型自适应鲁棒容积卡尔曼滤波器（ARCKF），其中嵌入了基于卡方检验的自适应遗忘因子（AFF-ARCKF）。该算法能够同时对过程噪声和测量噪声协方差矩阵进行自适应估计，从而提高收敛速度与精度，并有效抑制异常测量值的影响。针对运行于地球-月球L4平面轨道及远距离逆行轨道（DRO）的航天器进行的数值仿真验证表明，所提方法在近共面条件下显著增强了系统可观测性。对比评估显示，AFF-ARCKF相比标准ARCKF实现了更快的收敛速度。进一步分析初始状态误差及不同初始遗忘因子的影响，明确了所提算法的适用边界与实际应用可行性。},
  file = {/home/ouyangjiahong/Zotero/storage/S6CZ4FY4/Xu 等 - 2026 - Adaptive robust cubature filtering-based autonomous navigation for cislunar spacecraft using inter-s.pdf}
}


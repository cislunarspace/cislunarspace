@article{jezewskiSurveyRendezvousTrajectory1992,
  title = {A Survey of Rendezvous Trajectory Planning},
  author = {Jezewski, D. J. and Brazzel, Jr., J. P. and Prust, E. E. and Brown, B. G. and Mulder, T. A. and Wissinger, D. B.},
  year = 1992,
  month = aug,
  journal = {Astrodynamics 1991},
  pages = {1373--1396},
  urldate = {2026-01-28},
  abstract = {A survey of international papers written about rendezvous trajectories was performed. This report highlights the significant developments in the analytical and nonanalytical study of rendezvous planning and provides a bibliography of the approximately 200 papers examined. The survey did not consider close-in proximity operations, docking, on-board sensors, or spacecraft mechanisms. The various formulations, assumptions, approximations, optimization approaches, and in-flight and terminal constraints that comprise the theoretical subject are presented from a historical point of view. Many operational considerations (e.g., navigation uncertainties, launch windows, crew schedules) are often not addressed by theoretical developments and are therefore discussed separately. Significant characteristics, developments, and solution results are identified by illustrations from the bibliography. It is hoped the survey of rendezvous trajectory planning and techniques will serve as a basis for future research and development.},
  langid = {english},
  keywords = {Astrodynamics,Orbital Maneuvers,Orbital Rendezvous,Space Navigation,Spacecraft Docking,Spacecraft Instruments,Trajectory Planning},
  annotation = {ADS Bibcode: 1992asdy.conf.1373J\\
titleTranslation: 交会轨迹规划综述\\
abstractTranslation: 本文对国际有关交会轨迹的论文进行了综述。报告重点介绍了交会规划在解析与非解析研究方面的重要进展，并列出了约200篇相关文献的参考书目。本次综述未涉及近距离操作、对接、机载传感器或航天器机构等内容。从历史角度出发，阐述了构成该理论主题的各种公式、假设、近似方法、优化策略以及飞行中与终端约束。许多运行考量因素（如导航不确定性、发射窗口、乘组调度）通常未被理论研究涵盖，因此另行讨论。通过参考文献中的示例，标明了重要特征、进展及求解结果。希望这份关于交会轨迹规划与技术的综述能为未来的研究与发展奠定基础。}
}


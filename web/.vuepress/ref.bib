@article{spencerEarthmarsTransfersMoon2018,
  title = {Earth-Mars Transfers through Moon Distant Retrograde Orbits},
  author = {Spencer, David B. and Vasile, Massimiliano and Conte, Davide and Ho, Koki and Di Carlo, Marilena},
  year = 2018,
  journal = {Acta Astronautica},
  volume = {Vol.143},
  number = {No.0},
  pages = {372--379},
  abstract = {This paper focuses on the trajectory design which is relevant for missions that would exploit the use of asteroid mining in stable cis-lunar orbits to facilitate deep space missions, specifically human Mars exploration. Assuming that a refueling ``gas station'' is present at a given lunar Distant Retrograde Orbit (DRO), ways of departing from the Earth to Mars via that DRO are analyzed. Thus, the analysis and results presented in this paper add a new cis-lunar departure orbit for Earth-Mars missions. Porkchop plots depicting the required C 3 at launch, v {$\infty$} at arrival, Time of Flight (TOF), and total {$\Delta$} V for various DRO departure and Mars arrival dates are created and compared with results obtained for low {$\Delta$} V Low Earth Orbit (LEO) to Mars trajectories. The results show that propellant-optimal trajectories from LEO to Mars through a DRO have higher overall mission {$\Delta$} V due to the additional stop at the DRO. However, they have lower Initial Mass in LEO (IMLEO) and thus lower gear ratio as well as lower TOF than direct LEO to Mars transfers. This results in a lower overall spacecraft dry mass that needs to be launched into space from Earth's surface.},
  langid = {english},
  keywords = {Earth-DRO-Mars,Earth-Mars trajectories,Lunar DRO,Mars,Mars missions},
  annotation = {titleTranslation: 地火转移任务中的月球远距离逆行轨道应用\\
abstractTranslation: 本文聚焦于与任务相关的轨迹设计，这些任务将利用稳定地月轨道上的小行星采矿来支持深空探测，特别是人类火星探索。假设在某个给定的月球远距逆行轨道（DRO）上设有燃料补给``加油站''，本文分析了从地球经该DRO飞往火星的出发方式。因此，本文的分析与结果为地球-火星任务新增了一种地月逃逸轨道。绘制了 Porkchop 图，展示了不同DRO出发和火星到达日期下的发射所需C3、到达时v{$\infty$}、飞行时间（TOF）及总{$\Delta$}V，并与低{$\Delta$}V的低地球轨道（LEO）至火星轨迹的结果进行了比较。结果表明，经DRO从LEO到火星的推进剂最优轨迹由于需要在DRO额外停留，整体任务{$\Delta$}V较高。然而，与直接从LEO转移至火星相比，其LEO初始质量（IMLEO）更低，因而传动比更小，TOF也更短。这导致需要从地球表面发射进入太空的航天器干质量更低。}
}


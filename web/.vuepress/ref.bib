@phdthesis{ZhengDanDanDiYuePingDongDianZhuanYiGuiDaoSheJiYuJiaoHuiKongZhiFangFaYanJiu2020,
  type = {{博士学位论文}},
  title = {{地月平动点转移轨道设计与交会控制方法研究}},
  author = {{郑丹丹}},
  year = 2020,
  address = {西安},
  doi = {10.27406/d.cnki.gxbgu.2020.000460},
  abstract = {本论文面向平动点空间非合作目标在轨服务的特点和需求,综合考虑平动点轨道交会过程中的多约束条件与不确定性等特性。采用辛算法、混合级数、特征空间、微分器以及预设性能控制理论与方法研究了平动点转移轨道与交会的多约束轨迹规划与控制方法。主要内容和创新性的研究工作有: (1)基于辛算法的不变流形计算。针对利用不变流形设计低能转移轨道的过程中,传统的数值积分方法计算不变流形时会出现能量耗散以及计算效率低的问题,提出了一种基于混合李算子辛算法的保能量不变流形计算方法,该方法可以求解不能分解成势能和动能的哈密尔顿系统。通过与传统数值方法进行仿真对比,验证了该方法的能量误差小且计算效率高的特性。 (2)基于逆动力学的地月平动点转移轨道设计。针对利用平动点轨道轨迹规划时计算量大的问题,提出基于逆动力学方法与不变流形拼接的地-月L2平动点的低能小推力转移轨道设计。推导了圆型限制性三体问题在地心柱坐标系下的动力学模型,建立了转移轨道所要满足的优化条件,给出了利用傅里叶级数和幂级数的混合级数描述轨迹的方法,并采用高斯伪谱优化方法进行优化。通过仿真验证了该轨道设计方法在深空小推力,低能轨道优化设计中的有效性及快速性,为深空任务航天器在轨、快速轨道设计提供了新的设计思路。 (3)基于Lyapunov-Floquet定理的平动点轨道保持最优控制方法研究。针对平动点轨道不稳定的问题,提出了一种平动点轨道保持控制方法。利用Lyapunov-Floquet定理将相对运动方程转化成时不变的含有原方程状态转移矩阵的系统,同时利用两点边值问题求解Floquet因子,相比传统计算方法,在计算量以及积分误差等方面具有明显的优势;利用LQR最优控制方法求解出最优控制增益,保证了存在初始偏差、导航等误差的情况下,航天器仍然能够沿着标称轨迹运行。 (4)平动点轨道交会特征空间控制方法研究。针对平动点轨道近程交会过程中存在扰动等不确定性因素的问题,提出了一种基于特征空间的控制方法。首先推导了平动点轨道非线性相对动力学模型,接着利用笛卡尔符号规则分析了雅克比矩阵特征多项式具有一个正实根、一对共轭虚根的区域,在此状态范围内解析地求出雅克比矩阵的特征值与特征向量,并利用特征值与特征向量设计了特征空间控制器;然后针对控制器需要反复调参的问题,利用遗传算法对控制器增益参数进行优化;最后通过仿真验证了该方法的有效性与鲁棒性。 (5)速度信息缺失的平动点轨道交会控制方法研究。针对深空相对导航信息难以测量以及存在导航误差,现有的控制方法难以实现高精度交会的问题,提出了一种无需速度信息的平动点轨道近距离交会控制方法,即基于微分器的预设性能控制方法。该方法能够通过微分器估计两航天器的相对速度状态,利用预设性能控制器使得两航天器的相对运动状态在预设的边界内渐近收敛到期望状态。该方法为闭环控制,且与模型无关,容易在线操作。仿真结果表明,在平动点轨道航天器存在未知扰动以及导航误差等不确定的情况下,利用所提出的交会控制律能够实现追踪航天器与目标航天器交会任务的高精度实时控制,且具有较强鲁棒性。},
  collaborator = {{罗建军}},
  langid = {chinese},
  school = {西北工业大学},
  keywords = {,Lyapunov-Floquet},
  annotation = {album: 工程科技II辑\\
CLC: V412.41;V448.2\\
dbcode: CDFD\\
dbname: CDFDLAST2025\\
download: 155\\
filename: 1024389220.nh\\
major: 飞行器设计},
  file = {/home/ouyangjiahong/Zotero/storage/EUSMWV8Z/郑丹丹 - 2020 - 地月平动点转移轨道设计与交会控制方法研究.pdf}
}

@article{zhengDistributedOnboardMission2019,
  title = {Distributed Onboard Mission Planning for Multi-Satellite Systems},
  author = {Zheng, Zixuan and Guo, Jian and Gill, Eberhard},
  year = 2019,
  month = jun,
  journal = {Aerospace Science and Technology},
  volume = {89},
  pages = {111--122},
  issn = {1270-9638},
  doi = {10.1016/j.ast.2019.03.054},
  urldate = {2026-04-27},
  abstract = {The increasing number of satellites for specific space missions is hindering efficient control from the ground stations. In addition, the risk of failing or deteriorating elements in a multi-satellite system (MSS) leads to the uncertainty in its operating environment which challenges traditional centralized planning algorithms. Centralized algorithms depend on one coordinator to overview entire system, which is a single poitn of failure, so if it malfunctional, the MSS may go down. To overcome this problem, a distributed onboard mission planning algorithm based on the Hybrid Dynamic Mutation Genetic Algorithm (HDMGA) is proposed for such MSS. The satellites are considered as autonomous agents which can communicate and negotiate with other satellites. The mission objective is decomposed through the team negotiation procedures, and the local goals are dispatched to the participant satellite. The local planning procedure on each satellite is modeled as local search problems, while the planning problem for entire team is formulated as strongly-coupled distributed optimization problem. The verification shows that the proposed distributed approach can achieve the same results as the centralized approach. The simulation results illustrate that the proposed approach shows superior performance on both computation time and success rate, as compared with other two state-of-the-art distributed mission planning approaches.},
  langid = {english},
  keywords = {Distributed planning approach,Genetic algorithm,Multi-satellite system,Optimization},
  annotation = {titleTranslation: 分布式星上任务规划多卫星系统\\
abstractTranslation: 特定空间任务中卫星数量的不断增加，正对地面站的有效控制构成阻碍。此外，多卫星系统（MSS）中元件失效或性能下降的风险，导致其运行环境存在不确定性，这对传统的集中式规划算法提出了挑战。集中式算法依赖一个协调器来监控整个系统，这构成了单点故障，一旦该协调器发生故障，MSS可能全面瘫痪。为解决这一问题，针对此类MSS提出了一种基于混合动态变异遗传算法（HDMGA）的分布式星载任务规划算法。卫星被视为能够与其他卫星通信和协商的自主智能体。通过团队协商过程对任务目标进行分解，并将局部目标分派给参与的卫星。每颗卫星上的局部规划过程被建模为局部搜索问题，而整个团队的规划问题则被表述为强耦合的分布式优化问题。验证表明，所提出的分布式方法能够达到与集中式方法相同的结果。仿真结果显示，与另外两种最先进的分布式任务规划方法相比，本方法在计算时间和成功率方面均表现出更优的性能。}
}


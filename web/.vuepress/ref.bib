@article{pengSymplecticAdaptiveAlgorithm2011,
  title = {Symplectic Adaptive Algorithm for Solving Nonlinear Two-Point Boundary Value Problems in Astrodynamics},
  author = {Peng, H. J. and Gao, Q. and Wu, Z. G. and Zhong, W. X.},
  year = 2011,
  month = aug,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {110},
  number = {4},
  pages = {319--342},
  issn = {1572-9478},
  doi = {10.1007/s10569-011-9360-4},
  urldate = {2026-01-27},
  abstract = {In this paper, from a Hamiltonian point of view, the nonlinear optimal control problems are transformed into nonlinear two-point boundary value problems, and a symplectic adaptive algorithm based on the dual variational principle is proposed for solving the nonlinear two-point boundary value problem. The state and the costate variables within a time interval are approximated by using the Lagrange polynomial and the costate variables at two ends of the time interval are taken as independent variables. Then, based on the dual variational principle, the nonlinear two-point boundary value problems are replaced by a system of nonlinear equations which can preserve the symplectic structure of the nonlinear optimal control problem. Furthermore, the computational efficiency of the proposed symplectic algorithm is improved by using the adaptive multi-level iteration idea. The performance of the proposed algorithm is tested by the problems of Astrodynamics, such as the optimal orbital rendezvous problem and the optimal orbit transfer between halo orbits.},
  langid = {english},
  keywords = {Adaptive symplectic algorithm,Astrodynamics,Dual variational principle,Halo orbits,Nonlinear optimal control,Two-point boundary value problem},
  annotation = {titleTranslation: 天体动力学中非线性两点边值问题的辛自适应算法\\
abstractTranslation: 从哈密顿观点出发，将非线性最优控制问题转化为非线性两点边值问题，并基于对偶变分原理提出了一种辛自适应算法来求解该非线性两点边值问题。采用拉格朗日多项式近似时间区间内的状态和协态变量，并将时间区间两端的协态变量作为独立变量。随后，基于对偶变分原理，用一组可保持非线性最优控制问题辛结构的非线性方程组替代了非线性两点边值问题。此外，通过自适应多层次迭代思想提高了所提辛算法的计算效率。通过航天动力学中的问题（如最优轨道交会问题和晕轨道间最优轨道转移问题）对所提算法的性能进行了测试},
  file = {/home/ouyangjiahong/Zotero/storage/CHWGYR7I/Peng 等 - 2011 - Symplectic adaptive algorithm for solving nonlinear two-point boundary value problems in astrodynami.pdf}
}


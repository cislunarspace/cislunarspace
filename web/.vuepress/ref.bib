@inproceedings{murakamiTrajectoryDesignRendezvous2015,
  title = {Trajectory Design for Rendezvous in Lunar Distant Retrograde Orbit},
  booktitle = {2015 {{IEEE Aerospace Conference}}},
  author = {Murakami, Naomi and Yamanaka, Koji},
  year = 2015,
  series = {2015 {{IEEE Aerospace Conference}}},
  address = {Big Sky},
  doi = {10.1109/AERO.2015.7119023},
  abstract = {This paper describes solutions to the lunar Distant Retrograde Orbit (DRO) rendezvous in terms of trajectory and launch window design. Our study is motivated by the future potential to construct a new space station or fuel refilling ports in the Earth-Moon neighborhood. A DRO, which has a long-term stability, is a possible candidate for the orbit in which such habitable structures are located. Since these structures have to rendezvous with visiting vehicles from Low Earth Orbit (LEO), it is valuable to investigate rendezvous technology in DROs. Our current study is focused on designing rendezvous trajectories which require reasonable operational cost, such as delta-v and flight time. Launch window analysis derived from trajectory design is also within the scope of this paper. We applied a three-impulse transfer with retrograde powered lunar gravity assist, and examined the total delta-v and flight time required to transfer from LEO to various phase points in a certain DRO. The results showed how a certain region where the {$\Delta$}V cost is low exists, and the flight time varies considerably according to the rendezvous point. We proposed an applicable launch window with these features in mind. We also conducted a case study to evaluate delta-v and the flight time required for rendezvous after the visiting vehicle is inserted into the DRO at a certain distance from the station. The result showed the potential to widen the option to rendezvous. In our study, trajectories are computed using Systems Tool Kit (STK) / Astrogator software module. Unlike a Circular Restricted Three-Body Problem (CRTBP) model, STK/Astrogator employs various force models and accurately integrates trajectories, which enables more realistic operation scenarios to be discussed.},
  langid = {english},
  keywords = {Biographies,Computational modeling,Earth,Jacobian matrices,Numerical models,Orbits,Vehicles},
  annotation = {我们采用结合逆行动力月球引力辅助的三脉冲转移方案，计算了从LEO转移至特定DRO中不同相位点所需的总速度增量与飞行时间。结果表明存在一个低{$\Delta$}V成本区域，且飞行时间随交会点位置变化显著。基于这些特征，我们提出了适用的发射窗口方案。此外，通过案例研究评估了访问飞行器在距离空间站特定位置进入DRO后实施交会所需的速度增量与飞行时间，结果显示该方法可拓展交会任务的选择空间。\\
本研究中所有轨道均采用Systems Tool Kit（STK）/ Astrogator软件模块进行计算。与圆型限制性三体问题（CRTBP）模型不同，STK/Astrogator采用多重力场模型并进行精确轨道积分，使得更贴近实际任务的场景讨论成为可能。\\
论文摘要：本文从轨迹与发射窗口设计角度阐述了月球远距离逆行轨道（DRO）交会解决方案。本研究受未来在地月邻近区域建造新空间站或燃料补给站的潜在需求驱动。具有长期轨道稳定性的DRO是此类宜居结构的可能部署轨道。由于这些设施需与来自近地轨道（LEO）的访问飞行器实现交会，研究DRO交会技术具有重要价值。当前研究聚焦于设计满足合理运营成本（如速度增量与飞行时间）的交会轨迹，基于轨迹设计的发射窗口分析亦在本文讨论范围内。我们采用结合逆行动力月球引力辅助的三脉冲转移方案，计算了从LEO转移至特定DRO中不同相位点所需的总速度增量与飞行时间。结果表明存在低{$\Delta$}V成本区域，且飞行时间随交会点位置显著变化。基于这些特征，我们提出了适用的发射窗口方案。此外，通过案例研究评估了访问飞行器在距空间站特定距离处进入DRO后实现交会所需的速度增量与飞行时间，结果显示该方案可拓展交会策略的选择空间。本研究使用系统工具包（STK）/Astrogator软件模块进行轨迹计算。相较于圆型限制性三体问题（CRTBP）模型，STK/Astrogator采用多种力学模型并进行高精度轨迹积分，使得更贴近实际任务的场景讨论成为可能。\\
abstractTranslation: 本文针对月球远距离逆行轨道（DRO）交会任务，从轨道设计与发射窗口规划两方面提出了解决方案。本研究的动机源于未来在地月空间建造新空间站或燃料补给站的可能性。DRO具有长期轨道稳定性，是此类可居住航天器部署轨道的潜在候选。由于这些设施需与来自近地轨道（LEO）的访问飞行器实施交会，研究DRO交会技术具有重要价值。当前研究聚焦于设计具有合理运营成本（如速度增量与飞行时间）的交会轨道。基于轨道设计推导发射窗口分析亦在本文讨论范围内。\\
titleTranslation: 月球远距离逆行轨道交会轨迹设计},
  file = {/home/ouyangjiahong/Zotero/storage/JSJBNHR9/Murakami和Yamanaka - 2015 - Trajectory design for rendezvous in lunar distant retrograde orbit.pdf}
}


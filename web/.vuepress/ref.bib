@article{asanoAnalysisPeriodmultiplyingBifurcations2022,
  title = {Analysis of Period-Multiplying Bifurcations of Distant Retrograde Orbits in the Hill Three-Body Problem},
  author = {Asano, Yuta and Satoh, Satoshi and Yamada, Katsuhiko},
  year = 2022,
  month = nov,
  journal = {Advances in Space Research},
  volume = {70},
  number = {10},
  pages = {3016--3033},
  issn = {02731177},
  doi = {10.1016/j.asr.2022.07.047},
  urldate = {2025-11-20},
  abstract = {In this study, the period-multiplying bifurcations of distant retrograde orbits (DROs) in the Hill three-body problem are analyzed. Simple planar DRO can be accurately approximated as elliptical motion by Fourier expansion, and the linearized equations describing motion around the approximate analytical solution of the DRO can be separated into in-plane and out-of-plane motions. An approximate analytical solution for the out-of-plane monodromy matrix can be obtained by Magnus expansion, while the in-plane monodromy matrix is calculated quasi-analytically by approximating the DRO as a generalized elliptic motion with non-constant angular velocity. The period-multiplying bifurcation conditions of the DRO family can be analyzed by examining the eigenvalues of the monodromy matrix. The relationship between the direction of the bifurcation and the derivative of the period at the bifurcation point is also analyzed. Finally, the branching family is calculated numerically.},
  langid = {english},
  keywords = {Distant retrograde orbit,Hill three-body problem,Period-multiplying bifurcation,Quasi satellite orbit},
  annotation = {titleTranslation: 希尔三体问题中远距离逆行轨道的倍周期分岔分析\\
abstractTranslation: 在本研究中，分析了希尔三体问题中远距离逆行轨道（DRO）的倍周期分岔。简单的平面DRO可通过傅里叶展开精确近似为椭圆运动，而描述DRO近似解析解附近运动的线性化方程可分解为面内运动和面外运动。通过马格努斯展开可获得面外单值矩阵的近似解析解，而面内单值矩阵则通过将DRO近似为具有非恒定角速度的广义椭圆运动进行准解析计算。通过分析单值矩阵的特征值，可研究DRO族的倍周期分岔条件，同时分析了分岔方向与分岔点处周期导数之间的关系。最后，通过数值方法计算了分支族。},
  file = {/home/ouyangjiahong/Zotero/storage/938PNGCA/Asano 等 - 2022 - Analysis of period-multiplying bifurcations of distant retrograde orbits in the hill three-body prob.pdf}
}


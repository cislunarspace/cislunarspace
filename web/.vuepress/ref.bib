@article{CuiZhiYingJiYuHEOXingZuoZengQiangDeDiYueKongJianBeiDouGNSSDingWeiXingNengFenXi2025,
  title = {{基于HEO星座增强的地月空间北斗/GNSS定位性能分析}},
  author = {{崔志颖} and {王猛} and {王宇丰} and {刘昂} and {邢康} and {段立昌} and {董启甲}},
  year = 2025,
  journal = {导航定位与授时},

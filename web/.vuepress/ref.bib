@article{jorbaDynamicsCenterManifold1999,
  title = {Dynamics in the Center Manifold of the Collinear Points of the Restricted Three Body Problem},
  author = {Jorba, {\`A}ngel and Masdemont, Josep},
  year = 1999,
  month = jul,
  journal = {Physica D: Nonlinear Phenomena},
  volume = {132},
  number = {1-2},
  pages = {189--213},
  issn = {01672789},
  doi = {10.1016/S0167-2789(99)00042-1},
  urldate = {2025-11-06},
  abstract = {This paper focuses on the dynamics near the collinear equilibrium points L1,2,3 of the spatial Restricted Three Body Problem (RTBP). It is well known that the linear behavior of these three points is of the type center\texttimes center\texttimes saddle. To obtain an accurate description of the dynamics in an extended neighborhood of those points, two different (but complementary) strategies are used. First, the Hamiltonian of the problem is expanded in power series around the equilibrium point. Then, a partial normal form scheme is applied in order to uncouple (up to high order) the hyperbolic directions from the elliptic ones. Skipping the remainder we have that the (truncated) Hamiltonian has an invariant manifold tangent to the central directions of the linear part. The restriction of the Hamiltonian to this manifold is the so-called reduction to the center manifold. The study of the dynamics of this reduced Hamiltonian (now with only two degrees of freedom) gives a qualitative description of the phase space near the equilibrium point. Finally, a Lindstedt--Poincar\'e procedure is applied to explicitly compute the invariant tori contained in the center manifold. These tori are obtained as the Fourier series of the corresponding solutions, the frequencies being a power expansion of some parameters (amplitudes). This allows for an accurate quantitative description of these regions. In particular, the well known Halo orbits are obtained. \copyright 1999 Elsevier Science B.V. All rights reserved.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid = {english},
  annotation = {titleTranslation: 限制性三体问题共线点中心流形内的动力学特性\\
abstractTranslation: 本文研究空间限制性三体问题（RTBP）中共线平衡点L1、L2、L3附近的动力学行为。众所周知，这三个点的线性行为属于中心\texttimes 中心\texttimes 鞍点类型。为了精确描述这些点扩展邻域内的动力学，采用了两种不同但互补的策略。首先，将问题的哈密顿量在平衡点周围展开为幂级数。然后，应用部分正规形方案，以（高阶）解耦双曲方向与椭圆方向。忽略余项后，（截断的）哈密顿量具有一个与线性部分中心方向相切的 invariant 流形。哈密顿量在该流形上的限制称为中心流形约化。研究这个约化后的哈密顿量（现仅有二自由度）的动力学，可定性描述平衡点附近的相空间。最后，应用Lindstedt--Poincar\'e方法显式计算中心流形中包含的 invariant 环面。这些环面通过对应解的傅里叶级数获得，其频率是某些参数（振幅）的幂展开。这使得能够对这些区域进行精确的定量描述。特别地，著名的Halo轨道得以求解。\copyright 1999 Elsevier Science B.V. 版权所有。},
  file = {/home/ouyangjiahong/Zotero/storage/Q9ESNT7Q/Jorba和Masdemont - 1999 - Dynamics in the center manifold of the collinear points of the restricted three body problem.pdf}
}


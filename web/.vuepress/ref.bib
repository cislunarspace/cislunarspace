@article{canaliasComputingNaturalTransfers2008,
  title = {Computing Natural Transfers between Sun--Earth and {{Earth}}--Moon Lissajous Libration Point Orbits},
  author = {Canalias, Elisabet and Masdemont, Josep J.},
  year = 2008,
  month = jul,
  journal = {Acta Astronautica},
  volume = {63},
  number = {1-4},
  pages = {238--248},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2007.12.017},
  urldate = {2025-11-27},
  abstract = {The four body problem Sun--Earth--Moon--spacecraft can be decoupled, in a raw first approximation, in two restricted three body problems (RTBPs): the Sun.Earth + Moon (SE) and the Earth--Moon (EM). Using the hyperbolic manifolds of the libration orbits of both problems and intersecting them in an adequate way, trajectories joining the solar and lunar libration regions can be found. Unfortunately, however, the coupling of two different RTBPs does not correspond to the physical reality of the Sun, Earth and Moon relative motions. Therefore, the initial trajectories obtained in the simplified model have to be refined to more realistic models. The present work introduces a way to compute connecting trajectories between EM and SE L2 Lissajous type orbits, starting from a simple model which couples two RTBP and refining them to JPL ephemeris. Furthermore, the refinement of the trajectories is tackled in such a way that the cost of the coupling is iteratively reduced, while the trajectory is kept similar to the original one in the coupled RTBPs. As a result, zero cost or natural connecting trajectories are obtained when possible. For less favourable cases, the outcome of the method are connecting trajectories which need a maneuver at the coupling point, always below 100 m/s of total v.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid = {english},
  annotation = {titleTranslation: 太阳-地球与地-月系利萨茹平动点轨道间自然转移轨道的计算\\
abstractTranslation: 太阳-地球-月球-航天器四体问题可以在粗略的一级近似中解耦为两个限制性三体问题：日-地+月系统和地月系统。利用这两个问题中平动点轨道的双曲流形并以适当方式相交，可以找到连接太阳系平动点区域和月球平动点区域的轨道。然而，两个不同限制性三体问题的耦合并不对应太阳、地球和月球相对运动的物理现实。因此，在简化模型中获得的初始轨道需要精化到更真实的模型。本文介绍了一种计算地月系统与日-地+月系统L2李萨如型轨道之间连接轨道的方法，该方法从耦合两个限制性三体问题的简单模型出发，并将其精化至JPL星历。此外，轨道的精化过程使得耦合代价迭代降低，同时保持轨道与耦合限制性三体问题中的原始轨道相似。由此，在可行情况下可获得零代价或自然连接轨道。对于较不利的情况，该方法的结果是在耦合点需进行机动的连接轨道，其总速度增量始终低于100 m/s。},
  file = {/home/ouyangjiahong/Zotero/storage/WN8RSDS8/Canalias和Masdemont - 2008 - Computing natural transfers between sun–earth and Earth–moon lissajous libration point orbits.pdf}
}

@article{canaliasScatteringMapPlanar2006,

@phdthesis{ShaoWenKunBianXiShiDiMianYiDongJiQiRenMuBiaoGenZongFangFaYanJiu2006,
  type = {{硕士学位论文}},
  title = {{便携式地面移动机器人目标跟踪方法研究}},
  author = {{邵文坤}},
  year = 2006,
  address = {长沙},
  urldate = {2025-10-07},
  abstract = {复杂背景下实时目标的识别与跟踪属于自动目标识别(ATR)研究领域，包括对目标的分割、特征提取和目标识别等几个方面。当前对运动目标检测与跟踪的研究虽已取得一定进展，但由于运动目标经常处于室外多样的自然环境中，因此如何从复杂背景中检测和跟踪运动目标，且能满足实时处理的要求，仍是本领域研究的热点。     首先，本文对现有的目标跟踪方法进行了归纳分类，概述了各种方法的基本原理，并从算法内容、假设条件、先验知识、理论计算量、实现难点及改进措施等方面对几种典型跟踪算法进行了系统性分析，进而提出具体情况下目标跟踪方法的选择依据。     其次，针对移动机器人目标跟踪的动态变化场景，本文将相关匹配算法中的加速算法与模板更新算法进行了有效的结合，提出了特征约束的模板更新跟踪算法。该算法的基本思想是在指定模板粗匹配的基础上，辅以形状判别方法来确定具体跟踪点位置并将其作为更新模板的依据。优点是既减少了相关匹配的计算量，又提高了目标识别的准确度。实验结果表明，该算法简单稳定，具有较好的跟踪效果，可以通过软件实时实现，并可以解决障碍物部分遮挡的问题，在实践中有重要意义。     最后，研究了在目标和成像系统都运动的情况下，如何运用目标特征点的透视投影成像模型获取目标的空间位置和运动参数等三维信息。首先通过实验分析了二次成像法获取目标深度信息的缺陷，然后针对陆地跟踪目标，基于目标深度信息恢复原理，建立了机器人成像几何模型，提出了目标特殊点三维坐标恢复方法，同时完成了目标跟踪点的跟踪和预报，并进行了实验验证。},
  collaborator = {{韦庆}},
  langid = {chinese},
  school = {国防科学技术大学},
  annotation = {album: 信息科技\\
CLC: TP242\\

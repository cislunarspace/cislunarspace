@article{xiongSimplifiedPathSearching2020,
  title = {A Simplified Path Searching and Correcting Method for the Calculation of Initial Value of Libration Periodic Orbit},
  author = {Xiong, Yao and Yuan, Hong and Yang, Xin and Zhang, Yang and Gan, Qingbo},
  year = 2020,
  journal = {Chinese Journal of Space Science},
  volume = {Vol.40},
  number = {No.1},
  pages = {102--108},
  doi = {10.11728/cjss2020.01.102},
  abstract = {In the restricted three-body problem, the path searching and correcting method is often used to calculate the approximate initial value of planar and three-dimensional periodic orbit. In this paper, in view of the Circular Restricted Three-Body Problem (CRTBP), a simplified mode of this method is applied to calculate the approximate initial value of several ordinary kinds of periodic orbit. The results show that the approximate initial value obtained by the simplified method is not unique, and the precise initial values derived from the unique values above using differential correction method often include both Halo and DRO (Distant Retrograde Orbit) orbits. Moreover, under certain boundary initial values, Halo orbit will disappear from the results and the planar Lyapunov orbit or Vertical orbit will appears. The relationship between these initial values using in this method and the certain kinds of orbit needs further study.},
  langid = {english},
  keywords = {Circular restricted three-body problem,Distant retrograde orbit,Halo orbit,Libration Periodic orbit,Path searching and correcting method},
  annotation = {titleTranslation: 一种用于计算平动点周期轨道初值的简化路径搜索与修正方法\\
abstractTranslation: 在限制性三体问题中，路径搜索与校正方法常被用于计算平面及三维周期轨道的近似初值。本文针对圆型限制性三体问题（CRTBP），采用该方法的简化模式计算了几类常见周期轨道的近似初值。结果表明，简化方法所得近似初值并非唯一，而基于这些唯一初值使用微分校正方法获得的精确初值常同时包含Halo轨道与DRO（远距离逆行轨道）。此外，在特定边界初值条件下，Halo轨道会从结果中消失，转而出现平面Lyapunov轨道或垂直轨道。该方法中这些初值与特定轨道类型之间的关系有待进一步研究。}
}


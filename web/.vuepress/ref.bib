  annotation = {titleTranslation: 基于双平均模型的木卫四轨道寿命图\\
abstractTranslation: 本文研究了绕其母行星运行的卫星周围的轨道寿命。在内限制性三体问题的背景下，本研究采用的动力学模型利用了航天器在椭圆轨道上受第三体引力扰动下绕卫星运动的双平均动力学，同时考虑了卫星质量非均匀分布的影响。通过针对 Callisto--航天器--Jupiter 系统的数值实验进行了应用，并呈现了不同扰动体（Jupiter）偏心率下的寿命图，以探究该参数在这些图中的角色。其思路是模拟一个与 Jupiter--Callisto 系统物理参数相同、但具有更大偏心率的系统。这些图还有助于验证和改进现有文献中的结果，例如寻找条件，以延长无质量轨道体在系统内其他天体的引力扰动下处于高倾角轨道的可用时间},
  file = {/home/ouyangjiahong/Zotero/storage/L9QVRJXS/Cardoso dos Santos 等 - 2017 - Lifetime maps for orbits around callisto using a double-averaged model.pdf}
}

@article{caritaImageClassificationRetrograde2024,
  title = {Image Classification of Retrograde Resonance in the Planar Circular Restricted Three-Body Problem},
  author = {Carit{\'a}, G. A. and Aljbaae, S. and Morais, M. H. M. and Signor, A. C. and Carruba, V. and Prado, A. F. B. A. and Hussmann, H.},
  year = 2024,
  month = apr,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {2},
  pages = {10--34},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10181-8},
  urldate = {2025-10-01},
  abstract = {The study of resonances in celestial mechanics is crucial for understanding the dynamics of planetary or stellar systems. This study focuses on presenting a method for investigating the topology and resonant structures of a dynamical system. To illustrate the strength of the method, we have applied our method to retrograde resonances in the planar circular restricted three-body problem within binary star systems. Because of the high mass ratio systems, the techniques based on perturbation of the two-body orbit are not the ideal to analyze the system. Consequently, resonant angles could be meaningless, necessitating alternative methods for resonance identification. To address this challenge, an image classificationbased machine learning model is implemented to identify resonances based on the shape of orbits in the rotating frame. Initially, the model is trained on empirical cases with low mass ratios using the resonant angle as a starting point for resonance identification. The model's performance is validated against existing literature results. The model results demonstrate successful classification and identification of retrograde resonances in both empirical and non-empirical cases. The model accurately captures the resonance patterns and provides initial insights into the short-term stability of the corresponding resonances.},
  langid = {english},
  annotation = {titleTranslation: 平面圆型限制性三体问题中逆共振的图像分类。\\
abstractTranslation: 天体力学中共振的研究对于理解行星或恒星系统的动力学至关重要。本研究旨在提出一种方法来探究动力系统的拓扑结构和共振结构。为展示该方法的有效性，我们将其应用于双星系统中平面圆形限制性三体问题的逆行共振。由于系统质量比较高，基于二体轨道摄动的技术并非分析此类系统的理想选择，因此共振角可能失去意义，需要采用替代方法进行共振识别。为应对这一挑战，我们实现了一种基于图像分类的机器学习模型，通过旋转坐标系中的轨道形状来识别共振。模型首先以低质量比的经验案例进行训练，以共振角作为共振识别的起点。模型的性能通过与现有文献结果进行对比验证。模型结果显示，无论是经验案例还是非经验案例，都能成功分类并识别逆行共振。该模型准确捕捉了共振模式，并初步揭示了相应共振的短期稳定性。},
  file = {/home/ouyangjiahong/Zotero/storage/IM7F7BHS/Caritá 等 - 2024 - Image classification of retrograde resonance in the planar circular restricted three-body problem.pdf}
}


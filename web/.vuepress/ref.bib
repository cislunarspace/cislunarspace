@article{quattrucciImplementationStudyDrag2023,
  title = {Implementation and Study of a Drag Model for an {{N-body}} Problem Simulator},
  author = {Quattrucci, R. D. and Meireles, L. G. and Pereira, M. C.},
  year = 2023,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {1},
  pages = {5},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-022-10119-y},
  urldate = {2025-10-01},
  abstract = {Planet Earth is a constant target to various astronomical objects. Larger ones manage to overcome the natural barrier imposed by the atmosphere, colliding with the ground and causing damage to Earth's surface. With these events in mind, this work proposed the implementation of several modules for a previously existing N-body simulator in Python\textregistered{} to study the entry of multiple objects into the Earth's atmosphere and analyze the effects of possible impact scenarios. Among the modules implemented are a coordinate converter to the Earth-Centered Earth-Fixed (ECEF) reference frame, an atmospheric density model along with its corresponding drag force, a fragmentation/disintegration evaluation from the objects interaction with Earth's atmosphere (based on a stochastic model specifically applied for the purposes of this study), an impact radius calculator and, finally, ECEF trajectory and impact zone visualization. From the possibility of fragmentations (addition of bodies) or disintegrations (removal of bodies), the algorithm developed also made it possible to run numerical integrations with a variable number of objects, dynamically updating the number of bodies and equations of motion mid simulation. At last, a few case studies were executed to generate results that made it possible to evaluate the successful implementation of all the modules.},
  langid = {english},
  annotation = {titleTranslation: N体问题模拟器阻力模型的实现与研究。\\
abstractTranslation: 地球 constantly 受到各种天体的撞击。较大的天体能够突破大气层这一天然屏障，与地面相撞并对地球表面造成破坏。基于这些事件，本研究提出在现有的Python\textregistered{} N体模拟器中集成多个模块，用于研究多个天体进入地球大气层的过程，并分析可能的撞击场景效应。所实现的模块包括：坐标转换器（转换至地心地固坐标系ECEF）、大气密度模型及其对应的阻力模型、基于随机模型的碎裂/解体评估（该模型专为本研究目的而设计）、撞击半径计算器，以及ECEF轨迹与撞击区域可视化模块。由于算法支持碎裂（增加天体）或解体（移除天体），该算法还能实现可变数量天体的数值积分，在模拟过程中动态更新天体数量及其运动方程。最后，通过若干案例研究生成结果，验证了所有模块的成功实现。},
  file = {/home/ouyangjiahong/Zotero/storage/D4NDFQ64/Quattrucci 等 - 2023 - Implementation and study of a drag model for an N-body problem simulator.pdf}
}


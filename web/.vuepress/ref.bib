@article{luoOptimizationMultipleimpulseMinimumtime2006,
  title = {Optimization of Multiple-Impulse Minimum-Time Rendezvous with Impulse Constraints Using a Hybrid Genetic Algorithm},
  author = {Luo, Ya-Zhong and Tang, Guo-Jin and Li, Hai-yang},
  year = 2006,
  month = sep,
  journal = {Aerospace Science and Technology},
  volume = {10},
  number = {6},
  pages = {534--540},
  issn = {1270-9638},
  doi = {10.1016/j.ast.2005.12.007},
  urldate = {2026-01-28},
  abstract = {The minimum-time multiple-impulse rendezvous with impulse constraints is investigated in this paper. Based on the Clohessy--Wiltshire (C--W) equations, an optimization model including several different kinds of impulse constraints such as the maximum impulse magnitude, the total velocity change magnitude and the time of imposing impulse for multiple-impulse minimum-time rendezvous is established. A generalized inverse matrix solution for linear equation is applied to avoid handling the terminal equality constraints. In order to obtain the global solution efficiently, a hybrid optimizer combining the advantages of a floating-coded genetic algorithm and simplex method is employed. A low-earth orbit multiple-impulse rendezvous problem is used as an example. The influence of the number of impulses, the optimization variables and the constraints on the solution is analyzed, and the different optimization algorithms are compared. Results indicate our proposed model and approach is effective in designing linearized minimum-time rendezvous trajectory with impulse constraints.},
  langid = {english},
  keywords = {Genetic algorithm,Global optimization,Impulse constraints,Minimum-time,Multiple-impulse rendezvous},
  annotation = {titleTranslation: 基于混合遗传算法的脉冲约束下多脉冲最短时间交会优化\\
abstractTranslation: 本文研究了具有冲量约束的最小时间多次冲量交会问题。基于Clohessy--Wiltshire（C--W）方程，建立了包含多种冲量约束（如最大冲量幅值、总速度变化量及冲量施加时刻）的多次冲量最小时间交会优化模型。采用线性方程广义逆矩阵解法以避免处理终端等式约束。为高效获取全局解，结合浮点编码遗传算法与单纯形法的优势，设计了一种混合优化器。以近地轨道多次冲量交会问题为例，分析了冲量次数、优化变量及约束条件对解的影响，并对比了不同优化算法。结果表明，所提出的模型与方法在求解带有冲量约束的线性化最小时间交会轨迹时是有效的},
  file = {/home/ouyangjiahong/Zotero/storage/LCUA2GEQ/S1270963806000162.html}
}


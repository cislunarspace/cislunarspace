@article{GuoXiaoZhongRiYueGuiDaoJiSuanDuiTLEShenKongBianMuMuBiaoYuBaoJingDuDeYingXiang2022,
  title = {{{日月轨道计算对TLE深空编目目标预报精度的影响}}},
  author = {{郭效忠} and {李佳威} and {沈鸣} and {高鹏骐} and {杨大陶} and {于欢欢} and {赵有}},
  year = 2022,
  journal = {天文学报},
  number = {第6期},
  pages = {103--112},
  abstract = {双行根数（Two Line Element,TLE）作为一类广泛使用的空间物体编目数据,其预报精度和误差特性是TLE编目在空间碎片研究中所要关注的问题之一.TLE编目需要配合SGP4/SDP4（Simplified General Perturbations 4/Simplified Deep Space 4）模型进行轨道预报,对深空物体来说,主要考虑带谐项J\textexclamdown sub\textquestiondown 2\textexclamdown/sub\textquestiondown 、J\textexclamdown sub\textquestiondown 3\textexclamdown/sub\textquestiondown 、J\textexclamdown sub\textquestiondown 4\textexclamdown/sub\textquestiondown 摄动、第三体日月摄动和特殊轨道共振问题修正等.其中,SGP4/SDP4模型第三体摄动计算时,对日月轨道近似采用了长期进动根数和简单平运动的方式,在外推10d时存在约2{$^\circ$}-3{$^\circ$}的日月位置偏差.日月轨道计算可选用更加精确的方法来改进初始位置估计,并根据日月运动规律的不同,对太阳轨道采用平运动近似,对月球轨道采用计算真近点角近似,在外推10 d时,二者位置偏差可分别减小到约1'-2'和15'-20'范围.采用激光测距卫星Etalon1、伽利略卫星导航系统Galileo 23卫星作为对比算例,结果分析表明二者原始的TLE编目轨道进行预报时存在明显的位置误差异常变化趋势;采用日月轨道计算改进后,重新定轨得到的``改进''编目具有更加精确的轨道预报结果.},
  keywords = {;SGP4/SDP4;:}
}


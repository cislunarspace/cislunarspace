@article{aydinConleyZehnderIndices2023,
  title = {The Conley--Zehnder Indices of the Spatial Hill Three-Body Problem},
  author = {Aydin, Cengiz},
  year = 2023,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {3},
  pages = {32},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10134-7},
  urldate = {2025-10-01},
  abstract = {We explore the interaction between the Conley--Zehnder index and bifurcation points of symmetric planar as well as spatial periodic orbits in the spatial Hill three-body problem. We start with the fundamental families of planar periodic orbits which are those of direct (family g) and retrograde periodic orbits (family f ). Since the spatial system is invariant under a symplectic involution, whose fixed point set corresponds to the planar problem, planar orbits have planar and spatial Floquet multipliers, and planar and spatial Conley--Zehnder indices. When the Floquet multipliers move through a root of unity, new families of periodic orbits bifurcate and the index jumps. For very low energies, the families g and f arise dynamically from the rotating Kepler problem, and in a recent work (Aydin From Babylonian lunar observations to Floquet multipliers and Conley-Zehnder Indices) we determined analytically their indices. By their numerical continuations for higher energies, we determine the index of various families of planar and spatial periodic orbits bifurcating from g and f . Since these families can bifurcate again and meet each other, this procedure can get complicated. This index leads to a grading on local Floer homology. Since the local Floer homology and its Euler characteristic stay invariant under bifurcation, the index provides important information about the interconnectedness of such families, which we illustrate in form of bifurcation graphs. Since the solutions of Hill's system may serve as orbits for space mission design or astronomical observations, our results promote the interaction between Symplectic Geometry and practical problems.},
  langid = {english},
  annotation = {titleTranslation: 空间希尔三体问题的康利--泽伦德指标\\
abstractTranslation: 我们探讨空间Hill三体问题中Conley--Zehnder指数与对称平面及空间周期轨道分岔点之间的相互作用。首先从平面周期轨道的基本族入手，即顺行周期轨道（g族）与逆行周期轨道（f族）。由于空间系统在辛对合下保持不变，且该对合的不动点集对应于平面问题，因此平面轨道同时拥有平面与空间的Floquet乘子，以及平面与空间的Conley--Zehnder指数。当Floquet乘子经过单位根时，新的周期轨道族发生分岔，指数随之跃变。在极低能量下，g族与f族动力学上源于旋转Kepler问题，我们在近期工作（Aydin，《从巴比伦月球观测到Floquet乘子与Conley--Zehnder指数》）中解析确定了它们的指数。通过数值延拓至高能量，我们确定了从g族与f族分岔出的各类平面及空间周期轨道族的指数。由于这些族可能再次分岔并相互交汇，该过程可能变得复杂。该指数为局部Floer同调提供了分级结构。由于局部Floer同调及其欧拉特征标在分岔下保持不变，指数为此类轨道族间互连性提供了重要信息，我们以分岔图形式加以说明。鉴于Hill系统的解可作为航天任务设计或天文观测的轨道，我们的研究成果促进了辛几何与实际问题的互动。},
  file = {/home/ouyangjiahong/Zotero/storage/4TVMDXGL/Aydin - 2023 - The conley–zehnder indices of the spatial hill three-body problem.pdf}
}


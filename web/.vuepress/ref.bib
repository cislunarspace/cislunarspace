@article{YangZeLongMeiGuoTaiKongJiaoTongXieDiaoXiTongJinZhanFenXi2024,
  title = {{美国太空交通协调系统进展分析}},
  author = {{杨泽龙} and {李鸿飞} and {王晓晨} and {张明江} and {韩洪波} and {张昊鹏}},
  year = 2024,
  journal = {国际太空},
  number = {12},
  pages = {36--40},
  urldate = {2026-05-11},
  abstract = {{$<$}正{$>$}太空交通协调系统（TraCSS）是美国商务部下属太空商务办公室主导的空间态势感知（SSA）数据及太空交通协调服务平台。2018年，美国出台了太空领域指导性法律政策文件《航天政策3号令》（SPD-3），指定商务部接替国防部承担其当前所负责的空间态势感知数据和太空交通协调服务提供角色。此后，TraCSS经历了长时间的宣传、论证，目前已与美国军方数据和服务进行了初步整合，发布了相关商业合同和多次行业征询，并于近期发布了第一版试用系统，正处于论证与建设的关键时期。美国对TraCSS的大力建设与推广，将使其在技术发展、数据累积、规则制定、国际合作等方面扩大优势。针对紧迫的空间态势感知领域竞争，文章在积极跟进美国TraCSS最前沿进展的同时，对其体系结构、构建过程、数据协议等内容进行分析，对其影响进行研判，并提出相关发展建议。},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/MMGRA7UA/杨泽龙 等 - 2024 - 美国太空交通协调系统进展分析.pdf}
}


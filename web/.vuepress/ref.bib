  abstract = {The stable distant retrograde orbits (DROs) around the Moon are considered as potential parking orbits for cislunar stations that are important facilities in cislunar space. Transfer orbits from DROs to lunar orbits will be fundamental and routine for operations of the cislunar stations. This paper studies transfer orbits from DROs to low lunar orbits with inclinations between 0{$^\circ$} and 90{$^\circ$}. Ten DROs are selected for the construction of transfers. The planar transfer orbits from each DRO to the LLO with zero inclination are firstly obtained and compared in the planar circular restricted three-body problem (PCR3BP) to reveal basic characteristics of the transfer solutions. The planar transfers are classified into several types based on characteristics. Each type is discussed in details, especially their transfer cost and time. Based on the planar transfers, nonplanar transfer orbits are constructed in the circular restricted three-body problem (CR3BP). Some nonplanar transfers are selected and compared to show effects of the LLO inclination. Then, the planar transfer orbits are refined in the planar bicircular restricted four-body problem (PBR4BP) with the gravity of the Sun. The comparison between results in the PCR3BP and PBR4BP shows that the gravity of the Sun can increase transfer options and reduce the transfer cost. Further analysis is carried out based on the realistic results in the PBR4BP, including the ballistic capture, departure and insertion locations, transfer cost and time, etc. The results are useful for selecting parking DROs and designing transport systems to the Moon.},
  langid = {english},
  keywords = {Bicircular restricted four-body problem,Circular restricted three-body problem,Distant retrograde orbits,Low lunar orbits,Optimization,Transfer orbits},
  annotation = {titleTranslation: 从远距离逆行轨道至低月球轨道的转移},
  file = {/home/ouyangjiahong/Zotero/storage/BFXB5FI8/Zhang 等 - 2020 - Transfers from distant retrograde orbits to low lunar orbits.pdf}
}

@article{zhangTransfersLunarDROs2021,
  title = {The Transfers from Lunar {{DROs}} to {{Earth}} Orbits via Optimization in the Four Body Problem},
  author = {Zhang, Ruikang and Wang, Yue and Zhang, Chen and Zhang, Hao},
  year = 2021,
  month = jun,
  journal = {Astrophysics and Space Science},
  volume = {366},
  number = {6},
  pages = {49},
  issn = {1572-946X},
  doi = {10.1007/s10509-021-03955-1},
  abstract = {The distant retrograde orbits (DROs) can serve as the parking orbits for a long-term cis-lunar space station. This paper gives a comprehensive study on the transfer problem from DROs to Earth orbits, including low Earth orbits (LEOs), medium Earth orbits (MEOs), and geosynchronous orbits (GSOs), in the bicircular restricted four-body problem (BR4BP) via optimizations within a large solution space. The planar transfer problem is firstly solved by grid search and optimization techniques, and two types of transfer orbits, direct ones and low-energy ones, are both constructed. Then, the nonplanar transfer problem to Earth orbits with inclinations between 0 and 90 degrees are solved via sequential optimizations based on the planar transfers. The transfer characteristics in the cases of different destination orbit inclinations are discussed for both the direct and the low-energy transfer orbits. The important role of the lunar gravity in the low-energy transfers is also discussed, which can overcome the increase of transfer cost caused by the high inclination of Earth orbits. The distinct features of different transfer scenarios, including multiple revolutions around the Earth and Moon, the exterior phase, and the lunar flyby, are discovered. The energy of transfer orbits is exploited to discuss the effects of close lunar flybys. The results will be helpful for the transfer design in future manned or unmanned return missions, and can also provide valuable information for selecting proper parking DROs for cis-lunar space stations.},
  langid = {english},
  keywords = {Bicircular restricted four-body problem,Distant retrograde orbits,Earth orbits,Lunar flyby,Optimization,Transfer problem},
  annotation = {titleTranslation: 基于四体问题优化的月球DRO至地球轨道转移\\
abstractTranslation: 远距离逆行轨道（DROs）可作为长期运行的地月空间站停泊轨道。本文在双圆型限制性四体问题（BR4BP）框架下，通过大解空间内的优化方法，系统研究了从DRO至地球轨道（包括低地球轨道LEO、中地球轨道MEO及地球同步轨道GSO）的转移问题。首先采用网格搜索与优化技术解决了平面转移问题，构建了直接转移与低能量转移两类转移轨道；进而基于平面转移方案，通过序列优化方法解决了目标轨道倾角为0至90度的非共面转移问题。针对直接转移与低能量转移轨道，分别探讨了不同目标轨道倾角下的转移特性，并分析了月球引力在低能量转移中的关键作用------其能有效抵消地球轨道高倾角带来的转移能耗增加。研究揭示了多种转移场景的显著特征，包括绕地/绕月的多圈飞行、外部相位段及月球飞越过程，并通过转移轨道能量分析了近月飞越的效应。研究成果可为未来载人或无人返回任务的转移轨道设计提供参考，并为地月空间站选择适宜的DRO停泊轨道提供重要依据。},
  file = {/home/ouyangjiahong/Zotero/storage/HUS8YBES/Zhang 等 - 2021 - The transfers from lunar DROs to Earth orbits via optimization in the four body problem.pdf;/home/ouyangjiahong/Zotero/storage/8RPBAZRK/s10509-021-03955-1.html}
}

@inproceedings{zhangTransfersRectilinearHalo2021,
  title = {The Transfers between near Rectilinear Halo Orbits and Distant Retrograde Orbits in the {{Earth-moon}} System},
  booktitle = {Astrodynamics {{Symposium}}},
  author = {Zhang, Ruikang and Wang, Yue and Zhang, Chen and Zhang, Hao},
  year = 2021,
  series = {Astrodynamics {{Symposium}}},
  address = {United Arab Emirates},
  abstract = {The stable distant retrograde orbits (DROs) and near rectilinear halo orbits (NRHOs) are both considered as potential parking orbits for cis-lunar space stations. Transfer orbits between NRHOs and DROs will be helpful for exploitation of their advantages, and possible cooperations between cis-lunar space stations in different kinds of orbits. Due to the symmetry in the circular restricted three body problem (CR3BP), the transfers between NRHOs and DROs can be represented by the transfers from southern NRHOs to DROs. which are obtained by using the search and optimization methods. In the optimization, the curve fitting technique is combined with the direct transcription and multiple shooting strategies to construct the nonlinear programming (NLP) problem. The transfer orbits with and without an exterior phase are both found. The transfer orbits with an exterior phase could have lower transfer cost but longer transfer time than those without exterior phase. Some transfer orbits with the local minimum transfer cost are selected, and found to have a lower transfer cost compared with previous results, especially in the cases of transfer orbits from the NRHO (L1). The comparison between transfer orbits from the NRHOs (LI and L2) indicates that the transfer costs from the NRHO (LI) are lower. The results are of significance for the construction of connections between cis-lunar space stations, and for designing transport systems in the Earth-Moon system.},
  langid = {english},
  annotation = {titleTranslation: 地月系统中近直线晕轨道与远距离逆行轨道间的转移}
}


@article{ZhaoJunRiDiXiTongL2DianHaloGuiDaoShengXiWeiXingBianDuiDongLiXue2010,
  title = {{{日地系统L2点Halo轨道绳系卫星编队动力学}}},
  author = {{赵军} and {蔡志勤} and {齐朝晖} and {黄琳琳}},
  year = 2010,
  journal = {应用力学学报},
  number = {第1期},
  pages = {1-7，219},
  abstract = {研究平动点附近周期轨道上旋转多体绳系卫星编队系统的非线性耦合动力学问题。编队系统为各卫星质量接近的轮辐状结构,位于日地系统第二平动点附近,整个系统的旋转保持系绳处于张紧状态,建立Hill限制性三体问题的绳系编队系统动力学模型。针对处于留位阶段的典型对称三星编队,在位于较大Halo轨道上无控制力作用的情况下,进行母卫星轨道运动与系绳摆动耦合运动的动力学模拟,分析轨道方向、卫星质量比、系绳长度以及初始旋转速度对编队系统整体稳定性的影响。},
  keywords = {Hill;;;}
}

@article{zhaoLearningbasedAlgorithmTurnbased2025,
  title = {A Learning-Based Algorithm for Turn-Based Orbital Pursuit-Evasion Problem with Reaction-Time Delay},
  author = {Zhao, Liran and Sun, Qinbo and Xu, Sihan and Dang, Zhaohui},
  year = 2025,
  month = apr,
  journal = {Engineering Applications of Artificial Intelligence},
  volume = {145},
  pages = {110231},
  issn = {0952-1976},
  doi = {10.1016/j.engappai.2025.110231},
  urldate = {2026-03-08},
  abstract = {In this paper, we propose an artificial intelligence-based methodology to investigate the impulsive orbital pursuit-evasion problem, taking into account the often-neglected factor of reaction time delay. This study defines this scenario as a Delayed Turn-based Orbital Pursuit-Evasion Game (DT-OPEG) and establishes relevant concepts and definitions based on orbital dynamics and game theory. Subsequently, considering several constraints inherent in real-world missions, including nonlinear orbital dynamics, maneuvering capabilities, fuel reserves, and mission duration, we formulate the problem modeling for DT-OPEG. To address the complexity of this problem, especially the challenge of incorporating action delays, we propose a Delayed Turn-based Multi-Agent Deep Deterministic Policy Gradient (DT-MADDPG) algorithm. The establishment process of this algorithm includes establishing a Turn-based Markov Decision Process (T-MDP) model with reaction-time delay, constructing a turn-based training framework, developing a network architecture based on MADDPG, and designing reward functions. Finally, simulation analyses are conducted for both two-dimensional and three-dimensional DT-OPEG scenarios, confirming the effectiveness of the proposed algorithm and demonstrating the winning mechanism in this type of game.},
  langid = {english},
  keywords = {Multi-agent reinforcement learning,Orbital pursuit-evasion game,Reaction-time delay,Turn-based},
  annotation = {titleTranslation: 基于反应时延的回合制轨道追逃问题学习算法\\
abstractTranslation: 本文提出了一种基于人工智能的方法，用于研究脉冲式轨道追击-逃逸问题，并考虑了常被忽略的反应时间延迟因素。本研究将此场景定义为延迟回合制轨道追击-逃逸博弈（DT-OPEG），并基于轨道动力学与博弈论建立了相关概念与定义。随后，结合实际任务中的若干约束条件，包括非线性轨道动力学、机动能力、燃料储备及任务时长，我们构建了DT-OPEG的问题模型。为解决该问题的复杂性，尤其是引入动作延迟所带来的挑战，我们提出了一种延迟回合制多智能体深度确定性策略梯度（DT-MADDPG）算法。该算法的构建过程包括：建立含反应时间延迟的回合制马尔可夫决策过程（T-MDP）模型、构建回合制训练框架、开发基于MADDPG的网络架构以及设计奖励函数。最后，针对二维与三维DT-OPEG场景进行了仿真分析，验证了所提算法的有效性，并揭示了该类博弈中的获胜机制。},
  file = {/home/ouyangjiahong/Zotero/storage/QEUKLTVS/Zhao 等 - 2025 - A learning-based algorithm for turn-based orbital pursuit-evasion problem with reaction-time delay.pdf;/home/ouyangjiahong/Zotero/storage/5754TFID/S0952197625002313.html;/home/ouyangjiahong/Zotero/storage/M3RUARLE/S0952197625002313.html}
}

@article{ZhaoLeiLeiKeXueJiaoYuShuZhiHuaZhuanXingFengXianJiQiYingDuiJiYuJiShuZhongJieShiJiao2026,
  title = {{科学教育数智化转型风险及其应对：基于技术中介视角}},
  author = {{赵磊磊} and {刘睿} and {董艳}},

@article{wangImpulsiveManeuverStrategy2024,
  title = {Impulsive Maneuver Strategy for Multi-Agent Orbital Pursuit-Evasion Game under Sparse Rewards},
  author = {Wang, Hongbo and Zhang, Yao},
  year = 2024,
  month = dec,
  journal = {Aerospace Science and Technology},
  volume = {155},
  pages = {109618},
  issn = {1270-9638},
  doi = {10.1016/j.ast.2024.109618},
  urldate = {2026-03-26},
  abstract = {To address the subjectivity of dense reward designs for the orbital pursuit-evasion game with multiple optimization objectives, this paper proposes the reinforcement learning method with a hierarchical network structure to guide game strategies under sparse rewards. Initially, to overcome the convergence challenges in the reinforcement learning training process under sparse rewards, a hierarchical network structure is proposed based on the hindsight experience replay. Subsequently, considering the strict constraints imposed by orbital dynamics on spacecraft state space, the reachable domain method is introduced to refine the subgoal space in the hierarchical network, further facilitating the achievement of subgoals. Finally, by adopting the centralized training-layered execution approach, a complete multi-agent reinforcement learning method with the hierarchical network structure is established, enabling networks at each level to learn effectively in parallel within sparse reward environments. Numerical simulations indicate that, under the single-agent reinforcement learning framework, the proposed method exhibits superior stability in the late training stage and enhances exploration efficiency in the early stage by 38.89\% to 55.56\% to the baseline method. Under the multi-agent reinforcement learning framework, as the relative distance decreases, the subgoals generated by the hierarchical network transition from long-term to short-term, aligning with human behavioral logic.},
  langid = {american},
  keywords = {Hierarchical network,Hindsight experience,Impulsive thrust,Orbital pursuit-evasion game,Reinforcement learning},
  annotation = {titleTranslation: 稀疏奖励下的多智能体轨道追逃博弈脉冲机动策略\\
abstractTranslation: 为应对多优化目标轨道追击-规避博弈中密集奖励设计的主观性，本文提出一种基于分层网络结构的强化学习方法，以在稀疏奖励下引导博弈策略。首先，为克服稀疏奖励下强化学习训练过程中的收敛难题，基于后见经验回放提出分层网络结构。其次，考虑轨道动力学对航天器状态空间的严格约束，引入可达域方法对分层网络中的子目标空间进行优化，进一步促进子目标的实现。最后，采用集中训练-分层执行方式，建立完整的分层网络结构多智能体强化学习方法，使各层级网络能够在稀疏奖励环境中并行有效学习。数值仿真表明，在单智能体强化学习框架下，所提方法在训练后期具有更优的稳定性，并在训练前期将探索效率较基线方法提升38.89\%至55.56\%。在多智能体强化学习框架下，随着相对距离减小，分层网络生成的子目标由长期逐步过渡至短期，符合人类行为逻辑。},
  file = {/home/ouyangjiahong/Zotero/storage/ISJFEDEG/Wang和Zhang - 2024 - Impulsive maneuver strategy for multi-agent orbital pursuit-evasion game under sparse rewards.pdf;/home/ouyangjiahong/Zotero/storage/CAX48E59/S1270963824007478.html}
}


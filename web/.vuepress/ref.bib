@article{fuHighorderTargetPhase2024,
  title = {A High-Order Target Phase Approach for the Station-Keeping of Periodic Orbits},
  author = {Fu, Xiaoyu and Baresi, Nicola and Armellin, Roberto},
  year = 2024,
  month = mar,
  journal = {Astrodynamics},
  volume = {8},
  number = {1},
  pages = {61--75},
  issn = {2522-0098},
  doi = {10.1007/s42064-023-0169-1},
  urldate = {2026-02-18},
  abstract = {A novel high-order target phase approach (TPhA) for the station-keeping of periodic orbits is proposed in this work. The key elements of the TPhA method, the phase-angle Poincare map and high-order maneuver map, are constructed using differential algebra (DA) techniques to determine station-keeping epochs and calculate correction maneuvers. A stochastic optimization framework tailored for the TPhA-based station-keeping process is leveraged to search for fuel-optimal and error-robust TPhA parameters. Quasi-satellite orbits (QSOs) around Phobos are investigated to demonstrate the efficacy of TPhA in mutli-fidelity dynamical models. Monte Carlo simulations demonstrated that the baseline QSO of JAXA's Martian Moons eXploration (MMX) mission could be maintained with a monthly maneuver budget of approximately 1 m/s.},
  langid = {english},
  keywords = {differential algebra (DA),Poincare map,quasi-satellite orbit (QSO),station-keeping,target phase approach (TPhA)},
  annotation = {titleTranslation: 一种用于周期轨道位置保持的高阶目标相位方法\\
abstractTranslation: 本文提出了一种新颖的高阶目标相位方法（TPhA），用于周期性轨道的站位保持。TPhA方法的关键要素------相位角庞加莱映射和高阶机动映射------均采用微分代数（DA）技术构建，以确定站位保持时机并计算修正机动。针对基于TPhA的站位保持过程，设计了随机优化框架，用于搜索燃料最优且对误差鲁棒的TPhA参数。通过对火卫一（Phobos）周围的准卫星轨道（QSOs）进行研究，验证了TPhA在多保真度动力学模型中的有效性。蒙特卡洛模拟结果表明，JAXA的火卫探测任务（MMX）的基准准卫星轨道可借助每月约1米/秒的机动预算进行维持},
  file = {/home/ouyangjiahong/Zotero/storage/8VQCNK65/Fu 等 - 2024 - A high-order target phase approach for the station-keeping of periodic orbits.pdf}
}

@inproceedings{fuHighorderTargetPoint2020,
  title = {A High-Order Target Point Approach to the Stationkeeping of near Rectilinear Halo Orbits},
  booktitle = {71st {{International Astronautical Congress}}, {{IAC}} 2020},
  author = {Fu, Xiaoyu and Baresi, Nicola and Armellin, Roberto},
  year = 2020,
  address = {Virtual, Online},
  abstract = {Near Rectilinear Halo Orbits (NRHOs) are orbits of great interest for the upcoming Lunar Orbital Platform-Gateway, an international effort led by NASA to extend the human presence beyond low-Earth orbits. As with other trajectories found in the Circular Restricted Three-Body Problem (CRTBP), NRHOs are sensitive to dynamical perturbations and navigation errors, prompting stationkeeping maneuvers. Among impulsive stationkeeping strategies, the Target Point Approach (TPA) enables the analytical computation of corrective maneuvers by minimizing a weighted cost function of the maneuver cost and position residuals at downstream points. Although widely used in a variety of space mission design and operations, the TPA is based on a linear approximation of position deviations obtained via the state transition matrix of a reference trajectory. To maximize the potential of the TPA, a high-order variant of this approach is hereby proposed using Taylor polynomial series and Differential Algebra (DA) techniques. By leveraging the capabilities of DA, accurate maneuvers and position deviations at target points are calculated in a nonlinear fashion. A high-order manuever map is built to efficiently calculate the optimal maneuvers via simple polynomial map evaluations. Comparative analyses between the high-order and linear TPAs are conducted to showcase the superiority of the nonlinear approach.},
  langid = {english},
  annotation = {titleTranslation: 高阶目标点逼近法在近直线晕轨道站保持中的应用}
}

@phdthesis{FuJiangLiangKongJianMuBiaoTeZhengDianXiangDuiXiaoXuanDongLiXueJianMoJiZiGuiYiTiKongZhi2019,
  type = {{硕士学位论文}},
  title = {{空间目标特征点相对消旋动力学建模及姿轨一体控制}},
  author = {{傅江良}},
  year = 2019,
  address = {北京},
  abstract = {空间目标消旋是在轨操控任务中的难点，也是近年来空间技术研究的热点。传统的解决方案是采取绝对式物理消旋技术，即通过外界输入力或力矩来衰减目标的角速度，从而实现追踪航天器与目标保持相对静止。然而这种消旋方式存在潜在的碰撞风险，而且容易对目标产生干扰，并破坏目标原有的运动形式。区别于绝对式物理消旋，本文提出一类相对消旋的概念来处理追踪航天器与目标交互中的相对旋转问题。相对消旋是一种对相对运动的描述，它通过主动生成追踪航天器的旋转运动，从而在运动层面上使航天器与目标在某一局部参考系中保持相对静止。这种消旋方式不改变目标的既有属性和运动形式，其消旋效率只取决于追踪航天器本身的姿轨机动能力，因而在空间目标特征面监视、在轨操控以及空间攻防等领域具有广泛的应用。本文围绕目标特征点凝视随动跟踪、空间碎片主动清理、小行星悬停等一类问题，结合目标轨道是否为圆轨道、目标与追踪航天器是否有相互作用、系统是否存在外界干扰和参数不确定性的情况，重点研究了二体、圆形限制性三体问题中的特征点相对消旋动力学建模和姿轨一体控制方法。主要研究成果包括:1. 提出了两种相对消旋模式，包括基于期望共振比的平面内相对消旋以及基于特征点凝视随动跟踪的空间相对消旋。针对后一种相对消旋模式，提出了一种新的建立在以目标特征点为原点，特征轴为主轴的局部指向坐标系下的特征点相对轨道动力学模型。结合在追踪航天器本体坐标系下表示的相对姿态动力学模型，进一步得到了基于特征点凝视随动跟踪的相对消旋姿轨耦合动力学模型。传统的航天器质心间相对运动模型或是建立在目标轨道坐标系下的特征点模型，其特征点间相对位置参考轨迹以及期望指向都是时变的。相比之下，新提出的动力学模型的优点在于姿轨控制过程中可以保持特征点相对运动期望状态稳定不变，从而降低末端约束的处理难度。2. 针对二体问题中目标轨道为圆轨道、目标和追踪航天器之间无相互作用，也不考虑外界扰动和系统不确定性的情况，基于非奇异终端滑模方法设计了相对消旋姿轨一体控制器，并通过标准 Lyapunov 函数分析了该控制器的有限时间稳定性和滑模到达时间。仿真结果表明所设计的控制器能使追踪航天器特征点在有限时间内快速地对目标特征点进行相对位置和姿态的跟踪。进一步分析结果，得到构成追踪航天器观测轴指向偏差的影响因素，并提出在存在特征点相对位置偏差的情况下，通过主动调整观测轴的指向，可以使总的指向偏差控制在允许范围内。3. 采用特征点相对消旋的方法，仿真实现了天基激光平台对空间碎片的边相对消旋边降轨清理。首先针对目标轨道偏心率不为零，目标受到来自追踪航天器的激光作用力，且系统存在外部扰动和不确定性的情况，建立了二体问题中天基激光平台降轨清理空间碎片的特征点相对消旋动力学模型；其次采用干扰观测器对系统外部扰动进行观测，并设计了结合干扰观测器的非奇异终端滑模控制律；最后通过数值仿真验证了在给定相对消旋控制律下的碎片降轨结果。4. 采用特征点相对消旋的方法，仿真实现了圆形限制性三体问题中航天器对捕获于绕月大幅值逆行轨道上的小行星的定点悬停。首先考虑追踪航天器受到来自目标引力场的作用，以及存在系统外部扰动和不确定性的情况，建立了圆形限制性三体问题中的相对消旋动力学模型；其次针对该模型设计了自适应鲁棒滑模控制器；仿真结果表明该控制器对求解圆形限制性三体问题中的特征点相对消旋具有良好的效果。},
  langid = {chinese},
  school = {中国科学院大学},
  keywords = {;;;},
  file = {/home/ouyangjiahong/Zotero/storage/NSRW3QA6/傅江良 - 2019 - 空间目标特征点相对消旋动力学建模及姿轨一体控制.pdf}
}


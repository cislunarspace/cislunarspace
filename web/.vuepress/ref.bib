  pages = {1374--1390},
  issn = {0021-9142, 2195-0571},
  doi = {10.1007/s40295-020-00229-w},
  urldate = {2025-11-27},
  abstract = {Lunar gravity assist is a means to boost the energy and C3 of an escape trajectory. Trajectories with two lunar gravity assists are considered and analyzed. Two approaches are applied and tested for the design of missions aimed at Near-Earth asteroids. In the first method, indirect optimization of the heliocentric leg is combined to an approximate analytical treatment of the geocentric phase for short escape trajectories. In the second method, the results of pre-computed maps of escape C3 are employed for the design of longer Sun-perturbed escape sequences combined with direct optimization of the heliocentric leg. Features are compared and suggestions about a combined use of the approaches are presented. The techniques are efficiently applied to the design of a mission to a near-Earth asteroid.},

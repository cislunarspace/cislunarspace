@article{sidhoumLowthrustTrajectoryDesign2024,
  title = {Low-Thrust Trajectory Design for Icy Moons Orbiters Using Multi-Body Techniques},
  author = {Sidhoum, Yanis and Oguri, Kenshiro},
  year = 2024,
  month = dec,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {6},
  pages = {55--83},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10228-w},
  urldate = {2025-10-01},
  abstract = {Icy moons of our Solar system are currently one of the focuses of the leading space agencies in the search for extraterrestrial life. Especially, Enceladus is a prime target because of the presence of geyser-like jets of water emanating from its south pole. Future missions to Enceladus would benefit from inter-moon transfers of the Saturnian system to reach Enceladus. However, such trajectories are challenging to design, due to the highly nonlinear, often chaotic, multibody dynamics with close encounters of the planetary moons. The trajectory design is even more complex when low-thrust propulsion is used due to the long-duration, multi-revolution nature of the solutions. The approach outlined in this paper confronts this shortcoming by exploiting multi-body dynamics to construct a `resonant hopping' trajectory, which is then optimized using indirect methods. Unstable resonant orbits are pre-computed and provide a starting point to a multiple indirect shooting method in a forward--backward fashion. The insights from multi-body dynamics steer the algorithm to a near-ballistic solution. The use of indirect optimization allows the design of long-duration, multi-revolution low-thrust trajectory, with a limited number of optimization variables. Finally, forward--backward shooting technique reduces the sensitivities to constraints satisfaction. This strategy is employed to design a low-thrust inter-moon transfer between a close resonant orbit of Tethys and a near rectilinear halo orbit around Enceladus.},
  langid = {english},
  keywords = {Enceladus,Inter-moon transfer,Pontryagin's minimum principle,Resonant gravity assist,Trajectory optimization},
  annotation = {titleTranslation: 基于多体技术的冰卫星轨道器低推力轨迹设计\\
abstractTranslation: 太阳系中的冰卫星目前是各大领先航天机构在寻找地外生命方面的重点之一。特别是，Enceladus是一个首要目标，因为其南极存在类似间歇泉的水流喷流。未来前往Enceladus的任务将受益于土星系统内的卫星间转移以到达Enceladus。然而，由于涉及行星卫星近距离交会的高度非线性、通常混沌的多体动力学，此类轨迹设计具有挑战性。当使用低推力推进时，由于解具有长时间、多圈次的特性，轨迹设计更加复杂。本文提出的方法通过利用多体动力学构建``共振跳跃''轨迹来应对这一不足，随后使用间接法进行优化。预先计算不稳定共振轨道，并为多重间接打靶法提供起始点，采用前向-后向方式。来自多体动力学的洞察引导算法走向近弹道解。使用间接优化可以设计长时间、多圈次的低推力轨迹，且优化变量数量有限。最后，前向-后向打靶技术降低了对约束满足的敏感性。该策略用于设计从Tethys的近共振轨道到Enceladus周围的近直线晕轨道之间的低推力卫星间转移},
  file = {/home/ouyangjiahong/Zotero/storage/9RFMVCJB/Sidhoum和Oguri - 2024 - Low-thrust trajectory design for icy moons orbiters using multi-body techniques.pdf}
}

@article{sidorenkoQuasisatelliteOrbitsGeneral2014,
  title = {Quasi-Satellite Orbits in the General Context of Dynamics in the 1:1 Mean Motion Resonance: Perturbative Treatment},
  shorttitle = {Quasi-Satellite Orbits in the General Context of Dynamics in the 1},
  author = {Sidorenko, Vladislav V. and Neishtadt, Anatoly I. and Artemyev, Anton V. and Zelenyi, Lev M.},
  year = 2014,
  month = oct,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {120},
  number = {2},
  pages = {131--162},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-014-9565-4},
  urldate = {2025-11-27},
  abstract = {Our investigation is motivated by the recent discovery of asteroids orbiting the Sun and simultaneously staying near one of the Solar System planets for a long time. This regime of motion is usually called the quasi-satellite regime, since even at the times of the closest approaches the distance between the asteroid and the planet is significantly larger than the region of space (the Hill's sphere) in which the planet can hold its satellites. We explore the properties of the quasisatellite regimes in the context of the spatial restricted circular three-body problem ``Sun-planet-asteroid''. Via double numerical averaging, we construct evolutionary equations which describe the long-term behaviour of the orbital elements of an asteroid. Special attention is paid to possible transitions between the motion in a quasi-satellite orbit and the one in another type of orbits available in the 1:1 resonance. A rough classification of the corresponding evolutionary paths is given for an asteroid's motion with a sufficiently small eccentricity and inclination.},
  langid = {english},
  annotation = {titleTranslation: 一般动力学背景下1:1平运动共振中的准卫星轨道：摄动处理方法\\
abstractTranslation: 我们的研究源于近期发现的小行星绕太阳运行的同时，长时间停留在太阳系某一行星附近的现象。这种运动模式通常被称为``准卫星机制''，因为即使在小行星与行星距离最近时，两者之间的距离也远大于行星能够束缚其卫星的空间区域（即希尔球）。我们基于``太阳-行星-小行星''空间限制性圆型三体问题，探讨了准卫星机制的特性。通过双重数值平均方法，我们构建了描述小行星轨道要素长期演化的方程，并特别关注了准卫星轨道运动与1:1共振中其他类型轨道之间可能发生的转换。针对偏心率和倾角足够小的小行星运动，我们给出了相应的演化路径的粗略分类。},
  file = {/home/ouyangjiahong/Zotero/storage/2VNNBKZY/Sidorenko 等 - 2014 - Quasi-satellite orbits in the general context of dynamics in the 11 mean motion resonance perturba.pdf}
}


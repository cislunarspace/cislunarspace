@article{angelopoulosARTEMISMission2011,
  title = {The {{ARTEMIS}} Mission},
  author = {Angelopoulos, V.},
  year = 2011,
  month = dec,
  journal = {Space Science Reviews},
  volume = {165},
  number = {1},
  pages = {3--25},
  issn = {1572-9672},
  doi = {10.1007/s11214-010-9687-2},
  urldate = {2026-04-05},
  abstract = {The Acceleration, Reconnection, Turbulence, and Electrodynamics of the Moon's Interaction with the Sun (ARTEMIS) mission is a spin-off from NASA's Medium-class Explorer (MIDEX) mission THEMIS, a five identical micro-satellite (hereafter termed ``probe'') constellation in high altitude Earth-orbit since 17 February 2007. By repositioning two of the five THEMIS probes (P1 and P2) in coordinated, lunar equatorial orbits, at distances of {$\sim$}55--65 REgeocentric ({$\sim$}1.1--12 RLselenocentric), ARTEMIS will perform the first systematic, two-point observations of the distant magnetotail, the solar wind, and the lunar space and planetary environment. The primary heliophysics science objectives of the mission are to study from such unprecedented vantage points and inter-probe separations how particles are accelerated at reconnection sites and shocks, and how turbulence develops and evolves in Earth's magnetotail and in the solar wind. Additionally, the mission will determine the structure, formation, refilling, and downstream evolution of the lunar wake and explore particle acceleration processes within it. ARTEMIS's orbits and instrumentation will also address key lunar planetary science objectives: the evolution of lunar exospheric and sputtered ions, the origin of electric fields contributing to dust charging and circulation, the structure of the lunar interior as inferred by electromagnetic sounding, and the lunar surface properties as revealed by studies of crustal magnetism. ARTEMIS is synergistic with concurrent NASA missions LRO and LADEE and the anticipated deployment of the International Lunar Network. It is expected to be a key element in the NASA Heliophysics Great Observatory and to play an important role in international plans for lunar exploration.},
  langid = {english},
  keywords = {ARTEMIS,Lunar exosphere,Magnetosphere,Reconnection,Solar wind,THEMIS,Turbulence},
  annotation = {**论文标题：** ARTEMIS任务\\
\\
**论文摘要：** ``月球与太阳相互作用中的加速、重联、湍流及电动力学（ARTEMIS）''任务衍生于美国国家航空航天局（NASA）的中型探测器（MIDEX）任务THEMIS。THEMIS任务自2007年2月17日起，在高海拔地球轨道部署了由五颗完全相同微型卫星（以下简称``探测器''）组成的星座。通过将其中两颗THEMIS探测器（P1和P2）重新定位至协调运行的月球赤道轨道（距离地心约55--65个地球半径，距离月心约1.1--12个月球半径），ARTEMIS任务将对远磁尾、太阳风以及月球空间与行星环境进行首次系统的两点观测。该任务主要的太阳物理学科学目标是：从这些前所未有的观测位置和探测器间距，研究粒子如何在重联区和激波处被加速，以及湍流如何在地球磁尾和太阳风中形成并演化。此外，该任务还将确定月球尾迹的结构、形成、补充及其下游演化，并探索其中的粒子加速过程。ARTEMIS的轨道和仪器配置也将致力于实现关键的月球行星科学目标：研究月球外逸层离子和溅射离子的演化，探究导致尘埃带电与循环的电场的起源，通过电磁探测推断月球内部结构，以及通过研究地壳磁性揭示月球表面特性。ARTEMIS任务与NASA同时进行的月球勘测轨道飞行器（LRO）、月球大气与尘埃环境探测器（LADEE）任务以及预期的国际月球网络部署具有协同效应。它有望成为NASA太阳物理学``伟大观测台''计划的关键组成部分，并在国际月球探索计划中发挥重要作用。\\
titleTranslation: ARTEMIS任务\\
abstractTranslation: 月球与太阳相互作用的加速度、重联、湍流及电动力学任务（ARTEMIS）源自美国国家航空航天局（NASA）的中级探索者（MIDEX）任务THEMIS------自2007年2月17日起，由五颗相同的微型卫星（以下简称``探测器''）组成的高空地球轨道星座。通过将五颗THEMIS探测器中的两颗（P1和P2）重新部署至协调的月球赤道轨道（地心距约55--65 RE，月心距约1.1--12 RL），ARTEMIS将对遥远磁尾、太阳风以及月球空间与行星环境进行首次系统性双点观测。该任务的主要太阳物理学科学目标包括：从这些前所未有的观测位置和探测器间距出发，研究粒子如何在重联区域和激波中被加速，以及湍流在地球磁尾和太阳风中如何产生与演化。此外，任务还将确定月球尾迹的结构、形成、再填充及下游演化，并探索其中粒子加速过程。ARTEMIS的轨道与仪器还将解决关键的月球行星科学问题：月球外逸层与溅射离子的演化、导致尘埃带电与循环的电场起源、通过电磁探测推断的月球内部结构，以及通过壳层磁性研究揭示的月球表面特性。ARTEMIS与NASA同期任务LRO和LADEE及预期部署的国际月球网络相辅相成，预计将成为NASA太阳物理学大天文台的关键组成部分，并在国际月球探测计划中发挥重要作用。},
  file = {/home/ouyangjiahong/Zotero/storage/ADD5QR9W/Angelopoulos - 2011 - The ARTEMIS mission.pdf}
}

@article{anilkumarMoonMarsChallenges2025,
  title = {Moon to {{Mars}}: Challenges and Strategic Frameworks for Space Traffic Management in Cislunar and Cismartian Environments},
  shorttitle = {Moon to {{Mars}}},
  author = {Anilkumar, K. and Mukherjee, Bulbul and Berend, Nicolas and Biswas, Sanat K. and Buinhas, Luisa and Dailey, Nathaniel and Foing, Bernard and Rodriguez, Natalia Franco and Hedrick, Gabrielle and Kebe, Fatoumata and Li, Yide and Ott, Antoinette and Pastor, Alejandro and Rana, Zaid and Rodriguez, Javier and Sorge, Marlon E. and Unfried, Christian and Urdampilleta, Igone},
  year = 2025,
  month = apr,
  journal = {Acta Astronautica},
  volume = {229},
  pages = {211--217},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2024.12.056},
  urldate = {2025-09-25},
  abstract = {This chapter comprehensively explores the unique challenges, risks, and gaps associated with managing space traffic in cislunar and cismartian environments, focusing on the complexities introduced by the Moon-to-Mars mission trajectory. It examines the technical hurdles, such as astrodynamics, communication, and Positioning, Navigation, and Timing (PNT) systems, which are critical for safe and effective space traffic management (STM) in regions beyond geostationary orbit (xGEO). The report also addresses the escalating issue of space debris in these areas, which poses significant threats to future lunar and Martian missions, underscoring the urgent need for innovative debris mitigation strategies.},
  langid = {english},
  annotation = {titleTranslation: 月球到火星：地月和火星环境中空间交通管理的挑战和战略框架\\
abstractTranslation: 本章全面探讨了在地月空间和地火环境中管理空间交通所面临的独特挑战、风险与不足，重点聚焦于``月球到火星''任务轨迹所引入的复杂性。它深入分析了技术难题，例如天体动力学、通信以及定位、导航与授时（PNT）系统------这些系统对于在地球静止轨道以外（xGEO）区域实现安全有效的空间交通管理（STM）至关重要。报告还探讨了这些区域中日益严重的空间碎片问题，该问题对未来月球和火星任务构成重大威胁，凸显了创新性碎片减缓策略的迫切需求},
  file = {/home/ouyangjiahong/Zotero/storage/76H8DR2Q/Anilkumar 等 - 2025 - Moon to Mars challenges and strategic frameworks for space traffic management in cislunar and cisma.pdf}
}


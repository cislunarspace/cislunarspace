@article{renFamiliesTransfersMoon2020,
  title = {Families of Transfers from the Moon to Distant Retrograde Orbits in Cislunar Space},
  author = {Ren, Jing and Li, Mingtao and Zheng, Jianhua},
  year = 2020,
  journal = {Astrophysics and Space Science},
  volume = {Vol.365},
  number = {No.12},
  pages = {1--15},
  doi = {10.1007/s10509-020-03901-7},
  abstract = {This paper presents different families of transfers from Low Lunar Orbit to Distant Retrograde Orbits in the Earth-Moon system and analyzes their characteristics from the perspective of velocity increment requirement, transfer time, and sensitivity to small perturbations. Initially, families of transfer trajectories in the Circular Restricted Three-Body Problem are found by the predictor-corrector method and numerical continuation. Each transfer uses two impulsive maneuvers. These families are computed for different parking orbit altitudes, constants of motion, and insertion points. Then, to investigate the sensitivity characteristics of each family, a metric based on Local Lyapunov Exponent is introduced and computed along each trajectory. This work provides various choices for future cargo and human-crewed missions in the cislunar space.},
  langid = {english},
  keywords = {Methods: numerical,Moon,Planets and satellites: dynamical evolution and stability,Space vehicles},
  annotation = {titleTranslation: 月球至地月空间远距离逆行轨道的转移族系\\
abstractTranslation: 本文提出了从低月球轨道到地月系统中远距离逆行轨道的不同转移族，并从速度增量需求、转移时间和对小扰动敏感性等方面分析了其特性。首先，通过预测-校正方法和数值延拓，在圆形限制性三体问题中找到了转移轨迹族。每次转移采用两次脉冲机动。这些族针对不同的驻留轨道高度、运动常数和入轨点进行了计算。随后，为研究各族的敏感性特征，引入了基于局部李雅普诺夫指数的度量，并沿每条轨迹进行了计算。本工作为未来地月空间中的货物和载人任务提供了多种选择},
  file = {/home/ouyangjiahong/Zotero/storage/5F4WYIMS/Ren 等 - 2020 - Families of transfers from the moon to distant retrograde orbits in cislunar space.pdf}
}


@article{panAttemptBuildDynamical2025,
  title = {An Attempt to Build a Dynamical Catalog of Present-Day Solar System Co-Orbitals},
  author = {Pan, Nicolas and Gallardo, Tabar{\'e}},
  year = 2025,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {137},
  number = {1},
  pages = {2--25},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10234-y},
  urldate = {2025-10-01},
  abstract = {The main objective of this paper is to fully study 1:1 mean-motion resonance in the Solar System. We calculated stability points applying a resonant semi-analytic theory valid for any value of eccentricity or inclination. The location of each equilibrium point changes as the orbital elements of an object change, which led us to map the location of them. For the case of low inclination and low eccentricity we recovered the known L4 and L5 points. The three global types of orbits for this resonance; Tadpoles, Quasi-satellites and Horseshoes, vary as a function of the orbital elements, even disappearing for some cases. In order to build a catalog of real co-orbital objects, we filtered the NASA Horizons minor-body catalog inside the maximum resonant width and analyzed which objects are indeed in resonance. In total, we found 173 objects to be in co-orbital resonant motion with Solar System planets excluding Jupiter. We were able to recover all the already known objects and to confirm the resonant state of some new ones. Mercury remains to be the only planet with zero known co-orbitals and no L5 Earth Trojan has been discovered so far. Among the interesting identified orbits we highlight the one of 2021 FV1, a new Mars Quasi-satellite. Despite having circulating critical angles, we found some objects to be dynamically driven by the resonance such as 2021 GN1.},
  langid = {english},
  annotation = {titleTranslation: 构建当代太阳系共轨天体的动态星表尝试\\
abstractTranslation: 本文的主要目标是全面研究太阳系中的1:1平均运动共振。我们利用适用于任意偏心率和轨道倾角值的共振半解析理论，计算了稳定点。随着天体轨道要素的变化，各平衡点的位置也随之改变，这促使我们绘制了这些点的位置分布图。在低倾角和低偏心率情况下，我们重现了已知的L4和L5点。该共振对应的三种全局轨道类型------蝌蚪轨道、准卫星轨道和马掌轨道，随轨道要素的变化而变化，甚至在部分情况下会消失。为构建真实共轨天体目录，我们筛选了NASA Horizons小行星数据库中位于最大共振宽度内的天体，并分析了哪些天体确实处于共振状态。总计发现173个天体与太阳系中除木星以外的行星存在共轨共振运动。我们成功复现了所有已知天体，并确认了一些新天体的共振状态。水星仍然是唯一已知零共轨天体的行星，且目前尚未发现任何地球L5特洛伊天体。在有趣的识别轨道中，我们特别指出2021 FV1------一颗新的火星准卫星。尽管存在临界角循环变化，我们仍发现部分天体（如2021 GN1）受到共振的动力学驱动。},
  file = {/home/ouyangjiahong/Zotero/storage/NWJSIGTU/Pan和Gallardo - 2025 - An attempt to build a dynamical catalog of present-day solar system co-orbitals.pdf}
}

@article{pangOrbitsChargedParticles2023,
  title = {Orbits of Charged Particles with an Azimuthal Initial Velocity in a Dipole Magnetic Field},
  author = {Pang, Hanrui and Liu, Siming and Liu, Rong},
  year = 2023,
  month = dec,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {6},
  pages = {53},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10167-y},
  urldate = {2025-10-01},
  abstract = {Nonintegrable dynamical systems have complex structures in their phase space. Due to the axisymmetry of the system, motion of a test charged particle in a dipole magnetic field can be reduced to a two-degree-of-freedom (2-DoF) nonintegrable Hamiltonian system (St\"ormer, Radium (Paris) 4(1):2--5, 1907; Dragt, Rev Geophys, https://doi.org/10.1029/ RG003i002p00255, 1965). We carried out a systematic study of orbits of charged particles with an azimuthal initial velocity in a dipole field via calculation of their Lyapunov characteristic exponents (LCEs) and escape times for a dimensionless energy, respectively, less and greater than 1/32, above which most particles will escape from the magnetic dipole to infinity. Meridian plane periodic orbits symmetric with respect to the equatorial plane of the magnetic dipole are then identified. We found that (1) symmetric periodic orbits can be classified into several classes based on their number of crossing points on the equatorial plane; (2) the initial conditions of these classes locate on closed loops or closed curves going through the origin; (3) most isolated regions of stable quasi-periodic orbits are associated asymmetric stable periodic orbits; (4) classes of asymmetric periodic orbits either go through the origin or terminate at flat equatorial plane orbits with the other end approaching centers of spiral structures; (5) there are apparent self-similarities in the above features with the decrease of energy. These results can be used to guide the search for stable orbits that may have applications in broad physical contexts.},
  langid = {english},
  annotation = {titleTranslation: 具有方位角初速度的带电粒子在偶极磁场中的轨道。\\
abstractTranslation: 非可积动力系统在其相空间中具有复杂结构。由于系统的轴对称性，测试带电粒子在偶极磁场中的运动可简化为一个两自由度非可积哈密顿系统（St\"ormer, Radium (Paris) 4(1):2--5, 1907; Dragt, Rev Geophys, https://doi.org/10.1029/RG003i002p00255, 1965）。我们通过计算无量纲能量分别小于和大于1/32（超过该值时大部分粒子将从磁偶极子逃逸至无穷远）时的Lyapunov特征指数（LCEs）和逃逸时间，系统研究了具有方位角初始速度的带电粒子在偶极场中的轨道。随后识别出与磁偶极子赤道平面对称的子午面周期轨道。我们发现：(1) 对称周期轨道可根据其与赤道平面的交点数分为若干类；(2) 这些类的初始条件位于经过原点的闭合环路或闭合曲线上；(3) 大多数稳定的准周期轨道孤立区域与非对称稳定周期轨道相关；(4) 非对称周期轨道类别要么经过原点，要么终止于平坦的赤道平面轨道，另一端则趋近螺旋结构的中心；(5) 上述特征随能量减小呈现明显的自相似性。这些结果可用于指导寻找稳定轨道，这类轨道在广泛的物理背景中可能具有应用价值},
  file = {/home/ouyangjiahong/Zotero/storage/CBBLCVKC/Pang 等 - 2023 - Orbits of charged particles with an azimuthal initial velocity in a dipole magnetic field.pdf}
}

@article{pangReachableSetSpacecraft2022,
  title = {Reachable Set of Spacecraft with Finite Thrust Based on Grid Method},
  author = {Pang, Bo and Wen, Changxuan},
  year = 2022,
  month = aug,
  journal = {IEEE Transactions on Aerospace and Electronic Systems},
  volume = {58},
  number = {4},
  pages = {2720--2731},
  issn = {1557-9603},
  doi = {10.1109/TAES.2021.3138373},
  urldate = {2026-02-13},
  abstract = {Reachable sets are sets of position states that the spacecraft can reach from its initial state under mass and time constraints. In this study, a method to solve the reachable set of spacecraft with finite thrust is proposed. Solving reachable sets can be transformed into solving its boundary surface using the distance fields over grids method. A grid is established to represent the boundary surface, and each node on the grid can be determined by an optimal control problem. A modified sequential convex programming with nonlinear dynamic correction is used to solve optimal control problems with a theoretical proof of convergence. Moreover, the symmetry plane of the reachable set is found to reduce the computation in applications. The method is tested with two types of orbits, namely, geosynchronous and highly elliptical orbits, and the properties of the spacecraft's reachability in two orbits are obtained. Numerical simulations show that the proposed method can succeed in solving reachable sets under mass and time constraints in two types of initial orbits even when a long period is considered.},
  langid = {english},
  keywords = {Aerospace electronics,Finite thrust,grid method,Mathematical models,Optimal control,Planetary orbits,Programming,reachable set (RS),Space vehicles,Trajectory},
  annotation = {titleTranslation: 基于网格方法的有限推力航天器可达集\\
abstractTranslation: 可达集是航天器在质量与时间约束下，从初始状态能够到达的位置状态集合。本研究提出了一种求解有限推力航天器可达集的方法。将可达集的求解转化为利用网格距离场方法求解其边界曲面。建立网格以表示边界曲面，网格上的每个节点可通过一个最优控制问题来确定。采用一种带有非线性动力学修正的改进序列凸规划方法求解最优控制问题，并给出了收敛性的理论证明。此外，发现了可达集的对称平面，以减少实际应用中的计算量。该方法在两种轨道类型（地球同步轨道和高椭圆轨道）上进行了测试，获得了航天器在两种轨道上的可达性特性。数值仿真表明，即使在长时间周期下，所提方法也能成功求解两种初始轨道类型下存在质量与时间约束的可达集},
  file = {/home/ouyangjiahong/Zotero/storage/44NSIAUT/Pang和Wen - 2022 - Reachable set of spacecraft with finite thrust based on grid method.pdf}
}


@article{farkasvolgyiEvolutionLunarCommunication2024,
  title = {The Evolution of Lunar Communication---from the Beginning to the Present},
  author = {Farkasv{\"o}lgyi, Andrea and Csurgai-Horv{\'a}th, L{\'a}szl{\'o} and Boh{\'a}{\v c}ek, Petr},
  year = 2024,
  month = may,
  journal = {International Journal of Satellite Communications and Networking},
  volume = {42},
  number = {3},
  pages = {200--216},
  issn = {1542-0973, 1542-0981},
  doi = {10.1002/sat.1507},
  urldate = {2025-09-25},
  abstract = {The Moon is the closest celestial body to the Earth. The examination and discovery of this planet have always played an important role in the history of humanity. Since the beginning of the space age, the Moon has been the target of many missions from the 1950s to the present day. Radio communication plays a fundamental role in space vehicle projects because this is the most obvious way to communicate with the ground station and transmit control commands and scientific data. From the early missions to the present day, Earth--Moon communication had many stages of development. In our article, we review this progress and then present the state-of-the-art ideas related to the present missions through the missions currently underway and those planned for the near future. Our primary objective is to describe the radio communication relay services planned for orbit around the Moon. Furthermore, we present the European Space Agency (ESA)-supported lunar missions, highlighting the Lunar Geology Orbiter (LUGO) mission. Finally, as a future perspective, we present the possibilities of optical communication in the Earth--Moon path, which can result a significant increase in capacity.},
  langid = {english},
  annotation = {titleTranslation: 月球通信的演变- -从开始到现在。\\
abstractTranslation: 月球是距离地球最近的天体。对这颗行星的探索与发现始终在人类历史中占据重要地位。自太空时代开启以来，从20世纪50年代至今，月球一直是众多航天任务的目标。无线电通信在航天器项目中发挥着根本性作用，因为这是与地面站通信、传输控制指令和科学数据最直接的方式。从早期任务至今，地月通信经历了多个发展阶段。本文回顾了这一演进过程，并通过当前正在执行及近期规划的任务，介绍与现有任务相关的前沿理念。我们的首要目标是描述计划在环月轨道上运行的无线电通信中继服务。此外，我们介绍了欧洲空间局（ESA）支持的月球任务，重点突出了月球地质轨道器（LUGO）任务。最后，作为未来展望，我们探讨了地月路径上光学通信的可能性，这种通信方式可显著提升容量},
  file = {/home/ouyangjiahong/Zotero/storage/4T2F8SZS/Farkasvölgyi 等 - 2024 - The evolution of lunar communication—from the beginning to the present.pdf}
}


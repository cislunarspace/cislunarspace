  booktitle = {7th {{International Conference}} on {{Astrodynamics Tools}} and {{Techniques}} ({{ICATT}})},
  author = {Blazquez, Emmanuel and Beauregard, Laurent and {Lizy-Destrez}, St{\'e}phanie},

@article{chongruiGenerationArtificialHalo2022,
  title = {Generation of Artificial Halo Orbits in Near-Moon Space Using Low-Thrust Engines},
  author = {Chongrui, Du and Starinova, O. L.},
  year = 2022,
  journal = {Cosmic Research},
  volume = {Vol.60},
  number = {No.2},
  pages = {124--138},
  issn = {0010-9525},
  doi = {10.1134/S0010952522020022},
  abstract = {This study is devoted to the possibility of creating artificial halo orbits in the circular restricted three-body problem of the Earth--Moon system due to the small acceleration from low-thrust engines acting on a spacecraft for a long time in situations, where the natural halo orbit cannot meet the mission requirements or is busy. In this paper, using collocation and parameter-continuation methods, two classes of artificial halo orbits in the Earth--Moon system are obtained. The first class is generated due to additional constant in magnitude and direction acceleration. A complete family of orbits of this class was obtained, which significantly differ from the traditional ones in terms of period and shape. The second class of orbits is generated by variable electric propulsion. This class of orbits was obtained as a solution to the problem of the optimal consumption of the working substance for orbit formation with a given period using the Pontryagin maximum principle and the method of continuation in parameter. It was shown that there are significant differences in orbital periods between artificial halo orbits---descendants of the same halo orbit. The calculation results confirm the possibility of using low-thrust engines to vary the parameters of natural halo orbits suitable for ballistic design of future lunar missions.},
  langid = {english},
  keywords = {LIBRATION POINTS,OPTIMIZATION,TRAJECTORIES},
  annotation = {titleTranslation: 利用低推力发动机在近月空间生成人工晕轨道\\
abstractTranslation: 本研究致力于探讨在地-月系统圆型限制性三体问题中，当自然晕轨道无法满足任务需求或被占用时，通过航天器长时间承受来自低推力发动机的小加速度来创建人造晕轨道的可能性。本文采用配置法和参数延拓法，得到了地-月系统中的两类人造晕轨道。第一类轨道因施加常值大小和方向的附加加速度而产生。获得了该类轨道的完整族系，其在周期和形状上与传统轨道有显著差异。第二类轨道由可变电推进产生。这类轨道作为给定周期下轨道形成过程中工作物质最优消耗问题的解而获得，采用了庞特里亚金最大值原理和参数延拓法。研究表明，作为同一晕轨道后裔的人造晕轨道之间在轨道周期上存在显著差异。计算结果证实了使用低推力发动机改变自然晕轨道参数的可行性，这可为未来月球任务的弹道设计提供参考}
}


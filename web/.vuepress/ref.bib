@phdthesis{WuGuangYuMianXiangZhiNengWuRenXiTongDeKuaMoTaiGanZhiJiSuanYouHuaFangFaYanJiu2024,
  type = {{硕士学位论文}},
  title = {{面向智能无人系统的跨模态感知计算优化方法研究}},
  author = {{吴光宇}},
  year = 2024,
  address = {合肥},
  doi = {10.27517/d.cnki.gzkju.2024.002290},
  urldate = {2026-02-05},
  abstract = {由于多复杂场景下的多种任务都能具有自主智能作业能力,智能无人系统在民用、军用等多领域都展示了广泛的应用潜力,已经成为民生保障与国家安全的战略需求与与重大关切。作为智能无人系统的``眼睛'',跨模态感知计算优化是实现在复杂场景下智能无人系统高效获取环境信息的有效途径。然而智能无人系统给跨模态感知计算带来了异构性、动态性、协同性、复杂性、资源受限的新特点,导致了一系列更加艰巨的挑战,使得传统跨模态感知计算方法难以直接应用。本文聚焦智能无人系统的跨模态感知计算优化问题,针对现有方法普遍存在模态特性针对性不足、缺少泛化性、自主融合能力差、计算复杂度高等不足,以基于智能无人系统的广域无人机定位问题为研究的切入点,通过构建一套真实的包含跨模态传感计算载荷、分布式车载-固定无人感知节点以及远程控制计算平台的``智能无人机定位系统'',利用多源融合、注意力机制与离在线学习方法,从单无人感知节点的自纠正融合感知、移动无人感知节点的动态融合感知、多无人感知节点的协同融合感知以及跨模态感知与模型优化四个方面展开研究,为智能无人系统中的大规模异构跨模态感知结果的高效利用提供理论和方法支撑,论文的主要研究内容如下:(1)传感器间面向跨模态特性的自纠正融合感知研究。针对智能无人系统跨模态传感器间感知信息的异构性以及感知目标的非显著性挑战,基于``智能无人机定位系统''中毫米波-视觉融合需求,研究了面向模态特性的毫米波-视觉自纠正融合定位无人机问题。首先,开发了一种面向模态特性的毫米波-视觉自纠正融合无人机定位系统框架。基于模态特征选择和提取跨模态特征,将毫米波感知的多普勒特征迁移到图像特征上,实现跨模态特征增强与高精度无人机定位。其次,基于该框架,提出了一种面向跨模态特性的自纠正融合网络,其提出一种新颖的基于感知特性的三维毫米波特征提取方法提取无人机的多普勒运动特征,并进一步提出一种自纠正跨模态仿射变换,在无需空间标定的前提下,将无人机的多普勒运动特征自纠正地融入其视觉特征域,实现跨模态增强融合。最后,本文建立了一个实际的毫米波-视觉近地无人机定位平台,并在多种场景下构建了包含同步视觉图像和毫米波射频序列的数据集。实验证明,本文的框架在定位准确性方面优于基线方法,同时保持实时性能。此外,消融研究也证实了框架中每个模块的有效性。(2)面向动态感知特性的时空匹配融合感知研究。针对智能无人系统中无人平台移动性带来的动态感知特性,基于``智能无人机定位系统...},
  collaborator = {{李向阳}},

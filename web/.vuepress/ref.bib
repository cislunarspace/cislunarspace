@article{chongCalibratingBuildingEnergy2021,
  title = {Calibrating Building Energy Simulation Models: A Review of the Basics to Guide Future Work},
  shorttitle = {Calibrating Building Energy Simulation Models},
  author = {Chong, Adrian and Gu, Yaonan and Jia, Hongyuan},
  year = 2021,
  month = dec,
  journal = {Energy and Buildings},
  volume = {253},
  pages = {111533},
  issn = {0378-7788},
  doi = {10.1016/j.enbuild.2021.111533},
  urldate = {2026-02-19},
  abstract = {Building energy simulation (BES) plays a significant role in buildings with applications such as architectural design, retrofit analysis, and optimizing building operation and controls. There is a recognized need for model calibration to improve the simulations' credibility, especially with building data becoming increasingly available and the promises that a digital twin brings. However, BES calibration remains challenging due to the lack of clear guidelines and best practices. This study aims to provide the foundation for future research through a detailed systematic review of the vital aspects of BES calibration. Specifically, we conducted a meta-analysis and categorization of the simulation inputs and outputs, data type and resolution, key calibration methods, and calibration performance evaluation. This study also identified reproducible simulations as a critical issue and proposes an incremental approach to encourage future research's reproducibility.},
  langid = {english},
  keywords = {Building performance simulation,Building simulation,Calibration,Optimization,Reproducibility,Uncertainty},
  annotation = {titleTranslation: 建筑能耗模拟模型校准：基础回顾与未来工作指引\\
abstractTranslation: Building energy simulation (BES) 在建筑领域具有重要作用，可应用于建筑设计、改造分析以及建筑运行与控制的优化。随着建筑数据日益丰富以及数字孪生技术所展现的潜力，模型校准的需求愈发凸显，旨在提升模拟的可信度。然而，由于缺乏明确的指南和最佳实践，BES 校准仍面临诸多挑战。本研究旨在通过对 BES 校准关键方面的系统性综述，为未来研究奠定基础。具体而言，我们对模拟输入与输出、数据类型与分辨率、关键校准方法以及校准性能评估进行了元分析与分类。此外，本研究将可复现模拟视为关键问题，并提出了一种渐进式方法，以促进未来研究的可复现性。},
  file = {/home/ouyangjiahong/Zotero/storage/UCYCUFDW/S0378778821008173.html}
}

@article{chongruiAnalysisDesignHalo2020,
  title = {Analysis and Design of Halo Orbits in Cislunar Space},
  author = {Chongrui, D and Fain, M K and Starinova, O L},
  year = 2020,
  month = nov,
  journal = {IOP Conference Series: Materials Science and Engineering},
  volume = {984},
  number = {1},
  pages = {012033},
  issn = {1757-8981, 1757-899X},
  doi = {10.1088/1757-899X/984/1/012033},
  urldate = {2025-11-20},
  abstract = {This paper examines the formation of halo-orbits by a spacecraft around L1 and L2 libration points of the Earth-Moon system. Perturbations from the gravitation of the Sun and the non-centrality of the gravitational fields of the Moon and the Earth are taken into account (LP165p model). The proposed perturbed model is an intermediate stage between the dynamic model of the three bodies of the Earth-Moon system and the high-precision non-periodic ephemeris model. The paper proposes two strategies for maintaining halo orbits. The first is to use a small impulse performed on each half of the orbit. The second is to use continuation methods to form a periodic orbit that does not require additional corrections. The essence of the second strategy is to use the perturbation periodicity to generate a special multi-circular halo orbit resonating with the perturbation period. The results of these two approaches are presented for various perturbed models.},
  langid = {english},
  annotation = {titleTranslation: 地月空间晕轨道分析与设计\\
abstractTranslation: 本文研究了航天器在地月系L1和L2平动点附近形成晕轨道的相关问题，考虑了太阳引力以及月球和地球引力场非中心性（LP165p模型）的摄动影响。所提出的摄动模型是地月系三体动力学模型与高精度非周期星历模型之间的中间阶段。本文提出了两种维持晕轨道的策略：其一是在每半个轨道上施加一次小推力脉冲；其二是利用延拓法形成无需额外修正的周期轨道。第二种策略的核心在于利用摄动周期性，生成一种与摄动周期共振的特殊多圈晕轨道。针对多种摄动模型，给出了这两种方法的结果。},
  file = {/home/ouyangjiahong/Zotero/storage/LUVFGWUM/Chongrui 等 - 2020 - Analysis and design of halo orbits in cislunar space.pdf}
}


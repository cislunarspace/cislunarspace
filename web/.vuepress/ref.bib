  abstract = {Collinear Earth--Moon libration points have emerged as locations with immediate applications. These libration point orbits are inherently unstable and must be maintained regularly which constrains operations and maneuver locations. Stationkeeping is challenging due to relatively short time scales for divergence, effects of large orbital eccentricity of the secondary body, and third-body perturbations. Using the Acceleration Reconnection and Turbulence and Electrodynamics of the Moon's Interaction with the Sun (ARTEMIS) mission orbit as a platform, the fundamental behavior of the trajectories is explored using Poincare\textasciiacute{} maps in the circular restricted three-body problem. Operational stationkeeping results obtained using the Optimal Continuation Strategy are presented and compared to orbit stability information generated from mode analysis based in dynamical systems theory.},
  langid = {english},
  annotation = {titleTranslation: 地月平动点轨道位置保持：理论、建模与操作\\
abstractTranslation: 共线地月平动点已成为具有即时应用价值的区域。这些平动点轨道本身具有不稳定性，必须定期进行维持，从而限制了操作和机动位置。由于发散时间尺度较短、次级天体轨道偏心率较大以及第三体摄动效应，轨道保持面临挑战。以``加速重联与月球与太阳相互作用的湍流及电动力学''（ARTEMIS）任务轨道为平台，利用圆形限制性三体问题中的Poincar\'e映射，探讨了轨迹的基本行为。展示了采用最优延续策略获得的运行轨道保持结果，并与基于动力学系统理论模态分析生成的轨道稳定性信息进行了比较。},
  file = {/home/ouyangjiahong/Zotero/storage/G244XC82/Folta 等 - 2014 - Earth–moon libration point orbit stationkeeping theory, modeling, and operations.pdf;/home/ouyangjiahong/Zotero/storage/MRITQ6ZE/Folta 等 - 2014 - Earth–moon libration point orbit stationkeeping theory, modeling, and operations.pdf}
}

@article{foltaEarthMoonSystem2015,

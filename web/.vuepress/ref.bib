  doi = {10.1007/s10569-010-9283-5},
  urldate = {2026-02-18},
  abstract = {A method for the nonlinear propagation of uncertainties in Celestial Mechanics based on differential algebra is presented. The arbitrary order Taylor expansion of the flow of ordinary differential equations with respect to the initial condition delivered by differential algebra is exploited to implement an accurate and computationally efficient Monte Carlo algorithm, in which thousands of pointwise integrations are substituted by polynomial evaluations. The algorithm is applied to study the close encounter of asteroid Apophis with our planet in 2029. To this aim, we first compute the high order Taylor expansion of Apophis' close encounter distance from the Earth by means of map inversion and composition; then we run the proposed Monte Carlo algorithm to perform the statistical analysis.},
  langid = {english},
  keywords = {Apophis close encounter,Differential algebra,Monte Carlo simulation,Uncertainties propagation},
  annotation = {titleTranslation: 利用微分代数进行小行星近距相遇特性分析：以阿波菲斯为例\\
abstractTranslation: 一种基于微分代数的天体力学不确定性非线性传播方法被提出。利用微分代数提供的常微分方程流相对于初始条件的任意阶泰勒展开，实现了一种精确且计算高效的蒙特卡罗算法，该算法中用多项式求值替代了数千次逐点积分。将该算法应用于研究2029年小行星阿波菲斯与地球的近距离交会。为此，我们首先通过映射求逆与组合计算阿波菲斯近距离交会距离的高阶泰勒展开，随后运行所提出的蒙特卡罗算法进行统计分析。},
  file = {/home/ouyangjiahong/Zotero/storage/2DSF6N24/Armellin 等 - 2010 - Asteroid close encounters characterization using differential algebra the case of apophis.pdf}
}


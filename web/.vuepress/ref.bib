@article{sandeepsinghEclipseconsciousTransferLunar2021,
  title = {Eclipse-Conscious Transfer to Lunar Gateway Using Ephemeris-Driven Terminal Coast Arcs},
  author = {Sandeep Singh, John Junkins Brian Anderson},
  year = 2021,
  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {Vol.44},
  number = {No.11},
  pages = {1972--1988},
  issn = {0731-5090},
  doi = {10.2514/1.G005920},
  abstract = {A novel methodology is proposed for designing low-thrust trajectories to quasi-periodic, near-rectilinear Halo orbits that leverages ephemeris-driven, ``invariant manifold analogs'' as long-duration asymptotic terminal coast arcs. The proposed methodology generates end-to-end, eclipse-conscious, fuel-optimal transfers in an ephemeris model using an indirect formulation of optimal control theory. The end-to-end trajectories are achieved by patching Earth-escape spirals to a judiciously chosen set of states on precomputed manifolds. The results elucidate the efficacy of employing such a hybrid optimization algorithm for solving end-to-end analogous fuel-optimal problems using indirect methods and leveraging a composite smooth control construct. Multiple representative cargo resupply trajectories are generated for the Lunar Orbital Platform-Gateway. A novel process is introduced to incorporate eclipse-induced coast arcs and their impact within optimization. The results quantify accurate {$\Delta$}V costs required for achieving efficient eclipse-conscious transfers for several launch opportunities in 2025 and are anticipated to find applications for analogous uncrewed missions.},
  langid = {english},
  keywords = {DESIGN,INVARIANT-MANIFOLDS,LOW-THRUST,OPTIMIZATION,PROPULSION,SET},
  annotation = {titleTranslation: 利用星历驱动终端滑行弧实现避日食转移至月球门户站。\\
abstractTranslation: 提出了一种新颖的方法，用于设计通往准周期、近直线晕轨道的低推力轨迹，该方法利用星历驱动的``不变流形模拟''作为长期渐近终端滑行弧段。所提出的方法基于最优控制理论的间接形式，在星历模型中生成端到端、考虑日食约束、燃料最优的转移轨道。通过将地球逃逸螺旋线与预先计算的流形上精心选取的状态点进行拼接，实现了完整的端到端轨迹。结果阐明了采用这种混合优化算法，通过间接方法并借助复合平滑控制结构来解决端到端类似燃料最优问题的有效性。为月球轨道平台-门户生成了多个代表性货运补给轨迹。引入了一种新颖的过程，将日食引发的滑行弧段及其影响纳入优化中。结果量化了2025年多次发射窗口实现高效日食感知转移所需的精确{$\Delta$}V成本，并预计将应用于类似的无人任务。}
}

@article{sandelNaturalForcedSpacecraft2024,
  title = {Natural and Forced Spacecraft Loitering in a near Rectilinear Halo Orbit},
  author = {Sandel, Carrie and Sood, Rohan},
  year = 2024,
  journal = {Journal of Astronautical Sciences},
  volume = {Vol.71},
  number = {No.3},
  pages = {1--25},
  issn = {0021-9142},
  doi = {10.1007/s40295-024-00446-7},
  abstract = {With an increasing number of missions planned to cislunar space, on-orbit servicing, inspection, and docking in a multi-body environment will need to take place in highly perturbed orbits for the first time. Thus, the investigation of these relative motion trajectories between two spacecraft is critical to successfully performing rendezvous and proximity operations in a multi-body environment. In this work, mass- and time-optimal trajectories are generated for a low-thrust chaser spacecraft entering into natural and forced loiter sequences about a target on a near rectilinear halo orbit. Constraints on the allowable region for safe rendezvous and proximity operations are applied to investigate the effects on feasible loitering maneuvers. Fuel costs are compared for transfers to both forced and natural loitering trajectories to determine the propellant reduction from leveraging the relative dynamics of NRHO manifolds.},
  langid = {english},
  keywords = {Circular restricted three-body problem,Cislunar,Low-thrust trajectory design,Rendezvous and proximity operations},
  annotation = {titleTranslation: 航天器在近直线晕轨道上的自然与受控驻留\\

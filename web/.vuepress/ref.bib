@article{darrenthorntonDimCislunarTarget2022,
  title = {Dim Cislunar Target Tracking with {{GEO-}} and {{HEO-based}} Optical Sensors},
  author = {Thornton, Darren and Little, Bryan and Steward, Bryan},
  year = 2022,
  journal = {Journal of Applied Remote Sensing},
  volume = {Vol.16},
  number = {No.4},
  pages = {044511},
  issn = {1931-3195},
  abstract = {This research considers the percentage of time that geosynchronous earth orbit (GEO)- and HEO-based optical sensors can track dim cislunar targets in L2 near-rectilinear Halo orbit (NRHO), taking into account observer constellation configuration---number of observer satellites and their orbits---as well as the sensors' lunar exclusion angle (LEA). Simulations are created using systems tool kit (STK) to model the targets, observers, sensors, and all relevant orbits. Outputs of the simulations include target-sensor-Moon and target-sensor-Sun angles, as well as target signal-to-noise ratios (SNRs). Outputs are used for analyzing whether the observer constellation has access to the target (i.e., at least one sensor is not lunar- or solar-angle excluded), and the quality of the observation (i.e., the achieved SNR for every time step of the simulation). This research finds that LEA is the most significant variable influencing the extent to which tracking custody can be maintained over L2 NRHO and Halo targets. While utilizing larger OCCs does tend to increase the probability that targets will be trackable, this effect is insignificant relative to the impact of utilizing a smaller LEA. If a 1~deg LEA is implemented for these sensors, target tracking is successful through roughly 50\% of the synodic period for targets in either orbit. Increasing the LEA beyond 3~deg decreases tracking uptime by a very significant margin for Halo targets, but not as significantly for NRHO targets.},
  langid = {english},
  keywords = {cislunar space domain awareness,lunar exclusion angle,optical sensors,space domain awareness,tracking},
  annotation = {titleTranslation: 基于地球同步轨道与高椭圆轨道光学传感器的地月空间暗弱目标跟踪\\
abstractTranslation: 本研究考虑了基于地球同步轨道（GEO）和地球高轨道（HEO）的光学传感器能够跟踪L2近直线晕轨道（NRHO）中暗淡地月空间目标的时间百分比，同时考虑了观测星座的配置------观测卫星数量及其轨道------以及传感器的月球规避角（LEA）。利用系统工具包（STK）建立仿真模型，对目标、观测器、传感器及所有相关轨道进行建模。仿真输出包括目标-传感器-月球角度、目标-传感器-太阳角度以及目标的信噪比（SNR）。这些输出用于分析观测星座是否能够访问目标（即至少有一个传感器未受月球或太阳角度限制），以及观测质量（即仿真每个时间步长所达到的SNR）。本研究发现，LEA是影响对L2 NRHO和Halo目标维持跟踪监护程度的最重要变量。虽然使用更大的观测星座（OCC）确实倾向于增加目标可跟踪的概率，但该效果相对于使用更小LEA的影响而言微不足道。若这些传感器采用1度LEA，则对于两种轨道的目标，在约50\%的会合周期内均可成功跟踪。将Halo目标的LEA增大至3度以上会显著降低跟踪可用时间，但对NRHO目标的影响则不那么显著},
  file = {/home/ouyangjiahong/Zotero/storage/M5NT7HWQ/Thornton 等 - 2022 - Dim cislunar target tracking with GEO- and HEO-based optical sensors.pdf}
}


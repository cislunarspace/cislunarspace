@article{zhangLargeLanguageModelbased2025,
  title = {A Large Language Model-Based Approach to Spacecraft Formation Mission Planning},
  author = {Zhang, Yuhang and Jiao, Bohan and Dang, Zhaohui},
  year = 2025,
  month = jan,
  journal = {IFAC-PapersOnLine},
  series = {23th {{IFAC Symposium}} on {{Automatic Control}} in {{Aerospace ACA}} 20255},
  volume = {59},
  number = {20},
  pages = {2166--2170},
  issn = {2405-8963},
  doi = {10.1016/j.ifacol.2025.11.480},
  urldate = {2026-03-08},
  abstract = {Recent breakthroughs in artificial intelligence have led to paradigm shifts in complex mission planning, particularly through the use of large language models (LLMs). This study explores the feasibility of applying LLMs to spacecraft formation mission planning, with space-based gravitational wave detection serving as a representative application scenario. We propose a Hierarchical LLM-driven Mission Planning Framework (HLMPF) consisting of three key components: (1) a domain-specific toolset tailored for gravitational wave detection missions, (2) a model for complex task decomposition, and (3) a task sequence execution model. The framework's autonomous planning capabilities are validated through closed-loop simulations of formation initialization scenarios. This work contributes novel theoretical insights and technical foundations for intelligent spacecraft mission planning.},
  langid = {english},
  keywords = {Formation flying,Gravitational wave detection,Large language models,Task planning},
  annotation = {titleTranslation: 基于大语言模型的航天器编队任务规划方法\\
abstractTranslation: 人工智能领域的最新突破已引发复杂任务规划中的范式转变，尤其是通过大语言模型（LLMs）的应用。本研究探讨了将LLMs应用于航天器编队任务规划的可行性，并以天基引力波探测作为代表性应用场景。我们提出了一种层次化LLM驱动的任务规划框架（HLMPF），该框架由三个关键组件构成：（1）针对引力波探测任务的专用工具集；（2）复杂任务分解模型；（3）任务序列执行模型。通过编队初始化场景的闭环仿真，验证了该框架的自主规划能力。本工作为航天器智能任务规划提供了新的理论见解与技术基础。},
  file = {/home/ouyangjiahong/Zotero/storage/6T543EGY/Zhang 等 - 2025 - A large language model-based approach to spacecraft formation mission planning.pdf;/home/ouyangjiahong/Zotero/storage/BQB9A52G/S2405896325021573.html}
}

@article{zhangLayoutAnalysisEfficiency2024,
  title = {Layout Analysis and Efficiency Evaluation of Space-Based {{DRO}} Monitoring System for near-Earth Asteroids},
  author = {Zhang, Wei and Li, Rundao and Shi, Xiaolian and Wu, Di and Yuan, Yuan and Wang, Wei},
  year = 2024,
  journal = {Journal of Deep Space Exploration},
  volume = {Vol.11},
  number = {No.2},
  pages = {184--194},
  abstract = {To address such the problems as the limitation of the invisible zone of the ground-based monitoring system for near-Earth asteroids and the insufficient discovery and cataloguing capabilities of the monitoring system, a solution of a space-based distant retrograde orbit 4-satellite monitoring system was proposed.Then, the space-based monitoring system's to solve the problems mentioned above was quantified and analyzed, and a cosrreponding model for evaluating the efficiency of the system was set up. A process for the implementation of the corresponding evaluation software was given and an integration of the scoring of various elements was completed in accordance with the visible and infrared spectrum. By analyzing and evaluating, the efficiency of the distant retrograde orbit monitoring layout in compensating for the full-time visibility of the invisible zone of the ground-based monitoring system was verified, as well as the enhancement of the capability of target discovery and cataloguing. This research could provide design reference for subsequent construction of space-based monitoring system.},
  langid = {english},
  keywords = {DRO,efficiency evaluation,invisible zone compensation,near-Earth asteroid,space-based monitoring,system layout},
  annotation = {titleTranslation: 近地小行星天基DRO监测系统布局分析与效能评估\\
abstractTranslation: 针对近地天体地基监测系统存在观测盲区受限以及监测系统发现与编目能力不足等问题，提出了基于空间远距离逆行轨道的四星监测系统方案。随后，对该空间监测系统解决上述问题的能力进行了量化分析，并建立了相应的系统效能评估模型。给出了相应评估软件的实现流程，并根据可见光与红外光谱完成了各要素评分的集成。通过分析评估，验证了远距离逆行轨道监测布局在弥补地基监测系统盲区全天时可见性方面的有效性，以及提升目标发现与编目能力的作用。该研究可为后续空间监测系统的建设提供设计参考。}
}


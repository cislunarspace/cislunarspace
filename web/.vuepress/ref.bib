  year = 2025,
  journal = {美国研究},
  volume = {39},
  number = {5},
  pages = {48--65},
  urldate = {2026-04-05},
  abstract = {``算法部落化''是美国文化战争演化格局与社会互动模式的新形态。在人工智能技术进步的推动下，美国文化战争呈现出系统性转向。传播范式由大众化扩散转为圈层化渗透，催生封闭性文化集群；叙事逻辑则从事实争夺转向情感塑造，算法机制强化群体间区隔；博弈空间从实体场域延伸至虚实交互生态，重构文化战争权力分配与意识形态再生产逻辑。究其原因，这是市场、社会和政治三者共同作用的结果。具体而言，资本增值需求驱动文化符号数据化，社会裂隙借由算法偏见形成强化循环，政党则将技术工具异化为意识形态博弈载体。与此同时，人工智能技术嵌入也引发了美国文化政治嬗变，从认知隔阂推升对抗性立场，到隐蔽运算压缩传统公共领域协商空间，再到监管滞后带来的文化治理失效，美国文化战争逐步走向``算法部落化'',预示着数字生态中文化政治的全新范式危机。},
  langid = {chinese},
  annotation = {Fund: 国家社科基金研究项目的阶段性成果；},
  file = {/home/ouyangjiahong/Zotero/storage/YEFJVK33/申青青和罗建波 - 2025 - 算法部落化：人工智能对美国文化战争的嵌入.pdf}
}


@article{ShenNianGanJuShenZhiNengShiChangDeLongDuanFengXianJiQiYingDui2026,
  title = {{具身智能市场的垄断风险及其应对}},
  author = {{沈年淦}},
  year = 2026,
  month = jan,
  journal = {科学学研究},
  pages = {1--18},
  issn = {1003-2053},
  doi = {10.16192/j.cnki.1003-2053.20260130.003},
  urldate = {2026-02-05},
  abstract = {具身智能作为``十五五''规划中的六大未来产业之一，其市场的高质量发展面临数据采集、产业链条、智能协同、产业政策四个维度的垄断风险。相较于传统的人工智能，具身智能在行为模式、产业链条、竞争形态方面存在显著区别。其依据``自主感知-实时决策-物理交互''的逻辑，在产业链上呈现出``上游技术-中游集成-下游场景''的结构，市场竞争则表现为``数据竞争-创新竞争-生态竞争''三个层次。为应对上述风险，需要重塑监管理念，优化监管工具：以敏捷治理和包容审慎监管为依托，以竞争倡导和市场研究为手段，对具身智能市场进行全方位、全周期的智慧监管，通过``平行智能系统''，实现``以技术治理技术''。对于具身智能面临的垄断风险，需要进行体系规制：一是破除具身数据流通壁垒，对前端合成数据、终端场景数据的流通，在特定情形下可以考虑强制共享；二是保持具身智能生态开放，避免生态系统的主导者从事排他性滥用行为，打破用户锁定效应，保障消费者自由选择，对自身数据能够自由迁移，从而实现生态系统的``去中心化''；三是规范具身智能市场协作，将消费者利益和竞争秩序融入算法价值对齐，保障算法的透明度，面对不同的算法共谋，需要采取类型化的风险应对策略；四是强化公平竞争审查，通过统一标准规范、引导行业自律，达成产业政策与竞争政策的有效协调。},
  langid = {chinese},
  annotation = {original-container-title: Studies in Science of Science\\
AIF: 6.131\\
album: 社会科学I辑;信息科技;经济与管理科学\\
CIF: 11.869\\
CLC: F426.67;D922.294;F49\\

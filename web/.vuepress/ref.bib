@article{battistaQuantumEffectsLagrangian2015,
  title = {Quantum Effects on Lagrangian Points and Displaced Periodic Orbits in the {{Earth-moon}} System},
  author = {Battista, Emmanuele and Dell'Agnello, Simone and Esposito, Giampiero and Simo, Jules},
  year = 2015,
  month = apr,
  journal = {Physical Review D},
  volume = {91},
  number = {8},
  eprint = {1501.02723},
  primaryclass = {gr-qc},
  pages = {084041},
  issn = {1550-7998, 1550-2368},
  doi = {10.1103/PhysRevD.91.084041},
  urldate = {2025-11-27},
  abstract = {Recent work in the literature has shown that the one-loop long distance quantum corrections to the Newtonian potential imply tiny but observable effects in the restricted three-body problem of celestial mechanics, i.e., at the Lagrangian libration points of stable equilibrium the planetoid is not exactly at equal distance from the two bodies of large mass, but the Newtonian values of its coordinates are changed by a few millimeters in the Earth-Moon system. First, we assess such a theoretical calculation by exploiting the full theory of the quintic equation, i.e., its reduction to Bring-Jerrard form and the resulting expression of roots in terms of generalized hypergeometric functions. By performing the numerical analysis of the exact formulas for the roots, we confirm and slightly improve the theoretical evaluation of quantum corrected coordinates of Lagrangian libration points of stable equilibrium. Second, we prove in detail that also for collinear Lagrangian points the quantum corrections are of the same order of magnitude in the Earth-Moon system. Third, we discuss the prospects to measure, with the help of laser ranging, the above departure from the equilateral triangle picture, which is a challenging task. On the other hand, a modern version of the planetoid is the solar sail, and much progress has been made, in recent years, on the displaced periodic orbits of solar sails at all libration points, both stable and unstable. The present paper investigates therefore, eventually, a restricted three-body problem involving Earth, Moon and a solar sail. By taking into account the one-loop quantum corrections to the Newtonian potential, displaced periodic orbits of the solar sail at libration points are again found to exist.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Astrophysics - Earth and Planetary Astrophysics,General Relativity and Quantum Cosmology},
  annotation = {titleTranslation: 地球-月球系统中拉格朗日点与位移周期轨道的量子效应\\
abstractTranslation: 近期文献研究表明，牛顿势的单圈长距离量子修正会在天体力学限制性三体问题中产生微小但可观测的效应，即在稳定平衡的拉格朗日平动点处，小天体并非严格位于两个大质量天体的等距位置，而是在地月系统中其坐标的牛顿值发生了数毫米的改变。首先，我们利用五次方程的完整理论（即将其约化为Bring-Jerrard形式，并借助广义超几何函数给出根的表达式）来评估上述理论计算。通过对根的精确公式进行数值分析，我们验证并略微改进了稳定平衡拉格朗日平动点量子修正坐标的理论估值。其次，我们详细证明，在地月系统中，共线拉格朗日点的量子修正也具有相同的数量级。第三，我们讨论了借助激光测距技术测量上述偏离等边三角形构型的可能性------这是一项具有挑战性的任务。另一方面，现代版的小天体即太阳帆，近年来在平动点（包括稳定与不稳定点）处的太阳帆位移周期轨道研究已取得显著进展。因此，本文最终探讨了涉及地球、月球和太阳帆的限制性三体问题。在考虑牛顿势的单圈量子修正后，我们再次发现太阳帆在平动点处存在位移周期轨道。},
  file = {/home/ouyangjiahong/Zotero/storage/QCV64A8V/Battista 等 - 2015 - Quantum effects on lagrangian points and displaced periodic orbits in the Earth-moon system.pdf}
}

@inproceedings{beauregardOptimizedTransfersEarthmoon2019,

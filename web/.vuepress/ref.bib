@article{bosanacClusteringNaturalTrajectories2026,
  title = {Clustering Natural Trajectories in the {{Earth-moon}} Circular Restricted Three-Body Problem},
  author = {Bosanac, Natasha},
  year = 2026,
  month = feb,
  journal = {Journal of Astronautical Sciences},
  volume = {73},
  number = {1},
  pages = {2--42},
  publisher = {Springer US},
  issn = {2195-0571},
  doi = {10.1007/s40295-025-00539-x},
  urldate = {2026-04-23},
  abstract = {Summaries of the diverse array of natural spacecraft motions that exist within cislunar space could support trajectory design and space situational awareness. This paper uses a clustering-based framework to automatically summarize the prominent geometries of a large set of natural, spatial trajectories in the Earth-Moon circular restricted three-body problem. This procedure is demonstrated using trajectories that begin near the Moon, possess a specified duration, and exist across a range of energy levels. These continuous trajectories are discretized using a curvature-based sampling scheme that efficiently captures their global shape. These samples are used to form finite-dimensional feature vectors that summarize the shape and path of each trajectory. Using these definitions, initial conditions are sampled throughout a desired region of the phase space in a geometry-based manner that relies on the concept of curvature as well as localized clustering. The trajectories associated with these initial conditions are then grouped by their geometry in a distributed manner by applying a two-step, density-based clustering process to their feature vectors. The result is a data-driven summary of prominent geometries exhibited across a large set of trajectories sampled from a complex and diverse solution space.},
  copyright = {2025 The Author(s)},
  langid = {english},
  keywords = {Cislunar space,Clustering,Curvature,Data-driven summary of trajectories,Multi-body gravitational system},
  annotation = {titleTranslation: 聚类地月圆型限制性三体问题中的自然轨迹\\
abstractTranslation: 对地月空间内自然航天器多种运动模式的总结有助于轨道设计和空间态势感知。本文采用基于聚类的框架，自动归纳地球-月球圆型限制性三体问题中大量自然空间轨迹的突出几何特征。该流程以靠近月球出发、具有指定持续时间且分布于不同能级水平的轨迹为例进行演示。这些连续轨迹通过基于曲率的采样方案进行离散化，该方案能高效捕捉其全局形状。采样点被用于构建有限维特征向量，以概括每条轨迹的形状与路径。基于这些定义，初始条件以几何导向的方式（利用曲率概念及局部聚类）在相空间的目标区域内进行采样。随后，通过对其特征向量应用两步密度聚类过程，将这些初始条件对应的轨迹按几何特征进行分布式分组。最终形成数据驱动的总结，呈现从复杂多样的解空间中采样得到的大量轨迹所展现的突出几何形态},
  file = {/home/ouyangjiahong/Zotero/storage/NHYUFKI7/Bosanac - 2026 - Clustering natural trajectories in the Earth-moon circular restricted three-body problem.pdf;/home/ouyangjiahong/Zotero/storage/KWAVR7UG/abstract.html}
}

@phdthesis{bosanacLeveragingNaturalDynamical2016,
  title = {Leveraging Natural Dynamical Structures to Explore Multi-Body Systems},
  author = {Bosanac, Natasha},
  year = 2016,
  abstract = {Multi-body systems have become the target of an increasing number of mission concepts and observations,supplying further information about the composition,origin and dynamical environment of bodies within the solar system and beyond. In many of these scenarios,identification and characterization of the particular solutions that exist in a circular restricted three-body model is valuable. This insight into the underlying natural dynamical structures is achieved via the application of dynamical systems techniques. One application of such analysis is trajectory design for CubeSats,which are intended to explore cislunar space and other planetary systems. These increasingly complex mission objectives necessitate innovative trajectory design strategies for spacecraft within our solar system,as well as the capability for rapid and well-informed redesign. Accordingly,a trajectory design framework is constructed using dynamical systems techniques and demonstrated for the Lunar IceCube mission. An additional application explored in this investigation involves the motion of an exoplanet near a binary star system. Due to the strong gravitational field near a binary star,physicists have previously leveraged these systems as testbeds for examining the validity of gravitational and relativistic theories. In this investigation,a preliminary analysis into the effect of an additional three-body interaction on the dynamical environment near a large mass ratio binary system is conducted. As demonstrated through both of these sample applications,identification and characterization of the natural particular solutions that exist within a multi-body system supports a well-informed and guided analysis.},
  langid = {english},
  school = {Purdue University},
  keywords = {Applied sciences,Dynamical environments,Multi-body systems},
  annotation = {titleTranslation: 利用自然动力学结构探索多体系统},
  file = {/home/ouyangjiahong/Zotero/storage/PR7W8TG8/Bosanac - 2016 - Leveraging natural dynamical structures to explore multi-body systems.pdf}
}

@mastersthesis{boudad2018disposal,
  title = {Disposal Dynamics from the Vicinity of near Rectilinear Halo Orbits in the {{Earth-moon-sun}} System},
  author = {Boudad, Kenza Katiane},
  year = 2018,
  abstract = {After completion of a resupply mission to NASA's proposed Lunar Orbital Platform - Gateway, safe disposal of the Logistics Module is required. One potential  option is disposal to heliocentric space. This investigation includes an exploration of  the trajectory escape dynamics from an Earth-Moon L2 Near Rectilinear Halo Orbit  (NRHO). The effects of the solar gravitational perturbations are assessed in the Bicircular Restricted 4-Body Problem (BCR4BP), as defined in the Earth-Moon rotating  frame and in the Sun-B1 rotating frame, where B1 is the Earth-Moon barycenter.  Disposal trajectories candidates are classified in three outcomes: direct escape, indirect escapes and captures. Characteristics of each outcome is defined in terms of  three parameters: the location of the apoapses within to the Sun-B1 rotating frame,  a characteristic Hamiltonian value, and the osculating eccentricity with respect to  the Earth-Moon barycenter. Sample trajectories are presented for each outcome.  Low-cost disposal options are introduced.},
  langid = {english},
  school = {Purdue University},
  annotation = {titleTranslation: 地月日系统近直线晕轨道附近弃置动力学\\
abstractTranslation: 在完成对NASA拟建月球轨道平台``门户''的补给任务后，需对后勤舱进行安全处置。一种潜在处置方案是将其抛射至日心空间。本研究探讨了从地月系L2近直线晕轨道（NRHO）逃逸的轨迹动力学特性，并在双圆限制性四体问题（BCR4BP）框架下评估了太阳引力摄动的影响------该框架分别定义于地月旋转坐标系及太阳-B1旋转坐标系（其中B1为地月系质心）。处置轨迹候选方案按三种结果分类：直接逃逸、间接逃逸与捕获。每种结果的特征通过三个参数界定：在太阳-B1旋转坐标系中的远心点位置、特征哈密顿量值，以及相对于地月系质心的瞬时偏心率。本文针对每种结果展示了示例轨迹，并提出了低能耗处置方案。},
  file = {/home/ouyangjiahong/Zotero/storage/TTWC67YJ/Boudad - 2018 - Disposal dynamics from the vicinity of near rectilinear halo orbits in the Earth-moon-sun system.pdf}
}


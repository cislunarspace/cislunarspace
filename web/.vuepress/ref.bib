@phdthesis{LiShuangLinDiYueKongJianDROHangTianQiBianDuiTongBoShuChaiFenZiZhuDaoHang2023,
  type = {{硕士学位论文}},
  title = {{地月空间DRO航天器编队同波束差分自主导航}},
  author = {{李霜琳}},
  year = 2023,
  address = {北京},
  abstract = {随着地月空间任务的不断推进，航天器编队任务自主相对导航技术将发挥重要作用。中国科学院战略性先导科技专项地月空间DRO探索研究任务对远距离逆行轨道（Distant Retrograde Orbit, DRO）航天器编队提出自主相对导航的需求，即运行于DRO轨道的两个航天器需不依赖于地基测控自主解算相对轨道状态。本文提出了地月空间DRO航天器编队的同波束差分相对导航方法，近地轨道（Low Earth Orbit, LEO）航天器的测量波束可同时覆盖DRO轨道上的两个编队航天器。基于这两条测量链路获得的差分测距数据，并考虑DRO轨道处于地月三体非对称引力场的特性，航天器编队的相对轨道状态的解算具有可观测性。同波束差分测量数据消除了共同误差，可显著提升DRO航天器编队的自主相对导航能力。本文首先建立高保真星间双向单程测量模型，并对模型中各项因素误差进行了定量分析，这是基于星间链路实现航天器自主定轨以及航天器编队相对导航的基础。进一步，确定DRO航天器编队中主星的绝对轨道，这是同波束相对导航的基础。已有研究表明利用星间测量链路可不依赖于地基测量自主确定DRO编队主星轨道，但这种自主导航方法的前提是月球的精密历表已知，因此该方法并非严格意义上的自主导航。本文提出了基于星间测量链路自主确定DRO编队主星轨道和月球星历的方法，分析了地月空间中不同星间链路场景对于月球星历自主确定的可观测性，并进行了数值仿真计算。研究结果表明：DRO-LEO测量链路场景对于月球星历的自主确定是最优的，月球星历的位置精度可达10米级， DRO编队主星定轨位置精度为米级。因此，基于DRO-LEO测量链路，LEO航天器、DRO主星以及月球星历可实现自主定轨。最后，本文给出基于LEO航天器同波束差分测量的DRO编队相对导航方法。由于LEO航天器和DRO主星的轨道已通过星间测量链路确定，且DRO编队所处轨道的处于地月三体引力场非对称度较高，此时差分测量数据序列与航天器编队的相对状态一一对应，相对导航具有可观测性。本文对同波束差分相对导航的研究包括以下几个部分：建立差分观测模型，给出相对动力学模型和扩展卡尔曼滤波（EKF）方法，并开展可观测性分析。同波束差分相对导航的数值仿真结果表明相对轨道确定精度达到5m，相比于传统相对轨道计算方法（即利用LEO-DRO链路分别计算两个DRO航天器的绝对轨道后再作差）提高4倍。本论文的研究结论表明，地月空间星间链路测量具备自主估计月球星历的能力，同时自主确定卫星轨道状态。LEO航天器同波束差分测量方法可以实现DRO航天器编队米级自主相对导航，满足在轨编队任务需要。},
  langid = {chinese},
  school = {中国科学院大学},
  keywords = {;;(SST);;(DRO)}
}

@article{LiShuangLinDROWeiXingBianDuiTongBoShuChaiFenXiangDuiDaoHang2023,

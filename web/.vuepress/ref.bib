@book{ChenGuoJiuGuoWaiTaiKongJunYanYuTaiKongAnQuanZhanLueYanJiu2022,
  title = {国外太空军演与太空安全战略研究},
  author = {{陈国玖} and {杨广华}},
  year = 2022,
  publisher = {北京：北京理工大学出版社},
  abstract = {本书分为两大部分内容：国外太空军演情况分析和国外太空安全战略研究。本书深入探讨了世界主要国家太空军演开展情况及各国出台的相关战略。以美国为例，介绍美国太空战略转型及其影响、美国太空力量建设、美国太空网络作战能力建设，对美国太空军演情况、美国太空威慑力量建设情况、美军太空武器装备发展进行分析。美国已对完善太空治理法律架构、打造太空安全国际联盟、推进太空商业化进程等重要内容作出明确战略部署。在这些战略之下，推出具有重要研究价值的具体措施。特别对美``施里弗''``太空旗帜''``全球哨兵''等演习组织实施情况及取得成果进行了综合分析，总结美军太空作战演习、太空力量运用等方面的做法经验。本书可供相关科研人员、学生及军事爱好者阅读。},
  keywords = {------}
}

@phdthesis{ChenGuoQingMianXiangDiYueJiHuiShiWangLuoDeShuJuLiuBianMaChuanShuFangAnYanJiu2021,
  type = {{硕士学位论文}},
  title = {{面向地月机会式网络的数据流编码传输方案研究}},
  author = {{陈国庆}},
  year = 2021,
  month = jan,
  address = {哈尔滨},
  doi = {10.27061/d.cnki.ghgdu.2019.006425},
  urldate = {2026-05-18},
  abstract = {随着新一轮探月工程的兴起,实现地月间高效通信越来越受到世界各国的广泛关注,作为未来载人登月的必要保障,通信系统的实时性和可靠性将对各项科学探测项目产生重大影响。由于业务的多样化,地月间通信业务类型已经从文本业务向各种流式传输的大数据量业务进行转变,且位于月球背面的源节点和位于地面的目的节点不存在直接可达的链路,传统点对点的通信方式已经无法满足未来地月通信的发展需求,组建包括地月中继卫星、环月卫星及已有地球侧混合星座的地月通信网络,并提出面向网络化的地月通信流式传输方案是未来月球探测领域的重点研究问题。相比较于传统互联网,地月通信网络所表现出的机会式网络特点使得目前各种基于静态拓扑的传输机制无法取得良好效果。本文主要针对未来地月通信的网络化传输问题,以减少数据传输时延及网络耗能为目标,考虑地月机会式网络环境下的链路与节点动态性等约束条件,建立流式传输模型,提出基于无码率编码的自适应传输策略,实现流式数据的高效可靠传输。具体围绕以下几方面展开研究:针对地月机会式网络下的传输机制问题,本文通过信息流图分析了数据在系统中的存储和流动过程,基于时间切片静态图模型对网络中数据流动和能量损耗进行分析。...},
  collaborator = {{王野}},
  langid = {chinese},
  school = {哈尔滨工业大学},
  annotation = {Major: 信息与通信工程\\
Fund: 国家自然科学基金青年项目,``面向深空通信网络中数据流业务的无码率传输协议研究''(项目编号61701136)； 国家自然科学基金重点项目,``面向载人登月的空间信息传输理论与关键技术''(项目编号61831008)；},
  file = {/home/ouyangjiahong/Zotero/storage/HECFYNF3/陈国庆 - 2021 - 面向地月机会式网络的数据流编码传输方案研究.pdf}
}


@article{HouBoWenXuLieTuXiangZiZhuDaoHangXiTongGuanCeNengLiYouHuaFangFa2024,
  title = {{序列图像自主导航系统观测能力优化方法}},
  author = {{侯博文} and {王大轶} and {王炯琦} and {董天舒} and {李嘉兴}},

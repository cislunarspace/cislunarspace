@article{LeiHanLunXiaoTuiLiXianZhiXingSanTiXiTongXiaWenDingPingDongDianFuJinDeGaoJieJie2015,
  title = {小推力限制性三体系统下稳定平动点附近的高阶解},
  author = {{雷汉伦} and {徐波}},

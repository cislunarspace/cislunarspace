  doi = {10.26914/c.cnkihy.2025.041466},
  urldate = {2026-01-11},
  abstract = {近直线晕轨道(Near-rectilinear halo orbit,NRHO)是一种正在计划当中,位于地月之间的一种轨道类型,其主要充当起前往环月轨道的缓冲区。NASA计划在2024年部署月球通道计划,其运行轨道将是一种高偏心率椭圆轨道(近乎是一条直线),轨道周期为7天。在这条轨道上运行的小型空间站会将月球北极上空3000 km处作为近月点,而远月点位于月球南极上空70000 km处。首先,利用圆形限制性三体模型和遗传算法在matlab上仿真计算出具有完整周期的NRHO轨道族;其次,选取其中不同的NRHO轨道,获取所对应的位置和速度;最后,通过构建深度网络来学习NRHO的轨道位置随时间的变化,进而预测未来的位置和速度。通过仿真结果可知,所构建的网络结构很好地学习了轨道参数随时间变化的规律,每一个不同的轨道预测的位置和速度误差在300km和1km/s以内,模型评估系数达到0.99,为L1点的NRHO任务轨道设计提供参考,省略积分过程,提高计算效率。 更多 还原 AbstractFilter('ChDivSummary', 'ChDivSummaryMore', 'ChDivSummaryReset');},
  langid = {chinese},
  keywords = {,(NRHO)},
  annotation = {album: 工程科技II辑;信息科技\\
CLC: TP18;V412.41\\
dbcode: CPFD\\
dbname: CPFDLAST2025\\
download: 51\\
filename: BJLH202503001184},
  file = {/home/ouyangjiahong/Zotero/storage/IHYNF7I7/基于深度学习的L1点NRHO轨道预测方法研究_叶亚华.pdf;/home/ouyangjiahong/Zotero/storage/YR5NMW5D/叶亚华和钱霙婧 - 基于深度学习的L1点NRHO轨道预测方法研究.pdf}
}

@article{YeZhengYuShenKongTanCeHangTianQiZiTaiKongZhiXiTongGuZhangDingWei2019,
  title = {深空探测航天器姿态控制系统故障定位},
  author = {{叶正宇} and {程月华} and {韩笑冬} and {姜斌}},
  year = 2019,
  journal = {控制理论与应用},
  number = {第12期},
  pages = {2093--2099},
  abstract = {执行机构与敏感器故障检测与定位是深空探测任务卫星平台可靠运行的前提和保障.本文从数据的角度出发,结合姿控系统工作机理,提出一种基于神经网络和支持向量机结合的故障诊断方法用于检测并定位故障.故障诊断方法分为3步,首先采集姿控系统的状态信息,采用神经网络对闭环姿控系统中未知动态特性建模并进行预测;然后将姿控系统敏感器信号与神经网络预测输出比较生成残差并提取故障特征;最后采用支持向量机辨识残差特征检测故障,并结合运动学特性分析定位故障.仿真结果表明本文所提方法可以有效提取、辨识故障特征,实现执行器与敏感器的故障检测定位.},
  keywords = {;;;},
  file = {/home/ouyangjiahong/Zotero/storage/3I9GYB74/叶正宇 等 - 2019 - 深空探测航天器姿态控制系统故障定位.pdf}

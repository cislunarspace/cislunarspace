@article{chengStudyTransferLibration2017,
  title = {Study of the Transfer between Libration Point Orbits and Lunar Orbits in {{Earth}}--Moon System},
  author = {Cheng, Yu and G{\'o}mez, Gerard and Masdemont, Josep J. and Yuan, Jianping},
  year = 2017,
  month = aug,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {128},
  number = {4},
  pages = {409--433},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-017-9759-7},
  urldate = {2025-11-27},
  abstract = {This paper is devoted to the study of the transfer problem from a libration point orbit of the Earth-Moon system to an orbit around the Moon. The transfer procedure analysed has two legs: the first one is an orbit of the unstable manifold of the libration orbit and the second one is a transfer orbit between a certain point on the manifold and the final lunar orbit. There are only two manoeuvres involved in the method and they are applied at the beginning and at the end of the second leg. Although the numerical results given in this paper correspond to transfers between halo orbits around the L1 point (of several amplitudes) and lunar polar orbits with altitudes varying between 100 and 500 km, the procedure we develop can be applied to any kind of lunar orbits, libration orbits around the L1 or L2 points of the Earth-Moon system, or to other similar cases with different values of the mass ratio.},
  langid = {english},
  annotation = {titleTranslation: 地月系统中平动点轨道与月球轨道之间转移的研究\\
abstractTranslation: 本文致力于研究从地月系统平动点轨道至月球轨道的转移问题。所分析的转移过程包含两段：第一段是平动点轨道的不稳定流形上的轨道，第二段是流形上某一点与最终月球轨道之间的转移轨道。该方法仅涉及两次机动，分别施加于第二段的起点和终点。尽管本文给出的数值结果对应的是从L1点附近（不同振幅）的晕轨道转移至高度在100至500公里之间的月球极轨，但我们所发展的方法可适用于任意类型的月球轨道、地月系统L1或L2点附近的平动点轨道，以及其他质量比不同的类似情形},
  file = {/home/ouyangjiahong/Zotero/storage/GKINCWHT/Cheng 等 - 2017 - Study of the transfer between libration point orbits and lunar orbits in Earth–moon system.pdf}
}

@article{ChenGuanHuaDiYueKongJianDeYuanJuChiNiXingGuiDaoZuJiQiFenChaYanJiu2022,
  title = {{地月空间的远距离逆行轨道族及其分岔研究}},
  author = {{陈冠华} and {杨驰航} and {张晨} and {张皓}},

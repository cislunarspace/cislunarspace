@article{johnstonFuelEfficientPoweredDescent2020,
  title = {Fuel-{{Efficient Powered Descent Guidance}} on {{Large Planetary Bodies}} via {{Theory}} of {{Functional Connections}}},
  author = {Johnston, Hunter and Schiassi, Enrico and Furfaro, Roberto and Mortari, Daniele},
  year = 2020,
  month = dec,
  journal = {Journal of Astronautical Sciences},
  volume = {67},
  number = {4},
  pages = {1521--1552},
  issn = {2195-0571},
  doi = {10.1007/s40295-020-00228-x},
  urldate = {2026-02-04},
  abstract = {In this paper we present a new approach to solve the fuel-efficient powered descent guidance problem on large planetary bodies with no atmosphere (e.g., Moon or Mars) using the recently developed Theory of Functional Connections. The problem is formulated using the indirect method which casts the optimal guidance problem as a system of nonlinear two-point boundary value problems. Using the Theory of Functional Connections, the problem's linear constraints are analytically embedded into a functional, which maintains a free-function that is expanded using orthogonal polynomials with unknown coefficients. The constraints are always analytically satisfied regardless of the values of the unknown coefficients (e.g., the coefficients of the free-function) which converts the two-point boundary value problem into an unconstrained optimization problem. This process reduces the whole solution space into the admissible solution subspace satisfying the constraints and, therefore, simpler, more accurate, and faster numerical techniques can be used to solve it. In this paper a nonlinear least-squares method is used. In addition to the derivation of this technique, the method is validated in two scenarios and the results are compared to those obtained by the general purpose optimal control software, GPOPS-II. In general, the proposed technique produces solutions of \$\textbackslash mathcal \textbraceleft O\textbraceright (10\textasciicircum\textbraceleft -10\textbraceright )\$accuracy. Additionally, for the proposed test cases, it is reported that each individual TFC-based inner-loop iteration converges within 6 iterations, each iteration exhibiting a computational time between 72 and 81 milliseconds, with a total execution time of 2.1 to 2.6 seconds using MATLAB. Consequently, the proposed methodology is potentially suitable for real-time computation of optimal trajectories.},
  langid = {english},
  keywords = {Constraint embedding,Fuel optimal pinpoint landing,Indirect method,Least-squares,Optimal control,Theory of functional connections},
  annotation = {TLDR: A nonlinear least-squares method is used to solve the fuel-efficient powered descent guidance problem on large planetary bodies with no atmosphere using the recently developed Theory of Functional Connections and produces solutions of O ( 10 - 10 ) accuracy.\\
titleTranslation: 基于函数连接理论的大型行星体燃料高效动力下降制导\\
abstractTranslation: 本文提出了一种利用近期发展的函数连接理论（Theory of Functional Connections）解决无大气层大型行星体（如月球或火星）上燃料最优动力下降制导问题的新方法。该问题采用间接法进行建模，将最优制导问题转化为一个非线性两点边值问题系统。通过函数连接理论，问题的线性约束被解析地嵌入到一个泛函中，该泛函保留了一个自由函数，该函数使用正交多项式展开并带有未知系数。无论未知系数的值如何（例如自由函数的系数），约束条件始终解析满足，从而将两点边值问题转化为无约束优化问题。这一过程将整个解空间缩减到满足约束条件的可行解子空间，因此可以采用更简单、更精确且更快速的数值技术进行求解。本文采用非线性最小二乘法。除了对该技术的推导外，还在两个场景下对该方法进行了验证，并将结果与通用最优控制软件GPOPS-II获得的结果进行了比较。总体而言，所提出的技术能够产生精度为\$\textbackslash mathcal\textbraceleft O\textbraceright (10\textasciicircum\textbraceleft -10\textbraceright )\$的解。此外，在提出的测试案例中，每个基于TFC的内层迭代收敛于6次迭代内，每次迭代的计算时间在72至81毫秒之间，使用MATLAB的总执行时间为2.1至2.6秒。因此，所提出的方法具有实时计算最优轨迹的潜力。},
  file = {/home/ouyangjiahong/Zotero/storage/KNW9IJFD/Johnston 等 - 2020 - Fuel-Efficient Powered Descent Guidance on Large Planetary Bodies via Theory of Functional Connectio.pdf}
}


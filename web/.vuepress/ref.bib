  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2024.08.004},
  abstract = {The construction of Gateway in lunar orbit is planned as a post-ISS mission by NASA, and JAXA is considering a cargo supply mission to provide service. The Near-Rectilinear Halo Orbit (NRHO) is a candidate for a Gateway orbit, and several methods for the transfer trajectory are being researched. The In-Direct Transfer (IDT) has a short transition period of seven days, but the {$\Delta$}V application is inefficient. The Weak Stability Boundary (WSB) transfer maintains a small {$\Delta$}V, but the transition takes over 100 days. However, a trajectory intermediate between IDT and WSB has not yet been actively studied. This paper proposes the Extended Perilune Rendezvous Method (EPRM) of intermediate transfer to NRHO. This method reduces {$\Delta$}V by orbiting in an elliptical lunar orbit for over two weeks. EPRM has several transition methods corresponding to {$\Delta$}V and transition periods. This paper systematically reveals the transition mechanisms. Moreover, an effective TCM, considering several error types, is presented for an actual mission. Finally, the rendezvous accuracy with Gateway is discussed.},
  langid = {english},
  keywords = {Gateway,HTV-X,NRHO,Orion,Perilune rendezvous method,WSB},
  annotation = {titleTranslation: 扩展近月点交会方法：用于货物运输任务至门户空间站的NRHO低变轨燃料转移。\\
abstractTranslation: 美国国家航空航天局（NASA）计划在月球轨道上建造``门户''（Gateway）作为国际空间站（ISS）后的任务，日本宇宙航空研究开发机构（JAXA）正考虑提供货运补给服务为其支持。近直线晕轨道（NRHO）被选为``门户''的候选轨道，多条转移轨迹方案正在研究中。间接转移（IDT）的过渡期仅需七天，但Delta V（{$\Delta$}V）应用效率较低；弱稳定性边界（WSB）转移的{$\Delta$}V较小，但过渡期超过100天。然而，介于IDT与WSB之间的中间轨迹尚未得到充分研究。本文提出了一种称为``扩展近月点交会方法''（EPRM）的中间转移方案，用于进入NRHO。该方法通过在椭圆月球轨道上运行两周以上以降低{$\Delta$}V。EPRM包含多种对应不同{$\Delta$}V与过渡期的转移方式，本文系统揭示了其转移机理。此外，针对实际任务，本文提出了一种考虑多种误差类型的高效轨道修正机动（TCM）方法，并最终讨论了与``门户''的交会精度。}
}


@article{MissionPlanningMethod,
  title = {A Mission Planning Method for Deep Space Detectors Using Deep Reinforcement Learning},
  author = {Qi, Yuheng and Gu, Defeng and Liu, Yuan and Zhu, Jubo and Wang, Jian and Liu, Daoping},
  year = 2024,
  month = oct,
  journal = {Aerospace Science and Technology},
  volume = {153},
  pages = {109417},
  issn = {1270-9638},
  doi = {10.1016/j.ast.2024.109417},
  urldate = {2026-04-27},
  abstract = {Mission planning for deep space detectors is a pivotal step in the successful execution of detection missions. Traditional planning approaches, which typically compartmentalize mission planning and data transmission scheduling, exhibit limitations in adapting to uncertainties and are often inadequate in responding to unforeseen opportunity targets. This paper introduces a mission planning method for deep space detectors designed to address these challenges. Firstly, a Markov Decision Process (MDP) model is formulated, integrating mission planning and data transmission scheduling, with a consideration for planning balance between detection missions and opportunity targets. Subsequently, a Planning Balance with Proximal Policy Optimization (PB-PPO) algorithm is proposed. The proposed algorithm, based in the Proximal Policy Optimization (PPO) algorithm, integrates an orthogonal initialization algorithm to afford improved control over parameter updates. Furthermore, a dynamic learning rate strategy is implemented to accelerate convergence speed. Experimental results show that, the PB-PPO achieves rewards that are 4.42\%, 6.78\%, 18.32\%, and 26.81\% higher than those obtained by compared algorithms. Additionally, the PB-PPO demonstrates the capability to address the planning balance between detection missions and opportunity targets, ensuring stable reward growth even when planning a significant number of opportunity targets. In summary, the PB-PPO integrates of MDP, deep reinforcement learning, and innovative strategies to make it a robust solution for detector mission planning in the complex and dynamic environment of deep space.},
  langid = {english},
  annotation = {titleTranslation: 基于深度强化学习的深空探测器任务规划方法\\
abstractTranslation: 深空探测器任务规划是成功执行探测任务的关键步骤。传统规划方法通常将任务规划与数据传输调度分开处理，在适应不确定性方面存在局限，且往往难以应对突发的机遇目标。本文提出了一种面向深空探测器的任务规划方法以解决上述挑战。首先，构建了马尔可夫决策过程（MDP）模型，将任务规划与数据传输调度相融合，并兼顾了探测任务与机遇目标之间的规划平衡。随后，提出了一种基于近端策略优化（PPO）的规划平衡算法（PB-PPO）。该算法以PPO为基础，引入正交初始化算法以更好地控制参数更新，同时采用动态学习率策略以加快收敛速度。实验结果表明，PB-PPO获得的奖励分别比对比算法高出4.42\%、6.78\%、18.32\%和26.81\%。此外，PB-PPO能够有效处理探测任务与机遇目标之间的规划平衡，即使在规划大量机遇目标时也能确保奖励稳定增长。总之，PB-PPO融合了MDP、深度强化学习以及创新策略，使其成为复杂动态深空环境中探测器任务规划的稳健解决方案},
  file = {/home/ouyangjiahong/Zotero/storage/XZN6NS2C/S1270963824005480.html}
}


@article{elshabouryPlanarRestrictedThreebody2016,
  title = {The Planar Restricted Three-Body Problem When Both Primaries Are Triaxial Rigid Bodies: Equilibrium Points and Periodic Orbits},
  shorttitle = {The Planar Restricted Three-Body Problem When Both Primaries Are Triaxial Rigid Bodies},
  author = {Elshaboury, S. M. and Abouelmagd, Elbaz I. and Kalantonis, V. S. and Perdios, E. A.},
  year = 2016,
  month = sep,
  journal = {Astrophysics and Space Science},
  volume = {361},
  number = {9},
  pages = {315--333},
  issn = {0004-640X, 1572-946X},
  doi = {10.1007/s10509-016-2894-x},
  urldate = {2025-11-27},
  abstract = {The restricted three-body problem when the primaries are triaxial rigid bodies is considered and its basic dynamical features are studied. In particular, the equilibrium points are identified as well as their stability is determined in the special case when the Euler angles of rotational motion are accordingly \texttheta i = {$\psi$}i = {$\pi$}/2 and {$\phi$}i = {$\pi$}/2, i = 1, 2. It is found that three unstable collinear equilibrium points exist and two triangular such points which may be stable. Special attention has also been paid to the study of simple symmetric periodic orbits and 31 families consisting of such orbits have been determined. It has been found that only one of these families consists entirely of unstable members while the remaining families contain stable parts indicating that other families bifurcate from them. Finally, using the grid-search technique a global solution in the space of initial conditions is obtained which comprises simple and of higher multiplicities symmetric periodic orbits as well as escape and collision orbits.},
  langid = {english},
  annotation = {titleTranslation: 双主天体均为三轴刚体时的平面限制性三体问题：平衡点与周期轨道\\
abstractTranslation: 考虑主星为三轴刚体的限制性三体问题，并研究其基本动力学特征。特别地，确定了平衡点，并在欧拉旋转角分别为\texttheta\_i = {$\psi\_$}i = {$\pi$}/2和{$\varphi\_$}i = {$\pi$}/2 (i=1,2)的特殊情况下判定了其稳定性。发现存在三个不稳定的共线平衡点和两个可能稳定的三角平衡点。还特别关注了简单对称周期轨道的研究，并确定了由这类轨道构成的31个族系。发现其中仅有一个族系完全由不稳定成员组成，其余族系包含稳定部分，表明其他族系从它们分岔而来。最后，利用网格搜索技术获得了初始条件空间中的全局解，该解包括简单及更高重数的对称周期轨道，以及逃逸轨道和碰撞轨道。},
  file = {/home/ouyangjiahong/Zotero/storage/FCFEH4XZ/Elshaboury 等 - 2016 - The planar restricted three-body problem when both primaries are triaxial rigid bodies equilibrium.pdf}
}


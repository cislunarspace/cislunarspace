@article{guzzettiAttitudeDynamicsCircular2018,
  title = {Attitude Dynamics in the Circular Restricted Three-Body Problem},
  author = {Guzzetti, Davide and Howell, Kathleen Connor},
  year = 2018,
  month = jun,
  journal = {Astrodynamics},
  volume = {2},
  number = {2},
  pages = {87--119},
  issn = {2522-008X, 2522-0098},
  doi = {10.1007/s42064-017-0012-7},
  urldate = {2025-11-27},
  abstract = {This document reflects the effort of constructing a basis for understanding attitude motion within a multi-body problem with application to spacecraft flight dynamics. The circular restricted three-body problem (CR3BP) is employed as a model for the orbital motion. Then, attitude dynamics is discussed within the CR3BP. Conditions for bounded attitude librations and techniques for the identification of such behavior are presented: initially for a spacecraft fixed at an orbital equilibrium point, and later for a vehicle that moves on non-linear periodic orbit. While previous works focus on specific challenges, this analysis serves to create a more general framework for attitude dynamics within the CR3BP. A larger framework enables additional observations. For example, a linkage is noted between regions of bounded motion that may appear on an attitude grid search map and families of periodic attitude solutions. Finally, coupling effects between attitude and orbit dynamics within the CR3BP, ones that enable new options for trajectory design, are considered an important opportunity, and should be included in a general framework. As a proof of that concept, sailcraft trajectories are generated within a coupled orbit--attitude model only using a sequence of constant commands for the attitude actuators.},
  langid = {english},
  annotation = {titleTranslation: 圆型限制性三体问题中的姿态动力学\\
abstractTranslation: 本文件旨在为多体问题中的姿态运动理解奠定基础，并将其应用于航天器飞行动力学。采用圆型限制性三体问题（CR3BP）作为轨道运动的模型，随后在CR3BP框架内讨论姿态动力学。文中介绍了有界姿态天平动的条件及其识别方法：首先针对固定于轨道平衡点的航天器，而后针对沿非线性周期轨道运行的飞行器。以往研究侧重于特定挑战，而本分析旨在为CR3BP中的姿态动力学构建一个更通用的框架。更广泛的框架有助于产生新的观察结果，例如，在姿态网格搜索图中可能出现的运动有界区域与周期姿态解族之间存在关联。最后，本文认为CR3BP中姿态与轨道动力学之间的耦合效应（能够为轨迹设计提供新选择）是一项重要机遇，应纳入通用框架。作为这一概念的验证，在耦合的轨道-姿态模型中，仅通过一系列恒定的姿态执行器指令生成了太阳帆航天器的轨迹},
  file = {/home/ouyangjiahong/Zotero/storage/YLIREAX8/Guzzetti和Howell - 2018 - Attitude dynamics in the circular restricted three-body problem.pdf}
}


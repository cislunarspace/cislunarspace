@article{LiMingMingKaoLuTongXinYueShuDeXingQunFenBuShiYingJiDiaoDuFangFaYanJiu2024,
  title = {{考虑通信约束的星群分布式应急调度方法研究}},
  author = {{李明铭} and {郭帅} and {杨迪} and {梁彦刚}},

@article{HuJinTaoKaoLuZhongDuanJiaoDuYueShuDeSanWeiZengLiangShiRaoDongBuChangZhiDaoLuSheJi2024,
  title = {{考虑终端角度约束的三维增量式扰动补偿制导律设计}},
  author = {{胡金涛} and {胡庆雷} and {韩拓}},
  year = 2024,
  journal = {宇航学报},
  volume = {45},
  number = {9},
  pages = {1456--1466},
  issn = {1000-1328},
  abstract = {针对具有特定终端碰撞角度需求的机动目标拦截问题，提出一种扰动补偿的增量式终端角度约束三维制导律设计方法。首先，基于非线性三维耦合相对运动学模型及视线转率动态方程，结合惯性延迟估计方法，设计目标机动过载与外界干扰等扰动在线补偿的三维终端角度约束制导律。其次，为了进一步提升制导律抗干扰特性，基于视线角误差方程泰勒展开的增量式动态逆方法，将误差动态系统扰动与制导指令压缩至一个采样步长内的增量形式，提出一种新近测量信息驱动的三维增量式扰动补偿角度约束制导律。理论分析表明，角度约束与扰动估计偏差能够收敛至一个有界的较小邻域内。复杂工况下多场景、多方法仿真对比及蒙特卡罗打靶仿真结果表明，所设计方法具有较强的适应性和鲁棒性。},
  langid = {chinese},
  annotation = {CNKICite: 2},
  file = {/home/ouyangjiahong/Zotero/storage/DTNKE96R/胡金涛 等 - 2024 - 考虑终端角度约束的三维增量式扰动补偿制导律设计.pdf}

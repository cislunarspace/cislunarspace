@article{wangSimulationInflightBackground2024,
  title = {Simulation of the In-Flight Background and Performance of {{DRO}}/{{GTM}}},
  author = {Wang, Chenwei and Zhang, Juan and Zheng, Shijie and Xiong, Shaolin and An, Zhenghua and Peng, Wenxi and Zhao, Haisheng and Zhao, Xiaoyun and Zheng, Chao and Feng, Peiyi and Gong, Ke and Guo, Dongya and Li, Xinqiao and Liu, Jiacong and Liu, Yaqing and Tan, Wenjun and Wang, Yue and Xue, Wangchen and Yang, Sheng and Zhang, Dali and Zhang, Fan Zhang Yanqiu},
  year = 2024,
  journal = {Experimental Astronomy},
  volume = {Vol.57},
  number = {No.3},
  pages = {1--24},
  doi = {10.1007/s10686-024-09946-8},
  abstract = {As a new member of the high energy astronomical transient monitoring network, Gamma-ray Transient Monitor (GTM) is an all-sky monitor onboard the Distant Retrograde Orbit (DRO) mission which has been launched in March 2024. In this work, we investigate the space radiation environment of DRO, and study the in-flight background of GTM using GEANT4. The background count rate on each of the 5 GTP detectors of GTM is estimated to be about 800\textbackslash (\textbackslash sim \textbackslash )1000 counts/s in the energy range from 20 keV to 1 MeV after one-year operation on orbit. We find that there are two distinct spectral lines clearly visible in the background spectrum, i.e. the 59 keV emission line from the embedded calibration source \textbackslash (\textasciicircum 241\textbackslash )Am and the 511 keV emission line induced by space radiations, which are suitable for the in-flight energy gain calibration. These results provide important reference for the development of payload, design of observation strategies, in-flight calibration of instrument and research of scientific objectives.},
  langid = {english},
  keywords = {Background,DRO/GTM,Geant4,Space environment},
  annotation = {titleTranslation: DRO/GTM在轨背景与性能仿真\\
abstractTranslation: 作为高能天文暂现源监测网络的新成员，伽马射线暂现监测器（GTM）是搭载于2024年3月发射的远距逆行轨道（DRO）任务上的全天监测器。本文研究了DRO的空间辐射环境，并利用GEANT4模拟了GTM的在轨本底。在轨运行一年后，GTM的5个GTP探测器在20 keV至1 MeV能段的本底计数率估计约为800\textasciitilde 1000计数/秒。我们发现本底谱中清晰可见两条特征谱线，即嵌入式校准源{$^{241}$}Am产生的59 keV发射线与空间辐射诱导的511 keV发射线，适用于在轨能量增益校准。这些结果为载荷研制、观测策略设计、仪器在轨定标及科学目标研究提供了重要参考}
}


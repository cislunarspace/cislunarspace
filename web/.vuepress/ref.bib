@article{jamilniaSimultaneousOptimizationStaging2012,
  title = {Simultaneous Optimization of Staging and Trajectory of Launch Vehicles Using Two Different Approaches},
  author = {Jamilnia, Reza and Naghash, Abolghasem},
  year = 2012,
  month = dec,
  journal = {Aerospace Science and Technology},
  series = {35th {{ERF}}: {{Progress}} in {{Rotorcraft Research}}},
  volume = {23},
  number = {1},
  pages = {85--92},
  issn = {1270-9638},
  doi = {10.1016/j.ast.2011.06.013},
  urldate = {2026-01-27},
  abstract = {In this paper, two different approaches are proposed for simultaneous optimization of staging and trajectory of multistage launch vehicles. In the first approach, the problems of staging optimization and trajectory optimization are solved separately. These problems are linked together by an overhead problem to find the overall optimal solution. In the second approach, the optimal staging and trajectory are achieved during trajectory optimization in an integrated problem. In the first approach, staging is optimized based on ideal velocity and classic formulation of staging, and in the second approach, staging is optimized based on actual velocity and details of trajectory optimization problem. In both approaches, direct collocation method and nonlinear programming techniques are used for solving optimization problems. A numerical example is presented and solved to demonstrate and compare the capabilities of proposed approaches. Both approaches can lead to very similar solutions in spite of their differences in staging formulation. Integrated approach can lead to better results because of simultaneous consideration of objective functions and effective constraints of two optimization problems of staging and trajectory.},
  langid = {english},
  keywords = {Direct collocation method,Launch vehicles,Nonlinear programming,Staging optimization,Trajectory optimization},
  annotation = {titleTranslation: 采用两种不同方法对运载火箭级间分离与弹道轨迹进行同步优化\\
abstractTranslation: 本文提出了两种不同的方法，用于多级运载火箭的级间优化与弹道同步优化。第一种方法分别独立求解级间优化与弹道优化问题，并通过一个上层问题将两者关联，以寻求全局最优解。第二种方法则在弹道优化过程中以集成问题的方式实现最优级间与弹道设计。第一种方法基于理想速度及经典级间公式进行级间优化；第二种方法则基于实际速度及弹道优化问题的详细建模进行级间优化。两种方法均采用直接配点法及非线性规划技术求解优化问题。文中给出并求解了一个数值算例，以展示和比较所提方法的能力。尽管两种方法在级间建模上存在差异，但均能得到极为相近的解。由于能同时考虑级间优化与弹道优化两个问题的目标函数及有效约束，集成方法可获得更优的结果。},
  file = {/home/ouyangjiahong/Zotero/storage/2ZJ9N9AW/Jamilnia和Naghash - 2012 - Simultaneous optimization of staging and trajectory of launch vehicles using two different approache.pdf;/home/ouyangjiahong/Zotero/storage/DXCJ8LHN/S1270963811001064.html}
}


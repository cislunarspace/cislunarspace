@article{FengLiChengCollisionfreeTrajectoryPlanning2016,
  title = {Collision-Free Trajectory Planning for Spacecraft Close-Range Proximity via Potential Sigmoid Function},
  author = {{冯丽程} and {白玉铸} and {陈小前}},
  year = 2016,
  journal = {Journal of Beijing Institute of Technology},
  number = {第A2期},
  pages = {5--9},
  abstract = {In the process of spacecraft close-range proximity,it is important to guarantee a collision-free trajectory.In this paper,we propose a control strategy based on generalized sigmoid functions to deal with obstacles with arbitrary shapes.Different from traditional artificial potential function,the adopted generalized sigmoid function could provide accurate representations of objects of arbitrary shapes by implicit primitives or from sampled surface data,overcoming the major limitation of previous artificial potential function.Additionally,the surfaces of both the chaser spacecraft and the obstacle are transferred into the form of ellipsoidal envelope rather than spherical form.Validation results show that the proposed control strategy can effectively allow the chaser to avoid penetrations of obstacles whilst successfully approaching the desired state.},
  langid = {english},
  keywords = {collision-free;generalized sigmoid function;ellipsoidal envelope},
  annotation = {titleTranslation: 基于势能Sigmoid函数的航天器近距离无碰撞轨迹规划\\
abstractTranslation: 在航天器近距离接近过程中，确保无碰撞轨迹至关重要。本文提出一种基于广义Sigmoid函数的控制策略，用于处理任意形状的障碍物。与传统人工势函数不同，所采用的广义Sigmoid函数能够通过隐式基元或采样表面数据精确表示任意形状的物体，克服了以往人工势函数的主要局限性。此外，追踪航天器与障碍物的表面均被转换为椭球包络形式而非球形包络。验证结果表明，该控制策略可有效使追踪航天器在成功接近目标状态的同时避免穿透障碍物}
}


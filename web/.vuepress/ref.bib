  urldate = {2025-11-27},
  abstract = {A new approach for spacecraft absolute attitude estimation based on the unscented Kalman filter (UKF) is extended to relative attitude estimation and navigation. This approach for nonlinear systems has faster convergence than the approach based on the standard extended Kalman filter (EKF) even with inaccurate initial conditions in attitude estimation and navigation problems. The filter formulation employs measurements obtained from a vision sensor to provide multiple line(-) of(-) sight vectors from the spacecraft to another spacecraft. The line-of-sight measurements are coupled with gyro measurements and dynamic models in an UKF to determine relative attitude, position and gyro biases. A vector of generalized Rodrigues parameters is used to represent the local error-quaternion between two spacecraft. A multiplicative quaternion-error approach is derived from the local error-quaternion, which guarantees the maintenance of quaternion unit constraint in the filter. The scenario for bounded relative motion is selected to verify this extended application of the UKF. Simulation results show that the UKF is more robust than the EKF under realistic initial attitude and navigation error conditions.},
  langid = {english},
  annotation = {titleTranslation: 使用无迹卡尔曼滤波器进行基于视觉的相对状态估计},
  file = {/home/ouyangjiahong/Zotero/storage/MMAA9KNZ/Lee和Pernicka - 2011 - Vision-based relative state estimation using the unscented kalman filter.pdf}
}


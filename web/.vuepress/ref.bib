  number = {10},
  pages = {5--25},
  urldate = {2026-04-05},
  abstract = {奥巴马政府以来，美国在国家安全问题上采取了一种收缩战略，试图在欧洲和中东地区收缩力量，将战略重心置于亚太地区。然而，这种主观的战略设计使得美国全球战略失衡，导致了乌克兰危机和加沙冲突接连爆发，美国不得不将部分战略资源和外交精力回撤欧洲和中东。由此，美国国家安全战略客观上出现了全球再平衡，它体现了大国权力要素流动和战略资源调配的均势机理，显露出美国秉持相对收益思维的战略后果。由于战略资源和外交精力有限，美国将难以平衡欧洲、中东和``印太''三个地区。当前，乌克兰危机和加沙冲突面临升级风险，美国国家安全战略正处于十字路口，其重心转向亚太的历史顶峰可能已经过去。},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/8L7CQ9YR/左希迎 - 2024 - 美国国家安全战略的全球再平衡.pdf}
}

@article{scottDualSatelliteaidedPlanetary2017,
  title = {Dual Satellite-Aided Planetary Capture with Interplanetary Trajectory Constraints},
  author = {Scott, Christopher J. and Ozimek, Martin T. and Haapala, Amanda F. and Siddique, Fazle E. and Buffington, Brent B.},

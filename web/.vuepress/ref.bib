@article{abduallahOperationalPredictionSolar2023,
  title = {Operational Prediction of Solar Flares Using a Transformer-Based Framework},
  author = {Abduallah, Yasser and Wang, Jason T. L. and Wang, Haimin and Xu, Yan},
  year = 2023,
  month = aug,
  journal = {Scientific Reports},
  volume = {13},
  number = {1},
  pages = {13665},
  issn = {2045-2322},
  doi = {10.1038/s41598-023-40884-1},
  urldate = {2026-05-11},
  abstract = {Abstract                            Solar flares are explosions on the Sun. They happen when energy stored in magnetic fields around solar active regions (ARs) is suddenly released. Solar flares and accompanied coronal mass ejections are sources of space weather, which negatively affects a variety of technologies at or near Earth, ranging from blocking high-frequency radio waves used for radio communication to degrading power grid operations. Monitoring and providing early and accurate prediction of solar flares is therefore crucial for preparedness and disaster risk management. In this article, we present a transformer-based framework, named SolarFlareNet, for predicting whether an AR would produce a                                                   \$\$\textbackslash gamma\$\$                                        {$\gamma$}                                                                  -class flare within the next 24 to 72 h. We consider three                                                   \$\$\textbackslash gamma\$\$                                        {$\gamma$}                                                                  classes, namely the                                                   \$\$\textbackslash ge\$\$                                        {$\geq$}                                                                  M5.0 class, the                                                   \$\$\textbackslash ge\$\$                                        {$\geq$}                                                                  M class and the                                                   \$\$\textbackslash ge\$\$                                        {$\geq$}                                                                  C class, and build three transformers separately, each corresponding to a                                                   \$\$\textbackslash gamma\$\$                                        {$\gamma$}                                                                  class. Each transformer is used to make predictions of its corresponding                                                   \$\$\textbackslash gamma\$\$                                        {$\gamma$}                                                                  -class flares. The crux of our approach is to model data samples in an AR as time series and to use transformers to capture the temporal dynamics of the data samples. Each data sample consists of magnetic parameters taken from Space-weather HMI Active Region Patches (SHARP) and related data products. We survey flare events that occurred from May 2010 to December 2022 using the Geostationary Operational Environmental Satellite X-ray flare catalogs provided by the National Centers for Environmental Information (NCEI), and build a database of flares with identified ARs in the NCEI flare catalogs. This flare database is used to construct labels of the data samples suitable for machine learning. We further extend the deterministic approach to a calibration-based probabilistic forecasting method. The SolarFlareNet system is fully operational and is capable of making near real-time predictions of solar flares on the Web.},
  langid = {english},
  annotation = {titleTranslation: 基于Transformer框架的太阳耀斑业务预测\\
abstractTranslation: 摘要  \\
太阳耀斑是太阳上的爆炸现象，当太阳活动区（AR）周围磁场中储存的能量突然释放时，便会发生耀斑。太阳耀斑及其伴随的日冕物质抛射是空间天气的源头，会对地球附近或表面的多种技术产生负面影响，从干扰用于无线电通信的高频无线电波，到破坏电网运行。因此，监测并提前准确预测太阳耀斑对于备灾和灾害风险管理至关重要。本文提出一个基于Transformer的框架，名为SolarFlareNet，用于预测某个活动区在未来24至72小时内是否会产生{$\gamma$}级耀斑。我们考虑三个{$\gamma$}级别，即{$\geq$}M5.0级、{$\geq$}M级和{$\geq$}C级，并分别构建三个Transformer，每个对应一个{$\gamma$}级别。每个Transformer用于预测其对应{$\gamma$}级别的耀斑。我们方法的核心是将活动区中的数据样本建模为时间序列，并利用Transformer捕捉数据样本的时间动态。每个数据样本包含来自空间天气HMI活动区补丁（SHARP）及相关数据产品的磁参数。我们利用国家环境信息中心（NCEI）提供的地球静止业务环境卫星X射线耀斑目录，调查2010年5月至2022年12月间发生的耀斑事件，并构建了一个包含NCEI耀斑目录中已识别活动区的耀斑数据库。该耀斑数据库用于构建适合机器学习的数据样本标签。我们进一步将确定性方法扩展到基于校准的概率预测方法。SolarFlareNet系统已完全投入使用，能够在网络上进行近实时太阳耀斑预测。},
  file = {/home/ouyangjiahong/Zotero/storage/LVMGTUD4/Abduallah 等 - 2023 - Operational prediction of solar flares using a transformer-based framework.pdf}
}


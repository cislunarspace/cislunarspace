@article{lebowitzStatisticalMechanicsProbabilistic1990,
  title = {Statistical Mechanics of Probabilistic Cellular Automata},
  author = {Lebowitz, Joel L. and Maes, Christian and Speer, Eugene R.},
  year = 1990,

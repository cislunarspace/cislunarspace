major: 控制科学与工程}
}

@inproceedings{lozanoortegaRobustOptimalControl2024,
  title = {Robust Optimal Control for Lunar Missions Using Autonomous Navigation},
  booktitle = {{{AIAA SCITECH}} 2024 {{Forum}}},
  author = {Lozano Ortega, R. and Sanchez Cuartielles, J. P. and Machuca, P.},
  year = 2024,
  address = {Orlando, FL, USA},
  doi = {10.2514/6.2024-0621},
  abstract = {This paper tackles the challenge of robust transfers to the Moon. Robust optimal control is formulated to plan orbital manoeuvres to compensate for the real-world inherent errors of spaceflight. Manoeuvre execution error is accounted for, together with a combination of GNSS and optical technology for navigation accuracy modelling. An impulsive closed-loop control law is optimised for trajectory correction manoeuvre computation, whereas unscented transform is used for uncertainty propagation. The goal is to demonstrate the adaptability of this method to transfers in the Earth-Moon system. To test the robustness of the proposed strategy and its utility for flexible manoeuvre planning, two scenarios are considered: a transfer to a near-rectilinear halo orbit (NRHO) and a transfer to a low lunar polar orbit (LLPO). It is found that in the worst case, less than 7\% of the Delta budget is employed for correction manoeuvres, and a 1 - dispersion in each axis of the order of 100 km is obtained for both cases.},
  langid = {english},
  annotation = {titleTranslation: 基于自主导航的月球任务鲁棒最优控制}
}

@article{luDesignAnalysisDirect2021,
  title = {Design and Analysis of a Direct Transfer Trajectory from a near Rectilinear Halo Orbit to a Low Lunar Orbit},
  author = {Lu, Lin and Li, Haiyang and Zhou, Wanmeng and Liu, Jianghui},
  year = 2021,
  month = feb,
  journal = {Advances in Space Research},
  volume = {67},
  number = {3},
  pages = {1143--1154},
  issn = {02731177},
  doi = {10.1016/j.asr.2020.11.003},
  urldate = {2025-10-01},
  abstract = {A near rectilinear halo orbit (NRHO) is regarded as a potential orbit for a future deep space station that can effectively support sustainable crewed lunar exploration missions. In this paper, the L2 southern NRHOs are selected as the research object, and a direct transfer trajectory from an NRHO to a low lunar orbit (LLO) is designed and analyzed. First, based on the circular restricted three-body problem, the characteristics of NRHOs are discussed including geometric behaviour, stability and synodic resonance. Second, optimal direct transfer trajectories are obtained by combining a local gradient optimization with a numerical continuation strategy. A reachable domain calculation model is established. Finally, simulations are carried out to verify the feasibility of the trajectory design method. The relationship between the velocity change and the reachable domain is further analysed through simulation calculations.},
  langid = {english},
  keywords = {Circular restricted three-body problem,Near rectilinear halo orbit,Optimal direct transfer trajectory,Reachable domain calculation},
  annotation = {abstractTranslation: 近直线的Halo轨道( Near直线的Halo Orbit，NRHO )被认为是未来深空探测的潜在轨道，可以有效地支持可持续的载人月球探测任务。本文选取L2南段近月轨道为研究对象，设计并分析了一条近月轨道向低月轨道( LLO )的直接转移轨道。首先，基于圆形限制性三体问题，讨论了NRHOs的几何行为、稳定性和会聚共振等特性。其次，通过结合局部梯度优化和数值延拓策略得到最优的直接转移轨迹。建立了可达域计算模型。 最后，通过仿真验证了轨迹设计方法的可行性。通过仿真计算，进一步分析了速度变化与可达域的关系。\\
titleTranslation: 近直线晕轨道至低月球轨道的直接转移轨道设计与分析},
  file = {/home/ouyangjiahong/Zotero/storage/6JV977UQ/Lu 等 - 2021 - Design and analysis of a direct transfer trajectory from a near rectilinear halo orbit to a low luna.pdf}
}


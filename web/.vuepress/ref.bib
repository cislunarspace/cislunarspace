@article{klueverOptimalLowthrustInterplanetary1997,
  title = {Optimal Low-Thrust Interplanetary Trajectories by Direct Method Techniques},
  author = {Kluever, Craig A.},
  year = 1997,
  month = sep,
  journal = {Journal of Astronautical Sciences},
  volume = {45},
  number = {3},
  pages = {247--262},
  issn = {2195-0571},
  doi = {10.1007/BF03546403},
  abstract = {A direct optimization method has been developed and utilized to compute a wide range of optimal low-thrust interplanetary trajectories. This method replaces the optimal control problem with a nonlinear programming problem which in turn is solved by using sequential quadratic programming. The direct approach is capable of modeling multiple powered and coast arcs, planetary gravity assists, and constant-thrust and variable-thrust electric propulsion systems. The advantages of the direct approach include reduction in the design space, ease of establishing good initial guesses for the design parameters, and improved flexibility for handling ``mixed'' optimal control problems with continuous control functions and discrete control parameters. Numerical results are presented for three interplanetary mission examples and the results from the direct method show an excellent match with published optimal trajectories. In addition, optimal trajectories are obtained for a new low-thrust interstellar transfer problem.},
  langid = {english},
  annotation = {titleTranslation: 基于直接法的星际最优低推力轨迹设计\\
abstractTranslation: 开发并采用了一种直接优化方法，用于计算多种最优低推力星际转移轨道。该方法将最优控制问题转化为非线性规划问题，进而通过序列二次规划进行求解。该直接方法能够对多个动力与滑行弧段、行星引力辅助，以及恒推力与变推力电推进系统进行建模。其优势包括：缩减设计空间、便于为设计参数建立良好的初始猜想，以及在处理包含连续控制函数与离散控制参数的``混合''最优控制问题时具备更强的灵活性。本文给出了三个星际任务示例的数值结果，直接方法所得结果与已发表的最优轨道高度吻合。此外，还针对一个新型低推力星际穿越转移问题获得了最优轨道。},
  file = {/home/ouyangjiahong/Zotero/storage/M8XCQ63V/Kluever - 1997 - Optimal low-thrust interplanetary trajectories by direct method techniques.pdf}
}


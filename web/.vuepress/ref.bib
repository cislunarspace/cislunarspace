@inproceedings{kimAutonomousSpacecraftProximity2025,
  title = {Autonomous Spacecraft Proximity Operations in the {{Earth-moon}} Cis-Lunar Space Using Time Shift Governors},
  booktitle = {{{AIAA Science}} and {{Technology Forum}} and {{Exposition}}, {{AIAA SciTech Forum}} 2025},
  author = {Kim, Taehyeun and Girard, Anouck and Kolmanovsky, Ilya},
  year = 2025,
  address = {Orlando, FL, United states},
  doi = {10.2514/6.2025-0311},
  abstract = {A Time Shift Governor (TSG)-based control approach is proposed to enforce multiple constraints, such as line of sight cone constraints, thrust limits, approach velocity limits, and stability constraints during spacecraft proximity operations in a near rectilinear halo orbit in the Earth-Moon system. The constraints are handled by an add-on scheme referred to as the TSG, which adjusts the time shift parameter of a reference trajectory being tracked by the Deputy spacecraft. The TSG generates a feasible reference trajectory for the Deputy spacecraft to approach the Chief spacecraft within a safety corridor, which directs the center of the Moon. Over time, the time shift is gradually reduced to zero, indicating that the virtual target converges to the Chief spacecraft. Numerical simulation results are presented to validate the proposed control approach.},
  langid = {english},
  annotation = {titleTranslation: 基于时移调控器的地月空间航天器自主近距离操作}
}


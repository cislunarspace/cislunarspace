  title = {Families of Orbits in the Vicinity of the Collinear Libration Points},
  author = {Howell, K. C.},
  year = 2001,
  month = mar,
  journal = {Journal of Astronautical Sciences},
  volume = {49},
  number = {1},
  pages = {107--125},
  issn = {2195-0571},
  doi = {10.1007/BF03546339},
  urldate = {2026-01-30},
  abstract = {In recent years, three-dimensional periodic and quasi-periodic orbits near the collinear libration points in the Sun-Earth/Moon three-body problem have been the focus of great interest for space mission design. Thus, more effort in the astrodynamics community has been directed toward analysis and computation of families of such orbits. But families of periodic orbits in the three-body problem have been the subject of much study for many decades. The first such orbit to be employed for a spacecraft trajectory (ISEE-3) was a member of a particular type of simply symmetric three-dimensional family, i.e., a halo orbit. Thus, attention shifted to further analysis of these periodic halo families. Some of the significant work in the development of periodic solutions in the three-body problem has been reviewed and a number of the highlights from the analysis and eventual numerical computation of halo families is presented here. The halo families of periodic orbits extend from each of the libration points to the nearest primary; they appear to exist for all values of the mass ratio. Thus, this further understanding may serve to support future spacecraft mission planning as well.},
  langid = {english},
  annotation = {titleTranslation: 共线平动点附近的轨道族\\
abstractTranslation: 近年来，日-地/月三体问题中共线平动点附近的三维周期与拟周期轨道已成为航天任务设计领域的研究热点。因此，动力学界投入更多精力对这些轨道族系进行分析与计算。然而，三体问题中的周期轨道族系已有数十年的研究历史。首个被应用于航天器轨迹（ISEE-3）的此类轨道，属于一种特殊类型的简单对称三维族系，即晕轨道。由此，研究重点转向对周期性晕族系的进一步分析。本文回顾了三体问题中周期解发展的部分重要工作，并介绍了晕族系分析及最终数值计算中的若干关键成果。晕族周期轨道从每个平动点延伸至最近的主天体，且似乎对所有质量比值均存在。因此，这些深入认识也有助于支持未来的航天任务规划。},
  file = {/home/ouyangjiahong/Zotero/storage/B8KRWMTN/Howell - 2001 - Families of orbits in the vicinity of the collinear libration points.pdf}
}

@article{howellNaturalPeriodicOrbitattitude2017,
  title = {Natural Periodic Orbit-Attitude Behaviors for Rigid Bodies in Three-Body Periodic Orbits},
  author = {Howell, Kathleen C. and Guzzetti, Davide},
  year = 2017,
  journal = {Acta Astronautica},
  volume = {Vol.130},
  number = {No.0},
  pages = {97--113},
  abstract = {Trajectory design increasingly leverages multi-body dynamical structures that are based on an understanding of various types of orbits in the Circular Restricted Three-Body Problem (CR3BP). Given the more complex dynamical environment, mission applications may also benefit from deeper insight into the attitude motion. In this investigation, the attitude dynamics are coupled with the trajectories in the CR3BP. In a highly sensitive dynamical model, such as the orbit-attitude CR3BP, periodic solutions allow delineation of the fundamental dynamical structures. Periodic solutions are also a subset of motions that are bounded over an infinite time-span (assuming no perturbing factors), without the necessity to integrate over an infinite time interval. Euler equations of motion and quaternion kinematics describe the rotational behavior of the spacecraft, whereas the translation of the center of mass is modeled in the CR3BP equations. A multiple shooting and continuation procedure is employed to target orbit-attitude periodic solutions in this model. Application of Floquet theory and Poincar\'e mappings to identify initial guesses for the targeting algorithm are described. In the Earth--Moon system, representative scenarios are explored for axisymmetric vehicles with various inertia characteristics, assuming that the vehicles move along L\textsubscript{1}/L\textsubscript{2} Lyapunov orbits as well as distant retrograde orbits. A rich structure of possible periodic behaviors appears to pervade the solution space in the coupled problem. The stability analysis of the attitude dynamics for the available families is included. Among the computed solutions, marginally stable and slowly diverging rotational behaviors exist and may offer interesting mission applications.},
  langid = {english},
  keywords = {Libration points,Multi-body systems,Periodic solutions,Spacecraft attitude,Three-body problem},
  annotation = {titleTranslation: 三体周期轨道中刚体的自然周期轨道-姿态行为\\
abstractTranslation: 轨迹设计日益利用基于对圆形限制性三体问题（CR3BP）中各类轨道理解的多体动力学结构。鉴于更为复杂的动力学环境，任务应用也可能受益于对姿态运动的更深入洞察。在本研究中，姿态动力学与CR3BP中的轨迹相耦合。在诸如轨道-姿态CR3BP这类高敏感性动力学模型中，周期解能够勾勒出基本动力学结构的轮廓。周期解也是在一段无限时间跨度内（假设无扰动因素）有界运动的一个子集，无需在无限时间区间上进行积分。欧拉运动方程和四元数运动学描述了航天器的旋转行为，而质心的平动则通过CR3BP方程进行建模。本文采用多重打靶与延拓方法，在该模型中搜索轨道-姿态周期解。介绍了应用Floquet理论和Poincar\'e映射来识别打靶算法初始猜测的过程。在地月系统中，针对具有不同惯性特性的轴对称航天器，探索了代表性场景，假设这些航天器沿L\textsubscript{1}/L\textsubscript{2} Lyapunov轨道以及远距逆行轨道运动。在耦合问题的解空间中，似乎普遍存在丰富的周期行为结构。同时包含了所得族系中姿态动力学的稳定性分析。在计算出的解中，存在临界稳定和缓慢发散旋转行为，可能为任务应用提供有趣的前景。}
}


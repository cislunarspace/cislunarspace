@article{petersonDynamicsEarthMoon2024,
  title = {Dynamics around the {{Earth}}--Moon Triangular Points in the Hill Restricted 4-Body Problem},
  author = {Peterson, Luke T. and Brown, Gavin and Jorba, {\`A}ngel and Scheeres, Daniel},
  year = 2024,
  month = aug,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {4},
  pages = {31--72},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10203-5},
  urldate = {2025-10-01},
  abstract = {This paper investigates the motion of a small particle moving near the triangular points of the Earth--Moon system. The dynamics are modeled in the Hill restricted 4-body problem (HR4BP), which includes the effect of the Earth and Moon as in the circular restricted 3body problem (CR3BP), as well as the direct and indirect effect of the Sun as a periodic time-dependent perturbation of the CR3BP. Due to the periodic perturbation, the triangular points of the CR3BP are no longer equilibrium solutions; rather, the triangular points are replaced by periodic orbits with the same period as the perturbation. Additionally, there is a 2:1 resonant periodic orbit that persists from the CR3BP into the HR4BP. In this work, we investigate the dynamics around these invariant objects by performing a center manifold reduction and computing families of 2-dimensional invariant tori and their linear normal behavior. We identify bifurcations and relationships between families. Mechanisms for transport between the Earth, L4, and the Moon are discussed. Comparisons are made between the results presented here and in the bicircular problem (BCP).},
  langid = {english},
  annotation = {titleTranslation: 希尔限制性四体问题中的地月三角点附近动力学\\
abstractTranslation: 本文研究了地月系统三角点附近小颗粒的运动。动力学模型采用Hill限制性四体问题（HR4BP），该模型既包含了圆形限制性三体问题（CR3BP）中地球与月球的影响，也包含了太阳作为CR3BP周期性时间依赖摄动的直接与间接效应。由于周期性摄动，CR3BP中的三角点不再是平衡解，而是被与摄动周期相同的周期轨道所取代。此外，存在一个从CR3BP延续至HR4BP的2:1共振周期轨道。本研究通过中心流形约化、计算二维不变环面族及其线性法向行为，探讨了这些不变对象周围的动力学特性。我们识别了分岔现象以及各族之间的关联关系。讨论了地球、L4点与月球之间的输运机制。将本文结果与双圆问题（BCP）中的结果进行了比较},
  file = {/home/ouyangjiahong/Zotero/storage/GXBGW5WH/Peterson 等 - 2024 - Dynamics around the Earth–moon triangular points in the hill restricted 4-body problem.pdf}
}

@article{petersonGaussEquationsLocal2024,
  title = {Gauss Equations for Local Action-Angle Orbital Elements in Cislunar Space},
  author = {Peterson, Luke T. and Scheeres, Daniel J.},
  year = 2024,
  month = nov,
  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {47},
  number = {11},
  pages = {2273--2286},
  issn = {0731-5090, 1533-3884},
  doi = {10.2514/1.G008399},
  urldate = {2025-11-06},
  abstract = {To track orbits in cislunar space, predict where they will naturally move over time, and identify where unbounded trajectories come from, one may consider local action-angle orbital elements---coordinates that relate a spacecraft state to specific trajectories and exist in approximately integrable regions of the Earth--moon circular restricted three-body problem (CR3BP). As local action-angle elements are a semi-analytical analog to two-body orbital elements, the theory is extended to allow for the study of arbitrary perturbations to the dynamics. Namely, we derive Gauss equations for an arbitrary perturbing acceleration---continuous or discrete---to the CR3BP. Examples for continuous thrust and impulsive [Formula: see text] are provided in cislunar space, i.e., around Earth--moon [Formula: see text] in the CR3BP. Strategies for instantaneous maneuver design and transfers between quasi-periodic orbits and manifolds are developed.},
  langid = {english},
  annotation = {titleTranslation: 高斯方程在近月空间局部作用角轨道要素中的应用\\
abstractTranslation: 为了追踪地月空间中的轨道，预测它们随时间的自然演化，并识别无界轨道的来源，可以考虑局部作用-角轨道根数------这些坐标将航天器状态与特定轨迹联系起来，存在于地球-月球圆型限制性三体问题（CR3BP）的近似可积区域中。由于局部作用-角根数是二体轨道根数的半解析类似物，该理论被扩展以允许研究任意动力学摄动。具体而言，我们推导了针对CR3BP中任意连续或离散摄动加速度的高斯方程。在地月空间（即CR3BP中的地月[公式]附近）提供了连续推力和脉冲[公式]的示例。同时，发展了瞬时机动设计以及准周期轨道与流形之间转移的策略。},
  file = {/home/ouyangjiahong/Zotero/storage/MWUL7G3F/Peterson和Scheeres - 2024 - Gauss equations for local action-angle orbital elements in cislunar space.pdf}
}

@article{petersonLocalOrbitalElements2023,
  title = {Local Orbital Elements for the Circular Restricted Three-Body Problem},
  author = {Peterson, Luke T. and Scheeres, Daniel J.},
  year = 2023,
  month = dec,
  journal = {Journal Of Guidance, Control, And Dynamics},
  volume = {46},
  number = {12},
  pages = {2275--2289},
  issn = {0731-5090, 1533-3884},
  doi = {10.2514/1.G007435},
  urldate = {2025-11-06},
  abstract = {The Keplerian orbital elements make up a set of parameters that uniquely describe a two-body trajectory. Once perturbations are imposed on two-body dynamics, one often studies the time evolution of the orbital elements. Moving in complexity beyond two-body perturbations [that is, studying the dynamics in the circular restricted three-body problem (CR3BP)], the Keplerian orbital elements are no longer well defined in certain regions of phase space, especially when the gravitational attractions of both the primary and secondary bodies have similar magnitudes, as occurs in the vicinity of the libration points. In this work, we define a generalization of orbit elements that can be applied in these regions and others. Specifically, we define a set of semi-analytical action-angle orbital elements that are defined locally about any bounded special solution in the CR3BP: equilibria, periodic orbits, and quasi-periodic orbits. Local action-angle orbital elements are defined using action-angle coordinates in the Birkhoff--Gustavson normal form about the bounded invariant manifold. We include detailed examples around the five equilibria [Formula: see text] in the Earth--Moon CR3BP.},
  langid = {english},
  annotation = {titleTranslation: 圆型限制性三体问题的局部轨道根数\\
abstractTranslation: 开普勒轨道元素是一组唯一描述二体轨迹的参数。当二体动力学受到摄动时，人们常研究轨道元素的时间演化。在复杂性上超越二体摄动（即研究圆型限制性三体问题（CR3BP）中的动力学）后，开普勒轨道元素在相空间的某些区域不再具有良好定义，尤其是在两个主天体引力大小相近的区域，例如平动点附近。本文定义了一种可在这些区域及其他区域应用的轨道元素推广形式。具体而言，我们定义了一组半解析的作用-角轨道元素，这些元素在CR3BP中任意有界特殊解（平衡点、周期轨道及拟周期轨道）附近局部定义。局部作用-角轨道元素通过围绕有界不变流形的Birkhoff--Gustavson标准型中的作用-角坐标来定义。我们以地球-月球CR3BP中五个平衡点[公式] 为例进行了详细说明。},
  file = {/home/ouyangjiahong/Zotero/storage/8LCFUFKQ/Peterson和Scheeres - 2023 - Local orbital elements for the circular restricted three-body problem.pdf}
}

@phdthesis{petersonUnifyingSemianalyticalNumerical2025,
  type = {博士论文},
  title = {Unifying Semi-Analytical and Numerical Methods for Astrodynamics Applications},
  author = {Peterson, Luke T.},
  year = 2025,
  journal = {ProQuest Dissertations and Theses},
  abstract = {Numerical methods are employed in the preliminary stages of spacecraft trajectory design, due to the accessibility of the underlying theory and relative ease of implementation. While having a more complex theoretical basis, semi-analytical methods can provide intuitive insights lost to mission designers who only consider present numerical procedures. These techniques are complementary yet have developed separately over the past few decades. Hence, their unified use requires new strategies. Taking as case studies the autonomous and non-autonomous models of cislunar space, we perform separately studies using semi-analytical and numerical methods. In particular, we develop and analyze local orbital elements, a local analog in the circular restricted 3-body problem to the classical orbital elements of the two-body problem. Additionally, we provide two in-depth investigations on regions of cislunar space in a higher-fidelity model of the Sun-Earth-Moon system. Throughout this thesis, we discuss connections between such methods, and we show explicitly the collaboration between semi-analytical and numerical techniques to compute particular quasi-periodic orbits in the Sun-Earth-Moon system. Overall, the presented work seeks to integrate semi-analytical methods into the standard numerical methodology for preliminary mission design.},
  isbn = {979-8-3157-0132-3},
  langid = {english},
  school = {University of Colorado},
  keywords = {0346:Mechanics,0538:Aerospace engineering,0606:Astronomy,Aerospace engineering,Astrodynamics,Astronomy,Celestial mechanics,Cislunar space,Hamiltonian dynamics,Mechanics,Restricted 3-body problem,Sun-Earth-Moon systems},
  annotation = {titleTranslation: 半解析与数值方法在航天动力学应用中的统一},
  file = {/home/ouyangjiahong/Zotero/storage/KGZVHA63/Peterson - 2025 - Unifying semi-analytical and numerical methods for astrodynamics applications.pdf}
}


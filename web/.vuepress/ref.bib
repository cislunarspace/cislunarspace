@article{gomezConnectingOrbitsInvariant2004,
  title = {Connecting Orbits and Invariant Manifolds in the Spatial Restricted Three-Body Problem},
  author = {G{\'o}mez, G and Koon, W S and Lo, M W and Marsden, J E and Masdemont, J and Ross, S D},
  year = 2004,

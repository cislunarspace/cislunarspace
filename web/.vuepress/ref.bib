@article{heOptimizationDesignCislunar2025,
  title = {Optimization Design of Cislunar Navigation Constellation with Orbital Period Resonance for On-Orbit Servicing},
  author = {He, Jiaxin and Li, Xiangyu and Wang, Sicheng and He, Jiang},
  year = 2025,
  journal = {Yuhang Xuebao/Journal of Astronautics},
  volume = {Vol.46},
  number = {No.8},
  pages = {1599--1611},
  issn = {1000-1328},
  abstract = {A hierarchical optimization framework integrating clustering and particle swarm algorithms is proposed to address challenges in cislunar navigation constellation design，including high-dimensional variables and extensive parameter spaces. The methodology leverages a periodic resonant orbit repository constructed from multiple families of three-body periodic orbits in cislunar space. Optimal constellation configurations are identified through a three-stage hierarchical clustering algorithm，prioritizing average dilution of precision（DOP）as the primary metric and coverage ratio as secondary. Final parameters are refined via satellite augmentation strategies and phase optimization. Targeting medium-Earth orbits （12 000～20 000 km）and high-Earth orbits（36 000 km radius），simulation results demonstrate that a 6-satellite constellation combining L2 north/south near-rectilinear Halo orbits（NRHOs）with L4/L5 planar orbits achieves optimal performance，characterized by a normalized baseline period of 1. 635 24，resonance ratio of 1{$:$}2{$:$}4{$:$}4，average DOP of 9. 282 2，and 100\% four-satellite coverage. This approach validates the feasibility of cislunar constellations for high-precision navigation in medium-high Earth orbits，offering a reference for future cislunar navigation system design.},
  langid = {english},
  keywords = {Air Navigation,Cislunar Navigation Constellation,Clustering Algorithms,Clustering Optimization,Clustering Optimizations,Dilution Of Precision,Hierarchical Clustering,Hierarchical Optimization,High Earth Orbits,Navigation Constellations,Navigation Systems,On-orbit Servicing,On-orbit-servicing,Optimization,Optimization Design,Orbital Periods,Orbits,Periodic Orbits,Satellites,Systems Analysis},
  annotation = {titleTranslation: 基于轨道周期共振的地月空间导航星座优化设计------面向在轨服务\\
abstractTranslation: 针对地月空间导航星座设计中存在的高维变量与庞大参数空间等挑战，提出了一种融合聚类与粒子群算法的分层优化框架。该方法利用由地月空间多族三体周期轨道构建的周期共振轨道库，通过三级分层聚类算法识别最优星座构型，将平均精度衰减因子（DOP）作为首要指标、覆盖率作为次要指标。最终参数通过卫星增补策略与相位优化进行精调。以中地球轨道（12000\textasciitilde 20000 km）和高地球轨道（半径36000 km）为目标，仿真结果表明：由L2北/南近直线晕轨道（NRHOs）与L4/L5平面轨道组成的6星星座可实现最优性能，其归一化基准周期为1.63524，共振比为1:2:4:4，平均DOP为9.2822，四星覆盖率达100\%。该方法验证了地月星座用于中高地球轨道高精度导航的可行性，可为未来地月导航系统设计提供参考。}
}

@article{hePropertiesLunarGravity2021,
  title = {Properties of the Lunar Gravity Assisted Transfers from {{LEO}} to the Retrograde-{{GEO}}},
  author = {He, Bo-yong and Ma, Peng-bin and Li, Heng-nian},
  year = 2021,
  month = sep,
  journal = {Scientific Reports},
  volume = {11},
  number = {1},
  pages = {18813},
  issn = {2045-2322},
  doi = {10.1038/s41598-021-98231-1},
  urldate = {2026-01-09},
  abstract = {Abstract                            The retrograde geostationary earth orbit (retro-GEO) is an Earth's orbit. It has almost the same orbital altitude with that of a GEO, but an inclination of 180{$^\circ$}. A retro-GEO monitor-satellite gives the GEO-assets vicinity space-debris warnings per 12~h. For various reasons, the westward launch direction is not compatible or economical. Thereby the transfer from a low earth orbit (LEO) to the retro-GEO via once lunar swing-by is a priority. The monitor-satellite departures from LEO and inserts into the retro-GEO both using only one tangential maneuver, in this paper, its transfer's property is investigated. The existence of this transfer is verified firstly in the planar circular restricted three-body problem (CR3BP) model based on the Poincar\'e-section methodology. Then, the two-impulse values and the perilune altitudes are computed with different transfer durations in the planar CR3BP. Their dispersions are compared with different Sun azimuths in the planar bi-circular restricted four-body problem (BR4BP) model. Besides, the transfer's inclination changeable capacity via lunar swing-by and the Sun-perturbed inclination changeable capacity are investigated. The results show that the two-impulse fuel-optimal transfer has the duration of 1.76 TU (i.e., 7.65~days) with the minimum values of 4.251~km~s               -1               in planar CR3BP, this value has a range of 4.249--4.252~km~s               -1               due to different Sun azimuths in planar BR4BP. Its perilune altitude changes from 552.6 to 621.9~km. In the spatial CR3BP, if the transfer duration is more than or equal to 4.00 TU (i.e., 17.59~days), the lunar gravity assisted transfer could insert the retro-GEO with any inclination. In the spatial BR4BP, the Sun's perturbation does not affect this conclusion in most cases.},
  langid = {english},
  annotation = {逆行地球静止轨道（retro-GEO）是一种地球轨道。其轨道高度与地球静止轨道（GEO）相近，但轨道倾角为180{$^\circ$}。逆行GEO监测卫星每12小时可为GEO资产提供邻近空间碎片预警。由于多方面原因，向西发射方向在兼容性或经济性上均不适宜。因此，通过单次月球借力实现从低地球轨道（LEO）至逆行GEO的转移成为优选方案。本文研究仅通过两次切向机动（分别实现从LEO出发与进入逆行GEO）的转移特性。首先基于庞加莱截面法在平面圆型限制性三体问题（CR3BP）模型中验证该转移轨道的存在性；随后计算平面CR3BP中不同转移时长对应的两次脉冲速度增量与近月点高度，并在平面双圆限制性四体问题（BR4BP）模型中比较不同太阳方位角下的参数分布。此外，探究了月球借力实现的轨道倾角改变能力及太阳摄动对倾角改变的影响。结果表明：在平面CR3BP中，两次脉冲燃料最优转移的时长为1.76时间单位（即7.65天），最小速度增量为4.251 km{$\cdot$}s{$^{-1}$}；在平面BR4BP中，因太阳方位角差异，该值波动范围为4.249--4.252 km{$\cdot$}s{$^{-1}$}，近月点高度变化区间为552.6--621.9 km。在空间CR3BP中，若转移时长大于等于4.00时间单位（即17.59天），月球引力辅助转移可实现任意倾角的逆行GEO入轨。在空间BR4BP中，太阳摄动在多数情况下不影响此结论。\\
titleTranslation: 月球借力转移轨道从低地球轨道至逆行地球静止轨道的特性\\
abstractTranslation: 摘要  \\
TLDR: The retrograde geostationary earth orbit (retro-GEO) is an Earth's orbit that has almost the same orbital altitude with that of a GEO, but an inclination of 180{$^\circ$}, and its transfer''s property is investigated, which shows that the two-impulse fuel-optimal transfer has the duration of 1.76 TU.},
  file = {/home/ouyangjiahong/Zotero/storage/X359CP9N/He 等 - 2021 - Properties of the lunar gravity assisted transfers from LEO to the retrograde-GEO.pdf}
}


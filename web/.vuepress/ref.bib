@article{tafanidisReinforcementLearningBased2025,
  title = {Reinforcement {{Learning Based Intelligent Control}} for {{Low-thrust Tight Station Keeping}} in {{Low Earth Orbit}}},
  author = {Tafanidis, Nektarios Aristeidis and Banerjee, Avijit and Satpute, Sumeet Gajanan and Nikolakopoulos, George},
  year = 2025,
  month = jul,
  journal = {International Journal of Control, Automation and Systems},
  volume = {23},
  number = {7},
  pages = {2105--2116},
  issn = {2005-4092},
  doi = {10.1007/s12555-024-0648-z},
  urldate = {2026-03-27},
  abstract = {Advancements in satellite technology have enabled the deployment of large constellations in low Earth orbit (LEO), presenting significant challenges in orbital management. Operating hundreds or even thousands of satellites imposes considerable computational and communication demands on ground control systems and operators. A primary operational challenge is maintaining satellites on their nominal trajectories in the presence of continuous perturbations, such as atmospheric drag and third-body gravitational forces. This article presents a reinforcement learning (RL)-based approach for decentralized satellite station keeping (SK). The proposed method utilizes a neural network policy---trained with the model-free soft actor-critic (SAC) algorithm in a high-fidelity, physics-based simulation environment---to compute corrective thrust vectors based on observed deviations from the satellite's nominal unperturbed trajectory. The resulting policy is computationally efficient and suitable for deployment onboard resource-constrained, space-grade systems. The performance of the RL-based controller is evaluated through Monte Carlo simulations and compared with that of a conventional linear model predictive controller (MPC), which is widely adopted due to its relatively low computational requirements. The comparison focuses on computational complexity, control performance, and robustness. Results demonstrate that the RL-based controller can achieve improved maneuver efficiency by directly learning the nonlinear relative dynamics, without incurring the computational cost typically associated with classical nonlinear optimization-based control methods. These findings underscore the potential of RL techniques for scalable and autonomous management of satellite constellations.},
  langid = {english},
  annotation = {titleTranslation: 基于强化学习的低推力低地球轨道紧密位置保持智能控制\\
abstractTranslation: 卫星技术的进步使得在低地球轨道部署大型星座成为可能，这给轨道管理带来了重大挑战。运行数百甚至数千颗卫星，对地面控制系统和操作人员提出了巨大的计算和通信需求。一个主要的运行挑战是在持续扰动（如大气阻力和第三体引力）下，将卫星维持在其标称轨迹上。本文提出了一种基于强化学习的分散式卫星站位保持方法。该方法利用神经网络策略------该策略在高保真物理仿真环境中通过无模型软演员-评论家算法进行训练------根据卫星偏离其标称无扰动轨迹的观测偏差，计算矫正推力矢量。所得策略计算效率高，适合部署在资源受限的宇航级系统上。通过蒙特卡洛仿真评估了基于强化学习的控制器的性能，并与因其计算需求相对较低而被广泛采用的常规线性模型预测控制器进行了比较。比较重点在于计算复杂度、控制性能和鲁棒性。结果表明，基于强化学习的控制器能够通过直接学习非线性相对动力学，在不产生经典非线性优化控制方法通常伴随的计算成本的情况下，实现更高的机动效率。这些发现凸显了强化学习技术在卫星星座可扩展自主管理方面的潜力},
  file = {/home/ouyangjiahong/Zotero/storage/MU3DIDCH/Tafanidis 等 - 2025 - Reinforcement Learning Based Intelligent Control for Low-thrust Tight Station Keeping in Low Earth O.pdf}
}


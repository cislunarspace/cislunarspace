@article{leeIntegratedSystemAutonomous2011,
  title = {Integrated System for Autonomous Proximity Operations and Docking},
  author = {Lee, Dae-Ro and Pernicka, Henry},
  year = 2011,
  month = mar,
  journal = {International Journal of Aeronautical and Space Sciences},
  volume = {12},
  number = {1},
  pages = {43--56},
  issn = {2093-274X},
  doi = {10.5139/IJASS.2011.12.1.43},
  urldate = {2025-11-27},
  abstract = {An integrated system composed of guidance, navigation and control (GNC) system for autonomous proximity operations and the docking of two spacecraft was developed. The position maneuvers were determined through the integration of the statedependent Riccati equation formulated from nonlinear relative motion dynamics and relative navigation using rendezvous laser vision (Lidar) and a vision sensor system. In the vision sensor system, a switch between sensors was made along the approach phase in order to provide continuously effective navigation. As an extension of the rendezvous laser vision system, an automated terminal guidance scheme based on the Clohessy-Wiltshire state transition matrix was used to formulate a ``V-bar hopping approach'' reference trajectory. A proximity operations strategy was then adapted from the approach strategy used with the automated transfer vehicle. The attitude maneuvers, determined from a linear quadratic Gaussian-type control including quaternion based attitude estimation using star trackers or a vision sensor system, provided precise attitude control and robustness under uncertainties in the moments of inertia and external disturbances. These functions were then integrated into an autonomous GNC system that can perform proximity operations and meet all conditions for successful docking. A sixdegree of freedom simulation was used to demonstrate the effectiveness of the integrated system.},
  langid = {english},
  annotation = {titleTranslation: 用于自主接近操作和对接的集成系统\\
abstractTranslation: 一套由制导、导航与控制（GNC）系统构成的集成化方案被开发出来，用于实现两航天器的自主交会接近操作与对接。位置机动通过结合基于非线性相对运动动力学建立的状态相关黎卡提方程与利用交会激光视觉（Lidar）及视觉传感器系统实现的相对导航来确定。在视觉传感器系统中，沿接近阶段对传感器进行切换，以提供持续有效的导航。作为交会激光视觉系统的扩展，基于Clohessy-Wiltshire状态转移矩阵的自动终端制导方案被用于构建``V-bar跳跃接近''参考轨迹。随后，借鉴自动转移飞行器所采用的接近策略，调整得到适用于接近操作的方案。姿态机动由包含基于星敏感器或视觉传感器系统的四元数姿态估计的线性二次高斯型控制确定，实现了精确的姿态控制，并在转动惯量不确定性与外部扰动下具备鲁棒性。上述功能最终集成为一套自主GNC系统，能够执行接近操作并满足成功对接的所有条件。六自由度仿真验证了该集成系统的有效性。},
  file = {/home/ouyangjiahong/Zotero/storage/BP39BBRI/Lee和Pernicka - 2011 - Integrated system for autonomous proximity operations and docking.pdf}
}

@article{leeKinematicallyCoupledRelative2015,
  title = {Kinematically Coupled Relative Spacecraft Motion Control Using the State-Dependent Riccati Equation Method},
  author = {Lee, Daero and Bang, Hyochoong and Butcher, Eric A. and Sanyal, Amit K.},
  year = 2015,
  month = jul,
  journal = {Journal of Aerospace Engineering},
  volume = {28},
  number = {4},
  pages = {04014099},
  issn = {0893-1321, 1943-5525},
  doi = {10.1061/(ASCE)AS.1943-5525.0000436},
  urldate = {2025-11-27},
  abstract = {This paper presents kinematically coupled relative spacecraft motion control in the close proximity of a tumbling target using the state-dependent Riccati equation method for proximity operation mission. In general, a rigid-body dynamics can be expressed as both translation and rotation about the center of mass. However, a kinematic coupling between the rotational and translational dynamics occurs when it is not expressed about the center of mass. Thus, kinematically coupled relative spacecraft motion model is derived to describe the relative motion about the selected arbitrary points on both the target and spacecraft. Then, spacecraft relative motion is represented by combining the relative translational and rotational dynamics of arbitrary points on the spacecraft. The spacecraft is required to achieve the desired position and attitude to track a tumbling spacecraft quickly in the effect of kinematic translation and rotation coupling. The state-dependent Riccati equation method is implemented to design a nonlinear controller in six degrees of freedom. Numerical simulation results validate kinematically coupled relative spacecraft motion control with respect to a tumbling target. DOI: 10.1061/(ASCE)AS.1943-5525.0000436. \copyright{} 2014 American Society of Civil Engineers.},
  langid = {english},
  annotation = {titleTranslation: 基于状态依赖Riccati方程方法的运动学耦合航天器相对运动控制\\
abstractTranslation: 本文提出了利用状态依赖Riccati方程方法在翻滚目标近距离范围内实现运动学耦合的相对航天器运动控制，以完成近距离操作任务。通常，刚体动力学可表达为质心的平动与转动。然而，当不以质心为参考点时，转动与平动动力学之间会产生运动学耦合。因此，推导了运动学耦合的相对航天器运动模型，用以描述目标与航天器上选定任意点之间的相对运动。随后，通过结合航天器上任意点的相对平动与转动动力学，表征了航天器的相对运动。在平动与转动运动学耦合的影响下，航天器需快速达到期望位置与姿态以跟踪翻滚目标。采用状态依赖Riccati方程方法设计了六自由度非线性控制器。数值仿真结果验证了针对翻滚目标的运动学耦合相对航天器运动控制的有效性。DOI: 10.1061/(ASCE)AS.1943-5525.0000436. \copyright{} 2014 American Society of Civil Engineers.},
  file = {/home/ouyangjiahong/Zotero/storage/XVWUDRES/Lee 等 - 2015 - Kinematically coupled relative spacecraft motion control using the state-dependent riccati equation.pdf}
}

@inproceedings{leeLowthrustMissionTrade2006,
  title = {Low-Thrust Mission Trade Studies with Parallel, Evolutionary Computing},
  booktitle = {Aerospace {{Conference}}, 2006 {{IEEE}}},
  author = {Lee, Seungwon and Russell, Ryan P. and Fink, Wolfgang and Terrile, Richard J. and Petropoulos, Anastassios E. and {von Allmen}, Paul and Electrical, The Institute Of and Electronics Engineers, {\relax Inc}.},
  year = 2006,
  series = {Aerospace {{Conference}}, 2006 {{IEEE}}},
  address = {Big Sky, Montana, USA},
  abstract = {New mission concepts are increasingly considering the use of ion propulsion for fuel-efficient navigation in deep space. The development of new low-thrust mission concepts requires efficient methods to rapidly determine feasibility and thoroughly explore trade spaces. This paper presents parallel, evolutionary computing methods to assess a trade-off between delivered payload mass and required flight time. The developed methods utilize a distributed computing environment in order to speed up computation, and use evolutionary algorithms to approximate optimal solutions. The methods are coupled with the Primer Vector theory, where a thrust control problem is transformed into a co-state control problem and the initial values of the co-state vector are optimized. The developed methods are applied to two mission scenarios: i) an orbit transfer around Earth and ii) a transfer between two distant retrograde orbits around Europa. The solutions found with the present methods are comparable to those obtained by other state-of-the-art trajectory optimizers. The required computational time can be up to several orders of magnitude shorter than that of other optimizers thanks to the utilization of the distributed computing environment, the significant reduction of the search space dimension with the Primer Vector theory, and the efficient and synergistic exploration of the remaining search space with evolutionary computing.},
  langid = {english},
  keywords = {aerospace computing,aerospace control,aerospace propulsion,costate control problem,costate vector optimization,deep space,distributed,evolutionary computation,ion engines,navigation,parallel processing,position control,Primer Vector theory,space research},
  annotation = {titleTranslation: 基于并行进化计算的低推力任务权衡研究}
}

@inproceedings{leeMultiobjectiveParallelGenetic2006,
  title = {Multi-Objective Parallel Genetic Algorithms Applied to the Primer Vector Control Law},
  booktitle = {Spaceflight {{Mechanics}} 2006},
  author = {Lee, Scungwon and Russell, R. P.},
  year = 2006,
  series = {Spaceflight {{Mechanics}} 2006},
  address = {Tampa, FL, USA},
  abstract = {A global, Pareto, and parallel optimization method for low-thrust orbit transfers is developed by applying a multi-objective parallel genetic algorithm to the primer vector control law. Complex trajectories are parameterized with the well-known primer vector control law using only the initial values of a co-state vector. The multi-objective parallel genetic algorithm searches for initial values that lead to mass- and time-optimal trajectories that satisfy a prescribed final target condition. The optimization method yields a set of Pareto-optimal solutions, which demonstrate the trade-oil between AV and flight time for a given low-thrust orbit transfer. The method is applied to three different multiple-revolution orbit transfer problems: 1) a two-body orbit transfer around the Earth, 2) a restricted three-body, coplanar distant retrograde orbit (DRO) transfer around Europa, and 3) a restricted three-body, non-coplanar DRO transfer around Europa. The resulting Pareto-optimal solutions are comparable to those from state-of-the-art optimization tools such as Mystic and GA-Q-Law.},
  langid = {english},
  annotation = {titleTranslation: 应用于初值向量控制律的多目标并行遗传算法}
}


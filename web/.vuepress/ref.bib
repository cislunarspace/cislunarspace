@article{ZhangHanQingYiZhongJiSuanYuanXingXianZhiXingSanTiWenTiZhouQiGuiDaoDeXinFangFa2011,
  title = {{一种计算圆形限制性三体问题周期轨道的新方法}},
  author = {{张汉清} and {李言俊} and {张科}},
  year = 2011,
  journal = {中国科学:技术科学},
  volume = {41},
  number = {8},
  pages = {1078--1083},
  issn = {1674-7259},
  abstract = {周期轨道是理解圆形限制性三体问题动力系统的关键,在深空探测实践中具有重要的应用价值,现有的周期轨道计算方法通常需要以高阶近似解析解作为迭代初值,计算过程复杂且能得到的周期轨道种类较少.本文利用圆形限制性三体问题的对称性,通过构造相空间内的一类流函数,将位于对称平面上的状态再次映射到该对称面上,得到了计算周期轨道的构造流函数方法,该方法不需要以近似解析解作为迭代初值,也不需要计算状态转移矩阵,从而便于编程实现,其优点是不受圆形限制性三体问题非线性的影响,并可以系统地计算一大类具有x-z平面对称性的周期轨道.作为算例,在平面情况下计算了Lyapunov轨道等周期轨道,并进一步将构造流函数方法与微分校正方法结合,设计了能在不同共振频率上跳转的共振引力加速轨道,最后,在三维空间情况下计算了晕轨道和多种三维周期轨道,证明了该方法的有效性.},
  langid = {chinese},
  annotation = {CNKICite: 8},
  file = {/home/ouyangjiahong/Zotero/storage/YGNTZ8ET/张汉清 等 - 2011 - 一种计算圆形限制性三体问题周期轨道的新方法.pdf}
}

@phdthesis{ZhangHaoChengJiYuSiYuanShuDeHangTianQiGuiDaoDongLiXueJianMoYuKongZhi2015,
  type = {{硕士学位论文}},
  title = {{基于四元数的航天器轨道动力学建模与控制}},
  author = {{张浩成}},
  year = 2015,
  month = jan,
  address = {哈尔滨},
  urldate = {2026-05-11},
  abstract = {复杂的空间任务对轨道表示，轨道预报和轨道控制等的要求越来越高。传统轨道参数在轨道表示，轨道外推等方面存在诸多不足。例如开普勒轨道要素在表示特定轨道会存在奇异性，其高斯摄动方程含有大量三角函数降低了轨道计算的效率等；笛卡尔坐标存在不能直观表征轨道几何参数的不足；轨道和姿态采用各自独立的描述方式，使用的数学工具不一样。本文针对传统轨道参数在描述航天器轨道中存在的不足，以航天器轨道动力学问题为研究背景，用单位四元数表示轨道面相对惯性系的角位置，辅以距离、径向速度和角动量等参数共同构成一组无奇异性且计算效率高的轨道参数。在此基础上研究了航天器轨道建模、轨道外推、轨道优化和轨道控制等问题，论文的主要内容如下： 	卫星轨道描述的是轨道坐标系相对于地心惯性系的相对运动关系，包括平移和旋转，利用轨道的旋转运动部分与刚体姿态的相似性，以四元数描述轨道面相对于惯性系的角位置，从而将四元数引入到轨道动力学中。从改进传统轨道参数不足的角度出发，分析了几组包含单位四元数在内的轨道参数。基于一组由单位四元数和径向距离、径向速度、角动量等矢量参数构成的四元数轨道要素推导了轨道动力学和运动学方程，给出了四元数轨道要素...},
  collaborator = {{张世杰}},
  langid = {chinese},
  school = {哈尔滨工业大学},
  annotation = {Major: 飞行器设计},
  file = {/home/ouyangjiahong/Zotero/storage/TPX5KHTB/张浩成 - 2015 - 基于四元数的航天器轨道动力学建模与控制.pdf}
}

@phdthesis{ZhangHaoMingJiYuDiYueTeShuGuiDaoDeTanHuoGuiDaoSheJi2025,
  type = {{硕士学位论文}},
  title = {{基于地月特殊轨道的探火轨道设计}},
  author = {{张浩铭}},
  year = 2025,
  address = {哈尔滨},
  doi = {10.27061/d.cnki.ghgdu.2025.000641},
  urldate = {2025-12-24},
  abstract = {火星探测是当前深空探测领域的热点之一,而地月空间特殊轨道因其长期稳定性和低能特性,成为未来深空探测任务的重要跳板。本文以火星探测任务为背景,研究了基于地月特殊轨道的探火轨道设计方法,重点探讨了平动点轨道和大幅值逆行轨道(Distant Retrograde Orbit,DRO)在火星转移任务中的应用。通过理论分析、数值计算和仿真验证,提出了多种低能转移方案,为未来地月空间站建立后的深空探测任务提供了重要的参考依据。首先,本文推导了圆形限制性三体模型下的动力学方程,并引入高精度星历模型。此后介绍了不同的修正算法对轨道进行优化设计,为后续轨道计算提供了理论支撑。针对地月空间内的特殊轨道,本文计算了地月系中的五个平动点位置及雅可比积分常数,求解出Halo轨道和李雅普诺夫轨道的解析解以及对应的不变流形,为后续的低能转移设计奠定了基础。针对DRO轨道,本文采用数值方法生成了不同振幅的轨道族,并对其稳定性参数进行了分析。在转移轨道设计方面,本文分别探究了借地转移、借月-借地转移以及流形拼接方案下的火星转移轨道设计。在基于地球借力、月球-地球借力的转移轨道设计中,通过建立数学模型并引入不同约束条件,此后通过微分修正得到了地月轨道-近地点的转移轨道,分析了不同起始相位、近地/月点高度、轨道倾角等对速度增量和转移时间的影响。随后结合Pork-chop图优化地火转移时间窗口及近地点脉冲机动,最终完成从地月特殊轨道经星体借力至火星的全轨道拼接。在基于流形拼接的转移轨道设计中,分别借助了李雅普诺夫轨道以及Halo轨道的不变流形完成轨道设计。在DRO-火星的转移轨道设计中,首先寻找到与DRO相切的地月L2李雅普诺夫轨道,此后利用地月L2点李雅普诺夫轨道的不稳定流形与日地L2点稳定流形的自然交点实现低能转移,并通过兰伯特弧连接日地与日火系统流形,最终以单次脉冲完成从日火L1点李雅普诺夫轨道到火星轨道捕获;在Halo-火星的转移轨道设计中,通过Halo轨道的不变流形完成地月-日地-日火的Halo轨道的拼接,设计了基于庞加莱界面交点的地月-日地转移,以及无交点情况下的兰伯特弧转移,最后设计了单次脉冲下的火星入轨方案,形成了完整的转移轨道。本文的研究为地月特殊轨道在火星探测任务中的应用提供了多种可行的轨道设计方案,综合比较了不同方案的能耗、转移时间和实现难度,为未来地月空间站支持的深空探测任务提供了重要参考。},
  collaborator = {{张泽旭}},
  langid = {chinese},
  school = {哈尔滨工业大学},
  keywords = {,;;;DRO;,DRO},
  annotation = {album: 工程科技II辑\\
CLC: V412.41\\
dbcode: CMFD\\

@mastersthesis{stahlDistantRetrogradeOrbits2022,
  title = {Distant Retrograde Orbits: Modeling and Stability},
  shorttitle = {Distant Retrograde Orbits},
  author = {Stahl, Dominik},
  year = 2022,
  abstract = {Distant Retrograde Orbits ( DROs ) are special orbits for third bodies in two\-body systems. The third body revolves around the secondary -- the smaller of the two primaries -- in a retrograde way, meaning the direction is opposite to the direction that the primaries revolve around each other. DROs are not close to either of the primaries, making it difficult to model them as perturbed two\-body orbits. There is no analytical solution for the initial conditions of DROs. This thesis presents a novel method of calculating an initial velocity guess which is then fed into a differential corrector that is able to calculate the initial conditions. In contrast to the state\-of\-the\-art, this happens without the method of incremental steps in the initial position, which requires to go through all possible DROs for a specific two\-body system first. For the calculation of DROs, numerical integration is done. Optimal integrator settings are deter\- mined, which is in this case an eighth\-order Runge\-Kutta method ( RK8 ). By setting the tolerance to the lowest possible value, the accuracy requirements are satisfied. Furthermore, this thesis explores a different method of modeling DROs that makes use of Fourier series and polynomials, which had already been proposed in [17] for a different set of parameters. By exploiting explicit knowledge about the shape of DROs, this approach is made more efficient in terms of accuracy per Fourier/polynomial parameters needed and thus the computation time is enhanced. The second part of this study addresses the stability of DROs. This is analyzed in order to get an idea of what DROs would be suitable for future missions. For mass ratios of primary and secondary that realistically occur in the Solar System, all DROs that are closer to the secondary than the primary turn out to be stable when disregarding perturbations. Perturbations are modeled as a constant external acceleration with a constant direction, which is only a first step towards modeling the Sun's and other planet's point mass gravity ( p. m. g. ), the solar radiation pressure ( s. r. p. ), and other perturbations, as they are usually depending on time and position. With this rough estimate, only the Sun's p. m. g. is identified as a possible source of instability for DROs in the Earth\-Moon system, as all other perturbations are too small.},
  langid = {english},
  school = {Delft University of Technology},
  annotation = {此外，本论文探索了另一种基于傅里叶级数与多项式的DROs建模方法，该方法虽已在文献[17]中针对不同参数集提出，但本研究通过利用DROs轨道形状的显式知识，提升了每个傅里叶/多项式参数所能达到的精度效率，从而显著缩短了计算时间。研究的第二部分探讨了DROs的稳定性问题，旨在为未来任务筛选适宜的DROs轨道。在太阳系实际存在的质比条件下，当忽略摄动影响时，所有距离次主天体近于主天体的DROs均呈现稳定状态。本研究将摄动建模为恒定方向的外部匀加速度，这仅是模拟太阳及其他行星质点引力、太阳辐射压及其他摄动的初步尝试（这些摄动通常具有时空依赖性）。通过此粗略估算，在地月系统DROs中仅太阳的质点引力可能成为轨道失稳源，其余摄动影响皆可忽略。\\
titleTranslation: 远距离逆行轨道：建模与稳定性分析\\
abstractTranslation: 远距离逆行轨道（DROs）是两体系统中第三体的一种特殊轨道。第三体以逆行方式围绕次主天体（即两个主天体中的较小者）运行，其方向与主天体相互绕转的方向相反。DROs远离两个主天体，因此难以将其建模为受摄动的两体轨道。目前尚无关于DROs初始条件的解析解。本论文提出了一种计算初始速度猜想值的新方法，该值随后被输入微分校正器，从而能够计算出初始条件。与现有技术相比，此方法无需采用初始位置增量步进法------该方法需首先遍历特定两体系统中所有可能的DROs轨道。在DROs计算中采用数值积分法，并确定了最优积分器设置：在本研究中采用八阶龙格-库塔法（RK8）。通过将容差设置为最低可能值，满足了精度要求。},
  file = {/home/ouyangjiahong/Zotero/storage/5KX4KYT2/Stahl - 2022 - Distant retrograde orbits modeling and stability.pdf}
}

@incollection{starekSpacecraftAutonomyChallenges2016,
  title = {Spacecraft Autonomy Challenges for Next-Generation Space Missions},
  booktitle = {Advances in Control System Technology for Aerospace Applications},
  author = {Starek, Joseph A. and A{\c c}{\i}kme{\c s}e, Beh{\c c}et and Nesnas, Issa A. and Pavone, Marco},

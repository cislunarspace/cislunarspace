@article{yangAnalysisGroundbasedSpacebased2021,
  title = {Analysis of Ground-Based and Space-Based Optical Observation System Warning Capability of near-Earth Asteroids},
  author = {Yang, Xu and Zhao, Kexin and Gan, Qingbo and Liu, Jing and Yao, Yongqiang},
  year = 2021,
  journal = {Beijing Ligong Daxue Xuebao/Transaction of Beijing Institute of Technology},
  volume = {Vol.41},
  number = {No.12},
  pages = {1307--1313},
  abstract = {In response to the threat of near-Earth asteroid impacts, the short-term warning capabilities of various typical ground-based and space-based optical observation systems for near-Earth asteroids (NEAs) were analyzed. The concept of short-term warning circle was proposed. Using the visible reflection model of celestial bodies in the solar system, the short-term warning capabilities of large-aperture ground-based telescope LSST, and three typical space-based telescopes deployed in the orbits of Sun-Earth L1 point, Venus-like orbit and distant retrograde orbit were simulated and calculated and the early warning capabilities of three space-based systems for NEAs approaching from the direction of the sun were compared. The results show that the early warning capability of L1 was good but the available warning time was short relatively; the Venus-like orbit constellation had a long warning time and wide coverage area, but the existence of phase gaps would cause a big omission probability; distant retrograde orbit had the advantages of high coverage rate and long warning time to the NEAs from the direction of the sun. The deployment of several space-based telescopes can provide sufficient supplement to the ground-based observation system, solve the problem of coverage omission in the direction of the sun, and provide approaching warning of NEAs in all directions.},
  langid = {english},
  keywords = {Distant retrograde orbit,Near-Earth asteroid,Short-term warning,Sun-Earth L1 point,Venus-like orbit},
  annotation = {titleTranslation: 近地小行星地基与天基光学观测系统预警能力分析\\
abstractTranslation: 针对近地小行星撞击威胁，分析了多种典型地基与天基光学观测系统对近地小行星的短期预警能力，提出了短期预警圈的概念。基于太阳系天体的可见光反射模型，分别对大口径地基望远镜LSST以及部署在日地L1点、类金星轨道和远距离逆行轨道上的三种典型天基望远镜的短期预警能力进行了仿真计算，并对比了三种天基系统对来自太阳方向近地小行星的预警能力。结果表明：L1点预警能力良好但可用预警时间相对较短；类金星轨道星座预警时间长、覆盖范围广，但相位间隙的存在会导致较大的遗漏概率；远距离逆行轨道对来自太阳方向的近地小行星具有覆盖率和高预警时间长的优势。部署多台天基望远镜可为地基观测系统提供充分补充，解决太阳方向覆盖遗漏问题，实现全方位近地小行星的接近预警。}
}

@article{YangBiaoTextLLMJiYuDongTaiFenBianLuDeWenDangDuoMoTaiDaMoXing2025,
  title = {{TextLLM:基于动态分辨率的文档多模态大模型}},
  shorttitle = {{TextLLM}},
  author = {{杨彪} and {刘禹良} and {刘强} and {朱盈盈}},
  year = 2025,
  journal = {中国图象图形学报},
  volume = {30},
  number = {9},
  pages = {3068--3082},
  urldate = {2026-05-27},
  abstract = {目的 文档智能旨在自动和智能地处理纸质文本信息，包括但不限于表格、表单和发票等，极大便利了信息的电子化管理。然而，传统深度学习方法往往专注于单一任务的优化，限制了它们在处理复杂多变的文档场景时的效能。此外，这些方法需要额外的光学字符识别（optical character recognition,OCR）工具来提取文档中的文字信息，这不仅增加了处理步骤，也可能引入额外的错误。多模态大模型的出现为免去OCR工具统一处理文档信息带来了希望，但是在处理高分辨率的文档图像和应对逐渐增加的视觉标记时，仍然面临着不小的挑战。本文提出一种基于动态分辨率的文档多模态大模型TextLLM，能免OCR工具处理高分辨率的文档图像。方法 基于最新的多模态大模型训练了一个能够处理动态分辨率的文档多模态大模型。在动态分辨率的基础上，提出一种动态特征压缩算法，设置动态的可学习压缩率来获得需要保留的特征长度，通过计算特征相似度来得到重要性特征，以此来聚合关键特征。更进一步，利用大语言模型的注意力机制捕捉与提示词相关的视觉特征部分，根据提示词的注意力分布图筛选出最相关的特征，并保留其周围相关特征。结果 实验在多个数据集...},
  langid = {chinese},
  annotation = {Fund: 国家自然科学基金项目(62206103)\textasciitilde\textasciitilde ；},
  file = {/home/ouyangjiahong/Zotero/storage/48FRQ47Q/杨彪 等 - 2025 - TextLLM基于动态分辨率的文档多模态大模型.pdf}
}

@phdthesis{YangChiHangDiYueKongJianYuanJuChiNiXingGuiDaoXiangDuiYunDongYuBianDuiSheJi2023,
  type = {{博士学位论文}},
  title = {{地月空间远距离逆行轨道相对运动与编队设计}},
  author = {{杨驰航}},
  year = 2023,
  address = {北京},
  abstract = {``地月空间DRO探索研究''战略性先导科技专项提出在地月空间远距离逆行轨道（Distant Retrograde Orbit，DRO）构建航天器编队以实现新型应用任务的设想。本论文以此为背景，针对DRO相对运动与编队设计开展系统性研究，并根据相对运动距离尺度将DRO附近的相对运动分为``近距离''与``远距离''两大类：``近距离''是指DRO航天器相对距离远小于DRO自身的轨道尺度，``远距离''是DRO航天器相对距离增大至DRO绕月距离同等量级。本论文的主要研究内容由DRO近/远距离相对运动和编队设计两大部分构成，针对每一部分，首先针对相应的相对运动开展研究，然后以相对运动规律为基础进行编队设计。对于DRO近距离相对运动，在圆型限制性三体问题（Circular Restricted Three-Body Problem, CRTBP）模型下构建了DRO近距离线性化相对运动模型的解析解，详尽分析了DRO近距离相对运动的运动规律：其有界解由平面周期模态、平面拟周期模态、以及法向拟周期模态（平面与法向参照白道面定义）三个相互独立的模态线性叠加构成，在逆行绕月轨道坐标系中，三者分别呈现为平面伴飞轨迹、平面绕飞轨迹、与法向垂直振动。基于对近距离相对运动的研究，针对DRO抵近观测任务场景，分别在CRTBP下设计了双脉冲绕飞编队、多脉冲伴飞/绕飞编队两类近距离编队。设计结果表明，双脉冲绕飞编队通过在每个DRO周期内施加两次脉冲，可在白道面内或面外实现对DRO卫星的绕飞；多脉冲伴飞/绕飞编队则沿参考圆轨道均匀施加多个脉冲，可通过调整脉冲施加间隔、参考圆轨道实现任意周期、轨迹灵活的伴飞或绕飞编队。为研究DRO远距离相对运动，提出了利用拟周期轨道分析相对运动的参数化方法，可支持双星与多星采用相同或不同的拟周期轨道构建长基线编队，并开展适用于任意目标几何构型的分析和设计。本文应用该方法分析了拟DRO的双星远距离相对运动，结果表明：通过调整拟DRO的平面/法向振幅与航天器之间的相位差，可得到不同平面与法向尺度的相对运动轨迹（平面与法向同样参照白道面定义）。基于拟周期轨道相对运动的参数化方法，设计了一种基于拟DRO的新型环月导航卫星编队，可对月球表面用户提供实时的几何定位和授时服务，并通过星间测量实现自主精密定轨与月球轨道反演。进一步，构建了利用五颗卫星构成的编队和十六颗卫星构建的星座，分别可实现周期性的月表中低纬全覆盖与全时的全月表覆盖，形成一种类似于GPS或北斗卫星导航系统（服务于地面用户）的环月轨道导航卫星星座新概念方案。本论文的研究全面覆盖了DRO近距离和远距离相对运动与编队设计，针对二者分别提出了相应的相对运动分析方法，提出并设计了多种近距离、远距离编队，特别展示了DRO近距离脉冲机动辅助的绕飞/伴飞、在拟DRO构建环月导航卫星编队新概念，它们对于地月空间在轨操控以及月球全球导航卫星星座等新型空间任务具有重要的牵引和支持作用。同时，本文提出的相对运动研究方法还可以扩展应用于包括CRTBP模型在内的任意天体动力学系统中的其它周期轨道与拟周期轨道。},
  langid = {chinese},
  school = {中国科学院大学},
  keywords = {;DRO;;;}
}

@article{YangChiHangYuanJuChiNiXingGuiDaoShangDeJinJuChiZiRanJiShouKongBianDui2023,
  title = {{远距离逆行轨道上的近距离自然及受控编队}},
  author = {{杨驰航} and {符弘岚} and {张皓}},
  year = 2023,
  journal = {航空学报},
  volume = {44},
  number = {5},
  pages = {229--241},
  issn = {1000-6893},
  urldate = {2025-12-12},
  abstract = {远距离逆行轨道（DROs）是地月空间中一族稳定的周期轨道，适用于地月空间站等长期任务。为维持任务的长期存在，交会对接及编队飞行等任务是必要的。因此有必要分析远距离逆行轨道上的近距离相对运动解，并进行编队设计。首先，基于Floquet理论得到了远距离逆行轨道上的近距离线性化相对运动的基础解集，并对其解进行了分类与分析。其次，以基础解集中的自然周期解为基础设计了伴飞编队，并对其特性进行了全面分析。之后，针对圆形受控绕飞编队做了详细的分析，可用于指导后续受控编队的设计。最后，设计了两点之间的安全转移编队，可用于任意两点之间的转移，并保证转移过程中主星与副星之间具有足够的安全距离。},

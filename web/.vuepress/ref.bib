@article{duOrbitalPerturbationAnalysis2022,
  title = {Orbital Perturbation Analysis and Generation of Nominal near Rectilinear Halo Orbits Using Low-Thrust Propulsion},
  author = {Du, Chongrui and Starinova, Olga L},
  year = 2022,
  month = nov,
  journal = {Proceedings of the Institution of Mechanical Engineers, Part G: Journal of Aerospace Engineering},
  volume = {236},
  number = {14},
  pages = {NaN-NaN},
  issn = {0954-4100, 2041-3025},
  doi = {10.1177/09544100211072318},
  urldate = {2025-10-07},
  abstract = {The near rectilinear halo orbit (NRHO) is a potential orbit for the establishment of lunar space station. This research is focused on the analysis of major orbital perturbations on NRHOs and the generation of nominal orbit using a lowthrust engine in the ephemeris model. First, the NRHO family is defined in the circular restricted three-body problem (CRTBP). Then, different perturbations are performed to integrate the spacecraft motion along the NRHOs; meanwhile, a modified momentum integral is employed to calculate the orbit deviation in the case of each perturbation examined independently. By this way, these perturbations are classified according to the magnitude of impact on NRHOs. Finally, combined with a fuel-optimal control, a target-point strategy generating the nominalcontrolled NRHO in the real Earth--Moon system is proposed using low-thrust technology. By selecting a fixed point from the original NRHO, the spacecraft is forced to depart from this point and then return to it, thereby forming a controlled closed trajectory. This provides an alternative nominal orbit for the future application of the low-thrust engine to lunar exploration missions.},
  langid = {english},
  keywords = {CONSTRUCTION,LIBRATION POINTS,PERIODIC-ORBITS,TRAJECTORIES},
  annotation = {titleTranslation: 利用低推力推进进行轨道摄动分析与名义近直线晕轨道生成\\
abstractTranslation: 近直线晕轨道（NRHO）是建立月球空间站的潜在轨道。本研究聚焦于分析主要轨道摄动对NRHO的影响，并在历表模型下利用低推力发动机构建标称轨道。首先，在圆形限制性三体问题（CRTBP）中定义了NRHO族。随后，对沿NRHO运行的航天器施加不同摄动进行积分；同时，采用修正动量积分独立计算每种摄动情况下的轨道偏差。据此，根据对NRHO影响程度的大小对这些摄动进行分类。最后，结合燃料最优控制，提出了一种利用低推力技术在真实地月系统中生成受控标称NRHO的目标点策略。通过从原始NRHO中选取一个固定点，迫使航天器离开该点并最终返回，从而形成一条受控闭合轨迹。这为低推力发动机在未来月球探测任务中的应用提供了一种备选的标称轨道方案。},
  file = {/home/ouyangjiahong/Zotero/storage/MIFLSXML/Du和Starinova - 2022 - Orbital perturbation analysis and generation of nominal near rectilinear halo orbits using low-thrus.pdf}
}

@article{DuQingFengBianZhiXinFeiXingQiShuangSuLuQianKuiFanKuiZuHeZiTaiKongZhi2025,

  booktitle = {{{AAS}}/{{AIAA Astrodynamics Specialist Conference}}},
  author = {Pellegrino, Marielle M. and Ocampo, Cesar and Foster, Christopher},
  year = 2025,
  address = {Boston, MA},
  abstract = {Satellites in a Near Rectilinear Halo Orbit can utilize unstable manifolds for departure to heliocentric orbits at their end of life. These orbits are highly sensitive to dispersions due to navigation uncertainties and maneuver execution errors. Additionally, uncertainties due to orientation can cause varying effects of solar radiation pressure and out-gassing events can occur after a satellite is no longer operational. This paper characterizes how operators can minimize time of contact with their satellites post-departure while avoiding collisions with other celestial bodies and spacecraft in the orbit used by Earth-Moon's 9:2 NRHO resonance.},
  langid = {english},
  annotation = {titleTranslation: 近直线晕轨道上的时间敏感离轨机动}
}

@article{penarroyaLiDARlessApproachAutonomous2023,
  title = {A {{LiDAR-less}} Approach to Autonomous Hazard Detection and Avoidance Systems Based on Semantic Segmentation},
  author = {Pe{\~n}arroya, Pelayo and Centuori, Simone and Sanjurjo, Manuel and Hermos{\'i}n, Pablo},
  year = 2023,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {3},
  pages = {34},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10140-9},
  urldate = {2025-10-01},
  abstract = {Abstract             In this paper, a passive hazard detection and avoidance (HDA) system is presented, relying only on images as observations. To process these images, convolutional neural networks (CNNs) are used to perform semantic segmentation and identify hazards corresponding to three different layers, namely feature detection, shadow detection, and slope estimation. The absence of active sensors such as light detection and ranging (LiDAR) makes it challenging to assess the surface geometry of a celestial body, and the training of the neural networks in this work is oriented towards coping with that drawback. The image data set for the training is generated using blender, and different body shape models (also referred to as meshes) are included, onto which stochastic feature populations and illumination conditions are imposed to produce a more diverse database. The CNNs are trained following a transfer learning approach to reduce the training effort and take advantage of previously trained networks. The results accurately predict the hazards in the images belonging to the data set, but struggle to yield successful predictions for the slope estimation, when images external to the data set are used, indicating that including the geometry of the target body in the training phase makes an impact on the quality of these predictions. The obtained predictions are composed to create safety maps, which are meant to be given as input to the guidance block of the spacecraft to evaluate the need for a manoeuvre to avoid hazardous areas. Additionally, preliminary hardware-in-the-loop (HIL) test results are included, in which the algorithms developed are confronted against images taken using real hardware.},
  langid = {english},
  annotation = {titleTranslation: 基于语义分割的无激光雷达自主危险检测与规避系统。\\
TLDR: A passive hazard detection and avoidance system relying only on images as observations, which accurately predict the hazards in the images belonging to the data set, but struggle to yield successful predictions for the slope estimation, indicating that including the geometry of the target body in the training phase makes an impact on the quality of these predictions.\\
abstractTranslation: 摘要  \\
本文提出了一种仅依赖图像观测的被动式危险检测与规避系统。为处理这些图像，采用卷积神经网络进行语义分割，并识别对应于三个不同层级的危险：特征检测、阴影检测与坡度估计。由于缺乏激光雷达等主动传感器，评估天体表面几何形状面临挑战，因此本工作的神经网络训练旨在应对这一不足。训练所用图像数据集通过Blender生成，并包含多种天体形状模型（亦称网格），在此类模型上施加随机特征分布与照明条件以构建更多样化的数据库。卷积神经网络采用迁移学习策略进行训练，以减少训练工作量并利用预训练网络的优势。结果表明，该网络能准确预测数据集中图像所含危险，但在使用数据集中未包含的图像时，坡度估计的预测效果欠佳，这表明训练阶段纳入目标天体几何形状会影响此类预测质量。所获预测结果被整合用于生成安全地图，这些地图将作为输入提供给航天器的制导模块，以评估规避危险区域所需机动操作。此外，文中还包含了初步的硬件在环测试结果，该测试使用真实设备拍摄的图像对上述算法进行了验证。},
  file = {/home/ouyangjiahong/Zotero/storage/VQQSU8UN/Peñarroya 等 - 2023 - A LiDAR-less approach to autonomous hazard detection and avoidance systems based on semantic segment.pdf}
}


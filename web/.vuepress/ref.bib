@article{gonzalez-garciaGuidanceControlBased2021,
  title = {Guidance and {{Control Based}} on {{Adaptive Sliding Mode Strategy}} for a {{USV Subject}} to {{Uncertainties}}},
  author = {{Gonzalez-Garcia}, Alejandro and Castaneda, Herman},
  year = 2021,
  month = oct,
  journal = {IEEE Journal of Oceanic Engineering},
  volume = {46},
  number = {4},
  pages = {1144--1154},
  issn = {0364-9059, 1558-1691, 2373-7786},
  doi = {10.1109/JOE.2021.3059210},
  urldate = {2025-09-25},
  abstract = {This article addresses a guidance and control strategy for an unmanned surface vehicle subject to uncertainties. The controller uses a dynamic three-degree-of-freedom model with identified parameters of an experimental platform. A strategy based on adaptive sliding-mode control is designed for the motion control of surge speed and heading variables, whereas a line-of-sight guidance law, with time-varying look-ahead distance, is applied to achieve path following. The adaptive controller is robust against bounded uncertainties/disturbances, and it does not overestimate the control gain. Outdoor experimental results validate the performance and advantages of the proposed control scheme in three different scenarios: 1) set-point regulation; 2) tracking of time-varying references; and 3) path following. To further demonstrate the characteristics of the proposed controller, a comparison against a standard controller while carrying an extra payload of 20\% of the mass of the vessel is included.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  annotation = {titleTranslation: 基于自适应滑模策略的USV不确定环境下的制导与控制\\
abstractTranslation: 本文针对存在不确定性的无人水面艇，提出了一种制导与控制策略。控制器采用基于实验平台参数辨识的动力学三自由度模型。针对纵荡速度与航向变量的运动控制，设计了基于自适应滑模控制的策略；同时，采用具有时变前视距离的视线制导律实现路径跟踪。该自适应控制器对界不确定性/干扰具有鲁棒性，且不会高估控制增益。室外实验结果验证了所提控制方案在三种不同场景下的性能与优势：1）设定点调节；2）时变参考信号跟踪；3）路径跟踪。为进一步展示所提控制器的特性，还将其与标准控制器进行了对比，对比中船舶额外承载了其自身质量20\%的载荷。},
  file = {/home/ouyangjiahong/Zotero/storage/8G2FMKJ7/Gonzalez-Garcia和Castaneda - 2021 - Guidance and Control Based on Adaptive Sliding Mode Strategy for a USV Subject to Uncertainties.pdf}
}


@article{parkerChainingPeriodicThreebody2010,
  title = {Chaining Periodic Three-Body Orbits in the {{Earth}}--Moon System},
  author = {Parker, Jeffrey S. and Davis, Kathryn E. and Born, George H.},
  year = 2010,
  journal = {Acta Astronautica},
  volume = {67},
  number = {5},
  pages = {623--638},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2010.04.003},
  abstract = {In this paper, we describe methods to construct complex chains of orbit transfers in the planar circular restricted Earth--Moon three-body system using the invariant manifolds of unstable three-body orbits. It is shown that the Poincar\'e map is a useful tool to identify and construct transfer trajectories from one orbit to another, i.e., homoclinic and heteroclinic orbit connections, with applications to practical spacecraft mission design. A multiple-shooting differential corrector is used to construct complex orbit chains and complex periodic orbits. The resulting complex periodic orbits are shown to be members of continuous families of such orbits, where the characteristics of each orbit in the family vary continuously from one end of the family to the other. Finally, we characterize the cost of constructing an orbit transfer between any two points along two libration orbits using a single maneuver. It is shown that a spacecraft requires substantially less {$\Delta$}V to perform such single-maneuver transfers if the transfers are near heteroclinic connections in the corresponding phase space.},
  langid = {english},
  keywords = {Dynamical systems,Earth-Moon orbits,Low-energy,Manifolds,Mission design,Orbit transfers,Three-body trajectories},
  annotation = {titleTranslation: 地月系统中的周期三体轨道链式结构\\
abstractTranslation: 本文描述了在平面圆型限制性地球-月球三体系统中，利用不稳定三体轨道的不变流形构建复杂轨道转移链的方法。研究表明，庞加莱映射是识别和构建轨道间转移轨迹（即同宿与异宿轨道连接）的有效工具，并适用于实际航天器任务设计。采用多点打靶微分校正器构建复杂轨道链与复杂周期轨道。结果表明，所得复杂周期轨道属于此类轨道的连续族，族内各轨道特性沿一族端点至另一端连续变化。最后，我们表征了沿两条平动轨道上任意两点之间进行单次机动构建轨道转移的成本。研究表明，若转移过程接近相应相空间中的异宿连接，则航天器执行此类单次机动转移所需的{$\Delta$}V显著降低。},
  file = {/home/ouyangjiahong/Zotero/storage/R87J5LU7/Parker 等 - 2010 - Chaining periodic three-body orbits in the Earth–moon system.pdf}
}

@article{parkerDirectLunarHalo2008,
  title = {Direct Lunar Halo Orbit Transfers},
  author = {Parker, Jeffrey S. and Born, George H.},
  year = 2008,
  month = dec,
  journal = {Journal of Astronautical Sciences},
  volume = {56},
  number = {4},
  pages = {441--476},
  issn = {0021-9142},
  doi = {10.1007/BF03256561},
  urldate = {2025-09-30},
  abstract = {This paper provides a robust survey of short-duration, two-burn transfers from the Earth to lunar halo orbits. The results show that several families of such transfers exist, including quick four- to five-day transfers, as well as more efficient transfers that require three or more weeks. The trajectories surveyed in this paper all begin from 185-km circular Earth parking orbits, with varying inclinations; they transfer to many sample halo orbits about the EarthMoon and points. It has been found that the quickest lunar transfers require between 3.6 and , depending on the halo orbit destination. If more time is available, then any lunar halo orbit considered in this paper may be reached for as little as 3.59 to Finally, the paper discusses the costs and benefits of short and longer halo transfers applied to real lunar mission designs.},
  copyright = {http://www.springer.com/tdm},
  langid = {english},
  annotation = {titleTranslation: 直接月球晕轨道转移\\
abstractTranslation: 本文对从地球到月球晕轨道短期两次变轨转移进行了全面综述。结果表明，存在多种此类转移轨道族，包括四至五天的快速转移，以及需要三周或更长时间的高效转移。本文考察的所有轨迹均始于高度为185千米、倾角各异的圆形地球停泊轨道，并转移至地球-月球系统拉格朗日点附近的多个样本晕轨道。研究发现，最快的地月转移所需时间介于3.6天至（取决于目标晕轨道）；若时间允许，本文所考虑的任何月球晕轨道均可通过仅3.59至（单位）的成本到达。最后，本文讨论了短期与长期晕轨道转移在实际月球任务设计中的成本与收益。},
  file = {/home/ouyangjiahong/Zotero/storage/8DWHEFA2/Parker和Born - 2008 - Direct lunar halo orbit transfers.pdf}
}


@article{gustavsonOilConstructingFormal1966,
  title = {Oil Constructing Formal Integrals of a Hamiltonian System near Ail Equilibrium Point},
  author = {Gustavson, F. G.},
  year = 1966,
  month = oct,
  journal = {Astronomical Journal},
  volume = {71},
  pages = {670},
  publisher = {IOP},
  issn = {0004-6256},
  doi = {10.1086/110172},
  urldate = {2026-01-01},
  abstract = {A procedure is given for constructing formal integrals of a Hamiltonian system of n degrees of freedom near an equilibrium point. The method consists of performing a series of canonical transformations which reduces the Hamiltonian to a normal form. The integrals then appear as quadratic forms. - computer program carries out the construction procedure by manipulating polynomials symboJically. For a given Hamiltonian system, it determines approximate integrals (truncated power series) and expresses them in the original coordinates. In the case of two degrees of freedom, level lines of the intersection of the integral with some appropriate surface are plotted. To illustrate this technique the problem of the existence of a third isolating integral of motion in an axisymmetrical potential is investigated; a comparison is then made be- tween computed orbits and the curves generated by the approximate third integral.},
  langid = {english},
  annotation = {ADS Bibcode: 1966AJ.....71..670G\\
titleTranslation: 在哈密顿系统平衡点附近构造形式积分的方法\\
abstractTranslation: 本文提出了一种在平衡点附近构造n自由度哈密顿系统形式积分的方法。该方法通过一系列正则变换将哈密顿量化为规范形，积分随之以二次型形式呈现。计算机程序通过符号化处理多项式来执行该构造流程。对于给定的哈密顿系统，程序可确定近似积分（截断幂级数）并以原始坐标表示。针对二自由度情形，绘制了积分与适当截面相交的等高线。为阐明此技术，本文研究了轴对称势场中第三运动隔离积分的存在性问题，并对计算轨道与近似第三积分生成的曲线进行了比较。},
  file = {/home/ouyangjiahong/Zotero/storage/XE5U7IYU/Gustavson - 1966 - Oil constructing formal integrals of a hamiltonian system near ail equilibrium point.pdf}
}

@article{gutierrezClassifyingStateUncertainty2024,
  title = {Classifying State Uncertainty for {{Earth-moon}} Trajectories},
  author = {Gutierrez, Juan and Hill, Keric and Jenson, Erica L. and Scheeres, Daniel J. and Bruer, Jill C. and Coder, Ryan D.},
  year = 2024,
  month = jun,
  journal = {Journal of Astronautical Sciences},
  volume = {71},
  number = {3},
  pages = {29--50},
  issn = {0021-9142, 2195-0571},
  doi = {10.1007/s40295-024-00451-w},
  urldate = {2025-09-25},
  abstract = {While the evolution of state uncertainties from Gaussian to non-Gaussian is well understood in geocentric orbits, the only data product made publicly available by the United States Space Force, the Two-Line Element, does not include state uncertainties at all. With a new international focus on cislunar space situational awareness, it is useful to determine how this complex dynamical environment influences trajectory uncertainties and the resultant implications for data association, orbit determination, and force model algorithms. This paper utilizes a new tensor eigenpair measure of nonlinearity (TEMoN) to quantify the nonlinearity of gravitational forces in the cislunar regime. This measure is then compared with various characterizations of Gaussian distributions to determine the value of TEMoN at which trajectory uncertainties become non-Gaussian. This novel advancement combines the cumulative effect of time and physical location of the trajectory into one value. The result is a predictive method that obviates highly parameterized Monte Carlo runs, and allows an objective assessment of how sensor tasking cadence, measurement uncertainty, and force model selection can be balanced to enable nascent cislunar space situational awareness capabilities with legacy space surveillance network assets.},
  langid = {english},
  annotation = {titleTranslation: 对地月轨道的状态不确定性进行分类。\\
abstractTranslation: 尽管在地球轨道上，状态不确定性从高斯分布向非高斯分布的演变已得到充分理解，但美国太空部队唯一公开发布的数据产品------双行根数------根本不包含状态不确定性。随着国际上对地月空间态势感知的新关注，有必要确定这一复杂动力学环境如何影响轨迹不确定性，以及由此对数据关联、轨道定轨和力模型算法产生的启示。本文采用一种新的张量特征对非线性度量（TEMoN）来量化地月区域中引力的非线性程度。随后将该度量与高斯分布的各种表征进行比较，以确定轨迹不确定性变为非高斯分布时的TEMoN值。这一创新进展将时间累积效应与轨迹的物理位置结合为一个数值。其结果是一种预测方法，避免了高度参数化的蒙特卡洛运行，并允许客观评估如何平衡传感器任务编排节奏、测量不确定性和力模型选择，从而利用传统空间监视网络资产实现新兴的地月空间态势感知能力},
  file = {/home/ouyangjiahong/Zotero/storage/8X6CJRJM/Gutierrez 等 - 2024 - Classifying state uncertainty for Earth-moon trajectories.pdf}
}


@article{jiaLearningbasedOrbitalPursuitevasion2025,
  title = {Learning-Based Orbital Pursuit-Evasion Games near Earth-Moon {{L1}} Point},
  author = {Jia, Kangjun and Dang, Zhaohui},
  year = 2025,
  month = jan,
  journal = {IFAC-PapersOnLine},
  series = {23th {{IFAC Symposium}} on {{Automatic Control}} in {{Aerospace ACA}} 20255},
  volume = {59},
  number = {20},
  pages = {2072--2077},
  issn = {2405-8963},
  doi = {10.1016/j.ifacol.2025.11.464},
  urldate = {2026-03-08},
  abstract = {This paper explores spacecraft orbital pursuit-evasion strategies near the Earth-Moon L1 point, addressing the challenges posed by thrust constraints through a Multi-Agent Deep Deterministic Policy Gradient (MADDPG) framework. By modeling the interaction between intelligent pursuers and evaders, a learning-based control strategy is trained in a cooperative-competitive setting. Simulation results show that the pursuer's success rate is highly sensitive to the evader's thrust level: when the evader's thrust is 40\% of the pursuer's, the success rate is 45\%, but it drops to 37\% when the thrust increases to 70\%. A larger initial semi-major axis also reduces success rates by 20-30\%. Compared to classical methods, the MADDPG-based approach demonstrates stronger adaptability and performance under complex, uncertain dynamics, offering both theoretical and practical value for future space mission planning.},
  langid = {english},
  keywords = {Earth-Moon L1 point,MADDPG,Orbital pursuit-evasion game,Reinforcement learning},
  annotation = {titleTranslation: 基于学习的近地月L1点轨道追逃博弈\\
abstractTranslation: 本文探讨了地月L1点附近的航天器轨道追逃策略，并通过多智能体深度确定性策略梯度（MADDPG）框架应对推力约束带来的挑战。通过模拟智能追捕方与逃逸方之间的交互，在合作-竞争环境下训练了一种基于学习的控制策略。仿真结果表明，追捕方的成功率对逃逸方的推力水平高度敏感：当逃逸方推力为追捕方的40\%时，成功率为45\%；而当推力增至70\%时，成功率降至37\%。初始半长轴较大时，成功率也会降低20\%-30\%。与传统方法相比，基于MADDPG的方法在复杂、不确定动力学环境下展现出更强的适应性与性能，为未来空间任务规划提供了理论与实际价值。},
  file = {/home/ouyangjiahong/Zotero/storage/H9BJGGRX/Jia和Dang - 2025 - Learning-based orbital pursuit-evasion games near earth-moon L1 point.pdf;/home/ouyangjiahong/Zotero/storage/KP7Y8ICW/S240589632502141X.html}
}

@article{JiaLuMengJuShenZhiNengDeFengXianJianShiYuShaHeJianGuan2026,
  title = {{具身智能的风险检视与沙盒监管}},
  author = {{贾璐萌}},
  year = 2026,
  journal = {自然辩证法研究},
  volume = {42},
  number = {1},
  pages = {81--89},
  issn = {1000-8934},
  doi = {10.19484/j.cnki.1000-8934.2026.01.010},
  urldate = {2026-02-05},
  abstract = {作为智能算法与机器人融合的前沿领域，具身智能正成为全球产业布局与竞争的热点。然而，其技术特性潜藏复杂多维的伦理风险：物理交互性加剧直接风险，具身模拟性导致失范风险，智能进化性引发系统风险，进而对传统``风险排除''治理理念与``科层式''监管机制提出挑战。对此，监管沙盒作为一种试验主义的监管工具，通过构造受控测试环境，有效平衡创新激励与风险防控的价值冲突。在面向具身智能的沙盒监管实践中，要确保``风险-场景''双维度的差异化监管设计、注重实施过程的程序正义、构建多层次制度衔接机制，以提升监管沙盒的治理效能。},
  langid = {chinese},
  annotation = {original-container-title: Studies in Dialectics of Nature\\
AIF: 1.188\\
album: 基础科学;信息科技;经济与管理科学\\
CIF: 1.669\\
CLC: TP18;F49\\
dbcode: CJFQ\\
dbname: CJFDAUTO\\
filename: ZRBZ202601011\\

@article{zhangAttentiondrivenReinforcementLearning2025,
  title = {Attention-Driven Reinforcement Learning for Multi-Satellite Collaborative Orbital Interception Strategy Solution},
  author = {Zhang, Wenxiu and Wang, Yamin and Zhang, Yonghe},
  year = 2025,
  month = oct,
  journal = {Astrodynamics},
  volume = {9},
  number = {5},
  pages = {657--669},
  issn = {2522-008X, 2522-0098},
  doi = {10.1007/s42064-024-0246-0},
  urldate = {2026-03-27},
  abstract = {Aiming at the problem of efficient collaborative decision-making among multiple satellites in multi-satellite orbital interception mission, a multi-satellite cooperative orbital interception strategy based on attention mechanism and deep reinforcement learning is proposed. Firstly, considering the orbital dynamics, maneuverability, mission duration, and collision avoidance constraints faced in orbital interception mission, a Markov decision process is designed, and a multi-satellite game strategy solution framework based on the actor--critic network is built; then, a guided reward function is designed to effectively guide the pursuit satellite to approach and intercept the escaping satellite to accelerate the convergence speed of the algorithm; finally, the attention mechanism is used to capture the potential relationship between satellites and generate coded information with biased attention effect, which helps satellites form an efficient collaborative interception strategy. The simulation experiments show that the trained satellites can conduct autonomous learning and decision-making in a dynamic and uncertain environment. In orbital interception mission, the pursuit satellite can adopt an effective collaborative strategy to use the advantage of quantity to make up for the disadvantage of speed, maintain a high mission success rate, and a series of intelligent game behaviors emerge.},
  langid = {english},
  annotation = {titleTranslation: 注意力驱动的强化学习用于多卫星协同轨道拦截策略求解\\
abstractTranslation: 针对多星轨道拦截任务中多星间高效协同决策问题，提出一种基于注意力机制与深度强化学习的多星协同轨道拦截策略。首先，考虑轨道动力学、机动能力、任务时长及轨道拦截任务中的避碰约束，设计马尔可夫决策过程，并构建基于actor--critic网络的多星博弈策略求解框架；然后，设计引导型奖励函数，有效引导追踪卫星接近并拦截逃逸卫星，以加速算法收敛；最后，利用注意力机制捕捉卫星间的潜在关系，生成具有偏置注意力效应的编码信息，助力卫星形成高效协同拦截策略。仿真实验表明，经过训练的卫星能够在动态不确定环境中进行自主学习与决策。在轨道拦截任务中，追踪卫星可采用有效协同策略，以数量优势弥补速度劣势，维持高任务成功率，并涌现出一系列智能博弈行为。},
  file = {/home/ouyangjiahong/Zotero/storage/QRT5VG7Z/Zhang 等 - 2025 - Attention-driven reinforcement learning for multi-satellite collaborative orbital interception strat.pdf}
}


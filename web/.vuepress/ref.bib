@inproceedings{uedaStudyGuidanceLogic2017,
  title = {A Study on Guidance Logic for Finite-Time Maneuver in Cislunar Orbit},
  booktitle = {68th {{International Astronautical Congress}}: {{Unlocking Imagination}}, {{Fostering Innovation}} and {{Strengthening Security}}, {{IAC}} 2017},
  author = {Ueda, Satoshi and Murakami, Naomi and Ikenaga, Toshinori},
  year = 2017,
  address = {Adelaide, SA, Australia},
  abstract = {This study addresses a new guidance logic used for finite-time orbital maneuvers in cislunar orbits, and is motivated by international discussion regarding the design architecture of future space stations in cislunar orbits. Near rectilinear halo orbits (NRHO) of the Earth-Moon system are possible orbits in which to position a new cislunar station. Orbital maneuvers with large delta-V require a spacecraft to be injected into the target NRHO. The maximum size of delta-V is about 250 m/s, which is significantly larger than the size of delta-V required in rendezvous missions to the International Space Station in low Earth orbits. Although further trajectory optimization reduces the size of delta-V, a spacecraft used for a cislunar transfer mission must be designed with the capability to execute large orbital maneuvers using the limited thrust force of its own engines. Moreover, the unique conditions of orbital dynamics dominated by the features of the multibody problem must be considered. This paper presents a new guidance logic that achieves precise execution accuracy for finite-time orbital maneuvers. The logic basically utilizes a trajectory optimization technique, and derives the time-series of thrust angles during a finite-time maneuver. The logic is applied to two major transfer maneuvers known as powered lunar swing-by and NRHO injection. First, an optimum transfer trajectory from low Earth orbit to NRHO is derived by considering an impulsive model. Second, an equivalent thrust arc and corresponding time-series of thrust angles for each maneuver are derived by the trajectory optimization technique. The thrust arc starts at a point along the nominal transfer trajectory before the impulse point, and ends up at a point also along the nominal transfer trajectory after the impulse point. Third, both thrust arcs and transfer trajectory are derived simultaneously to pursue more adequate guidance logic. It is therefore concluded that optimum thrust arc and control inputs (i.e., thrust angles) can be derived with sufficient accuracy by the proposed method, and that the fixed thrust angle for each maneuver is appropriate when both thrust arcs and transfer trajectory are derived simultaneously. A guidance logic with a fixed thrust angle is simple and appropriate in terms of onboard software implementation.},
  langid = {english},
  keywords = {Cislunar,Guidance,Optimization,Orbit control,Three-body problem,Trajectory design},
  annotation = {titleTranslation: 地月轨道有限时间机动制导逻辑研究}
}


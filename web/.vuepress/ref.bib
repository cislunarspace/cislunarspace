@phdthesis{JiangSongZaiGuiWeiXingFanLanJieZhiDaoKongZhiYanJiu2016,
  type = {硕士},
  title = {在轨卫星反拦截制导控制研究},
  author = {{姜松}},
  year = 2016,
  abstract = {随着各国对空间资源的不断探索,在轨卫星受到越来越多的空间威胁,导致在轨卫星的安全运行问题越来越引起人们的重视。所以,面对越来越严重的空间环境威胁,对空间在轨卫星防护的研究是十分必要的。本文针对空间防御中的一种重要方式,主动防御的制导控制技术进行了研究,主要内容包括以下几点:首先,对微分对策理论进行了较为深入的论述,以微分对策最基本问题即二人零和微分对策为基础,介绍了多人合作微分对策理论,着重论述了鞍点解的求解方法及存在的必要条件。面对空间威胁的多种多样,针对不同类型的空间目标,应选择不同的机动策略。本文尝试利用航天器轨迹规划问题中的高斯伪谱法,以C-W方程为模型,在燃料约束、路径约束及机动能力等约束下,建立偏置可拦截状态区将空间威胁划分为低速目标和高速目标。针对低速目标,建立了护卫飞行器视线坐标系下的相对动力学模型,并运用视线制导控制技术与基于对偶四元数理论的滑模控制律进行偏置拦截制导律的设计并进行了系统仿真,对该制导算法进行验证与分析。针对高速目标的速度快,机动能力强的特点,单独依赖护卫飞行器不足以完成拦截任务,在机动能力约束基础上,利用微分对策理论设计了主星与护卫飞行器的协同微分对策制导算法。讨论了制导参数对制导过程与鞍点解存在性的影响,仿真进行验证与分析,结果表明采用协同微分对策制导律,即使利用没有机动性优势的护卫飞行器护卫主星,仍然可以提高主星的生存能力。},
  school = {哈尔滨工业大学},
  keywords = {;;;},
  file = {/home/ouyangjiahong/Zotero/storage/QHE94A6Y/姜松 - 2016 - 在轨卫星反拦截制导控制研究.pdf}
}

@article{JiangWenHuiRongHeDuoJieDuanChaiFenTeZhengDeGuangChangTuXiangXianZhuXingJianCe2025,
  title = {{融合多阶段差分特征的光场图像显著性检测}},
  author = {{姜文晖} and {朱畅} and {方玉明} and {蔡超} and {鄢杰斌}},

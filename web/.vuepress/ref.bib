@article{manwadkarMeasurementThreebodyChaotic2024,
  title = {Measurement of Three-Body Chaotic Absorptivity Predicts Chaotic Outcome Distribution},
  author = {Manwadkar, Viraj and Trani, Alessandro A. and Kol, Barak},
  year = 2024,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {1},
  pages = {4--22},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10174-z},
  urldate = {2025-10-01},
  abstract = {The flux-based statistical theory of the non-hierarchical three-body system predicts that the chaotic outcome distribution reduces to the chaotic emissivity function times a known function, the asymptotic flux. Here, we measure the chaotic emissivity function (or equivalently, the absorptivity) through simulations. More precisely, we follow millions of scattering events only up to the point when it can be decided whether the scattering is regular or chaotic. In this way, we measure a trivariate absorptivity function. Using it, we determine the flux-based prediction for the chaotic outcome distribution over both binary binding energy and angular momentum, and we find good agreement with the measured distribution. This constitutes a detailed confirmation of the flux-based theory and demonstrates a considerable reduction in computation to determine the chaotic outcome distribution.},
  langid = {english},
  annotation = {titleTranslation: 测量三体混沌吸收率可以预测混沌结果分布。\\
abstractTranslation: 基于通量的非层级三体系统统计理论预言，混沌结果分布可简化为混沌发射率函数乘以一个已知函数------渐近通量。本文通过模拟测量混沌发射率函数（等价于吸收率）。更确切地说，我们追踪数百万次散射事件，直至能够判定散射是规则还是混沌为止。由此测量得到一个三变量吸收率函数。利用该函数，我们得到关于双星结合能和角动量的混沌结果分布的通量基预测，并与测量分布吻合良好。这构成了对通量基理论的详细验证，并表明确定混沌结果分布所需计算量的大幅减少},
  file = {/home/ouyangjiahong/Zotero/storage/4F68Q7EP/Manwadkar 等 - 2024 - Measurement of three-body chaotic absorptivity predicts chaotic outcome distribution.pdf}
}

@phdthesis{MaoQi911ShiJianHouMeiJunCanYuZhanHouChongJianYanJiu2022,
  type = {{硕士学位论文}},
  title = {{``9{$\cdot$}11''事件后美军参与战后重建研究}},

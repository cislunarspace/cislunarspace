  publisher = {国防科技大学出版社},
  abstract = {本书从题解开始，首先弄清楚孙子在每篇要讲什么，然后进行文白对照，了解孙子都讲了什么。在此基础上，再分析每一篇的中心要义，梳理其中的逻辑思路，对应地列出原文精华。围绕原文精华，精选名言警句81条，讲深、讲透、讲活其中所蕴藏的兵法道理。最后，优选古今中外的著名战例、案例近百个，精当分析其现实运用。如此，既有理论讲解，又有案例分析，既能整体把握，又不面面俱到，既能得其精要，又不挂一漏万，既能把握要义，又不断章取义。},
  keywords = {-}
}

@book{ZhaoRongSunZiBingFaZhuYiPing2017,

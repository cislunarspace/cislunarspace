  month = jun,
  journal = {Journal of Astronautical Sciences},
  volume = {67},
  number = {2},
  pages = {458--484},
  issn = {2195-0571},
  doi = {10.1007/s40295-019-00152-9},
  urldate = {2026-02-04},
  abstract = {We have developed a new method for solving low-thrust fuel-optimal orbit transfer problems in the vicinity of a large body (planet or asteroid), considering a high-fidelity spherical harmonic gravity model. The algorithm is formulated via the indirect optimization method, leading to a two-point boundary value problem (TPBVP). We make use of a hyperbolic tangent smoothing law for performing continuation on the thrust magnitude to reduce the sharpness of the control switches in early iterations and thus promote convergence. The TPBVP is solved using the method of particular solutions (MPS) shooting method and Picard-Chebyshev numerical integration. Application of Picard-Chebyshev integration affords an avenue for increased efficiency that is not available with step-by-step integrators. We demonstrate that computing the particular solutions with only a low-fidelity force model greatly increases the efficiency of the algorithm while ultimately achieving near machine precision accuracy. A salient feature of the MPS is that it is parallelizable, and thus further speedups are available. It is also shown that, for near-Earth orbits and over a small number of en-route revolutions around the Earth, only the zonal perturbation terms are required in the costate equations to obtain a solution that is accurate to machine precision and optimal to engineering precision. The proposed framework can be used for trajectory design around small asteroids and also for orbit debris rendezvous and removal tasks.},
  langid = {english},
  keywords = {Gravity perturbations,Low thrust,Method of particular solutions,Picard-Chebyshev,Trajectory optimization},
  annotation = {titleTranslation: 高效计算受引力摄动的最优低推力轨道转移\\
abstractTranslation: 我们提出了一种新方法，用于在大天体（行星或小行星）附近求解考虑高保真球形谐波重力模型的低推力燃料最优轨道转移问题。该算法基于间接优化方法构建，形成两点边值问题（TPBVP）。我们采用双曲正切平滑律对推力幅值进行延续，以降低早期迭代中控制切换的陡峭程度，从而促进收敛。TPBVP通过特殊解方法（MPS）打靶法结合皮卡-切比雪夫数值积分求解。皮卡-切比雪夫积分的应用提供了逐次积分器所不具备的效率提升途径。我们证明，仅使用低保真力模型计算特殊解可大幅提高算法效率，同时最终达到接近机器精度的准确性。MPS的一个显著特点是可并行化，因此能进一步加速计算。研究还表明，对于近地轨道且在少量绕地圈次内，仅需在协态方程中引入带状扰动项，即可获得机器精度准确且工程精度最优的解。该框架可用于小行星附近轨道设计，以及轨道碎片交会与清除任务},
  file = {/home/ouyangjiahong/Zotero/storage/DL5VZ5YD/Woollands 等 - 2020 - Efficient computation of optimal low thrust gravity perturbed orbit transfers.pdf}
}

@article{wordenDigitalTwinsMirrors2020,
  title = {On {{Digital Twins}}, {{Mirrors}}, and {{Virtualizations}}: {{Frameworks}} for {{Model Verification}} and {{Validation}}},
  shorttitle = {On {{Digital Twins}}, {{Mirrors}}, and {{Virtualizations}}},
  author = {Worden, K. and Cross, E. J. and Barthorpe, R. J. and Wagg, D. J. and Gardner, P.},
  year = 2020,
  month = may,
  journal = {ASCE-ASME J Risk and Uncert in Engrg Sys Part B Mech Engrg},
  volume = {6},
  number = {30902},
  issn = {2332-9017},
  doi = {10.1115/1.4046740},
  urldate = {2026-02-19},
  abstract = {A powerful new idea in the computational representation of structures is that of the digital twin. The concept of the digital twin emerged and developed over the last decade, and has been identified by many industries as a highly desired technology. The current situation is that individual companies often have their own definitions of a digital twin, and no clear consensus has emerged. In particular, there is no current mathematical formulation of a digital twin. A companion paper to the current one will attempt to present the essential components of the desired formulation. One of those components is identified as a rigorous representation theory of models; most importantly, governing how they are verified and validated, and how validation information can be transferred between models. Unlike its companion, which does not attempt detailed specification of any twin components, this paper will attempt to outline a rigorous representation theory of models, based on the introduction of two new concepts: mirrors and virtualizations. The paper is not intended as a passive wish list; it is intended as a rallying call. The new theory will require the active participation of researchers across a number of domains including: pure and applied mathematics, physics, computer science, and engineering. The paper outlines the main objects of the theory and gives examples of the sort of theorems and hypotheses that might be proved in the new framework.},
  langid = {american},
  annotation = {titleTranslation: 论数字孪生、镜像与虚拟化：模型验证与确认框架\\
abstractTranslation: 在结构计算表示领域中，一个强有力的新概念是数字孪生。数字孪生的概念在过去十年间出现并发展，已被众多行业视为一项备受追捧的技术。当前现状是，各企业往往对数字孪生有自己的定义，尚未形成明确共识。尤其值得注意的是，目前尚无数字孪生的数学表述。本文的姊妹篇将尝试提出所需表述的基本组成部分。其中一项组成部分被确定为模型的严格表示理论；最重要的是，它规定了模型如何被验证与确认，以及验证信息如何在模型之间传递。与姊妹篇不同（该篇未试图对任何孪生组件进行详细说明），本文基于两个新概念------镜像与虚拟化------勾勒出一套严格的模型表示理论。本文并非一份被动的愿望清单，而是一声集结号。这套新理论需要来自多个领域研究者的积极参与，包括：纯数学与应用数学、物理学、计算机科学以及工程学。本文概述了该理论的主要对象，并举例说明了在新框架下可能得以证明的定理与假设类型},
  file = {/home/ouyangjiahong/Zotero/storage/LHZY5CEA/Worden 等 - 2020 - On Digital Twins, Mirrors, and Virtualizations Frameworks for Model Verification and Validation.pdf;/home/ouyangjiahong/Zotero/storage/M7TLW84M/1.html}
}

@article{wrightInteriorpointRevolutionOptimization2004,
  title = {The Interior-Point Revolution in Optimization: {{History}}, Recent Developments, and Lasting Consequences},
  shorttitle = {The Interior-Point Revolution in Optimization},
  author = {Wright, Margaret},
  year = 2004,
  month = sep,
  journal = {Bulletin of the American Mathematical Society},
  volume = {42},
  number = {1},
  pages = {39--56},
  issn = {0273-0979, 1088-9485},
  doi = {10.1090/S0273-0979-04-01040-7},
  urldate = {2025-09-25},
  abstract = {Interior methods are a pervasive feature of the optimization landscape today, but it was not always so. Although interior-point techniques, primarily in the form of barrier methods, were widely used during the 1960s for problems with nonlinear constraints, their use for the fundamental problem of linear programming was unthinkable because of the total dominance of the simplex method. During the 1970s, barrier methods were superseded, nearly to the point of oblivion, by newly emerging and seemingly more efficient alternatives such as augmented Lagrangian and sequential quadratic programming methods. By the early 1980s, barrier methods were almost universally regarded as a closed chapter in the history of optimization.},
  copyright = {https://www.ams.org/publications/copyright-and-permissions},
  langid = {english},
  annotation = {titleTranslation: 优化中的内点法革命：历史、近期进展与持久影响\\
abstractTranslation: 内点法如今在优化领域已是一种普遍采用的方法，但情况并非一直如此。尽管障碍法这一内点技术在20世纪60年代已广泛用于非线性约束问题，但由于单纯形法的主导地位，将其用于线性规划这一基本问题仍难以想象。到了20世纪70年代，障碍法几乎被增广拉格朗日法和序列二次规划法等新兴且看似更高效的替代方法所取代，濒临消亡。到20世纪80年代初，障碍法几乎被普遍视为优化史上已经翻过的篇章。},
  file = {/home/ouyangjiahong/Zotero/storage/ZFQQPCCQ/Wright - 2004 - The interior-point revolution in optimization History, recent developments, and lasting consequence.pdf}
}


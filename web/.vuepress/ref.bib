@article{oghimRealtimeSpacecraftIntercept2019,
  title = {Real-Time Spacecraft Intercept Strategy on {{J2}} -Perturbed Orbits},
  author = {Oghim, Snyoll and Leeghim, Henzeh and Kim, Donghoon},
  year = 2019,
  month = jan,
  journal = {Advances in Space Research},
  volume = {63},
  number = {2},
  pages = {1007--1016},
  issn = {02731177},
  doi = {10.1016/j.asr.2018.09.023},
  urldate = {2025-09-25},
  abstract = {A real-time intercept strategy for spacecraft under the non-uniform gravitational perturbation of Earth is addressed in this paper. To intercept a target spacecraft on general conic sections, an interceptor considered in this work makes use of a thruster propelling the constant thrust which is comparable to unrealistic impulse-type thrust. The J 2 perturbation introduces critical dynamic variations of spacecraft orbiting the Earth, which results in a considerable amount of position error of the interceptor at the final intercept point. In order to release the burden of J 2 disturbance and make the miss distance between the target and interceptor small, a real-time intercept technique with an optimal intercept algorithm is suggested. The strategy proposed is to obtain an optimized output iteratively for a given time interval with previously obtained optimal values. These parameters are evaluated by the optimal intercept algorithm suggested. Once the optimal velocity change is obtained to satisfy intercept requirements, although the orbital system is perturbed, it is easy to regenerate a new solution by setting the previous solution as new initial guesses. This strategy is employed iteratively until the interceptor meets the target. Several numerical simulations are performed to highlight the proposed real-time strategy for spacecraft intercept missions.},
  langid = {english},
  annotation = {titleTranslation: J2扰动轨道上实时航天器拦截策略\\
abstractTranslation: 本文研究了一种在地球非均匀引力摄动下航天器的实时拦截策略。为实现对运行于一般圆锥曲线轨道上的目标航天器的拦截，本文所考虑的拦截器使用恒定推力推进器，其推力特性与理想化的脉冲式推力不同。J2摄动使地球周围航天器的动力学状态发生显著变化，从而导致拦截器在最终拦截点处产生较大的位置误差。为减轻J2扰动的影响并缩小目标与拦截器之间的脱靶距离，提出了一种结合最优拦截算法的实时拦截技术。该策略基于先前获取的最优值，在给定时间间隔内迭代求解优化输出，并通过所提出的最优拦截算法对这些参数进行评估。一旦获得满足拦截要求的最优速度增量，即使轨道系统受到扰动，只需将前一步的解作为新的初值即可轻松生成新的解。该策略迭代执行，直至拦截器与目标相遇。通过多次数值仿真，验证了所提出的实时拦截策略在航天器拦截任务中的有效性},
  file = {/home/ouyangjiahong/Zotero/storage/F6RSJU9G/Oghim 等 - 2019 - Real-time spacecraft intercept strategy on J2 -perturbed orbits.pdf}
}


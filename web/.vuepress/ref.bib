@phdthesis{ChenRuiHangTianFaSheCeKongRenWuShiJingFangZhenXiTongSheJiYuShiXian2019,
  type = {{硕士学位论文}},
  title = {{航天发射测控任务视景仿真系统设计与实现}},
  author = {{陈瑞}},
  year = 2019,
  urldate = {2025-09-25},
  abstract = {近年来,随着我国航天技术与航天活动的快速发展,航天发射测控任务密度与难度显著增加,对航天发射场信息化建设提出了新的更高要求,数字化航天发射场建设成为航天领域重要发展方向。利用先进的计算机建模与视景仿真技术,建设航天发射测控任务视景仿真系统,将航天发射测控任务与资源管理,环境与气象条件模拟有机结合,可对航天发射测控任务各种资源要素、任务过程和结果进行实时处理和动态显示,支持发射测控任务事先预演,事中监控和事后分析评估,为航天发射测控任务组织管理、资源优化配置、任务风险管控提供了直观便捷、灵活实用的指挥工具和辅助决策支持系统,对确保航天任务成功、增强航天发射测控任务效率具有重要意义和价值。本文正是在此背景下,以航天发射测控任务需求和流程为主线,利用三维建模技术和数据资源管理方法,设计并实现了航天发射测控任务视景仿真系统。主要研究内容包括以下四部分:一是首先设计了航天发射测控任务视景仿真系统总体技术框架,论证分析了系统组成和工作流程,梳理了系统各模块功能;二是重点研究了三维场景建模技术,围绕地形环境、空间环境和三维实体建模等问题论述了建模方法与特点;三是针对航天发射测控任务内容与特点,开展了基于脚本的任务想定生成,围绕测控设备资源管理与海量测控数据管理问题,设计开发了测控资源与任务数据库;四是运用上述建模方法,基于最新的ViewTerra可视化开发平台,设计开发了航天发射测控任务视景仿真原型系统。该系统经过现场安装调试,已初步应用于航天发射场任务分析与展示,可视化效果流畅逼真,社会效益明显。},
  collaborator = {{杨乐平}},
  langid = {chinese},
  school = {国防科学技术大学},

@article{leeRobustPositionAttitude2012,
  title = {Robust Position and Attitude Control for Spacecraft Formation Flying},
  author = {Lee, Daero and Cochran, John E. and No, Tae Soo},
  year = 2012,
  month = jul,
  journal = {Journal of Aerospace Engineering},
  volume = {25},
  number = {3},
  pages = {436--447},
  issn = {0893-1321, 1943-5525},
  doi = {10.1061/(ASCE)AS.1943-5525.0000146},
  urldate = {2025-11-27},
  abstract = {An integrated approach combining a state-dependent Ricatti equation (SDRE) and an extended Kalman filter (EKF) is applied to spacecraft formation flying for robust orbital and attitude maneuvers. The formation flying considered in this study is a two-spacecraft formation with a bounded out-of-orbit plane relative motion. The chaser is required to simultaneously perform large position and angle maneuvers with sufficient accuracy. The chaser is then required to maintain a relative orbit expressed in the local-vertical-local-horizontal frame with respect to the target and align its attitude with the target attitude for more than one orbital period. The controls of the chaser are formulated as a nonlinear optimal regulator problem using their highly nonlinear dynamics. To test the robustness of this integrated approach, highly nonlinear dynamics, including external disturbances, are employed as the truth plant that is then used to generate the measurements for an EKF. The tracking error is then computed between the true plant and the desired state. A six degrees-of-freedom simulation of a twospacecraft flying formation is used to demonstrate the robustness of this integrated approach to external disturbances and plant uncertainties. The integrated approach also has an effect well under the large uncertainty of the chaser moment of inertia. DOI: 10.1061/(ASCE)AS.19435525.0000146. \copyright{} 2012 American Society of Civil Engineers.},
  langid = {english},
  annotation = {titleTranslation: 航天器编队飞行的鲁棒位置与姿态控制\\
abstractTranslation: 一种结合状态相关Riccati方程（SDRE）与扩展卡尔曼滤波（EKF）的综合方法被应用于航天器编队飞行，以实现稳健的轨道与姿态机动。本研究考虑的编队飞行是由两颗航天器组成的编队，具有有界的面外相对运动。追踪航天器需同时执行大范围的位置与角度机动，并达到足够精度。随后，追踪航天器需在本地垂直-本地水平坐标系中维持相对于目标的相对轨道，并在一个轨道周期以上时间内使其姿态与目标姿态对齐。追踪航天器的控制被建模为非线性最优调节器问题，利用其高度非线性的动力学特性。为测试该综合方法的鲁棒性，将包含外部扰动的高度非线性动力学作为真实模型，用于生成扩展卡尔曼滤波的测量值。随后计算真实模型与期望状态之间的跟踪误差。通过六自由度双航天器编队飞行仿真，验证了该综合方法对外部扰动及模型不确定性的鲁棒性。该方法在追踪航天器转动惯量存在较大不确定性的情况下仍能保持良好效果。},
  file = {/home/ouyangjiahong/Zotero/storage/BRS8IPVN/Lee 等 - 2012 - Robust position and attitude control for spacecraft formation flying.pdf}
}

@article{leeSpecialIssueComprehensive2018,
  title = {Special Issue: A Comprehensive Study on Enhanced Optimization-Based Model Calibration Using Gradient Information},
  shorttitle = {Special Issue},
  author = {Lee, Guesuk and Yi, Guilian and Youn, Byeng D.},
  year = 2018,
  month = may,
  journal = {Structural and Multidisciplinary Optimization},
  volume = {57},
  number = {5},
  pages = {2005--2025},
  issn = {1615-1488},
  doi = {10.1007/s00158-018-1920-8},
  urldate = {2026-02-19},
  abstract = {Model calibration is the process of estimating unknown inputs in a model to improve the agreement between model predictions and experimental observations. Optimization-based model calibration is a probabilistic approach for estimating unknown inputs by using optimization techniques. Gradient-based optimization algorithms are popular for optimization-based model calibration because of their computational efficiency. Gradient-based algorithms, however, also have drawbacks that include the local optimum issue, the numerical noise issue, lack of gradient information, and related concerns. In optimization-based model calibration, a calibration metric that quantifies the similarity or difference between two probability distributions (the predicted and the observed system responses) is defined as an objective function. Current methods of optimization-based model calibration use existing calibration metrics, such as the likelihood function and the probability residual. Occasionally, these methods show inaccurate calibrated results. Therefore, first, this comprehensive study investigates the root causes of the inaccurate calibrated results that arise from using existing calibration metrics. Second, an enhanced method is proposed to achieve robust optimization-based model calibration by providing analytical gradient information. This study provides a general guideline for improved optimization-based model calibration.},
  langid = {english},
  keywords = {Calibration metric,Gradient information,Gradient-based algorithms,Kullback-Leibler divergence,Likelihood function,Optimization-based model calibration,Probability residual},
  annotation = {titleTranslation: 特刊：基于梯度信息的增强型优化模型校准综合研究\\
abstractTranslation: Model calibration is the process of estimating unknown inputs in a model to improve the agreement between model predictions and experimental observations. Optimization-based model calibration is a probabilistic approach for estimating unknown inputs by using optimization techniques. Gradient-based optimization algorithms are popular for optimization-based model calibration because of their computational efficiency. Gradient-based algorithms, however, also have drawbacks that include the local optimum issue, the numerical noise issue, lack of gradient information, and related concerns. In optimization-based model calibration, a calibration metric that quantifies the similarity or difference between two probability distributions (the predicted and the observed system responses) is defined as an objective function. Current methods of optimization-based model calibration use existing calibration metrics, such as the likelihood function and the probability residual. Occasionally, these methods show inaccurate calibrated results. Therefore, first, this comprehensive study investigates the root causes of the inaccurate calibrated results that arise from using existing calibration metrics. Second, an enhanced method is proposed to achieve robust optimization-based model calibration by providing analytical gradient information. This study provides a general guideline for improved optimization-based model calibration.\\
\\
模型标定是通过估计模型中的未知输入参数，以增强模型预测与实验观测之间一致性的过程。基于优化的模型标定是一种利用优化技术估计未知输入的概率性方法。基于梯度的优化算法因其计算效率高而被广泛应用于优化型模型标定。然而，这类算法也存在局部最优问题、数值噪声干扰、缺乏梯度信息及相关局限性。在基于优化的模型标定中，定义了一种标定度量作为目标函数，用于量化两个概率分布（即预测系统响应与观测系统响应）之间的相似性或差异性。当前基于优化的模型标定方法采用似然函数、概率残差等现成标定度量，但偶尔会出现标定结果不准确的情况。因此，本研究首先深入探讨了使用现成标定度量导致标定结果不准确的根本原因，其次提出了一种通过提供解析梯度信息实现稳健优化型模型标定的增强方法。本研究为改进基于优化的模型标定提供了通用指导框架。},
  file = {/home/ouyangjiahong/Zotero/storage/QSRRYRLY/Lee 等 - 2018 - Special issue a comprehensive study on enhanced optimization-based model calibration using gradient.pdf}
}


  abstract = {The push for a sustained human and robotic presence in cislunar space creates a critical need for robust and autonomous trajectory optimization capabilities within the chaotic multi-body dynamics of the Earth-Moon system. This challenge is especially pronounced for low-thrust spacecraft, where traditional methods often struggle to converge and typically require expert-provided initial guesses. We address this challenge with Attention-Augmented Proximal Policy Optimization (A2PPO), a novel deep reinforcement learning (DRL) framework that integrates a directional cross-attention mechanism into an actor-critic policy. When paired with a progressive curriculum learning strategy, A2PPO autonomously learns continuous control policies for precise low-thrust transfers between periodic orbits in the Earth-Moon Circular Restricted Three-Body Problem (CR3BP), balancing transfer time and fuel consumption without relying on any initial guess. We validate A2PPO on four challenging low-thrust transfer scenarios in the Earth-Moon CR3BP and compare its performance with classical optimization methods and state-of-the-art autonomous approaches. In a comparative study of a representative scenario, we demonstrate that the attention mechanism in A2PPO enables the policy to focus on critical state features, yielding faster convergence and higher reward than a standard baseline. Monte Carlo analysis shows that the learned policies exhibit strong robustness, maintaining a 100\% success rate under significant initial state perturbations and tolerating up to 32\% deterministic thrust degradation without retraining. The A2PPO framework thus represents an important advancement in robust and autonomous trajectory optimization methods that can enhance spacecraft autonomy for low-thrust missions in cislunar space.},
  langid = {english},
  annotation = {titleTranslation: 地月空间低推力轨迹自主优化：基于注意力增强的强化学习方法\\
abstractTranslation: 在推动人类与机器人持续驻留地月空间的过程中，混沌的地月系统多体动力学环境对稳健且自主的轨迹优化能力提出了迫切需求。对于低推力航天器而言，这一挑战尤为突出------传统方法往往难以收敛，且通常需要专家提供初始猜测。为此，我们提出注意力增强近端策略优化（A2PPO），这是一种新颖的深度强化学习框架，通过在行动者-评论家策略中集成定向交叉注意力机制。结合渐进式课程学习策略后，A2PPO能够自主习得连续控制策略，在地月圆形限制性三体问题（CR3BP）中实现周期轨道间的精确低推力转移，并在不依赖任何初始猜测的前提下平衡转移时间与燃料消耗。我们在四个具有挑战性的地月CR3BP低推力转移场景中验证了A2PPO，并将其性能与经典优化方法及当前最先进的自主方法进行了对比。通过对代表性场景的比较研究，我们证明A2PPO中的注意力机制使策略能够聚焦于关键状态特征，从而比标准基线实现更快的收敛速度和更高的奖励。蒙特卡洛分析表明，所学策略表现出强鲁棒性：在初始状态显著扰动下保持100\%的成功率，且无需重新训练即可容忍高达32\%的确定性推力退化。因此，A2PPO框架代表了稳健自主轨迹优化方法的重要进展，可提升地月空间低推力任务中航天器的自主能力},
  file = {/home/ouyangjiahong/Zotero/storage/DKC3M7LH/Ul Haq 等 - 2026 - Autonomous low-thrust trajectory optimization in cislunar space via attention-augmented reinforcemen.pdf;/home/ouyangjiahong/Zotero/storage/VTDF3IJS/S1270963826000544.html}
}

@article{ulhaqHybridDeepReinforcement2026,
  title = {Hybrid Deep Reinforcement Learning and Indirect Method for Low-Thrust Trajectory Optimization in Cislunar Space},
  author = {Ul Haq, Izhar and Dai, Honghua and Zhang, Jiye and Song, Liangjun},
  year = 2026,
  month = feb,
  journal = {Advances in Space Research},
  volume = {77},
  number = {4},
  pages = {4928--4954},
  issn = {02731177},
  doi = {10.1016/j.asr.2025.11.107},
  urldate = {2026-03-27},
  abstract = {Optimal low-thrust transfer trajectory design within the Circular Restricted Three-Body Problem (CRTBP) is crucial for cislunar missions, including lunar exploration and space station resupply. The chaotic nature of CRTBP dynamics makes conventional trajectory optimization computationally intensive and prone to convergence failure. Although indirect methods offer high-precision solutions, they rely on costate initial guesses that lack physical interpretability and are challenging to estimate. We introduce a hybrid framework that combines deep reinforcement learning (DRL) and indirect optimal control for the sequential optimization of low-thrust trajectories. A Proximal Policy Optimization (PPO) agent is trained to generate dynamically feasible trajectories from various initial phases on the departure orbit. Initial costates are then estimated via backward integration of the adjoint equations derived from Pontryagin's Minimum Principle (PMP) along the DRL trajectory. These state--costate pairs initialize a two-point boundary value problem (TPBVP), which is solved using continuation and indirect collocation. The method is validated on low-thrust transfers between Earth-Moon L1 and L2 Lyapunov orbits, optimizing for time-, energy-, and fuel-optimal objectives. In 500 Monte Carlo trials, the framework achieved 100 \% initial guess feasibility. The hybrid method converges post-training in 1.49--5 s with {$>$}95 \% success, outperforming the randominitialized indirect shooting benchmark (10--20 \% success, 753--1817 s runtime). It matches benchmark optimality for standard transfers and additionally discovers lower-fuel solutions. This semi-autonomous hybrid framework offers an efficient solution for low-thrust trajectory optimization and shows promise for cislunar mission design applications.},
  langid = {english},
  annotation = {titleTranslation: 混合深度强化学习与间接方法的地月空间低推力轨迹优化\\
abstractTranslation: 最优低推力转移轨迹在圆型限制性三体问题（CRTBP）中的设计对于地月空间任务（包括月球探测与空间站补给）至关重要。CRTBP动力学的混沌特性使传统轨迹优化计算量巨大且易陷入收敛失败。间接法虽能提供高精度解，但依赖于缺乏物理可解释性且难以估计的协态初值。我们提出了一种融合深度强化学习（DRL）与间接最优控制的混合框架，用于低推力轨迹的序列优化。训练一个近端策略优化（PPO）智能体，使其能够从出发轨道的不同初始相位生成动力学可行轨迹。随后，沿DRL轨迹反向积分由庞特里亚金极小值原理（PMP）导出的伴随方程，从而估计初始协态。这些状态-协态对用于初始化一个两点边值问题（TPBVP），并通过延拓法和间接配点法求解。该方法在地月L1与L2 Lyapunov轨道间的低推力转移上进行了验证，优化目标涵盖时间最优、能量最优和燃料最优。在500次蒙特卡洛试验中，该框架实现了100\%的初值可行性。混合方法在训练后收敛时间为1.49--5秒，成功率超过95\%，优于随机初始化间接打靶基准方法（成功率10--20\%，运行时间753--1817秒）。在标准转移中，该方法与基准最优性相当，并额外发现了更低燃料的解。这种半自主混合框架为低推力轨迹优化提供了高效方案，在地月空间任务设计中具有应用前景。},
  file = {/home/ouyangjiahong/Zotero/storage/8U9HEX3M/Ul Haq 等 - 2026 - Hybrid deep reinforcement learning and indirect method for low-thrust trajectory optimization in cis.pdf;/home/ouyangjiahong/Zotero/storage/LPKKES3T/S0273117725013912.html}
}


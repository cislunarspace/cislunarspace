@article{ZhangSiYangXingZuoShouMingHouSuiPianFeiYueGuiDaoSheJiYuYouHua2024,
  title = {{星座寿命后碎片飞越轨道设计与优化}},
  author = {{张思扬} and {王蜀泉}},
  year = 2024,
  journal = {宇航学报},
  volume = {45},
  number = {6},
  pages = {866--880},
  issn = {1000-1328},
  abstract = {针对星座卫星寿命结束后转变为大规模碎片的主动清理问题，提出一种多目标飞越方案，以SL(StarLink)星座为例设计从停泊轨道出发对多个轨道面、多枚碎片的飞越探测最优轨道。首先根据SL星座的轨道特征将目标按照轨道面进行聚类，然后根据球面几何关系和Gibbs公式对轨道机动参数进行降维，在开普勒运动假设下快速设计考虑航天器空飞、套圈飞行的单脉冲飞越多目标的轨道机动参数初值。最后基于分支定界广度优先方法，考虑J2引力摄动搜索单脉冲飞越双目标的飞行序列，得到燃耗最小的飞越轨道。数值仿真结果表明航天器通过24次轨道机动后，共飞越探测了48颗SL卫星，共需速度脉冲1.66 km/s，飞行时间9.64天，证明了所提出方法的有效性，为未来大规模空间碎片清理任务设计提供参考。},
  langid = {chinese},
  file = {/home/ouyangjiahong/Zotero/storage/K9W9A99W/张思扬和王蜀泉 - 2024 - 星座寿命后碎片飞越轨道设计与优化.pdf}
}

@article{zhangSmoothingTechniqueIndirect2025,
  title = {Smoothing Technique for Indirect Low-Thrust Trajectory Optimization in Cislunar Space},
  author = {Zhang, Zhongtao and Zhang, Yakun and Shi, Xueshuang and Zhang, Yasheng and Li, Ang and Wang, Bin},
  year = 2025,
  month = jan,
  journal = {IFAC-PapersOnLine},
  series = {23th {{IFAC Symposium}} on {{Automatic Control}} in {{Aerospace ACA}} 20255},
  volume = {59},
  number = {20},
  pages = {149--153},
  issn = {2405-8963},
  doi = {10.1016/j.ifacol.2025.11.141},
  urldate = {2025-12-20},
  abstract = {In this manuscript, a smoothing technique is employed to solve the low-thrust minimum-fuel trajectory optimization problem. The thrust profile is transitioned gradually from a smooth shape to a bang-of-bang shape by approximating the switching function derived in the indirect method using a parameterized sigmoid function. The proposed technique utilizes the error function as a basis for a novel smoothing method, leading to the effective resolution of the problem concerning transfer and rendezvous between the Earth-Moon L1 halo orbit and the L2 halo orbit. The efficacy of the proposed method is substantiated by the findings that the error function is more conducive to the resolution of such problems, exhibiting superior computational efficiency and convergence accuracy in comparison to the two existing smoothing functions.},
  langid = {english},
  keywords = {Aerospace trajectories,Fuel minimization,Indirect method,Optimal control,Regularization},
  annotation = {abstractTranslation: 本文采用一种平滑化技术求解低推力最小燃料轨迹优化问题。通过使用参数化Sigmoid函数逼近间接法导出的开关函数，推力曲线得以从平滑形态逐步过渡至Bang-Bang形态。该技术以误差函数为基础构建新型平滑方法，有效解决了地月系L1晕轨道至L2晕轨道的转移与交会问题。研究结果表明，相较于现有两种平滑函数，误差函数对此类问题具有更优的适应性，在计算效率与收敛精度方面均展现出显著优势，从而验证了所提方法的有效性。\\
titleTranslation: 地月空间间接低推力轨迹优化的平滑技术},
  file = {/home/ouyangjiahong/Zotero/storage/G8XI6IW9/Zhang 等 - 2025 - Smoothing technique for indirect low-thrust trajectory optimization in cislunar space.pdf;/home/ouyangjiahong/Zotero/storage/LVLJALYI/S2405896325018117.html}
}

@inproceedings{zhangSpacecraftTargetVisual2025,
  title = {Spacecraft Target Visual Classification Dataset Based on {{LLM}} Prompt Annotation},
  booktitle = {2025 40th {{Youth Academic Annual Conference}} of {{Chinese Association}} of {{Automation}} ({{YAC}})},
  author = {Zhang, Zhihao and Sun, Qinbo and Dang, Zhaohui},
  year = 2025,
  month = may,
  pages = {1131--1136},
  issn = {2837-8601},
  doi = {10.1109/YAC66630.2025.11150326},
  urldate = {2026-03-08},
  abstract = {The accuracy of fine-grained recognition and multi-attribute labeling for spacecraft target imagery heavily depends on dataset completeness and annotation precision. This study presents the Spacecraft Target Visual Classification Dataset, along with an optimized prompt-based annotation algorithm leveraging Large Language Model (LLM) to tackle these challenges. The dataset includes six fundamental attributes, including model, mission, components, geometry, illumination, and confidence, covering nine categories of spacecraft targets while providing detailed attribute-level annotations for complex on-orbit objects. To improve annotation accuracy and address issues in partial-attribute recognition, we propose an optimized prompt-based annotation method based on In-Context Learning (ICL), incorporating few-shot examples, Chain-of-Thought (CoT) reasoning, and Self-Consistency (SC) mechanisms. Experiments conducted on public spacecraft datasets demonstrate that our approach yields an average increase of 14.0\% in Per-Image Average Accuracy (PIAA) and 21.1\% in All-Attributes-Correct Accuracy (AACA), underscoring its adaptability to diverse scenarios. By significantly reducing reliance on manual labeling, this method enables precise and scalable spacecraft target classification, highlighting its broad applicability in space visual tasks.},
  langid = {english},
  keywords = {Accuracy,Annotations,Fine-Grained Classification,Image recognition,In-Context Learning,Labeling,Large language models,Lighting,LLM-Based Prompt Annotation,Manuals,Space vehicles,Spacecraft Dataset,Target recognition,Visualization},
  annotation = {titleTranslation: 基于LLM提示标注的航天器目标视觉分类数据集},
  file = {/home/ouyangjiahong/Zotero/storage/HPQ3ERCB/Zhang 等 - 2025 - Spacecraft target visual classification dataset based on LLM prompt annotation.pdf;/home/ouyangjiahong/Zotero/storage/R359DFUZ/11150326.html}
}

@article{ZhangTaoJiYuQianYiXueXiDeKuaYuJingXiaYiChangZhenDongJianCe2026,
  title = {{基于迁移学习的跨域井下异常振动监测}},
  author = {{张涛} and {曹雪萌} and {米力克{$\cdot$}萨迪尔} and {孟卓然} and {郭庆丰}},
  year = 2026,
  journal = {石油机械},
  volume = {54},
  number = {1},
  pages = {1--9},
  issn = {1001-4578},
  urldate = {2026-02-05},
  abstract = {由于不同井间工况差异显著，异常振动特征分布存在跨井不一致性，传统基于单井数据的监测方法难以适应跨井场景。为此，以黏滑振动为例，对不同工况下的黏滑振动数据特征进行了对比分析，提出了一种结合深度判别迁移学习网络（domain adaptive transfer learning network,DDTLN）与BO-Transformer-LSTM的跨井异常振动识别方法。将近钻头振动数据输入到DDTLN模型中，通过卷积层与改进的联合分布自适应（IJDA）机制减小域间特征差异，实现跨域特征提取；将提取的特征输入到BO-Transformer-LSTM模型中挖掘时序信息，实现跨井高效分类。试验结果表明：不同工况下井间振动信号差异显著，传统方法跨域分类效果较差；经过DDTLN处理后，不同域间的数据特征有了很好的对齐，跨域识别准确率高达91.5\%;DDTLN-BO-TransformerLSTM模型能够有效解决跨井识别问题，分类准确率最高达96.7\%，显著优于传统单井识别方法，具有更好的泛化能力。该研究可为跨井场景下的井下异常振动识别提供新思路。},
  langid = {chinese},
  keywords = {,BO-Transformer-LSTM},
  annotation = {original-container-title: China Petroleum Machinery\\

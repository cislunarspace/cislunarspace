@article{fenucciAegisOrbitDetermination2024,
  title = {The Aegis Orbit Determination and Impact Monitoring System and Services of the {{ESA NEOCC}} Web Portal},
  author = {Fenucci, M. and Faggioli, L. and Gianotto, F. and Bracali~Cioci, D. and Cano, J. L. and Conversi, L. and Devog{\`e}le, M. and Di~Girolamo, G. and Drury, C. and F{\"o}hring, D. and Gisolfi, L. and Kresken, R. and Micheli, M. and Moissl, R. and Oca{\~n}a, F. and Oliviero, D. and Porru, A. and {Ramirez-Moreta}, P. and Rudawska, R. and Bernardi, F. and Bertolucci, A. and Dimare, L. and Guerra, F. and Baldisserotto, V. and Ceccaroni, M. and Cennamo, R. and Chessa, A. and Del~Vigna, A. and Koschny, D. and Teodorescu, A. M. and Perozzi, E.},
  year = 2024,
  month = dec,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {6},
  pages = {58--99},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10225-z},
  urldate = {2025-10-01},
  abstract = {The NEO Coordination Centre (NEOCC) of the European Space Agency is an operational centre that, among other activities, computes the orbits of near-Earth objects and their probabilities of impact with the Earth. The NEOCC started providing information about near-Earth objects in 2012 on a dedicated web portal, accessible at https://neo.ssa.esa.int/. Since the beginning of the operational phase, many developments and improvements have been implemented regarding the software, the data provided, and the portal. One of the most important upgrades is that the NEOCC is now independently providing data through a newly developed Orbit Determination and Impact Monitoring system, named Aegis. All the data computed by Aegis are publicly available on the NEOCC web portal, and Aegis is also used to maintain all the major services offered. The most important services comprise an orbital catalogue of all known asteroids, a list of possible future impacts with the Earth (also called Risk List), a list of forthcoming close approaches, a set of graphical toolkits, and an on-demand ephemerides service. Many of the services are also available through dedicated APIs, which can be used to automatically retrieve data. Here we give an overview of the algorithms implemented in the Aegis software and provide a summary of the services offered by the NEOCC that are supported by Aegis.},
  langid = {english},
  annotation = {titleTranslation: 欧空局近地天体协调中心门户网站的"天盾"轨道测定与撞击监测系统及服务\\
abstractTranslation: 欧洲航天局近地天体协调中心（NEOCC）是一个运行中心，其主要任务之一包括计算近地天体的轨道及其撞击地球的概率。自2012年起，NEOCC通过专用门户网站（https://neo.ssa.esa.int/）提供近地天体相关信息。自运行阶段启动以来，该中心在软件、数据内容及门户网站方面实施了多项开发与改进。其中一项重要升级是，NEOCC现已通过新开发的轨道确定与撞击监测系统Aegis独立提供数据。由Aegis计算的所有数据均通过NEOCC门户网站公开发布，同时Aegis也用于维护该中心提供的所有主要服务。最重要的服务包括：所有已知小行星的轨道目录、未来可能撞击地球的列表（亦称风险列表）、即将发生的近距离接近列表、一组图形化工具包，以及按需星历服务。多项服务还通过专用应用程序接口（API）提供，可用于自动检索数据。本文概述了Aegis软件中实施的算法，并总结了由Aegis支持的NEOCC所提供服务。},
  file = {/home/ouyangjiahong/Zotero/storage/N69CPNCL/Fenucci 等 - 2024 - The aegis orbit determination and impact monitoring system and services of the ESA NEOCC web portal.pdf}
}


@article{bakkerRelativeEquilibriaPeriodic2023,
  title = {Relative Equilibria and Periodic Orbits in a Circular Planar (2+2)-Body Problem},
  author = {Bakker, Lennard F. and Freeman, Nicholas J.},
  year = 2023,
  month = dec,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {135},
  number = {6},
  pages = {58},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10173-0},
  urldate = {2025-10-01},
  abstract = {We present a planar four-body model, the Circular Planar (2+2)-Body Problem, for the motion of two asteroids (having small but positive masses) moving under the gravitational attraction of each other and under the gravitational attraction of two primaries (with masses much larger than the two smaller mass bodies) moving in uniform circular motion about their center of mass. We show the Circular Planar (2+2)-Body Problem has (at least) 6 relative equilibria and (at least) 10 one-parameter families of periodic orbits, two of which are of Hill-type. The existence of six relative equilibria and eight one-parameter families of periodic orbits is obtained by a reduction of the Circular Planar (2+2)-Body Problem in which the primaries have equal mass, the asteroids have equal mass, and the positions of the asteroids are symmetric with respect to the origin. The remaining two one-parameter families of periodic orbits, which are of comet-type, are obtained directly in the Circular Planar (2+2)-Body Problem.},
  langid = {english},
  annotation = {titleTranslation: 圆型平面(2+2)体问题中的相对平衡与周期轨道\\
abstractTranslation: 我们提出了一个平面四体模型，即 Circular Planar (2+2)-Body Problem，用于描述两颗小行星（具有小但为正的质量）在两个主天体（质量远大于两颗小行星）的引力作用下以及彼此之间的引力作用下的运动，其中两个主天体绕其质心做匀速圆周运动。我们证明了 Circular Planar (2+2)-Body Problem 至少存在6个相对平衡点和至少10个单参数周期轨道族，其中两个属于希尔型。通过约化，当主天体质量相等、小行星质量相等且小行星位置关于原点对称时，得到了其中6个相对平衡点和8个单参数周期轨道族。其余两个单参数周期轨道族属于彗星型，直接在 Circular Planar (2+2)-Body Problem 中得出},
  file = {/home/ouyangjiahong/Zotero/storage/YPAVZ4GB/Bakker和Freeman - 2023 - Relative equilibria and periodic orbits in a circular planar (2+2)-body problem.pdf}
}


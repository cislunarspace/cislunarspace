@article{shastiRobustDistributedControl2017,
  title = {Robust Distributed Control of Spacecraft Formation Flying with Adaptive Network Topology},
  author = {Shasti, Behrouz and Alasty, Aria and Assadian, Nima},
  year = 2017,
  month = jul,
  journal = {Acta Astronautica},
  volume = {136},
  pages = {281--296},
  issn = {00945765},
  doi = {10.1016/j.actaastro.2017.03.001},
  urldate = {2025-12-01},
  abstract = {In this study, the distributed six degree-of-freedom (6-DOF) coordinated control of spacecraft formation flying in low earth orbit (LEO) has been investigated. For this purpose, an accurate coupled translational and attitude relative dynamics model of the spacecraft with respect to the reference orbit (virtual leader) is presented by considering the most effective perturbation acceleration forces on LEO satellites, i.e. the second zonal harmonic and the atmospheric drag. Subsequently, the 6-DOF coordinated control of spacecraft in formation is studied. During the mission, the spacecraft communicate with each other through a switching network topology in which the weights of its graph Laplacian matrix change adaptively based on a distance-based connectivity function between neighboring agents. Because some of the dynamical system parameters such as spacecraft masses and moments of inertia may vary with time, an adaptive law is developed to estimate the parameter values during the mission. Furthermore, for the case that there is no knowledge of the unknown and time-varying parameters of the system, a robust controller has been developed. It is proved that the stability of the closed-loop system coupled with adaptation in network topology structure and optimality and robustness in control is guaranteed by the robust contraction analysis as an incremental stability method for multiple synchronized systems. The simulation results show the effectiveness of each control method in the presence of uncertainties and parameter variations. The adaptive and robust controllers show their superiority in reducing the state error integral as well as decreasing the control effort and settling time.},
  langid = {english},
  annotation = {titleTranslation: 具有自适应网络拓扑的航天器编队飞行鲁棒分布式控制\\
abstractTranslation: 在本研究中，针对低地球轨道（LEO）航天器编队飞行的分布式六自由度（6-DOF）协调控制问题进行了探讨。为此，通过考虑LEO卫星上最具影响力的摄动加速度力（即第二阶带谐项和大气阻力），建立了航天器相对于参考轨道（虚拟领航者）的精确耦合平移与姿态相对动力学模型。随后，研究了编队航天器的六自由度协调控制。在任务过程中，航天器通过切换网络拓扑进行通信，其中图拉普拉斯矩阵的权重基于相邻代理之间的距离连通函数自适应变化。由于部分动力学系统参数（如航天器质量与转动惯量）可能随时间变化，本文开发了一种自适应律，用于在任务期间估计参数值。此外，针对系统未知时变参数完全未知的情况，设计了鲁棒控制器。通过鲁棒收缩分析（一种针对多同步系统的增量稳定性方法），证明了闭环系统在拓扑结构自适应、控制最优性与鲁棒性耦合下的稳定性。仿真结果表明，在存在不确定性和参数变化的情况下，每种控制方法均有效。自适应控制器与鲁棒控制器在减小状态误差积分、降低控制能耗以及缩短调节时间方面展现出优越性。},
  file = {/home/ouyangjiahong/Zotero/storage/GKAXIGSQ/Shasti 等 - 2017 - Robust distributed control of spacecraft formation flying with adaptive network topology.pdf}
}


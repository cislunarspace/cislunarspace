  doi = {10.1016/j.ifacol.2025.11.499},
  urldate = {2025-12-20},
  abstract = {Maneuver detection of space objects within the cislunar domain is crucial for the safety and situational awareness of deep space exploration missions. However, current publicly reported research primarily focuses on maneuver detection for near-Earth objects under two-body dynamical models; dedicated studies for the cislunar environment, characterized by its significant three-body gravitational dynamics, remain notably absent. Due to the substantial differences in dynamical models, the applicability of existing methods in the cislunar regime is unclear, necessitating targeted research. This paper proposes a novel method for detecting and reconstructing impulsive maneuvers of cislunar objects, combining a two-dimensional Convolutional Neural Network (2DCNN) with forward-backward numerical integration. First, a windowing and slicing strategy pre-processes the observational sequence, enabling the 2DCNN to rapidly identify time windows containing potential maneuvers. Subsequently, within detected windows, forward and backward integration are employed to precisely reconstruct the maneuver time, location, and velocity change magnitude. The simulation results demonstrate that the proposed maneuver detection method achieves great performance on the noisy data test set, with an F1 score of 91.32\%, precision of 99.47\%, and recall of 84.40\%. Additionally, this method offers low computational cost for detection and high -accuracy maneuver information reconstruction.},
  langid = {english},
  keywords = {Cislunar Space,Convolutional Neural Network,Forward-backward integration,Maneuver detection,Maneuver reconstruction},
  annotation = {abstractTranslation: 地月空间内航天器的机动探测对于保障深空间探测任务的安全与态势感知至关重要。然而，当前公开报道的研究主要集中于二体动力学模型下的近地目标机动探测；针对具有显著三体引力动力学特征的地月空间环境的专项研究仍明显缺失。由于动力学模型存在本质差异，现有方法在地月空间区域的适用性尚不明确，亟需开展针对性研究。本文提出一种结合二维卷积神经网络与前后向数值积分的地月目标脉冲式机动探测与重构新方法。首先，通过窗口化与切片策略对观测序列进行预处理，使二维卷积神经网络能够快速识别包含潜在机动的时间窗口；随后，在检测到的窗口内运用前向与后向积分，精确重构机动时刻、位置及速度变化量。仿真结果表明，所提出的机动探测方法在含噪声数据测试集上表现优异，F1分数达91.32\%，精确率为99.47\%，召回率为84.40\%。此外，该方法具备较低的探测计算成本与高精度的机动信息重构能力。\\
titleTranslation: 基于卷积神经网络的地月空间目标脉冲机动检测},
  file = {/home/ouyangjiahong/Zotero/storage/2L4W78KG/Zhang和Dang - 2025 - Impulsive maneuver detection of cislunar space objects based on convolutional neural network.pdf;/home/ouyangjiahong/Zotero/storage/HIK9M93K/S2405896325021779.html}
}

@article{ZhangJiaChengJiYuZhiZhenWangLuoDeKongJianMuBiaoBianLiJiaoHuiXuLieGuiHua2023,
  title = {{基于指针网络的空间目标遍历交会序列规划}},
  author = {{张嘉城} and {朱阅訸} and {罗亚中}},
  year = 2023,
  journal = {航空学报},
  volume = {44},
  number = {15},
  pages = {420--432},
  issn = {1000-6893},
  urldate = {2026-01-27},
  abstract = {单航天器对多目标的遍历交会任务规划是一类复杂度极高的混合整数优化问题，涉及顶层交会序列组合优化和底层飞行轨迹连续优化。现有方法将离散变量和连续变量一体优化，计算效率低且难以求得最优序列。提出了一种基于指针网络的多目标遍历交会序列规划方法，可快速获得最优序列。首先，构建了多目标遍历交会序列规划的神经网络模型，作为序列规划的决策智能体。其次，提出了一种基于异步优势函数行动者-评论家算法的无监督学习方法，避免了求解训练标签数据的计算开销。最后，为提高奖励函数的计算效率，在训练中嵌入了一种快速估计实际转移成本的近似方法。应用算例分析表明：所提出的训练方法可显著提高训练效率，经训练的决策智能体能够以超过88.7\%的正确率快速求得最优序列。},
  langid = {chinese},
  annotation = {original-container-title: Acta Aeronautica et Astronautica Sinica\\
AIF: 2.037\\
album: 工程科技II辑;信息科技\\

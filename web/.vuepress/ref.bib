@inproceedings{ottRangeBiasesMeasurement2022,
  title = {Range Biases, Measurement Noise, and Perilune Accuracy in near Rectilinear Halo Orbit Navigation},
  booktitle = {{{AIAA SciTech Forum}} and {{Exposition}}},
  author = {Ott, Connor and Bolliger, Matthew and Thompson, Michael and R{\'e}, Nathan P. and Davis, Diane C.},
  year = 2022,
  address = {San Diego, CA, United states},
  doi = {10.2514/6.2022-0999},
  abstract = {The characteristics of Near Rectilinear Halo Orbits (NRHOs) that make them desirable for cislunar operations also introduce navigation challenges. The orbits large apolune distance provides excellent coverage of the lunar south pole, and its Earth-facing plane ensures constant line-of-sight with ground stations. However, the nearly perpendicular motion to the Earth-spacecraft line results in poor observability of range biases, and the necessarily low perilune altitude results in highly dynamic and sensitive perilune passages. Preliminary work indicates that range biases and state estimates near apolune and perilune are unintuitively related to range and range-rate measurement quality. This study seeks to clarify the relationship between measurements and navigation solutions, as well as to provide insight into filter designs that are more suitable for NRHO navigation operations.},
  langid = {english},
  annotation = {titleTranslation: 近直线晕轨道导航中的距离偏差、测量噪声与近月点精度}
}

@article{oueLowthrustManyrevolutionTransfer2025,
  title = {Low-Thrust Many-Revolution Transfer between near Rectilinear Halo Orbit and Low Lunar Orbit Using Hybrid Differential Dynamic Programming},
  author = {Oue, Kohei and Ozaki, Naoya and Chujo, Toshihiro},
  year = 2025,
  journal = {arXiv},
  abstract = {Low-thrust, many-revolution transfers between near-rectilinear halo orbits and low lunar orbits are challenging due to the many-revolutions and is further complicated by three-body perturbation. To address these challenges, we extend hybrid differential dynamic programming by enhancing with a continuation of dynamical system. The optimization begins with the Sundman-transformed two-body problem and gradually transitions to the Sundman-transformed circular restricted three-body problem expressed in the moon-centered inertial frame. Numerical examples demonstrate the robust convergence of our method, where optimal transfers from low lunar orbit to near-rectilinear halo orbit are obtained with a poor initial guess of low lunar orbit.},
  langid = {english},
  annotation = {titleTranslation: 采用混合微分动态规划实现近直线晕轨道与低月球轨道间的低推力多圈转移\\
abstractTranslation: 低推力、多圈转移在近直线晕轨道与低月球轨道之间具有挑战性，因为多圈特性且受到三体摄动的进一步复杂化。为解决这些挑战，我们通过引入动力学系统的延拓来扩展混合差分动态规划。优化从Sundman变换的二体问题开始，并逐渐过渡到在月球中心惯性系中表示的Sundman变换的圆形限制性三体问题。数值算例证明了我们方法的稳健收敛性，其中从低月球轨道到近直线晕轨道的最优转移是在一个较差的初始猜测下获得的}
}

@phdthesis{outlandApproachesRendezvousTrajectory2025,
  type = {硕士论文},
  title = {Approaches to Rendezvous Trajectory Design Problems with Applications to the Cislunar Domain},
  author = {Outland, Bennet},
  year = 2025,
  journal = {ProQuest Dissertations and Theses},
  abstract = {This work examines algorithms for performing autonomous rendezvous where a controlled ``deputy'' agent performs rendezvous missions with an uncontrolled ``chief'' agent. Algorithms are designed to solve four problems contained in this thesis: a two point boundary value problem (TPBVP), an optimal rendezvous time problem, a trajectory tracking problem, and a two point boundary value problem under uncertainty. All of the aforementioned problems have highly nonlinear dynamical constraints with the objective of minimizing control expenditure to reach a terminal constraint. The difficulty in these problems are primarily in the form of restrictive constraints on the actuators, determining if a rendezvous is feasible, and designing the trajectory under nonlinear differential constraints. For the final problem, there is the difficulty in doing so under measurement uncertainty. These problems are solved through utilizing chief agent trajectory forecasting, determining adequate warm starting conditions, and nonlinear optimization schemes. These algorithms are then applied to a deputy satellite performing rendezvous maneuvers with a chief satellite in cislunar space, the region between the Earth and the Moon. The circular restricted three-body problem (CR3BP) is used as a model of the system dynamics for the deputy and chief. Numerical examples are utilized to demonstrate the effectiveness of the algorithms designed in this work.},
  isbn = {979-8-3148-5156-2},
  langid = {english},
  school = {South Dakota School of Mines and Technology},
  keywords = {0405:Mathematics,0538:Aerospace engineering,0799:Remote sensing,0984:Computer science,Aerospace engineering,Circular restricted three-body problem,Computer science,Koopman operator theory,Mathematics,Numerical optimization,Remote sensing,Stochastic optimization,Trajectory design},
  annotation = {titleTranslation: 地月空间交会轨迹设计方法及其应用},
  file = {/home/ouyangjiahong/Zotero/storage/XXZF5P89/Outland - 2025 - Approaches to rendezvous trajectory design problems with applications to the cislunar domain.pdf}
}


@article{shethFifthOrderSolution2021,
  title = {Fifth Order Solution of Halo Orbits via {{Lindstedt}}--{{Poincar\'e}} Technique and Differential Correction Method},
  author = {Sheth, Dhwani and Thomas, V. O. and Abouelmagd, Elbaz I. and Srivastava, Vineet K.},
  year = 2021,
  month = aug,
  journal = {New Astronomy},
  volume = {87},
  pages = {101585},
  issn = {1384-1076},
  doi = {10.1016/j.newast.2021.101585},
  urldate = {2026-04-02},
  abstract = {In the frame work of the perturbed restricted three-body problem, the solutions of halo orbits are developed up to fifth order approximation by using Lindstedt--Poincar\'e technique. The effect of oblateness of the more massive primary on the size, location and period of halo orbits around L1 and L2 are studied by considering the Earth--Moon system. Due to oblateness of the Earth, halo orbits around L1 and L2 enlarge and move towards the Moon. Also, the period of halo orbits around L1 and L2 decreases. Numerical solution for halo orbits around L1 and L2 in the Sun--Earth system is obtained by using the differential correction method for different values of radiation pressure and oblateness. The separation between the orbits obtained using fourth and fifth order Lindstedt--Poincar\'e method as well as differential correction method is found to be less than the separation between the orbits obtained using third and fourth order Lindstedt--Paincar\'e as well as differential correction method. This indicates that as the order of the solution increases the separation between consecutive solution decreases leading to more accurate solution.},
  langid = {american},
  keywords = {Differential correction method,Halo orbits,Lindstedt-Poincare method,Restricted three-body problem},
  annotation = {titleTranslation: 基于Lindstedt--Poincar\'e技巧和微分修正法的晕轨道五阶解\\
abstractTranslation: 在受摄限制性三体问题的框架下，利用Lindstedt--Poincar\'e方法推导了晕轨道解至五阶近似。通过考虑地月系统，研究了较大主天体扁率对L1和L2点附近晕轨道大小、位置及周期的影响。由于地球扁率，L1和L2点附近的晕轨道扩大并向月球移动。同时，L1和L2点附近晕轨道的周期减小。针对太阳--地球系统，利用微分校正方法，在不同辐射压力和扁率参数下得到了L1和L2点附近晕轨道的数值解。研究发现，采用四阶和五阶Lindstedt--Poincar\'e方法以及微分校正方法所得轨道之间的间距，小于采用三阶和四阶Lindstedt--Poincar\'e方法以及微分校正方法所得轨道之间的间距。这表明随着解阶数的增加，相邻解之间的间距减小，从而获得更精确的解}
}


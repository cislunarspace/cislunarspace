@article{zengFreeForcedInclinations2024,
  title = {Free and Forced Inclinations of Orbits Perturbed by the Central Body's Oblateness and an Inclined Third Body},
  author = {Zeng, Qinggen and Jiang, Yu and Nie, Tao and Liu, Xiaodong},
  year = 2024,
  month = jun,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {3},
  pages = {16--37},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-024-10187-2},
  urldate = {2025-10-01},
  abstract = {The effect of inclined third-body perturbation on the perturbed body's inclination evolution has been investigated extensively. However, under various initial orbital elements, the exact effect of the J2 perturbation and the inclined third-body perturbation on perturbed body's inclination is still an open problem. In this paper, we use a simplified model for long-term orbital variations to analyze the free and forced inclinations for almost circular orbits with low inclinations. We analyze the influence of the J2 perturbation on the inclination evolution under various initial orbital elements. The results show that the J2 perturbation consistently decreases the maximum value of the inclination. Besides, the J2 perturbation either decreases the amplitude of the inclination's oscillation, or enables the perturbed body to orbit closer to the equator of the central body. These effects enable the objects with initially low inclinations to maintain their orbits near the equator of the central body for a long time. The results of the study are applied to circum-Jovian orbits and the triple asteroid system 87 Sylvia.},
  langid = {english},
  annotation = {titleTranslation: 轨道的自由和强迫倾角受到中心体的扁率和倾斜的第三体的扰动。\\
abstractTranslation: 倾斜第三体摄动对受摄体倾角演化的影响已得到广泛研究。然而，在不同初始轨道根数下，J2摄动与倾斜第三体摄动对受摄体倾角的确切影响仍是一个开放性问题。本文采用长期轨道变化的简化模型，分析近圆低倾角轨道的自由倾角和受迫倾角。我们研究了不同初始轨道根数下J2摄动对倾角演化的影响。结果表明，J2摄动始终降低倾角的最大值。此外，J2摄动要么减小倾角振荡的幅度，要么使受摄体更接近中心天体赤道运行。这些效应使得初始低倾角天体能够长时间维持在中心天体赤道附近的轨道上。研究结果应用于木星环绕轨道及三合小行星系统87 Sylvia},
  file = {/home/ouyangjiahong/Zotero/storage/VIPA9HBW/Zeng 等 - 2024 - Free and forced inclinations of orbits perturbed by the central body’s oblateness and an inclined th.pdf}
}

@article{zengFurtherAdvancesStaging2023,
  title = {Further Advances for Staging Orbits of Manned Lunar Exploration Mission},
  author = {Zeng, Hao and Li, Zhaoyu and Xu, Rui and Peng, Kun and Wang, Ping},
  year = 2023,
  journal = {Acta Astronautica},
  volume = {Vol.204},
  number = {Suppl C},
  pages = {281--293},
  issn = {0094-5765},
  doi = {10.1016/j.actaastro.2023.01.001},
  abstract = {With the increasing demand for manned lunar exploration and deep-space exploration missions, the application value of the three-body orbit in cislunar space becomes increasingly prominent due to its special orbital characteristic. The efficient round-trip versions for manned missions of both the nominal fuel-optimal and emergency transfers between NRHO and the Moon are exploited deeply. The collocation method and indirect optimization technique with constraint gradients are utilized in conjunction with the features of the NRHO configuration to increase the algorithm's accuracy and speed. The required initial value and suitable collocation point can be determined quickly based on a global search strategy and Lambert algorithm. To highlight the effectivity of the design scheme and aim at global lunar surface exploration, typical scenarios of lunar sites at different latitudes and longitudes are investigated with various time of flight, which show that the difference of fuel consumption varies from a few kilograms to hundreds of kilograms. Meanwhile, the relations among Moon landing sites, transition time and fuel consumption are analyzed and the advantages and disadvantages of NRHO in lunar exploration are compared. The design results have some reference value for the lunar landing vehicle's deployment in the near-Moon space, as well as the round-trip transfer mission and key parameter selection.},
  langid = {english},
  keywords = {Manned lunar exploration mission,NRHO orbit,Round-trip transfers,Trajectory optimization},
  annotation = {titleTranslation: 载人月球探测任务停泊轨道技术取得新进展\\
abstractTranslation: 随着载人月球探测和深空探测任务需求的日益增长，地月空间三体轨道因其特殊的轨道特性，其应用价值愈发凸显。针对NRHO与月球之间的标称燃料最优转移及应急往返转移，深入研究了适用于载人任务的高效往返方案。结合NRHO构型特点，采用配点法与带约束梯度的间接优化技术，提高了算法的精度与速度。基于全局搜索策略和Lambert算法，可快速确定所需初值与合适配点。为突出设计方案的实效性并面向全球月表探测，研究了不同纬度、经度月面站点在多种飞行时间下的典型场景，结果表明燃料消耗差异从几公斤到数百公斤不等。同时，分析了月面着陆点、过渡时间与燃料消耗之间的关系，并比较了NRHO在月球探测中的优缺点。该设计结果对月面着陆器在近月空间的部署以及往返转移任务与关键参数选择具有一定的参考价值。}
}

@article{zengGeneralizedFlybyTrajectories2016,
  title = {Generalized Flyby Trajectories around Elongated Minor Celestial Bodies as a Rotating Mass Dipole},
  author = {Zeng, Xiangyuan and Fang, Baodong and Li, Junfeng and Yu, Yang},
  year = 2016,
  journal = {力学学报(英文版)},
  volume = {第32卷},
  number = {第3期},
  pages = {535--545},
  abstract = {The aim of this paper is to understand the common characteristics of the generalized flyby trajectory around natural elongated bodies. Such flyby trajectories provide a short-term mechanism to clear away vicinal objects or temporally capture ejecta into circling orbits. The gravitational potential of elongated bodies is described by a unified approximate model, i.e., the rotating mass dipole which is two point masses connected with a constant massless rod The energy power is used to illustrate the flyby effect in terms of the instantaneous orbital energy. The essential of the single flyby trajectory is studied analytically, and the relationship between the flyby trajectory and its Jacobi integral is also illustrated. Sample trajectories are given to show the variational trend of the energy increment with respect to differen orbital periapsides. The distribution of natural ejecting orbits is presented by varying the parameters of the approximate model.},
  langid = {english},
  keywords = {rotating;elongated;trajectory;approximate;dipole;capture;illustrate;unified;variational;elliptical},
  annotation = {titleTranslation: 围绕细长小天体作为旋转质量偶极子的广义飞越轨道\\
abstractTranslation: 本文旨在理解自然细长天体周围广义飞越轨迹的共性特征。此类飞越轨迹提供了一种短期机制，用于清除邻近物体，或临时将抛射物捕获至环绕轨道。细长天体的引力势由统一近似模型描述，即旋转质量偶极子------由一根无质量刚性杆连接的两个质点构成。能量功率被用于以瞬时轨道能量的形式阐释飞越效应。对单次飞越轨迹的本质进行了分析研究，并揭示了飞越轨迹与其雅可比积分之间的关系。通过示例轨迹展示了能量增量随不同轨道近心点变化的趋势。通过改变近似模型的参数，给出了自然逃逸轨道的分布。}
}

@article{zengResearchApplicationEarthmoon2020,
  title = {Research on Application of {{Earth-moon NRHO}} and {{DRO}} for Lunar Exploration},
  author = {Zeng, Hao and Li, Zhaoyu and Peng, Kun and Wang, Ping and Huang, Zhen},
  year = 2020,
  journal = {Yuhang Xuebao/Journal of Astronautics},
  volume = {Vol.41},
  number = {No.7},
  pages = {910},
  issn = {1000-1328},
  abstract = {Researching on the application of NRHO and DRO in the Earth-Moon system on low-energy round-trip transfer for Moon exploration, the paper combines the flyby technique and hybrid optimization technology, analyzes systematically the influence of different target orbits and different flyby azimuth on the key parameters such as flight time and fuel consumption, and provides the selection strategy for the initial value of round-trip orbit design. For the problem of initial value guess, the genetic algorithm and Lambert transfer are used to determine quickly the initial value that satisfies the constraints. Considering multiple constraints at perilune and perigee simultaneously, the fuel optimal round-trip orbit from the Earth is studied further based on the sequential quadratic programming algorithm and multiple shooting method, and the constraint equation analytic gradient is derived to improve the design efficiency. Finally, the variation characteristic of perilune attitude, transfer time and fuel consumption of different target orbits are analyzed, which is of great reference value for round-trip transfer design and parameter selection considering lunar flyby.},
  langid = {english},
  keywords = {Hybrid optimization,Initial value problem,Lunar Exploration,Lunar flyby,Round-trip orbit},
  annotation = {titleTranslation: 地月NRHO与DRO在月球探测中的应用研究\\
abstractTranslation: 针对NRHO与DRO在地月系统中月球探测低能耗往返转移的应用研究，本文结合飞越技术与混合优化技术，系统分析了不同目标轨道及不同飞越方位角对飞行时间、燃料消耗等关键参数的影响，并给出了往返轨道设计初值的选取策略。针对初值猜测问题，采用遗传算法与Lambert转移快速确定满足约束条件的初值。同时考虑近月点与近地点的多重约束，基于序列二次规划算法与多重打靶法进一步研究了从地球出发的燃料最优往返轨道，并推导了约束方程解析梯度以提高设计效率。最后，分析了不同目标轨道的近月点姿态、转移时间及燃料消耗的变化特性，这对考虑月球飞越的往返转移设计与参数选取具有重要参考价值。}
}


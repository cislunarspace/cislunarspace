@article{WuWeiRenShenKongTanCeZhiQianYanKeXueWenTiTanXi2023,
  title = {{深空探测之前沿科学问题探析}},
  author = {{吴伟仁} and {王赤} and {刘洋} and {秦礼萍} and {林巍} and {叶生毅} and {李晖} and {沈芳} and {张哲}},

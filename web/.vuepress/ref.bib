@article{liuSixdegreeoffreedomMotionState2025,
  title = {Six-Degree-of-Freedom Motion State Prediction of Spacecraft near the Libration Point of {{Earth-moon}} System Based on Koopman Operator},
  author = {Liu, Wei and Luo, JianJun},
  year = 2025,
  journal = {Scientia Sinica: Physica, Mechanica Et Astronomica},
  volume = {Vol.55},
  number = {No.9},
  issn = {1674-7275},
  abstract = {Attitude-orbit maintenance, fuel optimization, and collision avoidance of the libration point spacecraft all rely on the effective prediction of their motion states. However, the instability and orbit-attitude coupling in the three-body problem pose significant challenges to state prediction. To address the need for six-degree-of-freedom motion state prediction of large spacecraft near the libration point, a linear predictor construction method based on the Koopman operator is proposed. First, a circular restricted three-body orbit-attitude motion model for large spacecraft near the libration point is established. Then, based on the theory of the Koopman operator, the motion of the spacecraft near the libration point is sampled, and a six-degree-of-freedom linear predictor for the spacecraft's motion state is constructed. Finally, the effectiveness of the predictor is analyzed in different regions of the near-rectilinear Halo orbit using simulation data. The simulation results show that the Koopman operator-based predictor outperforms the prediction method based on the local linearization of the periodic solution in both orbital motion and attitude motion prediction. Moreover, despite the strong instability in the perilune region, the proposed predictor can still provide reasonable predictions of the motion state.},
  langid = {english},
  keywords = {Koopman operator,near-rectilinear Halo orbit,restricted three body problem,state prediction,the libration point},
  annotation = {titleTranslation: 基于Koopman算子的地月系平动点附近航天器六自由度运动状态预测\\
abstractTranslation: 平动点航天器的姿轨维持、燃料优化及碰撞规避均依赖于对其运动状态的有效预测。然而，三体问题中的不稳定性和轨道-姿态耦合给状态预测带来了巨大挑战。针对大型航天器在平动点附近六自由度运动状态预测的需求，提出了一种基于Koopman算子的线性预测器构建方法。首先，建立了大型航天器在平动点附近的圆形限制性三体轨道-姿态运动模型。然后，基于Koopman算子理论，对航天器在平动点附近的运动进行采样，构建了航天器运动状态的六自由度线性预测器。最后，利用仿真数据分析了该预测器在近直线Halo轨道不同区域的有效性。仿真结果表明，基于Koopman算子的预测器在轨道运动与姿态运动预测方面均优于基于周期解局部线性化的预测方法。此外，尽管近月点区域存在强不稳定性，所提出的预测器仍能提供合理的运动状态预测。}
}


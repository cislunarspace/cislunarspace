@article{izzoSurveyArtificialIntelligence2019,
  title = {A Survey on Artificial Intelligence Trends in Spacecraft Guidance Dynamics and Control},
  author = {Izzo, Dario and M{\"a}rtens, Marcus and Pan, Binfeng},
  year = 2019,

@article{YinJianFengJiDiXuanTingHangTianQiGuiDaoDongLiXueTeXingYuGuiDaoWeiChi2018,
  title = {极地悬停航天器轨道动力学特性与轨道维持},
  author = {{殷建丰} and {张冉} and {张相宇}},

@article{xuOrbitDeterminationEarthmoon2024,
  title = {Orbit Determination of {{Earth-moon}} Libration Point Navigation Constellation Based on Inter-Satellite Links},
  author = {Xu, Zheyu and Shao, Kai and Gu, Defeng and Tong, Lisheng and Du, Lan and Wei, Chunbo and An, Zicong and Zhu, Jubo},
  year = 2024,
  month = jul,
  journal = {Advances in Space Research},
  volume = {74},
  number = {2},
  pages = {937--948},
  issn = {0273-1177},
  doi = {10.1016/j.asr.2024.04.002},
  urldate = {2026-03-01},
  abstract = {Earth-Moon libration point navigation constellation has a merit of fully covering the cislunar space and providing navigation services with merely a small number of satellites. Furthermore, this type of constellation itself can achieve orbit determination by using only its Inter-satellite links (ISL) owing to the well-known gravitational asymmetry near the libration points. This paper adopts a representative four-satellite navigation constellation including three satellites located near the libration point L3, L4, L5, and an extra one in Distant Retrograde Orbit (DRO), and studies the orbit determination accuracy of the constellation under two conditions: establishing ISLs within itself (called Solely libration point satellites) and establishing additional ISLs with BeiDou Navigation Satellite System (BDS) (called Libration ~+~BeiDou satellites). The simulation results indicate that, for the Solely libration point satellites scenario with the 1~m range error and solar radiation pressure (SRP) error with the level of 10\% deviation between ball model and macro model, the final orbit accuracies for L3, L4, L5, and DRO satellites can respectively achieve 11.3~m, 12.7~m, 12.6~m, and 7.3~m. Reducing the link interval can significantly shorten the arc length to achieve final accuracy, whileas it has less impact on the final orbital accuracy. When the link interval is set as 240, 60, 10, and 2~min, the arc lengths at the final accuracy of better than 15~m are about 35, 29, 23, and 20~days, respectively. To balance the communication burden and the orbit determination arc length, the recommended ISL building interval is 10~min. Errors coming from range measurement model and dynamic model, in addition, are key factors in orbit determination, which can result in meters to tens of meters of orbital accuracy. For the Libration ~+~BeiDou satellites scenario, the augmented ISLs to BDS can substantially improve constellation orbital accuracy and shorten the orbit determination arc length. When the DRO satellite attached to the Geostationary Earth Orbit (GEO), Inclined Geosynchronous Orbit (IGSO), and Medium Earth Orbit (MEO) satellites of BDS respectively, the improved accuracy are 37.1\%, 61.2\%, and 42.2\%, while the shortened arc length are 20.1\%, 28.3\%, and 28.1\%, respectively. The research findings presented in this paper can serve as a reference for the construction and assessment of navigation constellations in the Earth-Moon system.},
  langid = {english},
  keywords = {BDS,Earth-Moon Libration Point Navigation Constellation,Inter-satellite Link,Orbit Determination},
  annotation = {titleTranslation: 基于星间链路的地月平动点导航星座定轨研究\\
abstractTranslation: 地月平动点导航星座具有仅用少量卫星即可实现地月空间全覆盖并提供导航服务的优势。此外，由于平动点附近著名的引力不对称性，此类星座仅利用星间链路（ISL）即可自主完成轨道确定。本文采用一个具有代表性的四星导航星座，包括三颗分别位于平动点L3、L4、L5的卫星和一颗位于 distant retrograde orbit (DRO) 的卫星，研究了在两种条件下的星座轨道确定精度：仅建立星座内部星间链路（称为纯平动点卫星）以及额外建立与北斗卫星导航系统（BDS）的星间链路（称为平动点+北斗卫星）。仿真结果表明，对于纯平动点卫星场景，当测距误差为1米且太阳光压（SRP）误差达到球模型与宏模型偏差10\%水平时，L3、L4、L5和DRO卫星的最终轨道精度分别可达11.3米、12.7米、12.6米和7.3米。减小链路间隔可显著缩短达到最终精度的弧长，但对最终轨道精度影响较小。当链路间隔设置为240分钟、60分钟、10分钟和2分钟时，达到优于15米最终精度所需的弧长分别约为35天、29天、23天和20天。为平衡通信负担与轨道确定弧长，建议星间链路建立间隔为10分钟。此外，来自测距模型和动力学模型的误差是轨道确定的关键因素，可导致米级至数十米级的轨道精度。对于平动点+北斗卫星场景，与BDS增强的星间链路可显著提升星座轨道精度并缩短轨道确定弧长。当DRO卫星分别与北斗的地球静止轨道（GEO）、倾斜地球同步轨道（IGSO）和中地球轨道（MEO）卫星建立链路时，精度分别提升37.1\%、61.2\%和42.2\%，弧长分别缩短20.1\%、28.3\%和28.1\%。本文研究成果可为地月系统导航星座的构建与评估提供参考},
  file = {/home/ouyangjiahong/Zotero/storage/9BZJBPRT/Xu 等 - 2024 - Orbit determination of Earth-moon libration point navigation constellation based on inter-satellite.pdf;/home/ouyangjiahong/Zotero/storage/4G8X7N9W/S027311772400334X.html}
}

@article{xuResearchSlidingwindowBatch2025,
  title = {Research on Sliding-Window Batch Processing Orbit Determination Algorithm for Satellite-to-Satellite Tracking},
  author = {Xu, Yingjie and Feng, Xuan and Li, Shuanglin and Pu, Jinghui and Chen, Shixu and Wang, Wenbin},
  year = 2025,
  journal = {Aerospace},
  volume = {Vol.12},
  number = {No.8},
  pages = {662},
  doi = {10.3390/aerospace12080662},
  abstract = {In response to the increasing demand for high-precision navigation of satellites operating in the cislunar space, this study introduces an onboard orbit determination algorithm considering both convergence and computational efficiency, referred to as the Sliding-Window Batch Processing (SWBP) algorithm. This algorithm combines the strengths of data batch processing and the sequential processing algorithm, utilizing measurement data from multiple historical and current epochs to update the orbit state of the current epoch. This algorithm facilitates rapid convergence in orbit determination, even in instances where the initial orbit error is large. The SWBP algorithm has been used to evaluate the navigation performance in the Distant Retrograde Orbit (DRO) and the Earth--Moon transfer orbit. The scenario involves a low-Earth-orbit (LEO) satellite establishing satellite-to-satellite tracking (SST) links with both a DRO satellite and an Earth--Moon transfer satellite. The LEO satellite can determine its orbit accurately by receiving GNSS signals. The experiments show that the DRO satellite achieves an orbit determination accuracy of 100 m within 100 h under an initial position error of 500 km, and the transfer orbit satellite reaches an orbit determination accuracy of 600 m within 3.5 h under an initial position error of 100 km. When the Earth--Moon transfer satellite exhibits a large initial orbital error (on the order of hundreds of kilometers) or the LEO satellite's positional accuracy is degraded, the SWBP algorithm demonstrates superior convergence speed and precision in orbit determination compared to the Extended Kalman Filter (EKF). This confirms the proposed algorithm's capability to handle complex orbital determination scenarios effectively.},
  langid = {english},
  keywords = {Distant Retrograde Orbit (DRO),Earth-Moon space,Earth-Moon transfer orbit,inter-satellite link,Sliding-Window Batch Processing,space-based orbit determination},
  annotation = {titleTranslation: 基于星间链路的滑动窗口批处理定轨算法研究\\
abstractTranslation: 为应对地月空间卫星对高精度导航日益增长的需求，本研究提出了一种兼顾收敛性与计算效率的星载轨道确定算法，即滑动窗口批处理（Sliding-Window Batch Processing, SWBP）算法。该算法融合了数据批处理与序贯处理算法的优势，利用多个历史时刻和当前时刻的测量数据来更新当前时刻的轨道状态。即使在初始轨道误差较大的情况下，该算法也能实现轨道确定的快速收敛。SWBP算法被用于评估远距离逆行轨道（DRO）和地月转移轨道中的导航性能。场景涉及一颗低地球轨道（LEO）卫星，分别与一颗DRO卫星和一颗地月转移卫星建立卫星间跟踪（SST）链路。LEO卫星可通过接收GNSS信号精确确定自身轨道。实验表明，在初始位置误差为500 km的条件下，DRO卫星在100小时内达到100 m的轨道确定精度；而转移轨道卫星在初始位置误差为100 km的条件下，在3.5小时内达到600 m的轨道确定精度。当地月转移卫星存在较大初始轨道误差（数百公里量级）或LEO卫星位置精度下降时，SWBP算法在轨道确定的收敛速度与精度方面均优于扩展卡尔曼滤波（EKF）。这证实了所提算法能够有效应对复杂的轨道确定场景。}
}


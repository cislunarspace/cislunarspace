@article{parkAssessmentDynamicalModels2024,
  title = {Assessment of Dynamical Models for Transitioning from the Circular Restricted Three-Body Problem to an Ephemeris Model with Applications},
  author = {Park, Beom and Howell, Kathleen C.},
  year = 2024,
  month = feb,
  journal = {Celestial Mechanics \& Dynamical Astronomy},
  volume = {136},
  number = {1},
  pages = {6--45},
  issn = {0923-2958, 1572-9478},
  doi = {10.1007/s10569-023-10178-9},
  urldate = {2025-10-01},
  abstract = {While the Circular Restricted Three-Body Problem (CR3BP) provides useful structures for various applications, transitioning the solutions from the CR3BP to a higher-fidelity ephemeris model while maintaining specific characteristics remains non-trivial. An analytical approach is leveraged to provide additional insight on the perturbations that are present in an ephemeris model. For the Earth--Moon CR3BP, pulsation of the Earth--Moon distance and solar gravity are identified as key components contributing to the additional accelerations, where patterns are illustrated through simplified mathematical relationships and graphics. Utilizing these findings, capabilities and limitations of two intermediate models, the Elliptic Restricted Three-Body Problem and the Bi-Circular Restricted Four-Body Problem, are assessed within the context of transitioning from the CR3BP to a realistic ephemeris model. A sample transition process for Earth--Moon L2 halo orbits is provided, leveraging the insight from the proposed analytical approach.},
  langid = {english},
  annotation = {titleTranslation: 从圆形限制性三体问题向星历模型过渡的动力学模型评估及其应用\\
abstractTranslation: 尽管圆型限制性三体问题（CR3BP）为多种应用提供了有用的结构，但将CR3BP的解过渡到更高保真度的星历模型同时保持特定特性仍然是一项艰巨任务。采用分析方法以进一步洞察星历模型中存在的摄动。对于地月CR3BP，地月距离的脉动和太阳引力被识别为导致额外加速度的关键因素，并通过简化的数学关系和图形展示了其模式。利用这些发现，评估了两种中间模型------椭圆型限制性三体问题和双圆型限制性四体问题------在从CR3BP过渡到真实星历模型的过程中的能力与局限性。借助所提出的分析方法，提供了一个地月L2晕轨道的过渡过程示例},
  file = {/home/ouyangjiahong/Zotero/storage/BLX3TBT6/Park和Howell - 2024 - Assessment of dynamical models for transitioning from the circular restricted three-body problem to.pdf}
}


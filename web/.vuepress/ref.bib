@article{elankumaranLeveragingBallisticLunar2025,
  title = {On Leveraging Ballistic Lunar Transfers to Devise Cislunar Transfers from the Lunar Gateway},
  author = {Elankumaran, Kawsihen and Kawaguchi, Junichiro},
  year = 2025,
  journal = {AIAC 2025: 21st Australian International Aerospace Congress},
  pages = {310--315},
  issn = {9781925627909},
  abstract = {The Lunar Gateway to be established as a part of the Artemis program will serve as a platform that supports orbital space missions in the proximity of the Moon. The operational goals of the Gateway may necessitate the deployment of small spacecraft and satellites from the Gateway to other proximal cislunar orbits. To devise energy-efficient cislunar transfers from the Lunar Gateway, it is instructive to utilize combinations of Ballistic Lunar Transfers (BLTs) to develop trajectory sequences in the Sun-Earth-Moon 4-body problem. This paper presents a trajectory sequence for an external cislunar transfer of a small spacecraft deployed from the Gateway to the northern near-Rectilinear Halo Orbit (NRHO), utilizing the dynamical and geometric characteristics of the Sun-Earth-Moon system. The numerical simulations performed of the trajectory segments suggest the utility and viability of this concept.},
  langid = {english},
  annotation = {titleTranslation: 论利用弹道月球转移轨道设计从月球门户出发的地月转移轨道\\
abstractTranslation: 作为Artemis计划一部分的月球门户（Lunar Gateway）将作为支持月球附近轨道空间任务的平台。门户的运行目标可能要求从小型航天器和卫星从门户部署到其他近地月轨道。为了设计从月球门户出发的节能地月转移，利用弹道月球转移（BLTs）的组合在日-地-月四体问题中构建轨迹序列是富有启发性的。本文提出了一种轨迹序列，用于从门户部署的小型航天器向北部的近直线晕轨道（NRHO）进行外部地月转移，充分利用了日-地-月系统的动力学和几何特性。对轨迹段进行的数值模拟表明了这一概念的实用性和可行性。}
}


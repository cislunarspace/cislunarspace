{
  "name": "cislunarspace",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "gen-sidebar": "tsx .vuepress/generate.ts",
    "docs:dev": "npm run gen-sidebar && vuepress dev . --host 0.0.0.0",
    "docs:build": "npm run gen-sidebar && node --max-old-space-size=8192 ./node_modules/vuepress/bin/vuepress.js build . && npm run sync-figures",
    "docs:build:verify-dist": "tsx .vuepress/build/verify-dist.ts",
    "docs:build:measure": "tsx .vuepress/build/measure-build.ts",
    "docs:build:parallel": "npm run gen-sidebar && tsx .vuepress/build/sharded-build.ts",
    "sync-figures": "tsx .vuepress/build/sync-figures.js",
    "check:bilingual": "tsx .vuepress/build/check-bilingual-mirror.ts",
    "check:en-chinese": "tsx .vuepress/build/check-en-chinese.ts",
    "check:links": "tsx .vuepress/build/check-links.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vitest/ui": "^3.1.4",
    "@vuepress/bundler-vite": "2.0.0-rc.27",
    "@vuepress/plugin-back-to-top": "2.0.0-rc.126",
    "@vuepress/plugin-google-analytics": "2.0.0-rc.126",
    "@vuepress/plugin-medium-zoom": "2.0.0-rc.126",
    "@vuepress/plugin-prismjs": "2.0.0-rc.126",
    "@vuepress/plugin-register-components": "2.0.0-rc.126",
    "@vuepress/plugin-search": "^2.0.0-rc.126",
    "@vuepress/plugin-sitemap": "2.0.0-rc.126",
    "@vuepress/theme-default": "2.0.0-rc.126",
    "dotenv": "^17.4.2",
    "happy-dom": "^18.0.1",
    "katex": "^0.16.33",
    "sass-embedded": "^1.87.0",
    "tsx": "^4.19.4",
    "vitest": "^3.1.4",
    "vue": "^3.5.0",
    "vuepress": "2.0.0-rc.27",
    "vuepress-plugin-code-copy": "^1.0.6"
  },
  "dependencies": {
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "citation-js": "^0.7.22",
    "lodash-es": "^4.17.21",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  }
}

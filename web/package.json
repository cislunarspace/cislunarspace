{
  "name": "cislunarspace",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "gen-sidebar": "tsx .vuepress/generate.ts",
    "docs:dev": "npm run gen-sidebar && vuepress dev . --host 0.0.0.0",
    "docs:build": "npm run gen-sidebar && node --max-old-space-size=8192 ./node_modules/vuepress/bin/vuepress.js build . && npm run sync-figures",
    "docs:build:verify-dist": "tsx .vuepress/build/verify-dist.ts",
    "docs:build:measure": "tsx .vuepress/build/measure-build.ts",
    "docs:build:parallel": "npm run gen-sidebar && tsx .vuepress/build/sharded-build.ts",
    "sync-figures": "tsx .vuepress/build/sync-figures.js",
    "check:bilingual": "tsx .vuepress/build/check-bilingual-mirror.ts",
    "check:en-chinese": "tsx .vuepress/build/check-en-chinese.ts",
    "check:links": "tsx .vuepress/build/check-links.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\"",
    "lint:code": "eslint .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "npm run lint:md && npm run lint:code && npm run format:check"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vitest/ui": "^3.1.4",
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-back-to-top": "2.0.0-rc.131",
    "@vuepress/plugin-google-analytics": "2.0.0-rc.130",
    "@vuepress/plugin-medium-zoom": "2.0.0-rc.131",
    "@vuepress/plugin-prismjs": "2.0.0-rc.132",
    "@vuepress/plugin-search": "2.0.0-rc.131",
    "@vuepress/plugin-sitemap": "2.0.0-rc.132",
    "@vuepress/theme-default": "2.0.0-rc.132",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^18.0.1",
    "katex": "^0.16.33",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.19.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.1.4",
    "vue": "^3.5.0",
    "vuepress": "2.0.0-rc.30"
  },
  "dependencies": {
    "@citation-js/plugin-bibtex": "^0.7.21",
    "citation-js": "^0.7.22",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "citation-js@0.7.22": true
  }
}

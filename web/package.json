{
  "name": "cislunarspace",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "gen-sidebar": "tsx .vuepress/gen-sidebar.ts",
    "docs:dev": "npm run gen-sidebar && vuepress dev . --host 0.0.0.0",
    "docs:build": "npm run gen-sidebar && NODE_OPTIONS='--max-old-space-size=8192' vuepress build . && npm run sync-figures",
    "sync-figures": "tsx .vuepress/sync-figures.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vuepress/bundler-vite": "2.0.0-rc.27",
    "@vuepress/plugin-back-to-top": "2.0.0-rc.126",
    "@vuepress/plugin-google-analytics": "2.0.0-rc.126",
    "@vuepress/plugin-medium-zoom": "2.0.0-rc.126",
    "@vuepress/plugin-prismjs": "2.0.0-rc.126",
    "@vuepress/plugin-register-components": "2.0.0-rc.126",
    "@vuepress/plugin-search": "^2.0.0-rc.126",
    "@vuepress/plugin-sitemap": "2.0.0-rc.126",
    "@vuepress/theme-default": "2.0.0-rc.126",
    "dotenv": "^17.4.2",
    "katex": "^0.16.33",
    "sass-embedded": "^1.87.0",
    "vue": "^3.5.0",
    "vuepress": "2.0.0-rc.27",
    "vuepress-plugin-code-copy": "^1.0.6",
    "vitest": "^3.1.4",
    "happy-dom": "^18.0.1",
    "@vitest/ui": "^3.1.4",
    "tsx": "^4.19.4"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  }
}
